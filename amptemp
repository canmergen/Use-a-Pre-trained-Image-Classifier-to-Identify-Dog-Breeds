    const zamansal = bfZamansalMi();

    kok.appendChild(elYap("div", "iskele-baslik", "Bölme stratejisi"));
    if (f.kilitli) kok.appendChild(bfKilitCiz());

    // ---- 1. asama: test nasil ayrilir ----
    kok.appendChild(bfTestTanimCiz(al));

    const testAlan = elYap("div", "bf-alanlar bf-asama-alanlar");
    /* Zamansal testte test ORANI yoktur (test = son N donem), rastgele
       testte de donem SAYISI yoktur. Ikisi de gorunur ama yalnizca
       secili olan aktif: alanin kaybolmasi "nereye gitti?" ettiriyordu. */
    testAlan.appendChild(bfAlanCiz("Test dönem sayısı (son N)",
