def _bd_kapsam():
    """Her dönem, model renklerindeki KK müşterileri (tekil): FPD tablosunda kaydı, FPD hedefi, FPD skoru ve PredCs dolu
    olanlar. PredCs yönü FPD hedefinde belirlenir (Gini artıysa büyük değer riskli). → (satırlar, PredCs bilgisi)."""
    renkler = sorted({k for m in _BD_MODELLER for k in m["renkler"]})
    h = "TKP_ST_5M90" if "TKP_ST_5M90" in _BD_FPD_ADLAR else (_BD_FPD_ADLAR[-1] if _BD_FPD_ADLAR else None)
    satir, parca = [], []
    for d in [x for x in _BD_DON if x in _bd_donem_var]:
        pos = np.flatnonzero(np.isin(_BD_RENK_A, renkler) & (_BD_DONEM_A == d) & _BD_KK_A)
        mbb = _bd_tamsayi(_BD_VERI["MBB_NO"].iloc[pos]).to_numpy()
        pc = _bd_pc_dizi(pos, mbb, d)
        t = pd.DataFrame({"MBB_NO": pd.array(mbb, dtype="Int64"), "PC": pc if pc is not None else np.nan})
        t = t.dropna(subset=["MBB_NO"]).drop_duplicates("MBB_NO", keep="first")
        r = {"donem": d, "n": len(t), "pc": int(t["PC"].notna().sum()), "kayit": None, "hedef": None, "fskor": None}
        pc_var, fpd_var = t["PC"].notna().to_numpy(), np.zeros(len(t), dtype=bool)     # FPD var = FPD hedefi dolu
        if _BD_FPD is not None:
            r.update(kayit=0, hedef=0, fskor=0 if _bd_fpd_skorlu else None)
            if d in _BD_FPD_P:
                m = t.merge(_BD_FPD_P[d], on="MBB_NO", how="left", indicator=True)
                r["kayit"] = int((m["_merge"] == "both").sum())
                fpd_var = m[_BD_FPD_ADLAR].notna().any(axis=1).to_numpy()
                r["hedef"] = int(fpd_var.sum())
                if _bd_fpd_skorlu:
                    r["fskor"] = int(m["FSKOR"].notna().sum())
                if pc is not None and h:
                    ok = m[h].notna() & m["PC"].notna()
                    parca.append(pd.DataFrame({"y": m.loc[ok, h].to_numpy(dtype="float64"),
                                               "pc": m.loc[ok, "PC"].to_numpy(dtype="float64"),
                                               "fs": (m.loc[ok, "FSKOR"].to_numpy(dtype="float64", na_value=np.nan)
                                                      if _bd_fpd_skorlu else np.nan)}))
        r.update(iki=int((pc_var & fpd_var).sum()), yalniz_pc=int((pc_var & ~fpd_var).sum()),
                 yalniz_fpd=int((~pc_var & fpd_var).sum()), hicbiri=int((~pc_var & ~fpd_var).sum()))
        satir.append(r)
    bilgi = {"yon": 1, "h": h, "n": 0, "v": 0.0, "g_pc": np.nan, "n_f": 0, "g_pc_f": np.nan, "g_f": np.nan}
    if parca:
        k = pd.concat(parca, ignore_index=True)
        bilgi.update(n=len(k), v=float(k["y"].sum()))
        if min(bilgi["v"], bilgi["n"] - bilgi["v"]) >= _BD_MIN_VAKA:
            g = _bd_gini(k["y"], k["pc"])
            bilgi["yon"] = -1 if np.isfinite(g) and g < 0 else 1
            bilgi["g_pc"] = bilgi["yon"] * g
            kf = k[k["fs"].notna()]
            bilgi["n_f"] = len(kf)
            if len(kf) and min(kf["y"].sum(), len(kf) - kf["y"].sum()) >= _BD_MIN_VAKA:
                bilgi["g_pc_f"] = bilgi["yon"] * _bd_gini(kf["y"], kf["pc"])
                bilgi["g_f"] = _bd_gini(kf["y"], kf["fs"])
    return satir, bilgi


