def _feature_ailesi(c, ham):
    if c in ham:
        return 'ham_kolon'
    for onek, ad in _AILE_ONEKLERI:
        if c.startswith(onek):
            return ad
    if '_INTD_' in c:
        return 'int_degisim'
    for onek, ad in _ESKI_AILE_ONEKLERI:
        if c.startswith(onek):
            return ad
    return 'diger'


def _aile_ozeti(etiket, ham, aday, sabit, korelasyon, shap_oncesi, secilen, imp, secim_yontemi):
    """Her aile icin: uretilen / elenen (sabit, korelasyon, secim) / secilen / gain payi."""
    sabit, korelasyon, secilen = set(sabit), set(korelasyon), set(secilen)
    shap_elenen = set(shap_oncesi) - secilen
    gain = dict(zip(imp['feature'], imp['feat_imp_gain']))
    split = dict(zip(imp['feature'], imp['feat_imp_split']))
    shap = dict(zip(imp['feature'], imp['shap_mean_abs'])) if 'shap_mean_abs' in imp else {}
    g_tot = max(float(sum(gain.values())), 1e-12)
    s_tot = max(float(sum(split.values())), 1e-12)
    sh_tot = max(float(sum(shap.values())), 1e-12)
    aile = {c: _feature_ailesi(c, ham) for c in aday}
    satirlar = []
    for ad in sorted(set(aile.values())):
        cols = [c for c in aday if aile[c] == ad]
        sec = [c for c in cols if c in secilen]
        en_iyi = sorted(sec, key=lambda c: -gain.get(c, 0.0))[:3]
        satirlar.append({
            'renk': etiket, 'aile': ad, 'uretilen': len(cols),
            'sabit_elenen': sum(c in sabit for c in cols),
            'korelasyon_elenen': sum(c in korelasyon for c in cols),
            'secim_elenen': sum(c in shap_elenen for c in cols),
            'secim_yontemi': secim_yontemi,
            'secilen': len(sec),
            'gain_payi': round(sum(gain.get(c, 0.0) for c in sec) / g_tot, 4),
            'split_payi': round(sum(split.get(c, 0.0) for c in sec) / s_tot, 4),
            'shap_payi': round(sum(shap.get(c, 0.0) for c in sec) / sh_tot, 4) if shap else None,
            'en_onemli_3': ', '.join(en_iyi),
        })
    return pd.DataFrame(satirlar).sort_values('gain_payi', ascending=False)


def _capture_bootstrap(y, p, pct, n_boot, seed):
    """Capture@pct icin Poisson bootstrap %95 araligi (siralama bir kez yapilir)."""
    y = np.asarray(y, dtype='float64')
    p = np.asarray(p, dtype='float64')
    if n_boot <= 0 or len(y) == 0 or y.sum() == 0:
        return np.nan, np.nan
    ys = y[np.argsort(-p, kind='mergesort')]
    rng = np.random.default_rng(seed)
    res = np.empty(n_boot)
    for b in range(n_boot):
        w = rng.poisson(1.0, len(ys)).astype('float64')
        cw = np.cumsum(w)
        oran = np.clip((pct * cw[-1] - (cw - w)) / np.where(w > 0, w, 1.0), 0.0, 1.0)
        pay = (ys * w).sum()
        res[b] = (ys * w * oran).sum() / pay if pay > 0 else np.nan
    return float(np.nanpercentile(res, 2.5)), float(np.nanpercentile(res, 97.5))


def _hk_dagilim(train, val, oot, cols):
    satir = []
    for c in cols:
        r = {'feature': c}
        for ad, fr in (('train', train), ('val', val), ('oot', oot)):
            v = pd.to_numeric(fr[c], errors='coerce')
            r[f'{ad}_ort'], r[f'{ad}_std'] = float(v.mean()), float(v.std())
        satir.append(r)
    return pd.DataFrame(satir)


def renk_goc_skorla(df_raw, paket, fe_fn=None, renk_kontrol=True):
    """Ham satirlardan model paketiyle skor uretir (canli skorlama ile egitimin ayni yolu).

    df_raw: paket['required_raw_features'] kolonlarini iceren ham veri.
    fe_fn : egitimde kullanilan feature_engineering fonksiyonu (varsayilan: global).
    renk_kontrol: df_raw'da RENK varsa, tum satirlar paketin renginde olmali.
    """
    fe_fn = fe_fn or globals()['feature_engineering']
    if renk_kontrol:
        if 'RENK' not in df_raw.columns:
            raise KeyError("Renk kontrolu icin df_raw'da RENK kolonu gerekli (renk_kontrol=False ile kapatilabilir).")
        yanlis = int((pd.to_numeric(df_raw['RENK'], errors='coerce') != paket['renk_kod']).sum())
        if yanlis:
            raise ValueError(f"{yanlis:,} satir {paket['etiket']} modelinin renginde degil.")
    raw = list(paket['required_raw_features'])
    eksik = [c for c in raw if c not in df_raw.columns]
    if eksik:
        raise KeyError(f'Skorlama icin eksik ham kolon: {eksik[:10]}')
    X = df_raw.loc[:, raw]
    eng, _ = fe_fn(X)
    yeni = [c for c in paket['engineered_features'] if c in eng.columns and c not in raw]
    frame = pd.concat([X, eng.loc[:, yeni]], axis=1)
    for c in raw:
        if c in eng.columns and not eng[c].equals(X[c]):
            frame[c] = eng[c]
    schema = paket['preprocess_schema']
    if schema.get('mode') != 'train_fitted_native':
        raise NotImplementedError('Yalnizca train_fitted_native preprocess skorlanabilir.')
    feats = list(paket['features'])
    kolonlar = {}
    for c in feats:
        if c.startswith('HK_'):
            continue
        if c in schema['categorical']:
            kolonlar[c] = frame[c].astype('string').astype(
                pd.CategoricalDtype(categories=schema['categorical'][c]))
        else:
            kolonlar[c] = pd.to_numeric(frame[c], errors='coerce')
    hk_cols = [c for c in feats if c.startswith('HK_')]
    if hk_cols:
        hk = paket['hedef_kodlama']
        anahtar = _desen_anahtarlari(frame)
        for c in hk_cols:
            ad, tur = (c[3:-5], 'oran') if c.endswith('_ORAN') else (c[3:-4], 'pay')
            dolgu = hk['prior'] if tur == 'oran' else 0.0
            kolonlar[c] = pd.Series(
                anahtar[ad].map(hk['haritalar'][ad][tur]).fillna(dolgu).to_numpy(dtype='float64'),
                index=frame.index)
    sonuc = pd.DataFrame(kolonlar, index=frame.index)
    return pd.Series(paket['model'].predict_proba(sonuc[feats])[:, 1], index=frame.index)


def _hk_num(frame, c):
    if c not in frame.columns:
        return np.full(len(frame), np.nan)
    return pd.to_numeric(frame[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)


def _hk_bin(v, sinirlar, etiketler):
    out = np.full(len(v), 'X', dtype=object)
    ok = np.isfinite(v)
    out[ok] = np.asarray(etiketler, dtype=object)[np.digitize(v[ok], sinirlar)]
    return out


def _hk_birlestir(parcalar):
    res = parcalar[0].astype(str)
    for p in parcalar[1:]:
        res = np.char.add(np.char.add(res, '|'), p.astype(str))
    return res


def _desen_anahtarlari(frame):
    """Satir bazli desen anahtarlari (renk, kullanim, odeme)."""
    aylar = ['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M']
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != 'INAKTIF']
    R = np.column_stack([_hk_num(frame, f'RENK_{m}') for m in aylar])
    Rk = np.where(np.isin(R, aktif) | (R == 0), R, np.nan)
    renk_str = np.where(np.isfinite(Rk), np.nan_to_num(Rk).astype(int).astype(str), 'X')
    anahtar = {'RENK3': _hk_birlestir([renk_str[:, j] for j in range(3)])}

    Ra = np.where(np.isin(R, aktif), R, np.nan)
    hareket = []
    for j in range(5):
        a, b = Ra[:, j], Ra[:, j + 1]
        ok = np.isfinite(a) & np.isfinite(b)
        h = np.where(a < b, '-', np.where(a > b, '+', '0'))
        hareket.append(np.where(ok, h, 'X'))
    anahtar['RENK_HAREKET5'] = _hk_birlestir(hareket)

    U = []
    for m in aylar[:3]:
        lim, rsk = _hk_num(frame, f'KK_LIMIT_{m}'), _hk_num(frame, f'KK_RISK_{m}')
        ok = np.isfinite(lim) & np.isfinite(rsk) & (lim > 0)
        U.append(np.where(ok, rsk / np.where(ok, lim, 1.0), np.nan))
    kku = [_hk_bin(u, [0.3, 0.8, 0.9], ['a', 'b', 'c', 'd']) for u in U]
    odm = [_hk_bin(_hk_num(frame, f'KK_ODEME_ORANI_{m}'), [20, 100], ['a', 'b', 'c'])
           for m in aylar[:3]]
    anahtar['KKU3'] = _hk_birlestir(kku)
    anahtar['ODM3'] = _hk_birlestir(odm)
    anahtar['RENK_KKU_ODM_LM'] = _hk_birlestir([renk_str[:, 0], kku[0], odm[0]])
    return {k: pd.Series(v, index=frame.index) for k, v in anahtar.items()}


def _hk_harita(k, y, prior):
    g = pd.DataFrame({'k': k.to_numpy(), 'y': np.asarray(y, dtype='float64')}).groupby('k')['y'].agg(['sum', 'count'])
    oran = (g['sum'] + HK_M * prior) / (g['count'] + HK_M)
    return oran, g['count']


def _hedef_kodla(train, val, oot, target, source_meta):
    """Train'de out-of-fold, val/OOT'de tum train haritasi. (yeni_kolonlar, paket)"""
    y = train[target].to_numpy(dtype='float64')
    prior = float(y.mean())
    k_tr, k_va, k_oo = (_desen_anahtarlari(f) for f in (train, val, oot))
    cv = StratifiedKFold(n_splits=HK_FOLD, shuffle=True, random_state=RANDOM_STATE)
    splits = None
    if 'MBB_NO' in source_meta.columns:
        grp = source_meta.reindex(train.index)['MBB_NO'].astype(str)
        if grp.duplicated().any():
            splits = list(StratifiedGroupKFold(n_splits=HK_FOLD, shuffle=True,
                                               random_state=RANDOM_STATE).split(train, y, grp))
    if splits is None:
        splits = list(cv.split(train, y))
    yeni, paket = [], {'prior': prior, 'm': HK_M, 'haritalar': {}}
    for ad in k_tr:
        oof_o = np.full(len(train), np.nan)
        oof_p = np.zeros(len(train))
        for itr, iva in splits:
            o, n = _hk_harita(k_tr[ad].iloc[itr], y[itr], float(y[itr].mean()))
            kk = k_tr[ad].iloc[iva]
            oof_o[iva] = kk.map(o).fillna(float(y[itr].mean())).to_numpy()
            oof_p[iva] = kk.map(n / len(itr)).fillna(0).to_numpy()
        o, n = _hk_harita(k_tr[ad], y, prior)
        pay = n / len(train)
        c_o, c_p = f'HK_{ad}_ORAN', f'HK_{ad}_PAY'
        train[c_o], train[c_p] = oof_o, oof_p
        for fr, kk in ((val, k_va[ad]), (oot, k_oo[ad])):
            fr[c_o] = kk.map(o).fillna(prior).to_numpy()
            fr[c_p] = kk.map(pay).fillna(0).to_numpy()
        yeni += [c_o, c_p]
        paket['haritalar'][ad] = {'oran': o.to_dict(), 'pay': pay.to_dict()}
    return yeni, paket


