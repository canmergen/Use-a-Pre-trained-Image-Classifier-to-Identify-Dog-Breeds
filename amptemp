import numpy as np
import pandas as pd


def _psi_hesap(p, q, eps=1e-4):
    p = np.clip(np.asarray(p, dtype='float64'), eps, None)
    q = np.clip(np.asarray(q, dtype='float64'), eps, None)
    return float(np.sum((q - p) * np.log(q / p)))


def _sayisal_mi(s):
    return pd.to_numeric(s, errors='coerce').notna().sum() >= 0.95 * s.notna().sum() and s.notna().any()


def _kolon_psi(a, b, n_bin=10):
    if _sayisal_mi(a):
        an = pd.to_numeric(a, errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
        bn = pd.to_numeric(b, errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
        kenar = np.unique(np.nanquantile(an, np.linspace(0, 1, n_bin + 1))[1:-1]) if np.isfinite(an).any() else np.array([])

        def _pay(x):
            ok = np.isfinite(x)
            i = np.searchsorted(kenar, x[ok], side='right')
            say = np.bincount(i, minlength=len(kenar) + 1).astype('float64')
            return np.r_[say, (~ok).sum()] / max(len(x), 1)
        return _psi_hesap(_pay(an), _pay(bn))
    pa = a.astype('string').fillna('<BOS>').value_counts(normalize=True)
    pb = b.astype('string').fillna('<BOS>').value_counts(normalize=True)
    k = pa.index.union(pb.index)
    return _psi_hesap(pa.reindex(k, fill_value=0), pb.reindex(k, fill_value=0))


def donem_karsilastir(df, kolonlar, d_train, d_oot, donem_kolonu='DONEM'):
    """Her ham kolon icin train ve OOT donemindeki bosluk orani, tekil deger, ortalama ve PSI."""
    a_df = df.loc[df[donem_kolonu] == d_train]
    b_df = df.loc[df[donem_kolonu] == d_oot]
    satirlar = []
    for c in kolonlar:
        a, b = a_df[c], b_df[c]
        r = {'kolon': c, 'tip': str(a.dtype),
             'bos_train_%': round(a.isna().mean() * 100, 2), 'bos_oot_%': round(b.isna().mean() * 100, 2),
             'tekil_train': int(a.nunique()), 'tekil_oot': int(b.nunique())}
        if _sayisal_mi(a):
            an, bn = pd.to_numeric(a, errors='coerce'), pd.to_numeric(b, errors='coerce')
            r.update({'ort_train': an.mean(), 'ort_oot': bn.mean(),
                      'min_train': an.min(), 'max_train': an.max(),
                      'min_oot': bn.min(), 'max_oot': bn.max()})
            dolu = bn.dropna()
            disarida = ((dolu < an.min()) | (dolu > an.max())).mean() if len(dolu) and an.notna().any() else np.nan
            r['oot_aralik_disi_%'] = round(float(disarida) * 100, 2) if np.isfinite(disarida) else np.nan
        r['psi'] = round(_kolon_psi(a, b), 4)
        satirlar.append(r)
    sonuc = pd.DataFrame(satirlar)
    if 'oot_aralik_disi_%' not in sonuc.columns:
        sonuc['oot_aralik_disi_%'] = np.nan
    sonuc = sonuc.sort_values('psi', ascending=False).reset_index(drop=True)
    sonuc['bos_farki_puan'] = (sonuc['bos_oot_%'] - sonuc['bos_train_%']).round(2)
    return sonuc


