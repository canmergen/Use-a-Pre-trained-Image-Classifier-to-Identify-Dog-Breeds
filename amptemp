_NS_M = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
_NS_R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
_NS_X14 = "http://schemas.microsoft.com/office/spreadsheetml/2009/9/main"
_NS_X15 = "http://schemas.microsoft.com/office/spreadsheetml/2010/11/main"
_NS_MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
_NS_XDR = "http://schemas.openxmlformats.org/drawingml/2006/spreadsheetDrawing"
_NS_A = "http://schemas.openxmlformats.org/drawingml/2006/main"
_NS_PR = "http://schemas.openxmlformats.org/package/2006/relationships"
_REL_CIZIM = _NS_R + "/drawing"
_REL_DILIM = "http://schemas.microsoft.com/office/2007/relationships/slicer"
_REL_DILIM_ON = "http://schemas.microsoft.com/office/2007/relationships/slicerCache"
_URI_KITAP = "{46BE6895-7355-4a93-B00E-2C351335B9C9}"   # workbook extLst: x15:slicerCaches (tablo dilimleyicileri)
_URI_SAYFA = "{3A4CF648-6AED-40f4-86FF-DC5316D8AED3}"   # worksheet extLst: x14:slicerList (tablo dilimleyicileri)
_URI_ON = "{2F2917AC-EB37-4324-AD4E-5DD8C200BD13}"      # slicerCacheDefinition extLst: x15:tableSlicerCache
_XML_BAS = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'


def _q(s):
    return _xml_kacis(str(s), {'"': "&quot;"})


def _parca_yolu(kaynak, hedef):
    """rels Target'ını zip içi yola çevirir (mutlak '/xl/..' ya da göreli '../..')."""
    if hedef.startswith("/"):
        return hedef.lstrip("/")
    parca = kaynak.split("/")[:-1]
    for p in hedef.split("/"):
        if p == "..":
            parca.pop()
        elif p not in (".", ""):
            parca.append(p)
    return "/".join(parca)


def _rels_yolu(parca):
    d, ad = parca.rsplit("/", 1)
    return f"{d}/_rels/{ad}.rels"


def _kok_onek(s, etiket):
    m = re.search(r"<(\w+:)?" + etiket + r"[\s>]", s)
    return (m.group(1) or "") if m else ""


def _once_ekle(s, desenler, ek):
    """s içinde desenlerden en önce eşleşenin önüne ek'i koyar."""
    konum = [m.start() for d in desenler for m in [re.search(d, s)] if m]
    if not konum:
        raise ValueError("XML içinde ekleme yeri bulunamadı")
    k = min(konum)
    return s[:k] + ek + s[k:]


def _capa(no, ad, baslik, c1, r1, c2, r2):
    """Çizim (drawing) içindeki dilimleyici yeri; Excel 2010 ve öncesi ile diğer programlar yedek kutuyu gösterir."""
    return (f'<xdr:twoCellAnchor xmlns:xdr="{_NS_XDR}" xmlns:a="{_NS_A}" editAs="oneCell">'
            f'<xdr:from><xdr:col>{c1}</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>{r1}</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:from>'
            f'<xdr:to><xdr:col>{c2}</xdr:col><xdr:colOff>0</xdr:colOff><xdr:row>{r2}</xdr:row><xdr:rowOff>0</xdr:rowOff></xdr:to>'
            f'<mc:AlternateContent xmlns:mc="{_NS_MC}">'
            '<mc:Choice xmlns:sle15="http://schemas.microsoft.com/office/drawing/2012/slicer" Requires="sle15">'
            f'<xdr:graphicFrame macro=""><xdr:nvGraphicFramePr><xdr:cNvPr id="{no}" name="{_q(ad)}"/><xdr:cNvGraphicFramePr/>'
            '</xdr:nvGraphicFramePr><xdr:xfrm><a:off x="0" y="0"/><a:ext cx="0" cy="0"/></xdr:xfrm>'
            '<a:graphic><a:graphicData uri="http://schemas.microsoft.com/office/drawing/2010/slicer">'
            f'<sle:slicer xmlns:sle="http://schemas.microsoft.com/office/drawing/2010/slicer" name="{_q(ad)}"/>'
            '</a:graphicData></a:graphic></xdr:graphicFrame></mc:Choice>'
            '<mc:Fallback><xdr:sp macro="" textlink="">'
            f'<xdr:nvSpPr><xdr:cNvPr id="{no}" name="{_q(ad)}"/><xdr:cNvSpPr><a:spLocks noTextEdit="1"/></xdr:cNvSpPr></xdr:nvSpPr>'
            '<xdr:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="1828800" cy="900000"/></a:xfrm>'
            '<a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:solidFill><a:srgbClr val="F2F2F2"/></a:solidFill>'
            '<a:ln w="9525"><a:solidFill><a:srgbClr val="A6A6A6"/></a:solidFill></a:ln></xdr:spPr>'
            '<xdr:txBody><a:bodyPr vertOverflow="clip" horzOverflow="clip"/><a:lstStyle/><a:p><a:r>'
            f'<a:rPr lang="tr-TR" sz="1000"/><a:t>Dilimleyici: {_q(baslik)} (Excel 2013 ve sonrasında görünür)</a:t>'
            '</a:r></a:p></xdr:txBody></xdr:sp></mc:Fallback></mc:AlternateContent><xdr:clientData/></xdr:twoCellAnchor>')


def _dilimleyici_ekle(veri, plan):
    zin = zipfile.ZipFile(BytesIO(veri))
    sira = [i.filename for i in zin.infolist()]
    z = {ad: zin.read(ad) for ad in sira}
    oku = (lambda p: z[p].decode("utf-8"))

    def rels(parca):
        yol = _rels_yolu(parca)
        if yol not in z:
            return []
        return [(e.get("Id"), e.get("Type"), _parca_yolu(parca, e.get("Target"))) for e in ET.fromstring(z[yol])]

    def rel_ekle(parca, tip, hedef, on):
        yol = _rels_yolu(parca)
        if yol not in z:
            z[yol] = (_XML_BAS + f'<Relationships xmlns="{_NS_PR}"></Relationships>').encode("utf-8")
            sira.append(yol)
        mevcut = {i for i, _, _ in rels(parca)}
        k = 1
        while f"{on}{k}" in mevcut:
            k += 1
        rid = f"{on}{k}"
        ek = f'<Relationship Id="{rid}" Type="{tip}" Target="/{hedef}"/>'
        s = oku(yol)
        s = (s.replace("</Relationships>", ek + "</Relationships>") if "</Relationships>" in s else
             re.sub(r"<Relationships([^>]*)/>", lambda m: f"<Relationships{m.group(1)}>{ek}</Relationships>", s))
        z[yol] = s.encode("utf-8")
        return rid

    def yeni_parca(kalip, icerik, tur):
        k = 1
        while kalip.format(k) in z:
            k += 1
        yol = kalip.format(k)
        z[yol] = icerik.encode("utf-8")
        sira.append(yol)
        tipler.append((yol, tur))
        return yol

    tipler, onbellekler = [], []
    wb_kok = ET.fromstring(z["xl/workbook.xml"])
    sayfa_rid = {e.get("name"): e.get(f"{{{_NS_R}}}id") for e in wb_kok.iter(f"{{{_NS_M}}}sheet")}
    wb_hedef = {i: h for i, _, h in rels("xl/workbook.xml")}
    for p in plan:
        sayfa_yol = wb_hedef[sayfa_rid[p["sayfa"]]]
        srels = rels(sayfa_yol)
        tablo_id, kolon_id = None, {}
        for _, t, h in srels:
            if t.endswith("/table"):
                tk = ET.fromstring(z[h])
                if tk.get("displayName") == p["tablo"]:
                    tablo_id = tk.get("id")
                    kolon_id = {c.get("name"): c.get("id") for c in tk.iter(f"{{{_NS_M}}}tableColumn")}
        if tablo_id is None:
            raise ValueError(f"{p['sayfa']}: {p['tablo']} tablosu bulunamadı")
        s_ws = oku(sayfa_yol)
        on = _kok_onek(s_ws, "worksheet")
        cizim = next((h for _, t, h in srels if t == _REL_CIZIM), None)
        if cizim is None:                                     # sayfada çizim yoksa boş bir çizim parçası aç
            cizim = yeni_parca("xl/drawings/drawing{}.xml", _XML_BAS + f'<xdr:wsDr xmlns:xdr="{_NS_XDR}" xmlns:a="{_NS_A}"></xdr:wsDr>',
                               "application/vnd.openxmlformats-officedocument.drawing+xml")
            rid = rel_ekle(sayfa_yol, _REL_CIZIM, cizim, "rIdCizim")
            s_ws = _once_ekle(s_ws, [rf"<{on}(?:legacyDrawing|legacyDrawingHF|picture|oleObjects|controls|webPublishItems|"
                                     rf"tableParts|extLst)\b", rf"</{on}worksheet>"],
                              f'<{on}drawing xmlns:r="{_NS_R}" r:id="{rid}"/>')
        s_cz = oku(cizim)
        no = max([int(x) for x in re.findall(r'<(?:\w+:)?cNvPr[^>]*?\sid="(\d+)"', s_cz)] + [0]) + 1
        dilim_xml, capalar = [], []
        for j, (kolon, baslik, (c1, r1, c2, r2), n_kol) in enumerate(p["dilimler"], start=1):
            if kolon not in kolon_id:
                raise ValueError(f"{p['tablo']}: '{kolon}' kolonu yok")
            ad = f"Dilim_{p['tablo']}_{j}"
            on_ad = f"Slicer_{p['tablo']}_{j}"
            ob = yeni_parca("xl/slicerCaches/slicerCache{}.xml",
                            _XML_BAS + f'<slicerCacheDefinition xmlns="{_NS_X14}" xmlns:mc="{_NS_MC}" mc:Ignorable="x" '
                            f'xmlns:x="{_NS_M}" name="{on_ad}" sourceName="{_q(kolon)}"><extLst>'
                            f'<x:ext uri="{_URI_ON}" xmlns:x15="{_NS_X15}"><x15:tableSlicerCache tableId="{tablo_id}" '
                            f'column="{kolon_id[kolon]}"/></x:ext></extLst></slicerCacheDefinition>',
                            "application/vnd.ms-excel.slicerCache+xml")
            onbellekler.append((on_ad, rel_ekle("xl/workbook.xml", _REL_DILIM_ON, ob, "rIdDilimOn")))
            dilim_xml.append(f'<slicer name="{_q(ad)}" cache="{on_ad}" caption="{_q(baslik)}" columnCount="{n_kol}" '
                             f'style="{DILIMLEYICI_STIL}" rowHeight="241300"/>')
            capalar.append(_capa(no, ad, baslik, c1, r1, c2, r2))
            no += 1
        dl = yeni_parca("xl/slicers/slicer{}.xml",
                        _XML_BAS + f'<slicers xmlns="{_NS_X14}" xmlns:mc="{_NS_MC}" mc:Ignorable="x" xmlns:x="{_NS_M}">'
                        + "".join(dilim_xml) + "</slicers>", "application/vnd.ms-excel.slicer+xml")
        rid_dl = rel_ekle(sayfa_yol, _REL_DILIM, dl, "rIdDilim")
        ext = (f'<{on}ext uri="{_URI_SAYFA}" xmlns:x15="{_NS_X15}"><x14:slicerList xmlns:x14="{_NS_X14}">'
               f'<x14:slicer xmlns:r="{_NS_R}" r:id="{rid_dl}"/></x14:slicerList></{on}ext>')
        if re.search(rf"</{on}extLst>\s*</{on}worksheet>\s*$", s_ws):
            s_ws = _once_ekle(s_ws, [rf"</{on}extLst>\s*</{on}worksheet>\s*$"], ext)
        else:
            s_ws = _once_ekle(s_ws, [rf"</{on}worksheet>\s*$"], f"<{on}extLst>{ext}</{on}extLst>")
        z[sayfa_yol] = s_ws.encode("utf-8")
        z[cizim] = _once_ekle(s_cz, [r"</(?:\w+:)?wsDr>\s*$"], "".join(capalar)).encode("utf-8")

    s_wb = oku("xl/workbook.xml")
    on = _kok_onek(s_wb, "workbook")
    adlar = "".join(f'<{on}definedName name="{a}">#N/A</{on}definedName>' for a, _ in onbellekler)
    if re.search(rf"</{on}definedNames>", s_wb):
        s_wb = _once_ekle(s_wb, [rf"</{on}definedNames>"], adlar)
    elif re.search(rf"<{on}definedNames\s*/>", s_wb):
        s_wb = re.sub(rf"<{on}definedNames\s*/>", f"<{on}definedNames>{adlar}</{on}definedNames>", s_wb, count=1)
    else:
        s_wb = _once_ekle(s_wb, [rf"<{on}calcPr\b", rf"<{on}oleSize\b", rf"<{on}customWorkbookViews\b",
                                 rf"<{on}pivotCaches\b", rf"<{on}extLst\b", rf"</{on}workbook>"],
                          f"<{on}definedNames>{adlar}</{on}definedNames>")
    ext = (f'<{on}ext uri="{_URI_KITAP}" xmlns:x15="{_NS_X15}"><x15:slicerCaches xmlns:x14="{_NS_X14}">'
           + "".join(f'<x14:slicerCache xmlns:r="{_NS_R}" r:id="{rid}"/>' for _, rid in onbellekler)
           + f"</x15:slicerCaches></{on}ext>")
    if re.search(rf"</{on}extLst>\s*</{on}workbook>\s*$", s_wb):
        s_wb = _once_ekle(s_wb, [rf"</{on}extLst>\s*</{on}workbook>\s*$"], ext)
    else:
        s_wb = _once_ekle(s_wb, [rf"</{on}workbook>\s*$"], f"<{on}extLst>{ext}</{on}extLst>")
    z["xl/workbook.xml"] = s_wb.encode("utf-8")
    s_ct = oku("[Content_Types].xml")
    z["[Content_Types].xml"] = s_ct.replace("</Types>", "".join(
        f'<Override PartName="/{yol}" ContentType="{tur}"/>' for yol, tur in tipler) + "</Types>").encode("utf-8")
    for ad in z:                                              # tüm XML parçaları hâlâ düzgün mü
        if ad.endswith((".xml", ".rels")):
            ET.fromstring(z[ad])
    cikti = BytesIO()
    with zipfile.ZipFile(cikti, "w", zipfile.ZIP_DEFLATED) as zo:
        for ad in sira:
            zo.writestr(ad, z[ad])
    return cikti.getvalue(), len(onbellekler)


