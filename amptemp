def _fu_kat_metin(s):
    """Kategori değerlerini metne çevirir; 1 ve 1.0 aynı metin ('1') olur (pipeline'daki _kat_metin)."""
    if pd.api.types.is_numeric_dtype(s.dtype) and not pd.api.types.is_bool_dtype(s.dtype):
        v = pd.to_numeric(s, errors="coerce").astype("float64")
        out = v.astype("string")
        tam = v.notna() & np.isfinite(v) & (v == np.round(v)) & (v.abs() < 2 ** 53)
        out[tam] = v[tam].astype("int64").astype("string")
        return out
    return s.astype("string")


_FU_DESEN_AYLAR = ["LM"] + [f"L{i}M" for i in range(2, 13)]
_FU_DESEN_KOL = ([f"RENK_{m}" for m in _FU_DESEN_AYLAR[:6]] +
                 [f"{b}_{m}" for b in ("KK_LIMIT", "KK_RISK", "KK_ODEME_ORANI") for m in _FU_DESEN_AYLAR[:3]])


def _fu_desen_num(frame, c):
    if c not in frame.columns:
        return np.full(len(frame), np.nan)
    return pd.to_numeric(frame[c], errors="coerce").to_numpy(dtype="float64", na_value=np.nan)


def _fu_desen_bin(v, sinirlar, etiketler):
    out = np.full(len(v), "X", dtype=object)
    ok = np.isfinite(v)
    out[ok] = np.asarray(etiketler, dtype=object)[np.digitize(v[ok], sinirlar)]
    return out


def _fu_desen_birlestir(parcalar):
    res = parcalar[0].astype(str)
    for p in parcalar[1:]:
        res = np.char.add(np.char.add(res, "|"), p.astype(str))
    return res


def _fu_desen_anahtarlari(frame):
    """Satır bazlı desen anahtarları (pipeline'daki _desen_anahtarlari, kaydir=0)."""
    aylar = _FU_DESEN_AYLAR[:6]
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != "INAKTIF"]
    R = np.column_stack([_fu_desen_num(frame, f"RENK_{m}") for m in aylar])
    Rk = np.where(np.isin(R, aktif) | (R == 0), R, np.nan)
    renk_str = np.where(np.isfinite(Rk), np.nan_to_num(Rk).astype(int).astype(str), "X")
    anahtar = {"RENK3": _fu_desen_birlestir([renk_str[:, j] for j in range(3)])}
    Ra = np.where(np.isin(R, aktif), R, np.nan)
    hareket = []
    for j in range(5):
        a, b = Ra[:, j], Ra[:, j + 1]
        ok = np.isfinite(a) & np.isfinite(b)
        h = np.where(a < b, "-", np.where(a > b, "+", "0"))
        hareket.append(np.where(ok, h, "X"))
    anahtar["RENK_HAREKET5"] = _fu_desen_birlestir(hareket)
    U = []
    for m in aylar[:3]:
        lim, rsk = _fu_desen_num(frame, f"KK_LIMIT_{m}"), _fu_desen_num(frame, f"KK_RISK_{m}")
        ok = np.isfinite(lim) & np.isfinite(rsk) & (lim > 0)
        U.append(np.where(ok, rsk / np.where(ok, lim, 1.0), np.nan))
    kku = [_fu_desen_bin(u, [0.3, 0.8, 0.9], ["a", "b", "c", "d"]) for u in U]
    odm = [_fu_desen_bin(_fu_desen_num(frame, f"KK_ODEME_ORANI_{m}"), [20, 100], ["a", "b", "c"]) for m in aylar[:3]]
    anahtar["KKU3"] = _fu_desen_birlestir(kku)
    anahtar["ODM3"] = _fu_desen_birlestir(odm)
    anahtar["RENK_KKU_ODM_LM"] = _fu_desen_birlestir([renk_str[:, 0], kku[0], odm[0]])
    return {k: pd.Series(v, index=frame.index) for k, v in anahtar.items()}


class _FuUretim:
    """Bir renk x dönem x ham kolon seti için FE çıktısı; değişkenler paketin tanımıyla tek tek istenir."""

    def __init__(self, X, eng, eng_liste):
        self.X, self.eng, self.eng_liste = X, eng, eng_liste
        self._anahtar = None
        self._degisti = {}

    def _ham_veya_fe(self, c, raw, eng_set):
        if c in raw:
            if c in self.eng.columns:
                if c not in self._degisti:
                    self._degisti[c] = not self.eng[c].equals(self.X[c])
                if self._degisti[c]:
                    return self.eng[c]                        # FE ham kolonu dönüştürdüyse dönüşmüş hali
            return self.X[c]
        if c in eng_set and c in self.eng.columns:
            return self.eng[c]
        return None

    def kolon(self, c, paket):
        """Değişkenin modelin gördüğü hali (sayısal ya da paketteki kategorilerle kategorik)."""
        raw, eng_set = set(paket["required_raw_features"]), set(paket["engineered_features"])
        desen = paket.get("desen_kodlama") or {}
        ds = desen.get("kolonlar", {})
        if c in ds:
            if self._anahtar is None:
                if "COLOR_MAP" not in globals():
                    raise RuntimeError("Desen değişkenleri (DSN_*) için COLOR_MAP bellekte olmalı.")
                cer = pd.DataFrame({k: s for k in _FU_DESEN_KOL if (s := self._ham_veya_fe(k, raw, eng_set)) is not None},
                                   index=self.X.index)
                self._anahtar = _fu_desen_anahtarlari(cer)
            ad, tur = ds[c]
            dolgu = desen["haritalar"][ad]["nadir_oran"] if tur == "oran" else 0.0
            return pd.Series(self._anahtar[ad].map(desen["haritalar"][ad][tur]).fillna(dolgu).to_numpy(dtype="float64"),
                             index=self.X.index)
        s = self._ham_veya_fe(c, raw, eng_set)
        if s is None:
            raise KeyError(f"Değişken üretilemedi: {c}")
        schema = paket["preprocess_schema"]
        if c in schema.get("categorical", {}):
            return _fu_kat_metin(s).astype(pd.CategoricalDtype(categories=schema["categorical"][c]))
        return pd.to_numeric(s, errors="coerce")

    def girdi_ve_skor(self, paket):
        if paket["preprocess_schema"].get("mode") != "train_fitted_native":
            raise NotImplementedError("Yalnızca train_fitted_native ön işlemeli paketler skorlanabilir.")
        feats = list(paket["features"])
        F = pd.DataFrame({c: self.kolon(c, paket) for c in feats}, index=self.X.index)[feats]
        return F, np.asarray(paket["model"].predict_proba(F)[:, 1], dtype="float64")


def _fu_havuz(paket):
    """Eğitimdeki eleme öncesi havuz: ham + FE + DSN (pipeline'daki FEATURES sırası)."""
    raw = list(paket["required_raw_features"])
    fe = [c for c in paket["engineered_features"] if c not in set(raw)]
    ds = list((paket.get("desen_kodlama") or {}).get("kolonlar", {}))
    return raw + fe + [c for c in ds if c not in set(raw + fe)]


def _fu_pozisyon(kod, donem):
    return np.flatnonzero((_FU_RENK_A == kod) & (_FU_DONEM_A == donem) & _FU_KK_A)


def _fu_uret(kod, donem, raw):
    """Kitle (bütün müşteriler) + FE. → (_FuUretim, müşteri no dizisi, FE'nin ürettiği yeni değişken listesi)"""
    pos = _fu_pozisyon(kod, donem)
    kol = list(dict.fromkeys(list(raw)))
    eksik = [c for c in kol if c not in _FU_V.columns]
    if eksik:
        raise KeyError(f"ham veride eksik kolon: {eksik[:10]}" + (" ..." if len(eksik) > 10 else ""))
    X = _FU_V.iloc[pos, [_FU_V.columns.get_loc(c) for c in kol]]
    mbb = pd.to_numeric(_FU_V["MBB_NO"].iloc[pos], errors="coerce").to_numpy("float64")
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        eng, eng_cols = feature_engineering(X)
    if not eng.index.equals(X.index):
        raise RuntimeError("feature_engineering satır sırasını / index'i değiştirdi.")
    sizinti = set(globals().get("LEAK_COLS", []))
    yeni = [c for c in dict.fromkeys(eng_cols) if c in eng.columns and c not in _FU_V.columns and c not in sizinti
            and c not in {"TARGET"}]
    return _FuUretim(X, eng, yeni), mbb, yeni


def fu_feature_uret(kod, donem, vade=None, hedef=None, klasor=None, tum=False):
    """Ham veriden bir renk x dönem için değişken tablosu (bütün müşteriler).
    tum=False: modele giren değişkenler; tum=True: eğitimdeki havuzun bütün değişkenleri (ham + FE + DSN).
    Model klasörü 'klasor' ile ya da vade + hedef ile verilir (ör. vade=6, hedef="TAKIP"). Sonda SKOR kolonu var."""
    if klasor is None:
        aday = [k["klasor"] for k in _FU_KLASORLER if k["vade"] == vade and k["aile"] == hedef]
        if not aday:
            raise KeyError(f"{vade}M {hedef} klasörü yok (OOT{_FU_OOT})")
        klasor = aday[0]
    paket = fu_paket(klasor, kod)
    U, mbb, _ = _fu_uret(kod, int(donem), paket["required_raw_features"])
    F, skor = U.girdi_ve_skor(paket)
    if tum:
        F = pd.DataFrame({c: U.kolon(c, paket) for c in _fu_havuz(paket)}, index=U.X.index)
    F.insert(0, "DONEM", int(donem))
    F.insert(0, "MBB_NO", _FU_V["MBB_NO"].loc[U.X.index].to_numpy())
    F["SKOR"] = skor
    return F


