def _yorum(d):
    sk = d["skor"].lower()                                    # "davranış skoru" / "müşteri skoru"
    if d["kazanan"] == "VAKA YOK":
        return "Bu kitlede hedefi gerçekleşen müşteri yok; karşılaştırma yapılamaz."
    if not (_sonlu(d["sm_o"]) and _sonlu(d["sv_o"])):
        return f"Model ile {sk} riskli listede aynı müşterileri gösteriyor; ayrışan müşteri yok."
    metin = (f"{sk.capitalize()}nun kaçırdığı, modelin riskli dediği {_adet(d['sm_n'])} kişide hedef oranı "
             f"{_yuzde(d['sm_o'])}; modelin kaçırdığı, {sk}nun riskli dediği {_adet(d['sv_n'])} kişide {_yuzde(d['sv_o'])}.")
    net = d["net"] if _sonlu(d["net"]) else 0
    if d["kazanan"] == "MODEL":
        return metin + f" Model {_adet(abs(net))} vakayı fazladan yakalıyor."
    if d["kazanan"] == "MEVCUT SKOR":
        return metin + f" {sk.capitalize()} {_adet(abs(net))} vakayı fazladan yakalıyor."
    return metin + f" Fark {_adet(KIYAS_BERABER_PUAN * 100)} puandan küçük; iki skor eşit isabetli sayılır."


def _gorsel_ekle(ws, hucre):
    """GOC_MODEL_RESULTS'taki açıklama görselini ekler; eklenen yüksekliği (punto) döner."""
    if not GORSEL_DOSYA:
        return 0
    ham = _ham_oku(GORSEL_DOSYA)
    if ham is None:
        return 0
    try:
        from PIL import Image as PILImage
        from openpyxl.drawing.image import Image as XLImage
        im = PILImage.open(BytesIO(ham))
        en, boy = im.size
        if en > 2 * GORSEL_GENISLIK_PX:                       # dosya küçülsün, ekranda net kalsın (2x çözünürlük)
            im = im.resize((2 * GORSEL_GENISLIK_PX, int(boy * 2 * GORSEL_GENISLIK_PX / en)), PILImage.LANCZOS)
        buf = BytesIO()
        im.save(buf, format="PNG", optimize=True)
        buf.seek(0)
        img = XLImage(buf)
        img.width, img.height = GORSEL_GENISLIK_PX, int(boy * GORSEL_GENISLIK_PX / en)
        ws.add_image(img, hucre)
        return img.height * 0.75
    except Exception as e:
        _log(f"⚠ Görsel eklenemedi ({type(e).__name__}: {e}); sayfa görselsiz yazılacak")
        return 0


