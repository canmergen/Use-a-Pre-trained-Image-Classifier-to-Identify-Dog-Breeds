# --- THREAD SAYISI ------------------------------------------------------------
# os.cpu_count() pod'un değil node'un çekirdek sayısını verir. Pod'un gerçek CPU
# kotası cgroup'tan okunur; kotadan fazla thread açılırsa Linux thread'leri dondurur
# (CFS throttling). LGB_JOBS = min(kota, LGB_JOBS_TAVAN).
def _dosya_oku(yol):
    with open(yol) as f:
        return f.read()


def _cpu_kotasi(tavan=48):
    _q = None
    try:
        _v = _dosya_oku('/sys/fs/cgroup/cpu.max').split()  # cgroup v2
        if _v[0] != 'max':
            _q = int(_v[0]) / int(_v[1])
    except Exception:
        try:
            _qq = int(_dosya_oku('/sys/fs/cgroup/cpu/cpu.cfs_quota_us'))  # cgroup v1
            _pp = int(_dosya_oku('/sys/fs/cgroup/cpu/cpu.cfs_period_us'))
            if _qq > 0:
                _q = _qq / _pp
        except Exception:
            pass
    _n = int(_q) if _q else (os.cpu_count() or 8)
    return max(1, min(_n, tavan))

# HIZ_TESTI: SHAP ve Optuna öncesi kısa bir LightGBM testiyle o anki en hızlı
# thread sayısı seçilir (5-60 sn); node yoğunken çok thread birbirini bekler.
# Notebook'tan: LGB_JOBS_TAVAN = 16 (aday üst sınırı), HIZ_TESTI = False (test yok,
# kota tabanlı sabit sayı).
LGB_JOBS_TAVAN = int(globals().get('LGB_JOBS_TAVAN', 48))
HIZ_TESTI = bool(globals().get('HIZ_TESTI', True))
HIZ_TESTI_ADAYLAR = (8, 16, 24, 32, 48)
LGB_JOBS = _cpu_kotasi(LGB_JOBS_TAVAN)
print(f"[HIZ] cgroup kotası={_cpu_kotasi(10**9)} | tavan={LGB_JOBS_TAVAN} -> LGB n_jobs={LGB_JOBS}"
      + (' (SHAP ve Optuna oncesi hiz testiyle guncellenir)' if HIZ_TESTI else ''))
_HIZ_VERI = None


def _thread_ayarla(adim):
    """O anki en hizli LightGBM thread sayisini olcer; LGB_JOBS ve SHAP_MODEL_JOBS'u gunceller.

    Adaylar kucukten buyuge denenir; bir aday en iyinin 2 katindan yavassa
    daha buyukleri denenmez. En iyiye %15 yakin olanlarin en buyugu secilir
    (gercek veri test verisinden buyuk; esitlikte fazla thread tercih edilir).
    """
    global LGB_JOBS, SHAP_MODEL_JOBS, _HIZ_VERI
    if not HIZ_TESTI:
        return LGB_JOBS
    ust = min(_cpu_kotasi(10**9), LGB_JOBS_TAVAN)
    adaylar = sorted({c for c in HIZ_TESTI_ADAYLAR if c <= ust} or {max(1, ust)})
    if _HIZ_VERI is None:
        # DataFrame: pipeline'daki fit'lerle ayni yol. numpy verilirse eski LightGBM
        # surumleri sklearn >= 1.6 ile her fit'te 'force_all_finite' uyarisi basar.
        _r = np.random.default_rng(0)
        _X = _r.normal(size=(300_000, 150)).astype('float32')
        _y = (_X[:, :10].sum(axis=1) + _r.normal(size=300_000) * 3 > 0).astype(int)
        _HIZ_VERI = (pd.DataFrame(_X, columns=[f'h{i}' for i in range(_X.shape[1])]), _y)
    X_, y_ = _HIZ_VERI
    _ayar = dict(objective='binary', num_leaves=15, max_depth=5, max_bin=63,
                 learning_rate=0.05, min_child_samples=50, verbose=-1)
    lgb.LGBMClassifier(n_estimators=2, n_jobs=adaylar[0], **_ayar).fit(X_.iloc[:20_000], y_[:20_000])
    sureler = {}
    for nj in adaylar:
        t0 = time.time()
        lgb.LGBMClassifier(n_estimators=40, n_jobs=nj, **_ayar).fit(X_, y_)
        sureler[nj] = time.time() - t0
        if sureler[nj] > 2 * min(sureler.values()):
            break
    en_kisa = min(sureler.values())
    secilen = max(nj for nj, t in sureler.items() if t <= 1.15 * en_kisa)
    LGB_JOBS = SHAP_MODEL_JOBS = secilen
    print(f'  [HIZ] {adim}: ' + ', '.join(f'{nj} thread {t:.1f} sn' for nj, t in sureler.items())
          + f' -> n_jobs={secilen} (node yuku {os.getloadavg()[0]:.0f} / {os.cpu_count()} cekirdek)')
    return secilen

