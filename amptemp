                r += len(b) + (1 if _i == 0 else 0) + 1
            ws = xl.book[_sheet]
            _yon = "düşük skor = riskli" if _isaret < 0 else "yüksek skor = riskli"
            _panel_yaz(ws,
                f"{_ad_tr} ile MODEL, 20'li bucket (OOT {_don}): hangisi riskli müşteriyi daha iyi sıralıyor?",
                [
