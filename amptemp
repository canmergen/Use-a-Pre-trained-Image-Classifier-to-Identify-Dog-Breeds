# -*- coding: utf-8 -*-
# =====================================================================
# FPD_TXN_FEATS_2025 + FPD_TXN_FEATS_2026 -> ORTAK kolonlar uzerinden alt alta birlestir
# feature_birlesik.xlsx'teki formullerle yeni feature'lari uret
# -> FPD_TXN_FEATS_ENH
# Yil ayrimi mevcut PERIOD kolonu ile yapilir (ek kolon eklenmez).
# =====================================================================
import io
import re
import time

import numpy as np
import pandas as pd
import pyarrow.dataset as pads
import pyarrow.fs as pafs
import dataiku

# ------------------------- AYARLAR -------------------------
GIRDI_DATASETLER  = ["FPD_TXN_FEATS_2025", "FPD_TXN_FEATS_2026"]   # kolon sirasi ilkinden alinir
CIKTI_DATASET     = "FPD_TXN_FEATS_ENH"
FEATURE_KLASOR    = "COMPLETE_JSON"
FEATURE_DOSYA     = "feature_birlesik.xlsx"
ALINACAK_DURUMLAR = {"KABUL"}            # RED'leri de uretmek istersen: {"KABUL", "RED"}
S3_ENDPOINT       = "loscdlhp.aknet.akb:9000"   # notebook'undaki endpoint; yazimini kontrol et
DONEM_KOL         = "PERIOD"
BOS_DEGERLER      = {"", "-", "nan", "none", "null"}
YASAK_KALIPLAR    = ["import", "__", "exec(", "eval(", "open(", "lambda"]


# ------------------------- 1) OKUMA -------------------------
def s3_ile_oku(ad):
    """Dataset'in parquet dosyalarini S3'ten pyarrow ile paralel okur (get_dataframe'den cok hizli)."""
    d = dataiku.Dataset(ad)
    info = d.get_location_info(sensitive_info=True)["info"]
    cp = info["connectionParams"]
    root = info["path"].replace("s3://", "")

    s3 = pafs.S3FileSystem(
        access_key=cp["accessKey"],
        secret_key=cp["secretKey"],
        endpoint_override=S3_ENDPOINT,
        scheme="https",
        force_virtual_addressing=False,
    )
    dset = pads.dataset(root, filesystem=s3, format="parquet")
    df = dset.to_table(use_threads=True).to_pandas(self_destruct=True, split_blocks=True)

    # Dataiku semasindaki tiplere cevir (int+null -> float vb.), kolon sirasini semaya gore diz
    names, dtypes, date_idx = d.get_dataframe_schema_st(d.read_schema(), int_as_float=True)
    date_cols = {names[i] for i in date_idx} if date_idx else set()
    cast = {c: t for c, t in dtypes.items() if c in df.columns and c not in date_cols}
    return df.astype(cast)[names]


def oku(ad):
    t0 = time.time()
    try:
        df = s3_ile_oku(ad)
        yol = "S3 (pyarrow)"
    except Exception as e:
        print(f"[{ad}] S3'ten dogrudan okunamadi ({type(e).__name__}: {e}) -> get_dataframe ile okunuyor")
        df = dataiku.Dataset(ad).get_dataframe()
        yol = "get_dataframe"
    print(f"[{ad}] {df.shape[0]:,} satir x {df.shape[1]:,} kolon | {yol} | {time.time() - t0:.0f} sn")
    return df


parcalar = {ad: oku(ad) for ad in GIRDI_DATASETLER}


# ------------------------- 2) ORTAK KOLONLAR -------------------------
ilk = parcalar[GIRDI_DATASETLER[0]]
ortak_set = set.intersection(*(set(x.columns) for x in parcalar.values()))
ortak = [c for c in ilk.columns if c in ortak_set]      # sira ilk dataset'ten

print(f"\nOrtak kolon sayisi: {len(ortak):,}")
for ad, x in parcalar.items():
    disarida = [c for c in x.columns if c not in ortak_set]
    if disarida:
        print(f"UYARI: {ad} icinde sadece kendisinde olan {len(disarida)} kolon DISARIDA birakildi: "
              f"{disarida[:30]}{' ...' if len(disarida) > 30 else ''}")
    else:
        print(f"[{ad}] tum kolonlari ortak.")

if DONEM_KOL not in ortak_set:
    raise ValueError(f"{DONEM_KOL} kolonu iki dataset'te ortak degil; yil ayrimi yapilamaz.")

# Ayni isimli ama farkli tipte gelen kolonlar (concat'te object'e donup bozulabilir)
tip_farki = []
for c in ortak:
    tipler = {ad: str(x[c].dtype) for ad, x in parcalar.items()}
    if len(set(tipler.values())) > 1:
        tip_farki.append((c, tipler))
if tip_farki:
    print(f"\nUYARI: {len(tip_farki)} ortak kolonun tipi dataset'ler arasinda farkli:")
    for c, tipler in tip_farki[:30]:
        print(f"  - {c}: {tipler}")

# Donem kontrolu
donemler = {ad: set(x[DONEM_KOL].dropna().unique()) for ad, x in parcalar.items()}
for ad, s in donemler.items():
    print(f"[{ad}] {DONEM_KOL}: {sorted(s)}")
cakisan = set.intersection(*donemler.values())
if cakisan:
    print(f"UYARI: iki dataset'te de bulunan {DONEM_KOL} degerleri: {sorted(cakisan)} "
          f"(bu donemlerin satirlari iki kez gelebilir)")


# ------------------------- 3) BIRLESTIRME (alt alta, ortak kolonlar) -------------------------
df = pd.concat([x[ortak] for x in parcalar.values()], ignore_index=True)
parcalar.clear()   # bellegi bosalt
del ilk

print(f"\nBirlesik df: {df.shape[0]:,} satir x {df.shape[1]:,} kolon")
print(df[DONEM_KOL].value_counts().sort_index().to_string())


# ------------------------- 4) FEATURE TANIMLARINI OKU -------------------------
klasor = dataiku.Folder(FEATURE_KLASOR)
with klasor.get_download_stream(FEATURE_DOSYA) as s:
    fx = pd.read_excel(io.BytesIO(s.read()), sheet_name=0)
fx.columns = [str(c).strip() for c in fx.columns]

eksik = {"ad", "formul", "durum"} - set(fx.columns)
if eksik:
    raise ValueError(f"Excel'de beklenen kolon(lar) yok: {eksik}. Mevcut kolonlar: {list(fx.columns)}")


def bos_mu(x):
    return pd.isna(x) or str(x).strip().lower() in BOS_DEGERLER


fx = fx[fx["durum"].astype(str).str.strip().str.upper().isin(ALINACAK_DURUMLAR)]
fx = fx[~fx["formul"].apply(bos_mu) & ~fx["ad"].apply(bos_mu)].copy()
print(f"\nUretilecek feature tanimi: {len(fx)} (durum: {sorted(ALINACAK_DURUMLAR)})")


# ------------------------- 5) FEATURE URETIMI -------------------------
yeni = {}
hatalar = []
ortam = {"df": df, "np": np, "pd": pd}

for _, r in fx.iterrows():
    ad = str(r["ad"]).strip()
    formul = str(r["formul"]).strip()

    if ad in df.columns or ad in yeni:
        hatalar.append((ad, "bu isimde kolon zaten var", formul))
        continue
    if any(k in formul for k in YASAK_KALIPLAR):
        hatalar.append((ad, "formulde yasak kalip var", formul))
        continue

    kullanilan = re.findall(r"df\[\s*['\"]([^'\"]+)['\"]\s*\]", formul)
    yok = [k for k in kullanilan if k not in df.columns]
    if yok:
        hatalar.append((ad, f"df'te olmayan kolon: {yok}", formul))
        continue

    try:
        sonuc = eval(formul, {"__builtins__": {}}, ortam)
    except Exception as e:
        hatalar.append((ad, f"{type(e).__name__}: {e}", formul))
        continue

    if np.isscalar(sonuc):
        hatalar.append((ad, "formul tek bir sayi dondurdu (seri degil)", formul))
        continue

    seri = sonuc if isinstance(sonuc, pd.Series) else pd.Series(np.asarray(sonuc), index=df.index)
    if len(seri) != len(df):
        hatalar.append((ad, f"uzunluk uyusmuyor ({len(seri)} != {len(df)})", formul))
        continue

    seri = pd.to_numeric(seri, errors="coerce").replace([np.inf, -np.inf], np.nan).astype("float64")
    yeni[ad] = seri

# Tek seferde ekle (kolon kolon eklemek 1000+ kolonlu df'i parcalar, yavaslatir)
if yeni:
    df = pd.concat([df, pd.DataFrame(yeni, index=df.index)], axis=1)


# ------------------------- 6) RAPOR -------------------------
print(f"\nUretilen feature: {len(yeni)} / {len(fx)}")
tamamen_bos = [k for k, v in yeni.items() if v.isna().all()]
sabit = [k for k, v in yeni.items() if not v.isna().all() and v.nunique(dropna=True) <= 1]
if tamamen_bos:
    print(f"UYARI: tamamen NaN olan feature'lar: {tamamen_bos}")
if sabit:
    print(f"UYARI: tek degerli (sabit) feature'lar: {sabit}")
if hatalar:
    print(f"\nUretilemeyen {len(hatalar)} feature:")
    for ad, neden, formul in hatalar:
        print(f"  - {ad}: {neden}\n      formul: {formul[:200]}")

print(f"\nCikti: {df.shape[0]:,} satir x {df.shape[1]:,} kolon")


# ------------------------- 7) YAZMA -------------------------
dataiku.Dataset(CIKTI_DATASET).write_with_schema(df)
print(f"{CIKTI_DATASET} yazildi.")
