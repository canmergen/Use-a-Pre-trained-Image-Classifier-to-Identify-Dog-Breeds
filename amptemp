import dataiku
import pandas as pd

client = dataiku.api_client()
project = client.get_project(dataiku.default_project_key())

# 1) S3 bağlantısı üzerinde MANAGED dataset oluştur
builder = project.new_managed_dataset("AMP_DUMMY")
builder.with_store_into(
    "s3_baglanti_adin",              # <-- kendi S3 connection adın
    format_option_id="PARQUET_HIVE"  # ya da CSV için: CSV_ESCAPING_NOGZIP_FORCTS
)
builder.create()                      # zaten varsa: builder.create(overwrite=True)

# 2) Şemayı da belirlemek için içine bir şey yaz
df = pd.DataFrame({
    "MUS_NO": ["M0001", "M0002", "M0003"],
    "AY": [202401, 202402, 202403],
    "TUTAR": [1250.0, 980.5, 3310.75],
    "HEDEF": [0, 1, 0],
})
dataiku.Dataset("AMP_DUMMY").write_with_schema(df)
