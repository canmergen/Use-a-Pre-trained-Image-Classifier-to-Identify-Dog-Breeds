def _fk_deger(x):
    if isinstance(x, (float, np.floating)) and not np.isfinite(x):
        return None
    return x.item() if hasattr(x, "item") else x


def _fk_tablo(ws, S, r, kolonlar, gruplar, satirlar, tablo_adi, acilis):
    """Dilimleyici alanı + grup bandı + başlık + satırlar + Excel tablosu. acilis: {anahtar: açılışta görünen değer}.
    → (başlık satırı, son satır, kolon numaraları)."""
    C = {k[4]: 2 + i for i, k in enumerate(kolonlar)}
    r_dilim = r
    r_bant = r + 7 if DILIMLEYICI_EKLE else r
    for g in dict.fromkeys(k[0] for k in kolonlar):
        cs = [C[k[4]] for k in kolonlar if k[0] == g]
        S.birlestir(r_bant, cs[0], cs[-1], gruplar[g], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=11, h="center",
                    kenar=_KENAR_B)
    ws.row_dimensions[r_bant].height = 20
    R0 = r_bant + 1
    for k in kolonlar:
        S.hucre(R0, C[k[4]], k[1], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
    ws.row_dimensions[R0].height = 46
    for i, d in enumerate(satirlar):
        rr = R0 + 1 + i
        for k in kolonlar:
            v = _fk_deger(d.get(k[4]))
            x = S.hucre(rr, C[k[4]], v, fmt=k[2], wrap=False, dikey="center", size=10,
                        h="left" if k[4] in ("seg", "ad", "model", "fh", "hedef") else "center")
            if k[4] == "hk" and v in FK_HUKUM_RENK:
                x.fill = PatternFill("solid", fgColor=FK_HUKUM_RENK[v])
                x.font = Font(name=YAZI_TIPI, bold=True, size=10)
            if k[4] == "sonuc" and v in FK_SONUC_RENK:
                x.fill = PatternFill("solid", fgColor=FK_SONUC_RENK[v])
                x.font = Font(name=YAZI_TIPI, bold=True, size=10)
        ws.row_dimensions[rr].height = 18
        if any(str(d.get(a)) != str(b) for a, b in acilis.items() if b is not None):
            ws.row_dimensions[rr].hidden = True                # açılışta yalnızca seçili renk / hedef görünür
    RS = R0 + len(satirlar)
    tab = _tablo_ekle(ws, tablo_adi, R0, RS, 2, [k[1] for k in kolonlar])
    for a, b in acilis.items():
        if b is not None:
            tab.autoFilter.filterColumn.append(FilterColumn(colId=C[a] - 2, filters=Filters(filter=[str(b)])))
    son = [k[4] for k in kolonlar if k[0] == "M"][-1]
    _dilimleyici_alani(ws, tablo_adi, r_dilim, [
        ("Renk Segmenti", "Renk Segmenti", C["seg"], C["model"], 4, N_RENK),
        ("Model", "Model", C["vade"], C["vade"] + 3, 6, 2),
        ("Hedef Süre", "Hedef Süre", C["vade"] + 4, C["vade"] + 6, 4, 3),
        (kolonlar[[k[4] for k in kolonlar].index(son)][1], kolonlar[[k[4] for k in kolonlar].index(son)][1],
         C["vade"] + 7, C["vade"] + 9, 4, 1)])
    return R0, RS, C


