            rng = f"{get_column_letter(c0)}{r0}:{get_column_letter(c1)}{r0 + len(b) - 1}"
            ws.conditional_formatting.add(rng, ColorScaleRule(
                start_type='num', start_value=0, start_color='FFFFFF',
                mid_type='num', mid_value=skala['mid'], mid_color='FFEB84',
