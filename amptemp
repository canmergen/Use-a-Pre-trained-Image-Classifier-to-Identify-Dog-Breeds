            ws = _sheet_yaz(xl, f"HUKUM_OOT_{_don}", _c["hukum"],
                f"HÜKÜM (OOT {_don}): Davranış ve Müşteri skoru varken bu modellere ihtiyaç var mı?",
                [
                    "KİTLE: " + _KITLE_ORTAK,
                    "Her satır bir renk segmenti × bir hedef. GENEL satırı yok: 6 renk modelinin skorları tek sıraya konamaz.",
                    (f"KARAR: GINI FARKI {_yzd(ESIK_GINI_GEREKLI)} ve üstü → MODEL GEREKLİ; 0 ile "
                     f"{_yzd(ESIK_GINI_GEREKLI)} arası → SINIRDA; 0 veya eksi → MEVCUT SKOR YETER."),
                    f"Vaka ya da vaka olmayan müşteri {ESIK_MIN_VAKA}'dan azsa Gini güvenilmez → YETERSİZ VAKA.",
                    "Yakalama kolonları karara girmez, destek bilgisidir.",
                    "Önce KONTROLLER sheet'inde UYARI olmadığına bakın.",
                ],
                [
                    ("SEGMENT", "Renk segmenti."),
                    ("HEDEF", "Ölçülen gerçekleşme (örn. 3M KIRMIZIYA GÖÇ = 3 ay içinde kırmızıya geçti)."),
                    ("KİTLE (adet)", "Bu segmentteki ortak kitle müşteri sayısı. Satırdaki tüm metrikler bu kişiler üzerinden."),
                    ("KİTLE VAKA (adet)", "Bu kişilerden hedefi gerçekleşen sayısı."),
                    ("HEDEF ORANI (%)", "KİTLE VAKA / KİTLE."),
                    ("GINI: DAVRANIŞ / MÜŞTERİ / MODEL (%)", "Skorun vakaları ne kadar üste sıraladığı. 0 = rastgele, %100 = kusursuz, eksi = ters sıralıyor."),
                    ("GINI FARKI: MODEL − EN İYİ MEVCUT (%)", "Model Gini'si eksi iki mevcut skordan yüksek olanın Gini'si. Karar bu kolondan verilir."),
                    ("HÜKÜM", "GINI FARKI'na göre karar (OKUMA NOTLARI'ndaki kural)."),
                    ("YAKALAMA: ... (%)", f"Skorun en riskli %{_RISKLI_YZD}'si işaretlenseydi vakaların yüzde kaçı bu dilimde olurdu."),
                    ("YAKALAMA ÜST SINIRI (%)", f"Kusursuz bir skorun ulaşabileceği en yüksek yakalama (%{_RISKLI_YZD} / hedef oranı). "
                                                "Kırmızı gibi hedef oranı yüksek segmentlerde düşüktür; yakalamayı buna göre okuyun."),
                    ("AÇIKLAMA", "Hükmün tek cümlelik gerekçesi."),
                ])
            _son = get_column_letter(_TABLO_SUTUN + _c["hukum"].shape[1] - 1)
            ws.column_dimensions[_son].width = 80

        # ---- 2) KONTROLLER ----
        _sh = "KONTROLLER"
        _bloklar_k = [
            ("1) HEDEF TANIMLARI", _ktrl_hedef_df),
            ("2) MODEL SKOR DOSYALARI", _ktrl_skor_dosya_df),
            ("3) MODEL KLASÖRÜNDEKİ BUCKET TABLOLARI", _ktrl_model_tablo_df),
            ("4) MEVCUT SKOR KAPSAMASI", _ktrl_kapsama_df),
        ]
        r = _ILK_SATIR - 1
        for _bas, _df in _bloklar_k:
            if _df.empty:
                continue
            _df.to_excel(xl, sheet_name=_sh, index=False, startrow=r + 1, startcol=_TABLO_SUTUN - 1)
            ws = xl.book[_sh]
            ws.cell(row=r + 1, column=_TABLO_SUTUN, value=_bas).font = Font(bold=True, size=12)
            _tablo_bicim(ws, _df.columns, r + 2, r + 2 + len(_df))
            r += len(_df) + 4
        ws = xl.book[_sh]
        _panel_yaz(ws,
            "KONTROLLER: Rapordaki sonuçlara güvenmeden önce bakılacak veri ve eşleşme kontrolleri",
            [
                (f"ÖZET: {_n_uyari} kontrol satırı OK değil." if _n_uyari else "ÖZET: tüm kontroller OK."),
                "DURUM: OK = eşik içinde. UYARI = eşik dışı, nedeni NOT kolonunda. YOK = veri bulunamadı.",
