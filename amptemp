def _yakalama_egrisi(ws, S, satirlar, R0, r):
    """Seçimdeki ilk görünen modelin yakalama eğrisi (model, Davranış, Müşteri ve rastgele sıralama).
    Gizli veri sheet'inde her tablo satırının eğrisi durur; SUBTOTAL ile ilk görünen satır bulunur ve
    grafik o satırın değerlerini çizer. Bir sonraki boş satırı döner."""
    L = get_column_letter
    S.baslik(r, "Yakalama eğrisi: en riskli %X müşteriye bakınca vakaların yüzde kaçı bulunuyor?", c2=_C["aciklama"])
    if not EGRI:
        S.not_satiri(r + 1, "Bu grafik için 14 ANALİZ'in v5 sürümü gerekiyor (YAKALAMA_OOT_ sheet'i); mevcut 14 raporunda yok. "
                            "14'ü v5 ile çalıştırıp bu kodu yeniden çalıştırın.", c2=_C["aciklama"])
        return r + 3
    wv = _veri_sayfasi()
    kc, gc, v0 = 12, 13, 14                                   # L: model, M: görünür mü, N..: 3 x 20 değer
    n_n = len(YAKALAMA_NOKTALARI)
    wv.cell(1, kc, "Model (Model Sonuçları satır sırası)")
    wv.cell(1, gc, "Görünür")
    for j, sk in enumerate(("Model", "Davranış Skoru", "Müşteri Skoru")):
        for p_i, p in enumerate(YAKALAMA_NOKTALARI):
            wv.cell(1, v0 + n_n * j + p_i, f"{sk} %{p}")
    n_veri = 0
    for i, d in enumerate(satirlar):
        rv = 2 + i
        wv.cell(rv, kc, f"{_RENK_ADI[d['kod']]} | {d['ad']}")
        wv.cell(rv, gc, f"=SUBTOTAL(103,'{ws.title}'!${L(_C['ad'])}${R0 + 1 + i})")
        eg = EGRI.get((d["vade"], d["_aile"], d["kod"]), {})
        n_veri += bool(eg)
        for j, sk in enumerate(("MODEL", "Davranış Skoru", "Müşteri Skoru")):
            for p_i, deger in enumerate(eg.get(sk, [])):
                if _sonlu(deger):
                    wv.cell(rv, v0 + n_n * j + p_i, float(deger))
    son = 1 + len(satirlar)
    h0 = son + 3
    idx = f"${L(gc)}${h0}"
    wv.cell(h0, kc, "Seçili satır (ilk görünen)")
    wv.cell(h0, gc, f"=IFERROR(MATCH(1,${L(gc)}$2:${L(gc)}${son},0),0)")
    wv.cell(h0 + 1, kc, "Eğri")
    for p_i, p in enumerate(YAKALAMA_NOKTALARI):
        wv.cell(h0 + 1, v0 + p_i, f"%{p}")
    for j, ad_s in enumerate(("Model", "Davranış Skoru", "Müşteri Skoru")):
        wv.cell(h0 + 2 + j, kc, ad_s)
        for p_i in range(n_n):
            col = L(v0 + n_n * j + p_i)
            rng = f"${col}$2:${col}${son}"
            wv.cell(h0 + 2 + j, v0 + p_i, f'=IF({idx}=0,NA(),IF(INDEX({rng},{idx})="",NA(),INDEX({rng},{idx})))')
    wv.cell(h0 + 5, kc, "Rastgele sıralama")
    for p_i, p in enumerate(YAKALAMA_NOKTALARI):
        wv.cell(h0 + 5, v0 + p_i, p / 100.0)
