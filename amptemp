/* Tum calismayi silen bir islem: sohbet icinde onay kartiyla sorulur.
   native confirm() KULLANILMIYOR - Dataiku iframe'inde akisi bloklar. */
function sifirlaUygula() {
    /* Ucusta bir /mesaj varsa once onu iptal et: gec donen yanit
       sifirlanan durumun uzerine yazmasin. */
    if (mesgul) istegiIptalEt("sifirla");
    kilitle(true);
    rozetGuncelle("mesgul");
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        aktifMod = null;
        TUR_NO = 0;
        sonYanitMetni = null;
        geriAlKilit = null;
        acikFazlar = new Set();
        yanitUygula(d, d.metin || d.cevap);
        sayfaAc("calisma");
    })
    .catch(e => {
        rozetGuncelle("hata");
        balonEkle("bot", "Oturum sıfırlanamadı: " + e, true);
    })
    .finally(() => { kilitle(false); });
}

function sifirlaOnayiSor() {
    const eski = sohbetEl.querySelector(".sifirla-onay");
    if (eski) { eski.querySelector(".secim-onay").focus(); return; }

    const kart = document.createElement("div");
    kart.className = "secim-kart sifirla-onay";

    const bas = document.createElement("div");
    bas.className = "secim-baslik";
    bas.textContent = YENI_CALISMA_ETIKETI + ": mevcut çalışma silinsin mi?";
    kart.appendChild(bas);

    const ack = document.createElement("div");
    ack.className = "secim-aciklama";
    ack.textContent = "Bu işlem sayfayı yenilemez; " + HAFIZA_KLASORU
        + " klasöründeki mevcut çalışmanın TAMAMINI siler ve sıfırdan yeni bir "
        + "çalışma başlatır: sohbet geçmişi, seçimler ve tamamlanan adımlar "
        + "kaybolur. Geri alınamaz.";
    kart.appendChild(ack);

    const dugmeler = document.createElement("div");
    dugmeler.className = "onay-dugmeler";

    const evet = document.createElement("button");
    evet.type = "button";
    evet.className = "secim-onay";
    evet.textContent = "Evet, yeni çalışma başlat";
    evet.onclick = () => { kart.remove(); sifirlaUygula(); };

    const hayir = document.createElement("button");
    hayir.type = "button";
    hayir.className = "secim-onay ikincil";
    hayir.textContent = "Vazgeç";
    hayir.onclick = () => { kart.remove(); kutuEl.focus(); };

    dugmeler.appendChild(evet);
    dugmeler.appendChild(hayir);
    kart.appendChild(dugmeler);

    sohbetEl.appendChild(kart);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    hayir.focus();          // yanlislikla Enter'a basilirsa vazgecilsin
}

document.getElementById("sifirla-btn").onclick = () => {
    sayfaAc("calisma");
    sifirlaOnayiSor();      // once onay: buton "yenile" sanilip tiklaniyordu
};
