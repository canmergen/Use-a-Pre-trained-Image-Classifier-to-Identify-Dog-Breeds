import time
import dataiku

VERI_SETI = "FPD_TXN_FEATS_2025"   # kendi veri setinizin adı

client = dataiku.api_client()
proje = client.get_default_project()
ds = proje.get_dataset(VERI_SETI)

t = time.time()
sema = ds.get_settings().get_raw().get("schema", {}).get("columns", [])
print("Kolon sayısı :", len(sema), "| süre: %.1f sn" % (time.time() - t))

t = time.time()
try:
    ds.compute_metrics(metric_ids=["basic:SIZE", "basic:COUNT_FILES"])
    son = ds.get_last_metric_values()
    print("Boyut (byte) :", son.get_global_value("basic:SIZE"))
    print("Dosya sayısı :", son.get_global_value("basic:COUNT_FILES"))
except Exception as e:
    print("Boyut alınamadı:", e)
print("süre: %.1f sn" % (time.time() - t))

try:
    print("Kayıtlı satır sayısı :",
          ds.get_last_metric_values().get_global_value("records:COUNT_RECORDS"))
except Exception as e:
    print("Kayıtlı satır sayısı yok:", e)
