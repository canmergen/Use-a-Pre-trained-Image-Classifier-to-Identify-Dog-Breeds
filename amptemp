import pandas as pd

# ============================================================
# AKB TAKİP / GECİKME 3M EKLEME + 12M/6M DOĞRULAMA
# ============================================================

KEY = ["MBB_NO", "TARIH"]

TAKIP_CHECK = ["AKB_TAKIP_12M", "AKB_TAKIP_6M"]
GGS_CHECK   = ["AKB_GGS_12_90", "AKB_GGS_6_90"]

NEW_COLS = ["AKB_TAKIP_3M", "AKB_GGS_3_90"]


# ------------------------------------------------------------
# 1. Gerekli kolonlar mevcut mu?
# ------------------------------------------------------------

required_df = KEY + TAKIP_CHECK + GGS_CHECK
required_takip = KEY + TAKIP_CHECK + ["AKB_TAKIP_3M"]
required_gecikme = KEY + GGS_CHECK + ["AKB_GGS_3_90"]

for name, data, cols in [
    ("df", df, required_df),
    ("df_takip", df_takip, required_takip),
    ("df_gecikme", df_gecikme, required_gecikme)
]:
    missing = [c for c in cols if c not in data.columns]

    if missing:
        raise ValueError(
            f"{name} içinde eksik kolon var: {missing}"
        )


# ------------------------------------------------------------
# 2. Join key'lerini aynı formata getir
# ------------------------------------------------------------

for data in [df, df_takip, df_gecikme]:

    data["MBB_NO"] = pd.to_numeric(
        data["MBB_NO"],
        errors="coerce"
    ).astype("Int64")

    data["TARIH"] = pd.to_datetime(
        data["TARIH"],
        errors="coerce"
    ).dt.normalize()


# ------------------------------------------------------------
# 3. Source tarafında MBB_NO + TARIH unique olmalı
# ------------------------------------------------------------

dup_takip = df_takip.duplicated(KEY).sum()
dup_gecikme = df_gecikme.duplicated(KEY).sum()

print(f"df_takip duplicate key   : {dup_takip:,}")
print(f"df_gecikme duplicate key : {dup_gecikme:,}")

if dup_takip > 0 or dup_gecikme > 0:
    raise ValueError(
        "MBB_NO + TARIH source datasetlerde unique değil. "
        "Birleştirme yapılmadı."
    )


# ------------------------------------------------------------
# 4. 12M / 6M kontrol dataseti
# Ana df'ye bu kolonların SQL versiyonları EKLENMİYOR
# ------------------------------------------------------------

check_df = (
    df[
        KEY
        + TAKIP_CHECK
        + GGS_CHECK
    ]
    .merge(
        df_takip[
            KEY + TAKIP_CHECK
        ].rename(
            columns={
                "AKB_TAKIP_12M": "AKB_TAKIP_12M_SQL",
                "AKB_TAKIP_6M":  "AKB_TAKIP_6M_SQL"
            }
        ),
        on=KEY,
        how="left",
        validate="many_to_one"
    )
    .merge(
        df_gecikme[
            KEY + GGS_CHECK
        ].rename(
            columns={
                "AKB_GGS_12_90": "AKB_GGS_12_90_SQL",
                "AKB_GGS_6_90":  "AKB_GGS_6_90_SQL"
            }
        ),
        on=KEY,
        how="left",
        validate="many_to_one"
    )
)


# ------------------------------------------------------------
# 5. Eski değerler ile SQL'den hesaplanan değerleri karşılaştır
# ------------------------------------------------------------

comparisons = [
    ("AKB_TAKIP_12M", "AKB_TAKIP_12M_SQL"),
    ("AKB_TAKIP_6M",  "AKB_TAKIP_6M_SQL"),
    ("AKB_GGS_12_90", "AKB_GGS_12_90_SQL"),
    ("AKB_GGS_6_90",  "AKB_GGS_6_90_SQL")
]

all_ok = True

print("\nKONTROL SONUÇLARI")
print("-" * 75)

for mevcut_col, sql_col in comparisons:

    mevcut = pd.to_numeric(
        check_df[mevcut_col],
        errors="coerce"
    )

    sql = pd.to_numeric(
        check_df[sql_col],
        errors="coerce"
    )

    same = (
        mevcut.eq(sql)
        | (mevcut.isna() & sql.isna())
    )

    farkli = (~same).sum()
    oran = same.mean()

    print(
        f"{mevcut_col:<20} "
        f"Aynı: {same.sum():>12,} | "
        f"Farklı: {farkli:>10,} | "
        f"Eşleşme: {oran:.6%}"
    )

    if farkli > 0:
        all_ok = False


# Artık kontrol datasına ihtiyaç yok
del check_df


# ------------------------------------------------------------
# 6. TÜM KONTROLLER BAŞARILIYSA SADECE 3M'LERİ EKLE
# ------------------------------------------------------------

if all_ok:

    # Notebook hücresi tekrar çalıştırılmışsa _x/_y oluşmasını engelle
    existing_3m = [
        c for c in NEW_COLS
        if c in df.columns
    ]

    if existing_3m:
        raise ValueError(
            f"Bu kolonlar df içinde zaten mevcut: {existing_3m}. "
            "Birleştirme tekrar yapılmadı."
        )

    n_before = len(df)

    df = (
        df
        .merge(
            df_takip[
                KEY + ["AKB_TAKIP_3M"]
            ],
            on=KEY,
            how="left",
            validate="many_to_one"
        )
        .merge(
            df_gecikme[
                KEY + ["AKB_GGS_3_90"]
            ],
            on=KEY,
            how="left",
            validate="many_to_one"
        )
    )

    n_after = len(df)

    if n_before != n_after:
        raise ValueError(
            f"Satır sayısı değişti: "
            f"{n_before:,} -> {n_after:,}"
        )

    print("\n" + "=" * 75)
    print("TÜM KONTROLLER BAŞARILI.")
    print("12M ve 6M değerleri mevcut df ile birebir aynı.")
    print("Birleştirme yapıldı.")
    print("Eklenen kolonlar:")
    print("  - AKB_TAKIP_3M")
    print("  - AKB_GGS_3_90")
    print(f"Satır sayısı: {len(df):,}")
    print("=" * 75)

else:

    print("\n" + "=" * 75)
    print("KONTROL BAŞARISIZ.")
    print("12M / 6M değerlerinden en az biri mevcut df ile farklı.")
    print("3M kolonları df'ye EKLENMEDİ.")
    print("=" * 75)