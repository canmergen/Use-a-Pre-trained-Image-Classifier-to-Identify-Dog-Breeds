    donemler = [str(x) for x in (durum.get("_donemler") or [])]
    if ham.startswith("son:"):
        try:
            n = int(ham[4:])
        except ValueError:
            return None
        en_fazla = max(len(donemler) - 1, 1)
        n = max(1, min(n, en_fazla))
        return {"tur": "son_donem", "deger": None, "adet": n}
