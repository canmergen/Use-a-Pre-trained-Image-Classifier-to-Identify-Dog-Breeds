def _eksen_yazisi(eksen, boyut=8):
    """Eksen etiketlerinin punto boyutu (çok modelde etiketler sığsın diye küçük)."""
    cp = CharacterProperties(sz=boyut * 100)
    eksen.txPr = RichText(p=[Paragraph(pPr=ParagraphProperties(defRPr=cp), endParaRPr=cp)])


def _yukseklik(n):
    """n model için çubuk grafik yüksekliği (cm) ve kapladığı satır sayısı (varsayılan satır = 0,53 cm)."""
    h = max(9.0, 2.8 + 0.85 * n)
    return h, int(np.ceil(h / 0.53)) + 2


def _grafik(ws, tur, baslik, seriler, r0, rs, fmt, renkler, w=16.5, hgt=11.5, ymin=None):
    """Tablo satırlarına bağlı yatay çubuk grafik; kategori = Model Adı, seri = verilen kolonlar."""
    ch = BarChart()
    ch.type = tur
    ch.grouping = "clustered"
    ch.title = baslik
    ch.width, ch.height = w, hgt
    ch.style = 10
    ch.legend.position = "b"
    ch.y_axis.numFmt = fmt
    ch.y_axis.majorGridlines = None
    if ymin is not None:
        ch.y_axis.scaling.min = ymin
    ch.x_axis.scaling.orientation = "maxMin"                  # tablodaki sırayla yukarıdan aşağı
    ch.y_axis.crosses = "max"                                 # değer ekseni altta kalsın
    for anahtar, rk in zip(seriler, renkler):
        c = _C[anahtar]
        s = Series(Reference(ws, min_col=c, min_row=r0, max_row=rs), title_from_data=True)
        s.graphicalProperties.solidFill = rk
        s.graphicalProperties.line.solidFill = rk
        ch.series.append(s)
    ch.set_categories(Reference(ws, min_col=_C["ad"], min_row=r0 + 1, max_row=rs))
    ch.x_axis.tickLblSkip = 1                                 # her modelin adı yazsın
    _eksen_yazisi(ch.x_axis)
    _eksen_yazisi(ch.y_axis)
    ch.x_axis.delete = False
    ch.y_axis.delete = False
    ch.visible_cells_only = True                              # filtrelenen (gizlenen) satırlar çizilmez
    return ch


def _renk_sayfasi(kod, ad_dosya, ad_tr):
    ws = wb.create_sheet(f"{ad_tr} - Model")
    ws.sheet_view.showGridLines = False
    S = Sayfa(ws, _SON_KOL)
    ws.column_dimensions["A"].width = 2
    for i, k in enumerate(KOLONLAR):
        ws.column_dimensions[get_column_letter(2 + i)].width = k[3]

    S.baslik(2, f"{ad_tr} Segmenti: Model Sonuçları", c2=_C["aciklama"])
    R_GRUP, R0 = 5, 6
    for g in ("M", "P", "K", "B"):                            # grup başlık bandı
        cs = [2 + i for i, k in enumerate(KOLONLAR) if k[0] == g]
        S.birlestir(R_GRUP, cs[0], cs[-1], GRUP_ADI[g], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=11,
                    h="center", kenar=_KENAR_B)
    ws.row_dimensions[R_GRUP].height = 20
    for i, k in enumerate(KOLONLAR):                          # tablo başlığı
        S.hucre(R0, 2 + i, k[1], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B)
    ws.row_dimensions[R0].height = 46

    satirlar = []
    for v, aile in _hv:
        p = MODELLER[(v, aile)]["perf"].get(kod, {})
        if kod not in MODELLER[(v, aile)]["renkler"] and not np.isfinite(p.get("oot_gini", np.nan)):
            continue                                          # bu renkte bu hedef-vadenin modeli yok
        kk = KIYAS.get((v, aile, kod), {})
        d = {"ad": f"{v}M {_MODEL_ADI[aile]}", "model": _MODEL_ADI[aile], "vade": v, "_aile": aile,
             **{k: p.get(k, np.nan) for k in ("kitle", "tr_oran", "oot_oran", "tr_gini", "val_gini", "oot_gini",
                                               "top1", "top5", "top10")},
             "kayip": p.get("tr_gini", np.nan) - p.get("oot_gini", np.nan),
             "k_kitle": kk.get("kitle", np.nan), "k_vaka": kk.get("vaka", np.nan), "k_oran": kk.get("oran", np.nan),
             **{k: kk.get(k, np.nan) for k in ("g_dav", "g_mus", "g_mod", "fark", "y_dav", "y_mus", "y_mod")},
             "en_iyi": kk.get("en_iyi"), "hukum": kk.get("hukum"), "aciklama": kk.get("aciklama")}
        for i, b in enumerate(p.get("bucket", [np.nan] * 20), start=1):
            d[f"b{i}"] = b
        satirlar.append(d)
    S.not_satiri(3, f"Model dönemi: {MODEL_DONEMI} | OOT: {OOT_DONEMI} | {len(satirlar)} model | Tablonun Model veya "
                    "Hedef Süre filtre okundan bir ya da birden çok model seçin; grafikler yalnızca seçilen satırları çizer.",
                 c2=_C["aciklama"])
    for i, d in enumerate(satirlar):
        rr = R0 + 1 + i
        for k in KOLONLAR:
            v = d.get(k[4])
            if isinstance(v, float) and not np.isfinite(v):
                v = None
            x = S.hucre(rr, _C[k[4]], v, fmt=k[2], wrap=k[4] in ("aciklama",), dikey="center",
                        h="left" if k[4] in ("ad", "model", "aciklama") else "center")
            if k[4] == "hukum" and isinstance(v, str):
                x.fill = PatternFill("solid", fgColor=_HUKUM_RENK.get(v.split(":")[0], "FFFFFF"))
                x.font = Font(name=YAZI_TIPI, bold=True, size=10)
                x.alignment = Alignment(wrap_text=True, vertical="center", horizontal="center")
        ws.row_dimensions[rr].height = 30
    RS = R0 + len(satirlar)
    if not satirlar:
        return
    tab = Table(displayName=f"Model_{ad_dosya}", ref=f"B{R0}:{get_column_letter(_SON_KOL)}{RS}")
    tab.tableStyleInfo = TableStyleInfo(name="TableStyleLight1", showRowStripes=False)
    ws.add_table(tab)
    L = get_column_letter
    ws.conditional_formatting.add(f"{L(_C['oot_gini'])}{R0+1}:{L(_C['oot_gini'])}{RS}",
                                  ColorScaleRule(start_type="min", start_color="F8696B", mid_type="percentile",
                                                 mid_value=50, mid_color="FFEB84", end_type="max", end_color="63BE7B"))
    ws.conditional_formatting.add(f"{L(_C['fark'])}{R0+1}:{L(_C['fark'])}{RS}",
                                  ColorScaleRule(start_type="num", start_value=0, start_color="FFFFFF",
                                                 end_type="num", end_value=0.3, end_color="63BE7B"))
    for rr in range(R0 + 1, RS + 1):                          # bucket satırı ısı haritası (her model kendi içinde)
        ws.conditional_formatting.add(f"{L(_C['b1'])}{rr}:{L(_C['b20'])}{rr}",
                                      ColorScaleRule(start_type="min", start_color="FFFFFF", end_type="max",
                                                     end_color="F8696B"))
    ws.freeze_panes = "C1"                                    # Model Adı kolonu sabit

    # ---- Grafikler ----
    r = RS + 2
    S.baslik(r, "Grafikler (tablonun filtresinden seçilen modeller)", c2=_C["aciklama"])
    S.not_satiri(r + 1, "Tablonun Model / Hedef Süre filtre okundan istediğiniz modelleri işaretleyin (birden çok seçilebilir); "
                        "grafikler yalnızca görünen satırları çizer. Slicer isterseniz: tabloya tıklayın > Tablo Tasarımı > "
                        "Dilimleyici Ekle.", c2=_C["aciklama"], yuk=30)
    hgt, adim = _yukseklik(len(satirlar))
    a1 = r + 3
    ws.add_chart(_grafik(ws, "bar", "Gini (pipeline): Train / Val / OOT", ["tr_gini", "val_gini", "oot_gini"],
                         R0, RS, "0.00", ("DC0005", "A6A6A6", "404040"), hgt=hgt), f"B{a1}")
    ws.add_chart(_grafik(ws, "bar", "OOT Gini: model ve mevcut skorlar", ["g_dav", "g_mus", "g_mod"],
                         R0, RS, "0%", ("A6A6A6", "404040", "DC0005"), hgt=hgt, ymin=0), f"{L(_C['tr_gini'])}{a1}")
    a2 = a1 + adim
    ws.add_chart(_grafik(ws, "bar", f"En riskli {_YZD} yakalama (OOT): model ve mevcut skorlar", ["y_dav", "y_mus", "y_mod"],
                         R0, RS, "0%", ("A6A6A6", "404040", "DC0005"), hgt=hgt, ymin=0), f"B{a2}")
    ws.add_chart(_grafik(ws, "bar", "Top %1 / %5 / %10 yakalama (pipeline, OOT)", ["top1", "top5", "top10"],
                         R0, RS, "0%", ("F4B6B7", "EA5A5C", "DC0005"), hgt=hgt, ymin=0), f"{L(_C['tr_gini'])}{a2}")
    # Bucket eğrileri: her satır bir çizgi (filtrelenen satırın çizgisi görünmez)
    a3 = a2 + adim
    lc = LineChart()
    lc.title = "Bucket hedef oranı (OOT), B1 = en riskli %5 | çizgi: 3M düz, 6M kesik, 12M noktalı"
    lc.width, lc.height = 34, 11
    lc.style = 10
    lc.legend.position = "b"
    lc.y_axis.numFmt = "0%"
    lc.y_axis.scaling.min = 0
    _ust = max([d[f"b{i}"] for d in satirlar for i in range(1, 21) if np.isfinite(d[f"b{i}"])] or [0])
    if _ust > 0.8:                                            # oranlar %100'e yaklaşıyorsa eksen %100'de dursun
        lc.y_axis.scaling.max = 1
    lc.y_axis.majorGridlines = None
    for i in range(len(satirlar)):
        rr = R0 + 1 + i
        s = Series(Reference(ws, min_col=_C["b1"], max_col=_C["b20"], min_row=rr, max_row=rr))
        s.tx = SeriesLabel(strRef=StrRef(f"'{ws.title}'!${L(_C['ad'])}${rr}"))   # seri adı = Model Adı hücresi
        s.graphicalProperties.line.solidFill = _CIZGI_RENK.get(satirlar[i]["_aile"], "7F7F7F")
        s.graphicalProperties.line.dashStyle = _CIZGI_TIPI.get(satirlar[i]["vade"], "solid")
        s.graphicalProperties.line.width = 22000
        s.smooth = False
        lc.series.append(s)
    lc.set_categories(Reference(ws, min_col=_C["b1"], max_col=_C["b20"], min_row=R0, max_row=R0))
    lc.x_axis.delete = False
    lc.y_axis.delete = False
    _eksen_yazisi(lc.x_axis)
    _eksen_yazisi(lc.y_axis)
    lc.visible_cells_only = True
    ws.add_chart(lc, f"B{a3}")
    ws.page_setup.orientation = "landscape"
    ws.page_setup.fitToWidth = 1
    ws.page_setup.fitToHeight = 0
    ws.sheet_properties.pageSetUpPr.fitToPage = True
    _log(f"   {ad_tr} - Model: {len(satirlar)} model | karşılaştırması olan: "
         f"{sum(1 for d in satirlar if d.get('hukum'))} | bucket eğrisi olan: "
