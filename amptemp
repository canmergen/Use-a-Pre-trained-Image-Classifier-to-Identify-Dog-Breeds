def _seri_d(seri, son):
    ad, kotu, notu = _SERI_D[seri]
    r = _seri_d_ham(seri, son, ad, kotu)
    return (r[0] + notu, r[1]) if r else None


def _seri_d_ham(seri, son, ad, kotu):
    kotu_yon = "düşüş kötü" if kotu < 0 else "artış kötü"
    m = re.match(r"^EGIM_(3|6|12)M$", son)
    if m:
        return (f"Son {m.group(1)} ayın {ad} değerlerine çizilen en küçük kareler doğrusunun eğimi (birim / ay); "
                "en az 3 dolu ay gerekir.", f"Pozitif = zamanla artış, negatif = azalış; {ad} için {kotu_yon}.")
    tablo = {
        "GECERLI_AY": (f"Son 12 ayda {ad} dolu olan ay sayısı.", f"Diğer {seri}_D değerlerinin kaç aya dayandığı."),
        "IVME": (f"{_bas(ad)}: (son 3 ay ort. - 4-6. aylar ort.) - (4-6. aylar ort. - 7-9. aylar ort.).",
                 "Değişim hızlanıyor mu; " + ("negatif = düşüş hızlanıyor." if kotu < 0 else "pozitif = artış hızlanıyor.")),
        "ARTIS_SERI": (f"Son aydan (LM) geriye {ad} değerinin kesintisiz arttığı geçiş sayısı.", "Kaç aydır her ay artıyor."),
        "AZALIS_SERI": (f"Son aydan (LM) geriye {ad} değerinin kesintisiz azaldığı geçiş sayısı.", "Kaç aydır her ay azalıyor."),
        "ARTIS_ADET_12M": (f"Son 12 aydaki 11 aylık geçişte {ad} değerinin arttığı geçiş sayısı.", "Bir yılda kaç kez arttı."),
        "AZALIS_ADET_12M": (f"Son 12 aydaki 11 aylık geçişte {ad} değerinin azaldığı geçiş sayısı.", "Bir yılda kaç kez azaldı."),
        "MAX_AYLIK_ARTIS": (f"Son 12 ayda tek bir aydan diğerine {ad} değerindeki en büyük artış (yoksa 0).",
                            "En sert aylık artış."),
        "MAX_AYLIK_AZALIS": (f"Son 12 ayda tek bir aydan diğerine {ad} değerindeki en büyük azalış (yoksa 0).",
                             "En sert aylık azalış."),
        "YON_DEGISIM_12M": (f"Son 12 ayda {ad} değerinde artış ile azalış arasında yön kaç kez tersine döndü "
                            "(sabit aylar atlanır).", "Seri zikzak mı tek yönlü mü."),
        "ZSKOR_LM": (f"(Son ay {ad} - L2M..L12M ortalaması) / L2M..L12M standart sapması; en az 3 geçmiş ay ve std > 0.",
                     "Son ay müşterinin kendi geçmişine göre ne kadar sıra dışı; -2 altı = alışılmadık düşük, "
                     "+2 üstü = alışılmadık yüksek."),
        "ZIRVEDEN_FARK": (f"Son 12 aydaki en yüksek {ad} eksi son ay (LM) değeri.", "Zirvenin ne kadar altında."),
        "DIPTEN_FARK": (f"Son ay (LM) {ad} eksi son 12 aydaki en düşük değer.", "Dibin ne kadar üstünde; 0 = şu an dipte."),
        "AY_SON_ZIRVE": (f"Son 12 ayda en yüksek {ad} değerinin görüldüğü en yeni ay. " + _AY_NOTU, "Zirve ne kadar önceydi."),
