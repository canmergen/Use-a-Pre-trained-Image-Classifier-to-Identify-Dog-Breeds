SHAP_SCORE_TOL = 0.003       # Capture eşitlik bandının tabanı (0-1 ölçeği).
# Capture eşitlik bandı: tol = min(max(SHAP_SCORE_TOL, SHAP_TOL_SE_KATSAYI x SE),
#   SHAP_MAX_KAYIP x tavan); SE = en iyi setin fold std'si / sqrt(SHAP_CV) (1-SE).
# Bu bant içindeki setler Capture bakımından eşit sayılır.
SHAP_TOL_SE_KATSAYI = 1.0
# SET SEÇİMİ: 1) Capture'ı en iyiye bant içinde yakın setler aday kalır.
