def _fk_grupla(skor_riskli_buyuk, nb=FK_N_GRUP):
    """Eşit adetli nb grup; skor büyük = riskli; 1 = en riskli (14 ANALİZ _bucketla_riskli ile aynı)."""
    s = np.asarray(skor_riskli_buyuk, dtype="float64")
    n = len(s)
    if n == 0:
        return np.array([], dtype=int)
    order = np.argsort(s, kind="stable")
    r = np.empty(n, dtype="float64")
    r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
    return (nb - np.searchsorted(edges[1:-1], r, side="left")).astype(int)


def _fk_gini(y, skor_riskli_buyuk):
    """Gini = 2 x AUC - 1 (eşit skorlar yarım sayılır). Tek sınıf ya da boşsa NaN."""
    y = np.asarray(y, dtype="float64")
    s = np.asarray(skor_riskli_buyuk, dtype="float64")
    ok = np.isfinite(y) & np.isfinite(s)
    y, s = y[ok], s[ok]
    n1 = float((y == 1).sum())
    n0 = float(len(y) - n1)
    if n1 == 0 or n0 == 0:
        return np.nan
    rank = pd.Series(s).rank(method="average").to_numpy()
    auc = (rank[y == 1].sum() - n1 * (n1 + 1) / 2.0) / (n1 * n0)
    return float(2.0 * auc - 1.0)


def _fk_tamsayi(s):
    return pd.to_numeric(s, errors="coerce").round().astype("Int64")


