def _cocuklar(yol):
    det = mf.get_path_details(yol) or {}
    return det.get("children") or []


def _alt_klasorler():
    kl = sorted(c["name"] for c in _cocuklar("/") if c.get("directory"))
    if not kl:
        kl = sorted({p.strip("/").split("/")[0]
                     for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    return kl


def _dosyalar(klasor):
    ad = [c["name"] for c in _cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition()
              if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


def _model_klasorleri():
    """Ana klasördeki model klasörleri (ARSIV hariç); hedef sırası (NO:1 → NO:5), vade ve OOT'a göre.
    Dönen: [{'klasor', 'vade', 'aile', 'oot'}, ...]"""
    haric = {h.upper() for h in HARIC_KLASORLER}
    bulunan, taninmayan = [], []
    for ad in _alt_klasorler():
        if ad.upper() in haric:
            continue
        m = KLASOR_RE.match(ad)
        if not m:
            taninmayan.append(ad)
            continue
        bulunan.append({"klasor": ad, "vade": int(m.group(1)), "aile": m.group(2),
                        "oot": int(m.group(3))})
    if taninmayan:
        _log(f"ⓘ Adı tanınmayan klasör (okunmadı): {taninmayan}")
    _sira = list(HEDEF_AILELERI)
    return sorted(bulunan, key=lambda k: (_sira.index(k["aile"]), k["vade"], k["oot"]))


def _sheet_adi(m, kullanilan):
    """Excel sheet adı en fazla 31 karakter ve benzersiz olmalı.
    Örn. 12M_ICINDE_KIRMIZI_RENGE_GOC_OOT202506 → 12M_ICINDE_KRM_GOC_OOT_202506"""
    s = f"{m['vade']}M_{HEDEF_AILELERI[m['aile']][0]}_OOT_{m['oot']}"[:31]
    aday, i = s, 2
    while aday in kullanilan:
        ek = f"_{i}"
        aday = s[:31 - len(ek)] + ek
        i += 1
    kullanilan.add(aday)
    return aday


def _renk_sira(x):
    """'2-TURUNCU' -> 2 (renk modeli sıralaması için)."""
    return int(str(x).split("-")[0])


