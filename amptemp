# --- SHAPRFECV (yerel uygulama; probatus / shap paketi gerekmez) --------------
# Her turda CV fold'larında model eğitilir, val fold'unda Capture@10 ve Gini
# ölçülür, SHAP önemi (LightGBM pred_contrib, TreeSHAP) val fold'unda hesaplanır ve
# ortalama |SHAP| en düşük feature'lar atılır. Rapor: her turun feature sayısı,
# seti ve CV skorları.
class Scorer:
    def __init__(self, metric_name, custom_scorer):
        self.metric_name = metric_name
        self.scorer = custom_scorer

    def score(self, model, X, y):
        return float(self.scorer(model, X, y))


def _orneklem_std(x):
    """Fold skorlarinin orneklem std'si (ddof=1); 1-SE kuralindaki standart hata bunu kullanir."""
    x = np.asarray([v for v in x if np.isfinite(v)], dtype='float64')
    return float(np.std(x, ddof=1)) if len(x) >= 2 else (0.0 if len(x) == 1 else np.nan)


class ShapRFECV:
    def __init__(self, model, step=0.15, min_features_to_select=1, cv=None,
                 scoring=None, n_jobs=1, step_ust=None, step_esik=None,
                 shap_max_rows=None, skor_p=None, train_skoru=True, random_state=0):
        if not isinstance(step, (int, float)) or step <= 0:
            raise ValueError(f'Gecersiz step: {step}')
        self.model = model
        self.step = step
        self.min_features_to_select = max(int(min_features_to_select), 1)
        self.cv = cv
        self.scorer = scoring
        self.step_ust = step_ust
        self.step_esik = step_esik
        self.shap_max_rows = shap_max_rows
        self.skor_p = skor_p
        self.train_skoru = train_skoru
        self.random_state = random_state
        self.report_df = pd.DataFrame()

    def _silinecek_sayisi(self, n):
        if self.step_ust and self.step_esik and n > self.step_esik:
            # Kaba eleme; esige cok yaklasacaksa dogrudan esige iner.
            k = max(int(np.floor(n * self.step_ust)), 1)
            k_ince = (self.step if isinstance(self.step, int)
                      else max(int(np.floor(self.step_esik * self.step)), 1))
            if n - k <= self.step_esik + k_ince:
                k = n - self.step_esik
        else:
            k = self.step if isinstance(self.step, int) else max(int(np.floor(n * self.step)), 1)
        return max(min(k, n - self.min_features_to_select), 0)

    @staticmethod
    def _gini(y, p):
        # AUC sinifa gore alt orneklemeden etkilenmez; agirlik gerekmez.
        y = np.asarray(y)
        if len(np.unique(y)) < 2:
            return np.nan
        return 2 * roc_auc_score(y, p) - 1

    @staticmethod
    def _shap_degerleri(model, X):
        katki = np.asarray(model.predict(X, pred_contrib=True), dtype='float64')
        if katki.ndim != 2 or katki.shape[1] != X.shape[1] + 1:
            raise ValueError(f'pred_contrib boyutu beklenmedik: {katki.shape}')
        return katki[:, :-1]

    def fit_compute(self, X, y, sample_weight=None, check_additivity=False):
        _obj = list(X.columns[X.dtypes == object])
        if _obj:
            X = X.copy()
            for c in _obj:
                X[c] = X[c].astype('category')
        y = pd.Series(np.asarray(y), index=X.index)
        sw = None if sample_weight is None else np.asarray(sample_weight, dtype='float64')
        splits = list(self.cv.split(X, y)) if hasattr(self.cv, 'split') else list(self.cv)
        # SHAP satirlari her fold icin bir kez secilir; tum turlarda ayni satirlar.
        # Pozitifler orneklemin yarisindan azsa hepsi alinir, negatifler orneklenir
        # ve agirliklandirilir: ortalama |SHAP| tum fold'un tahminiyle ayni olcekte.
        _rng = np.random.default_rng(self.random_state)
        _y_np = y.to_numpy()
        shap_satir = []
        for _, iva in splits:
            if self.shap_max_rows is None or len(iva) <= self.shap_max_rows:
                shap_satir.append((None, None))
                continue
            _yv = _y_np[iva]
            _pos, _neg = np.flatnonzero(_yv == 1), np.flatnonzero(_yv != 1)
            if 0 < len(_pos) <= self.shap_max_rows // 2:
                _n_neg = min(len(_neg), self.shap_max_rows - len(_pos))
                _sec = np.sort(np.r_[_pos, _rng.choice(_neg, _n_neg, replace=False)])
                shap_satir.append((_sec, np.where(_yv[_sec] == 1, 1.0, len(_neg) / max(_n_neg, 1))))
            else:
                shap_satir.append((np.sort(_rng.choice(len(iva), self.shap_max_rows, replace=False)), None))

        satirlar = []
        _t0 = time.time()
        mevcut = kalan = list(X.columns)
        while len(mevcut) > self.min_features_to_select:
            mevcut = kalan
            Xc = X[mevcut]
            shap_parcalar, shap_agirlik, s_tr, s_va, g_va = [], [], [], [], []
            for (itr, iva), (ss, ww) in zip(splits, shap_satir):
                m = clone(self.model)
                if sw is None:
                    m.fit(Xc.iloc[itr], y.iloc[itr])
                else:
                    m.fit(Xc.iloc[itr], y.iloc[itr], sample_weight=sw[itr])
                if self.train_skoru:
                    s_tr.append(self.scorer.score(m, Xc.iloc[itr], y.iloc[itr]))
                X_va, y_va = Xc.iloc[iva], y.iloc[iva]
                p_va = m.predict_proba(X_va)[:, 1]
                s_va.append(float(self.skor_p(y_va, p_va)) if self.skor_p is not None
                            else self.scorer.score(m, X_va, y_va))
                g_va.append(self._gini(y_va, p_va))
                shap_parcalar.append(self._shap_degerleri(m, X_va if ss is None else X_va.iloc[ss]))
                shap_agirlik.append(ww)
            if all(w is None for w in shap_agirlik):
                onem = np.abs(np.concatenate(shap_parcalar, axis=0)).mean(axis=0)
            else:
                _W = np.concatenate([np.ones(len(sp)) if w is None else w
                                     for sp, w in zip(shap_parcalar, shap_agirlik)])
                onem = (_W @ np.abs(np.concatenate(shap_parcalar, axis=0))) / _W.sum()
            sira = np.argsort(-onem, kind='mergesort')
            k = self._silinecek_sayisi(len(mevcut))
            silinen = [mevcut[i] for i in sira[len(mevcut) - k:]] if k else []
            _sil = set(silinen)
            kalan = [c for c in mevcut if c not in _sil]
            satirlar.append({
                'num_features': len(mevcut), 'features_set': list(mevcut),
                'eliminated_features': silinen,
                'train_metric_mean': float(np.mean(s_tr)) if s_tr else np.nan,
                'train_metric_std': _orneklem_std(s_tr),
                'val_metric_mean': float(np.mean(s_va)), 'val_metric_std': _orneklem_std(s_va),
                'val_gini_mean': float(np.nanmean(g_va)), 'val_gini_std': _orneklem_std(g_va),
            })
            if globals().get('SHAP_ILERLEME', True):
                print(f'    tur {len(satirlar):>2}: {len(mevcut):>3} feature | '
                      f'CV Capture={np.mean(s_va):.4f} Gini={np.nanmean(g_va):.4f} | '
                      f'{(time.time() - _t0) / 60:.1f} dk', flush=True)
        self.report_df = pd.DataFrame(satirlar, index=range(1, len(satirlar) + 1))
        return self.report_df

    def get_reduced_features_set(self, num_features):
        eslesen = self.report_df[self.report_df['num_features'] == num_features]
        if eslesen.empty:
            raise ValueError(f'{num_features} feature hicbir turda olusmadi: '
                             f'{sorted(self.report_df["num_features"].unique())}')
        return list(eslesen.iloc[0]['features_set'])

