class Sayfa:
    """Bir sheet'e hücre / birleşik hücre / bölüm başlığı yazan küçük yardımcı."""
    def __init__(self, ws, son):
        self.ws, self.son = ws, son

    def hucre(self, r, c, v=None, bold=False, fill=None, wrap=True, h="left", italic=False, renk="000000",
              size=11, fmt=None, kenar=_KENAR, dikey=None):
        x = self.ws.cell(r, c, v)
        x.font = Font(name=YAZI_TIPI, bold=bold, italic=italic, color=renk, size=size)
        x.alignment = Alignment(wrap_text=wrap, vertical=dikey or ("center" if h == "center" else "top"),
                                horizontal=h)
        if fill:
            x.fill = fill
        if fmt:
            x.number_format = fmt
        if kenar:
            x.border = kenar
        return x

    def birlestir(self, r, c1, c2, v=None, **k):
        for c in range(c1, c2 + 1):
            self.hucre(r, c, None, fill=k.get("fill"), kenar=k.get("kenar", _KENAR))
        if c2 > c1:
            self.ws.merge_cells(start_row=r, start_column=c1, end_row=r, end_column=c2)
        return self.hucre(r, c1, v, **k)

    def baslik(self, r, metin, c1=2, c2=None):
        self.birlestir(r, c1, c2 or self.son, metin, bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=12)
        self.ws.row_dimensions[r].height = 20

    def satir(self, r, etiket, metin, yuk=18, c_metin=3):
        if c_metin > 3:
            self.birlestir(r, 2, c_metin - 1, etiket, bold=True, dikey="center")
        else:
            self.hucre(r, 2, etiket, bold=True, dikey="center")
        self.birlestir(r, c_metin, self.son, metin, dikey="center")
        self.ws.row_dimensions[r].height = yuk

    def not_satiri(self, r, metin, c1=2, c2=None, yuk=16):
        self.birlestir(r, c1, c2 or self.son, metin, italic=True, renk="595959", size=10, kenar=None)
        self.ws.row_dimensions[r].height = yuk


