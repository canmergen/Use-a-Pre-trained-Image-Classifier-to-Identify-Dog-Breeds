# --- Feature listesi: df'teki TUM kolonlar - LEAK_COLS - kimlik/hedef ---
# Kural: LEAK_COLS kesin liste; disindaki her kolon temiz ve aday.
# SHAPRFECV + korelasyon elemesi gereksizleri zaten atiyor.

# Leakage degil ama modele GIRMEMESI gerekenler: kimlik, tarih, hedef,
# populasyon filtresi ve model ayi rengi (renk bazli model zaten buna gore
# ayriliyor). Cogu LEAK_COLS'ta da var; burada ikinci guvence.
KIMLIK_HEDEF = {'MBB_NO', 'TARIH', 'DONEM', 'TARGET', 'KK_URUN_FLG', 'RENK'}

# Bu hucre "4 Target Tanimlama"dan SONRA calisiyor. Target hucresi df'e ara
# kolon eklediyse (TARGET_*, *_HEDEF vb.) LEAK_COLS'ta olmadiklari icin
# otomatik listeye girerlerdi -> hedef sizintisi. Adinda TARGET / HEDEF
# gecen her kolon disarida.
def _hedef_kolonu_mu(c):
    u = str(c).upper()
    return 'TARGET' in u or 'HEDEF' in u

_hedef_benzeri = [c for c in df.columns
                  if _hedef_kolonu_mu(c) and c not in LEAK_COLS and c not in KIMLIK_HEDEF]

_aday = [c for c in df.columns
         if c not in LEAK_COLS and c not in KIMLIK_HEDEF and not _hedef_kolonu_mu(c)]

# Metin/ID gibi gorunen kolonlar (CAT_COLS disinda, cok fazla farkli deger)
# modele girmesin; varsa listelenir. object ve pandas 'string' tipleri.
_metin_id = [c for c in _aday
             if (pd.api.types.is_object_dtype(df[c]) or pd.api.types.is_string_dtype(df[c]))
             and c not in CAT_COLS
             and df[c].nunique(dropna=True) > 50]
RAW_FEATURES = [c for c in _aday if c not in _metin_id]

