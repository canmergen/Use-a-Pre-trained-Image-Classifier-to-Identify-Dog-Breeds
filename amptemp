# 1e) DSN DESEN TABLOSU: model paketlerindeki (renk_<kod>_<ad>_model.pkl) desen tabloları
# ------------------------------------------------------------------
# SQL'deki DSN_* ifadeleri bu tabloyu okur: KLASOR (model klasörü), RENK_KOD (model rengi),
# DESEN_ADI, DESEN (anahtar), ORAN, PAY. Her desen için DESEN = '#NADIR#' satırı nadir oranı taşır
# (train'de görülmemiş desen bu oranı alır, payı 0).
# ==================================================================
def _desen_tablosu(klasorler, renkler):
    satirlar, okunan, hata = [], 0, []
    for kl in klasorler:
        for kod, ad in renkler:
            yol = f"/{kl}/renk_{kod}_{ad}_model.pkl"
            try:
                with mf.get_download_stream(yol) as s:
                    ham_bayt = s.read()
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore")
                    paket = pickle.loads(ham_bayt)
            except Exception as e:
                hata.append(f"{yol} ({type(e).__name__})")
                continue
            ds = paket.get("desen_kodlama") if isinstance(paket, dict) else None
            if not ds or not ds.get("haritalar"):
                continue
            okunan += 1
            for desen, h in ds["haritalar"].items():
                for k, o in h.get("oran", {}).items():
                    satirlar.append((kl, int(kod), desen, str(k), float(o), float(h.get("pay", {}).get(k, 0.0))))
                satirlar.append((kl, int(kod), desen, "#NADIR#", float(h.get("nadir_oran", np.nan)), 0.0))
    tablo = pd.DataFrame(satirlar, columns=["KLASOR", "RENK_KOD", "DESEN_ADI", "DESEN", "ORAN", "PAY"])
    return tablo, okunan, hata


def _sql_satirla(sorgu, genislik=180):
    """Uzun satırları tırnak dışındaki boşluklardan böler (SQL*Plus gibi araçların satır sınırı için)."""
    out = []
    for satir in sorgu.split("\n"):
        while len(satir) > genislik:
            tirnak, kes = False, -1
            for i, ch in enumerate(satir):
                if ch == "'":
                    tirnak = not tirnak
                elif ch == " " and not tirnak and i <= genislik:
                    kes = i
                elif i > genislik and kes > 0:
                    break
            if kes <= 0:
                break
            out.append(satir[:kes])
            satir = "      " + satir[kes + 1:]
        out.append(satir)
    return "\n".join(out)


