def _sn_ilk(anahtar):
    v = [x[anahtar] for x in _SN_MODELLER if x.get(anahtar) is not None and
         not (isinstance(x[anahtar], float) and not np.isfinite(x[anahtar]))]
    return v[0] if v else None


def _sn_sayfa_secim():
    _bd_sayfa_sil(SN_SECIM_SAYFA)
    ws = _yeni_sayfa(SN_SECIM_SAYFA, _bd_genislik(_SN_K_MODEL, _SN_K_FEAT))
    son = 1 + len(_SN_K_MODEL)
    S = Sayfa(ws, son)
    r = 2
    S.baslik(r, "Kullanılan modeller ve feature seçim kriteri", c2=son)
    r += 1
    havuz, aday = _sn_ilk("havuz"), _sn_ilk("aday")
    aralik = _sn_ilk("aralik") or "25-50"
    adim_ust = globals().get("SHAP_STEP_UST", 0.15)
    adim_esik = globals().get("SHAP_STEP_ESIK", 50)
    adim = globals().get("SHAP_STEP", 5)
    tol = _sn_ilk("tol")
    n_iter = globals().get("N_ITER")
