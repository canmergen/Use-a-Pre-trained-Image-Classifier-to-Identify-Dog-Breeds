# 1c) PYTHON KOD SATIRI: feature'ın feature engineering kaynak kodunda üretildiği satır
# ------------------------------------------------------------------
# FE fonksiyonlarının kaynağı (inspect) okunur; out[...] = ... atamalarının anahtarı (f-string
# dahil) kalıba çevrilir ve feature adıyla eşleşen en özel kalıbın satırı alınır.
# ==================================================================
_FE_FONKSIYONLAR = ["_renk_features", "_renk_yol_features", "_dav_features", "_mms_features", "_kkb_features",
                    "_odeme_features", "_ratio_features", "_kk_features", "_fe_seri_dinamik", "_seri_dinamik_features",
                    "_eszamanli_features", "_gizli_kotulesme_features", "_int_degisim_features",
                    "_borc_varlik_features", "_kk_olay_features", "_odeme_kullanim_features",
                    "_yeni_baslangic_features", "_oncu_gecikme_features", "_dis_skor_features", "_summ",
                    "_trend_delta", "_desen_kodla"]


def _ast_metin(node):
    """Sabit metin düğümünün değeri (Python 3.8+ ast.Constant, eski sürümlerde ast.Str); değilse None."""
    if isinstance(node, ast.Constant) and isinstance(getattr(node, "value", None), str):
        return node.value
    if type(node).__name__ == "Str":
        return node.s
    return None


def _kod_kaliplari():
    """[(regex, fonksiyon, kod satırı, sabit karakter sayısı)]"""
    kaliplar = []
    for fn_ad in _FE_FONKSIYONLAR:
        fn = globals().get(fn_ad)
        if not callable(fn):
            continue
        try:
            src = textwrap.dedent(inspect.getsource(fn))
            agac = ast.parse(src)
        except Exception:
            continue
        satirlar = src.splitlines()
        for node in ast.walk(agac):
            if not (isinstance(node, ast.Assign) and len(node.targets) == 1
                    and isinstance(node.targets[0], ast.Subscript)):
                continue
            hedef = node.targets[0]
            if not (isinstance(hedef.value, ast.Name) and hedef.value.id in ("out", "fr")):
                continue
            anahtar = hedef.slice
            anahtar = getattr(anahtar, "value", anahtar) if type(anahtar).__name__ == "Index" else anahtar
            if _ast_metin(anahtar) is not None:
                rx, sabit = re.escape(_ast_metin(anahtar)), len(_ast_metin(anahtar))
            elif isinstance(anahtar, ast.JoinedStr):
                parca, sabit = [], 0
                for v in anahtar.values:
                    if _ast_metin(v) is not None:
                        parca.append(re.escape(_ast_metin(v)))
                        sabit += len(_ast_metin(v))
                    else:
                        parca.append("(.+?)")
                rx = "".join(parca)
            elif isinstance(anahtar, ast.Name) and anahtar.id in ("c_o", "c_p"):
                rx, sabit = (r"DSN_(.+?)_KOT_ORAN" if anahtar.id == "c_o" else r"DSN_(.+?)_PAY"), 9
            else:
                continue
            bas = node.lineno - 1
            son = getattr(node, "end_lineno", node.lineno)
            kod = " ".join(s.strip() for s in satirlar[bas:son])
            kaliplar.append((re.compile(rx), fn_ad, kod[:400], sabit))
    return kaliplar


def _kod_satiri(ad, kaliplar, fonk=""):
    """Eşleşen kalıplardan önce feature'ın kendi fonksiyonundakini, yoksa pencere özetlerini (_summ, _trend_delta)
    ve seri hareketini (_fe_seri_dinamik), en son en özel (sabit kısmı en uzun) kalıbı seçer."""
    uyan = [k for k in kaliplar if k[0].fullmatch(ad)]
    if not uyan:
        return "", ""
    if re.search(r"_(AVG|STD|MIN|MAX|MED)_L(3M|6M|12M)$", ad) and not ad.startswith("KKB_SKOR_"):
        sira = ("_summ",)                                  # pencere özetleri 5. hücredeki _summ ile
    elif re.search(r"_(TREND_3_46|TREND_6_712|DELTA_1_2)$", ad) and not ad.startswith("KKB_SKOR_"):
        sira = ("_trend_delta",)
    else:
        sira = (fonk, "_fe_seri_dinamik")
    for tercih in sira:
        aday = [k for k in uyan if tercih and k[1] == tercih]
        if aday:
            rx, fn_ad, kod, _ = max(aday, key=lambda k: k[3])
            return fn_ad, kod
    rx, fn_ad, kod, _ = max(uyan, key=lambda k: k[3])
    return fn_ad, kod


# ==================================================================
# 1d) SQL TESTİ: örnek satırlarda SQL'i (sqlite3) çalıştırıp Python FE çıktısıyla karşılaştırır
# ------------------------------------------------------------------
# Oracle'da olmayan küçük farklar sqlite için çevrilir: GREATEST / LEAST / SIGN / SQRT Python
# fonksiyonu olarak tanımlanır; tamsayı bölmesi olmasın diye " / " → " * 1.0 / ". Mantık aynıdır.
# ==================================================================
def _sqlite_baglanti():
    con = sqlite3.connect(":memory:")
    con.create_function("GREATEST", -1, lambda *a: None if any(x is None for x in a) else max(a))
    con.create_function("LEAST", -1, lambda *a: None if any(x is None for x in a) else min(a))
    con.create_function("SIGN", 1, lambda x: None if x is None else (x > 0) - (x < 0))
    con.create_function("SQRT", 1, lambda x: None if x is None else math.sqrt(x))
    return con


def _sql_test(G, girdi, beklenen, featurelar, ara_kolonlar, dsn_python=None):
    """Feature → test sonucu metni. girdi: FE'ye verilen ham kolonlar (örnek); beklenen: FE çıktısı;
    dsn_python: {ARA_DSN_<desen>: Python'daki anahtar Series} (yoksa DSN anahtar testi atlanır)."""
    sonuc = {}
    n = len(girdi)
    con = _sqlite_baglanti()
    tablo = girdi.copy()
    for c in tablo.columns:
        if c in G.ham and tablo[c].dtype == object:
            sayi = pd.to_numeric(tablo[c], errors="coerce")
            if sayi.notna().sum() >= tablo[c].notna().sum() * 0.99:
                tablo[c] = sayi
    tablo.insert(0, "SATIR_NO_TEST", np.arange(n))
    if "RENK" not in tablo.columns:
        tablo["RENK"] = np.nan
    tablo.to_sql("KAYNAK_TABLO", con, index=False)
    ciktilar = list(dict.fromkeys(featurelar + ara_kolonlar + (list(dsn_python) if dsn_python else [])))
    for o in G.oge.values():
        o.pop("katman", None)
    sorgu = G.tam_sorgu(ciktilar, kaynak="KAYNAK_TABLO", anahtarlar=("SATIR_NO_TEST",)).replace(" / ", " * 1.0 / ")
    for o in G.oge.values():
        o.pop("katman", None)
    s = pd.read_sql_query(sorgu, con).sort_values("SATIR_NO_TEST").reset_index(drop=True)
    con.close()
    beklenen = beklenen.reset_index(drop=True)
    for f in featurelar:
        if f not in beklenen.columns:
            sonuc[f] = "test edilmedi (Python çıktısında yok)"
            continue
        a = pd.to_numeric(beklenen[f], errors="coerce").to_numpy("float64")
        b = pd.to_numeric(s[f], errors="coerce").to_numpy("float64")
        not_ = ""
        if f.endswith("_D_ZSKOR_LM"):
            std = pd.to_numeric(s.get(f"ARA_{f.split('_')[0]}_G_STD"), errors="coerce")
            ort = pd.to_numeric(s.get(f"ARA_{f.split('_')[0]}_G_ORT"), errors="coerce")
            if std is not None and ort is not None:
                sabit = (std.to_numpy("float64") <= 1e-9 * (np.abs(ort.to_numpy("float64")) + 1))
                k = int(((np.isnan(a) != np.isnan(b)) & sabit).sum())
                a, b = np.where(sabit, np.nan, a), np.where(sabit, np.nan, b)
                not_ = f"; {k} satırda seri sabit (std = 0, z-skor tanımsız) atlandı" if k else ""
        na, nb = np.isnan(a), np.isnan(b)
        ok = ~na & ~nb
        fark = int((na != nb).sum() + (~np.isclose(a[ok], b[ok], rtol=2e-6, atol=1e-6)).sum())
        sonuc[f] = (f"AYNI ({n:,} satır{not_})" if fark == 0 else f"FARKLI: {fark:,} / {n:,} satır{not_}")
    for k, beklenen_k in (dsn_python or {}).items():
        a = beklenen_k.reset_index(drop=True).astype(str).to_numpy()
        b = s[k].astype(str).to_numpy()
        fark = int((a != b).sum())
        sonuc[k] = f"AYNI ({n:,} satır)" if fark == 0 else f"FARKLI: {fark:,} / {n:,} satır"
    return sonuc


