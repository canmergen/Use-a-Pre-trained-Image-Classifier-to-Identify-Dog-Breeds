def _sn_yzd(x, nd=1):
    return ("%" + format(100 * x, f".{nd}f")).replace(".", ",") if x is not None and np.isfinite(x) else "?"


def _sn_sayi(x):
    try:
        v = float(x)
    except (TypeError, ValueError):
        return np.nan
    return v if np.isfinite(v) else np.nan


def _sn_deger(x):
    if x is None or x is pd.NA:
        return None
    if isinstance(x, (float, np.floating)) and not np.isfinite(x):
        return None
    return x.item() if hasattr(x, "item") else x


def _sn_hucre(ws, r, c, v, fmt=None, bold=False, sol=False, dolgu=None):
    x = ws.cell(r, c, _sn_deger(v))
    x.font, x.border = (_sn_font_k if bold else _sn_font), _KENAR
    x.alignment = _sn_sola if sol else _sn_ortala
    if fmt:
        x.number_format = fmt
    if dolgu:
        x.fill = dolgu
    return x


def _sn_donem(v):
    try:
        return str(int(float(v)))
    except (TypeError, ValueError):
        return "?"


