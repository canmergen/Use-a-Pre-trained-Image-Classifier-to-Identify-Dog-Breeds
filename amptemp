        S.hucre(mh, 2, "Model ↓  PredCs →", bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=9)
        for j in range(G + 1):
            S.hucre(mh, 3 + j, f"B{j + 1}" if j < G else "Toplam", bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center",
                    kenar=_KENAR_B, size=10)
        ws.row_dimensions[mh].height = 22
        for i in range(G + 1):
            rr = mh + 1 + i
            top_s = i == G
            S.hucre(rr, 2, f"B{i + 1}" if not top_s else "Toplam", bold=True, fill=_ALT if top_s else None, h="center")
            for j in range(G + 1):
                top_k = j == G
                if isinstance(kaynak, tuple):                  # oran: aynı konumdaki pay / payda
                    f = f'=IFERROR({L(3 + j)}{r_mat[kaynak[0]] + 2 + i}/{L(3 + j)}{r_mat[kaynak[1]] + 2 + i},"")'
                elif top_s:
                    f = f"=SUM({L(3 + j)}{mh + 1}:{L(3 + j)}{mh + G})"
                elif top_k:
                    f = f"=SUM({L(3)}{rr}:{L(2 + G)}{rr})"
                else:
                    f = "=" + kaynak(i * G + j + 1)
                S.hucre(rr, 3 + j, f, fmt=fmt, h="center", size=9, bold=top_s or top_k,
                        fill=_ALT if (top_s or top_k) else None)
            ws.row_dimensions[rr].height = 15
        ws.conditional_formatting.add(f"{L(3)}{mh + 1}:{L(2 + G)}{mh + G}", ColorScaleRule(
            start_type="min", start_color="FFFFFF", end_type="max", end_color=renk))

    # ---- seçimin özetleri (tablolardan formülle): her FPD hedefi için bir blok
    def ozet_yaz(r0, bant, basliklar, k0, v0, yak_bas):
        """k0, v0: kişi ve vaka tablolarının ilk veri satırı."""
        def blok(t0, i1, i2, j1, j2):
            return f"SUM({L(2 + j1)}{t0 + i1 - 1}:{L(2 + j2)}{t0 + i2 - 1})"

        top_k, top_v = f"{L(c_top)}{k0 + G}", f"{L(c_top)}{v0 + G}"
        S.birlestir(r0 - 1, 2, c_top, bant, bold=True, fill=_ALT, dikey="center")
        for j, t_ in enumerate([""] + basliklar):
            S.birlestir(r0, 2 if j == 0 else 3 + (j - 1) * 2, 2 if j == 0 else 4 + (j - 1) * 2, t_, bold=True, fill=_BOLUM,
                        renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
        for i, (ad_, (i1, i2, j1, j2)) in enumerate([
                ("Bütün müşteriler", (1, G, 1, G)), ("İkisi de riskli", (1, u, 1, u)),
                ("Yalnız model riskli", (1, u, u + 1, G)), ("Yalnız PredCs riskli", (u + 1, G, 1, u)),
                ("İkisi de risksiz", (u + 1, G, u + 1, G))]):
            rr = r0 + 1 + i
            kf, vf = blok(k0, i1, i2, j1, j2), blok(v0, i1, i2, j1, j2)
            S.hucre(rr, 2, ad_, bold=i == 0, dikey="center")
            for j, (f, fmt) in enumerate([(f"={kf}", "#,##0"), (f'=IFERROR({kf}/{top_k},"")', "0.0%"), (f"={vf}", "#,##0"),
                                          (f'=IFERROR({vf}/{kf},"")', "0.00%"), (f'=IFERROR({vf}/{top_v},"")', "0.0%")]):
                S.birlestir(rr, 3 + j * 2, 4 + j * 2, f, fmt=fmt, h="center", dikey="center", size=10, bold=i == 0)
        yak_m, yak_p = blok(v0, 1, u, 1, G), blok(v0, 1, G, 1, u)
        S.birlestir(r0, 14, c_top, yak_bas, bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
        for i, (ad_, f) in enumerate([("Model", f'=IFERROR({yak_m}/{top_v},"")'), ("PredCs", f'=IFERROR({yak_p}/{top_v},"")'),
                                      ("İkisinden biri", f'=IFERROR(({yak_m}+{yak_p}-{blok(v0, 1, u, 1, u)})/{top_v},"")')]):
            S.birlestir(r0 + 1 + i, 14, 17, ad_, dikey="center", size=10)
            S.birlestir(r0 + 1 + i, 18, c_top, f, fmt="0.0%", h="center", dikey="center", size=10, bold=True)

    for t, h in enumerate(fpd_adlar):
        ozet_yaz(r_ozetler[t], f"Seçimin özeti: {h} (vaka = {h} = 1 olan müşteri; riskli = en riskli %{_BD_RISKLI_YZD}, "
                               f"B1-B{u})",
                 ["Kişi", "Kişi payı", f"{h} vaka", "Oran (vaka / kişi)", "Vakaların payı"], r_mat[0] + 2, r_mat[1 + t] + 2,
                 f"{h} vakalarını yakalama (en riskli %{_BD_RISKLI_YZD})")
    # ---- listeler ve anahtarlar (gizli kolonlarda)
    for j, (bas_, deg) in enumerate([("Model listesi", modeller), ("Dönem listesi", donemler),
                                     ("Renk listesi", ["Tümü"] + renkler)]):
        S.hucre(lh, cl + j, bas_, bold=True, size=9, kenar=None)
        for i, d_ in enumerate(deg):
            S.hucre(lh + 1 + i, cl + j, d_, size=9, kenar=None)
    S.hucre(lh, cl + 3, "Veri bloğu anahtarı", bold=True, size=9, kenar=None)
    for i, a_ in enumerate(anahtarlar):
        S.hucre(lh + 1 + i, cl + 3, a_, size=9, kenar=None)
    # ---- veri tablosu (tabloların kaynağı; her model x dönem x renk için 20 x 20 = 400 satır, sabit sırada)
    S.baslik(r_veri, "Veri: model x dönem x renk x modelin grubu x PredCs'nin grubu (tabloların kaynağı; sırası "
                     "değiştirilmemeli)", c2=c_top)
    vk = ["Model", "Dönem", "Renk Segmenti", "Model Grubu", "PredCs Grubu", "Kişi"] + [f"{h} Vaka" for h in fpd_adlar]
    for j, c in enumerate(vk):
        S.hucre(r_veri + 1, 2 + j, c, bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
    etiket = [f"B{i + 1}" for i in range(G)]
    sifir = [0.0] * G2
    rr = v1
    for x_ in _BD_T_X:
        kolonlar = [x_["kisi"].tolist()] + [x_["fpd"][h].tolist() if h in x_["fpd"] else sifir for h in fpd_adlar]
        for q in range(G2):
            for j, val in enumerate((x_["ad"], x_["donem"], x_["seg"], etiket[q // G], etiket[q % G])):
                ws.cell(rr, 2 + j, val).font = _bd_font
            for j, kol_ in enumerate(kolonlar):
                c = ws.cell(rr, 7 + j, kol_[q])
                c.font, c.number_format = _bd_font, "#,##0"
            rr += 1
    _tablo_ekle(ws, "Model_PredCs_Capraz", r_veri + 1, rr - 1, 2, vk)
    for c in range(cl, cl + 6):                                # seçim listeleri ve formül yardımcıları gizli kolonlarda
        ws.column_dimensions[L(c)].hidden = True
    _yazdir(ws)
    return ws


