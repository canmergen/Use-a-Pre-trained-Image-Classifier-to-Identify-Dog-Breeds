import dataiku
import os
import shutil

DRY_RUN   = True                     # True: sadece ne taşınacağını listeler, False: gerçekten taşır
ARSIV_ADI = "ARSIV"                  # GOC_MODEL_RESULTS içinde açılacak klasör
folder    = dataiku.Folder("GOC_MODEL_RESULTS")

def _arsiv_mi(yol):
    return yol.strip("/").split("/")[0] == ARSIV_ADI

def _tum_dosyalar(f, path="/"):
    """Folder'ı kökten recursive gezer, tüm dosya yollarını döner."""
    detay = f.get_path_details(path)
    out = []
    for c in detay.get("children", []):
        if c.get("directory"):
            out += _tum_dosyalar(f, c["fullPath"])
        else:
            out.append(c["fullPath"])
    return out

# Folder yerel diskteyse get_path() çalışır, değilse (S3, HDFS vb.) hata verir
try:
    kok = folder.get_path()
    yerel = True
except Exception:
    yerel = False

print(f"Folder tipi: {'yerel disk' if yerel else 'uzak depolama (stream ile kopyalanacak)'}")
print(f"Hedef: GOC_MODEL_RESULTS/{ARSIV_ADI}/ | DRY_RUN = {DRY_RUN}\n")

if yerel:
    # --- Yerel disk: üst seviyedeki her şeyi doğrudan ARSIV içine taşı ---
    tasinacaklar = [e for e in sorted(os.listdir(kok)) if e != ARSIV_ADI]
    print(f"Taşınacak ({len(tasinacaklar)}):")
    for e in tasinacaklar:
        print("  -", e)

    if not DRY_RUN:
        hedef_kok = os.path.join(kok, ARSIV_ADI)
        os.makedirs(hedef_kok, exist_ok=True)
        for e in tasinacaklar:
            shutil.move(os.path.join(kok, e), os.path.join(hedef_kok, e))
        print(f"\nTamamlandı: {len(tasinacaklar)} öğe {ARSIV_ADI}/ içine taşındı.")

else:
    # --- Uzak depolama: önce ARSIV içine kopyala, kopya tamsa orijinali sil ---
    dosyalar = [p for p in _tum_dosyalar(folder) if not _arsiv_mi(p)]
    ust_seviye = sorted({p.strip("/").split("/")[0] for p in dosyalar})
    print(f"Taşınacak üst seviye öğe ({len(ust_seviye)}), toplam dosya: {len(dosyalar)}")
    for e in ust_seviye:
        print("  -", e)

    if not DRY_RUN:
        hatalar = []
        for p in dosyalar:
            hedef = f"/{ARSIV_ADI}/{p.strip('/')}"
            try:
                with folder.get_download_stream(p) as s:
                    folder.upload_stream(hedef, s)
            except Exception as ex:
                hatalar.append((p, str(ex)))

        if hatalar:
            print(f"\n⚠ {len(hatalar)} dosya kopyalanamadı, orijinaller SİLİNMEDİ:")
            for p, ex in hatalar[:20]:
                print("  ", p, "->", ex)
        else:
            for e in ust_seviye:
                folder.delete_path("/" + e)
            print(f"\nTamamlandı: {len(dosyalar)} dosya {ARSIV_ADI}/ içine taşındı, orijinaller silindi.")
