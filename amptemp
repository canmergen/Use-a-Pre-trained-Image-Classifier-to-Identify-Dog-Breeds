_ST_KK_A = ((_ST_VERI["KK_URUN_FLG"] == "KK").to_numpy() if ST_KK_FILTRE and "KK_URUN_FLG" in _ST_VERI.columns
            else np.ones(len(_ST_VERI), dtype=bool))


def _st_satirlar(kod, donem, kolonlar):
    """Pipeline kitlesi (KK, renk, dönem); ST_ORNEK_N'den fazlaysa sabit tohumla örnek.
    → (tablo, kitle sayısı, kitlenin tamamının müşteri numaraları)"""
    pos = np.flatnonzero((_ST_RENK_A == kod) & (_ST_DONEM_A == donem) & _ST_KK_A)
    n_kitle = len(pos)
    kitle_k = (np.unique(pd.to_numeric(_ST_VERI["MBB_NO"].iloc[pos], errors="coerce").dropna().to_numpy("float64"))
               if "MBB_NO" in _ST_VERI.columns else None)
    if ST_ORNEK_N and n_kitle > ST_ORNEK_N:
        pos = np.sort(np.random.RandomState(ST_TOHUM + int(donem) % 1000 + kod).choice(pos, ST_ORNEK_N, replace=False))
    kol = [c for c in dict.fromkeys(kolonlar) if c in _ST_VERI.columns]
    return _ST_VERI.iloc[pos, [_ST_VERI.columns.get_loc(c) for c in kol]], n_kitle, kitle_k


def _st_egitim_skorlari(klasor, kod, ad, donemler):
    """Pipeline'ın eğitimde yazdığı müşteri skorları → {dönem: DataFrame(k = müşteri no, s = skor)}.
    musteri_skorlari.csv train dönemini (train + val) ve OOT'yi içerir; yoksa yalnızca OOT dosyası okunur."""
    dosyalar = set(_dosyalar(klasor))
    adaylar = [f"renk_{kod}_{ad}_musteri_skorlari.csv", f"renk_{kod}_{ad}_musteri_skorlari_oot.csv"]
    if ST_SKOR_KONTROL == "OOT":
        adaylar = adaylar[::-1]
    for dosya in adaylar:
        if dosya not in dosyalar:
            continue
        with mf.get_download_stream(f"/{klasor}/{dosya}") as s:
            t = pd.read_csv(s, usecols=lambda c: c in {"mbb_no", "donem", "target_score"})
        if not {"mbb_no", "donem", "target_score"} <= set(t.columns):
            continue
        t = pd.DataFrame({"k": pd.to_numeric(t["mbb_no"], errors="coerce"), "d": pd.to_numeric(t["donem"], errors="coerce"),
                          "s": pd.to_numeric(t["target_score"], errors="coerce")}).dropna(subset=["k", "d"])
        out = {int(d): g[["k", "s"]].drop_duplicates("k").reset_index(drop=True) for d, g in t.groupby("d")
               if int(d) in donemler}
        if out:
            return out
    return {}


def _st_uretim(egitim, kitle_k, mbb_ornek, skor, aile):
    """Yeniden üretim kontrolü (bir model x dönem). egitim: eğitimdeki skorlar (k, s); kitle_k: yeni verideki kitlenin
    müşteri numaraları (örneklemeden önce); mbb_ornek / skor: skorlanan müşteriler ve yeniden üretilen skorları."""
    if egitim is None or not len(egitim) or kitle_k is None or mbb_ornek is None:
        return {"durum": "Eğitim skoru yok"}                  # eğitim skoru dosyası ya da MBB_NO yok
    ek = np.unique(egitim["k"].to_numpy("float64"))
    vk = kitle_k if kitle_k is not None else np.array([], dtype="float64")
    eksik, fazla = int(len(np.setdiff1d(ek, vk, assume_unique=True))), int(len(np.setdiff1d(vk, ek, assume_unique=True)))
    a = pd.DataFrame({"k": pd.to_numeric(pd.Series(mbb_ornek), errors="coerce").to_numpy("float64"), "s1": skor})
    j = a.dropna(subset=["k"]).merge(egitim.rename(columns={"s": "s2"}), on="k", how="inner")
    fark = (j["s1"] - j["s2"]).to_numpy("float64")
    ayni = int((np.abs(fark) <= ST_FARK_TOL).sum())
    farkli = j.assign(fark=fark).loc[np.abs(fark) > ST_FARK_TOL]
    farkli = farkli.reindex(farkli["fark"].abs().sort_values(ascending=False).index).head(ST_FARK_ORNEK)
    farkli["k"] = farkli["k"].round().astype("int64")
    if len(j) and ayni < len(j):
        durum = "Skor farklı"
    elif eksik:
        durum = "Eğitim müşterisi eksik"
    elif fazla and aile not in _ST_DISLAYAN:
        durum = "Kitle farklı"
    else:
        durum = "Birebir aynı" if len(j) else "Eğitim skoru yok"
    return {"durum": durum, "n_egitim": len(ek), "n_veri": len(vk), "eksik": eksik, "fazla": fazla, "karsilastirilan": len(j),
            "ayni": ayni, "ayni_pay": ayni / len(j) if len(j) else np.nan,
            "max_fark": float(np.abs(fark).max()) if len(fark) else np.nan,
            "farklar": farkli.rename(columns={"k": "mbb_no", "s2": "skor_egitim", "s1": "skor_yeni"}).to_dict("records")}


_st_modeller = [(kod, v, a) for kod, v, a in TUM_MODELLER
                if (ST_RENKLER is None or kod in ST_RENKLER) and (ST_VADELER is None or v in ST_VADELER)
                and (ST_HEDEFLER is None or a in ST_HEDEFLER) and kod in MODELLER[(v, a)]["renkler"]]
_ST_DON = dict(ST_DONEMLER)
_st_donem_var = set(pd.to_numeric(_ST_VERI["DONEM"], errors="coerce").dropna().astype(int).unique())
_log(f"Stabilite: {len(_st_modeller)} model | karşılaştırılan dönemler: "
     + ", ".join(f"{e} {d}" + ("" if d in _st_donem_var else " (veride yok)") for e, d in _ST_DON.items()))
_ST_SONUC = []                                                # model başına: kimlik, paket bilgisi, dönem istatistikleri
