def _sn_sayfa_grafik():
    from openpyxl.drawing.image import Image as XLImage
    _bd_sayfa_sil(SN_GRAFIK_SAYFA)
    kol_px = 75                                                  # 10 karakterlik kolon ~ 75 piksel
    n_kol = int(math.ceil((SN_GRAFIK_GENISLIK_PX + 20) / kol_px))
    son = 1 + SN_GRAFIK_YAN_YANA * n_kol
    ws = _yeni_sayfa(SN_GRAFIK_SAYFA, {c: 10 for c in range(2, son + 1)})
    S = Sayfa(ws, son)
    r = 2
    S.baslik(r, "Feature seçim grafikleri: eleme boyunca CV Gini (her model x renk segmenti)", c2=son)
    r += 1
    S.not_satiri(r, "Solda bütün eleme (bütün adaylardan 1 feature'a), sağda seçim aralığı büyütülmüş; işaretli nokta seçilen "
                    "set. Train içi 3 katlı çapraz doğrulama, eleme modeli (sabit parametre). Seçim kriteri ve tablolar "
                    f"'{SN_SECIM_SAYFA}' sheet'inde.", c2=son, yuk=30)
    r += 2
    try:
        from PIL import Image as PILImage
    except Exception:
        PILImage = None
    n_resim = 0
    for m in _BD_MODELLER:
        kl = m["klasor"]
        S.baslik(r, f"{m['vade']}M {m['model']}  ({kl})", c2=son)
        r += 1
        renkler = [k for k in m["renkler"]]
        if not any((k, kl) in _SN_GRAFIK for k in renkler):
            S.not_satiri(r, "Bu klasörde seçim grafiği yok: model pipeline v16 öncesiyle eğitilmiş, SHAPRFECV çalışmamış "
                            "(ör. pozitif sayısı yetersiz, yedek seçim) ya da ortamda matplotlib yoktu. Durum "
                            f"'{SN_SECIM_SAYFA}' sheet'indeki Seçim Kuralı kolonunda.", c2=son)
            r += 2
            continue
        for i in range(0, len(renkler), SN_GRAFIK_YAN_YANA):
            grup = renkler[i:i + SN_GRAFIK_YAN_YANA]
            yuk_px = 0
            for j, kod in enumerate(grup):
                c = 2 + j * n_kol
                x = ws.cell(r, c, _seg_etiket(kod))
                x.font = Font(name=YAZI_TIPI, bold=True, size=11)
                ham = _SN_GRAFIK.get((kod, kl))
                if ham is None:
                    y = ws.cell(r + 1, c, "Grafik yok (bu renkte SHAPRFECV çalışmamış olabilir)")
                    y.font = Font(name=YAZI_TIPI, italic=True, size=10, color="595959")
                    continue
                buf = BytesIO(ham)
                en, boy = 2080, 896
                if PILImage is not None:
                    im = PILImage.open(BytesIO(ham))
                    en, boy = im.size
                    hedef = 2 * SN_GRAFIK_GENISLIK_PX                # ekranda net kalsın, dosya küçülsün
                    if en > hedef:
                        im = im.resize((hedef, int(boy * hedef / en)), PILImage.LANCZOS)
                    buf = BytesIO()
                    im.save(buf, format="PNG", optimize=True)
                    buf.seek(0)
                img = XLImage(buf)
                img.width, img.height = SN_GRAFIK_GENISLIK_PX, int(boy * SN_GRAFIK_GENISLIK_PX / en)
                ws.add_image(img, f"{get_column_letter(c)}{r + 1}")
                yuk_px = max(yuk_px, img.height)
                n_resim += 1
            r += 2 + int(math.ceil(yuk_px / 20.0))
        r += 1
    _yazdir(ws)
    return ws, n_resim


