import dataiku, zipfile, tempfile, shutil, os

# ---- Ayarlar ----
FOLDER_NAME      = "GOC_MODEL_RESULTS"
ZIP_NAME         = "CCY_RENK_SONUCLAR.zip"
TARGET_PREFIX    = "/CCY_RENK_SONUCLAR"   # "" yaparsan folder köküne açar
OVERWRITE        = False                  # True: aynı yoldaki dosyaların üzerine yazar
DELETE_ZIP_AFTER = False                  # True: hatasız biterse zip'i siler
CHUNK            = 16 * 1024 * 1024       # 16 MB'lık parçalarla indir

f = dataiku.Folder(FOLDER_NAME)
paths = f.list_paths_in_partition()
existing = set(paths)

# 1) Zip'i adıyla bul (ilk bulduğu zip'i değil)
matches = [p for p in paths if p.lstrip("/").lower() == ZIP_NAME.lower()]
if not matches:
    raise Exception(f"{ZIP_NAME} bulunamadı. Klasördeki zip'ler: "
                    + str([p for p in paths if p.lower().endswith('.zip')]))
zip_path = matches[0]
print("Seçilen zip:", zip_path)

def fix_name(info):
    """Windows'ta sıkıştırılmış zip'lerde Türkçe karakterli isimleri düzeltir."""
    name = info.filename
    if info.flag_bits & 0x800:          # isim zaten UTF-8 işaretli
        return name
    raw = name.encode("cp437")
    for enc in ("utf-8", "cp857"):      # cp857 = Türkçe DOS kodlaması
        try:
            return raw.decode(enc)
        except UnicodeDecodeError:
            pass
    return name

tmp_dir = tempfile.mkdtemp()
local_zip = os.path.join(tmp_dir, "archive.zip")
added, skipped, errors = [], [], []

try:
    # 2) Zip'i RAM yerine geçici diske parça parça indir
    print("Boş disk (GB):", round(shutil.disk_usage(tmp_dir).free / 1024**3, 2))
    with f.get_download_stream(zip_path) as s, open(local_zip, "wb") as out:
        shutil.copyfileobj(s, out, length=CHUNK)
    print("İndirildi (GB):", round(os.path.getsize(local_zip) / 1024**3, 2))

    # 3) Her dosyayı tek tek folder'a yaz
    with zipfile.ZipFile(local_zip) as z:
        for info in z.infolist():
            if info.is_dir():
                continue
            name = fix_name(info).replace("\\", "/").lstrip("/")
            base = os.path.basename(name)
            # Mac çöpleri ve güvensiz yolları atla
            if name.startswith("__MACOSX/") or base.startswith("._") or ".." in name.split("/"):
                skipped.append(name)
                continue

            target = TARGET_PREFIX.rstrip("/") + "/" + name
            if target in existing and not OVERWRITE:
                skipped.append(target)
                continue

            try:
                with z.open(info) as src:
                    f.upload_stream(target, src)
                added.append(target)
                print("eklendi:", target)
            except Exception as e:
                errors.append((target, str(e)))
                print("HATA:", target, e)
finally:
    shutil.rmtree(tmp_dir, ignore_errors=True)   # geçici zip'i temizle

print(f"\nEklenen: {len(added)} | Atlanan: {len(skipped)} | Hata: {len(errors)}")
if skipped:
    print("Atlananlar (ilk 20):", skipped[:20])

# 4) Zip'i sadece istenirse ve hata yoksa sil
if DELETE_ZIP_AFTER and not errors and added:
    f.delete_path(zip_path)
    print("zip silindi:", zip_path)
