import re
import time
import pandas as pd
import dataiku
from io import BytesIO

# =====================================================================
# AYARLAR
# =====================================================================
MAIN_FOLDER   = "GOC_MODEL_RESULTS"
CIKTI_DOSYA   = "/kalan_featurelar_tum.xlsx"     # kök dizine tek dosya

# True: kökteki tüm klasörler taranır | False: sadece aşağıdaki liste
TUM_KLASORLER = False
KLASORLER = [
    "3M_ICINDE_KIRMIZI_RENGE_GOC_OOT202506",
    "6M_ICINDE_KIRMIZI_RENGE_GOC_OOT202506",
    "12M_ICINDE_KIRMIZI_RENGE_GOC_OOT202506",
    "3M_ICINDE_KIRMIZI_TAKIP_OOT202506",
    "6M_ICINDE_KIRMIZI_TAKIP_OOT202506",
    "12M_ICINDE_KIRMIZI_TAKIP_OOT202506",
    "3M_TAKIP_OOT202506",
    "6M_TAKIP_OOT202506",
    "12M_TAKIP_OOT202506",
]

FEATURE_DOSYA_RE = re.compile(r"^renk_(\d+)_(.+?)_kalan_featurelar\.csv$")

mf = dataiku.Folder(MAIN_FOLDER)
_T0 = time.time()


def _log(mesaj):
    """Geçen süreyle birlikte anında ekrana basar."""
    dk, sn = divmod(int(time.time() - _T0), 60)
    print(f"[{dk:02d}:{sn:02d}] {mesaj}", flush=True)


# =====================================================================
# YARDIMCILAR
# =====================================================================
def _cocuklar(yol):
    det = mf.get_path_details(yol) or {}
    return det.get("children") or []


def _alt_klasorler():
    kl = sorted(c["name"] for c in _cocuklar("/") if c.get("directory"))
    if not kl:
        kl = sorted({p.strip("/").split("/")[0]
                     for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    return kl


def _dosyalar(klasor):
    ad = [c["name"] for c in _cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition()
              if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


def _sheet_adi(klasor, kullanilan):
    """Excel sheet adı en fazla 31 karakter ve benzersiz olmalı."""
    s = (klasor.replace("_ICINDE_KIRMIZI_RENGE_GOC", "_KRM_GOC")
               .replace("_ICINDE_KIRMIZI_TAKIP", "_KRM_TAKIP")
               .replace("_KIRMIZI_RENGE_GOC", "_RENGE_GOC")
               .replace("_OOT", "_OOT_"))[:31]
    aday, i = s, 2
    while aday in kullanilan:
        ek = f"_{i}"
        aday = s[:31 - len(ek)] + ek
        i += 1
    kullanilan.add(aday)
    return aday


# =====================================================================
# ANA DÖNGÜ (klasörlere yazmaz, sadece okur)
# =====================================================================
_log("Başladı")
klasorler = _alt_klasorler() if TUM_KLASORLER else KLASORLER
_log(f"{len(klasorler)} klasör taranacak")

tum_parcalar, sheetler, icindekiler = [], {}, []
kullanilan_adlar = {"ICINDEKILER", "OZET", "TUM"}

for ki, klasor in enumerate(klasorler, start=1):
    dosyalar = _dosyalar(klasor)
    renkler = sorted({(int(m.group(1)), m.group(2), ad)
                      for ad in dosyalar if (m := FEATURE_DOSYA_RE.match(ad))})
    if not renkler:
        _log(f"[{ki}/{len(klasorler)}] ⚠ {klasor}: kalan_featurelar dosyası yok, atlandı")
        continue

    parcalar = []
    for kod, renk, ad in renkler:                       # 1-KIRMIZI ... 6-KOY_YESIL
        with mf.get_download_stream(f"/{klasor}/{ad}") as s:
            df = pd.read_csv(s)
        if "sira" in df.columns:
            df = df.sort_values("sira", kind="stable")
        df.insert(0, "KLASOR", klasor)
        df.insert(1, "RENK_MODEL", f"{kod}-{renk}")
        parcalar.append(df)

    blok = pd.concat(parcalar, ignore_index=True)
    sh = _sheet_adi(klasor, kullanilan_adlar)
    sheetler[sh] = blok.drop(columns="KLASOR")          # sheet adı zaten klasörü gösteriyor
    tum_parcalar.append(blok)
    icindekiler.append({"sheet": sh, "klasor": klasor,
                        "renk_model_sayisi": len(renkler), "satir": len(blok)})
    _log(f"[{ki}/{len(klasorler)}] {klasor}: {len(renkler)} renk modeli | "
         + " | ".join(f"{r}: {n}" for r, n in blok.groupby("RENK_MODEL", sort=False).size().items()))

if not tum_parcalar:
    raise ValueError("Hiçbir klasörde kalan_featurelar dosyası bulunamadı.")

tum = pd.concat(tum_parcalar, ignore_index=True)

# Klasör x renk modeli feature sayısı
ozet = (tum.pivot_table(index="KLASOR", columns="RENK_MODEL",
                        values=tum.columns[2], aggfunc="size", fill_value=0)
           .reindex(columns=sorted(tum["RENK_MODEL"].unique(),
                                   key=lambda x: int(x.split("-")[0])))
           .reindex([k for k in klasorler if k in set(tum["KLASOR"])])
           .reset_index())
ozet.columns.name = None


# =====================================================================
# TEK EXCEL
# =====================================================================
_log("Excel yazılıyor")
buf = BytesIO()
with pd.ExcelWriter(buf, engine="openpyxl") as xl:
    pd.DataFrame(icindekiler).to_excel(xl, sheet_name="ICINDEKILER", index=False)
    ozet.to_excel(xl, sheet_name="OZET", index=False)
    tum.to_excel(xl, sheet_name="TUM", index=False)
    for sh, tablo in sheetler.items():
        tablo.to_excel(xl, sheet_name=sh, index=False)
buf.seek(0)
mf.upload_stream(CIKTI_DOSYA, buf)
_log(f"✓ {MAIN_FOLDER}{CIKTI_DOSYA} yazıldı | {len(sheetler)} klasör | {len(tum):,} feature satırı")
