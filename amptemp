# =====================================================================
# KOLON KARŞILAŞTIRMA: df (RENK_MDL_ALL_INP_2) vs df_baz (GOC_MDL_BAZ_INPUTLAR)
# 1) LEAK_COLS dahil: hangi kolonlar sadece birinde var
# 2) LEAK_COLS çıkarıldıktan sonra: fark hâlâ kalıyor mu
# =====================================================================

def _yazdir(baslik, kolonlar):
    print(f"{baslik} ({len(kolonlar)}):")
    for c in sorted(kolonlar):
        print("   -", c)
    if not kolonlar:
        print("   (yok)")
    print()

kol_df  = set(df.columns)
kol_baz = set(df_baz.columns)
leak    = set(LEAK_COLS)

# --- 1) LEAK_COLS dahil karşılaştırma ---
ortak       = kol_df & kol_baz
sadece_df   = kol_df - kol_baz
sadece_baz  = kol_baz - kol_df

print("=" * 70)
print("1) TÜM KOLONLAR (LEAK_COLS dahil)")
print("=" * 70)
print(f"df     kolon sayısı : {len(kol_df)}")
print(f"df_baz kolon sayısı : {len(kol_baz)}")
print(f"Ortak kolon         : {len(ortak)}")
print(f"Farklı kolon toplam : {len(sadece_df) + len(sadece_baz)}\n")
_yazdir("Sadece df'te olan (df_baz'da YOK)", sadece_df)
_yazdir("Sadece df_baz'da olan (df'te YOK)", sadece_baz)

# --- 2) LEAK_COLS çıkarıldıktan sonra karşılaştırma ---
sadece_df_temiz  = sadece_df  - leak
sadece_baz_temiz = sadece_baz - leak

print("=" * 70)
print("2) LEAK_COLS ÇIKARILDIKTAN SONRA")
print("=" * 70)
print(f"LEAK_COLS sayısı                : {len(leak)}")
print(f"Farktan LEAK_COLS ile düşen     : "
      f"{len(sadece_df - sadece_df_temiz) + len(sadece_baz - sadece_baz_temiz)}")
print(f"Kalan farklı kolon toplam       : {len(sadece_df_temiz) + len(sadece_baz_temiz)}\n")
_yazdir("Sadece df'te olan (LEAK hariç)", sadece_df_temiz)
_yazdir("Sadece df_baz'da olan (LEAK hariç)", sadece_baz_temiz)

if not sadece_df_temiz and not sadece_baz_temiz:
    print("✓ LEAK_COLS çıkarıldığında iki dataset'in kolonları birebir aynı.")
else:
    print("⚠ LEAK_COLS çıkarıldıktan sonra da farklı kolonlar var (yukarıdaki listeler).")

# --- 3) Ek kontrol: ortak kolonlarda tip farkı ---
tip_farki = {c: (str(df[c].dtype), str(df_baz[c].dtype))
             for c in sorted(ortak - leak) if df[c].dtype != df_baz[c].dtype}
print(f"\nOrtak kolonlarda (LEAK hariç) tip farkı ({len(tip_farki)}):")
for c, (t1, t2) in tip_farki.items():
    print(f"   - {c}: df={t1} | df_baz={t2}")
if not tip_farki:
    print("   (yok)")
