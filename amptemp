# -*- coding: utf-8 -*-
# =====================================================================
# PySpark: FPD_TXN_FEATS_2025 + FPD_TXN_FEATS_2026 -> ortak kolonlarla alt alta birlestir
# + feature_birlesik.xlsx'teki pandas formulleriyle yeni feature'lar -> FPD_TXN_FEATS_ENH
# =====================================================================
import io
import re

import numpy as np
import pandas as pd
import dataiku
from dataiku import spark as dkuspark
from pyspark import SparkContext
from pyspark.sql import SQLContext
from pyspark.sql import functions as F
from pyspark.sql import types as T

# ------------------------- AYARLAR -------------------------
GIRDI_DATASETLER  = ["FPD_TXN_FEATS_2025", "FPD_TXN_FEATS_2026"]   # kolon sirasi ilkinden
CIKTI_DATASET     = "FPD_TXN_FEATS_ENH"
FEATURE_KLASOR    = "COMPLETE_JSON"
FEATURE_DOSYA     = "feature_birlesik.xlsx"
ALINACAK_DURUMLAR = {"KABUL"}            # RED'ler de istenirse: {"KABUL", "RED"}
DONEM_KOL         = "PERIOD"
ORNEK_SATIR       = 50_000               # formulleri tam calismadan once deneme orneklemi
BATCH_SATIR       = 20_000               # mapInPandas'ta her pandas parcasinin satir sayisi
BOS_DEGERLER      = {"", "-", "nan", "none", "null"}
YASAK_KALIPLAR    = ["import", "__", "exec(", "eval(", "open(", "lambda"]

sc = SparkContext.getOrCreate()
sqlContext = SQLContext(sc)
spark = sqlContext.sparkSession
spark.conf.set("spark.sql.execution.arrow.pyspark.enabled", "true")
spark.conf.set("spark.sql.execution.arrow.maxRecordsPerBatch", str(BATCH_SATIR))

# ------------------------- 1) OKU -------------------------
girdiler = {ad: dkuspark.get_dataframe(sqlContext, dataiku.Dataset(ad)) for ad in GIRDI_DATASETLER}

# ------------------------- 2) ORTAK KOLONLAR + ORTAK TIPLER -------------------------
tipler = {ad: dict(sdf.dtypes) for ad, sdf in girdiler.items()}
ortak_set = set.intersection(*(set(t) for t in tipler.values()))
ortak = [c for c in girdiler[GIRDI_DATASETLER[0]].columns if c in ortak_set]

for ad, sdf in girdiler.items():
    disarida = [c for c in sdf.columns if c not in ortak_set]
    if disarida:
        print(f"UYARI: [{ad}] sadece kendisinde olan {len(disarida)} kolon disarida: {disarida[:20]}")
print(f"Ortak kolon: {len(ortak):,}")
if DONEM_KOL not in ortak_set:
    raise ValueError(f"{DONEM_KOL} iki dataset'te ortak degil.")

SAYISAL = {"tinyint", "smallint", "int", "bigint", "float", "double"}
hedef_tip = {}
for c in ortak:
    t_list = [tipler[ad][c] for ad in GIRDI_DATASETLER]
    if len(set(t_list)) == 1:
        continue
    hedef = "double" if all(t in SAYISAL or t.startswith("decimal") for t in t_list) else "string"
    hedef_tip[c] = hedef
    print(f"Bilgi: {c} tipleri {t_list} -> {hedef}")


def hizala(sdf):
    return sdf.select([F.col(c).cast(hedef_tip[c]).alias(c) if c in hedef_tip else F.col(c) for c in ortak])


# Donem kontrolu (sadece PERIOD kolonu okunur, hizlidir)
donemler = {}
for ad, sdf in girdiler.items():
    sayim = {r[DONEM_KOL]: r["count"] for r in sdf.groupBy(DONEM_KOL).count().collect()}
    donemler[ad] = set(sayim)
    print(f"[{ad}] {DONEM_KOL}: " + ", ".join(f"{k}:{v:,}" for k, v in sorted(sayim.items(), key=lambda x: str(x[0]))))
cakisan = set.intersection(*donemler.values())
if cakisan:
    print(f"UYARI: iki yilda da bulunan donemler: {sorted(cakisan, key=str)}")

df = hizala(girdiler[GIRDI_DATASETLER[0]])
for ad in GIRDI_DATASETLER[1:]:
    df = df.unionByName(hizala(girdiler[ad]))

# ------------------------- 3) FEATURE TANIMLARI -------------------------
with dataiku.Folder(FEATURE_KLASOR).get_download_stream(FEATURE_DOSYA) as s:
    fx = pd.read_excel(io.BytesIO(s.read()), sheet_name=0)
fx.columns = [str(c).strip() for c in fx.columns]
eksik = {"ad", "formul", "durum"} - set(fx.columns)
if eksik:
    raise ValueError(f"Excel'de beklenen kolon(lar) yok: {eksik}. Mevcut: {list(fx.columns)}")


def bos_mu(x):
    return pd.isna(x) or str(x).strip().lower() in BOS_DEGERLER


fx = fx[fx["durum"].astype(str).str.strip().str.upper().isin(ALINACAK_DURUMLAR)]
fx = fx[~fx["formul"].apply(bos_mu) & ~fx["ad"].apply(bos_mu)]

adaylar, elenen, gerekli = [], [], set()
for ad, formul in zip(fx["ad"].astype(str).str.strip(), fx["formul"].astype(str).str.strip()):
    kullanilan = re.findall(r"df\[\s*['\"]([^'\"]+)['\"]\s*\]", formul)
    yok = [k for k in kullanilan if k not in ortak_set]
    if ad in ortak_set or ad in {a for a, _ in adaylar}:
        elenen.append((ad, "bu isimde kolon zaten var"))
    elif any(k in formul for k in YASAK_KALIPLAR):
        elenen.append((ad, "formulde yasak kalip var"))
    elif yok:
        elenen.append((ad, f"veride olmayan kolon: {yok}"))
    else:
        adaylar.append((ad, formul))
        gerekli.update(kullanilan)


def formul_calistir(pdf, formul):
    """Formulu pandas df'te calistirir; float64 numpy dizisi dondurur, hata olursa exception atar."""
    sonuc = eval(formul, {"__builtins__": {}}, {"df": pdf, "np": np, "pd": pd})
    if np.isscalar(sonuc):
        raise ValueError("formul tek bir sayi dondurdu")
    seri = sonuc if isinstance(sonuc, pd.Series) else pd.Series(np.asarray(sonuc))
    if len(seri) != len(pdf):
        raise ValueError(f"uzunluk uyusmuyor ({len(seri)} != {len(pdf)})")
    arr = pd.to_numeric(seri, errors="coerce").to_numpy(dtype="float64", na_value=np.nan)
    arr[~np.isfinite(arr)] = np.nan
    return arr


# ------------------------- 4) ORNEKLEMDE DENEME (driver'da) -------------------------
# Tam veriye gecmeden once formulleri kucuk bir ornekte calistirir; hata verenleri eler.
ornek = df.select([c for c in ortak if c in gerekli]).limit(ORNEK_SATIR).toPandas()
tanimlar = []
for ad, formul in adaylar:
    try:
        arr = formul_calistir(ornek, formul)
    except Exception as e:
        elenen.append((ad, f"ornekte hata: {type(e).__name__}: {e}"))
        continue
    dolu = np.isfinite(arr)
    not_ = ""
    if not dolu.any():
        not_ = " | UYARI: ornekte tamamen NaN"
    elif np.nanmin(arr) == np.nanmax(arr):
        not_ = " | UYARI: ornekte sabit deger"
    print(f"OK: {ad} | ornekte dolu %{dolu.mean()*100:.1f}{not_}")
    tanimlar.append((ad, formul))
del ornek

print(f"\nFeature: {len(tanimlar)} uretilecek, {len(elenen)} elendi")
for ad, neden in elenen:
    print(f"ELENDI: {ad} -> {neden}")

# ------------------------- 5) TAM VERIDE FEATURE URETIMI (executor'larda) -------------------------
cikis_sema = T.StructType(df.schema.fields + [T.StructField(ad, T.DoubleType(), True) for ad, _ in tanimlar])


def feature_ekle(iterator):
    for pdf in iterator:
        n = len(pdf)
        yeni = {}
        for ad, formul in tanimlar:
            try:
                yeni[ad] = formul_calistir(pdf, formul)
            except Exception:
                yeni[ad] = np.full(n, np.nan)   # ornekte gecip burada patlayan parca -> NaN
        yield pd.concat([pdf, pd.DataFrame(yeni, index=pdf.index)], axis=1)


df_out = df.mapInPandas(feature_ekle, schema=cikis_sema) if tanimlar else df

# ------------------------- 6) YAZ -------------------------
dkuspark.write_with_schema(dataiku.Dataset(CIKTI_DATASET), df_out)
print(f"{CIKTI_DATASET} yazildi: {len(cikis_sema.fields):,} kolon ({len(ortak):,} ortak + {len(tanimlar)} yeni)")
