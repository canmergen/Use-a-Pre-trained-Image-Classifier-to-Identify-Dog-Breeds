def _st_kat_metin(s):
    """Kategori değerlerini metne çevirir; 1 ve 1.0 aynı metin ('1') olur (pipeline'daki _kat_metin)."""
    if pd.api.types.is_numeric_dtype(s.dtype) and not pd.api.types.is_bool_dtype(s.dtype):
        v = pd.to_numeric(s, errors="coerce").astype("float64")
        out = v.astype("string")
        tam = v.notna() & np.isfinite(v) & (v == np.round(v)) & (v.abs() < 2 ** 53)
        out[tam] = v[tam].astype("int64").astype("string")
        return out
    return s.astype("string")


_ST_DESEN_AYLAR = ["LM"] + [f"L{i}M" for i in range(2, 13)]


def _st_desen_num(frame, c):
    if c not in frame.columns:
        return np.full(len(frame), np.nan)
    return pd.to_numeric(frame[c], errors="coerce").to_numpy(dtype="float64", na_value=np.nan)


def _st_desen_bin(v, sinirlar, etiketler):
    out = np.full(len(v), "X", dtype=object)
    ok = np.isfinite(v)
    out[ok] = np.asarray(etiketler, dtype=object)[np.digitize(v[ok], sinirlar)]
    return out


def _st_desen_birlestir(parcalar):
    res = parcalar[0].astype(str)
    for p in parcalar[1:]:
        res = np.char.add(np.char.add(res, "|"), p.astype(str))
    return res


def _st_desen_anahtarlari(frame):
    """Satır bazlı desen anahtarları (pipeline'daki _desen_anahtarlari, kaydir=0)."""
    aylar = _ST_DESEN_AYLAR[:6]
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != "INAKTIF"]
    R = np.column_stack([_st_desen_num(frame, f"RENK_{m}") for m in aylar])
    Rk = np.where(np.isin(R, aktif) | (R == 0), R, np.nan)
    renk_str = np.where(np.isfinite(Rk), np.nan_to_num(Rk).astype(int).astype(str), "X")
    anahtar = {"RENK3": _st_desen_birlestir([renk_str[:, j] for j in range(3)])}
    Ra = np.where(np.isin(R, aktif), R, np.nan)
    hareket = []
    for j in range(5):
        a, b = Ra[:, j], Ra[:, j + 1]
        ok = np.isfinite(a) & np.isfinite(b)
        h = np.where(a < b, "-", np.where(a > b, "+", "0"))
        hareket.append(np.where(ok, h, "X"))
    anahtar["RENK_HAREKET5"] = _st_desen_birlestir(hareket)
    U = []
    for m in aylar[:3]:
        lim, rsk = _st_desen_num(frame, f"KK_LIMIT_{m}"), _st_desen_num(frame, f"KK_RISK_{m}")
        ok = np.isfinite(lim) & np.isfinite(rsk) & (lim > 0)
        U.append(np.where(ok, rsk / np.where(ok, lim, 1.0), np.nan))
    kku = [_st_desen_bin(u, [0.3, 0.8, 0.9], ["a", "b", "c", "d"]) for u in U]
    odm = [_st_desen_bin(_st_desen_num(frame, f"KK_ODEME_ORANI_{m}"), [20, 100], ["a", "b", "c"]) for m in aylar[:3]]
    anahtar["KKU3"] = _st_desen_birlestir(kku)
    anahtar["ODM3"] = _st_desen_birlestir(odm)
    anahtar["RENK_KKU_ODM_LM"] = _st_desen_birlestir([renk_str[:, 0], kku[0], odm[0]])
    return {k: pd.Series(v, index=frame.index) for k, v in anahtar.items()}


_ST_DESEN_KOL = ([f"RENK_{m}" for m in _ST_DESEN_AYLAR[:6]] +
                 [f"{b}_{m}" for b in ("KK_LIMIT", "KK_RISK", "KK_ODEME_ORANI") for m in _ST_DESEN_AYLAR[:3]])


def _st_girdi(X, eng, paket):
    """Ham satırlar (X) ve FE çıktısından (eng) modele giren tablo ve skor. renk_goc_skorla ile aynı: ham kolonu FE
    dönüştürdüyse dönüşmüş hali, FE'nin ürettiği kolon yalnızca paketin engineered_features listesindeyse kullanılır."""
    raw = set(paket["required_raw_features"])
    eng_liste = set(paket["engineered_features"])

    def kolon(c):
        if c in raw:
            if c in eng.columns and not eng[c].equals(X[c]):
                return eng[c]
            return X[c]
        if c in eng_liste and c in eng.columns:
            return eng[c]
        return None

    schema = paket["preprocess_schema"]
    if schema.get("mode") != "train_fitted_native":
        raise NotImplementedError("Yalnızca train_fitted_native ön işlemeli paketler skorlanabilir.")
    feats = list(paket["features"])
    desen = paket.get("desen_kodlama") or {}
    ds_kolon = desen.get("kolonlar", {})
    kolonlar = {}
    for c in feats:
        if c in ds_kolon:
            continue
        s = kolon(c)
        if s is None:
            raise KeyError(f"Modelin değişkeni üretilemedi: {c}")
        if c in schema["categorical"]:
            kolonlar[c] = _st_kat_metin(s).astype(pd.CategoricalDtype(categories=schema["categorical"][c]))
        else:
            kolonlar[c] = pd.to_numeric(s, errors="coerce")
    ds_cols = [c for c in feats if c in ds_kolon]
    if ds_cols:
        if "COLOR_MAP" not in globals():
            raise RuntimeError("Desen değişkenleri (DSN_*) için COLOR_MAP bellekte olmalı.")
        cerceve = pd.DataFrame({c: s for c in _ST_DESEN_KOL if (s := kolon(c)) is not None}, index=X.index)
        anahtar = _st_desen_anahtarlari(cerceve)
        for c in ds_cols:
            ad, tur = ds_kolon[c]
            dolgu = desen["haritalar"][ad]["nadir_oran"] if tur == "oran" else 0.0
            kolonlar[c] = pd.Series(anahtar[ad].map(desen["haritalar"][ad][tur]).fillna(dolgu).to_numpy(dtype="float64"),
                                    index=X.index)
    F = pd.DataFrame(kolonlar, index=X.index)[feats]
    skor = paket["model"].predict_proba(F)[:, 1]
    turler = {c: ("kategorik" if c in schema["categorical"] else "sayısal") for c in feats}
    return F, np.asarray(skor, dtype="float64"), turler


def _st_csi(p, q):
    p = np.maximum(np.asarray(p, dtype="float64"), _ST_EPS)
    q = np.maximum(np.asarray(q, dtype="float64"), _ST_EPS)
    return float(np.sum((q - p) * np.log(q / p)))


def _st_durum(x):
    if not np.isfinite(x):
        return None
    return "Belirgin kayma" if x > _ST_UST else ("Dikkat" if x > _ST_ALT else "Stabil")


def _st_ozellik(F, skor, turler, ref=None):
    """Bir dönemin istatistiği. ref None ise bu dönem referanstır ve dilim sınırları buradan alınır."""
    out = {"n": len(skor), "feat": {}}
    for c in F.columns:
        if turler[c] == "kategorik":
            v = F[c].astype("object")
            bos = v.isna().to_numpy()
            kat = ref["feat"][c]["kat"] if ref else list(pd.Series(v[~bos]).value_counts().index)
            say = pd.Series(v[~bos]).value_counts()
            pay = np.array([float(say.get(k, 0)) for k in kat] + [float(say[~say.index.isin(kat)].sum()), float(bos.sum())])
            d = {"tur": "kategorik", "kat": kat, "ort": np.nan, "med": np.nan}
        else:
            v = pd.to_numeric(F[c], errors="coerce").to_numpy(dtype="float64", na_value=np.nan)
            ok = np.isfinite(v)
            if ref:
                sinir = ref["feat"][c]["sinir"]
            else:
                sinir = (np.unique(np.quantile(v[ok], np.linspace(0, 1, _ST_DILIM + 1)[1:-1])) if ok.any()
                         else np.array([]))
            idx = np.searchsorted(sinir, v[ok], side="left")
            pay = np.append(np.bincount(idx, minlength=len(sinir) + 1).astype("float64"), float((~ok).sum()))
            d = {"tur": "sayısal", "sinir": sinir, "ort": float(v[ok].mean()) if ok.any() else np.nan,
                 "med": float(np.median(v[ok])) if ok.any() else np.nan}
        n = max(len(v), 1)
        d["pay"] = pay / n
        d["bos"] = float(pay[-1]) / n
        d["csi"] = _st_csi(ref["feat"][c]["pay"], d["pay"]) if ref else np.nan
        out["feat"][c] = d
    s = np.asarray(skor, dtype="float64")
    ok = np.isfinite(s)
    sinir = ref["skor_sinir"] if ref else np.unique(np.quantile(s[ok], np.linspace(0, 1, _ST_GRUP + 1)[1:-1]))
    idx = np.searchsorted(sinir, s[ok], side="left")              # 0 = en düşük skor
    say = np.bincount(idx, minlength=len(sinir) + 1).astype("float64")[::-1]   # B1 = en yüksek skor (en riskli)
    pay = say / max(say.sum(), 1.0)
    k = len(pay)
    hhi = float(np.sum(pay ** 2))
    out.update({"skor_sinir": sinir, "grup_pay": pay, "hhi": hhi,
                "hhi_norm": (hhi - 1.0 / k) / (1.0 - 1.0 / k) if k > 1 else np.nan,
                "psi": _st_csi(ref["grup_pay"], pay) if ref else np.nan})
    return out


def _st_paket(klasor, kod, ad):
    yol = f"/{klasor}/renk_{kod}_{ad}_model.pkl"
    try:
        with mf.get_download_stream(yol) as s:
            ham = s.read()
        with warnings.catch_warnings():
            warnings.filterwarnings("ignore", message=r"Trying to unpickle estimator")
            paket = pickle.loads(ham)
    except Exception as e:
        return None, f"{yol} okunamadı ({type(e).__name__})"
    gerekli = {"model", "features", "required_raw_features", "engineered_features", "preprocess_schema"}
    if not isinstance(paket, dict) or not gerekli <= set(paket):
        return None, f"{yol} skorlama paketi değil (eksik: {sorted(gerekli - set(paket)) if isinstance(paket, dict) else 'hepsi'})"
    return paket, None


_ST_RENK_A = pd.to_numeric(_ST_VERI["RENK"], errors="coerce").to_numpy()
_ST_DONEM_A = pd.to_numeric(_ST_VERI["DONEM"], errors="coerce").to_numpy()
_ST_KK_A = ((_ST_VERI["KK_URUN_FLG"] == "KK").to_numpy() if "KK_URUN_FLG" in _ST_VERI.columns
            else np.ones(len(_ST_VERI), dtype=bool))


def _st_satirlar(kod, donem, kolonlar):
    """Pipeline kitlesi: KK ürünü, renk, dönem; bütün müşteriler."""
    pos = np.flatnonzero((_ST_RENK_A == kod) & (_ST_DONEM_A == donem) & _ST_KK_A)
    kol = [c for c in dict.fromkeys(kolonlar) if c in _ST_VERI.columns]
    return _ST_VERI.iloc[pos, [_ST_VERI.columns.get_loc(c) for c in kol]]


