        if form.get("kilitli") and not istek.get("onay"):
            return jsonify({"tamam": False,
                            "onay_gerekli": True,
                            "hata": form.get("kilit_nedeni")
                                    or "Bölme kilitli."})

        sonuc = akis.bolme_kaydet(durum, istek.get("bolme"))
