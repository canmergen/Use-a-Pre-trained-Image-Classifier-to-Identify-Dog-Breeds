def _bd_sayfa_capraz():
    """Seçilen model ile PredCs: modelin 20 grubu x PredCs'nin 20 grubu (19'daki Takip ile Takip+Kırmızı tablolarının
    karşılığı). Model, dönem ve renk hücreden seçilir; tablolar en alttaki veri tablosundan formülle okunur.
    Vaka = gerçekleşen FPD (iki hedef ayrı ayrı); modelin kendi hedefi bu sheet'te yoktur."""
    _bd_sayfa_sil(_BD_SAYFA_X)
    G, G2 = _BD_N_GRUP, _BD_N_GRUP ** 2
    c_top = 3 + G                                              # Toplam kolonu
    cl = c_top + 2                                             # listeler ve formül yardımcıları (gizli kolonlar)
    ws = _yeni_sayfa(_BD_SAYFA_X, {2: 26, **{c: 9.5 for c in range(3, c_top + 1)}, c_top + 1: 3,
                                   **{c: 24 for c in range(cl, cl + 6)}})
    S = Sayfa(ws, c_top)
    L = get_column_letter
    sari = PatternFill("solid", fgColor="FFF2CC")
    fpd_adlar = [h for h in _BD_FPD_ADLAR if any(h in x["fpd"] for x in _BD_T_X)] if _BD_FPD is not None else []
    n_f = len(fpd_adlar)
    u = _BD_UST
    r = 2
    S.baslik(r, "Seçilen model ile PredCs: gerçekleşen FPD vakaları hangi gruplarda?")
    r += 1
    pc_metni, don_metni = _bd_pc_notlari()
    for e, m, yuk in [
        ("Ne karşılaştırılır", "Seçilen modelin skoru ile PredCs. Takip ile Takip+Kırmızı sheet'indeki tabloların aynısı: "
                               "satırlar modelin 20 grubu, kolonlar PredCs'nin 20 grubu (B1 = en riskli %5).", 32),
        ("Kimler üzerinde", "Modelin seçilen dönemdeki kitlesinden PredCs'si dolu olanlar (model ile PredCs'nin ortak "
                            "kitlesi). İki skor bu aynı müşterilerde ayrı ayrı sıralanıp 20 eşit gruba ayrılır; her renk "
                            "segmentinin kendi modeli ve kendi grupları vardır (Tümü: renklerin aynı numaralı grupları "
                            "toplanır).", 32),
        ("Vaka", ("Bu sheet'te vaka gerçekleşen FPD'dir; iki hedef ayrı ayrı verilir (" + ", ".join(fpd_adlar) + "). "
                  + _BD_FPD_TABAN + " Modelin kendi hedefi (takip / kırmızı) bu sheet'te kullanılmaz; o "
                  f"'{_BD_SAYFA_D}' sheet'indedir.") if n_f else
         "FPD tablosu okunamadı; vaka tabloları yazılamadı, yalnızca kişi sayıları var.", 32),
        ("Nasıl okunur", f"Riskli = en riskli %{_BD_RISKLI_YZD} (B1-B{u}). Sol üstteki {u}x{u} kare ikisinin de riskli "
                         f"dediği müşteriler; üst satırlar (B1-B{u}) modelin, sol kolonlar (B1-B{u}) PredCs'nin riskli "
                         "dedikleri. Vaka tablosunda Toplam satırı PredCs'nin, Toplam kolonu modelin bucket'larındaki vaka "
                         f"sayısıdır ('{_BD_SAYFA_P}' Bölüm 1'deki sayılar); ikisinin toplamı aynıdır. Vakalar sol "
                         "kolonlarda toplanıyorsa PredCs, üst satırlarda toplanıyorsa model FPD vakalarını öne alıyor.", 46),
        ("PredCs", pc_metni, 32),
        ("Dönemler", don_metni, 32),
    ]:
        S.satir(r, e, m, yuk)
        r += 1
    r += 1
    if not _BD_T_X:
        S.not_satiri(r, "PredCs'si dolu müşterisi olan model x dönem yok; tablolar yazılamadı.")
        _yazdir(ws)
        return ws
    # ---- satır planı (formüller için baştan): seçim, her FPD hedefinin özeti, tablolar, veri
    n_sec, n_ozet = 3, 6
    r_sec = r
    r_ozetler = [r_sec + n_sec + 1 + t * (n_ozet + 2) for t in range(n_f)]
    r_ilk = (r_ozetler[-1] + n_ozet + 3) if n_f else r_sec + n_sec + 2
    n_mat = 1 + 2 * n_f                                        # kişi; her hedefin vaka sayısı; her hedefin oranı
    r_mat = [r_ilk + i * (G + 5) for i in range(n_mat)]        # her tablonun bant satırı
    r_veri = r_mat[-1] + G + 6
    anahtarlar = [f"{x['ad']}|{x['donem']}|{x['seg']}" for x in _BD_T_X]
    modeller = list(dict.fromkeys(x["ad"] for x in _BD_T_X))
    donemler = list(dict.fromkeys(x["donem"] for x in sorted(_BD_T_X, key=lambda x: x["donem"][:6])))
    renkler = [_seg_etiket(k) for k, _, _ in RENKLER if any(x["kod"] == k for x in _BD_T_X)]
    n_kombi, lh = len(_BD_T_X), r_sec
    v1, v2 = r_veri + 2, r_veri + 1 + n_kombi * G2             # veri tablosunun ilk ve son satırı
    kisi_rng = f"${L(7)}${v1}:${L(7)}${v2}"
    fpd_rng = [f"${L(8 + t)}${v1}:${L(8 + t)}${v2}" for t in range(n_f)]      # her FPD hedefinin vaka kolonu
    anahtar_rng = f"${L(cl + 3)}${lh + 1}:${L(cl + 3)}${lh + n_kombi}"

    def liste_rng(j, n):
        return f"${L(cl + j)}${lh + 1}:${L(cl + j)}${lh + n}"

    # ---- seçim hücreleri
    varsayilan_d = max(donemler, key=lambda d: (_BD_PC_PAY.get(int(d[:6]), 0.0), d))    # PredCs'si en dolu dönem
    secim = [("Model seç:", modeller[0], liste_rng(0, len(modeller)), 3, 9),
             ("Dönem seç:", varsayilan_d, liste_rng(1, len(donemler)), 3, 6),
             ("Renk segmenti seç:", "Tümü", liste_rng(2, len(renkler) + 1), 3, 6)]
    sec_ref = []
    for i, (etiket, deger, kaynak, c1, c2) in enumerate(secim):
        rr = r_sec + i
        S.hucre(rr, 2, etiket, bold=True, dikey="center", kenar=None)
        S.birlestir(rr, c1, c2, deger, bold=True, h="center", dikey="center", fill=sari)
        dv = DataValidation(type="list", formula1="=" + kaynak, allow_blank=False, showDropDown=False)
        dv.error, dv.errorTitle = "Listeden seçin.", etiket.rstrip(":")
        ws.add_data_validation(dv)
        dv.add(f"{L(c1)}{rr}")
        ws.row_dimensions[rr].height = 20
        sec_ref.append(f"${L(c1)}${rr}")
    s_model, s_donem, s_renk = sec_ref
    S.birlestir(r_sec, 11, c_top, "Sarı hücrelerden seçim yapılır; özetler ve tablolar seçime göre yeniden hesaplanır.",
                italic=True, renk="595959", size=10, kenar=None, dikey="center")
    # yardımcılar (gizli kolonlarda): seçime uyan her rengin veri bloğunun sırası (yoksa 0)
    yh = lh + max(len(modeller), len(donemler), len(renkler) + 1, n_kombi) + 3
    S.hucre(yh - 1, cl, "Seçimin veri blokları (formül yardımcısı)", bold=True, size=9, kenar=None)
    yard = []
    for i, seg in enumerate(renkler):
        S.hucre(yh + i, cl, seg, size=9, kenar=None)
        S.hucre(yh + i, cl + 1, f'=IF(OR({s_renk}="Tümü",{s_renk}="{seg}"),IFERROR(MATCH({s_model}&"|"&{s_donem}&"|"&"{seg}",'
                                f'{anahtar_rng},0),0),0)', size=9, kenar=None, fmt="0")
        yard.append(f"${L(cl + 1)}${yh + i}")
    yard_top = f"SUM({L(cl + 1)}{yh}:{L(cl + 1)}{yh + len(renkler) - 1})"
    S.birlestir(r_sec + 1, 11, c_top, f'=IF({yard_top}=0,"Bu seçim için veri yok: model o renkte ya da dönemde yok ya da '
                                      f'PredCs\'si dolu müşteri yok.","")',
                bold=True, renk="C00000", size=10, kenar=None, dikey="center")

    def oku(aralik, sira):
        """Seçime uyan renk bloklarından aynı hücrenin toplamı."""
        return "+".join(f"IF({h}>0,INDEX({aralik},({h}-1)*{G2}+{sira}),0)" for h in yard)

    # ---- tablolar: (başlık, biçim, renk, kaynak); kaynak = veri okuyan fonksiyon ya da (pay tablosu, payda tablosu)
    yon = "satır = modelin grubu, kolon = PredCs'nin grubu"
    tablolar = [(f"Kişi sayısı: {yon}", "#,##0", "9DC3E6", lambda q: oku(kisi_rng, q))]
    for t, h in enumerate(fpd_adlar):
