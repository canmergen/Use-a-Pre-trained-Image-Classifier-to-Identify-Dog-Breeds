def _kt_df_raw_hedef(v, donemler):
    """df_raw'dan X ay içinde takip ve (takip ya da X. ay sonu Kırmızı) → MBB_NO, DONEM, TAKIP_RAW, TK_RAW."""
    if not KT_DF_RAW_ILE_DOLDUR or "df_raw" not in globals():
        return None
    tk, rk = f"AKB_TAKIP_YY_{v}M_FLG", f"RENK_{v}M_SONRASI"
    if not {"MBB_NO", "DONEM", tk} <= set(df_raw.columns):
        _log(f"   ⚠ df_raw'da MBB_NO / DONEM / {tk} yok: bir modelde olmayan müşterinin hedefi tamamlanamayacak")
        return None
    kol = ["MBB_NO", "DONEM", tk] + ([rk] if rk in df_raw.columns else [])
    don = pd.to_numeric(df_raw["DONEM"], errors="coerce")
    r = df_raw.loc[don.isin(donemler), kol].copy()
    r["MBB_NO"] = pd.to_numeric(r["MBB_NO"], errors="coerce")
    r["DONEM"] = pd.to_numeric(r["DONEM"], errors="coerce")
    r = r.dropna(subset=["MBB_NO", "DONEM"]).drop_duplicates(["MBB_NO", "DONEM"], keep="first")
    takip = (pd.to_numeric(r[tk], errors="coerce") == 1)
    out = pd.DataFrame({"MBB_NO": r["MBB_NO"].astype("int64"), "DONEM": r["DONEM"].astype("int64"),
                        "TAKIP_RAW": takip.astype("float64")})
    if rk in r.columns:
        kirmizi = r[rk].astype(str).str.split("-").str[0].str.strip() == "1"
        out["TK_RAW"] = (takip | kirmizi).astype("float64")
    else:
        out["TK_RAW"] = np.nan
        _log(f"   ⚠ df_raw'da {rk} yok: {KT_TAKIP_AD}nde olup {KT_TK_AD}nde olmayan müşterinin takip veya kırmızı "
             "hedefi boş kalacak")
    return out


def _kt_erken(v, donemler):
    """df_raw'dan daha uzun vadeli takip bayrağı (6M için AKB_TAKIP_YY_12M_FLG) → MBB_NO, DONEM, ERKEN.
    Boş bayrak, df_raw'daki diğer takip bayraklarındaki gibi takip değil sayılır."""
    h = KT_ERKEN_UFUK.get(v)
    if not h or "df_raw" not in globals():
        return None, h
    ek = f"AKB_TAKIP_YY_{h}M_FLG"
    if not {"MBB_NO", "DONEM", ek} <= set(df_raw.columns):
        _log(f"   ℹ df_raw'da {ek} yok: {v}M için erken uyarı kolonu boş kalacak")
        return None, h
    don = pd.to_numeric(df_raw["DONEM"], errors="coerce")
    r = df_raw.loc[don.isin(donemler), ["MBB_NO", "DONEM", ek]].copy()
    r["MBB_NO"] = pd.to_numeric(r["MBB_NO"], errors="coerce")
    r["DONEM"] = pd.to_numeric(r["DONEM"], errors="coerce")
    r = r.dropna(subset=["MBB_NO", "DONEM"]).drop_duplicates(["MBB_NO", "DONEM"], keep="first")
    return pd.DataFrame({"MBB_NO": r["MBB_NO"].astype("int64"), "DONEM": r["DONEM"].astype("int64"),
                         "ERKEN": (pd.to_numeric(r[ek], errors="coerce") == 1).astype("float64")}), h


def _kt_vade_verisi(v):
    t_k = MODELLER.get((v, KT_TAKIP_HEDEF), {}).get("klasor")
    tk_k = MODELLER.get((v, KT_TK_HEDEF), {}).get("klasor")
    if not t_k or not tk_k:
        _log(f"⚠ {v}M: {KT_TAKIP_AD if not t_k else KT_TK_AD} klasörü OOT{_oot} için yok; bu vade atlandı")
        return None
    _log(f"{v}M karşılaştırma")
    T = _kt_model_oku(t_k, KT_TAKIP_AD)
    TK = _kt_model_oku(tk_k, KT_TK_AD)
    if T is None or TK is None:
        _log(f"⚠ {v}M: {KT_TAKIP_AD if T is None else KT_TK_AD} klasöründe musteri_skorlari dosyası yok; bu vade atlandı")
        return None
    J = T.rename(columns={"HDF": "BATIK", "GRUP": "GT", "RENK": "RENK_T", "SKOR": "SKOR_T"}).merge(
        TK.rename(columns={"HDF": "TKH", "GRUP": "GK", "RENK": "RENK_K", "SKOR": "SKOR_K"}),
        on=["MBB_NO", "DONEM"], how="outer")
    n_renk_fark = int((J["RENK_T"].notna() & J["RENK_K"].notna() & (J["RENK_T"] != J["RENK_K"])).sum())
    J["RENK"] = J["RENK_T"].fillna(J["RENK_K"]).astype(int)
    J["GT"] = J["GT"].fillna(0).astype(int)                  # 0 = Yok (Takip modelinde yok)
    J["GK"] = J["GK"].fillna(0).astype(int)                  # 0 = Yok (Takip + Kırmızı modelinde yok)
    raw = _kt_df_raw_hedef(v, J["DONEM"].unique())
    n_doldur = (0, 0)
    if raw is not None:
        J = J.merge(raw, on=["MBB_NO", "DONEM"], how="left")
        ortak = J["BATIK"].notna() & J["TAKIP_RAW"].notna()
        uyum = float((J.loc[ortak, "BATIK"] == J.loc[ortak, "TAKIP_RAW"]).mean()) if ortak.any() else np.nan
        if np.isfinite(uyum) and uyum < 0.99:
            _log(f"   ⚠ df_raw'daki takip ile {KT_TAKIP_AD}nin hedefi %{uyum * 100:.1f} uyumlu (beklenen ~%100); "
                 "df_raw'dan tamamlanan hedeflere dikkat")
        n_doldur = (int((J["BATIK"].isna() & J["TAKIP_RAW"].notna()).sum()),
                    int((J["TKH"].isna() & J["TK_RAW"].notna()).sum()))
        J["BATIK"] = J["BATIK"].fillna(J["TAKIP_RAW"])
        J["TKH"] = J["TKH"].fillna(J["TK_RAW"])
        J = J.drop(columns=["TAKIP_RAW", "TK_RAW"])
    erk, ufuk = _kt_erken(v, J["DONEM"].unique())
    if erk is not None:
        J = J.merge(erk, on=["MBB_NO", "DONEM"], how="left")
        b1 = J["BATIK"] == 1
        kapsar = float((J.loc[b1, "ERKEN"] == 1).mean()) if (b1 & J["ERKEN"].notna()).any() else np.nan
        if np.isfinite(kapsar) and kapsar < 0.95:
            _log(f"   ⚠ {v} ay içinde takibe düşenlerin yalnızca %{kapsar * 100:.1f}'inde {ufuk}M takip bayrağı 1: bayrak "
                 f"{v} ayı kapsamıyor ya da dönem olgunlaşmamış olabilir; erken uyarı kolonuna dikkat")
        if float(J["ERKEN"].fillna(0).sum()) == 0:
            _log(f"   ⚠ {ufuk}M takip bayrağı bu dönemde hiç 1 değil (dönem olgunlaşmamış olabilir)")
    else:
        J["ERKEN"] = np.nan
    J["TH"] = _kt_ayni_hacim(J)
    bilgi = {"vade": v, "t_klasor": t_k, "tk_klasor": tk_k, "n": len(J),
             "iki": int(((J["GT"] > 0) & (J["GK"] > 0)).sum()), "yalniz_t": int(((J["GT"] > 0) & (J["GK"] == 0)).sum()),
             "yalniz_tk": int(((J["GT"] == 0) & (J["GK"] > 0)).sum()), "batik_bos": int(J["BATIK"].isna().sum()),
             "tk_bos": int(J["TKH"].isna().sum()), "doldurulan": n_doldur, "renk_fark": n_renk_fark,
             "ufuk": ufuk, "erken_var": erk is not None}
    _log(f"   full outer join: {bilgi['n']:,} kişi | ikisinde de {bilgi['iki']:,} | yalnız {_KT_T} {bilgi['yalniz_t']:,} | "
         f"yalnız {_KT_TK} {bilgi['yalniz_tk']:,} | df_raw'dan tamamlanan hedef (batık / takip veya kırmızı): "
         f"{n_doldur[0]:,} / {n_doldur[1]:,} | hedefi bilinmeyen: {bilgi['batik_bos']:,} / {bilgi['tk_bos']:,}"
         + (f" | ⚠ iki modelde farklı renkte görünen: {n_renk_fark:,}" if n_renk_fark else ""))
    return J, bilgi


