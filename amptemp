        iptal.textContent = "İptal ediliyor…";
        if (iptalEt) iptalEt();
    };
    alt.appendChild(iptal);
    balon.appendChild(alt);

    let gecen = 0;
    const enFazla = Math.round(ISTEK_ZAMAN_ASIMI / 1000);
