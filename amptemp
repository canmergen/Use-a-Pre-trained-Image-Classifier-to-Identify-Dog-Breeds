/* ==================== Kolon listesi ==================== */
/* Hedef değişken / kimlik / dönem alanlari VERI SETI DEGIL, secili veri
   setinin KOLONLARINI onerir. Oncelik backend'in gonderdigi
   _secim_alani.kolonlar; o bos gelirse secili veri seti icin /kolonlar
   ucundan cekilir. Istek basarisiz olursa alan SERBEST yazmaya duser:
   kullanici engellenmez, ekranda nedeni yazar. */
let KOLONLAR = [];
let KOLON_DURUMU = "hata";      // "yukleniyor" | "hazir" | "bos" | "hata"
let KOLON_KAYNAGI = null;       // kolonlarin okundugu veri seti adi
const KOLON_DINLEYICILER = [];  // liste gelince acik formlar kendini tazeler

/* Son yanitin ozet/detay govdesi: secili veri setinin adi buradan okunur */
let SON_OZET = null;
let SON_DETAY = null;

function kolonlariDuyur() { KOLON_DINLEYICILER.forEach(f => f()); }

function doluDeger(v) {
    const s = String(v === null || v === undefined ? "" : v).trim();
    if (!s || s === BOS_SIMGE || s === "-" || s === "—" || s === "–") return "";
    return s;
}

/* Secili veri setinin adi: once ust ozet kartlari, sonra ozet sayfasi.
   Backend ayri bir alan gondermiyor; bu iki govde zaten her yanitta gelir. */
function seciliVeriSeti() {
    const kartlar = (SON_OZET && SON_OZET.kartlar) || [];
    for (let i = 0; i < kartlar.length; i++) {
        const etiket = String(kartlar[i].etiket || "").toLocaleLowerCase("tr-TR");
        if (etiket.indexOf("veri seti") !== -1) {
            const v = doluDeger(kartlar[i].deger);
            if (v) return v;
        }
    }
    const bolumler = (SON_DETAY && SON_DETAY.bolumler) || [];
    for (let i = 0; i < bolumler.length; i++) {
        const satirlar = bolumler[i].satirlar || [];
        for (let j = 0; j < satirlar.length; j++) {
            const ad = String(satirlar[j][0] || "").toLocaleLowerCase("tr-TR");
            if (ad.indexOf("veri seti") !== -1) {
                const v = doluDeger(satirlar[j][1]);
                if (v) return v;
            }
        }
    }
    return null;
}

/* Kolon kaynagini forma gore hazirlar. Sessizce bos birakmaz:
   kolon adi bulunamazsa durum "hata" olur ve alan serbest yazmaya duser. */
function kolonlariHazirla(alan) {
    const gelen = (alan && alan.kolonlar) || [];
    if (gelen.length) {
        KOLONLAR = gelen.slice();
        KOLON_DURUMU = "hazir";
        KOLON_KAYNAGI = seciliVeriSeti();
        kolonlariDuyur();
        return;
    }

    const veriSeti = seciliVeriSeti();
    if (!veriSeti) {
        // Hangi veri setinin kolonlari sorulacagi bilinmiyor: serbest yaz.
        KOLONLAR = [];
        KOLON_DURUMU = "hata";
        KOLON_KAYNAGI = null;
        kolonlariDuyur();
        return;
    }
    if (KOLON_KAYNAGI === veriSeti
        && (KOLON_DURUMU === "hazir" || KOLON_DURUMU === "yukleniyor")) {
        kolonlariDuyur();       // ayni veri seti icin ikinci kez cekme
        return;
    }

    KOLONLAR = [];
    KOLON_DURUMU = "yukleniyor";
    KOLON_KAYNAGI = veriSeti;
    kolonlariDuyur();

    fetch(getWebAppBackendUrl("kolonlar")
          + "?veri_seti=" + encodeURIComponent(veriSeti))
        .then(r => r.json())
        .then(d => {
            const liste = (d && d.kolonlar) || [];
            if (d && d.hata) { KOLONLAR = []; KOLON_DURUMU = "hata"; }
            else {
                KOLONLAR = liste;
                KOLON_DURUMU = liste.length ? "hazir" : "bos";
            }
        })
        .catch(() => { KOLONLAR = []; KOLON_DURUMU = "hata"; })
        .finally(() => { kolonlariDuyur(); });
}


/* ==================== Seçim formu ==================== */
/* tip "form"  : bir veya iki tekli alan (alan.deger varsa dolu acilir)
   tip "liste" : + ile ekle, − ile cikar coklu liste
   YALNIZCA listedeki veri setleri kabul edilir. Liste okunamadiysa elle
   yazmaya izin verilir; tablo varligi backend'de kontrol edilir. */

const SECILDI_ETIKETI = "Seçildi ✓";
const GECERSIZ_GOLGE = "0 0 0 var(--halka) var(--amber-halka)";
const LISTE_YUKSEKLIGI = 208;            /* .combo-liste max-height ile ayni */
let KOMBO_SAYAC = 0;

/* Combo kaynaklari. Varsayilan "dataset": mevcut davranis aynen korunur.
   "kolon": secili veri setinin kolonlari. "serbest": liste yok, elle yazilir.
   Liste okunamadiysa ya da bos dondüyse elle yazmaya izin verilir. */
const COMBO_KAYNAKLARI = {
    dataset: {
        liste: () => DATASETLER,
        durum: () => DATASET_DURUMU,
        dinleyiciler: DATASET_DINLEYICILER,
        placeholder: "Veri seti ara…",
        yukleniyor_mesaji: "Veri seti listesi yükleniyor…",
        hata_mesaji: "Veri seti listesi okunamadı - adı elle yazabilirsiniz; "
                     + "erişim, seçimden sonra kontrol edilir.",
        bos_durum_mesaji: "Bu projede veri seti bulunamadı - adı elle "
                          + "yazabilirsiniz; erişim, seçimden sonra kontrol edilir.",
        eslesme_yok: "Eşleşen veri seti yok - listeden bir veri seti seçin.",
        uyari: "Bu ad veri seti listesinde yok"
    },
    kolon: {
        liste: () => KOLONLAR,
        durum: () => KOLON_DURUMU,
        dinleyiciler: KOLON_DINLEYICILER,
        placeholder: "Kolon ara…",
        yukleniyor_mesaji: "Kolon listesi yükleniyor…",
        hata_mesaji: "Kolon listesi okunamadı - adı elle yazabilirsiniz; "
                     + "doğruluğu, seçimden sonra kontrol edilir.",
        bos_durum_mesaji: "Veri setinin kolonları okunamadı - adı elle "
                          + "yazabilirsiniz; doğruluğu, seçimden sonra kontrol edilir.",
        eslesme_yok: "Eşleşen kolon yok",
        uyari: "Bu ad veri setinin kolonları arasında yok"
    },
    serbest: {
        liste: () => [],
        durum: () => "bos",
        dinleyiciler: null,          // tazelenecek liste yok
        placeholder: "Değeri yazın…",
        yukleniyor_mesaji: "",
        hata_mesaji: "Bu alanı elle yazabilirsiniz.",
        bos_durum_mesaji: "Bu alanı elle yazabilirsiniz.",
        eslesme_yok: "",
        uyari: ""
    }
};

/* secenekler = {liste, placeholder, zorunlu, bos_mesaji, kaynak}
   liste       : disaridan sabit liste (verilmezse kaynagin canli listesi)
   placeholder : giris kutusu ipucu
   zorunlu     : false ise alan BOS birakilabilir ("Devam et" beklemez)
   bos_mesaji  : filtreye uyan oge kalmadiginda gosterilecek metin
   kaynak      : "dataset" (varsayilan) | "kolon" | "serbest" */
function comboYap(etiket, degisince, baslangic, secenekler) {
    const s = secenekler || {};
    const kaynak = COMBO_KAYNAKLARI[s.kaynak] || COMBO_KAYNAKLARI.dataset;
    const sabitListe = Array.isArray(s.liste) ? s.liste : null;
    const listeAl = sabitListe ? () => sabitListe : kaynak.liste;
    const durumAl = sabitListe
        ? () => (sabitListe.length ? "hazir" : "bos")
        : kaynak.durum;
    const zorunlu = (s.zorunlu === false) ? false : true;
    const eslesmeYok = s.bos_mesaji || kaynak.eslesme_yok;

    const no = ++KOMBO_SAYAC;
    const kok = document.createElement("div");
    kok.className = "combo";

    const listeId = "combo-liste-" + no;
    const girisId = "combo-giris-" + no;

    if (etiket) {
        const lbl = document.createElement("label");
        lbl.textContent = tireSade(etiket);
        lbl.htmlFor = girisId;
        kok.appendChild(lbl);
    }

    const giris = document.createElement("input");
    giris.className = "combo-giris";
    giris.id = girisId;
    giris.placeholder = s.placeholder || kaynak.placeholder;
    giris.autocomplete = "off";
    giris.value = baslangic || "";
    giris.setAttribute("role", "combobox");
    giris.setAttribute("aria-autocomplete", "list");
    giris.setAttribute("aria-expanded", "false");
    giris.setAttribute("aria-controls", listeId);
    giris.setAttribute("aria-required", zorunlu ? "true" : "false");
    kok.appendChild(giris);

    /* Listeyi acip kapatan ok dugmesi. Odak listeyi actigi surece bu gereksizdi;
       artik acmanin TEK gorunur yolu bu (klavye: ArrowDown). */
    const okBtn = document.createElement("button");
    okBtn.type = "button";
    okBtn.className = "combo-ok";
    okBtn.tabIndex = -1;                 // Tab sirasini bozmasin; input yeter
    okBtn.setAttribute("aria-label", "Listeyi aç");
    okBtn.title = "Listeyi aç";
    okBtn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" '
        + 'fill="none" stroke="currentColor" stroke-width="2.4" '
        + 'stroke-linecap="round" stroke-linejoin="round">'
        + '<polyline points="6 9 12 15 18 9"></polyline></svg>';
    kok.appendChild(okBtn);

    const liste = document.createElement("ul");
    liste.className = "combo-liste";
    liste.id = listeId;
    liste.setAttribute("role", "listbox");
    kok.appendChild(liste);

    let ogeler = [];          // klavye ile gezilebilen li'ler
    let vurguIndeks = -1;

    function bilgiSatiri(metin) {
        const li = document.createElement("li");
        li.className = "bos";
        li.textContent = metin;
        liste.appendChild(li);
    }

    /* Listedeki adin yazim farkini duzelten arama (buyuk/kucuk harf) */
    function bul(ad) {
        const a = (ad || "").trim().toLowerCase();
        if (!a) return null;
        return listeAl().find(x => String(x).toLowerCase() === a) || null;
    }

    function gecerli() {
        const yazi = giris.value.trim();
        /* zorunlu:false alan bos birakilabilir; "Devam et" onu beklemez */
        if (!yazi) return !zorunlu;
        const d = durumAl();
        if (d === "hazir") return bul(yazi) !== null;
        if (d === "hata" || d === "bos") return yazi.length > 1;
        return false;                   // "yukleniyor"
    }

    function deger() {
        return bul(giris.value) || giris.value.trim();
    }

    /* Yazili ama listede olmayan ad: turuncu cerceve */
    function isaretle() {
        const hatali = durumAl() === "hazir"
            && giris.value.trim() !== ""
            && bul(giris.value) === null;
        giris.style.boxShadow = hatali ? GECERSIZ_GOLGE : "";
        giris.style.borderColor = hatali ? "var(--amber)" : "";
        giris.title = hatali ? kaynak.uyari : "";
    }

    function vurgula(i) {
        vurguIndeks = i;
        ogeler.forEach((li, k) => {
            const secili = (k === i);
            li.classList.toggle("vurgu", secili);
            li.setAttribute("aria-selected", secili ? "true" : "false");
        });
        if (i >= 0 && ogeler[i]) {
            giris.setAttribute("aria-activedescendant", ogeler[i].id);
            const li = ogeler[i];
            if (li.offsetTop < liste.scrollTop) liste.scrollTop = li.offsetTop;
            else if (li.offsetTop + li.offsetHeight > liste.scrollTop + liste.clientHeight)
                liste.scrollTop = li.offsetTop + li.offsetHeight - liste.clientHeight;
        } else {
            giris.removeAttribute("aria-activedescendant");
        }
    }

    function sec(ad) {
        giris.value = ad;
        kapat();
        isaretle();
        if (degisince) degisince();
    }

    function ciz(filtre) {
        liste.innerHTML = "";
        ogeler = [];
        vurguIndeks = -1;
        giris.removeAttribute("aria-activedescendant");

        const d = durumAl();
        if (d === "yukleniyor") { bilgiSatiri(kaynak.yukleniyor_mesaji); return; }
        if (d === "hata")       { bilgiSatiri(kaynak.hata_mesaji); return; }
        if (d === "bos")        { bilgiSatiri(kaynak.bos_durum_mesaji); return; }

        const f = (filtre || "").toLowerCase();
        const sonuc = listeAl()
            .filter(x => String(x).toLowerCase().includes(f)).slice(0, 80);
        if (!sonuc.length) {
            bilgiSatiri(eslesmeYok);
            return;
        }
        sonuc.forEach((x, i) => {
            const ad = String(x);
            const li = document.createElement("li");
            li.textContent = ad;
            li.id = listeId + "-" + i;
            li.setAttribute("role", "option");
            li.setAttribute("aria-selected", "false");
            li.onmousedown = e => { e.preventDefault(); sec(ad); };
            li.onmousemove = () => vurgula(i);
            liste.appendChild(li);
            ogeler.push(li);
        });
    }

    function acikMi() { return liste.classList.contains("acik"); }

    /* Liste asagi sigmiyorsa yukari acilir; yine de tasiyorsa sohbet
       kaydirilir — kart her zaman en altta oldugu icin gerekli. */
    function konumla() {
        liste.classList.remove("yukari");
        if (!sohbetEl) return;
        const g = giris.getBoundingClientRect();
        const alan = sohbetEl.getBoundingClientRect();
        const asagi = alan.bottom - g.bottom;
        const yukari = g.top - alan.top;
        const gerekli = Math.min(LISTE_YUKSEKLIGI, liste.scrollHeight + 8);
        if (asagi < gerekli && yukari > asagi) {
            liste.classList.add("yukari");
            return;
        }
        const tasma = (g.bottom + gerekli) - alan.bottom;
        if (tasma > 0) sohbetEl.scrollTop += tasma + 8;
    }

    function ac(filtre) {
        ciz(filtre);
        liste.classList.add("acik");
        giris.setAttribute("aria-expanded", "true");
        konumla();
    }

    function kapat() {
        liste.classList.remove("acik");
        liste.classList.remove("yukari");
        giris.setAttribute("aria-expanded", "false");
        vurgula(-1);
    }

    /* Odaklanmak listeyi ACMAZ. Kullanici alana tiklayinca ekranin yarisini
       kaplayan bir liste acilmasi rahatsiz ediciydi; liste artik yalnizca
       ISTENDIGINDE acilir: ok dugmesi, yazmaya baslama ya da ArrowDown. */
    giris.addEventListener("focus", () => {
        giris.style.boxShadow = "";
        giris.style.borderColor = "";
    });
    okBtn.addEventListener("mousedown", e => {
        e.preventDefault();              // input odagi kaybolmasin
        if (acikMi()) { kapat(); }
        else { giris.focus(); ac(gecerli() ? "" : giris.value); }
    });

    giris.addEventListener("input", () => {
        ac(giris.value);
        if (degisince) degisince();
    });
    giris.addEventListener("blur", () => {
        setTimeout(kapat, 130);
        const bulunan = bul(giris.value);
        if (bulunan) giris.value = bulunan;
        isaretle();
        if (degisince) degisince();
    });

    /* Klavye: ok tuslariyla gezinme, Enter ile secim, Escape ile kapatma */
    giris.addEventListener("keydown", e => {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            if (!acikMi()) { ac(gecerli() ? "" : giris.value); }
            if (!ogeler.length) return;
            const yon = (e.key === "ArrowDown") ? 1 : -1;
            let i = vurguIndeks + yon;
            if (i < 0) i = ogeler.length - 1;
            if (i >= ogeler.length) i = 0;
            vurgula(i);
            return;
        }
        if (e.key === "Home" && acikMi() && ogeler.length) {
            e.preventDefault(); vurgula(0); return;
        }
        if (e.key === "End" && acikMi() && ogeler.length) {
            e.preventDefault(); vurgula(ogeler.length - 1); return;
        }
        if (e.key === "Escape") { kapat(); return; }
        if (e.key === "Tab") { kapat(); return; }
        if (e.key === "Enter") {
            e.preventDefault();
            if (acikMi() && vurguIndeks >= 0 && ogeler[vurguIndeks]) {
                // Vurgulu ogeyi sec; bu Enter'i baska dinleyici (ekle) gormesin
                e.stopImmediatePropagation();
                sec(ogeler[vurguIndeks].textContent);
                return;
            }
            const bulunan = bul(giris.value);
            if (bulunan) giris.value = bulunan;
            kapat();
            isaretle();
            if (degisince) degisince();
        }
    });

    /* Liste sonradan gelirse (dataset ya da kolon) form kendini tazeler */
    if (kaynak.dinleyiciler) kaynak.dinleyiciler.push(() => {
        if (giris.disabled) return;
        const bulunan = bul(giris.value);
        if (bulunan) giris.value = bulunan;
        if (acikMi()) ac(giris.value);
        isaretle();
        if (degisince) degisince();
    });

    isaretle();
    return { kok, giris, gecerli, deger, isaretle, ciz: ac };
}

function secimAlaniEkle(alan) {
    if (!alan) return;

    const kart = document.createElement("div");
    kart.className = "secim-kart";

    const bas = document.createElement("div");
    bas.className = "secim-baslik";
    bas.textContent = tireSade(alan.baslik);
    kart.appendChild(bas);

    if (alan.aciklama) {
        const ack = document.createElement("div");
        ack.className = "secim-aciklama";
        ack.textContent = tireSade(alan.aciklama);
        kart.appendChild(ack);
    }

    const onayBtn = document.createElement("button");
    onayBtn.className = "secim-onay";
    onayBtn.type = "button";
    onayBtn.textContent = alan.buton || "Devam et";

    /* ---- tip: liste (coklu, + / −) ---- */
    if (alan.tip === "liste") {
        const secilenler = (alan.degerler || []).slice();

        const rozetler = document.createElement("div");
        rozetler.className = "secim-rozetler";

        const satir = document.createElement("div");
        satir.className = "secim-satir";

        const combo = comboYap(alan.etiket || "Tablo ara", () => ekleDurumu(),
                               "", { kaynak: alan.kaynak });
        satir.appendChild(combo.kok);

        const ekleBtn = document.createElement("button");
        ekleBtn.className = "secim-yuvarlak ekle";
        ekleBtn.type = "button";
        ekleBtn.title = "Listeye ekle";
        ekleBtn.textContent = "+";
        satir.appendChild(ekleBtn);

        kart.appendChild(satir);
        kart.appendChild(rozetler);

        function ekleDurumu() {
            if (kart.classList.contains("kilitli")) return;
            ekleBtn.disabled = !combo.gecerli()
                || secilenler.indexOf(combo.deger()) !== -1;
        }

        function durumTazele() {
            if (kart.classList.contains("kilitli")) return;
            onayBtn.disabled = secilenler.length < (alan.min || 1);
            onayBtn.textContent = (alan.buton || "Devam et")
                + (secilenler.length ? "  (" + secilenler.length + ")" : "");
            ekleDurumu();
        }

        function rozetCiz() {
            rozetler.innerHTML = "";
            secilenler.forEach((ad, i) => {
                const r = document.createElement("div");
                r.className = "secim-rozet";

                const t = document.createElement("span");
                t.textContent = ad;
                t.title = ad;          // uzun ad kisaltilir; tamami ipucunda
                r.appendChild(t);

                const sil = document.createElement("button");
                sil.className = "secim-yuvarlak sil";
                sil.type = "button";
                sil.title = "Listeden çıkar";
                sil.textContent = "−";
                sil.onclick = () => {
                    if (kart.classList.contains("kilitli")) return;
                    secilenler.splice(i, 1);
                    rozetCiz();
                    durumTazele();
                };
                r.appendChild(sil);
                rozetler.appendChild(r);
            });
        }

        function ekle() {
            if (!combo.gecerli()) {
                combo.isaretle();
                combo.ciz(combo.giris.value);
                return;
            }
            const ad = combo.deger();
            if (secilenler.indexOf(ad) !== -1) return;
            secilenler.push(ad);
            combo.giris.value = "";
            combo.isaretle();
            combo.giris.focus();
            rozetCiz();
            durumTazele();
        }

        ekleBtn.onclick = ekle;
        combo.giris.addEventListener("keydown", e => {
            if (e.key === "Enter") { e.preventDefault(); ekle(); }
        });

        onayBtn.onclick = () => {
            if (mesgul || secilenler.length < (alan.min || 1)) return;
            const oncekiMetin = onayBtn.textContent;
            const siller = Array.from(rozetler.querySelectorAll(".secim-yuvarlak.sil"));

            kart.classList.add("kilitli");
            onayBtn.disabled = true;
            onayBtn.textContent = SECILDI_ETIKETI;
            ekleBtn.disabled = true;
            combo.giris.disabled = true;
            siller.forEach(b => { b.disabled = true; });

            /* Hata olursa kart ESKI ACIK haline donsun; kullanici sikismasin */
            geriAlKilit = () => {
                kart.classList.remove("kilitli");
                onayBtn.textContent = oncekiMetin;
                onayBtn.disabled = false;
                combo.giris.disabled = false;
                siller.forEach(b => { b.disabled = false; });
                durumTazele();
            };

            gonder((alan.sablon || "{liste}").replace("{liste}", secilenler.join(", ")),
                   false);
        };

        rozetCiz();
        durumTazele();
        kart.appendChild(onayBtn);

    /* ---- tip: form (bir veya iki tekli alan) ---- */
    } else {
        const govde = document.createElement("div");
        govde.className = "secim-govde";
        const combolar = {};
        const alanlar = alan.alanlar || [];

        /* Kolon kaynakli alan varsa (hedef/kimlik/dönem) once kolon listesi
           hazirlanir: backend'in gonderdigi liste ya da /kolonlar ucu. */
        if (alanlar.some(a => (a.kaynak || "dataset") === "kolon"))
            kolonlariHazirla(alan);

        function durumTazele() {
            if (kart.classList.contains("kilitli")) return;
            onayBtn.disabled = !Object.keys(combolar)
                .every(k => combolar[k].gecerli());
        }

        alanlar.forEach(a => {
            /* Her alan kendi kaynagini kullanir: veri seti mi, kolon mu? */
            const combo = comboYap(a.etiket, durumTazele, a.deger, {
                kaynak: a.kaynak || "dataset",
                zorunlu: a.zorunlu
            });
            combolar[a.ad] = combo;
            govde.appendChild(combo.kok);
        });

        kart.appendChild(govde);

        onayBtn.onclick = () => {
            if (mesgul || onayBtn.disabled) return;
            let metin = alan.sablon || "";
            Object.keys(combolar).forEach(k => {
                const v = combolar[k].deger();
                combolar[k].giris.value = v;
                metin = metin.replace("{" + k + "}", v);
            });
            const oncekiMetin = onayBtn.textContent;
            kart.classList.add("kilitli");
            onayBtn.disabled = true;
            onayBtn.textContent = SECILDI_ETIKETI;
            Object.keys(combolar).forEach(k => { combolar[k].giris.disabled = true; });

            /* Hata olursa form ESKI ACIK haline donsun */
            geriAlKilit = () => {
                kart.classList.remove("kilitli");
                onayBtn.textContent = oncekiMetin;
                onayBtn.disabled = false;
                Object.keys(combolar).forEach(k => { combolar[k].giris.disabled = false; });
                durumTazele();
            };

            gonder(metin, false);
        };

        durumTazele();
        kart.appendChild(onayBtn);
    }

    sohbetEl.appendChild(kart);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    yeniOdak = kart.querySelector(".combo-giris") || kart.querySelector(".secim-onay");
}


/* ==================== Yanıtı ekrana uygula ==================== */
/* /karsilama, /mesaj ve /sifirla ayni govdeyi dondurur. */
function yanitUygula(d, metin) {
    const hataMi = typeof metin === "string" && metin.startsWith("HATA:");
    yeniOdak = null;
    sonYanitMetni = metin;
    /* Secili veri setinin adi bu iki govdeden okunuyor; kolon kaynakli
       form cizilmeden ONCE guncellenmeli. */
    if (d.ozet)  SON_OZET  = d.ozet;
    if (d.detay) SON_DETAY = d.detay;
    balonEkle("bot", metin, hataMi);
    secenekEkle(d.secenekler);          // balonun hemen ardindan: ayni kutuya girer
    secimAlaniEkle(d.secim_alani);
    if (typeof d.tur_no === "number") TUR_NO = Math.max(TUR_NO, d.tur_no);

    if (d.fazlar) fazlariYukle(d.fazlar);
    if (d.mod !== undefined) aktifMod = d.mod;
    if (d.adim_no !== undefined) {
        aktifAdim = d.adim_no;
        aktifFaziAc();
    }
    fazlariCiz();

    aksiyonGuncelle(d.bekleyen, d.adim_no);
    analizGuncelle(d.analiz);
    ozetGuncelle(d.ozet);
    detayGuncelle(d.detay);
    rozetGuncelle(hataMi ? "hata" : "hazir");
}


/* ==================== Gönderme ==================== */
function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    aksiyonlar.forEach(c => { c.disabled = durum; });
}

/* Hata/iptal yolunda: tiklanan kart grubunu ve secim kartini eski haline dondur */
function kartlariGeriAl() {
    if (!geriAlKilit) return;
    try { geriAlKilit(); } catch (e) { /* kart ekrandan kalkmis olabilir */ }
    geriAlKilit = null;
}

function istegiIptalEt(neden) {
    if (!istekKontrol) return;
    istekDurumu = neden || "iptal";
    try { istekKontrol.abort(); } catch (e) { /* yok say */ }
}

/* Timeout/iptal sonrasi sunucudaki gercek durumu okur: tur numarasi
   eslenir, adim sunucuda tamamlandiysa sonucu ekrana yansitir. */
function sunucudanTazele() {
    return fetch(getWebAppBackendUrl("durum")
                 + "?oturum_id=" + encodeURIComponent(OTURUM_ID))
        .then(r => r.json())
        .then(d => {
            if (!d || d.var !== true) return false;
            if (typeof d.tur_no === "number") TUR_NO = Math.max(TUR_NO, d.tur_no);
            const metin = d.metin || d.cevap;
            if (metin && metin !== sonYanitMetni) {
                yanitUygula(d, metin);
                return true;
            }
            return false;
        })
        .catch(() => false);
}

function gonder(metinDisaridan, etiket) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    sayfaAc("calisma");
    if (etiket !== false) balonEkle("kullanici", etiket || metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);
    rozetGuncelle("mesgul");

    /* Tur numarasi yanit gelmeden ARTMAZ: timeout sonrasi ayni tur tekrar
       gonderilirse backend adimi tekrar uygulamaz, kayitli yaniti doner. */
    const tur = TUR_NO + 1;

    const kontrol = new AbortController();
    istekKontrol = kontrol;
    istekDurumu = "";
    const zamanlayici = setTimeout(() => istegiIptalEt("zamanasimi"),
                                   ISTEK_ZAMAN_ASIMI);
    const gosterge = calismaGostergesi(() => istegiIptalEt("iptal"));

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin, tur_no: tur }),
        signal: kontrol.signal
    })
    .then(r => r.json())
    .then(d => {
        gosterge.kaldir();
        /* Backend yapilandirilmis hata dondurduyse (HTTP 200 + "HATA:")
           ekranda yeni kart gelmez: tiklanan kartlari geri acmak SART. */
        const hataMi = !!d && (d.hata === true
            || (typeof d.cevap === "string" && d.cevap.startsWith("HATA:")));
        if (hataMi) kartlariGeriAl();
        else geriAlKilit = null;        // yanit geldi: eski kartlara donulmeyecek
        yanitUygula(d, d.cevap);
    })
    .catch(e => {
        gosterge.kaldir();
        if (istekDurumu === "sifirla") return;   // sifirlama ekrani zaten kuruyor
        kartlariGeriAl();
        rozetGuncelle("hata");

        if (istekDurumu === "zamanasimi") {
            balonEkle("bot",
                "İşlem " + sureBicim(Math.round(ISTEK_ZAMAN_ASIMI / 1000))
                + " içinde yanıt vermedi. Sunucu adımı tamamlamış olabilir; "
                + "güncel durum kontrol ediliyor. Aynı adımı tekrar "
                + "onaylarsanız işlem İKİ KEZ uygulanmaz.", true);
            sunucudanTazele();
        } else if (istekDurumu === "iptal") {
            balonEkle("bot",
                "İsteği iptal ettiniz. Sunucudaki işlem sürüyor olabilir; "
                + "güncel durum kontrol ediliyor.", true);
            sunucudanTazele();
        } else {
            balonEkle("bot",
                "Bağlantı hatası: " + e + "\n\nSayfayı yenilediğinizde çalışma "
                + "kaldığı yerden yüklenir.", true);
        }
    })
    .finally(() => {
        clearTimeout(zamanlayici);
        const sifirlaniyor = (istekDurumu === "sifirla");
        istekDurumu = "";
        if (istekKontrol === kontrol) istekKontrol = null;
        if (sifirlaniyor) return;       // kilidi sifirlama akisi yonetiyor
        kilitle(false);
        // Yeni bir kart/form geldiyse odak oraya; yoksa yazi kutusuna
        if (yeniOdak && document.contains(yeniOdak)) {
            try { yeniOdak.focus(); } catch (err) { kutuEl.focus(); }
        } else {
            kutuEl.focus();
        }
        yeniOdak = null;
    });
}

/* Aksiyon butonlari kullanici balonu BASMAZ: "Onayla ve Uygula" yazisi
   kullanici yazmis gibi gorunuyordu. Yerine sohbete sessiz bir ayrac
   (aksiyon izi) dusuyor - bu bir balon degil, ince bir ayrac satiri. */
const AKSIYON_IZLERI = {
    onayla:   "✓ Onaylandı",
    degistir: "Değiştir seçildi",
    geri:     "Geri dönüldü"
};

function aksiyonIzMetni(buton) {
    if (buton.dataset && buton.dataset.iz) return buton.dataset.iz;
    const anahtar = Object.keys(AKSIYON_IZLERI)
        .find(k => buton.classList.contains(k));
    return anahtar ? AKSIYON_IZLERI[anahtar]
                   : (buton.dataset.etiket || buton.textContent).trim();
}

function aksiyonIziEkle(metin) {
    const iz = document.createElement("div");
    iz.className = "aksiyon-izi";
    const yazi = document.createElement("span");
    yazi.textContent = tireSade(metin);
    iz.appendChild(yazi);
    sohbetEl.appendChild(iz);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return iz;
}

gonderEl.onclick = () => gonder();
aksiyonlar.forEach(c => {
    c.onclick = () => {
        if (mesgul) return;
        const iz = aksiyonIziEkle(aksiyonIzMetni(c));
        /* Istek hata verirse iz de kalkar: yapilmamis bir islem
           yapilmis gibi durmasin. */
        geriAlKilit = () => iz.remove();
        gonder(c.dataset.mesaj, false);      // false: kullanici balonu basma
    };
});

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 96) + "px";
});


/* ==================== Karşılama ==================== */
/* Backend kayitli oturumu bulursa sohbet gecmisiyle birlikte devam eder;
   F5 saatlerce suren calismayi silmez. */
function gecmisiCiz(gecmis, sonMetin) {
    const liste = (gecmis || []).slice();
    const son = liste[liste.length - 1];
    if (son && son.rol === "bot" && son.metin === sonMetin) liste.pop();
    liste.forEach(g => {
        const hataMi = typeof g.metin === "string" && g.metin.startsWith("HATA:");
        balonEkle(g.rol === "kullanici" ? "kullanici" : "bot", g.metin, hataMi);
    });
}

/* Turkce tarih: gg.aa.yyyy ss:dd. Gecersiz/boş tarihte satir atlanir. */
function tarihBicim(iso) {
    if (!iso) return "";
    const t = new Date(iso);
    if (isNaN(t.getTime())) return "";
    const iki = n => (n < 10 ? "0" : "") + n;
    return iki(t.getDate()) + "." + iki(t.getMonth() + 1) + "." + t.getFullYear()
        + " " + iki(t.getHours()) + ":" + iki(t.getMinutes());
}

/* "Kaldigi yerden yuklendi" mesaji: nereden yuklendigi ve nasil
   sifirlanacagi acikca yazilir. devam_bilgi yoksa kisa mesaj kalir. */
function devamMetni(bilgi) {
    const bas = "**Önceki çalışmanız kaldığı yerden yüklendi.**";
    if (!bilgi) return bas;

    const parcalar = [];
    const zaman = tarihBicim(bilgi.zaman);
    if (zaman) parcalar.push("Son işlem: " + zaman);

    const adimNo = bilgi.adim_no;
    if (adimNo !== undefined && adimNo !== null && bilgi.toplam) {
        parcalar.push("Adım " + adimNo + "/" + bilgi.toplam
                      + (bilgi.adim ? " - " + tireSade(bilgi.adim) : ""));
    } else if (bilgi.adim) {
        parcalar.push(tireSade(bilgi.adim));
    }
    if (bilgi.veri_seti) parcalar.push("Veri seti: " + tireSade(bilgi.veri_seti));

    const satirlar = [bas];
    if (parcalar.length) satirlar.push(parcalar.join(" · "));
    satirlar.push("Çalışma, Dataiku'daki " + HAFIZA_KLASORU + " klasöründe sizin "
                  + "kullanıcı adınıza kayıtlı. Sıfırdan başlamak için sağ "
                  + "üstteki **" + YENI_CALISMA_ETIKETI + "** düğmesini kullanın.");
    return satirlar.join("\n");
}

fetch(getWebAppBackendUrl("karsilama")
      + "?oturum_id=" + encodeURIComponent(OTURUM_ID))
    .then(r => r.json())
    .then(d => {
        const metin = d.metin || d.cevap;
        if (d.devam) {
            // Bilgi satiri en ustte; kartlar son yanitin altinda kalsin
            balonEkle("bot", devamMetni(d.devam_bilgi));
            gecmisiCiz(d.gecmis, metin);
        }
        yanitUygula(d, metin);
    })
    .catch(e => {
        rozetGuncelle("hata");
        balonEkle("bot", "Bağlantı hatası: " + e, true);
    });


/* ==================== Yeni oturum ==================== */
/* Tum calismayi silen bir islem: sohbet icinde onay kartiyla sorulur.
   native confirm() KULLANILMIYOR - Dataiku iframe'inde akisi bloklar. */
function sifirlaUygula() {
    /* Ucusta bir /mesaj varsa once onu iptal et: gec donen yanit
       sifirlanan durumun uzerine yazmasin. */
    if (mesgul) istegiIptalEt("sifirla");
    kilitle(true);
    rozetGuncelle("mesgul");
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        aktifMod = null;
        TUR_NO = 0;
        sonYanitMetni = null;
        geriAlKilit = null;
        acikFazlar = new Set();
        yanitUygula(d, d.metin || d.cevap);
        sayfaAc("calisma");
    })
    .catch(e => {
        rozetGuncelle("hata");
        balonEkle("bot", "Oturum sıfırlanamadı: " + e, true);
    })
    .finally(() => { kilitle(false); });
}

function sifirlaOnayiSor() {
    const eski = sohbetEl.querySelector(".sifirla-onay");
    if (eski) { eski.querySelector(".secim-onay").focus(); return; }

    const kart = document.createElement("div");
    kart.className = "secim-kart sifirla-onay";

    const bas = document.createElement("div");
    bas.className = "secim-baslik";
    bas.textContent = YENI_CALISMA_ETIKETI + ": mevcut çalışma silinsin mi?";
    kart.appendChild(bas);

    const ack = document.createElement("div");
    ack.className = "secim-aciklama";
    ack.textContent = "Bu işlem sayfayı yenilemez; " + HAFIZA_KLASORU
        + " klasöründeki mevcut çalışmanın TAMAMINI siler ve sıfırdan yeni bir "
        + "çalışma başlatır: sohbet geçmişi, seçimler ve tamamlanan adımlar "
        + "kaybolur. Geri alınamaz.";
    kart.appendChild(ack);

    const dugmeler = document.createElement("div");
    dugmeler.className = "onay-dugmeler";

    const evet = document.createElement("button");
    evet.type = "button";
    evet.className = "secim-onay";
    evet.textContent = "Evet, yeni çalışma başlat";
    evet.onclick = () => { kart.remove(); sifirlaUygula(); };

    const hayir = document.createElement("button");
    hayir.type = "button";
    hayir.className = "secim-onay ikincil";
    hayir.textContent = "Vazgeç";
    hayir.onclick = () => { kart.remove(); kutuEl.focus(); };

    dugmeler.appendChild(evet);
    dugmeler.appendChild(hayir);
    kart.appendChild(dugmeler);

    sohbetEl.appendChild(kart);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    hayir.focus();          // yanlislikla Enter'a basilirsa vazgecilsin
}

document.getElementById("sifirla-btn").onclick = () => {
    sayfaAc("calisma");
    sifirlaOnayiSor();      // once onay: buton "yenile" sanilip tiklaniyordu
};

















:root {
  /* ===== YAZI OLCEGI - tum arayuz yalnizca bu degerleri kullanir =====
     Tek font: Calibri (urun adindaki font).
     Olcek, onceki tasarimin %80 zoom halidir; ama tarayici zoom'u
     boyutlari kuruslu yapar (14px -> 11.2px) ve Calibri Windows'ta
     kuruslu boyutta bulanik cizilir. Bu yuzden TUM boyutlar tam piksel.
     Yeni bir boyut eklersen de tam piksel ver.
     Calibri'de yalnizca 3 agirlik var: 300 (Light), 400 (Regular),
     700 (Bold). Bu yuzden yalnizca --fw-normal ve --fw-kalin kullanilir.
     Buyuk harf CSS ile DEGIL, HTML/Python'da yazilir (Turkce I/İ). */
  --fs-kucuk:  11px;     /* faz no, sayac, durum cipi */
  --fs-etiket: 12px;     /* BUYUK HARFLI kirmizi etiketler: ANALİTİK SÜREÇ, VERİ SETİ... */
  --fs-govde:  12px;     /* metin, butonlar */
  --fs-baslik: 13px;     /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  15px;     /* urun adi, sayfa basligi */

  --fw-normal: 400;
  --fw-kalin:  700;

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  /* Buyuk harf araligi: az tutuldu, Calibri'nin dar buyuk harfleri
     acildikca seyrek ve farkli bir font gibi gorunuyor */
  --etiket-aralik: .02em;

  /* ===== BILESEN SISTEMI - kose, bosluk, yukseklik, golge ===== */
  --r:         6px;      /* kart, balon, buton, giris kutusu */
  --r-kucuk:   5px;      /* sekme, cip, liste ogesi, ic alan */
  --b-1: 3px;  --b-2: 6px;  --b-3: 10px;  --b-4: 13px;  --b-5: 16px;  --b-6: 19px;
  --btn-h:     29px;     /* tum ana butonlar */
  --btn-h-kucuk: 24px;   /* ikon butonlari, Gonder */
  --serit:     3px;      /* kart solundaki marka vurgu cubugu */
  --halka:     2px;      /* odak ve hover halkasi kalinligi */
  --golge-1:   0 1px 2px rgba(16,24,40,.06);
  --golge-2:   0 5px 13px rgba(16,24,40,.10);

  /* ===== RENK - zemin notr, kirmizi yalnizca vurgu ===== */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-acik: #FDF1F1;
  --kirmizi-halka: rgba(213,17,21,.16);

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #F9FAFB;
  --kenar:        #DDE1E6;          /* kart, balon, form kenarlari */
  --kenar-guclu:  #BFC5CE;
  --kenar-acik:   #EDEFF2;
  /* Yalnizca 3 yapisal ayrac: ust bar alti, sol panel sagi, sag panel solu.
     Notr (mavimsi degil) ve saydam: hangi zeminde olursa olsun hafif kalir. */
  --ayrac:        rgba(0,0,0,.08);

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.66);

  --user-zemin:   #EEF0F3;          /* kullanici balonu: bot'tan ayrissin */

  --gonder-zemin: #111111;
  --gonder-metin: #FFFFFF;

  /* ===== SOHBET ARKA PLANI =====
     Gorsel JS'ten gelir. Uzerinde zemin renginde bir perde var.
     --sohbet-perde-gucu:    acilistaki perde. 0 = gorsel tamamen gorunur,
                             1 = gorsel hic gorunmez
     --sohbet-perde-calisma: sohbet basladiktan sonraki (en az 2 mesaj) perde.
                             Acilista gorsel belirgin, calisirken sakin kalir.
                             Hep ayni kalsin istersen --sohbet-perde-gucu ile
                             ayni degeri ver.
     --sohbet-bulanik:       0px = bulaniklik yok; 4px, 8px... arttikca bulanir */
  --sohbet-gorsel: none;
  --sohbet-perde-gucu:    .42;
  --sohbet-perde-calisma: .8;
  --sohbet-bulanik:       13px;

  --yesil:        #0E8A52;
  --yesil-acik:   #E6F4EC;
  --amber:        #B45309;
  --amber-acik:   #FEF3C7;
  --amber-halka:  rgba(217,119,6,.30);
  --sari:         #EAB308;
  --sari-koyu:    #000000;          /* sari zemin ustundeki metin rengi */
  --sari-acik:    #FDF6D3;

  /* Sol panel: dar ekranda 208px, genis ekranda en fazla 264px */
  --panel-en:   clamp(208px, 19vw, 264px);
  /* Sag panel: dar ekranda 304px, genis ekranda en fazla 432px */
  --analiz-en:  clamp(304px, 29vw, 432px);
  --avatar:     24px;
  --girinti:    32px;              /* avatar (24px) + bosluk (8px) */
  --ustbar-h:   70px;             /* ust bar yuksekligi; logo buna gore olceklenir */
  --sohbet-yan: 19px;

  /* LLM balonu icin UST SINIR. Icerik kisaysa daha dar kalir. */
  --balon-en:     min(calc(100% - var(--girinti)), 42rem);
  /* Secenek karti tasiyan balonun ALT SINIRI - kartlar ezilmesin */
  --secenekli-en: min(calc(100% - var(--girinti)), 24rem);
  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami */
  --govde-en:     calc(100% - var(--girinti));
}

/* -------- KOYU TEMA -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #E03B3E;
  --kirmizi-acik: #2A1517;
  --kirmizi-halka: rgba(255,77,79,.22);

  --zemin:        #111111;
  --yuzey:        #181818;
  --yuzey-alt:    #141414;
  --kenar:        #2E2E2E;
  --kenar-guclu:  #454545;
  --kenar-acik:   #232323;
  --ayrac:        rgba(255,255,255,.10);

  --metin:        #FFFFFF;
  --metin-soluk:  rgba(255,255,255,.68);

  --user-zemin:   #262626;

  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;

  --golge-1:   0 1px 2px rgba(0,0,0,.5);
  --golge-2:   0 5px 13px rgba(0,0,0,.55);

  --yesil:        #3DDC8A;
  --yesil-acik:   #10281B;
  --amber:        #F5B042;
  --amber-acik:   #2A2210;
  /* Koyu zeminde uyari halkasi acik temadaki degerle neredeyse gorunmezdi */
  --amber-halka:  rgba(245,176,66,.42);
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: var(--font);
  font-size: var(--fs-govde);
  font-weight: var(--fw-normal);
  line-height: 1.5;
  /* Rakamlar: satir hizasinda (lining) ve esit genislikte (tabular) */
  font-variant-numeric: lining-nums tabular-nums;
  text-rendering: optimizeLegibility;
  transition: background .2s, color .2s;
}
#kabuk *, #kabuk button, #kabuk input, #kabuk textarea {
  font-family: var(--font);
}
[hidden] { display: none !important; }

/* Sayfa basligi: ÇALIŞMA ÖZETİ - urun adiyla ayni boyut, ortali */
#ozet-h1 {
  font-size: var(--fs-buyuk); font-weight: var(--fw-kalin);
  letter-spacing: .03em; line-height: 1.3;
  color: var(--kirmizi); text-align: center;
}

/* Kirmizi etiketler: ANALİTİK SÜREÇ, İŞ AKIŞI, VERİ SETİ, SÖZLÜK...,
   ozet sayfasi kart basliklari. Urun adiyla ayni font, agirlik ve renk.
   Renk dogrudan --kirmizi: koyu temada otomatik acik kirmiziya doner.
   Hizalamayi bulunduklari kutu belirler. */
.panel-baslik, .ozet-etiket, .ozet-blok-baslik {
  font-size: var(--fs-etiket); font-weight: var(--fw-kalin);
  letter-spacing: var(--etiket-aralik); line-height: 1.3;
  color: var(--kirmizi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(11px, 1.6vw, 21px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--ayrac); flex-shrink: 0;
  gap: clamp(11px, 1.6vw, 22px);
}
#ustbar-sol { display: flex; align-items: center; gap: var(--b-4); flex-shrink: 0; }
#banner { height: calc(var(--ustbar-h) - 19px); width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: var(--b-4); line-height: 1.3; }
#urun-adi {
  font-weight: var(--fw-kalin); font-size: var(--fs-buyuk); letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt {
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  margin-top: 2px; white-space: nowrap;
}

#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(8px, 1.2vw, 16px);
  border-right: 1px solid var(--kenar-acik);
  line-height: 1.3;               /* 4 satir 70px bara rahat sigsin */
  text-align: center;             /* etiket ve icerik kendi bolmesinde ortali */
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket { display: block; margin-bottom: 2px; }
.ozet-deger {
  display: block;
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--metin-soluk); }
.ozet-ust, .ozet-alt {
  display: block; font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 5px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: var(--b-2); }

#tema-btn, #sifirla-btn, .cekmece-btn {
  display: flex; align-items: center; justify-content: center;
  width: 22px; height: 22px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: var(--r-kucuk); cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn svg, #sifirla-btn svg, .cekmece-btn svg { width: 12px; height: 12px; }
#tema-btn:hover, #sifirla-btn:hover, .cekmece-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
/* Çekmece düğmeleri yalnızca panelin gizlendiği dar ekranlarda görünür */
.cekmece-btn { display: none; }

#durum-rozet {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--yesil); display: inline-block; flex-shrink: 0;
}
/* Rozet son isteğin sonucunu gösterir: backend cevap vermiyorsa yeşil kalmaz */
#durum-rozet.mesgul .nokta-yesil { background: var(--sari); }
#durum-rozet.hata   .nokta-yesil { background: var(--kirmizi); }
#durum-rozet.hata { color: var(--kirmizi); }

#sekmeler {
  display: flex; gap: 2px; padding: 2px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: var(--r);
}
.sekme {
  flex: 1; height: 22px; padding: 0 var(--b-5);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: var(--etiket-aralik);
  border: none; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif { background: var(--kirmizi); color: #fff; }

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none !important; }   /* #sayfa-calisma'nin display:flex'ini ezer */
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--ayrac);
  padding: var(--b-5) var(--b-4) 22px; overflow-y: auto;
}

.panel-blok { margin-bottom: var(--b-6); }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik { margin-bottom: var(--b-3); }
.panel-metin {
  margin: 0 0 var(--b-3); font-size: var(--fs-govde); line-height: 1.6; color: var(--metin);
  text-indent: 0;                 /* paragraf basi girintisi yok; istersen 1.5em */
}
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı -------- */
.faz { margin-bottom: 2px; }
/* baseline: ok, numara, ad ve sayac ayni yazi cizgisine oturur */
/* <button>: klavye kullanicisi de fazi acabilsin (Enter/Space dogal) */
.faz-bas {
  position: relative; overflow: hidden;
  display: flex; align-items: baseline; gap: var(--b-2);
  padding: var(--b-2); border-radius: var(--r); cursor: pointer;
  color: var(--metin);
  width: 100%; border: none; background: none; text-align: left;
  font-family: inherit; font-size: var(--fs-govde); line-height: 1.5;
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz-bas:focus-visible {
  outline: none; background: var(--kenar-acik);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
/* Aktif faz: notr zemin + solda duz kirmizi cubuk. Sari yalnizca
   adim isaretinde "devam ediyor" durumu olarak kalir. */
.faz.aktif > .faz-bas { background: var(--kenar-acik); color: var(--metin); }
.faz.aktif > .faz-bas::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 8px; text-align: center;
  font-size: var(--fs-govde); transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; min-width: 1.4em;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  color: inherit;                 /* fazin metin rengini alir: siyah / tamamlaninca yesil */
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); line-height: 1.35; color: inherit; }
.faz-ozet {
  font-size: var(--fs-govde); color: inherit; opacity: .72;
  margin-top: 2px; line-height: 1.45;
}
.faz-durum {
  flex-shrink: 0; font-size: var(--fs-kucuk);
  font-weight: var(--fw-kalin); cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 2px 0 var(--b-2) var(--b-3); padding: 0 0 0 var(--b-5);
  display: none; border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: var(--b-2);
  padding: 4px 5px; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 11px; height: 11px;
  border: 1px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 8px; font-weight: var(--fw-kalin);
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: var(--fw-kalin); }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 var(--halka) var(--sari-acik);
}

/* ==================== ORTA: ÇALIŞMA ALANI ==================== */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--zemin);
  opacity: var(--sohbet-perde-gucu);
  backdrop-filter: blur(var(--sohbet-bulanik));
  pointer-events: none;
  transition: opacity .5s ease;
}
/* Sohbet basladiginda (en az iki mesaj satiri) perde koyulasir.
   JS gerekmez; satirlar eklenince tarayici kendisi uygular. */
#sohbet-alani:has(.satir ~ .satir)::before {
  opacity: max(var(--sohbet-perde-gucu), var(--sohbet-perde-calisma));
}
#sohbet, #giris-bolge { position: relative; z-index: 1; }

/* Kaydirma YALNIZCA burada */
#sohbet {
  flex: 1; overflow-y: auto;
  padding: var(--b-6) var(--sohbet-yan) var(--b-4);
  scrollbar-gutter: stable;
}

.satir {
  display: flex; align-items: flex-start; gap: 8px;
  margin: 0 0 var(--b-4);
  width: 100%; min-width: 0;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: var(--yuzey); object-fit: cover;
  border: 1px solid var(--kenar);
}

/* Balon metni kadar uzar; yukseklik siniri ve ic kaydirma YOK */
.balon {
  min-width: 0; width: fit-content;
  padding: var(--b-3) var(--b-4); border-radius: var(--r);
  font-size: var(--fs-govde); line-height: 1.6;
  white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;
}

/* -------- Bot kutusu: balon + (varsa) seçenek kartları -------- */
.balon-sutun {
  display: flex; flex-direction: column; align-items: stretch;
  flex: 0 1 auto; width: fit-content;
  max-width: var(--balon-en); min-width: 0;
}
.balon-sutun.secenekli { min-width: var(--secenekli-en); }

/* Bot: notr yuzey, marka yalnizca solda duz ince cubukta.
   Cubuk ayri ciziliyor; kenar yuvarlakligini takip edip kivrilmiyor. */
.satir.bot .balon {
  position: relative; overflow: hidden;
  width: auto; max-width: 100%;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  padding-left: calc(var(--b-4) + var(--serit));
  box-shadow: var(--golge-1);
}
.satir.bot .balon::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
/* Secenek tasiyan balonda cubuk yok: kirmizi vurgu yalnizca
   tiklanabilir kartlarda kalir, bilgi metni ile secenekler ayrisir. */
.satir.bot .balon-sutun.secenekli .balon { padding-left: var(--b-4); }
.satir.bot .balon-sutun.secenekli .balon::before { display: none; }
.satir.bot .balon strong { font-weight: var(--fw-kalin); }

.satir.kullanici .balon {
  max-width: min(75%, calc(100% - var(--girinti)));
  background: var(--user-zemin); color: var(--metin);
  border: 1px solid transparent;
}

.satir.bot .balon.hata {
  background: var(--kirmizi-acik); color: var(--kirmizi);
  border-color: var(--kirmizi);
}

/* -------- Seçenek kartları -------- */
.secenek-kok { display: flex; flex-direction: column; gap: var(--b-2); }
.balon-sutun .secenek-kok { width: 0; min-width: 100%; margin-top: var(--b-2); }
#sohbet > .secenek-kok {
  margin: 0 0 var(--b-4) var(--girinti);
  width: fit-content; max-width: var(--balon-en);
}

.secenek {
  position: relative; overflow: hidden;
  display: flex; align-items: center; gap: var(--b-3);
  padding: var(--b-3) var(--b-4) var(--b-3) calc(var(--b-4) + var(--serit));
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  cursor: pointer; text-align: left;
  font-size: var(--fs-govde);
  box-shadow: var(--golge-1);
  transition: border-color .15s, background .15s, box-shadow .15s, opacity .15s;
}
/* Tiklanabilir kart vurgusu: duz cubuk */
.secenek::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
.secenek:hover:not(:disabled) {
  border-color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.secenek:disabled { cursor: default; opacity: .45; }
.secenek.secili {
  opacity: 1; background: var(--kirmizi-acik);
  border-color: var(--kirmizi);
}

.secenek-rozet {
  flex-shrink: 0; width: 22px; height: 22px;
  background: var(--zemin); color: var(--metin);
  border: 1px solid var(--kenar); border-radius: 50%;
  font-weight: var(--fw-kalin); font-size: var(--fs-govde);
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s, border-color .15s;
}
.secenek:hover:not(:disabled) .secenek-rozet,
.secenek.secili .secenek-rozet {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.secenek-govde { min-width: 0; flex: 1; }
.secenek-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); line-height: 1.35; }
.secenek-aciklama {
  font-size: var(--fs-govde); color: var(--metin-soluk);
  line-height: 1.5; margin-top: 2px;
}

/* -------- Seçim formu: dataset seçici -------- */
.secim-kart {
  position: relative;
  width: var(--balon-en); margin: 0 0 var(--b-4) var(--girinti);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  padding: var(--b-4) var(--b-5) var(--b-5) calc(var(--b-5) + var(--serit));
  box-shadow: var(--golge-1);
}
/* overflow:hidden YOK - acilir liste kartin disina tasabilmeli.
   Cubugun koseleri bu yuzden kendi yuvarlakligiyla kirpiliyor. */
.secim-kart::before {
  content: ""; position: absolute; left: -1px; top: -1px; bottom: -1px;
  width: var(--serit); background: var(--kirmizi);
  border-radius: var(--r) 0 0 var(--r);
}
.secim-kart.kilitli { opacity: .7; }

.secim-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); margin-bottom: 2px; }
.secim-aciklama {
  font-size: var(--fs-govde); line-height: 1.6;
  margin-bottom: var(--b-4); color: var(--metin-soluk);
}

.secim-govde { display: flex; gap: var(--b-3); flex-wrap: wrap; margin-bottom: var(--b-4); }
.secim-govde .combo { flex: 1; min-width: 160px; }

.secim-satir { display: flex; gap: var(--b-2); align-items: flex-end; margin-bottom: var(--b-3); }
.secim-satir .combo { flex: 1; }

.combo { position: relative; }
.combo label {
  display: block; font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  margin-bottom: var(--b-1); color: var(--metin);
}
.combo-giris {
  width: 100%; height: var(--btn-h); padding: 0 var(--b-3);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde);
  outline: none; background: var(--yuzey); color: var(--metin);
  transition: border-color .15s, box-shadow .15s;
}
.combo-giris::placeholder { color: var(--metin-soluk); }
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }
.combo-giris:disabled { background: var(--yuzey-alt); color: var(--metin-soluk); }

/* Listeyi acan ok dugmesi. Liste artik odaklaninca kendiliginden
   acilmiyor; gorunur tek acma yolu bu (klavye: ArrowDown). */
.combo { position: relative; }
.combo-ok {
  position: absolute; right: 1px; bottom: 1px;
  width: calc(var(--btn-h) - 2px); height: calc(var(--btn-h) - 2px);
  display: flex; align-items: center; justify-content: center;
  padding: 0; border: none; background: none; cursor: pointer;
  color: var(--metin-soluk); border-radius: var(--r-kucuk);
}
.combo-ok:hover { color: var(--kirmizi); background: var(--kirmizi-acik); }
.combo-ok svg { transition: transform .15s; }
.combo:has(.combo-liste.acik) .combo-ok svg { transform: rotate(180deg); }
.combo:has(.combo-liste.acik) .combo-ok { color: var(--kirmizi); }
/* Ok dugmesi metnin ustune binmesin */
.combo-giris { padding-right: var(--btn-h); }
.combo-giris:disabled ~ .combo-ok { display: none; }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: var(--b-1) 0 0; padding: var(--b-1); list-style: none;
  background: var(--yuzey); border: 1px solid var(--kenar);
  border-radius: var(--r); box-shadow: var(--golge-2);
  max-height: 208px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
/* Sohbet alani kaydirilabilir oldugu icin kart hep en altta kalir;
   asagi sigmayan liste YUKARI acilir (JS olcup .yukari ekler). */
.combo-liste.yukari {
  top: auto; bottom: 100%;
  margin: 0 0 var(--b-1);
}
.combo-liste li {
  padding: 5px 8px; border-radius: var(--r-kucuk); cursor: pointer;
  font-size: var(--fs-govde); color: var(--metin);
}
.combo-liste li:hover,
.combo-liste li.vurgu { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; color: var(--metin-soluk); }
.combo-liste li.bos:hover { background: none; color: var(--metin-soluk); }

.secim-yuvarlak {
  flex-shrink: 0; width: var(--btn-h); height: var(--btn-h); padding: 0;
  border-radius: var(--r-kucuk); cursor: pointer;
  font-size: 15px; font-weight: var(--fw-kalin); line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.secim-yuvarlak:disabled { opacity: .4; cursor: not-allowed; }

.secim-yuvarlak.ekle { background: var(--kirmizi); color: #fff; border: none; }
.secim-yuvarlak.ekle:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.secim-yuvarlak.sil {
  width: 20px; height: 20px; font-size: 12px;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
}
.secim-yuvarlak.sil:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}

.secim-rozetler { display: flex; flex-direction: column; gap: 5px; margin-bottom: var(--b-4); }
/* Uzun veri seti adi rozeti tasirip "−" butonunu ekran disina itmesin */
.secim-rozet {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); padding: 4px 5px 4px var(--b-3);
  font-size: var(--fs-govde);
  min-width: 0; max-width: 100%;
}
.secim-rozet > span {
  min-width: 0; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.secim-onay {
  height: var(--btn-h); padding: 0 var(--b-6);
  background: var(--kirmizi); color: #fff;
  border: none; border-radius: var(--r);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  cursor: pointer; white-space: nowrap;
}
.secim-onay:hover:not(:disabled) { background: var(--kirmizi-koyu); }
.secim-onay:disabled {
  background: var(--kenar-acik); color: var(--metin-soluk); cursor: not-allowed;
}
/* Ikincil (vazgec) dugmesi: onay kartinda kirmizinin yaninda notr durur */
.secim-onay.ikincil {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.secim-onay.ikincil:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}
.onay-dugmeler { display: flex; gap: var(--b-2); flex-wrap: wrap; }

/* -------- Aksiyon izi -------- */
/* "Onayla ve Uygula" gibi buton aksiyonlari sohbete KULLANICI BALONU
   basmaz; ince bir ayrac uzerinde sessiz bir iz birakir. Balon degildir:
   avatar, zemin ve kenar yok. */
.aksiyon-izi {
  display: flex; align-items: center; gap: var(--b-3);
  margin: 0 0 var(--b-4);
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
}
.aksiyon-izi::before,
.aksiyon-izi::after {
  content: ""; flex: 1 1 auto; height: 1px; min-width: var(--b-5);
  background: var(--kenar-acik);
}
.aksiyon-izi span {
  flex: 0 1 auto; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* -------- Çalışıyor göstergesi -------- */
/* Tek basina ziplayan nokta "dondu" hissi veriyordu: adim adi,
   gecen sure ve iptal dugmesi ayni balonda. */
.balon.calisiyor { min-width: 15rem; }
.calisma-ust { display: flex; align-items: center; gap: var(--b-2); }
.calisma-adim {
  font-weight: var(--fw-kalin); font-size: var(--fs-govde); color: var(--metin);
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.calisma-alt {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3); margin-top: var(--b-2);
}
.calisma-sure { font-size: var(--fs-govde); color: var(--metin-soluk); }
.calisma-iptal {
  height: var(--btn-h-kucuk); padding: 0 var(--b-3);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer;
}
.calisma-iptal:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}
.calisma-iptal:disabled { opacity: .45; cursor: not-allowed; }

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 5px; height: 5px; margin-right: 3px;
  border-radius: 50%; background: var(--metin-soluk); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-2px); }
}

/* -------- Aksiyon butonları ve yazı kutusu -------- */
#giris-bolge {
  padding: var(--b-3) var(--sohbet-yan) var(--b-5);
  padding-right: calc(var(--sohbet-yan) + 6px);   /* #sohbet scrollbar payi */
  flex-shrink: 0;
}
#aksiyonlar {
  width: var(--govde-en); margin: 0 0 var(--b-3) var(--girinti);
  display: flex; gap: var(--b-2);
}
#aksiyonlar.bos { display: none; }

.aksiyon {
  flex: 1; height: var(--btn-h); padding: 0 var(--b-4);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  border-radius: var(--r); cursor: pointer; white-space: nowrap;
  text-align: center;
  transition: background .15s, border-color .15s, color .15s;
}
.aksiyon:disabled { opacity: .45; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff; border: 1px solid var(--kirmizi);
}
.aksiyon.onayla:hover:not(:disabled) {
  background: var(--kirmizi-koyu); border-color: var(--kirmizi-koyu);
}

.aksiyon.degistir, .aksiyon.geri {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.aksiyon.degistir:hover:not(:disabled),
.aksiyon.geri:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}

#giris {
  width: var(--govde-en); margin: 0 0 0 var(--girinti);
  display: flex; gap: var(--b-2); align-items: center;
  background: var(--yuzey);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r);
  padding: 2px 2px 2px var(--b-4);
  box-shadow: var(--golge-1);
  transition: border-color .15s, box-shadow .15s;
}
#giris:focus-within { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }
#kutu {
  flex: 1; padding: 5px 0; border: none;
  background: transparent; color: var(--metin);
  font-size: var(--fs-govde); line-height: 1.5;
  resize: none; outline: none; max-height: 77px; overflow-y: auto;
}
#kutu::placeholder { color: var(--metin-soluk); }

#gonder {
  height: var(--btn-h-kucuk); padding: 0 var(--b-5);
  background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { opacity: .85; }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--ayrac);
  display: flex; flex-direction: column; overflow: hidden;
}

/* Sekmeler 3 sutunlu izgara: her genislikte duzenli 2 satir (3 + 3),
   esit genislikte ve ortali. Yeni sekme eklenirse ayni izgaraya oturur. */
#analiz-sekmeler {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--b-1);
  padding: var(--b-4) var(--b-5) var(--b-3);
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  flex-shrink: 0;
}
.analiz-sekme {
  min-width: 0; height: 24px; padding: 0 var(--b-2);
  text-align: center; overflow: hidden; text-overflow: ellipsis;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: .02em;
  border: 1px solid transparent; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin-soluk); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); color: var(--metin); }
/* Backend'e henüz baglanmamis sekmeler bir sure SOLUK gosteriliyordu
   (opacity: .7). Tek bagli sekme VALIDASYON oldugu icin o tek basina koyu
   kaliyor ve sekme seridi bozuk gorunuyordu. Bilgi zaten iki yerden
   veriliyor: sekmenin title'i ("Hazirlaniyor - ...") ve tiklaninca cikan
   "Hazirlaniyor" karti. Bu yuzden renk/opaklik farki kaldirildi; tum
   sekme etiketleri ayni tonda. .hazir-degil sinifi title'i tasiyan
   semantik isaret olarak duruyor. */
.analiz-sekme.aktif {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi-halka);
}

#analiz-govde { flex: 1; overflow-y: auto; padding: var(--b-4) var(--b-5) var(--b-6); }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: var(--r);
  padding: var(--b-4); margin-bottom: var(--b-3); box-shadow: var(--golge-1);
}
.iskele-baslik {
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); margin-bottom: var(--b-2); color: var(--metin);
}
/* "Hazırlanıyor" notu: sekmenin verisi henüz bağlı değil */
.iskele-kart.hazirlaniyor { border-style: dashed; background: var(--yuzey-alt); }
.iskele-satir {
  display: flex; justify-content: space-between; gap: var(--b-3);
  font-size: var(--fs-govde); padding: 5px 0; color: var(--metin-soluk);
}
.iskele-deger {
  font-size: var(--fs-govde);
  color: var(--metin); background: var(--kenar-acik);
  padding: 0 var(--b-2); border-radius: var(--r-kucuk);
}
.iskele-grafik {
  height: 69px; border-radius: var(--r-kucuk); margin-top: var(--b-1);
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 5px,
    var(--yuzey) 5px, var(--yuzey) 10px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin-soluk); font-size: var(--fs-govde);
}

/* -------- Durum çipi (validasyon ve ileride tüm durumlar) -------- */
.cip {
  display: inline-flex; align-items: center; gap: 4px;
  height: 18px; padding: 0 var(--b-2);
  border-radius: var(--r-kucuk);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin); letter-spacing: .05em;
  white-space: nowrap;
}
.cip::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor;
}
.cip.gecti    { background: var(--yesil-acik);  color: var(--yesil); }
.cip.kosullu  { background: var(--amber-acik);  color: var(--amber); }
.cip.kaldi    { background: var(--kirmizi-acik); color: var(--kirmizi); }
/* Hesaplanamadi: hesap denendi ama guvenilir sonuc cikmadi (NaN skor,
   yetersiz bin). "Veri yok"tan farkli oldugu icin amber. */
.cip.hesaplanamadi { background: var(--amber-acik); color: var(--amber); }
.cip.bekliyor,
.cip.veri_yok { background: var(--kenar-acik);  color: var(--metin-soluk); }

/* -------- Validasyon sekmesi -------- */
.val-sonuc {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
}
.val-model { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 2px; }
.val-ozet  { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-2); }

/* Sonuc kartinin sol cubugu genel sonucun rengini alir */
.iskele-kart.val-kart {
  position: relative; overflow: hidden;
  padding-left: calc(var(--b-4) + var(--serit));
}
.iskele-kart.val-kart::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kenar-guclu);
}
.iskele-kart.val-kart.gecti::before   { background: var(--yesil); }
.iskele-kart.val-kart.kosullu::before { background: var(--amber); }
.iskele-kart.val-kart.kaldi::before   { background: var(--kirmizi); }

.val-satir {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--b-3); padding: 8px 0;
  border-bottom: 1px solid var(--kenar-acik);
}
.val-satir:first-of-type { padding-top: 0; }
.val-satir:last-child { border-bottom: none; padding-bottom: 0; }
.val-sol { min-width: 0; }
.val-ad { font-weight: var(--fw-kalin); color: var(--metin); }
.val-esik { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 1px; }
.val-sag {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: var(--b-1);
}
.val-deger { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin); }
.val-not { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-1); }

/* -------- Backend'e bağlı panel sekmeleri (VERİ / EKSİK DEĞER / SFA) ----- */
/* Kartın hangi adımdan sonra dolacağını söyleyen not */
.panel-not {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
  margin: calc(-1 * var(--b-1)) 0 var(--b-2);
}
/* Uzun etiket taşmasın; tam metin title'da */
.panel-etiket { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.iskele-satir > .iskele-deger { flex-shrink: 0; max-width: 62%; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }

.panel-tablo {
  width: 100%; border-collapse: collapse; table-layout: fixed;
  font-size: var(--fs-kucuk); color: var(--metin);
}
.panel-tablo th {
  text-align: left; font-weight: var(--fw-kalin); color: var(--metin-soluk);
  letter-spacing: .04em; padding: 0 var(--b-2) 5px 0;
  border-bottom: 1px solid var(--kenar);
}
.panel-tablo th:last-child, .panel-tablo td:last-child { padding-right: 0; }
.panel-tablo td {
  padding: 5px var(--b-2) 5px 0;
  border-bottom: 1px solid var(--kenar-acik);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.panel-tablo tr:last-child td { border-bottom: none; }
/* İlk kolon değişken adıdır: yer verilir ama taşma kırpılır */
.panel-tablo th:first-child, .panel-tablo .panel-ad { width: 38%; }
.panel-tablo .panel-ad { font-weight: var(--fw-kalin); }

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1024px; margin: 0 auto; padding: 22px clamp(14px, 2.4vw, 35px) 45px; }
#ozet-baslik-blok { margin-bottom: var(--b-5); }
#ozet-h1 { margin: 0; }
#ozet-adim {
  font-size: var(--fs-govde); color: var(--metin-soluk);
  margin-top: 5px; text-align: center;
}

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
  gap: var(--b-4); align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: var(--r);
  padding: var(--b-4) var(--b-5); box-shadow: var(--golge-1);
}
.ozet-blok-baslik {
  margin-bottom: var(--b-3);
  padding-bottom: var(--b-2); border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 11px;
  padding: 5px 0; font-size: var(--fs-govde); align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--metin-soluk); flex-shrink: 0; }
.ozet-satir-deger {
  color: var(--metin);
  text-align: right; font-weight: var(--fw-kalin); word-break: break-word; min-width: 0;
}
/* ==================== KAYDIRMA ÇUBUKLARI ==================== */
#panel::-webkit-scrollbar,
#sohbet::-webkit-scrollbar,
#analiz-govde::-webkit-scrollbar,
#sayfa-ozet::-webkit-scrollbar,
#kutu::-webkit-scrollbar,
.combo-liste::-webkit-scrollbar { width: 6px; }

#panel::-webkit-scrollbar-thumb,
#sohbet::-webkit-scrollbar-thumb,
#analiz-govde::-webkit-scrollbar-thumb,
#sayfa-ozet::-webkit-scrollbar-thumb,
#kutu::-webkit-scrollbar-thumb,
.combo-liste::-webkit-scrollbar-thumb {
  background: var(--kenar-guclu); border-radius: 3px;
}
#panel::-webkit-scrollbar-thumb:hover,
#sohbet::-webkit-scrollbar-thumb:hover,
#analiz-govde::-webkit-scrollbar-thumb:hover,
#sayfa-ozet::-webkit-scrollbar-thumb:hover,
#kutu::-webkit-scrollbar-thumb:hover,
.combo-liste::-webkit-scrollbar-thumb:hover { background: var(--kirmizi); }

#panel::-webkit-scrollbar-track,
#sohbet::-webkit-scrollbar-track,
#analiz-govde::-webkit-scrollbar-track,
#sayfa-ozet::-webkit-scrollbar-track,
#kutu::-webkit-scrollbar-track,
.combo-liste::-webkit-scrollbar-track { background: transparent; }

#panel, #sohbet, #analiz-govde, #sayfa-ozet, #kutu, .combo-liste {
  scrollbar-width: thin;
  scrollbar-color: var(--kenar-guclu) transparent;
}

/* -------- Dar ekran (kirilma noktalari da 0,8 ile olceklendi) -------- */
/* Paneller GIZLENMIYOR: ust bardaki dugmelerle acilan cekmeceye donuyor. */
#cekmece-perde {
  position: fixed; inset: var(--ustbar-h) 0 0 0; z-index: 39;
  background: rgba(0,0,0,.35);
}

@media (max-width: 1024px) { #baslik-blok { display: none; } }

@media (max-width: 944px) {
  #analiz-btn { display: flex; }
  #analiz-panel {
    position: fixed; top: var(--ustbar-h); right: 0; bottom: 0; z-index: 40;
    width: min(var(--analiz-en), 92vw);
    transform: translateX(101%); transition: transform .2s ease;
    box-shadow: var(--golge-2);
  }
  #analiz-panel.acik { transform: none; }
}

@media (max-width: 864px) {
  #panel-btn { display: flex; }
  #ozet-serit { display: none; }
  #panel {
    position: fixed; top: var(--ustbar-h); left: 0; bottom: 0; z-index: 40;
    width: min(var(--panel-en), 86vw);
    transform: translateX(-101%); transition: transform .2s ease;
    box-shadow: var(--golge-2);
  }
  #panel.acik { transform: none; }
}

@media (min-width: 945px) {
  /* Genis ekranda cekmece yok: perde asla gorunmesin */
  #cekmece-perde { display: none; }
}
