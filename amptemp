def _bd_ek_diziler(M, mbb, donem, pos):
    """Bucket detayı için dönemin bütün satırlarında: limit, risk, takip / gecikme bayrakları, aynı dönemin FPD'si
    (bucket raporundaki gibi her satır kendi müşteri + dönem kaydıyla eşlenir) ve PredCs (dolu olan = eşleşen)."""
    def sayi(c):
        if c is None or c not in M.columns:
            return None
        return pd.to_numeric(M[c], errors="coerce").astype("float64").to_numpy()

    out = {"limit": sayi(_BD_LIMIT), "risk": sayi(_BD_RISK), "ek": {c: sayi(c) for c in _BD_EK if c in M.columns},
           "fpd": {}, "pc": _bd_pc_dizi(pos, mbb, donem) if donem in _BD_PC_DONEM else None}
    if _BD_FPD is not None:
        if donem in _BD_FPD_P:
