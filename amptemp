def _bd_modeller():
    """GOC_MODEL_RESULTS'taki model klasörleri (18'in OOT'si): {klasor, vade, aile, m, ad, renkler}. 18'in tanımadığı
    <Y>MTAKIP klasörleri de dahil."""
    haric = {h.upper() for h in HARIC_KLASORLER}
    out = []
    for kl in _alt_klasorler():
        m = _BD_KLASOR_RE.match(kl)
        if not m or kl.upper() in haric or int(m.group(5)) != int(_oot):
            continue
        v = int(m.group(1))
        if m.group(2):
            aile, ufuk = m.group(2), None
        else:
            aile = "SONRA_KIRMIZI_VE_TAKIP" if m.group(3) == "SONRA_KIRMIZI_VE" else "ICINDE_KIRMIZI_TAKIP"
            ufuk = int(m.group(4))
        ad = _MODEL_ADI.get(aile, aile) + (f" ({ufuk} Ay Takip)" if ufuk and ufuk != v else "")
        renkler = sorted({int(x.group(1)) for d in _dosyalar(kl) if (x := _BD_PKL_RE.match(d))})
        if renkler:
            out.append({"klasor": kl, "vade": v, "aile": aile, "ufuk": ufuk, "model": ad, "renkler": renkler,
                        "sira": (v, _BD_TEMEL.index(aile) if aile in _BD_TEMEL else 99, ufuk or 0)})
    return sorted(out, key=lambda x: x["sira"])


def _bd_kaynak(v, aile, ufuk):
    """Hedefin dayandığı ham kolonlar ve hedef penceresi (ay)."""
    tk = f"AKB_TAKIP_YY_{ufuk or v}M_FLG"
    if aile == "TAKIP":
        return [tk], ufuk or v
    if aile == "SONRA_KIRMIZI_VE_TAKIP":
        return [f"RENK_{v}M_SONRASI", tk], max(v, ufuk or v)
    if aile == "KIRMIZI_RENGE_GOC":
        return [f"RENK_{v}M_SONRASI", f"AKB_TAKIP_YY_{v}M_FLG"], v
    ic = ([f"{v}M_ICINDE_KIRMIZI"] if f"{v}M_ICINDE_KIRMIZI" in _BD_VERI.columns else
          ["RENK_SONRAKI_AY"] + [f"RENK_SONRAKI_{k}AY" for k in range(2, v + 1)])
    if aile == "ICINDE_KIRMIZI_RENGE_GOC":
        return ic + [f"AKB_TAKIP_YY_{v}M_FLG"], v
    return ic + [tk], max(v, ufuk or v)                       # ICINDE_KIRMIZI_TAKIP


def _bd_kirmizi(s):
    """'1-Kırmızı' (ya da 1) → True."""
    k = pd.to_numeric(pd.Series(s).astype(str).str.split("-").str[0].str.strip(), errors="coerce")
    return (k == 1).to_numpy()


def _bd_hedef(M, v, aile, ufuk):
    """M: dönemin satırları (hedef kaynak kolonlarıyla). → y (1 / 0 / NaN = kitlede yok)."""
    def takip(n):
        return pd.to_numeric(M[f"AKB_TAKIP_YY_{n}M_FLG"], errors="coerce").to_numpy() == 1

    def icinde():
        if f"{v}M_ICINDE_KIRMIZI" in M.columns:
            return pd.to_numeric(M[f"{v}M_ICINDE_KIRMIZI"], errors="coerce").to_numpy() == 1
        kol = ["RENK_SONRAKI_AY"] + [f"RENK_SONRAKI_{k}AY" for k in range(2, v + 1)]
        return np.column_stack([_bd_kirmizi(M[c]) for c in kol]).any(axis=1)

    if aile == "TAKIP":
        y = takip(ufuk or v)
    elif aile == "SONRA_KIRMIZI_VE_TAKIP":
        y = _bd_kirmizi(M[f"RENK_{v}M_SONRASI"]) | takip(ufuk or v)
    elif aile == "ICINDE_KIRMIZI_TAKIP":
        y = icinde() | takip(ufuk or v)
    else:
        y = _bd_kirmizi(M[f"RENK_{v}M_SONRASI"]) if aile == "KIRMIZI_RENGE_GOC" else icinde()
        kitle = pd.to_numeric(M[f"AKB_TAKIP_YY_{v}M_FLG"], errors="coerce").to_numpy() == 0
        return np.where(kitle, y.astype("float64"), np.nan)
    return y.astype("float64")


_BD_DOLU = {}


def _bd_durum(kaynak, ufuk_ay, donem):
    """(kısa durum, açıklama): Olgun / Olgunlaşmadı / Yok."""
    eksik = [c for c in kaynak if c not in _BD_VERI.columns]
    if eksik:
        return "Yok", f"Yok: ham veride {', '.join(eksik[:2])} kolonu yok"
    for c in kaynak:
        if (c, donem) not in _BD_DOLU:
            m = (_BD_DONEM_A == donem) & _BD_KK_A
            _BD_DOLU[(c, donem)] = float(_BD_VERI[c].iloc[np.flatnonzero(m)].notna().mean()) if m.any() else 0.0
    bos = [c for c in kaynak if _BD_DOLU[(c, donem)] == 0]
    if bos:
        return "Yok", f"Yok: {', '.join(bos[:2])} bu dönemde boş"
    kapanis = _bd_ay_ekle(donem, ufuk_ay)
    if kapanis > _BD_SON_AY:
        return "Olgunlaşmadı", f"Olgunlaşmadı: pencere {kapanis} sonunda kapanıyor"
    return "Olgun", "Olgun"


