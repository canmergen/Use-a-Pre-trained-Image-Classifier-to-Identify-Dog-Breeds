class ShapSecimHatasi(RuntimeError):
    """SHAPRFECV asamasinda guvenli secim yapilamadi."""


def _importance_yedek_secim(X, y, current_features):
    """SHAP calismazsa yedek: train-only LightGBM gain importance, ilk N.

    N = SHAP_MAX_FEATURES (None ise tum liste). Val/OOT kullanilmaz.
    Buyuk renklerde maliyet icin SHAP_MAX_ROWS'a kadar stratified orneklem.
    Gain'i 0 olan feature'lar (model hic kullanmamis) secilmez.
    """
    Xc, yc = X[current_features], y
    if SHAP_MAX_ROWS is not None and len(yc) > SHAP_MAX_ROWS:
        _i = train_test_split(Xc.index, train_size=SHAP_MAX_ROWS, stratify=yc,
                              random_state=RANDOM_STATE)[0]
        Xc, yc = Xc.loc[_i], yc.loc[_i]
    _pos = max(int(yc.sum()), 1)
    _neg = max(len(yc) - _pos, 1)
    _spw = min(SHAP_SPW_CAP, max(1/SHAP_SPW_CAP, (_neg / _pos) ** 0.5))
    m = lgb.LGBMClassifier(
        objective='binary', n_estimators=SHAP_N_ESTIMATORS,
        learning_rate=0.05, num_leaves=15, max_depth=5,
        min_child_samples=50, max_bin=63, reg_lambda=5,
        scale_pos_weight=_spw, colsample_bytree=0.7, subsample=0.8,
        subsample_freq=1, random_state=RANDOM_STATE,
        n_jobs=SHAP_MODEL_JOBS, verbose=-1,
    ).fit(Xc, yc)
    gain = pd.Series(m.booster_.feature_importance(importance_type='gain'),
                     index=m.booster_.feature_name())
    gain = gain[gain > 0].sort_values(ascending=False)
    n_sec = len(current_features) if SHAP_MAX_FEATURES is None else SHAP_MAX_FEATURES
    top = set(gain.index[:n_sec])
    secilen = [c for c in current_features if c in top]
    if not secilen:
        raise RuntimeError('Yedek importance secimi bos dondu (model hic split yapmadi).')
    return secilen, int(len(Xc))


def _capture_agirlikli(y, prob, pct, neg_agirlik):
    """Negatifleri neg_agirlik ile sayan Capture@pct.

    Ust %pct, AGIRLIKLI populasyon uzerinden kesilir: alt orneklenmis bir
    negatif, populasyondaki neg_agirlik kadar negatifi temsil eder.
    """
    yy = np.asarray(y, dtype=int)
    pp = np.asarray(prob, dtype='float64')
    npos = yy.sum()
    if npos == 0:
        return np.nan
    order = np.argsort(-pp, kind='mergesort')
    yy = yy[order]
    w = np.where(yy == 1, 1.0, float(neg_agirlik))
    # Sınırdaki gözlemin üst %pct içinde kalan payı (0-1) sayılır.
    limit = pct * w.sum()
    onceki = np.cumsum(w) - w
    oran = np.clip((limit - onceki) / w, 0.0, 1.0)
    return float(np.sum(yy * oran) / npos)


def _capture_scorer_uret(neg_agirlik):
    """Scorer callable (estimator, X, y).

    neg_agirlik == 1 ise Optuna ile BIREBIR ayni _capture_at helper'i kullanilir.
    """
    if abs(neg_agirlik - 1.0) < 1e-12:
        def _scorer(estimator, X, y):
            return float(_capture_at(y, estimator.predict_proba(X)[:, 1], CAPTURE_PCT))
    else:
        def _scorer(estimator, X, y):
            return _capture_agirlikli(y, estimator.predict_proba(X)[:, 1],
                                      CAPTURE_PCT, neg_agirlik)
    return _scorer


def _shap_train_sample(X, y):
    """SHAP orneklemi + negatif agirligi.

    Donus: (Xs, ys, neg_agirlik, yontem)
      neg_agirlik = 1.0  -> prevalans korunmus stratified orneklem
      neg_agirlik > 1.0  -> negatif alt orneklemi; scorer agirlikli hesaplar
    """
    yy = np.asarray(y, dtype=int)
    n = len(yy)
    npos = int(yy.sum())
    nneg = n - npos
    if npos < SHAP_MIN_POS_PER_FOLD * SHAP_CV:
        raise ShapSecimHatasi(
            f'train pozitif sayisi {npos:,} < {SHAP_MIN_POS_PER_FOLD}x{SHAP_CV}; '
            f'fold basina guvenilir Capture@10 icin pozitif yetersiz.')
    if nneg < SHAP_MIN_POS_PER_FOLD * SHAP_CV:
        raise ShapSecimHatasi(f'train negatif sayisi yetersiz: {nneg:,}.')

    if SHAP_BASE_ROWS is None:
        return X, y, 1.0, 'tum_train'

    hedef_pos = min(npos, SHAP_HEDEF_POS_PER_FOLD * SHAP_CV)
    gereken = int(np.ceil(hedef_pos / (npos / n)))
    boyut = max(SHAP_BASE_ROWS, gereken)

    _ust = SHAP_MAX_ROWS if SHAP_MAX_ROWS is not None else n
    # (a) Prevalans korunarak hedefe ulasilabiliyor.
    if boyut <= _ust or n <= _ust:
        boyut = min(boyut, n, _ust)
        if boyut >= n:
            return X, y, 1.0, 'tum_train'
        _i = train_test_split(X.index, train_size=boyut, stratify=y,
                              random_state=RANDOM_STATE)[0].sort_values()
        return X.loc[_i], y.loc[_i], 1.0, 'stratified'

    # (b) Nadir renk: tum pozitifler (ust sinirla) + alt orneklenmis negatifler.
    rng = np.random.RandomState(RANDOM_STATE)
    pos_idx = y.index[yy == 1]
    neg_idx = y.index[yy == 0]
    n_pos_s = min(npos, _ust // 4)
    n_neg_s = min(nneg, _ust - n_pos_s)
    pos_s = pos_idx if n_pos_s == npos else pos_idx[rng.choice(npos, n_pos_s, replace=False)]
    neg_s = neg_idx[rng.choice(nneg, n_neg_s, replace=False)]
    # Pozitifler de alt orneklendiyse oran duzeltmesi iki tarafa birlikte yapilir.
    neg_agirlik = (nneg / n_neg_s) / (npos / n_pos_s)
    idx = pos_s.append(neg_s).sort_values()
    return X.loc[idx], y.loc[idx], float(neg_agirlik), 'negatif_alt_orneklem'


def _shap_folds(Xs, ys, source_meta):
    """Bir musterinin satirlari ayni fold icinde kalir; fold pozitif kontrolu SERT."""
    cv = StratifiedKFold(n_splits=SHAP_CV, shuffle=True,
                         random_state=RANDOM_STATE)
    if 'MBB_NO' in source_meta.columns:
        groups = source_meta['MBB_NO'].reindex(Xs.index)
        if groups.isna().any():
            raise ShapSecimHatasi('SHAPRFECV icin MBB_NO eksik grup kimligi var.')
        groups = groups.astype(str)
        if groups.duplicated().any():
            cv = StratifiedGroupKFold(n_splits=SHAP_CV, shuffle=True,
                                      random_state=RANDOM_STATE)
            splits = list(cv.split(Xs, ys, groups))
        else:
            splits = list(cv.split(Xs, ys))
    else:
        splits = list(cv.split(Xs, ys))
    val_pos = []
    for k, (itr, ival) in enumerate(splits, 1):
        p_tr = int(np.asarray(ys.iloc[itr]).sum())
        p_va = int(np.asarray(ys.iloc[ival]).sum())
        if min(p_tr, p_va) < SHAP_MIN_POS_PER_FOLD:
            raise ShapSecimHatasi(
                f'fold {k}: pozitif train/val=({p_tr}, {p_va}) < '
                f'{SHAP_MIN_POS_PER_FOLD}.')
        val_pos.append(p_va)
    return splits, min(val_pos)


def _select_shap_features(X, y, current_features, etiket, basename, source_meta):
    """Train-only SHAPRFECV (yerel ShapRFECV), Capture@10 scorer.

    Donus: (secilen_features, report, bilgi). Guvenli secim yapilamazsa
    ShapSecimHatasi firlatir; fallback karari cagiran tarafta SHAP_HATA_MODU ile.
    """
    bilgi = {'shap_durum': None, 'shap_n_satir': None, 'shap_n_pozitif': None,
             'shap_min_val_pos': None, 'shap_neg_agirlik': None,
             'shap_orneklem': None, 'shap_tam_set_skor': None,
             'shap_secilen_skor': None, 'shap_tam_set_kaybi': None,
             'shap_secilen_std': None, 'shap_capture_tavan': None,
             'shap_tol_eff': None, 'shap_tol_1se': None, 'shap_tol_taban': None,
             'shap_cv_se': None,
             'shap_sample_weight': None,
             'shap_genel_en_iyi_skor': None, 'shap_genel_en_iyi_n': None,
             'shap_kayip_genel': None, 'shap_kayip_esik': None,
             'shap_performans_ok': None,
             'shap_gini_esitlik': None, 'shap_gini_tol': None,
             'shap_secilen_gini': None, 'shap_esit_capture_en_iyi_gini': None,
             'shap_esit_capture_aday': None, 'shap_secim_kurali': None}
    if not SHAP_AKTIF:
        print('  SHAPRFECV KAPALI (SHAP_AKTIF=False).')
        bilgi['shap_durum'] = 'kapali'
        return list(current_features), None, bilgi
    if len(current_features) <= SHAP_MIN_FEATURES:
        print(f'  SHAPRFECV atlandi: {len(current_features)} feature <= '
              f'SHAP_MIN_FEATURES={SHAP_MIN_FEATURES}.')
        bilgi['shap_durum'] = 'atlandi_min_feature'
        return list(current_features), None, bilgi

    Xs, ys, neg_w, yontem = _shap_train_sample(X[current_features], y)
    splits, min_val_pos = _shap_folds(Xs, ys, source_meta)
    bilgi.update({'shap_n_satir': int(len(Xs)), 'shap_n_pozitif': int(ys.sum()),
                  'shap_min_val_pos': int(min_val_pos),
                  'shap_neg_agirlik': round(neg_w, 4), 'shap_orneklem': yontem})

    # Sınıf ağırlığı (scale_pos_weight) orijinal train prevalansından; örneklem
    # düzeltmesi (sample_weight) ayrı tutulur.
    _yy_full = np.asarray(y, dtype=int)
    _pos = max(int(_yy_full.sum()), 1)
    _neg = max(len(_yy_full) - _pos, 1)
    _spw_shap = min(SHAP_SPW_CAP, max(1/SHAP_SPW_CAP, (_neg / _pos) ** 0.5))
    # Negatif alt orneklemi MODEL EGITIMINDE de duzeltilir. ShapRFECV
    # sample_weight'i her fold'da .iloc[train_index] ile keser ve yalnizca
    # fit'te kullanir; skor tarafini agirlikli scorer duzeltir.
    if abs(neg_w - 1.0) > 1e-12:
        _sw = pd.Series(np.where(ys.to_numpy() == 1, 1.0, neg_w), index=ys.index)
    else:
        _sw = None
    bilgi['shap_sample_weight'] = int(_sw is not None)
    shap_model = lgb.LGBMClassifier(
        objective='binary', n_estimators=SHAP_N_ESTIMATORS,
        learning_rate=0.05, num_leaves=15, max_depth=5,
        min_child_samples=50, max_bin=63, reg_lambda=5,
        scale_pos_weight=_spw_shap,
        random_state=RANDOM_STATE, n_jobs=SHAP_MODEL_JOBS, verbose=-1
    )
    scorer = Scorer('capture_at_10pct', custom_scorer=_capture_scorer_uret(neg_w))
    if abs(neg_w - 1.0) < 1e-12:
        def _skor_p(yy, pp):
            return float(_capture_at(yy, pp, CAPTURE_PCT))
    else:
        def _skor_p(yy, pp):
            return _capture_agirlikli(yy, pp, CAPTURE_PCT, neg_w)
    selector = ShapRFECV(
        model=shap_model, step=SHAP_STEP,
        min_features_to_select=min(SHAP_MIN_FEATURES, len(current_features)-1),
        cv=splits, scoring=scorer, n_jobs=1,
        step_ust=SHAP_STEP_UST,
        step_esik=max(SHAP_STEP_ESIK, SHAP_MAX_FEATURES or 0) if SHAP_STEP_UST else None,
        shap_max_rows=SHAP_DEGER_MAX_ROWS, skor_p=_skor_p,
        train_skoru=SHAP_TRAIN_SKOR, random_state=RANDOM_STATE,
    )
    print(f'  SHAPRFECV: {len(Xs):,} satir ({yontem}, neg_agirlik={neg_w:.2f}), '
          f'pozitif={int(ys.sum()):,}, min val pozitif/fold={min_val_pos} '
          f'(1 pozitif={1/min_val_pos:.4f} capture), {len(current_features)} aday, '
          f'CV={SHAP_CV}, skor=Capture@{CAPTURE_PCT:.0%}, SPW={_spw_shap:.2f}')
    report = selector.fit_compute(Xs, ys, sample_weight=_sw, check_additivity=False)
    _model_yaz(f'{basename}_shaprfecv_rapor.csv', report)

    report = report.copy()
    report['val_metric_mean'] = pd.to_numeric(report['val_metric_mean'], errors='coerce')
    _tam = report.loc[report['num_features'] == len(current_features), 'val_metric_mean']
    tam_skor = float(_tam.iloc[0]) if len(_tam) and np.isfinite(_tam.iloc[0]) else np.nan

    max_allowed = len(current_features) - (0 if SHAP_TAM_SET_ADAY else 1)
    if SHAP_MAX_FEATURES is not None:
        max_allowed = min(max_allowed, SHAP_MAX_FEATURES)
    min_allowed = min(SHAP_MIN_FEATURES, max_allowed)
    candidates = report.loc[
        report['num_features'].between(min_allowed, max_allowed)
        & np.isfinite(report['val_metric_mean'])
    ].copy()
    if candidates.empty:
        raise ShapSecimHatasi(f'{etiket}: SHAPRFECV raporunda aday set yok; '
                              'SHAP_STEP / SHAP_MAX_FEATURES kontrol edin.')
    best_score = float(candidates['val_metric_mean'].max())
    _base = float(np.mean(np.asarray(y, dtype=float)))
    _tavan = min(1.0, CAPTURE_PCT / _base) if _base > 0 else 1.0
    _tol_taban = SHAP_SCORE_TOL * (_tavan if SHAP_TOL_TAVANA_GORE else 1.0)
    max_kayip_eff = SHAP_MAX_KAYIP * (_tavan if SHAP_KAYIP_TAVANA_GORE else 1.0)
    # 1-SE: en iyi adayin fold std'sinden standart hata.
    _best_row = candidates.loc[candidates['val_metric_mean'].idxmax()]
    _std = (pd.to_numeric(_best_row.get('val_metric_std'), errors='coerce')
            if 'val_metric_std' in candidates.columns else np.nan)
    _se = float(_std) / np.sqrt(SHAP_CV) if np.isfinite(_std) else 0.0
    tol_1se = max(_tol_taban, SHAP_TOL_SE_KATSAYI * _se)
    # SECIMDE KAYIP SINIRI: Capture esitlik bandi performans esigini gecemez;
    # sinir alti en iyi adaydan en fazla max_kayip_eff kadar uzaklasilir.
    # (Genel en iyi aday sinirin ustundeyse shap_performans_ok kontrolu ayrica calisir.)
    tol_eff = min(tol_1se, max_kayip_eff)
    bilgi.update({'shap_capture_tavan': round(_tavan, 4), 'shap_tol_eff': round(tol_eff, 6),
                  'shap_tol_1se': round(tol_1se, 6),
                  'shap_tol_taban': round(_tol_taban, 6), 'shap_cv_se': round(_se, 6)})
    near_best = candidates.loc[candidates['val_metric_mean'] >= best_score - tol_eff]
    bilgi['shap_esit_capture_aday'] = int(len(near_best))
    _gini_var = ('val_gini_mean' in near_best.columns
                 and np.isfinite(pd.to_numeric(near_best['val_gini_mean'], errors='coerce')).any())
    if SHAP_GINI_ESITLIK and _gini_var and len(near_best) > 1:
        _g = pd.to_numeric(near_best['val_gini_mean'], errors='coerce')
        _g_best_idx = _g.idxmax()
        _g_best = float(_g.loc[_g_best_idx])
        if SHAP_EN_KUCUK_SET:
            _g_std = float(pd.to_numeric(near_best.loc[_g_best_idx, 'val_gini_std'], errors='coerce'))
            _g_se = _g_std / np.sqrt(SHAP_CV) if np.isfinite(_g_std) else 0.0
            _g_tol = min(max(SHAP_SET_GINI_TOL, SHAP_TOL_SE_KATSAYI * _g_se), SHAP_GINI_TOL_MAX)
            near_best = near_best.loc[_g >= _g_best - _g_tol]
            bilgi['shap_secim_kurali'] = 'capture_esit_gini_tol_en_kucuk_set'
            print(f'  SHAPRFECV: Capture esit {bilgi["shap_esit_capture_aday"]} set; '
                  f'Gini en iyi={_g_best:.4f}, tol={_g_tol:.4f} -> {len(near_best)} set kaldi; '
                  f'en kucugu secilir.')
        else:
            _g_tol = 0.0
            near_best = near_best.loc[_g == _g_best]
            bilgi['shap_secim_kurali'] = 'capture_esit_en_yuksek_gini'
            print(f'  SHAPRFECV: Capture esit {bilgi["shap_esit_capture_aday"]} set; '
                  f'Gini en yuksek={_g_best:.4f} -> {int(near_best["num_features"].min())} feature.')
        bilgi.update({'shap_gini_esitlik': 1, 'shap_gini_tol': round(_g_tol, 6),
                      'shap_esit_capture_en_iyi_gini': round(_g_best, 5)})
    else:
        bilgi['shap_gini_esitlik'] = 0
        bilgi['shap_secim_kurali'] = 'capture_esit_en_kucuk_set'
    winner = near_best.sort_values(['num_features', 'val_metric_mean'],
                                   ascending=[True, False]).iloc[0]
    if 'val_gini_mean' in winner.index and np.isfinite(winner['val_gini_mean']):
        bilgi['shap_secilen_gini'] = round(float(winner['val_gini_mean']), 5)
    n_win = int(winner['num_features'])
    sec_skor = float(winner['val_metric_mean'])
    kayip = (tam_skor - sec_skor) if np.isfinite(tam_skor) else np.nan
    # GENEL EN IYI: SHAP_MAX_FEATURES sinirindan bagimsiz, raporlanan TUM setlerin en iyisi
    # (tam set en iyi olmayabilir; ornegin 150 feature'lik set daha iyi olabilir).
    _gecerli = report.loc[np.isfinite(report['val_metric_mean'])]
    _gi = _gecerli.loc[_gecerli['val_metric_mean'].idxmax()]
    genel_skor, genel_n = float(_gi['val_metric_mean']), int(_gi['num_features'])
    kayip_genel = genel_skor - sec_skor
    # Tavan KALDIRILMAZ; kisiti karsilamayan model yalnizca ISARETLENIR.
    performans_ok = bool(kayip_genel <= max_kayip_eff)
    bilgi.update({
        'shap_genel_en_iyi_skor': round(genel_skor, 5),
        'shap_genel_en_iyi_n': genel_n,
        'shap_kayip_genel': round(kayip_genel, 5),
        'shap_kayip_esik': round(max_kayip_eff, 5),
        'shap_performans_ok': int(performans_ok),
    })
    if not performans_ok:
        print(f'  ✗ PERFORMANS KISITI KARSILANMADI: secilen {n_win} feature '
              f'({sec_skor:.4f}), en iyi set {genel_n} feature ({genel_skor:.4f}); '
              f'kayip {kayip_genel:.4f} > esik {max_kayip_eff:.4f}. '
              f'{SHAP_MAX_FEATURES} siniri korunuyor; model shap_performans_ok=0.')
    bilgi.update({
        'shap_tam_set_skor': round(tam_skor, 5) if np.isfinite(tam_skor) else None,
        'shap_secilen_skor': round(sec_skor, 5),
        'shap_tam_set_kaybi': round(kayip, 5) if np.isfinite(kayip) else None,
        'shap_secilen_std': (round(float(winner['val_metric_std']), 5)
                             if 'val_metric_std' in winner.index else None),
    })
    if np.isfinite(kayip) and kayip > max_kayip_eff:
        print(f'  ⚠ SHAPRFECV: secilen set tam sete gore {kayip:.4f} Capture@10 '
              f'kaybettiriyor (> esik {max_kayip_eff:.4f}, tavan {_tavan:.3f}). '
              f'SHAP_TAM_SET_ADAY={SHAP_TAM_SET_ADAY}; bilincli karar gerekli.')

    if n_win == len(current_features):
        # Yalnizca SHAP_TAM_SET_ADAY=True iken mumkun.
        print(f'  SHAPRFECV: tam set secildi (SHAP_TAM_SET_ADAY=True, '
              f'tol {tol_eff:.5f}); eleme yok.')
        selected = list(current_features)
        bilgi['shap_durum'] = 'tam_set_secildi'
    else:
        chosen = selector.get_reduced_features_set(num_features=n_win)
        chosen_set = set(chosen)
        selected = [c for c in current_features if c in chosen_set]
        if len(selected) != len(chosen) or not selected:
            raise ShapSecimHatasi(f'{etiket}: SHAPRFECV secilen kolon eslestirmesi hatali.')
        bilgi['shap_durum'] = 'secildi'
    _sg = bilgi.get('shap_secilen_gini')
    print(f'  SHAPRFECV: {len(current_features)} -> {len(selected)} '
          f'| CV Gini secilen={_sg if _sg is not None else float("nan"):.4f} '
          f'| CV Capture@{CAPTURE_PCT:.0%} secilen={sec_skor:.5f} '
          f'tam_set={tam_skor:.5f} kayip={kayip:+.5f} | tavan={_tavan:.3f} '
          f'tol={tol_eff:.5f}')
    _model_yaz(f'{basename}_shaprfecv_secilen.csv',
               pd.DataFrame({'feature': selected, 'sira': range(len(selected))}))
    return selected, report, bilgi


def _ayir_train_val(df_train_raw, metadata, target):
    """Once ayir; tekrarlanan musterileri train/val arasinda bolme."""
    if 'MBB_NO' in metadata.columns:
        groups = metadata['MBB_NO'].reindex(df_train_raw.index)
        if groups.isna().any():
            raise ValueError('MBB_NO var ama eksik. Guvenli group split icin tamamlanmali.')
        groups = groups.astype(str)
        if groups.duplicated().any():
            n_splits = int(round(1.0 / VAL_ORAN))
            cv = StratifiedGroupKFold(n_splits=n_splits, shuffle=True,
                                      random_state=RANDOM_STATE)
            trials = []
            for tr_pos, va_pos in cv.split(df_train_raw, df_train_raw[target], groups):
                tr_y = df_train_raw[target].iloc[tr_pos]
                va_y = df_train_raw[target].iloc[va_pos]
                if tr_y.nunique() == 2 and va_y.nunique() == 2:
                    diff = (abs(len(va_pos)/len(df_train_raw)-VAL_ORAN) +
                            abs(float(tr_y.mean())-float(va_y.mean())))
                    trials.append((diff, tr_pos, va_pos))
            if not trials:
                raise ValueError('StratifiedGroupKFold sonucunda iki sinifli val olusmadi.')
            _, tr_pos, va_pos = min(trials, key=lambda item: item[0])
            a, b = df_train_raw.iloc[tr_pos], df_train_raw.iloc[va_pos]
            if set(groups.iloc[tr_pos]) & set(groups.iloc[va_pos]):
                raise RuntimeError('Group split musteriyi iki tarafta buldu.')
            print('  Grup farkindalikli train/val ayrimi kullanildi.')
            return a.sort_index(), b.sort_index()
    a, b = train_test_split(df_train_raw, test_size=VAL_ORAN,
                            stratify=df_train_raw[target], shuffle=True,
                            random_state=RANDOM_STATE)
    return a.sort_index(), b.sort_index()


def _kat_metin(s):
    """Kategori degerlerini metne cevirir. Sayisal kaynakta 1 ve 1.0 ayni metin ('1') olur;
    kaynak tipi egitim ile skorlama arasinda int / float degisse de kategori eslesir."""
    if pd.api.types.is_numeric_dtype(s.dtype) and not pd.api.types.is_bool_dtype(s.dtype):
        v = pd.to_numeric(s, errors='coerce').astype('float64')
        out = v.astype('string')
        tam = v.notna() & np.isfinite(v) & (v == np.round(v)) & (v.abs() < 2 ** 53)
        out[tam] = v[tam].astype('int64').astype('string')
        return out
    return s.astype('string')


def _fit_train_fitted_native(train_raw, val_raw, oot_raw, features, target):
    """Yalnizca train'de fit edilen dogal LightGBM numerik/kategori donusumu.

    * Kategorilerin listesini train'den alir; val/oot bilinmeyenleri NaN.
    * Numerikleri sayisala cevirir, NaN'i doldurmaz; LightGBM native NaN.
    * Median, target encoding, quantile veya diger ogrenme YAPMAZ.
    """
    schema = {'mode': 'train_fitted_native', 'numerical': [], 'categorical': {}}
    columns = {}
    for c in features:
        series = train_raw[c]
        if c in CAT_COLS:
            kind = 'category'
        elif pd.api.types.is_numeric_dtype(series):
            kind = 'numeric'
        else:
            converted = pd.to_numeric(series, errors='coerce')
            nonempty = series.notna() & series.astype('string').str.strip().ne('')
            conversion_rate = float(converted[nonempty].notna().mean()) if nonempty.any() else 1.0
            kind = 'numeric' if conversion_rate >= 0.995 else 'category'
        columns[c] = kind
        if kind == 'category':
            values = _kat_metin(series).dropna().unique().tolist()
            schema['categorical'][c] = values
        else:
            schema['numerical'].append(c)

    def transform(frame):
        # Kolonlar sözlükte toplanıp DataFrame tek seferde kurulur (fragmented uyarısı yok).
        kolonlar = {}
        for c in features:
            if columns[c] == 'numeric':
                kolonlar[c] = pd.to_numeric(frame[c], errors='coerce')
            else:
                dtype = pd.CategoricalDtype(categories=schema['categorical'][c])
                kolonlar[c] = _kat_metin(frame[c]).astype(dtype)
        kolonlar[target] = pd.to_numeric(frame[target], errors='coerce')
        return pd.DataFrame(kolonlar, index=frame.index)

    return transform(train_raw), transform(val_raw), transform(oot_raw), schema


def _preprocess_split(train_raw, val_raw, oot_raw, features, target):
    if PREPROCESS_MODU == 'train_fitted_native':
        print('  Preprocess: train_fitted_native (bosluklar korunur, kategoriler train\'den); '
              'hucre 8 preprocess() kullanilmiyor.')
        return _fit_train_fitted_native(train_raw, val_raw, oot_raw, features, target)
    if PREPROCESS_MODU == 'harici_satir_bazli':
        if not PREPROCESS_HARICI_ROW_LOCAL_ONAY:
            raise RuntimeError('Harici preprocess ancak row-local oldugu teyit edilerek calistirilabilir.')
        a, b, c = (preprocess(frame.copy()) for frame in (train_raw, val_raw, oot_raw))
        return a, b, c, {'mode': 'harici_satir_bazli',
                         'warning': 'Harici preprocess bagimsiz row-local olarak onaylandi'}
    raise ValueError(f'Bilinmeyen PREPROCESS_MODU: {PREPROCESS_MODU}')


