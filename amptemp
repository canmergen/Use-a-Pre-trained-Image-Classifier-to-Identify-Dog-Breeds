    return paket, None


class _StUretim:
    """Bir renk x dönem x ham kolon seti için FE çıktısı; değişkenler paketin tanımıyla tek tek istenir."""

    def __init__(self, X, eng, eng_liste):
        self.X, self.eng, self.eng_liste = X, eng, eng_liste
        self._anahtar = None
        self._degisti = {}

    def _ham_veya_fe(self, c, raw, eng_set):
        if c in raw:
            if c in self.eng.columns:
                if c not in self._degisti:
                    self._degisti[c] = not self.eng[c].equals(self.X[c])
                if self._degisti[c]:
                    return self.eng[c]                        # FE ham kolonu dönüştürdüyse dönüşmüş hali
            return self.X[c]
        if c in eng_set and c in self.eng.columns:
            return self.eng[c]
        return None

    def kolon(self, c, paket):
        """Değişkenin modelin gördüğü hali (sayısal ya da paketteki kategorilerle kategorik)."""
        raw, eng_set = set(paket["required_raw_features"]), set(paket["engineered_features"])
        desen = paket.get("desen_kodlama") or {}
        ds = desen.get("kolonlar", {})
        if c in ds:
            if self._anahtar is None:
                if "COLOR_MAP" not in globals():
                    raise RuntimeError("Desen değişkenleri (DSN_*) için COLOR_MAP bellekte olmalı.")
                cer = pd.DataFrame({k: s for k in _ST_DESEN_KOL if (s := self._ham_veya_fe(k, raw, eng_set)) is not None},
                                   index=self.X.index)
                self._anahtar = _st_desen_anahtarlari(cer)
            ad, tur = ds[c]
            dolgu = desen["haritalar"][ad]["nadir_oran"] if tur == "oran" else 0.0
            return pd.Series(self._anahtar[ad].map(desen["haritalar"][ad][tur]).fillna(dolgu).to_numpy(dtype="float64"),
                             index=self.X.index)
        s = self._ham_veya_fe(c, raw, eng_set)
        if s is None:
            raise KeyError(f"Değişken üretilemedi: {c}")
        schema = paket["preprocess_schema"]
        if c in schema.get("categorical", {}):
            return _st_kat_metin(s).astype(pd.CategoricalDtype(categories=schema["categorical"][c]))
        return pd.to_numeric(s, errors="coerce")

    def girdi_ve_skor(self, paket):
        if paket["preprocess_schema"].get("mode") != "train_fitted_native":
            raise NotImplementedError("Yalnızca train_fitted_native ön işlemeli paketler skorlanabilir.")
        feats = list(paket["features"])
        F = pd.DataFrame({c: self.kolon(c, paket) for c in feats}, index=self.X.index)[feats]
        return F, np.asarray(paket["model"].predict_proba(F)[:, 1], dtype="float64")


def _st_havuz(paket):
    """Eğitimdeki eleme öncesi havuz: ham + FE + DSN (pipeline'daki FEATURES sırası)."""
    raw = list(paket["required_raw_features"])
    fe = [c for c in paket["engineered_features"] if c not in set(raw)]
    ds = list((paket.get("desen_kodlama") or {}).get("kolonlar", {}))
    return raw + fe + [c for c in ds if c not in set(raw + fe)]


def _st_sinirlar(dolu, n):
    """Referansın n'lik yüzdelik sınırları. Referansın en büyük değerine eşit (ya da üstünde) sınır atılır: ör. ödeme
    oranında %100'de yığılma varsa üst yüzdelikler 100'e denk gelir ve (100, ∞) dilimi referansta boş kalır. Boş dilim
    PSI'da 1e-4 sayıldığı için referansın biraz üstüne çıkan birkaç müşteri (ör. %100,5) PSI'ı tek başına
    'Belirgin kayma'ya taşırdı. Sınır atılınca bu müşteriler en üst dilime girer; aralık dışına çıkış Max kolonunda görünür."""
    if not len(dolu):
        return np.array([])
    s = np.unique(np.quantile(dolu, np.linspace(0, 1, n + 1)[1:-1]))
    return s[s < dolu.max()]


def _st_ozet(v):
    """Boşlar hariç dağılım özeti (v yalnızca dolu değerler): min, P5, medyan, ortalama, P95, max."""
    if not len(v):
        return {}
    p5, med, p95 = np.quantile(v, [0.05, 0.5, 0.95])
    return {"min": float(v.min()), "p5": float(p5), "med": float(med), "ort": float(v.mean()), "p95": float(p95),
            "max": float(v.max())}


def _st_kolon_ist(s, kategorik, ref=None):
    """Bir değişkenin bir dönemdeki dağılımı: dilim payları, PSI (CSI), HHI, boş oranı ve (sayısalda) dağılım özeti.
    ref None ise dilimler buradan kurulur."""
    if kategorik:
        v = s.astype("object")
        bos = v.isna().to_numpy()
        say = pd.Series(v[~bos]).value_counts()
        kat = ref["kat"] if ref else list(say.index)
        pay = [float(say.get(k, 0)) for k in kat] + [float(say[~say.index.isin(kat)].sum()), float(bos.sum())]
        d = {"kat": kat}
    else:
        v = pd.to_numeric(s, errors="coerce").to_numpy(dtype="float64", na_value=np.nan)
        ok = np.isfinite(v)
        dolu = v[ok]
        sinir = ref["sinir"] if ref else _st_sinirlar(dolu, _ST_DILIM)
        idx = np.searchsorted(sinir, dolu, side="left")
        pay = list(np.bincount(idx, minlength=len(sinir) + 1).astype("float64")) + [float((~ok).sum())]
        d = {"sinir": sinir, "ozet": _st_ozet(dolu)}
    pay = np.asarray(pay, dtype="float64") / max(len(s), 1)
    d.update({"pay": pay, "bos": float(pay[-1]), "hhi": float(np.sum(pay ** 2)),
              "csi": _st_csi(ref["pay"], pay) if ref else np.nan})
    return d


def _st_skor_ist(skor, ref=None):
    """Skorun 20'li gruplardaki payı (referansın sınırlarıyla; B1 = en riskli), PSI ve HHI."""
    s = np.asarray(skor, dtype="float64")
    ok = np.isfinite(s)
    sinir = ref["sinir"] if ref else _st_sinirlar(s[ok], _ST_GRUP)
    say = np.bincount(np.searchsorted(sinir, s[ok], side="left"), minlength=len(sinir) + 1).astype("float64")[::-1]
    pay = say / max(say.sum(), 1.0)
    return {"sinir": sinir, "pay": pay, "hhi": float(np.sum(pay ** 2)), "psi": _st_csi(ref["pay"], pay) if ref else np.nan}


