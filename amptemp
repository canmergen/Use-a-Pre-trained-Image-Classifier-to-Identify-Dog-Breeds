# RENK_Y_* (62 feature): renk geçmişini bir yol olarak okur. Kaynak: RENK_LM..RENK_L12M.
# INAKTIF (0) ay renk sayılmaz. Geçiş = bir aydan sonraki aya renk değişimi (12 ayda 11 geçiş).
# Kötüleşme = kod küçülür, iyileşme = kod büyür. Risk rengi = KIRMIZI (1) veya TURUNCU (2).
# AY_* = olayın kaç ay geride olduğu (0 = LM, 1 = L2M ...); geçişte yeni ay. Olay yoksa NaN.
# Hiç aktif ayı olmayan müşteride INAKTIF feature'ları dışında hepsi NaN.
# Örnek yol (LM'den geriye): 2, 1, 1, 3, 4, 4, 5, 5, 5, 5, 5, 5
#
#   RENK_Y_GECERLI_AY
#     Nasıl : 12 ayda aktif renk kodu (1-6) olan ay sayısı.
#     Anlamı: Renk geçmişinin ne kadarı ölçülebilir; az ise diğer RENK_Y değerleri az aya
#             dayanır.
#     Örnek : 12 ayın hepsi aktif → 12.
#
#   RENK_Y_INAKTIF_AY_12M
#     Nasıl : 12 ayda kodu 0 (INAKTIF) olan ay sayısı.
#     Anlamı: Müşterinin ne kadar süre inaktif kaldığı.
#     Örnek : Hiç inaktif ay yok → 0.
#
#   RENK_Y_AY_SON_INAKTIF
#     Nasıl : En son inaktif olduğu ay (0 = LM).
#     Anlamı: İnaktiflik ne kadar yakın.
#     Örnek : Hiç inaktif değil → NaN.
#
#   RENK_Y_INAKTIFTEN_DONUS_FLG
#     Nasıl : LM aktif ve L2M..L12M arasında en az bir inaktif ay varsa 1.
#     Anlamı: İnaktiflikten yeni dönmüş müşteri.
#     Örnek : Önceki 11 ayda inaktif ay yok → 0 (ör. L5M inaktif olsaydı 1).
#
#   RENK_Y_EN_KOTU_12M
#     Nasıl : 12 ayın en küçük renk kodu.
#     Anlamı: 12 ayda düştüğü en kötü renk.
#     Örnek : KIRMIZI → 1.
#
#   RENK_Y_EN_IYI_12M
#     Nasıl : 12 ayın en büyük renk kodu.
#     Anlamı: 12 ayda çıktığı en iyi renk.
#     Örnek : YESIL → 5.
#
#   RENK_Y_ZIRVEDEN_DUSUS
#     Nasıl : EN_IYI_12M - LM.
#     Anlamı: Müşteri 12 aydaki en iyi halinden kaç basamak aşağıda; 0 = şu an zirvede.
#     Örnek : 5 - 2 = 3.
#
#   RENK_Y_DIPTEN_UZAKLIK
#     Nasıl : LM - EN_KOTU_12M.
#     Anlamı: Dipten ne kadar toparlanmış; 0 = şu an 12 ayın dibinde.
#     Örnek : 2 - 1 = 1.
#
#   RENK_Y_NET_KOTULESME_12M
#     Nasıl : En eski aktif ayın rengi - LM.
#     Anlamı: 12 ayda net kaç basamak düştü; pozitif = kötüleşti, negatif = iyileşti.
#     Örnek : L12M YESIL (5) - LM TURUNCU (2) = 3.
#
#   RENK_Y_NET_KOTULESME_3AY
#     Nasıl : L3M - LM (L3M boş / inaktifse NaN).
#     Anlamı: Son 3 aylık pencerede net değişim; pozitif = kötüleşme.
#     Örnek : 1 - 2 = -1 (net 1 basamak iyileşme).
#
#   RENK_Y_NET_KOTULESME_6AY
#     Nasıl : L6M - LM (L6M boş / inaktifse NaN).
#     Anlamı: Son 6 aylık pencerede net değişim.
#     Örnek : 4 - 2 = 2.
#
#   RENK_Y_AY_SON_KIRMIZI
#     Nasıl : Rengin KIRMIZI olduğu en yeni ay.
#     Anlamı: Kırmızılık ne kadar yakın; küçük = yakın.
#     Örnek : L2M kırmızı → 1.
#
#   RENK_Y_AY_SON_RISK
#     Nasıl : Rengin risk (KIRMIZI / TURUNCU) olduğu en yeni ay.
#     Anlamı: Risk ne kadar yakın.
#     Örnek : LM TURUNCU → 0.
#
#   RENK_Y_AY_SON_KOTULESME
#     Nasıl : En yeni kötüleşme geçişinin ayı.
#     Anlamı: Son düşüş ne kadar önce.
#     Örnek : L4M 3 → L3M 1 → 2.
#
#   RENK_Y_AY_SON_IYILESME
#     Nasıl : En yeni iyileşme geçişinin ayı.
#     Anlamı: Son toparlanma ne kadar önce.
#     Örnek : L2M 1 → LM 2 → 0.
#
#   RENK_Y_KIRMIZI_GORDU_12M
#     Nasıl : 12 ayda en az bir kırmızı ay varsa 1.
#     Anlamı: Son bir yılda kırmızıya düştü mü.
#     Örnek : L2M, L3M kırmızı → 1.
#
#   RENK_Y_MEVCUT_RENKTE_SURE
#     Nasıl : LM'deki renkte LM dahil kesintisiz kaç ay.
#     Anlamı: Bugünkü renkte ne kadar zamandır.
#     Örnek : LM TURUNCU, L2M KIRMIZI → 1.
#
#   RENK_Y_RISK_SERI_SIMDI
#     Nasıl : LM'den geriye kesintisiz risk renginde geçen ay sayısı.
#     Anlamı: Müşteri kaç aydır riskte; 0 = şu an riskte değil.
#     Örnek : LM T, L2M K, L3M K, L4M SARI → 3.
#
#   RENK_Y_RISK_EN_UZUN_SERI
#     Nasıl : 12 aydaki en uzun kesintisiz risk serisi.
#     Anlamı: En uzun risk dönemi.
#     Örnek : Tek risk dönemi L3M..LM, 3 ay → 3.
#
#   RENK_Y_TEK_RISK_DONEMI_FLG
#     Nasıl : LM riskte ve 12 aydaki tüm risk ayları LM'den geriye uzanan bu tek seride ise 1.
#     Anlamı: Müşteri bu yıl ilk kez riske girmiş (önceden başka risk dönemi yok).
#     Örnek : 3 risk ayının hepsi seride → 1.
#
#   RENK_Y_KOTULESME_SERI_SIMDI
#     Nasıl : LM'den geriye kesintisiz kötüleşen geçiş sayısı.
#     Anlamı: Kaç aydır her ay düşüyor.
#     Örnek : Son geçiş (L2M → LM) iyileşme → 0.
#
#   RENK_Y_IYILESME_SERI_SIMDI
#     Nasıl : LM'den geriye kesintisiz iyileşen geçiş sayısı.
#     Anlamı: Kaç aydır her ay iyileşiyor.
#     Örnek : L2M → LM iyileşme, L3M → L2M aynı → 1.
#
#   RENK_Y_SON_IYILESMEDEN_BERI_DUSUS
#     Nasıl : LM'den geriye ilk iyileşme geçişine kadar (aynı kalan aylar dahil) düşülen basamak
#             toplamı.
#     Anlamı: En son toparlanmadan bu yana ne kadar düştü.
#     Örnek : Son geçiş zaten iyileşme → 0. (Yol 5, 4, 3 diye bitseydi 2 olurdu.)
#
#   RENK_Y_SON_KOTULESMEDEN_BERI_YUKSELIS
#     Nasıl : LM'den geriye ilk kötüleşme geçişine kadar çıkılan basamak toplamı.
#     Anlamı: En son düşüşten bu yana ne kadar toparlandı.
#     Örnek : L2M → LM +1, L3M → L2M 0, L4M → L3M kötüleşme (dur) → 1.
#
#   RENK_Y_KOTULESME_ADET_6M, RENK_Y_KOTULESME_ADET_12M
#     Nasıl : Kötüleşen geçiş sayısı; 6M = son 6 aydaki 5 geçiş, 12M = 11 geçiş.
#     Anlamı: Düşüş sıklığı.
#     Örnek : 6M: L5M → L4M (4 → 3), L4M → L3M (3 → 1) → 2; 12M: + L7M → L6M (5 → 4) → 3.
#
#   RENK_Y_IYILESME_ADET_6M, RENK_Y_IYILESME_ADET_12M
#     Nasıl : İyileşen geçiş sayısı (6M = 5 geçiş, 12M = 11).
#     Anlamı: Toparlanma sıklığı.
#     Örnek : L2M → LM → 1 / 1.
#
#   RENK_Y_KOTULESME_BASAMAK_6M, RENK_Y_KOTULESME_BASAMAK_12M
#     Nasıl : Kötüleşen geçişlerde düşülen basamak toplamı.
#     Anlamı: Düşüşün toplam derinliği (3 → 1 düşüşü 2 basamak sayılır).
#     Örnek : 6M: 1 + 2 = 3; 12M: 3 + 1 = 4.
#
#   RENK_Y_IYILESME_BASAMAK_6M, RENK_Y_IYILESME_BASAMAK_12M
#     Nasıl : İyileşen geçişlerde çıkılan basamak toplamı.
#     Anlamı: Toparlanmanın toplam büyüklüğü.
#     Örnek : 1 / 1.
#
#   RENK_Y_MAX_TEK_DUSUS_12M
#     Nasıl : Tek bir geçişteki en büyük düşüş (basamak).
#     Anlamı: En sert tek aylık düşüş.
#     Örnek : L4M SARI (3) → L3M KIRMIZI (1) = 2.
#
#   RENK_Y_DEGISIM_ADET_12M
#     Nasıl : Rengin değiştiği geçiş sayısı (yön fark etmez).
#     Anlamı: Rengin ne kadar hareketli olduğu.
#     Örnek : 3 kötüleşme + 1 iyileşme = 4.
#
#   RENK_Y_YON_DEGISIM_12M
#     Nasıl : Değişimlerin yönü kaç kez tersine döndü (aynı kalan aylar atlanır).
#     Anlamı: İnip çıkan (zikzak) yol mu, tek yönlü mü.
#     Örnek : Eskiden yeniye: düşüş, düşüş, düşüş, iyileşme → 1.
#
#   RENK_Y_KIRMIZIYA_GIRIS_12M
#     Nasıl : Kırmızı olmayan bir aydan kırmızıya geçiş sayısı.
#     Anlamı: Kaç kez kırmızıya düştü.
#     Örnek : L4M SARI → L3M KIRMIZI → 1.
#
#   RENK_Y_RISKE_GIRIS_12M
#     Nasıl : Risk dışından (kod 3 ve üstü) riske (kod 1-2) geçiş sayısı.
#     Anlamı: Kaç kez riske girdi.
#     Örnek : L4M → L3M → 1.
#
#   RENK_Y_RISKTEN_CIKIS_12M
#     Nasıl : Riskten risk dışına geçiş sayısı.
#     Anlamı: Kaç kez riskten çıktı.
#     Örnek : LM TURUNCU hâlâ risk → 0.
#
#   RENK_Y_RISKE_YENIDEN_GIRIS_12M
#     Nasıl : En eski riskten çıkıştan sonra gerçekleşen riske giriş sayısı.
#     Anlamı: Riskten çıkıp yeniden düşme (nüks).
#     Örnek : Hiç çıkış yok → 0.
#
#   RENK_Y_KIRMIZI_SERI_SIMDI
#     Nasıl : LM'den geriye kesintisiz kırmızı ay sayısı.
#     Anlamı: Kaç aydır kırmızı.
#     Örnek : LM TURUNCU → 0.
#
#   RENK_Y_AY_SON_KIRMIZIYA_GIRIS
#     Nasıl : En yeni kırmızıya giriş geçişinin ayı.
#     Anlamı: Son kırmızıya düşüş ne kadar önce.
#     Örnek : L4M → L3M → 2.
#
#   RENK_Y_AY_ILK_KIRMIZIYA_GIRIS
#     Nasıl : 12 aydaki en eski kırmızıya giriş geçişinin ayı.
#     Anlamı: Kırmızı sorunu ne zamandan beri var.
#     Örnek : Tek giriş → 2.
#
#   RENK_Y_AY_SON_KIRMIZIDAN_CIKIS
#     Nasıl : En yeni kırmızıdan çıkış geçişinin ayı.
#     Anlamı: Kırmızıdan ne kadar önce çıktı.
#     Örnek : L2M KIRMIZI → LM TURUNCU → 0.
#
#   RENK_Y_SON_KIRMIZI_DONEM_SURE
#     Nasıl : En yeni kırmızı dönem kaç ay sürdü (kırmızı yoksa 0).
#     Anlamı: Son kırmızılığın uzunluğu.
#     Örnek : L3M ve L2M → 2.
#
#   RENK_Y_AY_SON_RISKE_GIRIS
#     Nasıl : En yeni riske giriş geçişinin ayı.
#     Anlamı: Son riske düşüş ne kadar önce.
#     Örnek : L4M → L3M → 2.
#
#   RENK_Y_AY_SON_RISKTEN_CIKIS
#     Nasıl : En yeni riskten çıkış geçişinin ayı.
#     Anlamı: Riskten ne kadar önce çıktı.
#     Örnek : Hiç çıkış yok → NaN.
#
#   RENK_Y_SON_RISK_DONEM_SURE
#     Nasıl : En yeni risk dönemi kaç ay sürdü (risk yoksa 0).
#     Anlamı: Son risk döneminin uzunluğu.
#     Örnek : LM, L2M, L3M → 3.
#
#   RENK_Y_KIRMIZI_SONRASI_EN_IYI
#     Nasıl : En yeni kırmızı aydan sonraki (daha yeni) aylardaki en iyi renk; son kırmızı LM
#             ise NaN.
#     Anlamı: Kırmızıdan sonra nereye kadar toparlandı.
#     Örnek : Son kırmızı L2M, sonrası yalnızca LM (2) → 2.
#
#   RENK_Y_KIRMIZI_SONRASI_GERI_DUSUS
#     Nasıl : KIRMIZI_SONRASI_EN_IYI - LM.
#     Anlamı: Kırmızıdan sonra toparlanıp yeniden düştü mü; 0 = toparlanmayı koruyor.
#     Örnek : 2 - 2 = 0.
#
#   RENK_Y_RISK_SONRASI_EN_IYI, RENK_Y_RISK_SONRASI_GERI_DUSUS
#     Nasıl : Aynı iki hesap, kırmızı yerine risk rengi için.
#     Anlamı: Riskten sonra ne kadar toparlandı ve geri düştü mü.
#     Örnek : Son risk ayı LM, sonrası yok → NaN / NaN.
#
#   RENK_Y_SON_HAREKET
#     Nasıl : En yeni renk değişiminin yönü: +1 kötüleşme, -1 iyileşme, hiç değişim yoksa 0.
#     Anlamı: Son hareket düşüş mü toparlanma mı.
#     Örnek : L2M → LM iyileşme → -1.
#
#   RENK_Y_ONCEKI_HAREKET
#     Nasıl : Ondan bir önceki renk değişiminin yönü (aynı kodlama).
#     Anlamı: Son hareketten önceki eğilim.
#     Örnek : L4M → L3M kötüleşme → +1.
#
#   RENK_Y_AY_SON_HAREKET
#     Nasıl : En yeni renk değişiminin ayı; değişim yoksa NaN.
#     Anlamı: Renk en son ne zaman değişti.
#     Örnek : Son değişim L2M → LM → 0.
#
#   RENK_Y_SON_HAREKET_BASAMAK
#     Nasıl : En yeni renk değişiminin büyüklüğü (basamak).
#     Anlamı: Son hareketin sertliği.
#     Örnek : 1 → 2 = 1.
#
#   RENK_Y_NUKS_FLG
#     Nasıl : SON_HAREKET = +1 ve ONCEKI_HAREKET = -1 ise 1; aktif ay 3'ten azsa NaN.
#     Anlamı: Toparlanıp yeniden kötüleşti (nüks).
#     Örnek : Son hareket iyileşme → 0 (yol 1, 2 diye bir yükselip sonra yine 1'e düşseydi 1).
#
#   RENK_Y_TOPARLANMA_FLG
#     Nasıl : SON_HAREKET = -1 ve ONCEKI_HAREKET = +1 ise 1; aktif ay 3'ten azsa NaN.
#     Anlamı: Kötüleşmeden sonra toparlanma başladı.
#     Örnek : Son hareket -1 (L2M → LM iyileşme), önceki +1 (L4M → L3M düşüş) → 1.
#
#   RENK_Y_ART_ARDA_KOTULESME_FLG, RENK_Y_ART_ARDA_IYILESME_FLG
#     Nasıl : Son iki değişim ikisi de +1 / ikisi de -1 ise 1; aktif ay 3'ten azsa NaN.
#     Anlamı: Üst üste iki düşüş / üst üste iki toparlanma.
#     Örnek : Son iki hareket -1 ve +1, aynı yönde değil → 0 / 0.
#
#   RENK_Y_KOTULESME_HIZLANMA
#     Nasıl : (L4M..L6M ortalaması - son 3 ay ortalaması) - (L7M..L12M ortalaması - L4M..L6M
#             ortalaması).
#     Anlamı: Son dönemdeki düşüş önceki dönemdeki düşüşten büyük mü; pozitif = düşüş
#             hızlanıyor.
#     Örnek : (3.67 - 1.33) - (5 - 3.67) = 2.33 - 1.33 = 1.0.
#
#   RENK_Y_EGIM_6M, RENK_Y_EGIM_12M
#     Nasıl : Son 6 / 12 ayın renk kodlarına en küçük kareler doğrusu çizilir; eğimi (basamak /
#             ay). En az 3 aktif ay gerekir.
#     Anlamı: Negatif = zamanla düşüş; -0.5 = ayda yarım basamak düşüş.
#     Örnek : Eskiden yeniye L6M..LM: 4, 4, 3, 1, 1, 2 → -0.60; 12 ay → -0.39.
# ------------------------------------------------------------------------------
def _renk_yol_features(df):
    """Musterinin renk gecmisini bir yol olarak ozetler."""
    M = _seri_matrisi(df, 'RENK')
    if M is None:
        return {}

    inaktif_kod, aktif, kirmizi = _renk_kodlari()
    inaktif = (M == inaktif_kod) if inaktif_kod is not None else np.zeros(M.shape, bool)
    M[~np.isin(M, aktif)] = np.nan

    idx = df.index
    T = M.shape[1]
    ar = np.arange(len(df))
    ok = np.isfinite(M)
    gecerli = ok.sum(axis=1)
    R0 = M[:, 0]

    d, pair = _hareketler(M)
    kot = pair & (d < 0)
    iyi = pair & (d > 0)
    ayni = pair & (d == 0)
    dus = np.where(kot, -d, 0.0)
    yuk = np.where(iyi, d, 0.0)
    risk = ok & (M <= _fe_ayarlar()['RENK_RISK_ESIK'])
    kir = ok & (M == kirmizi)
    t_gecis = np.arange(T - 1)[None, :]
    t_durum = np.arange(T)[None, :]

    out = {}
    out['RENK_Y_GECERLI_AY'] = gecerli

    out['RENK_Y_INAKTIF_AY_12M'] = inaktif.sum(axis=1)
    out['RENK_Y_AY_SON_INAKTIF'] = _ilk_true(inaktif)
    out['RENK_Y_INAKTIFTEN_DONUS_FLG'] = np.isfinite(R0) & inaktif[:, 1:].any(axis=1)

    en_kotu = np.where(ok, M, np.inf).min(axis=1)
    en_iyi = np.where(ok, M, -np.inf).max(axis=1)
    en_kotu[gecerli == 0] = np.nan
    en_iyi[gecerli == 0] = np.nan
    out['RENK_Y_EN_KOTU_12M'] = en_kotu
    out['RENK_Y_EN_IYI_12M'] = en_iyi
    out['RENK_Y_ZIRVEDEN_DUSUS'] = en_iyi - R0
    out['RENK_Y_DIPTEN_UZAKLIK'] = R0 - en_kotu
    i_eski = _son_true(ok)
    eski_deger = np.where(np.isfinite(i_eski), M[ar, np.nan_to_num(i_eski).astype(int)], np.nan)
    out['RENK_Y_NET_KOTULESME_12M'] = eski_deger - R0
    out['RENK_Y_NET_KOTULESME_3AY'] = M[:, 2] - R0
    out['RENK_Y_NET_KOTULESME_6AY'] = M[:, 5] - R0

    out['RENK_Y_AY_SON_KIRMIZI'] = _ilk_true(kir)
    out['RENK_Y_AY_SON_RISK'] = _ilk_true(risk)
    out['RENK_Y_AY_SON_KOTULESME'] = _ilk_true(kot)
    out['RENK_Y_AY_SON_IYILESME'] = _ilk_true(iyi)
    out['RENK_Y_KIRMIZI_GORDU_12M'] = kir.any(axis=1)

    sure = 1 + _seri_simdi(ayni)
    out['RENK_Y_MEVCUT_RENKTE_SURE'] = np.where(np.isfinite(R0), sure, np.nan)
    risk_seri = _seri_simdi(risk)
    out['RENK_Y_RISK_SERI_SIMDI'] = risk_seri
    out['RENK_Y_RISK_EN_UZUN_SERI'] = _en_uzun_seri(risk)
    out['RENK_Y_TEK_RISK_DONEMI_FLG'] = risk[:, 0] & (risk.sum(axis=1) == risk_seri)
    out['RENK_Y_KOTULESME_SERI_SIMDI'] = _seri_simdi(kot)
    out['RENK_Y_IYILESME_SERI_SIMDI'] = _seri_simdi(iyi)
    L_kot = _seri_simdi(pair & (d <= 0))
    out['RENK_Y_SON_IYILESMEDEN_BERI_DUSUS'] = np.where(t_gecis < L_kot[:, None], dus, 0.0).sum(axis=1)
    L_iyi = _seri_simdi(pair & (d >= 0))
    out['RENK_Y_SON_KOTULESMEDEN_BERI_YUKSELIS'] = np.where(t_gecis < L_iyi[:, None], yuk, 0.0).sum(axis=1)

    for W, tag in ((6, '6M'), (T, '12M')):
        tw = W - 1
        out[f'RENK_Y_KOTULESME_ADET_{tag}'] = kot[:, :tw].sum(axis=1)
        out[f'RENK_Y_IYILESME_ADET_{tag}'] = iyi[:, :tw].sum(axis=1)
        out[f'RENK_Y_KOTULESME_BASAMAK_{tag}'] = dus[:, :tw].sum(axis=1)
        out[f'RENK_Y_IYILESME_BASAMAK_{tag}'] = yuk[:, :tw].sum(axis=1)
    out['RENK_Y_MAX_TEK_DUSUS_12M'] = dus.max(axis=1)
    out['RENK_Y_DEGISIM_ADET_12M'] = (pair & (d != 0)).sum(axis=1)
    out['RENK_Y_YON_DEGISIM_12M'] = _yon_degisim(d, pair)

    yeni_s, eski_s = M[:, :-1], M[:, 1:]
    riske_giris = pair & (yeni_s <= _fe_ayarlar()['RENK_RISK_ESIK']) & (eski_s > _fe_ayarlar()['RENK_RISK_ESIK'])
    riskten_cikis = pair & (yeni_s > _fe_ayarlar()['RENK_RISK_ESIK']) & (eski_s <= _fe_ayarlar()['RENK_RISK_ESIK'])
    out['RENK_Y_KIRMIZIYA_GIRIS_12M'] = (pair & (yeni_s == kirmizi) & (eski_s > kirmizi)).sum(axis=1)
    out['RENK_Y_RISKE_GIRIS_12M'] = riske_giris.sum(axis=1)
    out['RENK_Y_RISKTEN_CIKIS_12M'] = riskten_cikis.sum(axis=1)
    en_eski_cikis = np.nan_to_num(_son_true(riskten_cikis), nan=-1.0)
    out['RENK_Y_RISKE_YENIDEN_GIRIS_12M'] = (riske_giris & (t_gecis < en_eski_cikis[:, None])).sum(axis=1)

    # Gecis zamanlari ve donem sureleri (0 = LM ayi; gecis yoksa NaN).
    kir_giris = pair & (yeni_s == kirmizi) & (eski_s > kirmizi)
    kir_cikis = pair & (yeni_s > kirmizi) & (eski_s == kirmizi)
    out['RENK_Y_KIRMIZI_SERI_SIMDI'] = _seri_simdi(kir)
    out['RENK_Y_AY_SON_KIRMIZIYA_GIRIS'] = _ilk_true(kir_giris)
    out['RENK_Y_AY_ILK_KIRMIZIYA_GIRIS'] = _son_true(kir_giris)
    out['RENK_Y_AY_SON_KIRMIZIDAN_CIKIS'] = _ilk_true(kir_cikis)
    out['RENK_Y_SON_KIRMIZI_DONEM_SURE'] = _son_donem_sure(kir)
    out['RENK_Y_AY_SON_RISKE_GIRIS'] = _ilk_true(riske_giris)
    out['RENK_Y_AY_SON_RISKTEN_CIKIS'] = _ilk_true(riskten_cikis)
    out['RENK_Y_SON_RISK_DONEM_SURE'] = _son_donem_sure(risk)

    for ad, mask in (('KIRMIZI', kir), ('RISK', risk)):
        i_son = np.nan_to_num(_ilk_true(mask), nan=-1.0)
        sonra = (t_durum < i_son[:, None]) & ok
        en_iyi_sonra = np.where(sonra, M, -np.inf).max(axis=1)
        en_iyi_sonra[~sonra.any(axis=1)] = np.nan
        out[f'RENK_Y_{ad}_SONRASI_EN_IYI'] = en_iyi_sonra
        out[f'RENK_Y_{ad}_SONRASI_GERI_DUSUS'] = en_iyi_sonra - R0

    s1, s2, i1, m1 = _son_iki_hareket(-d, pair)
    out['RENK_Y_SON_HAREKET'] = s1
    out['RENK_Y_ONCEKI_HAREKET'] = s2
    out['RENK_Y_AY_SON_HAREKET'] = i1
    out['RENK_Y_SON_HAREKET_BASAMAK'] = np.where(np.isfinite(i1), m1, np.nan)
    yeterli = gecerli >= 3
    out['RENK_Y_NUKS_FLG'] = np.where(yeterli, (s1 == 1) & (s2 == -1), np.nan)
    out['RENK_Y_TOPARLANMA_FLG'] = np.where(yeterli, (s1 == -1) & (s2 == 1), np.nan)
    out['RENK_Y_ART_ARDA_KOTULESME_FLG'] = np.where(yeterli, (s1 == 1) & (s2 == 1), np.nan)
    out['RENK_Y_ART_ARDA_IYILESME_FLG'] = np.where(yeterli, (s1 == -1) & (s2 == -1), np.nan)

    o13, o46, o712 = _ort(M, 0, 3), _ort(M, 3, 6), _ort(M, 6, T)
    out['RENK_Y_KOTULESME_HIZLANMA'] = (o46 - o13) - (o712 - o46)
    out['RENK_Y_EGIM_6M'] = _egim(M, 6)
    out['RENK_Y_EGIM_12M'] = _egim(M, T)

    bos = gecerli == 0
    res = _float_ciktilar({k: v for k, v in out.items() if 'INAKTIF' not in k}, idx, bos_satir=bos)
    res.update(_float_ciktilar({k: v for k, v in out.items() if 'INAKTIF' in k}, idx))
    return res


def _seri_dinamik(M, P):
    """Yonden bagimsiz dinamik feature'lar (artis ve azalis ayri ayri)."""
    ok = np.isfinite(M)
    n_ok = ok.sum(axis=1)
    T = M.shape[1]
    d, pair = _hareketler(M)
    art = pair & (d > 0)
    az = pair & (d < 0)
    out = {}
    out[f'{P}_D_GECERLI_AY'] = n_ok
    out[f'{P}_D_EGIM_3M'] = _egim(M, 3)
    out[f'{P}_D_EGIM_6M'] = _egim(M, 6)
    out[f'{P}_D_EGIM_12M'] = _egim(M, T)
    o13, o46, o79 = _ort(M, 0, 3), _ort(M, 3, 6), _ort(M, 6, 9)
    out[f'{P}_D_IVME'] = (o13 - o46) - (o46 - o79)
    out[f'{P}_D_ARTIS_SERI'] = _seri_simdi(art)
    out[f'{P}_D_AZALIS_SERI'] = _seri_simdi(az)
    out[f'{P}_D_ARTIS_ADET_12M'] = art.sum(axis=1)
    out[f'{P}_D_AZALIS_ADET_12M'] = az.sum(axis=1)
    out[f'{P}_D_MAX_AYLIK_ARTIS'] = np.where(art, d, 0.0).max(axis=1)
    out[f'{P}_D_MAX_AYLIK_AZALIS'] = np.where(az, -d, 0.0).max(axis=1)
    out[f'{P}_D_YON_DEGISIM_12M'] = _yon_degisim(d, pair)

    G = M[:, 1:]
    okg = ok[:, 1:]
    ng = okg.sum(axis=1)
    mg = np.where(okg, G, 0.0).sum(axis=1) / np.maximum(ng, 1)
    dev = np.where(okg, G - mg[:, None], 0.0)
    sg = np.sqrt((dev * dev).sum(axis=1) / np.maximum(ng - 1, 1))
    z_ok = (ng >= 3) & (sg > 0) & np.isfinite(M[:, 0])
    out[f'{P}_D_ZSKOR_LM'] = np.where(z_ok, (M[:, 0] - mg) / np.where(sg > 0, sg, 1.0), np.nan)

    mx = np.where(ok, M, -np.inf).max(axis=1)
    mn = np.where(ok, M, np.inf).min(axis=1)
    mx[n_ok == 0] = np.nan
    mn[n_ok == 0] = np.nan
    out[f'{P}_D_ZIRVEDEN_FARK'] = mx - M[:, 0]
    out[f'{P}_D_DIPTEN_FARK'] = M[:, 0] - mn
    out[f'{P}_D_AY_SON_ZIRVE'] = _ilk_true(ok & (M == mx[:, None]))
    out[f'{P}_D_AY_SON_DIP'] = _ilk_true(ok & (M == mn[:, None]))
    return out, (n_ok == 0)


def _kk_kullanim_matrisi(df):
    """KK_RISK_{m} / KK_LIMIT_{m}; limit <= 0 ise NaN. Lag'ler yoksa None."""
    if not any(f'KK_LIMIT_{m}' in df.columns and f'KK_RISK_{m}' in df.columns
               for m in _fe_ayarlar()['AYLAR_12']):
        return None
    M = np.full((len(df), len(_fe_ayarlar()['AYLAR_12'])), np.nan)
    for j, m in enumerate(_fe_ayarlar()['AYLAR_12']):
        lim, rsk = f'KK_LIMIT_{m}', f'KK_RISK_{m}'
        if lim in df.columns and rsk in df.columns:
            M[:, j] = _oran_nan(_sayi(df, rsk), _sayi(df, lim))
    return M


# ------------------------------------------------------------------------------
# <seri>_D_* (85 = 5 seri x 17): bir serinin hareketi. Seriler: DAV (DAV_SKOR), MMS, KKB
# (KKB_SKOR, 0 = boş), ODM (KK_ODEME_ORANI), KKU (kart kullanımı = KK_RISK / KK_LIMIT).
# Her feature 5 seri için aynı adla üretilir (KKB_D_EGIM_3M, DAV_D_EGIM_3M ...). Yön yok: artış
# ve azalış ayrı feature; hangisinin kötü olduğu seriye göre okunur (KKB, DAV, ODM'de düşüş
# kötü; MMS ve KKU'da artış kötü). Hiç dolu ayı olmayan seride hepsi NaN.
# Örnekler KKB serisi: 1150, 1180, 1250, 1300, 1350, 1380, 1400, 1400, 1410, 1400, 1420, 1410.
#
#   KKB_D_GECERLI_AY  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : 12 ayda dolu ay sayısı.
#     Anlamı: Diğer değerlerin kaç aya dayandığı.
#     Örnek : 12 ayın hepsi dolu → 12.
#
#   KKB_D_EGIM_3M, KKB_D_EGIM_6M, KKB_D_EGIM_12M  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : Son 3 / 6 / 12 ayın değerlerine en küçük kareler doğrusu; eğimi (birim / ay). En
#             az 3 dolu ay.
#     Anlamı: Pozitif = zamanla artış, negatif = azalış.
#     Örnek : L3M, L2M, LM = 1250, 1180, 1150 → ayda -50 puan; 6 ay -48.9; 12 ay -23.7.
#
#   KKB_D_IVME  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : (son 3 ay ort. - L4M..L6M ort.) - (L4M..L6M ort. - L7M..L9M ort.).
#     Anlamı: Değişim hızlanıyor mu; KKB'de negatif = düşüş hızlanıyor.
#     Örnek : (1193.3 - 1343.3) - (1343.3 - 1403.3) = -150 - (-60) = -90.
#
#   KKB_D_ARTIS_SERI, KKB_D_AZALIS_SERI  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : LM'den geriye kesintisiz artan / azalan geçiş sayısı.
#     Anlamı: Kaç aydır her ay artıyor / azalıyor.
#     Örnek : L7M'den LM'ye her ay düştü (1400 → 1380 → 1350 → 1300 → 1250 → 1180 → 1150) → 0 /
#             6.
#
#   KKB_D_ARTIS_ADET_12M, KKB_D_AZALIS_ADET_12M  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : 11 geçişte artan / azalan geçiş sayısı.
#     Anlamı: Bir yılda kaç kez arttı / azaldı.
#     Örnek : L12M → L11M ve L10M → L9M artış (+10) → 2; azalış → 8.
#
#   KKB_D_MAX_AYLIK_ARTIS, KKB_D_MAX_AYLIK_AZALIS  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : Tek bir geçişteki en büyük artış / azalış (yoksa 0).
#     Anlamı: En sert aylık hareket.
#     Örnek : En büyük artış 10; en büyük azalış L3M → L2M: 1250 → 1180 = 70.
#
#   KKB_D_YON_DEGISIM_12M  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : Artış ile azalış arasında yön kaç kez tersine döndü (sabit aylar atlanır).
#     Anlamı: Seri zikzak mı tek yönlü mü.
#     Örnek : Eskiden yeniye: artış, azalış, artış, azalış, sonra hep azalış → 3.
#
#   KKB_D_ZSKOR_LM  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : (LM - L2M..L12M ortalaması) / L2M..L12M standart sapması; en az 3 geçmiş ay ve std
#             > 0.
#     Anlamı: LM müşterinin kendi geçmişine göre ne kadar sıra dışı; -2 altı = alışılmadık
#             düşük.
#     Örnek : (1150 - 1354.5) / 78.5 = -2.60.
#
#   KKB_D_ZIRVEDEN_FARK  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : 12 aydaki en yüksek değer - LM.
#     Anlamı: Zirvenin ne kadar altında.
#     Örnek : 1420 - 1150 = 270.
#
#   KKB_D_DIPTEN_FARK  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : LM - 12 aydaki en düşük değer.
#     Anlamı: Dibin ne kadar üstünde; 0 = şu an dipte.
#     Örnek : 1150 - 1150 = 0.
#
#   KKB_D_AY_SON_ZIRVE  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : En yüksek değerin görüldüğü en yeni ay.
#     Anlamı: Zirve ne kadar önceydi.
#     Örnek : 1420, L11M → 10.
#
#   KKB_D_AY_SON_DIP  (aynısı DAV_D_, MMS_D_, ODM_D_, KKU_D_ ile)
#     Nasıl : En düşük değerin görüldüğü en yeni ay.
#     Anlamı: Dip ne kadar önceydi; 0 = dip bu ay.
#     Örnek : 1150, LM → 0.
# ------------------------------------------------------------------------------
def _seri_dinamik_features(df):
    res = {}
    for base, (P, sifir_gecersiz) in _fe_ayarlar()['SERI_TANIM'].items():
        M = _seri_matrisi(df, base, sifir_gecersiz=sifir_gecersiz)
        if M is None:
            continue
        out, bos = _seri_dinamik(M, P)
        res.update(_float_ciktilar(out, df.index, bos_satir=bos))
    M = _kk_kullanim_matrisi(df)
    if M is not None:
        out, bos = _seri_dinamik(M, 'KKU')
        res.update(_float_ciktilar(out, df.index, bos_satir=bos))
    return res


def _yonlu_seriler(df):
    """Yonu bilinen seriler: base -> (matris [LM..L12M], yon). INAKTIF renk NaN."""
    seriler = {}
    for base, yon in _fe_ayarlar()['SERI_YON'].items():
        if yon is None:
            continue
        if base == 'RENK':
            M = _seri_matrisi(df, 'RENK')
            if M is not None:
                M[~np.isin(M, _renk_kodlari()[1])] = np.nan
        elif base == 'KK_KULLANIM':
            M = _kk_kullanim_matrisi(df)
        else:
            sifir = _fe_ayarlar()['SERI_TANIM'].get(base, (None, False))[1]
            M = _seri_matrisi(df, base, sifir_gecersiz=sifir)
        if M is not None:
            seriler[base] = (M, yon)
    return seriler


# ------------------------------------------------------------------------------
# ESZ_* (15 feature): aynı dönemde kaç gösterge birlikte bozuldu. Göstergeler (6): renk, KKB,
# ödeme oranı, kart kullanımı, DAV, MMS. Kötü yön: renk / KKB / ödeme / DAV düşüşü, kullanım /
# MMS artışı. 3M: LM ile L3M, 6M: LM ile L6M karşılaştırılır.
# Örnek LM / L3M / L6M: renk 2 / 1 / 4; KKB 1150 / 1250 / 1380; ödeme 25 / 10 / 50;
# kullanım 0.95 / 0.94 / 0.50; DAV 400 / 450 / 530; MMS 8 / 7 / 4.
#
#   ESZ_KOTULESEN_SINYAL_3M, ESZ_KOTULESEN_SINYAL_6M
#     Nasıl : Her gösterge için LM, pencere başıyla (L3M / L6M) karşılaştırılır; kötü yöne
#             gidenler sayılır. Hiç gösterge ölçülemezse NaN.
#     Anlamı: Aynı anda kaç cephede bozulma var (0-6).
#     Örnek : 3M: KKB, kullanım, DAV, MMS kötü; renk (1 → 2) ve ödeme (10 → 25) iyi → 4. 6M:
#             altısı da kötü → 6.
#
#   ESZ_OLCULEN_SINYAL_3M, ESZ_OLCULEN_SINYAL_6M
#     Nasıl : İki ayı da dolu olan gösterge sayısı.
#     Anlamı: Sayımın kaç göstergeye dayandığı.
#     Örnek : Altı göstergenin hepsinde iki ay da dolu → 6 / 6.
#
#   ESZ_KOTULESEN_ORAN_3M, ESZ_KOTULESEN_ORAN_6M
#     Nasıl : KOTULESEN_SINYAL / OLCULEN_SINYAL.
#     Anlamı: Ölçülen göstergelerin ne kadarı bozuldu (0-1).
#     Örnek : 4 / 6 = 0.67; 6 / 6 = 1.0.
#
#   ESZ_DIPTE_SINYAL_12M
#     Nasıl : LM değeri 12 ayın en kötü değerinde olan gösterge sayısı (en az 3 dolu ay ve seri
#             sabit değilse).
#     Anlamı: Kaç gösterge şu an 12 ayın dibinde.
#     Örnek : KKB 1150 (en düşük), DAV 400 (en düşük), MMS 8 (en yüksek) dipte; renk (dip 1),
#             ödeme (dip 10), kullanım (en kötü 0.975) değil → 3.
#
#   ESZ_DIPTE_ORAN_12M
#     Nasıl : ESZ_DIPTE_SINYAL_12M / ölçülebilen gösterge sayısı.
#     Anlamı: Göstergelerin ne kadarı dipte (0-1).
#     Örnek : 3 / 6 = 0.5.
#
#   ESZ_RENK_ODEME_KOTU_3M, ESZ_RENK_KKB_KOTU_3M, ESZ_ODEME_KKB_KOTU_3M, ESZ_RENK_KKU_KOTU_3M,
#   ESZ_RENK_DAV_KOTU_3M, ESZ_RENK_MMS_KOTU_3M, ESZ_DAV_MMS_KOTU_3M
#     Nasıl : Adındaki iki gösterge de LM ile L3M arasında kötüleştiyse 1, değilse 0; biri
#             ölçülemezse NaN.
#     Anlamı: İki sinyalin aynı anda bozulması (ör. renk ve ödeme birlikte).
#     Örnek : DAV ve MMS ikisi de kötü → ESZ_DAV_MMS_KOTU_3M = 1; ödeme iyileştiği için
#             ODEME_KKB 0; renk iyileştiği için renkli çiftlerin hepsi 0.
# ------------------------------------------------------------------------------
def _eszamanli_features(df):
    """Ayni donemde kac gosterge birlikte bozuldu?"""
    seriler = _yonlu_seriler(df)
    if not seriler:
        return {}

    out = {}
    kotu = {}
    for tag, j in (('3M', 2), ('6M', 5)):
        sayi = np.zeros(len(df))
        olculen = np.zeros(len(df))
        for base, (M, yon) in seriler.items():
            olc = np.isfinite(M[:, 0]) & np.isfinite(M[:, j])
            k = olc & (yon * (M[:, 0] - M[:, j]) < 0)
            sayi += k
            olculen += olc
            kotu[(base, tag)] = np.where(olc, k, np.nan)
        out[f'ESZ_KOTULESEN_SINYAL_{tag}'] = np.where(olculen > 0, sayi, np.nan)
        out[f'ESZ_OLCULEN_SINYAL_{tag}'] = olculen
        out[f'ESZ_KOTULESEN_ORAN_{tag}'] = np.where(olculen > 0, sayi / np.maximum(olculen, 1), np.nan)

    dipte = np.zeros(len(df))
    dip_olc = np.zeros(len(df))
    for base, (M, yon) in seriler.items():
        ok = np.isfinite(M)
        n = ok.sum(axis=1)
        Y = yon * M
        en_kotu = np.where(ok, Y, np.inf).min(axis=1)
        en_iyi = np.where(ok, Y, -np.inf).max(axis=1)
        olc = (n >= 3) & np.isfinite(M[:, 0]) & (en_iyi > en_kotu)
        dipte += olc & (Y[:, 0] <= en_kotu)
        dip_olc += olc
    out['ESZ_DIPTE_SINYAL_12M'] = np.where(dip_olc > 0, dipte, np.nan)
    out['ESZ_DIPTE_ORAN_12M'] = np.where(dip_olc > 0, dipte / np.maximum(dip_olc, 1), np.nan)

    ciftler = [('RENK', 'KK_ODEME_ORANI', 'RENK_ODEME'),
               ('RENK', 'KKB_SKOR', 'RENK_KKB'),
               ('KK_ODEME_ORANI', 'KKB_SKOR', 'ODEME_KKB'),
               ('RENK', 'KK_KULLANIM', 'RENK_KKU'),
               ('RENK', 'DAV_SKOR', 'RENK_DAV'),
               ('RENK', 'MMS', 'RENK_MMS'),
               ('DAV_SKOR', 'MMS', 'DAV_MMS')]
    for a, b, ad in ciftler:
        if (a, '3M') in kotu and (b, '3M') in kotu:
            ka, kb = kotu[(a, '3M')], kotu[(b, '3M')]
            out[f'ESZ_{ad}_KOTU_3M'] = np.where(np.isnan(ka) | np.isnan(kb), np.nan, ka * kb)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# GIZLI_* (6 feature): renk henüz kötüleşmemişken diğer 5 göstergenin bozulması. Renk LM'de
# pencere başındakinden (L3M / L6M) kötü değilse sayılır; renk kötüleşmişse değerler 0. Renk
# ölçülemezse NaN. Örnek renk: L3M 1 → LM 2 (kötüleşmedi); L6M 4 → LM 2 (kötüleşti).
#
#   GIZLI_KOTULESEN_SINYAL_3M, GIZLI_KOTULESEN_SINYAL_6M
#     Nasıl : Renk kötüleşmediyse diğer 5 göstergeden kötüleşenlerin sayısı; kötüleştiyse 0.
#     Anlamı: Renk "iyi görünürken" alttan gelen bozulma; renk düşüşünden önceki uyarı.
#     Örnek : 3M: KKB, kullanım, DAV, MMS kötüleşti → 4. 6M: renk kötüleşti → 0.
#
#   GIZLI_KOTULESME_FLG_3M, GIZLI_KOTULESME_FLG_6M
#     Nasıl : Renk kötüleşmemiş ve en az 1 gösterge kötüleşmişse 1.
#     Anlamı: Gizli bozulma var mı.
#     Örnek : 3M: renk bozulmadı, 4 gösterge bozuldu → 1; 6M: renk bozuldu → 0.
#
#   GIZLI_KOTULESME_GORELI_3M, GIZLI_KOTULESME_GORELI_6M
#     Nasıl : Kötüleşen göstergelerin göreli değişimlerinin toplamı: |LM - pencere başı| /
#             |pencere başı|.
#     Anlamı: Gizli bozulmanın büyüklüğü; sayıdan farkı ne kadar sert olduğunu da göstermesi.
#     Örnek : 3M: KKB 100/1250 = 0.080, kullanım 0.0125/0.9375 = 0.013, DAV 50/450 = 0.111, MMS
#             1/7 = 0.143 → 0.347. 6M: 0.
# ------------------------------------------------------------------------------
def _gizli_kotulesme_features(df):
    """Renk HENUZ kotulesmemisken diger gostergeler bozuluyor mu?"""
    seriler = _yonlu_seriler(df)
    if 'RENK' not in seriler or len(seriler) < 2:
        return {}
    R, _ = seriler['RENK']
    out = {}
    for tag, j in (('3M', 2), ('6M', 5)):
        renk_olc = np.isfinite(R[:, 0]) & np.isfinite(R[:, j])
        renk_kotulesmedi = renk_olc & (R[:, 0] >= R[:, j])
        sayi = np.zeros(len(df))
        olculen = np.zeros(len(df))
        buyukluk = np.zeros(len(df))
        for base, (M, yon) in seriler.items():
            if base == 'RENK':
                continue
            olc = np.isfinite(M[:, 0]) & np.isfinite(M[:, j])
            fark = yon * (M[:, 0] - M[:, j])
            k = olc & (fark < 0)
            sayi += k
            olculen += olc
            olcek = np.abs(M[:, j])
            goreli = np.where(olc & (olcek > 0), -fark / np.where(olcek > 0, olcek, 1.0), 0.0)
            buyukluk += np.where(k, goreli, 0.0)
        gecerli = renk_olc & (olculen > 0)
        out[f'GIZLI_KOTULESEN_SINYAL_{tag}'] = np.where(gecerli, np.where(renk_kotulesmedi, sayi, 0.0), np.nan)
        out[f'GIZLI_KOTULESME_FLG_{tag}'] = np.where(gecerli, renk_kotulesmedi & (sayi >= 1), np.nan)
        out[f'GIZLI_KOTULESME_GORELI_{tag}'] = np.where(gecerli, np.where(renk_kotulesmedi, buyukluk, 0.0), np.nan)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# INT_*_INTD_* (veride kaç INT ailesi varsa): INT_ ile başlayıp _LM / _L3M / _L6M / _L9M / _L12M
# ile biten kolonlar bir aile sayılır (ör. INT_SDM_BSVR_ADT_LM, _L3M, _L6M, _L12M). Ailede hangi
# pencereler varsa o oranlar üretilir. Pencere değerinin tanımı (toplam, adet vb.) ham veriden gelir.
# Örnek aile INT_SDM_BSVR_ADT: LM 0, L3M 2, L6M 5, L12M 9.
#
#   INT_SDM_BSVR_ADT_INTD_LM_L3M, INT_SDM_BSVR_ADT_INTD_L3M_L6M, INT_SDM_BSVR_ADT_INTD_L3M_L12M,
#   INT_SDM_BSVR_ADT_INTD_L6M_L12M
#     Nasıl : Yakın pencere / uzak pencere: LM / L3M, L3M / L6M, L3M / L12M, L6M / L12M; payda
#             <= 0 veya boşsa NaN.
#     Anlamı: Pencereler kümülatifse: 1'e yakın = hareketin çoğu yakın dönemde; 0'a yakın =
#             yakın dönemde hareket yok.
#     Örnek : 0 / 2 = 0; 2 / 5 = 0.40; 2 / 9 = 0.22; 5 / 9 = 0.56.
#
#   INT_SDM_BSVR_ADT_INTD_DURDU_FLG
#     Nasıl : En yakın pencere 0 ve daha uzak pencerelerden en az biri > 0 ise 1; ölçülemezse
#             NaN.
#     Anlamı: Önceden olan aktivite son dönemde durdu.
#     Örnek : LM 0, L3M 2 → 1.
# ------------------------------------------------------------------------------
def _int_degisim_features(df):
    """INT_* aileleri aylik degil, pencere bazli (LM, L3M, L6M, L9M, L12M)."""
    aileler = {}
    for c in df.columns:
        if not c.startswith('INT_'):
            continue
        for w in _fe_ayarlar()['INT_PENCERELER']:
            if c.endswith('_' + w):
                aileler.setdefault(c[: -len(w) - 1], {})[w] = c
                break
    out = {}
    for aile, pc in aileler.items():
        if len(pc) < 2:
            continue
        V = {w: _sayi(df, c) for w, c in pc.items()}
        for yakin, uzak in (('LM', 'L3M'), ('L3M', 'L6M'), ('L3M', 'L12M'), ('L6M', 'L12M')):
            if yakin in V and uzak in V:
                out[f'{aile}_INTD_{yakin}_{uzak}'] = _oran_nan(V[yakin], V[uzak])
        sirali = [w for w in _fe_ayarlar()['INT_PENCERELER'] if w in V]
        yakin, uzaklar = sirali[0], sirali[1:]
        uzak_aktif = np.zeros(len(df), bool)
        uzak_olc = np.zeros(len(df), bool)
        for w in uzaklar:
            uzak_aktif |= np.nan_to_num(V[w]) > 0
            uzak_olc |= np.isfinite(V[w])
        olc = np.isfinite(V[yakin]) & uzak_olc
        out[f'{aile}_INTD_DURDU_FLG'] = np.where(olc, (V[yakin] == 0) & uzak_aktif, np.nan)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# BV_* (4 feature): kart borcu ile varlık (TAUM) birlikte. Örnek: TAUM_TUT_AVG_3M 20000,
# TAUM_TUT_AVG_4_6M 30000, KK_RISK_LM 7600, KK_RISK_L3M 7500. Payda <= 0 / boşsa NaN.
#
#   BV_TAUM_DEGISIM_ORAN_3_46
#     Nasıl : (TAUM 3M - TAUM 4-6M) / TAUM 4-6M.
#     Anlamı: Varlık son 3 ayda önceki 3 aya göre yüzde kaç değişti.
#     Örnek : (20000 - 30000) / 30000 = -0.33 (%33 azalma).
#
#   BV_KK_RISK_TAUM_ORAN
#     Nasıl : KK_RISK_LM / TAUM 3M.
#     Anlamı: Kart borcu varlığın ne kadarı; yüksek = borç varlığa göre büyük.
#     Örnek : 7600 / 20000 = 0.38.
#
#   BV_BORC_ARTIYOR_VARLIK_AZALIYOR_FLG
#     Nasıl : KK_RISK_LM > KK_RISK_L3M ve TAUM 3M < TAUM 4-6M ise 1.
#     Anlamı: Borç artarken varlık eriyor mu.
#     Örnek : 7600 > 7500 ve 20000 < 30000 → 1.
#
#   BV_KK_RISK_TAUM_ORAN_DEGISIM
#     Nasıl : BV_KK_RISK_TAUM_ORAN - (KK_RISK_L3M / TAUM 4-6M).
#     Anlamı: Borç / varlık oranı ne kadar arttı.
#     Örnek : 0.38 - 7500 / 30000 = 0.38 - 0.25 = 0.13.
# ------------------------------------------------------------------------------
def _borc_varlik_features(df):
    """Kart borcu artarken varliklar (TAUM) eriyor mu?"""
    out = {}
    if {'TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_4_6M'}.issubset(df.columns):
        t3, t46 = _sayi(df, 'TAUM_TUT_AVG_3M'), _sayi(df, 'TAUM_TUT_AVG_4_6M')
        out['BV_TAUM_DEGISIM_ORAN_3_46'] = _oran_nan(t3 - t46, t46)
    if 'KK_RISK_LM' in df.columns and 'TAUM_TUT_AVG_3M' in df.columns:
        rsk, taum = _sayi(df, 'KK_RISK_LM'), _sayi(df, 'TAUM_TUT_AVG_3M')
        out['BV_KK_RISK_TAUM_ORAN'] = _oran_nan(rsk, taum)
        if {'KK_RISK_L3M', 'TAUM_TUT_AVG_4_6M'}.issubset(df.columns):
            rsk3, taum46 = _sayi(df, 'KK_RISK_L3M'), _sayi(df, 'TAUM_TUT_AVG_4_6M')
            olc = np.isfinite(rsk) & np.isfinite(rsk3) & np.isfinite(taum) & np.isfinite(taum46)
            out['BV_BORC_ARTIYOR_VARLIK_AZALIYOR_FLG'] = np.where(olc, (rsk > rsk3) & (taum < taum46), np.nan)
            out['BV_KK_RISK_TAUM_ORAN_DEGISIM'] = out['BV_KK_RISK_TAUM_ORAN'] - _oran_nan(rsk3, taum46)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# KK_O_* (20 feature): bankanın limit aksiyonları ve kullanımın kritik eşikleri. Limit <= 0 boş
# sayılır. Kullanım = KK_RISK / KK_LIMIT. Eşikler 80, 90, 100 = kullanım >= 0.8 / 0.9 / 1.0.
# Örnek: limit L4M 10000 → L3M 8000; kullanım 0.95, 0.975, 0.94, 0.70 ...; borç L11M, L12M 0.
#
#   KK_O_LIMIT_DUSUS_ADET_12M, KK_O_LIMIT_ARTIS_ADET_12M
#     Nasıl : Limitin bir önceki aya göre düştüğü / arttığı geçiş sayısı.
#     Anlamı: Banka limiti kaç kez kıstı / artırdı.
#     Örnek : L4M → L3M düşüş → 1 / 0.
#
#   KK_O_AY_SON_LIMIT_DUSUS, KK_O_AY_SON_LIMIT_ARTIS
#     Nasıl : En yeni limit düşüşü / artışı geçişinin ayı.
#     Anlamı: Son limit aksiyonu ne kadar önce.
#     Örnek : Düşüş L4M → L3M → 2; artış yok → NaN.
#
#   KK_O_LIMIT_DEGISIM_ORAN_12M
#     Nasıl : LM limiti / en eski dolu ayın limiti.
#     Anlamı: 1'in altı = limit 12 ayda kısılmış.
#     Örnek : 8000 / 10000 = 0.8.
#
#   KK_O_KULLANIM_80_USTU_ADET_12M, KK_O_KULLANIM_90_USTU_ADET_12M,
#   KK_O_KULLANIM_100_USTU_ADET_12M
#     Nasıl : 12 ayda kullanımın eşiğin üstünde olduğu ay sayısı.
#     Anlamı: Limite ne sık dayanıyor.
#     Örnek : >= 0.8: LM, L2M, L3M → 3; >= 0.9 → 3; >= 1.0 → 0.
#
#   KK_O_KULLANIM_80_USTU_ADET_3M, KK_O_KULLANIM_90_USTU_ADET_3M, KK_O_KULLANIM_100_USTU_ADET_3M
#     Nasıl : Aynı sayım, son 3 ay.
#     Anlamı: Yakın dönemde limite dayanma.
#     Örnek : Son 3 ay 0.95, 0.975, 0.94: >= 0.8 → 3, >= 0.9 → 3, >= 1.0 → 0.
#
#   KK_O_AY_SON_KULLANIM_80_USTU, KK_O_AY_SON_KULLANIM_90_USTU, KK_O_AY_SON_KULLANIM_100_USTU
#     Nasıl : Kullanımın eşik üstünde olduğu en yeni ay.
#     Anlamı: Ne kadar önce eşik üstündeydi.
#     Örnek : 0 / 0 / NaN (hiç >= 1.0 olmadı).
#
#   KK_O_KULLANIM_80_USTU_SERI, KK_O_KULLANIM_90_USTU_SERI, KK_O_KULLANIM_100_USTU_SERI
#     Nasıl : LM'den geriye kesintisiz eşik üstü ay sayısı.
#     Anlamı: Kaç aydır limite dayalı.
#     Örnek : LM, L2M, L3M eşik üstü, L4M 0.70 altında → 3 / 3 / 0 (>= 1.0 hiç yok).
#
#   KK_O_SIFIR_BORC_ADET_12M
#     Nasıl : 12 ayda kart borcu <= 0 olan ay sayısı.
#     Anlamı: Kartı borçsuz geçen aylar.
#     Örnek : L11M, L12M → 2.
#
#   KK_O_AY_SON_SIFIR_BORC
#     Nasıl : Borcun <= 0 olduğu en yeni ay.
#     Anlamı: En son ne zaman borçsuzdu.
#     Örnek : L11M → 10.
#
#   KK_O_BORC_SIFIRDAN_BASLADI_FLG
#     Nasıl : LM'de borç > 0 ve L2M ya da L3M'de borç 0 ise 1; ölçülemezse NaN.
#     Anlamı: Kart borcu yeni başladı.
#     Örnek : L2M ve L3M'de borç var → 0.
# ------------------------------------------------------------------------------
def _kk_olay_features(df):
    """Bankanin limit aksiyonlari ve kullanimin kritik esikleri."""
    A = _fe_ayarlar()
    L = _seri_matrisi(df, 'KK_LIMIT')
    Rk = _seri_matrisi(df, 'KK_RISK')
    if L is None or Rk is None:
        return {}
    out = {}

    Lp = np.where(L > 0, L, np.nan)
    d, pair = _hareketler(Lp)
    dus = pair & (d < 0)
    art = pair & (d > 0)
    out['KK_O_LIMIT_DUSUS_ADET_12M'] = dus.sum(axis=1)
    out['KK_O_LIMIT_ARTIS_ADET_12M'] = art.sum(axis=1)
    out['KK_O_AY_SON_LIMIT_DUSUS'] = _ilk_true(dus)
    out['KK_O_AY_SON_LIMIT_ARTIS'] = _ilk_true(art)
    ok_l = np.isfinite(Lp)
    i_eski = _son_true(ok_l)
    ar = np.arange(len(df))
    eski_lim = np.where(np.isfinite(i_eski), Lp[ar, np.nan_to_num(i_eski).astype(int)], np.nan)
    out['KK_O_LIMIT_DEGISIM_ORAN_12M'] = _oran_nan(Lp[:, 0], eski_lim)

    U = _kk_kullanim_matrisi(df)
    if U is not None:
        okU = np.isfinite(U)
        for e in A['KKU_ESIKLER']:
            tag = f'{int(round(e * 100))}'
            ust = okU & (U >= e)
            out[f'KK_O_KULLANIM_{tag}_USTU_ADET_12M'] = ust.sum(axis=1)
            out[f'KK_O_KULLANIM_{tag}_USTU_ADET_3M'] = ust[:, :3].sum(axis=1)
            out[f'KK_O_AY_SON_KULLANIM_{tag}_USTU'] = _ilk_true(ust)
            out[f'KK_O_KULLANIM_{tag}_USTU_SERI'] = _seri_simdi(ust)

    okR = np.isfinite(Rk)
    sifir = okR & (Rk <= 0)
    out['KK_O_SIFIR_BORC_ADET_12M'] = sifir.sum(axis=1)
    out['KK_O_AY_SON_SIFIR_BORC'] = _ilk_true(sifir)
    olc = okR[:, 0] & (okR[:, 1] | okR[:, 2])
    out['KK_O_BORC_SIFIRDAN_BASLADI_FLG'] = np.where(
        olc, (Rk[:, 0] > 0) & (sifir[:, 1] | sifir[:, 2]), np.nan)

    bos = ~(ok_l.any(axis=1) | okR.any(axis=1))
    return _float_ciktilar(out, df.index, bos_satir=bos)


# ------------------------------------------------------------------------------
# OK_* (7 feature): aynı ayda ödeme oranı < %20 ve kullanım >= 0.8 = "borç sarmalı" ayı.
# Örnek: L2M (%10, 0.975) ve L3M (%10, 0.94) sarmal; LM ödeme %25 olduğu için, L4M kullanım 0.70
# olduğu için değil.
#
#   OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_3M, OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_6M,
#   OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_12M
#     Nasıl : Son 3 / 6 / 12 ayda sarmal ayı sayısı.
#     Anlamı: Az ödeyip limite dayanma sıklığı.
#     Örnek : Sarmal aylar L2M ve L3M, ikisi de son 3 ay içinde → 2 / 2 / 2.
#
#   OK_AY_SON_DUSUK_ODEME_YUKSEK_KULLANIM
#     Nasıl : En yeni sarmal ayı.
#     Anlamı: Sarmal ne kadar yakın.
#     Örnek : L2M → 1.
#
#   OK_DUSUK_ODEME_YUKSEK_KULLANIM_SERI
#     Nasıl : LM'den geriye kesintisiz sarmal ayı sayısı.
#     Anlamı: Kaç aydır sarmalda.
#     Örnek : LM sarmal değil → 0.
#
#   OK_TAM_ODEME_DUSUK_KULLANIM_ADET_12M
#     Nasıl : Ödeme >= %100 ve kullanım < 0.3 olan ay sayısı.
#     Anlamı: Sağlıklı kart kullanımı ayları.
#     Örnek : L10M (0.25), L11M (0), L12M (0) → 3; L9M kullanım tam 0.30 → sayılmaz.
#
#   OK_OLCULEN_AY_12M
#     Nasıl : Ödeme oranı ve kullanımın ikisinin de dolu olduğu ay sayısı.
#     Anlamı: Sayımların kaç aya dayandığı.
#     Örnek : Ödeme ve kullanım 12 ayın hepsinde dolu → 12.
# ------------------------------------------------------------------------------
def _odeme_kullanim_features(df):
    """Ayni ayda dusuk odeme + yuksek kullanim: borc sarmalinin baslangici."""
    A = _fe_ayarlar()
    O = _seri_matrisi(df, 'KK_ODEME_ORANI')
    U = _kk_kullanim_matrisi(df)
    if O is None or U is None:
        return {}
    olc = np.isfinite(O) & np.isfinite(U)
    sarmal = olc & (O < A['ODM_DUSUK']) & (U >= A['KKU_YUKSEK'])
    saglikli = olc & (O >= A['ODM_TAM']) & (U < A['KKU_DUSUK'])
    out = {}
    for W, tag in ((3, '3M'), (6, '6M'), (O.shape[1], '12M')):
        out[f'OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_{tag}'] = sarmal[:, :W].sum(axis=1)
    out['OK_AY_SON_DUSUK_ODEME_YUKSEK_KULLANIM'] = _ilk_true(sarmal)
    out['OK_DUSUK_ODEME_YUKSEK_KULLANIM_SERI'] = _seri_simdi(sarmal)
    out['OK_TAM_ODEME_DUSUK_KULLANIM_ADET_12M'] = saglikli.sum(axis=1)
    out['OK_OLCULEN_AY_12M'] = olc.sum(axis=1)
    return _float_ciktilar(out, df.index, bos_satir=~olc.any(axis=1))


# ------------------------------------------------------------------------------
# DS_* (veride bulunan skora göre): ham veride hazır gelen skorlar (PRED_BK_12_AY_TOP,
# PRED_BK_12_AY_TOP_PERC, PredCs, EXPECTED_LOSS, LTV, LTV_WITH_LOSS) burada yeniden hesaplanmaz;
# yalnızca renk yolu feature'larıyla çarpılır. Örnek: PRED_BK_12_AY_TOP 0.12, EXPECTED_LOSS 900.
#
#   DS_PRED_BK_12_AY_TOP_X_RENK_LM, DS_PRED_BK_12_AY_TOP_X_NUKS,
#   DS_PRED_BK_12_AY_TOP_X_ARTARDA_KOT, DS_PRED_BK_12_AY_TOP_X_DUSUS,
#   DS_PRED_BK_12_AY_TOP_X_RISK_SERI, DS_PRED_BK_12_AY_TOP_X_GIZLI_3M,
#   DS_PRED_BK_12_AY_TOP_X_ESZ_3M  (her skor için aynı 7 çarpım)
#     Nasıl : Skor x feature. RENK_LM = LM renk kodu (inaktifse NaN), NUKS = RENK_Y_NUKS_FLG,
#             ARTARDA_KOT = RENK_Y_ART_ARDA_KOTULESME_FLG, DUSUS =
#             RENK_Y_SON_IYILESMEDEN_BERI_DUSUS, RISK_SERI = RENK_Y_RISK_SERI_SIMDI, GIZLI_3M =
#             GIZLI_KOTULESEN_SINYAL_3M, ESZ_3M = ESZ_KOTULESEN_SINYAL_3M.
#     Anlamı: Hazır skoru müşterinin renk durumuyla birleştirir: aynı skorlu iki müşteriden 3
#             aydır riskte olanın X_RISK_SERI değeri büyük; nüks yoksa X_NUKS 0.
#     Örnek : 0.12 x 2 = 0.24 (X_RENK_LM); 0.12 x 3 = 0.36 (X_RISK_SERI); 0.12 x 4 = 0.48
#             (X_GIZLI_3M, X_ESZ_3M); X_NUKS, X_ARTARDA_KOT, X_DUSUS 0. EXPECTED_LOSS için: 900
#             x 3 = 2700 (DS_EXPECTED_LOSS_X_RISK_SERI).
#
#   DS_EXPECTED_LOSS_KK_RISK_ORAN, DS_EXPECTED_LOSS_KK_LIMIT_ORAN, DS_EXPECTED_LOSS_TAUM_ORAN
#     Nasıl : EXPECTED_LOSS / KK_RISK_LM, / KK_LIMIT_LM, / TAUM_TUT_AVG_3M; payda <= 0 / boşsa
#             NaN.
#     Anlamı: Beklenen kaybın borca / limite / varlığa oranı.
#     Örnek : 900 / 7600 = 0.118; 900 / 8000 = 0.1125; 900 / 20000 = 0.045.
# ------------------------------------------------------------------------------
def _dis_skor_features(df, uretilen):
    """Hazir model skorlarini musterinin renk yolu ve gizli kotulesmesiyle caprazlar."""
    def _num(c):
        if c in uretilen:
            return np.asarray(uretilen[c], dtype='float64')
        if c in df.columns:
            return _sayi(df, c)
        return None

    capraz = {
        'RENK_LM': 'RENK_LM',
        'RENK_Y_NUKS_FLG': 'NUKS',
        'RENK_Y_ART_ARDA_KOTULESME_FLG': 'ARTARDA_KOT',
        'RENK_Y_SON_IYILESMEDEN_BERI_DUSUS': 'DUSUS',
        'RENK_Y_RISK_SERI_SIMDI': 'RISK_SERI',
        'GIZLI_KOTULESEN_SINYAL_3M': 'GIZLI_3M',
        'ESZ_KOTULESEN_SINYAL_3M': 'ESZ_3M',
    }
    out = {}
    for skor in _fe_ayarlar()['DIS_SKORLAR']:
        S = _num(skor)
        if S is None:
            continue
        for kaynak, kisa in capraz.items():
            X = _num(kaynak)
            if X is None:
                continue
            if kaynak == 'RENK_LM':
                X = np.where(np.isin(X, _renk_kodlari()[1]), X, np.nan)
            out[f'DS_{skor}_X_{kisa}'] = S * X
    el = _num('EXPECTED_LOSS')
    if el is not None:
        for payda, kisa in (('KK_RISK_LM', 'KK_RISK'), ('KK_LIMIT_LM', 'KK_LIMIT'),
                            ('TAUM_TUT_AVG_3M', 'TAUM')):
            P = _num(payda)
            if P is not None:
                out[f'DS_EXPECTED_LOSS_{kisa}_ORAN'] = _oran_nan(el, P)
    return _float_ciktilar(out, df.index) if out else {}


def _olay_matrisleri(df):
    """Olay adi -> (olay matrisi [durum veya gecis], olculebilir matrisi)."""
    A = _fe_ayarlar()
    olaylar = {}
    R = _seri_matrisi(df, 'RENK')
    if R is not None:
        R[~np.isin(R, _renk_kodlari()[1])] = np.nan
        okR = np.isfinite(R)
        olaylar['RISK'] = (okR & (R <= A['RENK_RISK_ESIK']), okR)
        olaylar['KIRMIZI'] = (okR & (R == _renk_kodlari()[2]), okR)
        d, pair = _hareketler(R)
        olaylar['RENK_KOTULESME'] = (pair & (d < 0), pair)
    U = _kk_kullanim_matrisi(df)
    if U is not None:
        okU = np.isfinite(U)
        olaylar['KKU_90'] = (okU & (U >= 0.9), okU)
        olaylar['KKU_ASIM'] = (okU & (U >= 1.0), okU)
    O = _seri_matrisi(df, 'KK_ODEME_ORANI')
    if O is not None:
        okO = np.isfinite(O)
        olaylar['DUSUK_ODEME'] = (okO & (O < A['ODM_DUSUK']), okO)
    L = _seri_matrisi(df, 'KK_LIMIT')
    if L is not None:
        d, pair = _hareketler(np.where(L > 0, L, np.nan))
        olaylar['LIMIT_DUSUS'] = (pair & (d < 0), pair)
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        d, pair = _hareketler(M)
        olaylar[f'{base}_BOZULMA'] = (pair & (yon * d < 0), pair)
    return olaylar


# ------------------------------------------------------------------------------
# YB_* (30 feature): müşteri için yeni başlayan olaylar. Her olay için iki feature:
#   YENI   = olay son 3 ayda (LM..L3M; geçişte son 3 geçiş) var, L4M..L12M'de hiç yok → 1.
#   TEKRAR = olay hem son 3 ayda hem L4M..L12M'de var → 1.
# Son 3 ayda hiç ölçüm yoksa ya da geçmişte 3'ten az ölçülebilir ay varsa ikisi de NaN.
# Aşağıda "Nasıl" satırı olayın tanımıdır.
#
#   YB_RISK_YENI, YB_RISK_TEKRAR
#     Nasıl : Rengin risk (KIRMIZI / TURUNCU) olduğu ay.
#     Anlamı: Riske ilk kez mi giriyor, tekrar mı.
#     Örnek : LM, L2M, L3M riskte; L4M..L12M'de hiç risk yok → YENI 1, TEKRAR 0.
#
#   YB_KIRMIZI_YENI, YB_KIRMIZI_TEKRAR
#     Nasıl : Rengin KIRMIZI olduğu ay.
#     Anlamı: Kırmızı ilk kez mi.
#     Örnek : L2M, L3M kırmızı; öncesinde yok → 1, 0.
#
#   YB_RENK_KOTULESME_YENI, YB_RENK_KOTULESME_TEKRAR
#     Nasıl : Rengin bir önceki aya göre kötüleştiği geçiş.
#     Anlamı: Düşüş müşteri için yeni mi.
#     Örnek : Son 3 geçişte L4M → L3M; geçmişte L5M → L4M ve L7M → L6M de var → 0, 1.
#
#   YB_KKU_90_YENI, YB_KKU_90_TEKRAR
#     Nasıl : Kart kullanımının >= 0.9 olduğu ay.
#     Anlamı: Limite dayanma yeni mi.
#     Örnek : LM, L2M, L3M >= 0.9; geçmişte en yüksek 0.70 → 1, 0.
#
#   YB_KKU_ASIM_YENI, YB_KKU_ASIM_TEKRAR
#     Nasıl : Kart kullanımının >= 1.0 olduğu ay (limit aşımı).
#     Anlamı: Limit aşımı yeni mi.
#     Örnek : Hiç aşım yok → 0, 0.
#
#   YB_DUSUK_ODEME_YENI, YB_DUSUK_ODEME_TEKRAR
#     Nasıl : Ödeme oranının < %20 olduğu ay.
#     Anlamı: Düşük ödeme yeni mi.
#     Örnek : L2M, L3M %10; geçmişte L4M %15 → 0, 1.
#
#   YB_LIMIT_DUSUS_YENI, YB_LIMIT_DUSUS_TEKRAR
#     Nasıl : Kart limitinin bir önceki aya göre düştüğü geçiş.
#     Anlamı: Limit kısıntısı yeni mi.
#     Örnek : L4M → L3M düşüş (son 3 geçiş içinde); geçmişte yok → 1, 0.
#
#   YB_KKB_SKOR_BOZULMA_YENI, YB_KKB_SKOR_BOZULMA_TEKRAR
#     Nasıl : KKB skorunun bir önceki aya göre düştüğü geçiş.
#     Anlamı: KKB düşüşü yeni mi.
#     Örnek : Son 3 geçişin hepsi düşüş; geçmişte de düşüş var → 0, 1.
#
#   YB_KK_ODEME_ORANI_BOZULMA_YENI, YB_KK_ODEME_ORANI_BOZULMA_TEKRAR
#     Nasıl : Ödeme oranının bir önceki aya göre düştüğü geçiş.
#     Anlamı: Ödeme düşüşü yeni mi.
#     Örnek : L4M → L3M (15 → 10); geçmişte L5M → L4M (30 → 15) → 0, 1.
#
#   YB_KK_KULLANIM_BOZULMA_YENI, YB_KK_KULLANIM_BOZULMA_TEKRAR
#     Nasıl : Kart kullanımının bir önceki aya göre arttığı geçiş.
#     Anlamı: Kullanım artışı yeni mi.
#     Örnek : L3M → L2M (0.94 → 0.975); geçmişte de artış var → 0, 1.
#
#   YB_DAV_SKOR_BOZULMA_YENI, YB_DAV_SKOR_BOZULMA_TEKRAR
#     Nasıl : DAV skorunun bir önceki aya göre düştüğü geçiş.
#     Anlamı: DAV düşüşü yeni mi.
#     Örnek : Son 3 geçişte ve geçmişte düşüş var → 0, 1.
#
#   YB_MMS_BOZULMA_YENI, YB_MMS_BOZULMA_TEKRAR
#     Nasıl : MMS'in bir önceki aya göre arttığı geçiş.
#     Anlamı: MMS artışı yeni mi.
#     Örnek : L2M → LM (7 → 8); geçmişte L5M → L4M (4 → 5) → 0, 1.
#
#   YB_YENI_OLAY_SAYISI
#     Nasıl : YENI = 1 olan olay sayısı (ölçülebilen olaylar içinde).
#     Anlamı: Müşteri için aynı anda kaç yeni sorun başladı.
#     Örnek : RISK, KIRMIZI, KKU_90, LIMIT_DUSUS → 4.
#
#   YB_KKB_SKOR_YENI_DIP, YB_KK_ODEME_ORANI_YENI_DIP, YB_KK_KULLANIM_YENI_DIP,
#   YB_DAV_SKOR_YENI_DIP, YB_MMS_YENI_DIP
#     Nasıl : LM değeri önceki 11 ayın en kötüsünden de kötüyse 1 (önceki ayların en az 3'ü dolu
#             olmalı).
#     Anlamı: Gösterge müşteri için yeni bir dip yaptı.
#     Örnek : KKB 1150 < önceki en düşük 1180 → 1; DAV 400 < 420 → 1; MMS 8 > 7 → 1; ödeme 25,
#             önceki en düşük 10 → 0; kullanım 0.95, önceki en yüksek 0.975 → 0.
# ------------------------------------------------------------------------------
def _yeni_baslangic_features(df):
    """Son 3 ayda olup onceki aylarda hic olmayan olaylar (musteri icin yeni)."""
    out = {}
    yeni_sayi = None
    olculen = None
    for ad, (E, ok) in _olay_matrisleri(df).items():
        yakin, gecmis = slice(0, 3), slice(3, None)
        yakin_olc = ok[:, yakin].any(axis=1)
        gecmis_olc = ok[:, gecmis].sum(axis=1) >= 3
        olc = yakin_olc & gecmis_olc
        simdi = E[:, yakin].any(axis=1)
        once = E[:, gecmis].any(axis=1)
        yeni = simdi & ~once
        out[f'YB_{ad}_YENI'] = np.where(olc, yeni, np.nan)
        out[f'YB_{ad}_TEKRAR'] = np.where(olc, simdi & once, np.nan)
        yeni_sayi = (0 if yeni_sayi is None else yeni_sayi) + (olc & yeni)
        olculen = (0 if olculen is None else olculen) + olc
    if yeni_sayi is not None:
        out['YB_YENI_OLAY_SAYISI'] = np.where(olculen > 0, yeni_sayi, np.nan)
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        Y = yon * M
        okg = np.isfinite(Y[:, 1:])
        gecmis_en_kotu = np.where(okg, Y[:, 1:], np.inf).min(axis=1)
        olc = np.isfinite(Y[:, 0]) & (okg.sum(axis=1) >= 3)
        out[f'YB_{base}_YENI_DIP'] = np.where(olc, Y[:, 0] < gecmis_en_kotu, np.nan)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# OG_* (15 = 5 seri x 3): müşterinin en son renk kötüleşmesinden önce göstergeleri bozulmuş muydu,
# ve aynı bozulma şimdi renk düşmeden tekrar ediyor mu. Seriler: KKB, ODM (ödeme oranı), KKU (kart
# kullanımı), DAV, MMS; kötü yön: KKB / ODM / DAV düşüşü, KKU / MMS artışı. Renk 12 ayda hiç
# kötüleşmediyse NaN. Örnek: son renk düşüşü L4M → L3M; ondan önceki 3 geçiş L5M → L4M,
# L6M → L5M, L7M → L6M; son 2 geçiş L3M → L2M ve L2M → LM.
#
#   OG_KKB_ONCE_BOZULMA_ADET  (aynısı OG_ODM_, OG_KKU_, OG_DAV_, OG_MMS_ ile)
#     Nasıl : Son renk düşüşünden önceki 3 geçişte göstergenin kötü yöne gittiği geçiş sayısı
#             (0-3).
#     Anlamı: Renk düşmeden önce bu gösterge uyarı vermiş mi; 3 = her ay uyarmış.
#     Örnek : KKB: 1350 → 1300, 1380 → 1350, 1400 → 1380, üçü de düşüş → 3. ODM, KKU, DAV 3; MMS
#             2.
#
#   OG_KKB_ONCU_AY  (aynısı OG_ODM_, OG_KKU_, OG_DAV_, OG_MMS_ ile)
#     Nasıl : Renk düşüşüne en yakın bozulma kaç geçiş önceydi (1-3); bozulma yoksa NaN.
#     Anlamı: Gösterge renkten kaç ay önce sinyal veriyor.
#     Örnek : KKB hemen önceki geçişte (L5M → L4M) düştü → 1.
#
#   OG_KKB_DESEN_TEKRARI  (aynısı OG_ODM_, OG_KKU_, OG_DAV_, OG_MMS_ ile)
#     Nasıl : ONCE_BOZULMA_ADET > 0, son 2 geçişte gösterge yine kötü yöne gitti ve renk son 2
#             geçişte kötüleşmedi ise 1.
#     Anlamı: Geçen sefer renk düşüşünden önce görülen sinyal şimdi yine var, ama renk henüz
#             düşmedi.
#     Örnek : KKB: 1250 → 1180 → 1150 düşüyor, renk son 2 geçişte düşmedi → 1. ODM: 10 → 10 → 25
#             bozulmadı → 0. KKU, DAV, MMS 1.
# ------------------------------------------------------------------------------
def _oncu_gecikme_features(df):
    """Musterinin son renk dususunden once skorlari kac ay once bozulmustu?"""
    R = _seri_matrisi(df, 'RENK')
    if R is None:
        return {}
    R[~np.isin(R, _renk_kodlari()[1])] = np.nan
    dR, pR = _hareketler(R)
    renk_kot = pR & (dR < 0)
    t = _ilk_true(renk_kot)
    var = np.isfinite(t)
    ti = np.where(var, t, 0).astype(int)
    ar = np.arange(len(df))
    son2_renk_kot = renk_kot[:, :2].any(axis=1)
    out = {}
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        d, pair = _hareketler(M)
        boz = pair & (yon * d < 0)
        T1 = boz.shape[1]
        adet = np.zeros(len(df))
        olc = np.zeros(len(df))
        oncu_ay = np.full(len(df), np.nan)
        for k in (3, 2, 1):
            j = ti + k
            gecerli = var & (j < T1)
            jj = np.where(gecerli, j, 0)
            b = gecerli & boz[ar, jj]
            o = gecerli & pair[ar, jj]
            adet += b
            olc += o
            oncu_ay = np.where(b, k, oncu_ay)
        P = 'KKU' if base == 'KK_KULLANIM' else _fe_ayarlar()['SERI_TANIM'].get(base, (base,))[0]
        out[f'OG_{P}_ONCE_BOZULMA_ADET'] = np.where(olc > 0, adet, np.nan)
        out[f'OG_{P}_ONCU_AY'] = np.where(olc > 0, oncu_ay, np.nan)
        simdi_boz = boz[:, :2].any(axis=1)
        out[f'OG_{P}_DESEN_TEKRARI'] = np.where(
            olc > 0, (adet > 0) & simdi_boz & ~son2_renk_kot, np.nan)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# Ana fonksiyon: aileleri sırayla üretir. DS_* en sonda, çünkü RENK_Y_, GIZLI_ ve ESZ_
# çıktılarını kullanır. Ham kolonla aynı isimli üretilen kolonlar atılır.
# Dönüş: (ham kolonlar + yeni feature'lar, yeni feature isimleri).
# ------------------------------------------------------------------------------
def feature_engineering(df):
    """Tum feature gruplarini uretir. (df_eng, yeni_feature_isimleri) doner."""
    out = {}
    for fn in (_renk_features, _renk_yol_features,
               _dav_features, _mms_features, _kkb_features,
               _odeme_features, _ratio_features, _kk_features,
               _seri_dinamik_features, _eszamanli_features,
               _gizli_kotulesme_features, _int_degisim_features,
               _borc_varlik_features, _kk_olay_features,
               _odeme_kullanim_features, _yeni_baslangic_features,
               _oncu_gecikme_features):
        out.update(fn(df))
    out.update(_dis_skor_features(df, out))
    eng = pd.DataFrame(out, index=df.index)
    eng = eng.loc[:, ~eng.columns.duplicated()]
    eng = eng.loc[:, ~eng.columns.isin(df.columns)]
    return pd.concat([df, eng], axis=1), list(eng.columns)
