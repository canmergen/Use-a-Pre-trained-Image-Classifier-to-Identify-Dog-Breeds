    def _tablo_bicim(ws, kolonlar, bas, bit, genislik=15):
        """bas: başlık satırı (1 tabanlı), bit: son veri satırı. Tablo D'den başlar."""
        for _i, ad in enumerate(kolonlar):
            c = _TABLO_SUTUN + _i
            h = ws.cell(row=bas, column=c); h.fill = _fill; h.font = _byz
            h.alignment = Alignment(wrap_text=True, vertical="top")
            ws.column_dimensions[get_column_letter(c)].width = genislik
            ad = str(ad)
            _fmt = ("0.00%" if ad.endswith("(%)") else "#,##0" if ad.endswith("(adet)") else
                    "0.00" if ad.endswith("LIFT") else None)
            for _r in range(bas + 1, bit + 1):
                _h = ws.cell(row=_r, column=c)
                if _fmt:
                    _h.number_format = _fmt
                if ad in ("HÜKÜM", "DURUM", _C_KAZANAN) and _h.value in _RENK_DURUM:
