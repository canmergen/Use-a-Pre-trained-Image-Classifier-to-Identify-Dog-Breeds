  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #E03B3E;
  --kirmizi-acik: #2A1517;
  --kirmizi-halka: rgba(255,77,79,.22);

  --zemin:        #111111;
  --yuzey:        #181818;
  --yuzey-alt:    #141414;
  --kenar:        #2E2E2E;
  --kenar-guclu:  #454545;
  --kenar-acik:   #232323;
  --ayrac:        rgba(255,255,255,.10);

  --metin:        #FFFFFF;
  --metin-soluk:  rgba(255,255,255,.68);

  --user-zemin:   #262626;

  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;

  --golge-1:   0 1px 2px rgba(0,0,0,.5);
  --golge-2:   0 5px 13px rgba(0,0,0,.55);

  --yesil:        #3DDC8A;
  --yesil-acik:   #10281B;
  --amber:        #F5B042;
  --amber-acik:   #2A2210;
  /* Koyu zeminde uyari halkasi acik temadaki degerle neredeyse gorunmezdi */
  --amber-halka:  rgba(245,176,66,.42);
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
