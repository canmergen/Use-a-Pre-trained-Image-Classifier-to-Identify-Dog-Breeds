            sat["hk"] = _bd_hukum(sat)
            b2.append(sat)
    return {"ozet": ozet, "bucket": bucket, "b1": b1, "b2": b2, "b3": b3, "b4": b4, "b5": b5, "b6": b6, "b7": b7}


