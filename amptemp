                        KARSILASTIRMA_SAYFA) if s and s in wb.sheetnames]
_bd_i = wb.sheetnames.index(_bd_once[0]) + 1 if _bd_once else len(wb._sheets)
for _j, _w in enumerate(_bd_yeni):
