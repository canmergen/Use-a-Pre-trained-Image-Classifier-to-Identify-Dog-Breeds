def _skor_durumu(skor):
    """Kıyas skorunun modellerde değişken olarak kullanımı → (durum, havuzu bilinen, havuzda olan, seçileni bilinen,
    seçilende olan). Durum: "var" | "yok_havuz" (hiçbir havuzda yok, tüm modellerin havuzu biliniyor) |
    "yok_secilen" (hiçbir modelde seçilmemiş; havuzu bilinmeyen model var) | "bilinmiyor"."""
    h = [d["skor"][skor][0] for d in DEG_LISTE if d.get("skor") and d["skor"][skor][0] is not None]
    s = [d["skor"][skor][1] for d in DEG_LISTE if d.get("skor") and d["skor"][skor][1] is not None]
    if not s:
        dur = "bilinmiyor"
    elif any(h) or any(s):
        dur = "var"
    else:
        dur = "yok_havuz" if len(h) == len(s) else "yok_secilen"
    return dur, len(h), sum(h), len(s), sum(s)


SKOR_DURUM = {s: _skor_durumu(s) for s in KIYAS_SKOR_KODU}


def _skor_metni(skor):
    """Kıyas skorunun modelde kullanılıp kullanılmadığını anlatan cümle ("" = bilgi yok)."""
    dur, nh, h, ns, s = SKOR_DURUM[skor]
    if dur == "yok_havuz":
        return f"{skor} modellerde değişken olarak kullanılmaz (hiçbir modelin elemeye giren değişkenleri arasında yok)."
    if dur == "yok_secilen":
        return f"{skor} hiçbir modelin değişkenleri arasında yok."
    if dur == "var" and s:
        return (f"{skor}'ndan türetilen değişkenler {s} / {ns} modelde kullanılıyor; bu modeller o skorun bilgisini de "
                "taşır, karşılaştırma bu gözle okunmalı.")
    if dur == "var":
        return f"{skor}'ndan türetilen değişkenler elemeye girdi ama hiçbir modelde kalmadı."
    return ""


