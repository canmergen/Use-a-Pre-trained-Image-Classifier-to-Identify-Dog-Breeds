    if not kl:
        kl = sorted({p.strip("/").split("/")[0] for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    return kl


def _dosyalar(klasor):
    ad = [c["name"] for c in _cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition() if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


def _csv(klasor, ad):
    with mf.get_download_stream(f"/{klasor}/{ad}") as s:
        return pd.read_csv(s)


def _bucket_oot(klasor, ad):
    """bucket xlsx'in ana sheet'inden OOT satırları (bucket'a göre sıralı), kolon adları küçük harf."""
    with mf.get_download_stream(f"/{klasor}/{ad}") as s:
        sayfalar = pd.read_excel(BytesIO(s.read()), sheet_name=None)
    for sh_ad, t in sayfalar.items():
        t.columns = [str(c).strip().lower() for c in t.columns]
        if str(sh_ad).upper().endswith("_DETAY") or not {"kume", "bucket"} <= set(t.columns):
            continue
        t = t[t["kume"].astype(str).str.strip().str.upper() == "OOT"].copy()
        for c in ("bucket", "n", "bad", "bad_rate", "capture", "cum_n_pct"):
            if c in t.columns:
                t[c] = pd.to_numeric(t[c], errors="coerce")
        t = t.dropna(subset=["bucket"]).sort_values("bucket")
        if "bad_rate" not in t.columns and {"n", "bad"} <= set(t.columns):
            t["bad_rate"] = t["bad"] / t["n"]
        elif "bad_rate" in t.columns and t["bad_rate"].max(skipna=True) > 1.5:
            t["bad_rate"] = t["bad_rate"] / 100.0             # 98,24 yazılmışsa 0,9824'e çek
        return t
    return None


def _yakalama(t, pay):
    """En riskli 'pay' kadar müşterideki kümülatif yakalama. Tablonun kümülatif kitle payı
    (cum_n_pct ya da n'den) 'pay'a denk gelen bir dilim sınırı yoksa boş döner (tahmin yapılmaz)."""
    if t is None or "capture" not in t.columns or not len(t):
        return np.nan
    if "cum_n_pct" in t.columns and t["cum_n_pct"].notna().all():
        x = t["cum_n_pct"].to_numpy(dtype=float)
    elif "n" in t.columns and t["n"].notna().all() and t["n"].sum() > 0:
        x = (t["n"].cumsum() / t["n"].sum()).to_numpy(dtype=float)
    else:
        x = (t["bucket"] / t["bucket"].max()).to_numpy(dtype=float)
    i = int(np.argmin(np.abs(x - pay)))
    return _sayi(t["capture"].iloc[i]) if abs(x[i] - pay) <= 0.0025 else np.nan


def _performans(klasor, dosyalar):
    """Renk kodu → {kitle, tr_oran, oot_oran, tr_gini, val_gini, oot_gini, top1, top5, top10, bucket(20)}."""
    sonuc = {}
    ozet = {}
    if "renk_bazli_train_val_oot_ozet.csv" in dosyalar:
        t = _csv(klasor, "renk_bazli_train_val_oot_ozet.csv")
        for _, r in t.iterrows():
            try:
                ozet[int(str(r["renk"]).split("-")[0])] = r
            except (ValueError, KeyError):
                pass
    for kod, ad, _ in RENKLER:
        r = ozet.get(kod)
        if r is None and f"renk_{kod}_{ad}_ozet.csv" in dosyalar:
            o = _csv(klasor, f"renk_{kod}_{ad}_ozet.csv")
            r = o.iloc[0] if len(o) else None
        g = (lambda k: _sayi(r.get(k)) if r is not None else np.nan)
        d = {"kitle": g("n_oot"), "tr_oran": g("target_rate"), "oot_oran": g("oot_target_rate"),
             "tr_gini": g("train_gini"), "val_gini": g("val_gini"), "oot_gini": g("oot_gini"),
             "top1": np.nan, "top5": np.nan, "top10": np.nan, "bucket": [np.nan] * 20}
        b20 = f"renk_{kod}_{ad}_bucket20_train_val_oot.xlsx"
        b100 = f"renk_{kod}_{ad}_bucket100_train_val_oot.xlsx"
        t20 = _bucket_oot(klasor, b20) if b20 in dosyalar else None
        if t20 is not None and len(t20):
            if "bad_rate" in t20.columns:
                br = dict(zip(t20["bucket"].astype(int), t20["bad_rate"]))
                d["bucket"] = [_sayi(br.get(i)) for i in range(1, 21)]
            if not np.isfinite(d["oot_oran"]) and {"n", "bad"} <= set(t20.columns):
                n = t20["n"].sum()
                d["oot_oran"] = t20["bad"].sum() / n if n else np.nan
            if not np.isfinite(d["kitle"]) and "n" in t20.columns:
                d["kitle"] = float(t20["n"].sum())
        t100 = _bucket_oot(klasor, b100) if b100 in dosyalar else None
        for anahtar, pay in (("top1", 0.01), ("top5", 0.05), ("top10", 0.10)):
            d[anahtar] = _yakalama(t100, pay)
            if not np.isfinite(d[anahtar]):                   # bucket100 yoksa bucket20 (%5 ve %10 dilim sınırı)
                d[anahtar] = _yakalama(t20, pay)
        sonuc[kod] = d
    return sonuc


def _kiyas_oku(oot):
    """14 ANALİZ HÜKÜM sheet'i → (vade, hedef, renk kodu) → karşılaştırma değerleri."""
    try:
        with mf.get_download_stream(KIYAS_RAPORU) as s:
            ham = s.read()
    except Exception as e:
        _log(f"⚠ {KIYAS_RAPORU} okunamadı ({type(e).__name__}); karşılaştırma kolonları boş kalacak")
        return {}
    sayfalar = pd.ExcelFile(BytesIO(ham)).sheet_names
    sh = f"HUKUM_OOT_{oot}" if f"HUKUM_OOT_{oot}" in sayfalar else next((s for s in sayfalar if s.startswith("HUKUM_")), None)
    if sh is None:
        _log(f"⚠ {KIYAS_RAPORU}: HUKUM sheet'i yok; karşılaştırma kolonları boş kalacak")
        return {}
    t = pd.read_excel(BytesIO(ham), sheet_name=sh, header=None)
    # tablo başlığı: "SEGMENT" ve hemen sağında "HEDEF" olan hücre (sol paneldeki kolon sözlüğü de "SEGMENT" içerir)
    yer = [(i, j) for i in range(min(15, len(t))) for j in range(t.shape[1] - 1)
           if str(t.iat[i, j]).strip() == "SEGMENT" and str(t.iat[i, j + 1]).strip() == "HEDEF"]
    if not yer:
        _log(f"⚠ {KIYAS_RAPORU}/{sh}: SEGMENT | HEDEF başlığı bulunamadı; karşılaştırma kolonları boş kalacak")
        return {}
    i0, j0 = yer[0]
    bas = [str(x).strip() for x in t.iloc[i0, j0:]]
    veri = t.iloc[i0 + 1:, j0:j0 + len(bas)]
    veri.columns = bas

    def kol(on):
        return next((c for c in bas if c.upper().startswith(on)), None)
    K = {"kitle": kol("KİTLE (ADET)"), "vaka": kol("KİTLE VAKA"), "oran": kol("HEDEF ORANI"),
         "g_dav": kol("GINI: DAVRANIŞ"), "g_mus": kol("GINI: MÜŞTERİ"), "g_mod": kol("GINI: MODEL"),
         "fark": kol("GINI FARKI"), "hukum": kol("HÜKÜM"), "en_iyi": kol("EN İYİ MEVCUT"),
         "y_dav": kol("YAKALAMA: DAVRANIŞ"), "y_mus": kol("YAKALAMA: MÜŞTERİ"), "y_mod": kol("YAKALAMA: MODEL"),
         "aciklama": kol("AÇIKLAMA")}
    _skor_adi = {"DAVRANIŞ SKORU": "Davranış Skoru", "MÜŞTERİ SKORU": "Müşteri Skoru"}
    sonuc = {}
    for _, r in veri.iterrows():
        seg, hed = str(r["SEGMENT"]), str(r["HEDEF"])
        m_s, m_h = re.match(r"^(\d+)-", seg), re.match(r"^(\d+)M (.+)$", hed.strip())
        if not (m_s and m_h) or m_h.group(2).strip() not in KIYAS_HEDEF:
            continue
        d = {k: (r[c] if c else np.nan) for k, c in K.items()}
        for k in ("kitle", "vaka", "oran", "g_dav", "g_mus", "g_mod", "fark", "y_dav", "y_mus", "y_mod"):
            d[k] = _sayi(d[k])
        gd, gm, go = d["g_dav"], d["g_mus"], d["g_mod"]
        if pd.notna(d["en_iyi"]) and str(d["en_iyi"]).strip().upper() in _skor_adi:      # 14'ün kendi kolonu
            d["en_iyi"] = _skor_adi[str(d["en_iyi"]).strip().upper()]
        else:                                                                         # yoksa Gini'den
            d["en_iyi"] = (None if not (np.isfinite(gd) or np.isfinite(gm)) else
                           "Davranış Skoru" if np.nan_to_num(gd, nan=-9) >= np.nan_to_num(gm, nan=-9) else "Müşteri Skoru")
        hk = str(d["hukum"]).strip() if pd.notna(d["hukum"]) else None
        if hk and hk.endswith("YETER"):        # MEVCUT SKOR YETER / DAVRANIŞ SKORU YETER / MÜŞTERİ SKORU YETER
            yeter = [ad for ad, g in (("Davranış Skoru", gd), ("Müşteri Skoru", gm))
                     if np.isfinite(g) and np.isfinite(go) and g >= go]
            hk = f"MEVCUT SKOR YETER: {' ve '.join(yeter) if yeter else d['en_iyi']}"
        d["hukum"] = hk
        d["aciklama"] = str(d["aciklama"]) if pd.notna(d["aciklama"]) else None
        sonuc[(int(m_h.group(1)), KIYAS_HEDEF[m_h.group(2).strip()], int(m_s.group(1)))] = d
    _log(f"{KIYAS_RAPORU} / {sh}: {len(sonuc)} karşılaştırma satırı okundu")
    return sonuc


