def _kacan_oku(ham, oot):
    """14 ANALİZ KAÇAN DİLİM sheet'i → satır listesi (her satır: renk x hedef-vade x mevcut skor)."""
    if ham is None:
        return []
    veri, sh = _rapor_tablosu(ham, "KACAN_DILIM_", oot)
    if veri is None:
        return []
    kol = set(veri.columns)
    g = (lambda r, ad: _sayi(r[ad]) if ad in kol else np.nan)
    sonuc = []
    for _, r in veri.iterrows():
        an = _anahtar(r)
        skor = _SKOR_ADI.get(str(r.get("MEVCUT SKOR", "")).strip().upper()) if "MEVCUT SKOR" in kol else None
        if an is None or skor is None:
            continue
        kz = str(r["KAZANAN"]).strip() if "KAZANAN" in kol and pd.notna(r["KAZANAN"]) else None
        d = {"vade": an[0], "aile": an[1], "kod": an[2], "skor": skor, "kazanan": kz,
             "n": g(r, "KİTLE (adet)"), "v": g(r, "KİTLE VAKA (adet)"), "o": g(r, "KİTLE HEDEF ORANI (%)"),
             "fark": g(r, "ORAN FARKI: MODEL GRUBU - MEVCUT GRUBU (%)"), "net": g(r, "NET EK VAKA: MODEL LEHİNE (adet)"),
             "ort": g(r, "RİSKLİ LİSTE ÖRTÜŞMESİ (%)")}
        for on, grup in (("sm", _G_SM), ("sv", _G_SV), ("ir", _G_IR), ("it", _G_IT)):
            d[f"{on}_n"] = g(r, f"{grup} (adet)")
            d[f"{on}_v"] = g(r, f"{grup}: VAKA (adet)")
            d[f"{on}_o"] = g(r, f"{grup}: HEDEF ORANI (%)")
        sonuc.append(d)
    _log(f"{KIYAS_RAPORU} / {sh}: {len(sonuc)} kaçan dilim satırı okundu")
    return sonuc


def _ozet_oku(ham, oot):
    """14 ANALİZ OZET_ADETLER → {"kitle": {kod | "TOPLAM": {...}}, "hedef": {(vade, aile, kod | "TOPLAM"): (vaka, oran)}}."""
    if ham is None:
        return None
    veri, sh = _rapor_tablosu(ham, "OZET_ADETLER", oot, ilk="DONEM", ikinci="SEGMENT")
    if veri is None:
        return None
    don = pd.to_numeric(veri["DONEM"], errors="coerce")
    if (don == oot).any():
        veri = veri[don == oot]
    elif don.notna().any():                                  # bu OOT yoksa son dönem
        veri = veri[don == don.max()]
    kol = set(veri.columns)
    g = (lambda r, ad: _sayi(r[ad]) if ad in kol else np.nan)
    hedef_kol = {}
    for c in veri.columns:
        m = re.match(r"^(\d+)M (.+): (VAKA \(adet\)|ORAN \(%\))$", str(c))
        if m and m.group(2).strip() in KIYAS_HEDEF:
            hedef_kol[c] = (int(m.group(1)), KIYAS_HEDEF[m.group(2).strip()], "vaka" if m.group(3).startswith("VAKA") else "oran")
    sonuc = {"kitle": {}, "hedef": {}}
    for _, r in veri.iterrows():
        seg = str(r["SEGMENT"]).strip()
        m = re.match(r"^(\d+)-", seg)
        kod = "TOPLAM" if seg.upper() == "TOPLAM" else (int(m.group(1)) if m else None)
        if kod is None:
            continue
        sonuc["kitle"][kod] = {"tum": g(r, "TÜM KİTLE (adet)"), "ortak": g(r, "ORTAK KİTLE (adet)"),
                               "ortak_pay": g(r, "ORTAK KİTLE PAYI (%)"), "fpd": g(r, "FPD KESİŞEN KİTLE (adet)"),
                               "fpd_pay": g(r, "FPD KESİŞEN KİTLE PAYI (%)")}
        for c, (v, aile, tur) in hedef_kol.items():
            sonuc["hedef"].setdefault((v, aile, kod), {})[tur] = g(r, c)
    _log(f"{KIYAS_RAPORU} / {sh}: {len(sonuc['kitle'])} segment satırı okundu")
    return sonuc


def _yakalama_egrisi_oku(ham, oot):
    """14 ANALİZ YAKALAMA sheet'i → (vade, hedef, renk kodu) → {"MODEL" | "Davranış Skoru" | "Müşteri Skoru": [20 değer]}.
    Üç skor HÜKÜM ile aynı kitlede ölçülür; sheet yoksa (14'ün eski sürümü) boş döner."""
