def _sn_bucket_sayfa_adi(kod, nb):
    return f"{_seg_etiket(kod)} B{nb}"[:31]


def _sn_slot_anahtari(m):
    """Aynı hedef farklı vadelerde aynı satırlara gelsin: hedef ailesi ve ayrı takip süresi farkı (ör. 12 Ay Takip)."""
    a = m["aile"]
    return (_BD_TEMEL.index(a) if a in _BD_TEMEL else 99, a, (m["ufuk"] or m["vade"]) - m["vade"])


def _sn_blok(ws, r0, c0, baslik, alt_baslik, t):
    """r0: başlık satırı, c0: ilk kolon. Başlık + alt başlık + kolon adları + bucket satırları."""
    ws.merge_cells(start_row=r0, start_column=c0, end_row=r0, end_column=c0 + _SN_K - 1)
    h = ws.cell(r0, c0, baslik)
    h.fill, h.font, h.alignment = _BOLUM, Font(name=YAZI_TIPI, bold=True, color=BASLIK_YAZI, size=11), _sn_sola
    ws.merge_cells(start_row=r0 + 1, start_column=c0, end_row=r0 + 1, end_column=c0 + _SN_K - 1)
    a = ws.cell(r0 + 1, c0, alt_baslik)
    a.font, a.alignment = Font(name=YAZI_TIPI, italic=True, size=10, color="595959"), _sn_sola
    for j, (k, b, fmt, _) in enumerate(SN_BUCKET_KOLONLARI):
        x = ws.cell(r0 + 2, c0 + j, b)
        x.fill, x.font, x.border = _SN_ALT, _sn_font_k, _KENAR
        x.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        for i, v in enumerate(t[k].tolist()):
            _sn_hucre(ws, r0 + 3 + i, c0 + j, v, fmt=fmt)
    if len(t):
        for k in SN_SKALA_KOLONLARI:
            j = [x[0] for x in SN_BUCKET_KOLONLARI].index(k)
            if np.isfinite(t[k].to_numpy(dtype="float64")).any():
                L = get_column_letter(c0 + j)
                ws.conditional_formatting.add(f"{L}{r0 + 3}:{L}{r0 + 2 + len(t)}", ColorScaleRule(
                    start_type="min", start_color="F8696B", mid_type="percentile", mid_value=50,
                    mid_color="FFEB84", end_type="max", end_color="63BE7B"))


def _sn_sayfa_bucket(kod, nb):
    ad = _sn_bucket_sayfa_adi(kod, nb)
    _bd_sayfa_sil(ad)
    bl = {kl: t for (n, k, kl), t in _SN_BUCKET.items() if n == nb and k == kod}
    if not bl:
        return None
    mdl = {m["klasor"]: m for m in _BD_MODELLER}
    vadeler = sorted({mdl[kl]["vade"] for kl in bl})
    slotlar = sorted({_sn_slot_anahtari(mdl[kl]) for kl in bl})
    yuk = {s: max(len(t) for kl, t in bl.items() if _sn_slot_anahtari(mdl[kl]) == s) for s in slotlar}
    gen = {}
    for vi in range(len(vadeler)):
        for j, (_, _, _, w) in enumerate(SN_BUCKET_KOLONLARI):
            gen[2 + vi * (_SN_K + 1) + j] = w
        gen[2 + vi * (_SN_K + 1) + _SN_K] = 3
    ws = _yeni_sayfa(ad, gen)
    son = 1 + len(vadeler) * (_SN_K + 1) - 1
    S = Sayfa(ws, min(son, 1 + _SN_K))
    S.baslik(2, f"{_seg_etiket(kod)}: modellerin OOT bucketları ({nb}'lik; B1 = en riskli)")
    S.not_satiri(3, "Her blok bir model; vadeler yan yana (3M, 6M, 12M), aynı hedef aynı satırlarda. Kaynak: model "
                    f"klasörlerindeki bucket{nb} raporlarının OOT satırları. Kümülatif Yakalama = bu bucket ve üstündeki "
                    "vakaların bütün vakalara oranı. Renk skalası her blokta ayrı (kırmızı düşük, yeşil yüksek).",
                 yuk=30)
    ws.freeze_panes = "B5"
    r, bas = 5, {}
    for s in slotlar:
        bas[s] = r
        r += 3 + yuk[s] + 2
    for kl, t in bl.items():
        m = mdl[kl]
        vi = vadeler.index(m["vade"])
        x = next((z for z in _SN_MODELLER if z["kl"] == kl and z["kod"] == kod), {})
        baslik = f"{m['vade']}M {m['model']}"
        alt = (f"Train {x.get('tr', '?')} | OOT {x.get('oot', '?')} | {x.get('nsec') or '?'} feature | Gini: train "
               f"{_sn_yzd(x.get('g_tr'))}, val {_sn_yzd(x.get('g_val'))}, OOT {_sn_yzd(x.get('g_oot'))} | "
               f"klasör {kl}")
        _sn_blok(ws, bas[_sn_slot_anahtari(m)], 2 + vi * (_SN_K + 1), baslik, alt, t)
    _yazdir(ws)
    return ws


