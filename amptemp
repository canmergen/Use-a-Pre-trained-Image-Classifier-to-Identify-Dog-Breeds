def _fu_parmak_izi(U, paket, maske, kayit):
    """Havuzdaki her değişken için train müşterilerinde dolu oranı, en sık değer payı (boş dahil) ve tekil değer
    sayısı (pipeline 4a ile aynı hesap) ve eleme_oncesi_featurelar.csv'deki değerle karşılaştırma."""
    farkli, n = [], 0
    kayit = kayit.set_index("feature")
    for c in _fu_havuz(paket):
        if c not in kayit.index:
            continue
        r = kayit.loc[c]
        if pd.isna(r.get("train_dolu_orani")) and pd.isna(r.get("tekil_deger_bos_dahil")):
            continue
        try:
            s = U.kolon(c, paket)[maske]
        except Exception as e:
            farkli.append({"feature": c, "kaynak": r.get("kaynak"), "olcu": "üretilemedi", "egitim": None,
                           "yeni": f"{type(e).__name__}: {e}"})
            n += 1
            continue
        vc = s.value_counts(normalize=True, dropna=False)
        yeni = {"train_dolu_orani": round(float(s.notna().mean()), 4),
                "en_sik_deger_payi": round(float(vc.iloc[0]) if len(vc) else 1.0, 4),
                "tekil_deger_bos_dahil": int((vc > 0).sum())}
        n += 1
        for olcu, v in yeni.items():
            e = r.get(olcu)
            if pd.notna(e) and abs(float(e) - float(v)) > 1e-9:
                farkli.append({"feature": c, "kaynak": r.get("kaynak"), "olcu": olcu, "egitim": float(e), "yeni": v})
    return n, farkli


def _fu_desen_kontrol(U, paket, maskeler, kayit):
    """desen_dagilim.csv: DSN değişkenlerinin train / val / OOT ortalama ve standart sapması."""
    farkli, n = [], 0
    for _, r in kayit.iterrows():
        c = r["feature"]
        for ad, m in maskeler.items():
            if m is None or f"{ad}_ort" not in r:
                continue
            v = pd.to_numeric(U.kolon(c, paket)[m], errors="coerce")
            for olcu, x in ((f"{ad}_ort", float(v.mean())), (f"{ad}_std", float(v.std()))):
                e = r.get(olcu)
                if pd.isna(e):
                    continue
                n += 1
                if not np.isclose(float(e), x, rtol=1e-7, atol=1e-10):
                    farkli.append({"feature": c, "kaynak": "DSN", "olcu": olcu, "egitim": float(e), "yeni": x})
    return n, farkli


def _fu_skor_eslestir(y, e, tol, n_ornek):
    """y: yeni (k, s1), e: eğitim (k, s). Aynı müşteri aynı dönemde birden çok satırda olabilir (ör. birden çok kart);
    bu yüzden her müşterinin satırları skora göre sıralanıp sırayla karşılaştırılır. İki tarafta satır sayısı farklı olan
    müşteriler ayrıca sayılır. → (karşılaştırılan satır, aynı satır, satır sayısı farklı müşteri, en büyük fark, farklılar)"""
    ce, cy = e["k"].value_counts(), y["k"].value_counts()
    ortak = ce.index.intersection(cy.index)
    esit = ortak[ce.reindex(ortak).to_numpy() == cy.reindex(ortak).to_numpy()]
    es = e[e["k"].isin(esit)].sort_values(["k", "s"], kind="mergesort")
    ys = y[y["k"].isin(esit)].sort_values(["k", "s1"], kind="mergesort")
    fark = ys["s1"].to_numpy("float64") - es["s"].to_numpy("float64")
    ayni = int((np.abs(fark) <= tol).sum())
    f = pd.DataFrame({"mbb_no": ys["k"].to_numpy(), "skor_egitim": es["s"].to_numpy(), "skor_yeni": ys["s1"].to_numpy(),
                      "fark": fark})
    f = f.loc[~(np.abs(fark) <= tol)]
    f = f.reindex(f["fark"].abs().sort_values(ascending=False).index).head(n_ornek)
    f["mbb_no"] = f["mbb_no"].round().astype("int64")
    mx = float(np.nanmax(np.abs(fark))) if len(fark) and np.isfinite(fark).any() else np.nan
    return len(ys), ayni, int(len(ortak) - len(esit)), mx, f.to_dict("records")


def _fu_kitle_skor(mbb, skor, egitim, aile):
    """Kitle (eğitim müşterileri yeni veride var mı, müşteri başına satır sayısı aynı mı) ve skor karşılaştırması."""
    e = egitim[["k", "s"]].dropna(subset=["k"])
    y = pd.DataFrame({"k": mbb, "s1": skor}).dropna(subset=["k"])
    ek, vk = np.unique(e["k"].to_numpy("float64")), np.unique(y["k"].to_numpy("float64"))
    eksik, fazla = int(len(np.setdiff1d(ek, vk, assume_unique=True))), int(len(np.setdiff1d(vk, ek, assume_unique=True)))
    n, ayni, satir_farkli, mx, farklar = _fu_skor_eslestir(y, e, FU_FARK_TOL, FU_FARK_ORNEK)
    return {"n_egitim": len(ek), "n_veri": len(vk), "n_satir_egitim": len(e), "n_satir_veri": len(y), "eksik": eksik,
            "fazla": fazla, "fazla_beklenir": aile in _FU_DISLAYAN, "satir_farkli": satir_farkli, "karsilastirilan": n,
            "ayni": ayni, "ayni_pay": ayni / n if n else np.nan, "max_fark": mx, "farklar": farklar}


def _fu_surum_farki(paket):
    import sklearn
    try:
        import lightgbm
        lgb = lightgbm.__version__
    except Exception:
        lgb = None
    simdi = {"lightgbm": lgb, "sklearn": sklearn.__version__, "pandas": pd.__version__, "numpy": np.__version__}
    return [f"{k} {v} → {simdi.get(k)}" for k, v in (paket.get("surumler") or {}).items()
            if simdi.get(k) is not None and str(v) != str(simdi.get(k))]


def _fu_model_log(m, d, desen_bu):
    """Bir model x dönem için kontrol sonucunu hemen yazar: ✓ hepsi tuttu, ⚠ en az biri tutmadı."""
    kt, parca, sorun = m["kontrol"].get(d), [], False
    if kt:
        fz = kt["fazla"] and not kt["fazla_beklenir"]
        sorun |= bool(kt["eksik"]) or bool(fz) or kt["ayni"] < kt["karsilastirilan"]
        sorun |= bool(kt["satir_farkli"])
        parca.append(f"kitle eğitim {kt['n_egitim']:,} müşteri ({kt['n_satir_egitim']:,} satır) / yeni {kt['n_veri']:,} "
                     f"({kt['n_satir_veri']:,} satır) (eksik {kt['eksik']:,}, fazla {kt['fazla']:,}"
                     + (", beklenir" if kt["fazla"] and kt["fazla_beklenir"] else "")
                     + (f", satır sayısı farklı müşteri {kt['satir_farkli']:,}" if kt["satir_farkli"] else "") + ")")
        parca.append(f"skoru aynı {kt['ayni']:,} / {kt['karsilastirilan']:,} satır"
                     + (f" (en büyük fark {kt['max_fark']:.2e})" if np.isfinite(kt["max_fark"]) and kt["max_fark"] > 0
                        else " (en büyük fark 0)" if np.isfinite(kt["max_fark"]) else ""))
    else:
        sorun = True
        parca.append("eğitim skoru yok")
    if d == m["train"] and "fe_eksik" in m:
        fe_f = bool(m["fe_eksik"] or m["fe_fazla"])
        sorun |= fe_f
        parca.append("FE listesi aynı" if not fe_f else f"FE listesi farklı (eksik {len(m['fe_eksik'])}, fazla {len(m['fe_fazla'])}: "
                     + ", ".join((m["fe_eksik"] + m["fe_fazla"])[:5]) + ")")
    if d == m["train"] and m["parmak"]:
        n, fl = m["parmak"]
        fd = list(dict.fromkeys(x["feature"] for x in fl))
        sorun |= bool(fd)
        parca.append(f"parmak izi {n - len(fd):,} / {n:,} değişken aynı" + (f" (farklı: {', '.join(fd[:8])}"
                                                                          + (" ..." if len(fd) > 8 else "") + ")" if fd else ""))
    if desen_bu:
        n, fl = desen_bu
        sorun |= bool(fl)
        parca.append(f"desen {n - len(fl)} / {n} ölçü aynı")
    for x in m["farkli"]:
        if x.startswith(f"{d}:"):
            sorun = True
            parca.append(x[len(str(d)) + 2:])
    _fu_log(f"      {'⚠' if sorun else '✓'} {m['sat']['vade']}M {m['sat']['hedef']} | {d} | " + " | ".join(parca))


