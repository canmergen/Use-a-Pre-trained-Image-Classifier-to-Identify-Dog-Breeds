    def _panel_yaz(ws, baslik, notlar, sozluk):
        """Sol panel: A1 başlık, altında madde madde notlar, sonra kolon sözlüğü."""
        ws.cell(row=1, column=1, value=baslik).font = Font(bold=True, size=12)
        r = 3
        ws.cell(row=r, column=1, value="OKUMA NOTLARI").font = _byz
        for _t in notlar:                       # uzun notlar tabloya taşmasın diye bölünür
            for _j, _par in enumerate(textwrap.wrap(_t, 135)):
                r += 1
                ws.cell(row=r, column=1, value=("• " if _j == 0 else "   ") + _par)
        r += 2
        ws.cell(row=r, column=1, value="KOLON").font = _byz
        ws.cell(row=r, column=2, value="NE ANLATIYOR").font = _byz
        for _k, _a in sozluk:
            for _j, _par in enumerate(textwrap.wrap(_a, 95)):
                r += 1
                if _j == 0:
                    ws.cell(row=r, column=1, value=_k).font = Font(bold=True)
                ws.cell(row=r, column=2, value=_par)
        ws.column_dimensions["A"].width = 46
        ws.column_dimensions["B"].width = 95
        ws.column_dimensions["C"].width = 3
        for _r in range(3, r + 1):
            ws.cell(row=_r, column=1).alignment = Alignment(vertical="top")

    def _tablo_bicim(ws, kolonlar, bas, bit, genislik=15):
        """bas: başlık satırı (1 tabanlı), bit: son veri satırı. Tablo D'den başlar."""
        for _i, ad in enumerate(kolonlar):
            c = _TABLO_SUTUN + _i
            h = ws.cell(row=bas, column=c); h.fill = _fill; h.font = _byz
            h.alignment = Alignment(wrap_text=True, vertical="top")
            ws.column_dimensions[get_column_letter(c)].width = genislik
            ad = str(ad)
            _fmt = "0.00%" if ad.endswith("(%)") else "#,##0" if ad.endswith("(adet)") else None
            for _r in range(bas + 1, bit + 1):
                _h = ws.cell(row=_r, column=c)
                if _fmt:
                    _h.number_format = _fmt
                if ad in ("HÜKÜM", "DURUM", _C_KAZANAN) and _h.value in _RENK_DURUM:
                    _h.fill = PatternFill("solid", fgColor=_RENK_DURUM[_h.value])
        ws.row_dimensions[bas].height = 45

    def _sheet_yaz(xl, sheet, df, baslik, notlar, sozluk, genislik=15):
        df.to_excel(xl, sheet_name=sheet, index=False, startrow=_ILK_SATIR - 1, startcol=_TABLO_SUTUN - 1)
        ws = xl.book[sheet]
        _panel_yaz(ws, baslik, notlar, sozluk)
        _tablo_bicim(ws, df.columns, _ILK_SATIR, _ILK_SATIR + len(df), genislik)
        ws.freeze_panes = ws.cell(row=_ILK_SATIR + 1, column=1)
        return ws

    _yzd = lambda x: f"%{x * 100:g}".replace(".", ",")
