    const birimPasif = pasif || !!(al.birim && al.birim.kilitli);
    alanlar.appendChild(bfAlanCiz("Bölme birimi",
        bfSecimKutusu("birim", (al.birim && al.birim.secenekler) || ["satir", "kimlik"],
                      a.birim, birimPasif, v => bfDegistir("birim", v)),
        al.birim && al.birim["not"]));

    alanlar.appendChild(bfAlanCiz("Val seti",
        bfOnayKutusu("val_var", a.val_var, pasif, v => bfDegistir("val_var", v))));

    alanlar.appendChild(bfAlanCiz("Val oranı",
        bfSayiKutusu("val_oran", a.val_oran, { min: "0.01", max: "0.90", step: "0.01" },
                     pasif || !a.val_var, v => bfDegistir("val_oran", v))));

