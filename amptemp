# ==============================================================
# 1) MODEL KLASÖRLERİNİ BUL
# ==============================================================
def _analiz_klasor_var(yol):
    """mf içinde bu adla bir klasör var mı (dosya değil)."""
    try:
        d = mf.get_path_details("/" + str(yol).lstrip("/"))
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("exists") is False:
        return False
    return bool(d.get("directory", False))


def _analiz_kok_klasorleri():
    """Ana klasördeki alt klasör adları. list_paths_in_partition bu klasörde boş
    döndüğü için önce get_path_details("/") içindeki 'children' kullanılır."""
    adlar = set()
    try:
        d = mf.get_path_details("/")
        for c in (d or {}).get("children", []) or []:
            if c.get("directory"):
                ad = c.get("name") or str(c.get("fullPath", "")).strip("/").split("/")[-1]
                if ad:
                    adlar.add(str(ad).strip("/"))
    except Exception:
        pass
    if not adlar:
        try:
            for p in mf.list_paths_in_partition():
                parca = str(p).strip("/").split("/")
                if len(parca) > 1:
                    adlar.add(parca[0])
        except Exception:
            pass
    if not adlar:
        # Listeleme yoksa olası tüm adlar tek tek denenir
        for _oot in OOT_DONEMLER:
            for _n in VADE_ADAYLARI:
                for _aile in HEDEF_AILELERI:
                    _ad = f"{_n}M_{_aile}_{_oot}"
                    if _analiz_klasor_var("/" + _ad):
                        adlar.add(_ad)
    return sorted(adlar)


_KLASOR_DESENI = re.compile(
    r"^(\d+)M_(" + "|".join(sorted(HEDEF_AILELERI, key=len, reverse=True)) + r")_(OOT\d{6})$")


def _onek_coz(onek):
    """'3M_ICINDE_KIRMIZI_TAKIP' → (3, 'ICINDE_KIRMIZI_TAKIP')"""
    _m = re.match(r"^(\d+)M_(.+)$", onek)
    return int(_m.group(1)), _m.group(2)


# OOT → [(klasör adı, model öneki, ACT kolonu), ...]  (sadece var olanlar)
KLASORLER_OOT = {}
_taninmayan = []
if MODEL_GEREKLILIK_ANALIZI:
    for _ad in _analiz_kok_klasorleri():
        if _ad.upper() in {h.upper() for h in HARIC_KLASORLER}:
            continue
        _m = _KLASOR_DESENI.match(_ad)
        if not _m:
            _taninmayan.append(_ad)
            continue
        _onek = f"{_m.group(1)}M_{_m.group(2)}"
        KLASORLER_OOT.setdefault(_m.group(3), []).append((_ad, _onek, f"ACT_{_onek}"))
    for _oot in KLASORLER_OOT:
        KLASORLER_OOT[_oot].sort(key=lambda t: (list(HEDEF_AILELERI).index(_onek_coz(t[1])[1]),
                                                _onek_coz(t[1])[0]))
    for _oot, _lst in sorted(KLASORLER_OOT.items()):
        print(f"✓ {_oot}: {len(_lst)} model klasörü bulundu → " + ", ".join(k for k, _, _ in _lst))
    if _taninmayan:
        print(f"ⓘ Adı tanınmayan klasör (okunmadı): {_taninmayan}")

TUM_KLASORLER = [k for _lst in KLASORLER_OOT.values() for k, _, _ in _lst]
# (model öneki, gerçekleşme kolonu), her model bir kez
MODEL_ONEK_ACT = list(dict.fromkeys((o, a) for _lst in KLASORLER_OOT.values() for _, o, a in _lst))
_analiz_hazir = MODEL_GEREKLILIK_ANALIZI and len(TUM_KLASORLER) > 0

if not MODEL_GEREKLILIK_ANALIZI:
    print("ⓘ MODEL_GEREKLILIK_ANALIZI=False → analiz atlandı.")
elif not TUM_KLASORLER:
    print("ⓘ Hiçbir model klasörü bulunamadı → analiz atlandı.")

if _analiz_hazir:
    if 'df_raw' not in globals():
        raise RuntimeError("df_raw bellekte yok, analiz kurulamaz.")

    # Ayarları kısa adlara aç
    ESIK_GINI_GEREKLI       = float(ANALIZ_AYAR["ESIK_GINI_GEREKLI"])
    RISKLI_DILIM_PCT        = float(ANALIZ_AYAR["RISKLI_DILIM_PCT"])
    ESIK_BERABER_PUAN       = float(ANALIZ_AYAR["ESIK_BERABER_PUAN"])
    ESIK_MIN_VAKA           = int(ANALIZ_AYAR["ESIK_MIN_VAKA"])
    ESIK_SKOR_ESLESME       = float(ANALIZ_AYAR["ESIK_SKOR_ESLESME"])
    ESIK_MUSTERI_FARK       = float(ANALIZ_AYAR["ESIK_MUSTERI_FARK"])
    ESIK_HEDEF_ORANI_FARK   = float(ANALIZ_AYAR["ESIK_HEDEF_ORANI_FARK"])
    ESIK_BADRATE_TUTARLILIK = float(ANALIZ_AYAR["ESIK_BADRATE_TUTARLILIK"])
    ESIK_HEDEF_UYUM         = float(ANALIZ_AYAR["ESIK_HEDEF_UYUM"])

    # Riskli dilim = bucket 1..RISKLI_UST (20 bucket'ta %20 → B1-B4)
    RISKLI_UST   = max(1, min(ANALIZ_N_BUCKET, int(np.ceil(ANALIZ_N_BUCKET * RISKLI_DILIM_PCT))))
    _RISKLI_YZD  = int(round(RISKLI_DILIM_PCT * 100))

    _SKOR_RENKLER = MODEL_RENKLER if 'MODEL_RENKLER' in globals() else [1, 2, 3, 4, 5, 6]
    _renk_map     = COLOR_MAP if 'COLOR_MAP' in globals() else {}

    def _renk_etiket(rk):
        return f"{rk}-{_renk_map.get(rk, rk)}"

    # Rapordaki kısa hedef adları
    _KISA_GOVDE = {aile: v[2] for aile, v in HEDEF_AILELERI.items()}

    def _kisa_ad(ad):
        """'3M_ICINDE_KIRMIZI_RENGE_GOC' veya 'ACT_3M_...' → '3M İÇİNDE KIRMIZIYA GÖÇ'"""
        _s = ad[4:] if ad.startswith("ACT_") else ad
        _m = re.match(r"(\d+M)_(.+)", _s)
        if not _m:
            return _s
        return f"{_m.group(1)} {_KISA_GOVDE.get(_m.group(2), _m.group(2))}"

    # Kontrol tabloları bu listelerde birikir, en sonda KONTROLLER sheet'ine yazılır
    _ktrl_hedef, _ktrl_skor_dosya, _ktrl_model_tablo, _ktrl_kapsama = [], [], [], []
    _ktrl_fpd = []

    # ==============================================================
    # A) GERÇEKLEŞME HEDEFLERİ ve KIYAS SKORLARI (df_raw'dan)
    # --------------------------------------------------------------
    # ACT_ kolonları "gerçekte ne oldu" bilgisidir, model tahmini değil.
    # Bölüm 4 (Target Tanımlama) ile birebir aynı tanımlar:
    #   NO:1 ACT_<n>M_KIRMIZI_RENGE_GOC        = RENK_<n>M_SONRASI == '1-Kırmızı'
    #   NO:2 ACT_<n>M_ICINDE_KIRMIZI_RENGE_GOC = n ay içinde herhangi bir ay kırmızı
    #        NO:1 ve NO:2'de AKB_TAKIP_YY_<n>M_FLG == 0 olmayan müşteri kitlede yoktur:
    #        ACT boş (NaN) bırakılır, bu hedefin hiçbir hesabına girmez.
    #   NO:3 ACT_<n>M_TAKIP                    = AKB_TAKIP_YY_<n>M_FLG == 1
    #   NO:4 ACT_<n>M_ICINDE_KIRMIZI_TAKIP     = n ay içinde kırmızı VEYA takip
    #   NO:5 ACT_<n>M_SONRA_KIRMIZI_VE_TAKIP   = RENK_<n>M_SONRASI kırmızı VEYA takip
    # Kıyas skorları: DAV_SKOR → DAVRANIS_SKOR, MMS → MUSTERI_SKOR
    # ==============================================================
    JOIN_KEYS       = ["DONEM", "MBB_NO"]
    VADELER         = sorted({_onek_coz(o)[0] for o, _ in MODEL_ONEK_ACT})
    TARGET_COLS     = [a for _, a in MODEL_ONEK_ACT]
    _KIRMIZI_ETIKET = "1-Kırmızı"

    df_analiz = df_raw[list(dict.fromkeys(list(df_raw.columns)))].copy()

    _dfraw_kiyas_haritasi = {"DAV_SKOR": "DAVRANIS_SKOR", "MMS": "MUSTERI_SKOR"}
    _eksik = [c for c in _dfraw_kiyas_haritasi if c not in df_analiz.columns]
    if _eksik:
        raise KeyError(f"df_raw'da kıyas skoru kolonu yok: {_eksik}")
    _cakisma = [(s, d) for s, d in _dfraw_kiyas_haritasi.items()
                if s in df_analiz.columns and d in df_analiz.columns]
    if _cakisma:
        raise KeyError(f"df_raw'da hem eski hem yeni skor adı var: {_cakisma}. "
                       "Tek isme düşürüp tekrar çalıştırın.")
    df_analiz = df_analiz.rename(columns=_dfraw_kiyas_haritasi)

    _eksik = [c for c in JOIN_KEYS + [f"AKB_TAKIP_YY_{n}M_FLG" for n in VADELER]
              if c not in df_analiz.columns]
    if _eksik:
        raise KeyError(f"df_raw'da eksik kolon: {_eksik}")
    for col in JOIN_KEYS:
        df_analiz[col] = pd.to_numeric(df_analiz[col], errors="coerce").astype("Int64")

    # RENK etiketi ('1-Kırmızı') → sayısal kod (1)
    if "RENK" in df_analiz.columns:
        df_analiz["RENK_KOD"] = pd.to_numeric(
            df_analiz["RENK"].astype(str).str.split("-").str[0].str.strip(),
            errors="coerce").astype("Int64")
    else:
        df_analiz["RENK_KOD"] = pd.array([pd.NA] * len(df_analiz), dtype="Int64")
        print("⚠ df_raw'da RENK kolonu yok → renk blokları üretilemeyecek")

    # _ACT_KAYNAK_MAP: her ACT'nin dayandığı ham kolonlar. Kaynak kolon
    # o dönemde tamamen boşsa gerçekleşme penceresi henüz kapanmamıştır;
    # OZET'te sahte %0 yerine boş yazılır.
    # _ACT_KITLE: hedefin kitlesi (NO:1 / NO:2'de X içinde takibe düşenler yok).
    _ACT_KAYNAK_MAP, _ACT_TANIM, _ACT_KITLE = {}, {}, {}
    _ic_onbellek = {}

    def _icinde_kirmizi(n):
        """n ay içinde herhangi bir ay kırmızı: (seri, kaynak kolonlar, tanım metni)."""
        if n in _ic_onbellek:
            return _ic_onbellek[n]
        _ic = f"{n}M_ICINDE_KIRMIZI"
        _snk = ["RENK_SONRAKI_AY"] + [f"RENK_SONRAKI_{k}AY" for k in range(2, n + 1)]
        if _ic in df_analiz.columns:
            _sonuc = (pd.to_numeric(df_analiz[_ic], errors="coerce").fillna(0) == 1, [_ic], f"{_ic} == 1")
        else:
            _eks = [c for c in _snk if c not in df_analiz.columns]
            if _eks:
                raise KeyError(f"{_ic} yok ve türetmek için gereken kolonlar eksik: {_eks}")
            _sonuc = ((df_analiz[_snk] == _KIRMIZI_ETIKET).any(axis=1), _snk,
                      f"{_snk[0]} .. {_snk[-1]} içinde '{_KIRMIZI_ETIKET}' var")
        _ic_onbellek[n] = _sonuc
        return _sonuc

    for _onek, _act in MODEL_ONEK_ACT:
        _n, _aile = _onek_coz(_onek)
        _no, _kitle_filtresi, _ = HEDEF_AILELERI[_aile]
        _tk = f"AKB_TAKIP_YY_{_n}M_FLG"
        _flg = pd.to_numeric(df_analiz[_tk], errors="coerce")
        _tk_seri = _flg == 1
        _son_kol = f"RENK_{_n}M_SONRASI"
        if _aile in ("KIRMIZI_RENGE_GOC", "SONRA_KIRMIZI_VE_TAKIP"):
            if _son_kol not in df_analiz.columns:
                raise KeyError(f"{_act} için {_son_kol} df_raw'da yok")
            _son_seri = df_analiz[_son_kol] == _KIRMIZI_ETIKET
            _son_not = f"{_son_kol} == '{_KIRMIZI_ETIKET}'"

        if _aile == "KIRMIZI_RENGE_GOC":
            _seri, _kaynak, _tanim = _son_seri, [_son_kol], _son_not
        elif _aile == "ICINDE_KIRMIZI_RENGE_GOC":
            _seri, _kaynak, _tanim = _icinde_kirmizi(_n)
        elif _aile == "TAKIP":
            _seri, _kaynak, _tanim = _tk_seri, [_tk], f"{_tk} == 1"
        elif _aile == "ICINDE_KIRMIZI_TAKIP":
            _ic_s, _ic_k, _ic_n = _icinde_kirmizi(_n)
            _seri, _kaynak, _tanim = _ic_s | _tk_seri, _ic_k + [_tk], f"{_ic_n} VEYA {_tk} == 1"
        else:                                   # SONRA_KIRMIZI_VE_TAKIP
            _seri, _kaynak, _tanim = _son_seri | _tk_seri, [_son_kol, _tk], f"{_son_not} VEYA {_tk} == 1"

        _deger = _seri.astype("float32")
        if _kitle_filtresi:
            _deger = _deger.where(_flg == 0)    # takibe düşen (ya da bayrağı boş) kitlede yok
        df_analiz[_act] = _deger
        _ACT_KAYNAK_MAP[_act] = list(dict.fromkeys(_kaynak + ([_tk] if _kitle_filtresi else [])))
        _ACT_TANIM[_act] = f"{_no}: {_tanim}"
        _ACT_KITLE[_act] = (f"{_tk} == 0 olanlar (X içinde takibe düşen yok)" if _kitle_filtresi
                            else "tüm KK müşteriler")
    del _flg, _tk_seri, _seri, _deger
    _ic_onbellek.clear()

    ortak_donemler = sorted(df_analiz["DONEM"].dropna().unique())
    print(f"✓ Gerçekleşme hedefleri hazır: {len(df_analiz):,} satır | dönemler: {ortak_donemler}")

    # ==============================================================
    # B) MODEL SKORLARI (her model klasöründeki 6 renk CSV'si)
    # --------------------------------------------------------------
    # renk_{kod}_{ad}_musteri_skorlari.csv → SKOR_<klasör> ve PRED_<klasör>
    # kolonları; klasördeki hedef (target_actual) HDF_<klasör> olarak
    # yalnızca kontrol için alınır (KONTROLLER 1).
    # Sol birleştirme: df_analiz'in satır sayısı değişmez.
    # ==============================================================
    SKOR_KOLON = ["mbb_no", "donem", "target_actual", "target_pred", "target_score"]

    for _ek in TUM_KLASORLER:
        _parcalar, _okunan = [], 0
        for _rk in _SKOR_RENKLER:
            _yol = f"/{_ek}/renk_{_rk}_{_renk_map.get(_rk, _rk)}_musteri_skorlari.csv"
            try:
                with mf.get_download_stream(_yol) as _s:
                    _parcalar.append(pd.read_csv(_s, usecols=SKOR_KOLON))
                _okunan += 1
            except Exception as e:
                print(f"   ⚠ {_yol} okunamadı ({e})")
        _ktrl = {"MODEL": _ek, "OKUNAN RENK DOSYASI": f"{_okunan} / {len(_SKOR_RENKLER)}",
                 "MÜKERRER SATIR (adet)": None}
        _ktrl_skor_dosya.append(_ktrl)
        if not _parcalar:
            continue
        _sc = pd.concat(_parcalar, ignore_index=True)
        del _parcalar
        _sc["mbb_no"] = pd.to_numeric(_sc["mbb_no"], errors="coerce").astype("Int64")
        _sc["donem"]  = pd.to_numeric(_sc["donem"],  errors="coerce").astype("Int64")
        _sc = _sc.dropna(subset=["mbb_no", "donem"])
        _dup = int(_sc.duplicated(subset=["mbb_no", "donem"]).sum())
        _ktrl["MÜKERRER SATIR (adet)"] = _dup
        if _dup:
            _sc = _sc.drop_duplicates(subset=["mbb_no", "donem"], keep="first")
        _sc["target_actual"] = pd.to_numeric(_sc["target_actual"], errors="coerce").astype("float32")
        _sc["target_pred"] = pd.to_numeric(_sc["target_pred"], errors="coerce").astype("float32")
        _sc = _sc.rename(columns={"target_score": f"SKOR_{_ek}", "target_pred": f"PRED_{_ek}",
                                  "target_actual": f"HDF_{_ek}",
                                  "mbb_no": "MBB_NO", "donem": "DONEM"})
        _n_once = len(df_analiz)
        df_analiz = df_analiz.merge(_sc, on=JOIN_KEYS, how="left", validate="m:1")
        assert len(df_analiz) == _n_once, f"{_ek}: birleştirme satır sayısını değiştirdi"
        del _sc
        print(f"   ✓ {_ek}: model skoru eklendi")

    # ==============================================================
    # C) MODEL KLASÖRÜNDEKİ 20'Lİ BUCKET TABLOLARI (Excel'den, aynen)
    # --------------------------------------------------------------
    # Her model klasöründe her renk için TEK dosya okunur:
    #   /<klasör>/renk_{kod}_{ad}_bucket20_train_val_oot.xlsx
    # (bucket100 dosyaları ve diğer xlsx'ler okunmaz.)
    # Dosyadaki tablo TRAIN, VAL ve OOT satırlarını alt alta içerir;
    # SADECE kume == 'OOT' olan 20 satır alınır. Hiçbir değer yeniden
    # hesaplanmaz. Alınan kolonlar:
    #   n        → MODEL DİLİMİ MÜŞTERİ
    #   bad      → MODEL DİLİMİNDE GERÇEKLEŞEN (adet)
    #   bad_rate → MODEL DİLİMİNDE GERÇEKLEŞEN (%)  (dosyada yoksa bad / n)
    #   lift     → MODEL DİLİMİ LIFT  (dosyada yoksa bad_rate / OOT toplam oranı)
    #   FPD_ESLESEN_ADET_TKP_ST_5M90 → OZET'teki FPD KESİŞEN KİTLE (20 bucket toplamı)
    # ==============================================================
    _FPD_KOLON_K = FPD_KOLON.lower()

    def _sayiya(seri):
        """Excel hücresini sayıya çevirir; '98,24%' gibi metinleri de çözer."""
        if seri.dtype != object:
            return pd.to_numeric(seri, errors="coerce")
        _s = seri.astype(str).str.strip()
        _pct = _s.str.endswith("%")
        _s = _s.str.rstrip("%").str.replace(" ", "", regex=False)
        _virgul = _s.str.contains(",", regex=False)
        _s = _s.where(~_virgul, _s.str.replace(".", "", regex=False).str.replace(",", ".", regex=False))
        _v = pd.to_numeric(_s, errors="coerce")
        return _v.where(~_pct, _v / 100.0)

    def _model_tablosu(ek, onek, rk):
        """(model klasörü, renk) için OOT bucket tablosu, index = bucket.
        Bulunamazsa (None, neden) döner; neden KONTROLLER'e yazılır."""
        _dosya = f"renk_{rk}_{_renk_map.get(rk, rk)}_bucket20_train_val_oot.xlsx"
        _yol = f"/{ek}/{_dosya}"
        try:
            with mf.get_download_stream(_yol) as _s:
                _d = pd.read_excel(BytesIO(_s.read()), sheet_name=0)
        except Exception as e:
            return None, f"{_dosya} okunamadı ({type(e).__name__})"
        _d.columns = [str(c).strip().lower() for c in _d.columns]
        _eksik = [c for c in ("kume", "bucket", "n", "bad") if c not in _d.columns]
        if _eksik:
            return None, f"{_dosya}: kolon eksik {_eksik}"
        _d = _d[_d["kume"].astype(str).str.strip().str.upper() == "OOT"].copy()
        if _d.empty:
            return None, f"{_dosya}: kume = OOT satırı yok"
        for _c in ("bucket", "n", "bad", "bad_rate", _FPD_KOLON_K):
            if _c in _d.columns:
                _d[_c] = _sayiya(_d[_c])
        if "bad_rate" not in _d.columns:
            _d["bad_rate"] = _d["bad"] / _d["n"]
        elif _d["bad_rate"].max(skipna=True) > 1.5:
            _d["bad_rate"] = _d["bad_rate"] / 100.0        # 98,24 yazılmışsa 0,9824'e çek
        if "lift" in _d.columns:
            _d["lift"] = _sayiya(_d["lift"])
        else:
            _base = _d["bad"].sum() / _d["n"].sum() if _d["n"].sum() else np.nan
            _d["lift"] = _d["bad_rate"] / _base
        _d["bucket"] = _d["bucket"].astype(int)
        return _d.drop_duplicates(subset="bucket", keep="first").set_index("bucket"), _dosya

    def _fpd_degeri(liste):
        """Bir rengin model tablolarından FPD KESİŞEN KİTLE.
        liste: [(model öneki, ACT, SKOR kolonu, klasör tablosu | None), ...]
        Dönen: (değer, kaynak model, en az, en çok, FPD kolonu olan tablo sayısı).
        Modellerin kitlesi farklı olabilir (NO:1 / NO:2 takibe düşenleri çıkarır);
        TÜM KİTLE'ye en yakın olan en geniş kitleli modelin değeri kullanılır."""
        _deg = []
        for _onek, _act, _sc, _tablo in liste:
            if _tablo is not None and _FPD_KOLON_K in _tablo.columns:
                _deg.append((float(_tablo["n"].sum()), int(round(_tablo[_FPD_KOLON_K].fillna(0).sum())), _onek))
        if not _deg:
            return None, None, None, None, 0
        _deg.sort(key=lambda t: t[0], reverse=True)
        _vals = [v for _, v, _ in _deg]
        return _deg[0][1], _deg[0][2], min(_vals), max(_vals), len(_deg)

    # ==============================================================
    # D) METRİK FONKSİYONLARI
    # --------------------------------------------------------------
    # Kıyas skorlarının yönü:
    #   DAVRANIS_SKOR: yüksek = iyi müşteri → riskli taraf DÜŞÜK skor (işaret -1)
    #   MUSTERI_SKOR : yüksek = kötü müşteri → riskli taraf YÜKSEK skor (işaret +1)
    # Skor işaretle çarpılınca hepsinde "büyük = riskli" olur.
    # ==============================================================
    KIYAS_SKORLARI = [                        # (kısa ad, kolon, işaret, rapordaki ad)
        ("DAVRANIS", "DAVRANIS_SKOR", -1.0, "DAVRANIŞ SKORU"),
        ("MUSTERI",  "MUSTERI_SKOR",  +1.0, "MÜŞTERİ SKORU"),
    ]

    _kitle_cache = {}
    def _kitle(don):
        """Bir dönemin analiz kitlesi: o dönemdeki KK ürünlü müşteriler."""
        if don not in _kitle_cache:
            _m = df_analiz["DONEM"] == don
            if "KK_URUN_FLG" in df_analiz.columns:
                _m &= (df_analiz["KK_URUN_FLG"] == "KK")
            _kitle_cache[don] = df_analiz.loc[_m].copy()
        return _kitle_cache[don]

    def _bucketla_riskli(skor_riskli_buyuk, nb=ANALIZ_N_BUCKET):
        """Eşit adetli 20 dilim. Skor 'büyük = riskli' verilmeli; bucket 1 = en riskli %5."""
        s = np.asarray(skor_riskli_buyuk, dtype="float64"); n = len(s)
        order = np.argsort(s, kind="stable")
        r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
        edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
        return nb - np.searchsorted(edges[1:-1], r, side="left")

    def _gini(y, skor_riskli_buyuk):
        """Gini = 2 x AUC - 1. 0 = rastgele, 1 = kusursuz, eksi = ters sıralıyor."""
        y = pd.to_numeric(pd.Series(np.asarray(y)), errors="coerce").to_numpy(dtype="float64")
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        if len(y) == 0 or len(np.unique(y)) < 2:
            return np.nan
        return float(2.0 * roc_auc_score(y, s) - 1.0)

    def _yakalama(y, skor_riskli_buyuk, pct=RISKLI_DILIM_PCT):
        """En riskli %pct dilimdeki vakanın toplam vakaya oranı."""
        y = pd.to_numeric(pd.Series(np.asarray(y)), errors="coerce").to_numpy(dtype="float64")
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        if len(y) == 0 or y.sum() <= 0:
            return np.nan
        k = max(1, int(pct * len(y)))
        top = np.argpartition(-s, min(k, len(y) - 1))[:k]
        return float(y[top].sum() / y.sum())

    def _r4(x):
        return round(float(x), 4) if x is not None and np.isfinite(x) else None

    # ==============================================================
    # E) BUCKET20 BLOĞU (bir segment için 20 satır + TOPLAM)
    # --------------------------------------------------------------
    # Her hedef için 5 kolon; karşılaştırılacak iki oran bitişik:
    #   SKOR DİLİMİNDE GERÇEKLEŞEN (%)    : kıyas skorunun bucket'ında
    #   MODEL DİLİMİNDE GERÇEKLEŞEN (%)   : klasör tablosundaki bad_rate
    #   SKOR DİLİMİNDE GERÇEKLEŞEN (adet)
    #   MODEL DİLİMİ MÜŞTERİ (adet)       : klasör tablosundaki n
    #   MODEL DİLİMİNDE GERÇEKLEŞEN (adet): klasör tablosundaki bad
    # Aynı satırdaki iki bucket'ta farklı müşteriler vardır: solda kıyas
    # skorunun en riskli %5'i, sağda modelin en riskli %5'i.
    # SKOR tarafında her hedef yalnızca o modelin kitlesindeki müşterilerle
    # hesaplanır (hedefin tanımına girmeyen müşteri o hedefin oranına girmez).
    # ==============================================================
    _BUCKET_KOLON = "BUCKET (1 = en riskli %5)"

    def _bucket_blogu(dsub, etiket, skor_col, isaret, model_listesi):
        """model_listesi: [(model öneki, ACT kolonu, SKOR kolonu, klasör tablosu | None), ...]"""
        d = dsub.copy()
        d["_B"] = _bucketla_riskli(isaret * d[skor_col].to_numpy(dtype="float64"))
        _bser = d["_B"]
        _bidx = _bser.value_counts().sort_index().index
        _gs = d.groupby("_B")[skor_col]

        blok = pd.DataFrame({
            "SEGMENT": etiket,
            _BUCKET_KOLON: _bidx,
            "MÜŞTERİ (adet)": _bser.value_counts().sort_index().values,
            "SKOR_MIN": _gs.min().reindex(_bidx).round(4).values,
            "SKOR_ORT": _gs.mean().reindex(_bidx).round(4).values,
            "SKOR_MAX": _gs.max().reindex(_bidx).round(4).values,
        })
        _top = {"SEGMENT": etiket, _BUCKET_KOLON: "TOPLAM", "MÜŞTERİ (adet)": int(len(d)),
                "SKOR_MIN": _r4(d[skor_col].min()), "SKOR_ORT": _r4(d[skor_col].mean()),
                "SKOR_MAX": _r4(d[skor_col].max())}

        def _tablodan(tablo, src):
            if tablo is None or src not in tablo.columns:
                return [None] * len(_bidx)
            return [None if pd.isna(x) else float(x) for x in tablo[src].reindex(_bidx).to_numpy()]

        for _onek, _act, _skor_m, _tablo in model_listesi:
            _k = _kisa_ad(_onek) + " | "
            _c_sk_o = _k + "SKOR DİLİMİNDE GERÇEKLEŞEN (%)"
            _c_md_o = _k + "MODEL DİLİMİNDE GERÇEKLEŞEN (%)"
            _c_sk_l = _k + "SKOR DİLİMİ LIFT"
            _c_md_l = _k + "MODEL DİLİMİ LIFT"
            _c_sk_a = _k + "SKOR DİLİMİNDE GERÇEKLEŞEN (adet)"
            _c_md_n = _k + "MODEL DİLİMİ MÜŞTERİ (adet)"
            _c_md_a = _k + "MODEL DİLİMİNDE GERÇEKLEŞEN (adet)"

            _num = pd.to_numeric(d[_act], errors="coerce")
            if _skor_m in d.columns:                      # yalnızca modelin kitlesi
                _num = _num.where(d[_skor_m].notna())
            _gc  = _num.groupby(_bser)
            blok[_c_sk_o] = _gc.mean().reindex(_bidx).round(4).values
            blok[_c_md_o] = _tablodan(_tablo, "bad_rate")
            _ort = _num.mean()
            blok[_c_sk_l] = (_gc.mean().reindex(_bidx) / _ort).round(4).values if _ort else [None] * len(_bidx)
            blok[_c_md_l] = [None if x is None else round(x, 4) for x in _tablodan(_tablo, "lift")]
            blok[_c_sk_a] = _gc.sum().reindex(_bidx).fillna(0).astype("int64").values
            blok[_c_md_n] = _tablodan(_tablo, "n")
            blok[_c_md_a] = _tablodan(_tablo, "bad")

            # TOPLAM: model tarafında n ve bad toplanır, oran = bad / n (= base_rate)
            _n_t = _b_t = _o_t = None
            if _tablo is not None and {"n", "bad"} <= set(_tablo.columns):
                _n_t, _b_t = float(_tablo["n"].sum()), float(_tablo["bad"].sum())
                _o_t = _r4(_b_t / _n_t) if _n_t > 0 else None
            _top[_c_sk_o] = _r4(_num.mean())
            _top[_c_md_o] = _o_t
            _top[_c_sk_l] = 1.0 if _ort else None
            _top[_c_md_l] = 1.0 if _o_t else None          # toplamın lift'i tanım gereği 1
            _top[_c_sk_a] = int(_num.fillna(0).sum())
            _top[_c_md_n] = _n_t
            _top[_c_md_a] = _b_t

        return pd.concat([blok, pd.DataFrame([_top])], ignore_index=True)

    # ==============================================================
    # F) HÜKÜM ve KAÇAN DİLİM (bir renk segmenti için)
    # --------------------------------------------------------------
    # dsub ORTAK KİTLE'dir (Davranış ve Müşteri skoru dolu). Her hedef, bu
    # kitlenin içinde o modelin kitlesiyle ölçülür: hedef tanımına giren ve
    # model skoru dolu müşteriler. Böylece üç skor AYNI KİŞİLER üzerinde
    # ölçülür; karşılaştırma adildir.
    #
    # HÜKÜM kuralı: GINI FARKI = model Gini - iki mevcut skordan iyi olanın Gini'si
    #   ≥ ESIK_GINI_GEREKLI → MODEL GEREKLİ
    #   0 < fark < eşik     → SINIRDA
    #   ≤ 0                 → <EN İYİ MEVCUT SKOR> YETER (DAVRANIŞ SKORU YETER ya da MÜŞTERİ SKORU YETER)
    #   EN İYİ MEVCUT SKOR = iki mevcut skordan Gini'si yüksek olan; model bununla kıyaslanır.
    #   vaka ya da vaka olmayan < ESIK_MIN_VAKA → YETERSİZ VAKA (Gini güvenilmez)
    # Yakalama oranı karara girmez, destek bilgisidir.
    #
    # KAÇAN DİLİM: iki skor da kitlenin en riskli %20'sini "riskli" sayar.
    # Kişiler 4 gruba ayrılır:
    #   SADECE MODEL RİSKLİ  : mevcut skor temiz, model riskli (mevcudun kaçırdığı)
    #   SADECE MEVCUT RİSKLİ : mevcut skor riskli, model temiz (modelin kaçırdığı)
    #   İKİSİ DE RİSKLİ / İKİSİ DE TEMİZ: iki skorun anlaştığı kişiler
    # İki riskli liste eşit büyüklükte olduğu için ilk iki grup da (neredeyse)
    # eşit büyüklüktedir; hangisinde daha çok vaka varsa o skor haklıdır.
    # Tanım eşiksizdir: PRED (0/1) değil, model skorunun sıralaması kullanılır.
    # ==============================================================
    _G_SADECE_MODEL  = "SADECE MODEL RİSKLİ DİYOR"
    _G_SADECE_MEVCUT = "SADECE MEVCUT SKOR RİSKLİ DİYOR"
    _G_IKISI_RISKLI  = "İKİSİ DE RİSKLİ DİYOR"
    _G_IKISI_TEMIZ   = "İKİSİ DE TEMİZ DİYOR"
    _C_NET           = "NET EK VAKA: MODEL LEHİNE (adet)"
    _C_ORAN_FARK     = "ORAN FARKI: MODEL GRUBU - MEVCUT GRUBU (%)"
    _C_KAZANAN       = "KAZANAN"

    _YAKALAMA_YUZDELER = list(range(5, 101, 5))     # yakalama eğrisinin noktaları (%)

    def _segment_isle(dsub, etiket, skorm_map, kacan_l, hukum_l, yakalama_l=None):
        """dsub: bir renk segmentinin ORTAK KİTLE'si. skorm_map: ACT kolonu → model SKOR kolonu.
        yakalama_l verilirse her hedef için üç skorun yakalama eğrisi (aynı kitle) buraya eklenir."""
        for _a, _skor_m in skorm_map.items():
            _dm = dsub.loc[dsub[_a].notna() & dsub[_skor_m].notna()]      # modelin kitlesi
            _y = pd.to_numeric(_dm[_a], errors="coerce").fillna(0).to_numpy()
            _n, _v = len(_y), int(_y.sum())
            if _n == 0:
                continue
            _az = min(_v, _n - _v) < ESIK_MIN_VAKA

            # ---- üç skorun Gini ve yakalama oranı (aynı kitle) ----
            _met = {}
            for _ad, _col, _isaret, _ in KIYAS_SKORLARI:
                _s = _isaret * _dm[_col].to_numpy(dtype="float64")
                _met[_ad] = (_gini(_y, _s), _yakalama(_y, _s))
            _s_m = _dm[_skor_m].to_numpy(dtype="float64")
            _met["MODEL"] = (_gini(_y, _s_m), _yakalama(_y, _s_m))
            _mod_r = _bucketla_riskli(_s_m) <= RISKLI_UST

            # ---- YAKALAMA EĞRİSİ: üç skor, aynı kitle, %20 noktası HÜKÜM ile aynı fonksiyon ----
            if yakalama_l is not None and _v > 0:
                _skorlar = [("MODEL", _s_m)] + [(_t, _i * _dm[_c].to_numpy(dtype="float64"))
                                                for _, _c, _i, _t in KIYAS_SKORLARI]
                for _sk_ad, _sk in _skorlar:
                    _ys = {"SEGMENT": etiket, "HEDEF": _kisa_ad(_a), "SKOR": _sk_ad,
                           "KİTLE (adet)": _n, "KİTLE VAKA (adet)": _v}
                    for _p in _YAKALAMA_YUZDELER:
                        _ys[f"%{_p} (%)"] = _r4(_yakalama(_y, _sk, _p / 100.0))
                    yakalama_l.append(_ys)

            # ---- KAÇAN DİLİM: her mevcut skor için model ile 2x2 ----
            for _ad, _col, _isaret, _ad_tr in KIYAS_SKORLARI:
                _mev_r = _bucketla_riskli(_isaret * _dm[_col].to_numpy(dtype="float64")) <= RISKLI_UST
                _gruplar = {
                    _G_SADECE_MODEL:  ~_mev_r & _mod_r,
                    _G_SADECE_MEVCUT: _mev_r & ~_mod_r,
                    _G_IKISI_RISKLI:  _mev_r & _mod_r,
                    _G_IKISI_TEMIZ:   ~_mev_r & ~_mod_r,
                }
                _net = int(_y[_gruplar[_G_SADECE_MODEL]].sum() - _y[_gruplar[_G_SADECE_MEVCUT]].sum())
                # KAZANAN: iki "sadece" grubun hedef oranı farkı (puan). Gruplar eşit
                # büyüklükte olduğu için oranı yüksek olan grup daha çok vaka taşır.
                _o_mod = _y[_gruplar[_G_SADECE_MODEL]].mean() if _gruplar[_G_SADECE_MODEL].any() else np.nan
                _o_mev = _y[_gruplar[_G_SADECE_MEVCUT]].mean() if _gruplar[_G_SADECE_MEVCUT].any() else np.nan
                _ofark = _o_mod - _o_mev
                if _v == 0:
                    _kazanan = "VAKA YOK"
                elif not np.isfinite(_ofark):
                    _kazanan = "BERABER"                    # iki skor aynı listeyi vermiş
                elif abs(_ofark) < ESIK_BERABER_PUAN:
                    _kazanan = "BERABER"
                else:
                    _kazanan = "MODEL" if _ofark > 0 else "MEVCUT SKOR"

                _satir = {"SEGMENT": etiket, "HEDEF": _kisa_ad(_a), "MEVCUT SKOR": _ad_tr,
                          "KİTLE (adet)": _n, "KİTLE VAKA (adet)": _v,
                          "KİTLE HEDEF ORANI (%)": _r4(_y.mean()) if _n else None}

                def _grup_yaz(ad):
                    _m = _gruplar[ad]
                    _satir[f"{ad} (adet)"] = int(_m.sum())
                    _satir[f"{ad}: VAKA (adet)"] = int(_y[_m].sum())
                    _satir[f"{ad}: HEDEF ORANI (%)"] = _r4(_y[_m].mean()) if _m.any() else None

                _grup_yaz(_G_SADECE_MODEL)
                _grup_yaz(_G_SADECE_MEVCUT)
                _satir[_C_ORAN_FARK] = _r4(_ofark)
                _satir[_C_NET] = _net
                _satir[_C_KAZANAN] = _kazanan
                _grup_yaz(_G_IKISI_RISKLI)
                _grup_yaz(_G_IKISI_TEMIZ)
                _satir["RİSKLİ LİSTE ÖRTÜŞMESİ (%)"] = (
                    _r4(_gruplar[_G_IKISI_RISKLI].sum() / _mev_r.sum()) if _mev_r.any() else None)
                kacan_l.append(_satir)

            # ---- HÜKÜM ----
            _gin_md, _yak_md = _met["MODEL"]
            _mevcutlar = {k: v for k, v in _met.items() if k != "MODEL" and np.isfinite(v[0])}
            _tr = lambda x: f"{x * 100:.1f}".replace(".", ",")
            _ad_tr = {a: t for a, _, _, t in KIYAS_SKORLARI}
            _en_iyi = max(_mevcutlar, key=lambda k: _mevcutlar[k][0]) if _mevcutlar else None
            _en_iyi_tr = _ad_tr[_en_iyi] if _en_iyi else None
            if _az:
                _fark, _hkm = np.nan, "YETERSİZ VAKA"
                _acik = (f"Vaka {_v:,}, vaka olmayan {_n - _v:,}; ikisinden biri {ESIK_MIN_VAKA}'dan az "
                         "olduğu için Gini güvenilir değil.")
            elif _mevcutlar and np.isfinite(_gin_md):
                _gin_iyi, _yak_iyi = _mevcutlar[_en_iyi]
                _fark = _gin_md - _gin_iyi
                _hkm = ("MODEL GEREKLİ" if _fark >= ESIK_GINI_GEREKLI else
                        "SINIRDA" if _fark > 0 else f"{_en_iyi_tr} YETER")
                _acik = (f"Model, iyi olan mevcut skordan ({_en_iyi_tr}) "
                         f"{_tr(abs(_fark))} puan {'daha iyi' if _fark > 0 else 'daha kötü'} sıralıyor. "
                         f"En riskli %{_RISKLI_YZD}'lik dilimdeki yakalama: model %{_tr(_yak_md)}, "
                         f"{_en_iyi_tr} %{_tr(_yak_iyi)}.")
            else:
                _fark, _hkm = np.nan, "HESAPLANAMADI"
                _acik = "Gini hesaplanamadı: kitlede hedefin iki sınıfı birden yok."

            _oran = _y.mean() if _n else np.nan
            hukum_l.append({
                "SEGMENT": etiket,
                "HEDEF": _kisa_ad(_a),
                "KİTLE (adet)": _n,
                "KİTLE VAKA (adet)": _v,
                "HEDEF ORANI (%)": _r4(_oran),
                "GINI: DAVRANIŞ SKORU (%)": _r4(_met["DAVRANIS"][0]),
                "GINI: MÜŞTERİ SKORU (%)": _r4(_met["MUSTERI"][0]),
                "GINI: MODEL (%)": _r4(_gin_md),
                "EN İYİ MEVCUT SKOR": _en_iyi_tr,
                "GINI FARKI: MODEL - EN İYİ MEVCUT (%)": _r4(_fark),
                "HÜKÜM": _hkm,
                f"YAKALAMA: DAVRANIŞ SKORU (%)": _r4(_met["DAVRANIS"][1]),
                f"YAKALAMA: MÜŞTERİ SKORU (%)": _r4(_met["MUSTERI"][1]),
                f"YAKALAMA: MODEL (%)": _r4(_yak_md),
                "YAKALAMA ÜST SINIRI (%)": _r4(min(1.0, RISKLI_DILIM_PCT / _oran)) if _oran and _oran > 0 else None,
                "AÇIKLAMA": _acik,
            })

    # ==============================================================
    # G) ANA DÖNGÜ: her OOT için kitle, bucket, hüküm, kaçan dilim, kontroller
    # --------------------------------------------------------------
    # KİTLE TANIMLARI (raporun her yerinde bu adlardan biri geçer):
    #   TÜM KİTLE      : OOT dönemindeki KK ürünlü müşteriler (skor şartı yok)
    #   ORTAK KİTLE    : TÜM KİTLE'den Davranış ve Müşteri skoru dolu olanlar.
    #   MODELİN KİTLESİ: ORTAK KİTLE'den hedef tanımına giren ve o modelin skoru
    #                    dolu olanlar. HÜKÜM, KAÇAN DİLİM ve BUCKET20'nin SKOR
    #                    tarafı her hedef için bununla hesaplanır.
    #   MODEL KİTLESİ (klasör): model klasöründeki bucket tablosunun kendi kitlesi.
    #                    Rapordan BAĞIMSIZ kurulmuştur; BUCKET20'nin MODEL tarafı
    #                    buradan gelir. Rapordaki kitleyle ne kadar örtüştüğü
    #                    KONTROLLER'de ölçülür.
    # ==============================================================
    bucket_sheetler = {}    # sheet adı → (bloklar, kıyas kolonu, işaret, rapordaki ad, dönem)
    analiz_ciktilar = {}    # dönem → {"hukum": df, "kacan": df}
    ozet_satirlar   = []
    _oot_donemleri  = []

    for _oot, _kls in KLASORLER_OOT.items():
        _don = int(_oot.replace("OOT", ""))
        dfA0 = _kitle(_don)                                          # TÜM KİTLE
        print(f"\n===== OOT {_don} | tüm kitle: {len(dfA0):,} müşteri =====")
        if dfA0.empty:
            print(f"⚠ OOT {_don}: kitle boş → atlandı")
            continue
        _skorm_map = {a: f"SKOR_{k}" for k, _, a in _kls if f"SKOR_{k}" in df_analiz.columns}

        # ---- Kontrol: model skoru, modelin tanım kitlesinin ne kadarında var ----
        _bu_oot = {k: a for k, _, a in _kls}
        for _r in _ktrl_skor_dosya:
            if _r["MODEL"] in _bu_oot:
                _a = _bu_oot[_r["MODEL"]]
                _c = f"SKOR_{_r['MODEL']}"
                _tanim = dfA0[_a].notna()
                _r["TANIM KİTLESİ (adet)"] = int(_tanim.sum())
                if _c in dfA0.columns:
                    _r["TANIM KİTLESİNDE SKORU OLAN (%)"] = (
                        _r4(dfA0.loc[_tanim, _c].notna().mean()) if _tanim.any() else None)
                    _r["SKORU OLUP TANIM KİTLESİ DIŞINDA (adet)"] = int((dfA0[_c].notna() & ~_tanim).sum())
                else:
                    _r["TANIM KİTLESİNDE SKORU OLAN (%)"] = 0.0
                    _r["SKORU OLUP TANIM KİTLESİ DIŞINDA (adet)"] = 0

        if not _skorm_map:
            print(f"⚠ OOT {_don}: hiç model skoru yok → atlandı")
            continue
        _oot_donemleri.append(_don)

        # ---- ORTAK KİTLE ----
        _ortak_m = dfA0["DAVRANIS_SKOR"].notna() & dfA0["MUSTERI_SKOR"].notna()
        dfO = dfA0.loc[_ortak_m]
        print(f"   ortak kitle: {len(dfO):,} müşteri ({len(dfO) / len(dfA0):.1%})")

        # ---- Klasör tabloları + tablo kontrolleri ----
        # Model kitlesi, rapordaki "model skoru olan TÜM KİTLE" ile karşılaştırılır
        # (iki mevcut skor şartı yok; modelin kendi kitlesiyle aynı tanım).
        _renk_listeleri = {}
        for _rk in _SKOR_RENKLER:
            _ta = dfA0[dfA0["RENK_KOD"] == _rk]
            _liste = []
            for _ek, _onek, _act in _kls:
                _tablo, _bilgi = _model_tablosu(_ek, _onek, _rk)
                _sc = f"SKOR_{_ek}"
                _liste.append((_onek, _act, _sc, _tablo))
                _dm = _ta[_ta[_sc].notna()] if _sc in _ta.columns else _ta.iloc[0:0]
                _ktrl = {"MODEL": _kisa_ad(_onek), "SEGMENT": _renk_etiket(_rk),
                         "OKUNAN DOSYA": _bilgi if _tablo is not None else None,
                         "BUCKET SAYISI": None, "BAD_RATE = BAD / N": None,
                         "MODEL KİTLESİ (adet)": None,
                         "RAPORDA MODEL SKORU OLAN (adet)": int(len(_dm)),
                         "KİTLE FARKI (%)": None,
                         "MODEL KİTLESİ HEDEF ORANI (%)": None,
                         "RAPORDA MODEL SKORU OLANLARIN HEDEF ORANI (%)": _r4(_dm[_act].mean()) if len(_dm) else None,
                         "HEDEF ORANI FARKI (%)": None,
                         "_not": None if _tablo is not None else _bilgi}
                if _tablo is not None:
                    _tn, _tb = float(_tablo["n"].sum()), float(_tablo["bad"].sum())
                    _sapma = (_tablo["bad_rate"] - _tablo["bad"] / _tablo["n"]).abs().max()
                    _ktrl["BUCKET SAYISI"] = int(len(_tablo))
                    _ktrl["BAD_RATE = BAD / N"] = "EVET" if _sapma <= ESIK_BADRATE_TUTARLILIK else "HAYIR"
                    _ktrl["MODEL KİTLESİ (adet)"] = int(_tn)
                    _ktrl["MODEL KİTLESİ HEDEF ORANI (%)"] = _r4(_tb / _tn) if _tn else None
                    if len(_dm):
                        _ktrl["KİTLE FARKI (%)"] = _r4((_tn - len(_dm)) / len(_dm))
                    _a1, _a2 = _ktrl["MODEL KİTLESİ HEDEF ORANI (%)"], _ktrl["RAPORDA MODEL SKORU OLANLARIN HEDEF ORANI (%)"]
                    if _a1 is not None and _a2 is not None:
                        _ktrl["HEDEF ORANI FARKI (%)"] = _r4(_a1 - _a2)
                _ktrl_model_tablo.append(_ktrl)
            _renk_listeleri[_rk] = _liste

        # ---- ÖZET: segment bazında kitle hunisi + FPD + modelin kitlesinde hedef oranları ----
        _ozet_bu = []
        for _rk in _SKOR_RENKLER:
            _ta = dfA0[dfA0["RENK_KOD"] == _rk]
            _to = dfO[dfO["RENK_KOD"] == _rk]
            if not len(_ta):
                continue
            _fpd, _fpd_model, _fpd_min, _fpd_max, _fpd_n = _fpd_degeri(_renk_listeleri.get(_rk, []))
            _r = {"DONEM": _don, "SEGMENT": _renk_etiket(_rk),
                  "TÜM KİTLE (adet)": int(len(_ta)), "ORTAK KİTLE (adet)": int(len(_to)),
                  "ORTAK KİTLE PAYI (%)": _r4(len(_to) / len(_ta)),
                  "FPD KESİŞEN KİTLE (adet)": _fpd,
                  "FPD KESİŞEN KİTLE PAYI (%)": _r4(_fpd / len(_ta)) if _fpd is not None else None}
            for _a, _skor_m in _skorm_map.items():
                _var = any(k in _ta.columns and _ta[k].notna().any() for k in _ACT_KAYNAK_MAP[_a])
                _mk = _to[_a].notna() & _to[_skor_m].notna()
                _r[f"{_kisa_ad(_a)}: VAKA (adet)"] = int(_to.loc[_mk, _a].sum()) if _var else None
                _r[f"{_kisa_ad(_a)}: ORAN (%)"] = (_r4(_to.loc[_mk, _a].mean())
                                                   if _var and _mk.any() else None)
            _ozet_bu.append(_r)
            _ktrl_fpd.append({
                "DONEM": _don, "SEGMENT": _renk_etiket(_rk),
                "FPD KOLONU OLAN TABLO (adet)": _fpd_n,
                "KULLANILAN MODEL (en geniş kitle)": _kisa_ad(_fpd_model) if _fpd_model else None,
                "FPD KESİŞEN KİTLE (adet)": _fpd,
                "MODELLER ARASI EN AZ (adet)": _fpd_min,
                "MODELLER ARASI EN ÇOK (adet)": _fpd_max,
                "DURUM": "OK" if _fpd is not None else "YOK",
                "NOT": ("" if _fpd is None or _fpd_min == _fpd_max else
                        "Modellerin kitlesi farklı (NO:1 / NO:2 X içinde takibe düşenleri çıkarır); "
                        "en geniş kitleli modelin değeri yazıldı.")
                       if _fpd is not None else f"Bu renkte hiçbir bucket20 tablosunda {FPD_KOLON} yok.",
            })
        if _ozet_bu:
            # TOPLAM satırı: adetler toplanır, oranlar toplamlardan yeniden hesaplanır
            _segs = [_rk for _rk in _SKOR_RENKLER if (dfA0["RENK_KOD"] == _rk).any()]
            _ta = dfA0[dfA0["RENK_KOD"].isin(_segs)]
            _to = dfO[dfO["RENK_KOD"].isin(_segs)]
            _fpd_l = [r["FPD KESİŞEN KİTLE (adet)"] for r in _ozet_bu if r["FPD KESİŞEN KİTLE (adet)"] is not None]
            _fpd_t = int(sum(_fpd_l)) if _fpd_l else None
            _rt = {"DONEM": _don, "SEGMENT": "TOPLAM",
                   "TÜM KİTLE (adet)": int(len(_ta)), "ORTAK KİTLE (adet)": int(len(_to)),
                   "ORTAK KİTLE PAYI (%)": _r4(len(_to) / len(_ta)) if len(_ta) else None,
                   "FPD KESİŞEN KİTLE (adet)": _fpd_t,
                   "FPD KESİŞEN KİTLE PAYI (%)": _r4(_fpd_t / len(_ta)) if _fpd_t is not None and len(_ta) else None}
            for _a, _skor_m in _skorm_map.items():
                _var = any(k in _ta.columns and _ta[k].notna().any() for k in _ACT_KAYNAK_MAP[_a])
                _mk = _to[_a].notna() & _to[_skor_m].notna()
                _rt[f"{_kisa_ad(_a)}: VAKA (adet)"] = int(_to.loc[_mk, _a].sum()) if _var else None
                _rt[f"{_kisa_ad(_a)}: ORAN (%)"] = (_r4(_to.loc[_mk, _a].mean())
                                                    if _var and _mk.any() else None)
            ozet_satirlar.extend(_ozet_bu + [_rt])

        # ---- BUCKET20: her kıyas skoru için 6 renk bloğu (ORTAK KİTLE) ----
        for _ad, _col, _isaret, _ad_tr in KIYAS_SKORLARI:
            _bloklar = []
            for _rk in _SKOR_RENKLER:
                _do = dfO[dfO["RENK_KOD"] == _rk]
                if len(_do) >= ANALIZ_N_BUCKET:
                    _bloklar.append(_bucket_blogu(_do, _renk_etiket(_rk), _col, _isaret,
                                                  _renk_listeleri[_rk]))
            if _bloklar:
                bucket_sheetler[f"BUCKET20_{_ad}_OOT_{_don}"] = (_bloklar, _col, _isaret, _ad_tr, _don)

        # ---- HÜKÜM + KAÇAN DİLİM (ORTAK KİTLE, renk bazında) ----
        kacan_satirlar, hukum_satirlar, yakalama_satirlar = [], [], []
        for _rk in _SKOR_RENKLER:
            _do = dfO[dfO["RENK_KOD"] == _rk]
            if len(_do) >= ANALIZ_N_BUCKET:
                _segment_isle(_do, _renk_etiket(_rk), _skorm_map, kacan_satirlar, hukum_satirlar, yakalama_satirlar)
        analiz_ciktilar[_don] = {"hukum": pd.DataFrame(hukum_satirlar),
                                 "kacan": pd.DataFrame(kacan_satirlar),
                                 "yakalama": pd.DataFrame(yakalama_satirlar)}

        # ---- Kontrol: hedef tanımları + klasördeki target_actual ile uyum ----
        _hdf = {a: f"HDF_{k}" for k, _, a in _kls}
        for _a in _skorm_map:
            _kaynak_var = any(k in dfA0.columns and dfA0[k].notna().any() for k in _ACT_KAYNAK_MAP[_a])
            _h = _hdf.get(_a)
            _b = dfA0[_a].notna() & dfA0[_h].notna() if _h in dfA0.columns else pd.Series(False, index=dfA0.index)
            _uyum = _r4((dfA0.loc[_b, _a] == dfA0.loc[_b, _h]).mean()) if _b.any() else None
            _not = ""
            if not _kaynak_var:
                _durum, _not = "YOK", "Kaynak kolon bu dönemde boş: gerçekleşme penceresi henüz kapanmadı"
            elif _uyum is not None and _uyum < ESIK_HEDEF_UYUM:
                _durum = "UYARI"
                _not = (f"Klasördeki target_actual bu tanımla %{_uyum * 100:.2f}".replace(".", ",") +
                        " uyumlu: rapordaki hedef modelin eğitildiği hedefle aynı değil")
            else:
                _durum = "OK"
            _ktrl_hedef.append({
                "DONEM": _don, "HEDEF": _kisa_ad(_a), "TANIM": _ACT_TANIM[_a],
                "KİTLE": _ACT_KITLE[_a],
                "TANIM KİTLESİ (adet)": int(dfA0[_a].notna().sum()),
                "TÜM KİTLE HEDEF ORANI (%)": _r4(dfA0[_a].mean()) if _kaynak_var else None,
                "ORTAK KİTLE HEDEF ORANI (%)": (_r4(dfO.loc[dfO[_skorm_map[_a]].notna(), _a].mean())
                                                if _kaynak_var and len(dfO) else None),
                "KLASÖRDEKİ HEDEFLE UYUM (%)": _uyum,
                "DURUM": _durum,
                "NOT": _not,
            })

        # ---- Kontrol: mevcut skor kapsaması (TÜM KİTLE) ----
        _m_dav = dfA0["DAVRANIS_SKOR"].notna()
        _m_mus = dfA0["MUSTERI_SKOR"].notna()
        for _sen, _kap in [("SADECE DAVRANIŞ SKORU", _m_dav), ("SADECE MÜŞTERİ SKORU", _m_mus),
                           ("EN AZ BİRİ VAR", _m_dav | _m_mus), ("İKİSİ DE VAR", _m_dav & _m_mus)]:
            _r = {"DONEM": _don, "SENARYO": _sen, "SKOR OLAN MÜŞTERİ (%)": _r4(_kap.mean())}
            for _a in _skorm_map:
                _yy = pd.to_numeric(dfA0[_a], errors="coerce").fillna(0)
                _r[f"{_kisa_ad(_a)}: SKORSUZ KİŞİLERDEKİ VAKA PAYI (%)"] = (
                    _r4(_yy[~_kap].sum() / _yy.sum()) if _yy.sum() else None)
            _ktrl_kapsama.append(_r)

    if not analiz_ciktilar:
        raise RuntimeError("Hiçbir OOT için analiz üretilemedi. Model skor kolonlarını kontrol edin.")

    # ---- Kontrol tablolarına DURUM ve NOT ekle ----
    for _r in _ktrl_skor_dosya:
        _es = _r.get("TANIM KİTLESİNDE SKORU OLAN (%)")
        _n = []
        if not _r["OKUNAN RENK DOSYASI"].startswith(f"{len(_SKOR_RENKLER)} /"):
            _n.append("Bazı renk dosyaları okunamadı")
        if _r["MÜKERRER SATIR (adet)"]:
            _n.append("Aynı müşteri+dönem birden fazla satırda; ilki tutuldu")
        if _es is None or _es < ESIK_SKOR_ESLESME:
            _n.append(f"Hedef tanımına giren müşterilerin %{ESIK_SKOR_ESLESME * 100:.0f}'inden azında "
                      "model skoru var; bu hedef eksik kitlede ölçülür")
        if _r.get("SKORU OLUP TANIM KİTLESİ DIŞINDA (adet)"):
            _n.append("Model, bu raporun hedef tanımının dışında kalan müşterileri de skorlamış: "
                      "tanım ya da kitle modelinkiyle farklı")
        _r["DURUM"] = "UYARI" if _n else "OK"
        _r["NOT"] = "; ".join(_n)

    for _r in _ktrl_model_tablo:
        _n = [_r.pop("_not")] if _r.get("_not") else []
        _r.pop("_not", None)
        if _r["OKUNAN DOSYA"] is None:
            _r["DURUM"] = "YOK"
        else:
            _uyari = []
            if _r["BUCKET SAYISI"] != ANALIZ_N_BUCKET:
                _uyari.append(f"Tabloda {_r['BUCKET SAYISI']} bucket var, {ANALIZ_N_BUCKET} bekleniyordu")
            if _r["BAD_RATE = BAD / N"] == "HAYIR":
                _uyari.append("Tablodaki bad_rate, bad / n ile tutmuyor")
            if _r["KİTLE FARKI (%)"] is None or abs(_r["KİTLE FARKI (%)"]) > ESIK_MUSTERI_FARK:
                _uyari.append("Model kitlesi ile raporda model skoru olan kitle farklı büyüklükte")
            if _r["HEDEF ORANI FARKI (%)"] is None or abs(_r["HEDEF ORANI FARKI (%)"]) > ESIK_HEDEF_ORANI_FARK:
                _uyari.append("Hedef oranları tutmuyor: rapordaki hedef tanımı modelinkiyle aynı olmayabilir")
            _r["DURUM"] = "UYARI" if _uyari else "OK"
            _n += _uyari
        _r["NOT"] = "; ".join(_n)

    _ktrl_hedef_df       = pd.DataFrame(_ktrl_hedef)
    _ktrl_skor_dosya_df  = pd.DataFrame(_ktrl_skor_dosya)
    _ktrl_model_tablo_df = pd.DataFrame(_ktrl_model_tablo)
    _ktrl_kapsama_df     = pd.DataFrame(_ktrl_kapsama)
    _ktrl_fpd_df         = pd.DataFrame(_ktrl_fpd)
    ozet_df              = pd.DataFrame(ozet_satirlar)
    _n_uyari = sum(int((d["DURUM"] != "OK").sum()) for d in
                   [_ktrl_hedef_df, _ktrl_skor_dosya_df, _ktrl_model_tablo_df] if "DURUM" in d)
    print(f"\nKONTROLLER: {_n_uyari} satır OK değil (KONTROLLER sheet'ine bakın)")

    # ==============================================================
    # H) EXCEL
    # --------------------------------------------------------------
    # Her sheet aynı düzende:
    #   SOL (A-B): başlık, madde madde okuma notları ve KOLON SÖZLÜĞÜ
    #              (her kolon ne anlatıyor, hangi kitleden)
    #   SAĞ (D'den itibaren): tablo(lar)
    # ==============================================================
    _fill = PatternFill("solid", fgColor="F4CCCC")
    _byz  = Font(bold=True, color="7A1F1F")
    _RENK_DURUM = {
        "OK": "C6EFCE", "MEVCUT SKOR YETER": "C6EFCE", "MODEL": "C6EFCE",
        "DAVRANIŞ SKORU YETER": "C6EFCE", "MÜŞTERİ SKORU YETER": "C6EFCE",
        "UYARI": "FFC7CE", "MODEL GEREKLİ": "FFC7CE", "MEVCUT SKOR": "FFC7CE",
        "SINIRDA": "FFEB9C", "BERABER": "FFEB9C",
        "YOK": "D9D9D9", "HESAPLANAMADI": "D9D9D9", "YETERSİZ VAKA": "D9D9D9",
