def _yon_metni(yon, olay="değişim"):
    if yon > 0:
        return "Negatif = düşüş (kötüleşme), pozitif = artış (iyileşme)."
    if yon < 0:
        return "Pozitif = artış (kötüleşme), negatif = azalış (iyileşme)."
    return "Pozitif = artış, negatif = azalış (limitte azalış bankanın limiti kıstığını gösterir)."


def _ozet_anlam(on, ist):
    ad, yon, _ = _DEGISKEN[on]
    if on == "RENK":
        return {"AVG": "Dönemin ortalama renk seviyesi. Küçük = kötü (1 KIRMIZI ... 6 KOY_YESIL).",
                "STD": "Renk ne kadar oynak; 0 = dönem boyunca hep aynı renk.",
                "MIN": "Dönemde görülen en kötü renk.", "MAX": "Dönemde görülen en iyi renk.",
                "MED": "Uç aylardan etkilenmeyen tipik renk."}[ist]
    iyi_kotu = {+1: ("en kötü", "en iyi"), -1: ("en iyi", "en kötü"), 0: ("en düşük", "en yüksek")}[yon]
    yon_cumle = {+1: " Yüksek = iyi.", -1: " Yüksek = kötü.", 0: ""}[yon]
    return {"AVG": f"Dönemin ortalama seviyesi.{yon_cumle}",
            "STD": "Dönem içindeki oynaklık; 0 = dönem boyunca hep aynı değer.",
            "MIN": f"Dönemde görülen {iyi_kotu[0]} değer.",
            "MAX": f"Dönemde görülen {iyi_kotu[1]} değer.",
            "MED": "Uç aylardan etkilenmeyen tipik değer."}[ist]


