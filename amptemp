def _sn_oku_csv(klasor, ad, dosyalar):
    if ad not in dosyalar:
        return None
    try:
        return _csv(klasor, ad)
    except Exception as e:
        _log(f"   ⚠ /{klasor}/{ad} okunamadı ({type(e).__name__})")
        return None


def _sn_bucket_oku(klasor, ad, dosyalar):
    """Bucket raporu dosyasının ana sheet'inden OOT satırları (bucket'a göre sıralı) → (tablo, eksik kolonlar)."""
    if ad not in dosyalar:
        return None, None
    try:
        with mf.get_download_stream(f"/{klasor}/{ad}") as s:
            sayfalar = pd.read_excel(BytesIO(s.read()), sheet_name=None)
    except Exception as e:
        _log(f"   ⚠ /{klasor}/{ad} okunamadı ({type(e).__name__}: {str(e)[:100]})")
        return None, None
    for sh_ad, t in sayfalar.items():
        km = {str(c).strip().lower(): c for c in t.columns}
        if str(sh_ad).upper().endswith("_DETAY") or not {"kume", "bucket"} <= set(km):
            continue
        t = t[t[km["kume"]].astype(str).str.strip().str.upper() == "OOT"]
        t = t.assign(_b=pd.to_numeric(t[km["bucket"]], errors="coerce")).sort_values("_b", kind="stable")
        out, eksik = {}, []
        for k, _, _, _ in SN_BUCKET_KOLONLARI:
            c = km.get(k.lower()) or (km.get(k.lower()[:-5]) if k.lower().endswith("_adet") else None)
            if c is None:
                out[k] = np.full(len(t), np.nan)
                eksik.append(k)
            else:
                out[k] = pd.to_numeric(t[c], errors="coerce").to_numpy(dtype="float64")
        return pd.DataFrame(out), eksik
    return None, None


def _sn_toplama():
    modeller, secilen, bucket, grafik, eksik_kol, uyari = [], [], {}, {}, {}, []
    for m in _BD_MODELLER:
        kl = m["klasor"]
        dosyalar = set(_dosyalar(kl))
        for kod in m["renkler"]:
            oz = _sn_oku_csv(kl, _sn_renk_dosyasi(kod, "ozet.csv"), dosyalar)
            o = oz.iloc[0].to_dict() if oz is not None and len(oz) else {}
            paket, hata = _bd_paket(kl, kod)
            p = paket or {}
            sb = dict(p.get("shap_bilgi") or {})
            yeni = "shap_secim_metrik" in o or "shap_secim_metrik" in sb
            g = lambda k: _sn_sayi(o.get(k, sb.get(k)))
            n_sec = len(p.get("features") or []) or (int(g("n_feature")) if np.isfinite(g("n_feature")) else None)
            n_aday = g("n_aday_shap")
            if not np.isfinite(n_aday) and p.get("shap_elenen") is not None and n_sec:
                n_aday = float(n_sec + int(p.get("shap_elenen") or 0))
            kural = o.get("shap_secim_kurali", sb.get("shap_secim_kurali"))
            kural_metni = {"gini_en_yuksek": "CV Gini en yüksek", "capture_en_yuksek": "CV Capture@10 en yüksek",
                           "gini_tol_en_kucuk_set": "En yüksek CV Gini'ye yakın en az feature'lı set",
                           "capture_tol_en_kucuk_set": "En yüksek CV Capture'a yakın en az feature'lı set"
                           }.get(str(kural), None)
            aralik = (f"{int(g('shap_min_features'))}-{int(g('shap_max_features'))}"
                      if np.isfinite(g("shap_min_features")) and np.isfinite(g("shap_max_features")) else None)
            modeller.append({
                "kod": kod, "kl": kl, "seg": _seg_etiket(kod), "model": m["model"], "vade": m["vade"],
                "ad": f"{m['vade']}M {m['model']}",
                "tr": _sn_donem(p.get("train_donem")), "oot": _sn_donem(p.get("oot_donem")),
                "ntr": g("n_train"), "oran": g("target_rate"),
                "havuz": g("havuz_n"), "aday": n_aday, "nsec": n_sec,
                "aralik": aralik,
                "kural": ({"hata_importance_yedek": "Yedek: gain importance (SHAPRFECV çalışmadı)",
                           "hata_shapsiz_devam": "Seçimsiz (SHAPRFECV çalışmadı)", "kapali": "SHAPRFECV kapalı",
                           "atlandi_min_feature": "Eleme yok (aday sayısı aralığın altında)"}.get(
                              str(o.get("shap_durum", sb.get("shap_durum"))), kural_metni)
                          if yeni else "Eski pipeline (v16 öncesi)"),
                "cv_sec": g("shap_secilen_gini"), "cv_tam": g("shap_tam_set_gini"),
                "cv_en": g("shap_genel_en_iyi_skor") if str(o.get("shap_secim_metrik", "")) == "gini" else np.nan,
                "cv_en_n": g("shap_genel_en_iyi_n") if str(o.get("shap_secim_metrik", "")) == "gini" else np.nan,
                "tur": g("shap_tur_sayisi"), "kor": g("secilen_yuksek_kor_cift"), "tol": g("shap_secim_tol"),
                "onel": g("on_eleme_uygulandi"),
                "ar_n": g("shap_aralik_en_iyi_n"),
                "ar_g": g("shap_aralik_en_iyi_skor") if str(o.get("shap_secim_metrik", "")) == "gini" else np.nan,
                "g_tr": g("train_gini"), "g_val": g("val_gini"), "g_oot": g("oot_gini"),
                "gap": g("gini_gap_tr_val"), "c_oot": g("capture_oot"),
                "not": ("" if paket is not None else f"model.pkl okunamadı ({hata}). ") +
                       ("" if oz is not None else "ozet.csv yok. ")})
            # seçilen feature'lar: kalan_featurelar.csv (önem) + eleme_oncesi_featurelar.csv (kaynak)
            kf = _sn_oku_csv(kl, _sn_renk_dosyasi(kod, "kalan_featurelar.csv"), dosyalar)
            el = _sn_oku_csv(kl, _sn_renk_dosyasi(kod, "eleme_oncesi_featurelar.csv"), dosyalar)
            kaynak = dict(zip(el["feature"], el["kaynak"])) if el is not None and "kaynak" in el else {}
            feats = list(p.get("features") or (kf["feature"].tolist() if kf is not None else []))
            ek = kf.set_index("feature") if kf is not None and "feature" in kf else pd.DataFrame()
            sat = []
            for f in feats:
                r = ek.loc[f] if f in ek.index else {}
                sat.append({"kod": kod, "kl": kl, "seg": _seg_etiket(kod), "model": m["model"], "vade": m["vade"],
                            "f": f, "kaynak": kaynak.get(f), "shap": _sn_sayi(r.get("shap_pct", np.nan)),
                            "gain": _sn_sayi(r.get("feat_imp_gain_pct", np.nan)),
                            "tgt": _sn_sayi(r.get("tgt_assoc", np.nan)), "iv": _sn_sayi(r.get("iv", np.nan)),
                            "psi": _sn_sayi(r.get("psi", np.nan))})
            sat.sort(key=lambda x: -(x["shap"] if np.isfinite(x["shap"]) else -1))
            for i, x in enumerate(sat, start=1):
                x["sira"] = i
            secilen += sat
            # bucket tabloları
            for nb in SN_BUCKET_DEGERLERI:
                t, eks = _sn_bucket_oku(kl, _sn_renk_dosyasi(kod, f"bucket{nb}_train_val_oot.xlsx"), dosyalar)
                if t is None or t.empty:
                    uyari.append(f"{kl} renk {kod}: bucket{nb} dosyası yok ya da OOT satırı yok")
                    continue
                for k in eks:
                    eksik_kol[k] = eksik_kol.get(k, 0) + 1
                bucket[(nb, kod, kl)] = t
            # grafik
            yol = f"/{kl}/{SN_MODELRUN_KLASOR}/renk_{kod}_{_BD_RENK_AD.get(kod, kod)}/{SN_GRAFIK_DOSYA}"
            try:
                det = mf.get_path_details(yol) or {}
                if det.get("exists", True) and not det.get("directory"):
                    with mf.get_download_stream(yol) as s:
                        grafik[(kod, kl)] = s.read()
            except Exception:
                pass
    return modeller, secilen, bucket, grafik, eksik_kol, uyari


