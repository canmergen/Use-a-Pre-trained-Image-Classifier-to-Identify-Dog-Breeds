    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

/* Calisan adimin adi: DUZ_ADIMLAR sira -> adim eslemesinden */
function adimAdi() {
