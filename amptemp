def _ham_ad(kolon):
    """Ham kolonun Degiskenler'deki açıklaması (yoksa kolon adı)."""
    a = _HAM_ACIKLAMA.get(kolon)
    return f"{kolon} ({a})" if a else kolon


def _aciklama(ad):
    """(aile, açıklama, anlamı) ya da None."""
    if ad in _SABIT:
        aile, a, b = _SABIT[ad]
        return _AILE_ADI[aile], a, b

    # Pencere özetleri: <önek>_<AVG|STD|MIN|MAX|MED>_<pencere>
    m = re.match(r"^(RENK|DAV|MMS|KKB_SKOR|ODM|KK_LIMIT|KK_RISK|KK_LKO)_(AVG|STD|MIN|MAX|MED)_(L3M|L6M|L12M|L4_6M|L6_9M)$", ad)
    if m:
        on, ist, w = m.groups()
        dad, _, notu = _DEGISKEN[on]
        p_ad, p_ay = _PENCERE[w]
        return (_AILE_ADI[on], f"{p_ad} {p_ay} {_ISTAT[ist].format(ad=dad)}." + (f" {notu}" if notu else ""),
                _ozet_anlam(on, ist))

    m = re.match(r"^(RENK|DAV|MMS|KKB_SKOR|ODM|KK_LIMIT|KK_RISK|KK_LKO)_(TREND_3_46|TREND_6_712|TREND_6_79|DELTA_1_2)$", ad)
    if m:
        on, tip = m.groups()
        dad, yon, _ = _DEGISKEN[on]
        if tip == "TREND_3_46":
            a = f"Son 3 ay {dad} ortalaması eksi 4-6. aylar (L4M..L6M) ortalaması."
        elif tip == "TREND_6_712":
            a = f"Son 6 ay {dad} ortalaması eksi 7-12. aylar (L7M..L12M) ortalaması."
        elif tip == "TREND_6_79":
            a = f"Son 6 ay {dad} ortalaması eksi 7-9. aylar (L7M..L9M) ortalaması."
        else:
            a = f"Son ay (LM) {dad} eksi bir önceki ay (L2M) değeri."
        if on == "RENK":
            b = ("Pozitif = renk iyileşmiş (kaç basamak), negatif = kötüleşmiş." if tip == "DELTA_1_2"
                 else "Negatif = yakın dönemde renk kötüleşmiş, pozitif = iyileşmiş.")
        else:
            b = _yon_metni(yon)
        return _AILE_ADI[on], a, b

    m = re.match(r"^KK_(LIMIT|RISK|LKO)_(DELTA_PCT_LM_L2M|INC_LM_L2M_FLG|DEC_LM_L2M_FLG|LM_TO_AVG_L3M)$", ad)
    if m:
        on, tip = "KK_" + m.group(1), m.group(2)
        dad = _DEGISKEN[on][0]
        a = {"DELTA_PCT_LM_L2M": (f"(Son ay {dad} - L2M değeri) / L2M değeri; L2M 0 / boşsa -99.",
                                  "Son ayki oransal değişim."),
             "INC_LM_L2M_FLG": (f"Son ay (LM) {dad} bir önceki aydan (L2M) büyükse 1; iki aydan biri boşsa boş.",
                                "Son ayda arttı mı."),
             "DEC_LM_L2M_FLG": (f"Son ay (LM) {dad} bir önceki aydan (L2M) küçükse 1; iki aydan biri boşsa boş.",
                                "Son ayda azaldı mı."),
             "LM_TO_AVG_L3M": (f"Son ay (LM) {dad} / son 3 ay ortalaması; payda 0 / boşsa -99.",
                               "1 üstü = bugünkü değer son 3 ay ortalamasının üstünde.")}[tip]
        return _AILE_ADI[on], a[0], a[1]

    m = re.match(r"^KK_LKO_(LM|L\d{1,2}M)$", ad)
    if m:
        return (_AILE_ADI["KK_LKO"], f"{_bas(_ay_adi(m.group(1)))} kart kullanım oranı: kart bakiyesi / kart limiti "
                f"(KK_RISK_{m.group(1)} / KK_LIMIT_{m.group(1)}); limit 0 / boşsa boş.",
                "O ay limitin ne kadarı kullanılmış; 1 = limit dolu, 1 üstü = limit aşılmış.")

    m = re.match(r"^RENK_CNT_(.+)$", ad)
    if m and m.group(1) in _RENK_ADLARI:
        return (_AILE_ADI["RENK"], f"Son 12 ayda rengi {_RENK_ADLARI[m.group(1)]} olan ay sayısı.",
                "Müşterinin 12 ayının renk dağılımı.")

    if ad.startswith("RENK_Y_") and ad[7:] in _RENK_Y:
        a, b = _RENK_Y[ad[7:]]
        return _AILE_ADI["RENK_Y"], a, b

    m = re.match(r"^(DAV|MMS|KKB|ODM|KKU)_D_(.+)$", ad)
    if m:
        r = _seri_d(m.group(1), m.group(2))
        if r:
            return _AILE_ADI["D"], r[0], r[1]

    m = re.match(r"^ESZ_(KOTULESEN_SINYAL|OLCULEN_SINYAL|KOTULESEN_ORAN)_(3|6)M$", ad)
    if m:
        tip, n = m.groups()
        bas = f"Son ay (LM) ile L{n}M karşılaştırması"
        g = "renk, KKB, ödeme oranı, kart kullanımı, DAV, MMS"
        a = {"KOTULESEN_SINYAL": (f"{bas}: kötü yöne giden gösterge sayısı ({g}; 0-6); hiç gösterge ölçülemezse boş.",
                                  "Aynı anda kaç cephede bozulma var."),
             "OLCULEN_SINYAL": (f"{bas}: iki ayı da dolu olan gösterge sayısı.", "Bozulma sayımının kaç göstergeye dayandığı."),
             "KOTULESEN_ORAN": (f"ESZ_KOTULESEN_SINYAL_{n}M / ESZ_OLCULEN_SINYAL_{n}M.",
                                "Ölçülen göstergelerin ne kadarı bozuldu (0-1).")}[tip]
        return _AILE_ADI["ESZ"], a[0], a[1]
    m = re.match(r"^ESZ_([A-Z]+)_([A-Z]+)_KOTU_3M$", ad)
    if m and m.group(1) in _ESZ_GOSTERGE and m.group(2) in _ESZ_GOSTERGE:
        x, y = _ESZ_GOSTERGE[m.group(1)], _ESZ_GOSTERGE[m.group(2)]
        return (_AILE_ADI["ESZ"], f"{_bas(x)} ve {y} son ay (LM) ile L3M arasında ikisi birlikte kötüleştiyse 1, "
                "değilse 0; biri ölçülemezse boş.", f"İki sinyalin aynı anda bozulması ({x} + {y}).")

    m = re.match(r"^GIZLI_(KOTULESEN_SINYAL|KOTULESME_FLG|KOTULESME_GORELI)_(3|6)M$", ad)
    if m:
        tip, n = m.groups()
        on = f"Renk son ay (LM) ile L{n}M arasında kötüleşmemişken"
        son = " Renk kötüleştiyse 0, renk ölçülemezse boş."
        g5 = "diğer 5 göstergeden (KKB, ödeme oranı, kart kullanımı, DAV, MMS)"
        a = {"KOTULESEN_SINYAL": (f"{on} {g5} kötüleşenlerin sayısı." + son,
                                  "Renk iyi görünürken alttan gelen bozulma; renk düşüşünden önceki uyarı."),
             "KOTULESME_FLG": (f"{on} {g5} en az biri kötüleştiyse 1." + son, "Gizli bozulma var mı."),
             "KOTULESME_GORELI": (f"{on} {g5} kötüleşenlerin göreli değişimleri toplamı: |LM - L{n}M| / |L{n}M|." + son,
                                  "Gizli bozulmanın büyüklüğü; sayımdan farklı olarak bozulmanın ne kadar sert olduğunu "
                                  "da gösterir.")}[tip]
        return _AILE_ADI["GIZLI"], a[0], a[1]

    m = re.match(r"^(INT_.+)_INTD_(LM|L3M|L6M|L9M|L12M)_(L3M|L6M|L9M|L12M)$", ad)
    if m:
        aile, y, u = m.groups()
        ia = _INT_AILE_ACIKLAMA.get(aile)
        ne = f"{aile} ({ia})" if ia else aile
        return (_AILE_ADI["INT"], f"{ne}: {_PENCERE_ADI[y]} penceresi değeri / {_PENCERE_ADI[u]} penceresi değeri "
                f"({aile}_{y} / {aile}_{u}); payda 0 veya altı / boşsa boş.",
                "Pencereler kümülatifse: 1'e yakın = hareketin çoğu yakın dönemde; 0'a yakın = yakın dönemde hareket yok.")
    m = re.match(r"^(INT_.+)_INTD_DURDU_FLG$", ad)
    if m:
        aile = m.group(1)
        ia = _INT_AILE_ACIKLAMA.get(aile)
        ne = f"{aile} ({ia})" if ia else aile
        return (_AILE_ADI["INT"], f"{ne}: en yakın pencere 0 ve daha uzak pencerelerden en az biri 0'dan büyükse 1; "
                "ölçülemezse boş.", "Önceden olan aktivite son dönemde durdu.")

    m = re.match(r"^KK_O_(KULLANIM_(80|90|100)_USTU_ADET_(12|3)M|AY_SON_KULLANIM_(80|90|100)_USTU|KULLANIM_(80|90|100)_USTU_SERI)$", ad)
    if m:
        esik = _KK_ESIK[m.group(2) or m.group(4) or m.group(5)]
        if m.group(2):
            n = m.group(3)
            return (_AILE_ADI["KK_O"], f"Son {n} ayda kart kullanımının (bakiye / limit) {esik} ve üstünde olduğu ay sayısı.",
                    "Limite ne sık dayanıyor." if n == "12" else "Yakın dönemde limite dayanma.")
        if m.group(4):
            return (_AILE_ADI["KK_O"], f"Kart kullanımının {esik} ve üstünde olduğu en yeni ay. " + _AY_NOTU,
                    "Ne kadar önce eşik üstündeydi.")
        return (_AILE_ADI["KK_O"], f"Son aydan (LM) geriye kesintisiz kart kullanımı {esik} ve üstü olan ay sayısı.",
                "Kaç aydır limite dayalı.")

    m = re.match(r"^OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_(3|6|12)M$", ad)
    if m:
        return (_AILE_ADI["OK"], f"Son {m.group(1)} ayda \"borç sarmalı\" ayı sayısı (aynı ayda ödeme oranı < %20 ve "
                "kart kullanımı >= 0.8).", "Az ödeyip limite dayanma sıklığı.")

    m = re.match(r"^YB_(.+)_(YENI|TEKRAR)$", ad)
    if m and m.group(1) in _YB_OLAY:
        olay = _YB_OLAY[m.group(1)]
        if m.group(2) == "YENI":
            return (_AILE_ADI["YB"], f"Olay: {olay}. Olay son 3 ayda (LM..L3M) var, L4M..L12M'de hiç yoksa 1, değilse 0. "
                    + _YB_NAN, "Olay müşteri için yeni mi başladı (ilk kez).")
        return (_AILE_ADI["YB"], f"Olay: {olay}. Olay hem son 3 ayda (LM..L3M) hem L4M..L12M'de varsa 1, değilse 0. "
                + _YB_NAN, "Olay müşteride daha önce de görülmüş (tekrar).")
    m = re.match(r"^YB_(.+)_YENI_DIP$", ad)
    if m and m.group(1) in _YB_DIP:
        s, kotu = _YB_DIP[m.group(1)]
        return (_AILE_ADI["YB"], f"Son ay (LM) {s} değeri önceki 11 ayın en kötü ({kotu}) değerinden de kötüyse 1; "
                "önceki ayların en az 3'ü dolu olmalı.", "Gösterge müşteri için yeni bir dip yaptı.")

    m = re.match(r"^OG_(KKB|ODM|KKU|DAV|MMS)_(ONCE_BOZULMA_ADET|ONCU_AY|DESEN_TEKRARI)$", ad)
    if m:
        s = _OG_SERI[m.group(1)]
        nan = " Renk 12 ayda hiç kötüleşmediyse boş."
        a = {"ONCE_BOZULMA_ADET": (f"Müşterinin en son renk kötüleşmesinden önceki 3 aylık geçişte {s} değerinin kötü yöne "
                                   "gittiği geçiş sayısı (0-3)." + nan,
                                   "Renk düşmeden önce bu gösterge uyarı vermiş mi; 3 = her ay uyarmış."),
             "ONCU_AY": (f"Son renk düşüşüne en yakın {s} bozulması kaç geçiş önceydi (1-3); bozulma yoksa boş." + nan,
                         "Gösterge renkten kaç ay önce sinyal veriyor."),
             "DESEN_TEKRARI": (f"OG_{m.group(1)}_ONCE_BOZULMA_ADET > 0, son 2 geçişte {s} yine kötü yöne gitti ve renk son 2 "
                               "geçişte kötüleşmedi ise 1." + nan,
                               "Geçen sefer renk düşüşünden önce görülen sinyal şimdi yine var, ama renk henüz düşmedi.")}[m.group(2)]
        return _AILE_ADI["OG"], a[0], a[1]

    m = re.match(r"^DS_EXPECTED_LOSS_(KK_RISK|KK_LIMIT|TAUM)_ORAN$", ad)
    if m:
        return (_AILE_ADI["DS"], f"{_ham_ad('EXPECTED_LOSS')} / {_DS_PAYDA[m.group(1)]}; payda 0 veya altı / boşsa boş.",
                "Beklenen kaybın borca / limite / varlığa oranı.")
    m = re.match(r"^DS_(.+)_X_(RENK_LM|NUKS|ARTARDA_KOT|DUSUS|RISK_SERI|GIZLI_3M|ESZ_3M)$", ad)
    if m:
        skor, k = m.groups()
        if k == "RENK_LM":
            anlam = ("Hazır skoru son ay renk koduyla tek değerde birleştirir; aynı skorda renk kodu küçükse "
                     "(kötü renk) değer de küçük.")
        else:
            anlam = ("Hazır skoru müşterinin renk yolu durumuyla birleştirir; bayrak / sayaç 0 ise değer 0, "
                     "sayaç büyüdükçe skorun ağırlığı artar.")
        return _AILE_ADI["DS"], f"Hazır skor {_ham_ad(skor)} x {_DS_CARPAN[k]}.", anlam

    m = re.match(r"^DSN_(RENK3|RENK_HAREKET5|KKU3|ODM3|RENK_KKU_ODM_LM)_(KOT_ORAN|PAY)$", ad)
    if m:
        d, tip = m.groups()
        if tip == "KOT_ORAN":
            return (_AILE_ADI["DSN"], f"Pipeline'da üretilir. Müşterinin bugünkü deseni: {_DSN_DESEN[d]}. Değer: train'de aynı "
                    "desende olan müşterilerin rengi bir sonraki ay kötüleşen payı (LM rengi L2M'den kötü); 100'den az "
                    "müşterili desenler tek bir \"nadir\" grupta birleşir. Hedef (TARGET) kullanılmaz.",
                    "Yüksek = bu desen genelde renk düşüşüyle devam ediyor.")
        return (_AILE_ADI["DSN"], f"Pipeline'da üretilir. Müşterinin bugünkü deseninin ({_DSN_DESEN[d]}) train tablosundaki payı: "
                "desendeki müşteri / tablodaki tüm müşteri; train'de görülmemiş desen 0.",
                "Desen ne kadar yaygın; küçük pay = aynı desenin KOT_ORAN değeri az gözleme dayanır.")
    return None


