    R0, RS, C = _st_tablo(ws, S, r, _ST_K_DEG, _ST_G_DEG, _ST_T_DEG, "Stabilite_Degisken",
                          [("seg", N_RENK, 3), ("modelde", 2, 2), ("durum", 3, 3)])
    _st_esik_renk(ws, C, [f"psi_{d}" for d in _ST_KARS], R0, RS)
    r = RS + 3
    S.baslik(r, "2) Modele giren değişkenler: her dönemde boş oranı, min, P5, medyan, ortalama, P95, max", c2=son_oz)
    r += 2
    R0, RS, C = _st_tablo(ws, S, r, _ST_K_OZET, _ST_G_OZET, _ST_T_OZET, "Stabilite_Dagilim",
                          [("seg", N_RENK, 3), ("donem", len(_ST_DON), 3)])
    _st_esik_renk(ws, C, ["psi"], R0, RS)
    r = RS + 3
    S.baslik(r, "3) Modeller: skor PSI ve HHI", c2=son_mod)
    r += 2
    R0, RS, C = _st_tablo(ws, S, r, _ST_K_MOD, _ST_G_MOD, _ST_T_MOD, "Stabilite_Model",
                          [("seg", N_RENK, 2), ("model", 2, 1), ("vade", 3, 2), ("durum", 3, 2)])
    _st_esik_renk(ws, C, [f"psi_{d}" for d in _ST_KARS], R0, RS)
    _yazdir(ws)
    return ws


