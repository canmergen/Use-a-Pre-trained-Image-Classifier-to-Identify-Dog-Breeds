def _fk_bolum1(d, h):
    """Bir model x FPD hedefi için bölüm 1 satırı (d: modelin OOT müşterileri + FPD kolonları)."""
    esl = d[h].notna()
    y = d.loc[esl, h].to_numpy(dtype="float64")
    fe, fv = int(esl.sum()), float(y.sum()) if esl.any() else 0.0
    top = (d["GRUP"] <= _FK_UST).to_numpy()
    az = min(fv, fe - fv) < FK_MIN_VAKA
    hb = d["HDF"].notna()
    hv = float(d.loc[hb, "HDF"].sum())
    sat = {"n": len(d), "fe": fe, "fep": fe / len(d) if len(d) else np.nan, "fv": fv,
           "fo": fv / fe if fe else np.nan,
           "mg": _fk_gini(d.loc[hb, "HDF"], d.loc[hb, "SKOR"]),
           "my": float(d.loc[hb & top, "HDF"].sum()) / hv if hv > 0 else np.nan,
           "fg": np.nan, "fy": np.nan, "fo20": np.nan, "lift": np.nan}
    if not az:
        e_top = top[esl.to_numpy()]
        sat["fg"] = _fk_gini(y, d.loc[esl, "SKOR"])
        sat["fy"] = float(y[e_top].sum()) / fv
        sat["fo20"] = float(y[e_top].mean()) if e_top.any() else np.nan
        sat["lift"] = sat["fo20"] / sat["fo"] if sat["fo"] else np.nan
    g = d.loc[esl, "GRUP"].to_numpy()
    for i in range(1, FK_N_GRUP + 1):
        m = g == i
        sat[f"b{i}"] = float(y[m].mean()) if m.any() else np.nan
    return sat


def _fk_bolum2(dm, ycol):
    """Bir model x hedef için bölüm 2 satırı (dm: ortak kitle; ycol: hedef kolonu)."""
    dm = dm[dm[ycol].notna()]
    y = dm[ycol].to_numpy(dtype="float64")
    n, v = len(y), float(y.sum())
    sat = {"n": n, "v": v, "o": v / n if n else np.nan}
    if n == 0:
        return sat
    s_m, s_f = dm["SKOR"].to_numpy(dtype="float64"), dm["FSKOR"].to_numpy(dtype="float64")
    az = min(v, n - v) < FK_MIN_VAKA
    mr, fr = _fk_grupla(s_m) <= _FK_UST, _fk_grupla(s_f) <= _FK_UST
    if not az:
        sat.update(gm=_fk_gini(y, s_m), gf=_fk_gini(y, s_f))
        sat["gfark"] = sat["gm"] - sat["gf"]
        sat["ym"], sat["yf"] = float(y[mr].sum()) / v, float(y[fr].sum()) / v
    sm, sf, ir, it = mr & ~fr, fr & ~mr, mr & fr, ~mr & ~fr
    o = (lambda m: float(y[m].mean()) if m.any() else np.nan)
    sat.update(sm_n=int(sm.sum()), sm_o=o(sm), sf_n=int(sf.sum()), sf_o=o(sf), ir_n=int(ir.sum()), ir_o=o(ir),
               it_o=o(it), ort=float(ir.sum()) / float(fr.sum()) if fr.any() else np.nan,
               net=float(y[sm].sum() - y[sf].sum()))
    fark = sat["sm_o"] - sat["sf_o"]
    sat["sonuc"] = ("Vaka yok" if v == 0 else "Fark yok" if not np.isfinite(fark) or abs(fark) < FK_BERABER_PUAN
                    else "Model daha isabetli" if fark > 0 else "FPD skoru daha isabetli")
    sat["az"] = az
    return sat


def _fk_hukum(sat):
    if sat.get("az", True) or not np.isfinite(sat.get("gfark", np.nan)):
        return "YETERSİZ VAKA"
    return ("MODEL GEREKLİ" if sat["gfark"] >= FK_GEREKLI_PUAN else "SINIRDA" if sat["gfark"] > 0 else "FPD SKORU YETER")


