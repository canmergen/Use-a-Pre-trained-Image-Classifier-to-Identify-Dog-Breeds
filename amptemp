:root {
  /* ===== YAZI OLCEGI - tum arayuz yalnizca bu degerleri kullanir =====
     Tek font: Calibri (urun adindaki font).
     Olcek, onceki tasarimin %80 zoom halidir; ama tarayici zoom'u
     boyutlari kuruslu yapar (14px -> 11.2px) ve Calibri Windows'ta
     kuruslu boyutta bulanik cizilir. Bu yuzden TUM boyutlar tam piksel.
     Yeni bir boyut eklersen de tam piksel ver.
     Calibri'de yalnizca 3 agirlik var: 300 (Light), 400 (Regular),
     700 (Bold). Bu yuzden yalnizca --fw-normal ve --fw-kalin kullanilir.
     Buyuk harf CSS ile DEGIL, HTML/Python'da yazilir (Turkce I/İ). */
  --fs-kucuk:  11px;     /* faz no, sayac, durum cipi */
  --fs-etiket: 12px;     /* BUYUK HARFLI kirmizi etiketler: ANALİTİK SÜREÇ, VERİ SETİ... */
  --fs-govde:  12px;     /* metin, butonlar */
  --fs-baslik: 13px;     /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  15px;     /* urun adi, sayfa basligi */

  --fw-normal: 400;
  --fw-kalin:  700;

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  /* Buyuk harf araligi: az tutuldu, Calibri'nin dar buyuk harfleri
     acildikca seyrek ve farkli bir font gibi gorunuyor */
  --etiket-aralik: .02em;

  /* ===== BILESEN SISTEMI - kose, bosluk, yukseklik, golge ===== */
  --r:         6px;      /* kart, balon, buton, giris kutusu */
  --r-kucuk:   5px;      /* sekme, cip, liste ogesi, ic alan */
  --b-1: 3px;  --b-2: 6px;  --b-3: 10px;  --b-4: 13px;  --b-5: 16px;  --b-6: 19px;
  --btn-h:     29px;     /* tum ana butonlar */
  --btn-h-kucuk: 24px;   /* ikon butonlari, Gonder */
  --serit:     3px;      /* kart solundaki marka vurgu cubugu */
  --halka:     2px;      /* odak ve hover halkasi kalinligi */
  --golge-1:   0 1px 2px rgba(16,24,40,.06);
  --golge-2:   0 5px 13px rgba(16,24,40,.10);

  /* ===== RENK - zemin notr, kirmizi yalnizca vurgu ===== */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-acik: #FDF1F1;
  --kirmizi-halka: rgba(213,17,21,.16);

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #F9FAFB;
  --kenar:        #DDE1E6;          /* kart, balon, form kenarlari */
  --kenar-guclu:  #BFC5CE;
  --kenar-acik:   #EDEFF2;
  /* Yalnizca 3 yapisal ayrac: ust bar alti, sol panel sagi, sag panel solu.
     Notr (mavimsi degil) ve saydam: hangi zeminde olursa olsun hafif kalir. */
  --ayrac:        rgba(0,0,0,.08);

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.66);

  --user-zemin:   #EEF0F3;          /* kullanici balonu: bot'tan ayrissin */

  --gonder-zemin: #111111;
  --gonder-metin: #FFFFFF;

  /* ===== SOHBET ARKA PLANI =====
     Gorsel JS'ten gelir. Uzerinde zemin renginde bir perde var.
     --sohbet-perde-gucu:    acilistaki perde. 0 = gorsel tamamen gorunur,
                             1 = gorsel hic gorunmez
     --sohbet-perde-calisma: sohbet basladiktan sonraki (en az 2 mesaj) perde.
                             Acilista gorsel belirgin, calisirken sakin kalir.
                             Hep ayni kalsin istersen --sohbet-perde-gucu ile
                             ayni degeri ver.
     --sohbet-bulanik:       0px = bulaniklik yok; 4px, 8px... arttikca bulanir */
  --sohbet-gorsel: none;
  --sohbet-perde-gucu:    .42;
  --sohbet-perde-calisma: .8;
  --sohbet-bulanik:       13px;

  --yesil:        #0E8A52;
  --yesil-acik:   #E6F4EC;
  --amber:        #B45309;
  --amber-acik:   #FEF3C7;
  --amber-halka:  rgba(217,119,6,.30);
  --sari:         #EAB308;
  --sari-koyu:    #000000;          /* sari zemin ustundeki metin rengi */
  --sari-acik:    #FDF6D3;

  /* Sol panel: dar ekranda 208px, genis ekranda en fazla 264px */
  --panel-en:   clamp(208px, 19vw, 264px);
  /* Sag panel: dar ekranda 304px, genis ekranda en fazla 432px */
  --analiz-en:  clamp(304px, 29vw, 432px);
  --avatar:     24px;
  --girinti:    32px;              /* avatar (24px) + bosluk (8px) */
  --ustbar-h:   70px;             /* ust bar yuksekligi; logo buna gore olceklenir */
  --sohbet-yan: 19px;

  /* LLM balonu icin UST SINIR. Icerik kisaysa daha dar kalir. */
  --balon-en:     min(calc(100% - var(--girinti)), 42rem);
  /* Secenek karti tasiyan balonun ALT SINIRI - kartlar ezilmesin */
  --secenekli-en: min(calc(100% - var(--girinti)), 24rem);
  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami */
  --govde-en:     calc(100% - var(--girinti));
}

/* -------- KOYU TEMA -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #E03B3E;
  --kirmizi-acik: #2A1517;
  --kirmizi-halka: rgba(255,77,79,.22);

  --zemin:        #111111;
  --yuzey:        #181818;
  --yuzey-alt:    #141414;
  --kenar:        #2E2E2E;
  --kenar-guclu:  #454545;
  --kenar-acik:   #232323;
  --ayrac:        rgba(255,255,255,.10);

  --metin:        #FFFFFF;
  --metin-soluk:  rgba(255,255,255,.68);

  --user-zemin:   #262626;

  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;

  --golge-1:   0 1px 2px rgba(0,0,0,.5);
  --golge-2:   0 5px 13px rgba(0,0,0,.55);

  --yesil:        #3DDC8A;
  --yesil-acik:   #10281B;
  --amber:        #F5B042;
  --amber-acik:   #2A2210;
  /* Koyu zeminde uyari halkasi acik temadaki degerle neredeyse gorunmezdi */
  --amber-halka:  rgba(245,176,66,.42);
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: var(--font);
  font-size: var(--fs-govde);
  font-weight: var(--fw-normal);
  line-height: 1.5;
  /* Rakamlar: satir hizasinda (lining) ve esit genislikte (tabular) */
  font-variant-numeric: lining-nums tabular-nums;
  text-rendering: optimizeLegibility;
  transition: background .2s, color .2s;
}
#kabuk *, #kabuk button, #kabuk input, #kabuk textarea {
  font-family: var(--font);
}
[hidden] { display: none !important; }

/* Sayfa basligi: ÇALIŞMA ÖZETİ - urun adiyla ayni boyut, ortali */
#ozet-h1 {
  font-size: var(--fs-buyuk); font-weight: var(--fw-kalin);
  letter-spacing: .03em; line-height: 1.3;
  color: var(--kirmizi); text-align: center;
}

/* Kirmizi etiketler: ANALİTİK SÜREÇ, İŞ AKIŞI, VERİ SETİ, SÖZLÜK...,
   ozet sayfasi kart basliklari. Urun adiyla ayni font, agirlik ve renk.
   Renk dogrudan --kirmizi: koyu temada otomatik acik kirmiziya doner.
   Hizalamayi bulunduklari kutu belirler. */
.panel-baslik, .ozet-etiket, .ozet-blok-baslik {
  font-size: var(--fs-etiket); font-weight: var(--fw-kalin);
  letter-spacing: var(--etiket-aralik); line-height: 1.3;
  color: var(--kirmizi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(11px, 1.6vw, 21px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--ayrac); flex-shrink: 0;
  gap: clamp(11px, 1.6vw, 22px);
}
#ustbar-sol { display: flex; align-items: center; gap: var(--b-4); flex-shrink: 0; }
#banner { height: calc(var(--ustbar-h) - 19px); width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: var(--b-4); line-height: 1.3; }
#urun-adi {
  font-weight: var(--fw-kalin); font-size: var(--fs-buyuk); letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt {
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  margin-top: 2px; white-space: nowrap;
}

#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(8px, 1.2vw, 16px);
  border-right: 1px solid var(--kenar-acik);
  line-height: 1.3;               /* 4 satir 70px bara rahat sigsin */
  text-align: center;             /* etiket ve icerik kendi bolmesinde ortali */
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket { display: block; margin-bottom: 2px; }
.ozet-deger {
  display: block;
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--metin-soluk); }
.ozet-ust, .ozet-alt {
  display: block; font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 5px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: var(--b-2); }

#tema-btn, #sifirla-btn, .cekmece-btn {
  display: flex; align-items: center; justify-content: center;
  width: 22px; height: 22px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: var(--r-kucuk); cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn svg, #sifirla-btn svg, .cekmece-btn svg { width: 12px; height: 12px; }
#tema-btn:hover, #sifirla-btn:hover, .cekmece-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
/* Çekmece düğmeleri yalnızca panelin gizlendiği dar ekranlarda görünür */
.cekmece-btn { display: none; }

#durum-rozet {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--yesil); display: inline-block; flex-shrink: 0;
}
/* Rozet son isteğin sonucunu gösterir: backend cevap vermiyorsa yeşil kalmaz */
#durum-rozet.mesgul .nokta-yesil { background: var(--sari); }
#durum-rozet.hata   .nokta-yesil { background: var(--kirmizi); }
#durum-rozet.hata { color: var(--kirmizi); }

#sekmeler {
  display: flex; gap: 2px; padding: 2px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: var(--r);
}
.sekme {
  flex: 1; height: 22px; padding: 0 var(--b-5);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: var(--etiket-aralik);
  border: none; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif { background: var(--kirmizi); color: #fff; }

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none !important; }   /* #sayfa-calisma'nin display:flex'ini ezer */
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--ayrac);
  padding: var(--b-5) var(--b-4) 22px; overflow-y: auto;
}

.panel-blok { margin-bottom: var(--b-6); }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik { margin-bottom: var(--b-3); }
.panel-metin {
  margin: 0 0 var(--b-3); font-size: var(--fs-govde); line-height: 1.6; color: var(--metin);
  text-indent: 0;                 /* paragraf basi girintisi yok; istersen 1.5em */
}
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı -------- */
.faz { margin-bottom: 2px; }
/* baseline: ok, numara, ad ve sayac ayni yazi cizgisine oturur */
/* <button>: klavye kullanicisi de fazi acabilsin (Enter/Space dogal) */
.faz-bas {
  position: relative; overflow: hidden;
  display: flex; align-items: baseline; gap: var(--b-2);
  padding: var(--b-2); border-radius: var(--r); cursor: pointer;
  color: var(--metin);
  width: 100%; border: none; background: none; text-align: left;
  font-family: inherit; font-size: var(--fs-govde); line-height: 1.5;
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz-bas:focus-visible {
  outline: none; background: var(--kenar-acik);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
/* Aktif faz: notr zemin + solda duz kirmizi cubuk. Sari yalnizca
   adim isaretinde "devam ediyor" durumu olarak kalir. */
.faz.aktif > .faz-bas { background: var(--kenar-acik); color: var(--metin); }
.faz.aktif > .faz-bas::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 8px; text-align: center;
  font-size: var(--fs-govde); transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; min-width: 1.4em;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  color: inherit;                 /* fazin metin rengini alir: siyah / tamamlaninca yesil */
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); line-height: 1.35; color: inherit; }
.faz-ozet {
  font-size: var(--fs-govde); color: inherit; opacity: .72;
  margin-top: 2px; line-height: 1.45;
}
.faz-durum {
  flex-shrink: 0; font-size: var(--fs-kucuk);
  font-weight: var(--fw-kalin); cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 2px 0 var(--b-2) var(--b-3); padding: 0 0 0 var(--b-5);
  display: none; border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: var(--b-2);
  padding: 4px 5px; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 11px; height: 11px;
  border: 1px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 8px; font-weight: var(--fw-kalin);
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: var(--fw-kalin); }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 var(--halka) var(--sari-acik);
}

/* ==================== ORTA: ÇALIŞMA ALANI ==================== */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--zemin);
  opacity: var(--sohbet-perde-gucu);
  backdrop-filter: blur(var(--sohbet-bulanik));
  pointer-events: none;
  transition: opacity .5s ease;
}
/* Sohbet basladiginda (en az iki mesaj satiri) perde koyulasir.
   JS gerekmez; satirlar eklenince tarayici kendisi uygular. */
#sohbet-alani:has(.satir ~ .satir)::before {
  opacity: max(var(--sohbet-perde-gucu), var(--sohbet-perde-calisma));
}
#sohbet, #giris-bolge { position: relative; z-index: 1; }

/* Kaydirma YALNIZCA burada */
#sohbet {
  flex: 1; overflow-y: auto;
  padding: var(--b-6) var(--sohbet-yan) var(--b-4);
  scrollbar-gutter: stable;
}

.satir {
  display: flex; align-items: flex-start; gap: 8px;
  margin: 0 0 var(--b-4);
  width: 100%; min-width: 0;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: var(--yuzey); object-fit: cover;
  border: 1px solid var(--kenar);
}

/* Balon metni kadar uzar; yukseklik siniri ve ic kaydirma YOK */
.balon {
  min-width: 0; width: fit-content;
  padding: var(--b-3) var(--b-4); border-radius: var(--r);
  font-size: var(--fs-govde); line-height: 1.6;
  white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;
}

/* -------- Bot kutusu: balon + (varsa) seçenek kartları -------- */
.balon-sutun {
  display: flex; flex-direction: column; align-items: stretch;
  flex: 0 1 auto; width: fit-content;
  max-width: var(--balon-en); min-width: 0;
}
.balon-sutun.secenekli { min-width: var(--secenekli-en); }

/* Bot: notr yuzey, marka yalnizca solda duz ince cubukta.
   Cubuk ayri ciziliyor; kenar yuvarlakligini takip edip kivrilmiyor. */
.satir.bot .balon {
  position: relative; overflow: hidden;
  width: auto; max-width: 100%;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  padding-left: calc(var(--b-4) + var(--serit));
  box-shadow: var(--golge-1);
}
.satir.bot .balon::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
/* Secenek tasiyan balonda cubuk yok: kirmizi vurgu yalnizca
   tiklanabilir kartlarda kalir, bilgi metni ile secenekler ayrisir. */
.satir.bot .balon-sutun.secenekli .balon { padding-left: var(--b-4); }
.satir.bot .balon-sutun.secenekli .balon::before { display: none; }
.satir.bot .balon strong { font-weight: var(--fw-kalin); }

.satir.kullanici .balon {
  max-width: min(75%, calc(100% - var(--girinti)));
  background: var(--user-zemin); color: var(--metin);
  border: 1px solid transparent;
}

.satir.bot .balon.hata {
  background: var(--kirmizi-acik); color: var(--kirmizi);
  border-color: var(--kirmizi);
}

/* -------- Seçenek kartları -------- */
.secenek-kok { display: flex; flex-direction: column; gap: var(--b-2); }
.balon-sutun .secenek-kok { width: 0; min-width: 100%; margin-top: var(--b-2); }
#sohbet > .secenek-kok {
  margin: 0 0 var(--b-4) var(--girinti);
  width: fit-content; max-width: var(--balon-en);
}

.secenek {
  position: relative; overflow: hidden;
  display: flex; align-items: center; gap: var(--b-3);
  padding: var(--b-3) var(--b-4) var(--b-3) calc(var(--b-4) + var(--serit));
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  cursor: pointer; text-align: left;
  font-size: var(--fs-govde);
  box-shadow: var(--golge-1);
  transition: border-color .15s, background .15s, box-shadow .15s, opacity .15s;
}
/* Tiklanabilir kart vurgusu: duz cubuk */
.secenek::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
.secenek:hover:not(:disabled) {
  border-color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.secenek:disabled { cursor: default; opacity: .45; }
.secenek.secili {
  opacity: 1; background: var(--kirmizi-acik);
  border-color: var(--kirmizi);
}

.secenek-rozet {
  flex-shrink: 0; width: 22px; height: 22px;
  background: var(--zemin); color: var(--metin);
  border: 1px solid var(--kenar); border-radius: 50%;
  font-weight: var(--fw-kalin); font-size: var(--fs-govde);
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s, border-color .15s;
}
.secenek:hover:not(:disabled) .secenek-rozet,
.secenek.secili .secenek-rozet {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.secenek-govde { min-width: 0; flex: 1; }
.secenek-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); line-height: 1.35; }
.secenek-aciklama {
  font-size: var(--fs-govde); color: var(--metin-soluk);
  line-height: 1.5; margin-top: 2px;
}

/* -------- Seçim formu: dataset seçici -------- */
.secim-kart {
  position: relative;
  width: var(--balon-en); margin: 0 0 var(--b-4) var(--girinti);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  padding: var(--b-4) var(--b-5) var(--b-5) calc(var(--b-5) + var(--serit));
  box-shadow: var(--golge-1);
}
/* overflow:hidden YOK - acilir liste kartin disina tasabilmeli.
   Cubugun koseleri bu yuzden kendi yuvarlakligiyla kirpiliyor. */
.secim-kart::before {
  content: ""; position: absolute; left: -1px; top: -1px; bottom: -1px;
  width: var(--serit); background: var(--kirmizi);
  border-radius: var(--r) 0 0 var(--r);
}
.secim-kart.kilitli { opacity: .7; }

.secim-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); margin-bottom: 2px; }
.secim-aciklama {
  font-size: var(--fs-govde); line-height: 1.6;
  margin-bottom: var(--b-4); color: var(--metin-soluk);
}

.secim-govde { display: flex; gap: var(--b-3); flex-wrap: wrap; margin-bottom: var(--b-4); }
.secim-govde .combo { flex: 1; min-width: 160px; }

.secim-satir { display: flex; gap: var(--b-2); align-items: flex-end; margin-bottom: var(--b-3); }
.secim-satir .combo { flex: 1; }

.combo { position: relative; }
.combo label {
  display: block; font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  margin-bottom: var(--b-1); color: var(--metin);
}
.combo-giris {
  width: 100%; height: var(--btn-h); padding: 0 var(--b-3);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde);
  outline: none; background: var(--yuzey); color: var(--metin);
  transition: border-color .15s, box-shadow .15s;
}
.combo-giris::placeholder { color: var(--metin-soluk); }
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }
.combo-giris:disabled { background: var(--yuzey-alt); color: var(--metin-soluk); }

/* Listeyi acan ok dugmesi. Liste artik odaklaninca kendiliginden
   acilmiyor; gorunur tek acma yolu bu (klavye: ArrowDown). */
.combo { position: relative; }
.combo-ok {
  position: absolute; right: 1px; bottom: 1px;
  width: calc(var(--btn-h) - 2px); height: calc(var(--btn-h) - 2px);
  display: flex; align-items: center; justify-content: center;
  padding: 0; border: none; background: none; cursor: pointer;
  color: var(--metin-soluk); border-radius: var(--r-kucuk);
}
.combo-ok:hover { color: var(--kirmizi); background: var(--kirmizi-acik); }
.combo-ok svg { transition: transform .15s; }
.combo:has(.combo-liste.acik) .combo-ok svg { transform: rotate(180deg); }
.combo:has(.combo-liste.acik) .combo-ok { color: var(--kirmizi); }
/* Ok dugmesi metnin ustune binmesin */
.combo-giris { padding-right: var(--btn-h); }
.combo-giris:disabled ~ .combo-ok { display: none; }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: var(--b-1) 0 0; padding: var(--b-1); list-style: none;
  background: var(--yuzey); border: 1px solid var(--kenar);
  border-radius: var(--r); box-shadow: var(--golge-2);
  max-height: 208px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
/* Sohbet alani kaydirilabilir oldugu icin kart hep en altta kalir;
   asagi sigmayan liste YUKARI acilir (JS olcup .yukari ekler). */
.combo-liste.yukari {
  top: auto; bottom: 100%;
  margin: 0 0 var(--b-1);
}
.combo-liste li {
  padding: 5px 8px; border-radius: var(--r-kucuk); cursor: pointer;
  font-size: var(--fs-govde); color: var(--metin);
}
.combo-liste li:hover,
.combo-liste li.vurgu { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; color: var(--metin-soluk); }
.combo-liste li.bos:hover { background: none; color: var(--metin-soluk); }

.secim-yuvarlak {
  flex-shrink: 0; width: var(--btn-h); height: var(--btn-h); padding: 0;
  border-radius: var(--r-kucuk); cursor: pointer;
  font-size: 15px; font-weight: var(--fw-kalin); line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.secim-yuvarlak:disabled { opacity: .4; cursor: not-allowed; }

.secim-yuvarlak.ekle { background: var(--kirmizi); color: #fff; border: none; }
.secim-yuvarlak.ekle:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.secim-yuvarlak.sil {
  width: 20px; height: 20px; font-size: 12px;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
}
.secim-yuvarlak.sil:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}

.secim-rozetler { display: flex; flex-direction: column; gap: 5px; margin-bottom: var(--b-4); }
/* Uzun veri seti adi rozeti tasirip "−" butonunu ekran disina itmesin */
.secim-rozet {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); padding: 4px 5px 4px var(--b-3);
  font-size: var(--fs-govde);
  min-width: 0; max-width: 100%;
}
.secim-rozet > span {
  min-width: 0; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.secim-onay {
  height: var(--btn-h); padding: 0 var(--b-6);
  background: var(--kirmizi); color: #fff;
  border: none; border-radius: var(--r);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  cursor: pointer; white-space: nowrap;
}
.secim-onay:hover:not(:disabled) { background: var(--kirmizi-koyu); }
.secim-onay:disabled {
  background: var(--kenar-acik); color: var(--metin-soluk); cursor: not-allowed;
}
/* Ikincil (vazgec) dugmesi: onay kartinda kirmizinin yaninda notr durur */
.secim-onay.ikincil {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.secim-onay.ikincil:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}
.onay-dugmeler { display: flex; gap: var(--b-2); flex-wrap: wrap; }

/* -------- Aksiyon izi -------- */
/* "Onayla ve Uygula" gibi buton aksiyonlari sohbete KULLANICI BALONU
   basmaz; ince bir ayrac uzerinde sessiz bir iz birakir. Balon degildir:
   avatar, zemin ve kenar yok. */
.aksiyon-izi {
  display: flex; align-items: center; gap: var(--b-3);
  margin: 0 0 var(--b-4);
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
}
.aksiyon-izi::before,
.aksiyon-izi::after {
  content: ""; flex: 1 1 auto; height: 1px; min-width: var(--b-5);
  background: var(--kenar-acik);
}
.aksiyon-izi span {
  flex: 0 1 auto; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* -------- Çalışıyor göstergesi -------- */
/* Tek basina ziplayan nokta "dondu" hissi veriyordu: adim adi,
   gecen sure ve iptal dugmesi ayni balonda. */
.balon.calisiyor { min-width: 15rem; }
.calisma-ust { display: flex; align-items: center; gap: var(--b-2); }
.calisma-adim {
  font-weight: var(--fw-kalin); font-size: var(--fs-govde); color: var(--metin);
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.calisma-alt {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3); margin-top: var(--b-2);
}
.calisma-sure { font-size: var(--fs-govde); color: var(--metin-soluk); }
.calisma-iptal {
  height: var(--btn-h-kucuk); padding: 0 var(--b-3);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer;
}
.calisma-iptal:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}
.calisma-iptal:disabled { opacity: .45; cursor: not-allowed; }

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 5px; height: 5px; margin-right: 3px;
  border-radius: 50%; background: var(--metin-soluk); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-2px); }
}

/* -------- Aksiyon butonları ve yazı kutusu -------- */
#giris-bolge {
  padding: var(--b-3) var(--sohbet-yan) var(--b-5);
  padding-right: calc(var(--sohbet-yan) + 6px);   /* #sohbet scrollbar payi */
  flex-shrink: 0;
}
#aksiyonlar {
  width: var(--govde-en); margin: 0 0 var(--b-3) var(--girinti);
  display: flex; gap: var(--b-2);
}
#aksiyonlar.bos { display: none; }

.aksiyon {
  flex: 1; height: var(--btn-h); padding: 0 var(--b-4);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  border-radius: var(--r); cursor: pointer; white-space: nowrap;
  text-align: center;
  transition: background .15s, border-color .15s, color .15s;
}
.aksiyon:disabled { opacity: .45; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff; border: 1px solid var(--kirmizi);
}
.aksiyon.onayla:hover:not(:disabled) {
  background: var(--kirmizi-koyu); border-color: var(--kirmizi-koyu);
}

.aksiyon.degistir, .aksiyon.geri {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.aksiyon.degistir:hover:not(:disabled),
.aksiyon.geri:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}

#giris {
  width: var(--govde-en); margin: 0 0 0 var(--girinti);
  display: flex; gap: var(--b-2); align-items: center;
  background: var(--yuzey);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r);
  padding: 2px 2px 2px var(--b-4);
  box-shadow: var(--golge-1);
  transition: border-color .15s, box-shadow .15s;
}
#giris:focus-within { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }
#kutu {
  flex: 1; padding: 5px 0; border: none;
  background: transparent; color: var(--metin);
  font-size: var(--fs-govde); line-height: 1.5;
  resize: none; outline: none; max-height: 77px; overflow-y: auto;
}
#kutu::placeholder { color: var(--metin-soluk); }

#gonder {
  height: var(--btn-h-kucuk); padding: 0 var(--b-5);
  background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { opacity: .85; }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--ayrac);
  display: flex; flex-direction: column; overflow: hidden;
}

/* Sekmeler 3 sutunlu izgara: her genislikte duzenli 2 satir (3 + 3),
   esit genislikte ve ortali. Yeni sekme eklenirse ayni izgaraya oturur. */
#analiz-sekmeler {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--b-1);
  padding: var(--b-4) var(--b-5) var(--b-3);
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  flex-shrink: 0;
}
.analiz-sekme {
  min-width: 0; height: 24px; padding: 0 var(--b-2);
  text-align: center; overflow: hidden; text-overflow: ellipsis;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: .02em;
  border: 1px solid transparent; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin-soluk); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); color: var(--metin); }
/* Backend'e henüz bağlı olmayan sekmeler soluk durur */
.analiz-sekme.hazir-degil:not(.aktif) { opacity: .7; }
.analiz-sekme.aktif {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi-halka);
}

#analiz-govde { flex: 1; overflow-y: auto; padding: var(--b-4) var(--b-5) var(--b-6); }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: var(--r);
  padding: var(--b-4); margin-bottom: var(--b-3); box-shadow: var(--golge-1);
}
.iskele-baslik {
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); margin-bottom: var(--b-2); color: var(--metin);
}
/* "Hazırlanıyor" notu: sekmenin verisi henüz bağlı değil */
.iskele-kart.hazirlaniyor { border-style: dashed; background: var(--yuzey-alt); }
.iskele-satir {
  display: flex; justify-content: space-between; gap: var(--b-3);
  font-size: var(--fs-govde); padding: 5px 0; color: var(--metin-soluk);
}
.iskele-deger {
  font-size: var(--fs-govde);
  color: var(--metin); background: var(--kenar-acik);
  padding: 0 var(--b-2); border-radius: var(--r-kucuk);
}
.iskele-grafik {
  height: 69px; border-radius: var(--r-kucuk); margin-top: var(--b-1);
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 5px,
    var(--yuzey) 5px, var(--yuzey) 10px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin-soluk); font-size: var(--fs-govde);
}

/* -------- Durum çipi (validasyon ve ileride tüm durumlar) -------- */
.cip {
  display: inline-flex; align-items: center; gap: 4px;
  height: 18px; padding: 0 var(--b-2);
  border-radius: var(--r-kucuk);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin); letter-spacing: .05em;
  white-space: nowrap;
}
.cip::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor;
}
.cip.gecti    { background: var(--yesil-acik);  color: var(--yesil); }
.cip.kosullu  { background: var(--amber-acik);  color: var(--amber); }
.cip.kaldi    { background: var(--kirmizi-acik); color: var(--kirmizi); }
/* Hesaplanamadi: hesap denendi ama guvenilir sonuc cikmadi (NaN skor,
   yetersiz bin). "Veri yok"tan farkli oldugu icin amber. */
.cip.hesaplanamadi { background: var(--amber-acik); color: var(--amber); }
.cip.bekliyor,
.cip.veri_yok { background: var(--kenar-acik);  color: var(--metin-soluk); }

/* -------- Validasyon sekmesi -------- */
.val-sonuc {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
}
.val-model { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 2px; }
.val-ozet  { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-2); }

/* Sonuc kartinin sol cubugu genel sonucun rengini alir */
.iskele-kart.val-kart {
  position: relative; overflow: hidden;
  padding-left: calc(var(--b-4) + var(--serit));
}
.iskele-kart.val-kart::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kenar-guclu);
}
.iskele-kart.val-kart.gecti::before   { background: var(--yesil); }
.iskele-kart.val-kart.kosullu::before { background: var(--amber); }
.iskele-kart.val-kart.kaldi::before   { background: var(--kirmizi); }

.val-satir {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--b-3); padding: 8px 0;
  border-bottom: 1px solid var(--kenar-acik);
}
.val-satir:first-of-type { padding-top: 0; }
.val-satir:last-child { border-bottom: none; padding-bottom: 0; }
.val-sol { min-width: 0; }
.val-ad { font-weight: var(--fw-kalin); color: var(--metin); }
.val-esik { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 1px; }
.val-sag {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: var(--b-1);
}
.val-deger { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin); }
.val-not { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-1); }

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1024px; margin: 0 auto; padding: 22px clamp(14px, 2.4vw, 35px) 45px; }
#ozet-baslik-blok { margin-bottom: var(--b-5); }
#ozet-h1 { margin: 0; }
#ozet-adim {
  font-size: var(--fs-govde); color: var(--metin-soluk);
  margin-top: 5px; text-align: center;
}

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(272px, 1fr));
  gap: var(--b-4); align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: var(--r);
  padding: var(--b-4) var(--b-5); box-shadow: var(--golge-1);
}
.ozet-blok-baslik {
  margin-bottom: var(--b-3);
  padding-bottom: var(--b-2); border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 11px;
  padding: 5px 0; font-size: var(--fs-govde); align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--metin-soluk); flex-shrink: 0; }
.ozet-satir-deger {
  color: var(--metin);
  text-align: right; font-weight: var(--fw-kalin); word-break: break-word; min-width: 0;
}
/* ==================== KAYDIRMA ÇUBUKLARI ==================== */
#panel::-webkit-scrollbar,
#sohbet::-webkit-scrollbar,
#analiz-govde::-webkit-scrollbar,
#sayfa-ozet::-webkit-scrollbar,
#kutu::-webkit-scrollbar,
.combo-liste::-webkit-scrollbar { width: 6px; }

#panel::-webkit-scrollbar-thumb,
#sohbet::-webkit-scrollbar-thumb,
#analiz-govde::-webkit-scrollbar-thumb,
#sayfa-ozet::-webkit-scrollbar-thumb,
#kutu::-webkit-scrollbar-thumb,
.combo-liste::-webkit-scrollbar-thumb {
  background: var(--kenar-guclu); border-radius: 3px;
}
#panel::-webkit-scrollbar-thumb:hover,
#sohbet::-webkit-scrollbar-thumb:hover,
#analiz-govde::-webkit-scrollbar-thumb:hover,
#sayfa-ozet::-webkit-scrollbar-thumb:hover,
#kutu::-webkit-scrollbar-thumb:hover,
.combo-liste::-webkit-scrollbar-thumb:hover { background: var(--kirmizi); }

#panel::-webkit-scrollbar-track,
#sohbet::-webkit-scrollbar-track,
#analiz-govde::-webkit-scrollbar-track,
#sayfa-ozet::-webkit-scrollbar-track,
#kutu::-webkit-scrollbar-track,
.combo-liste::-webkit-scrollbar-track { background: transparent; }

#panel, #sohbet, #analiz-govde, #sayfa-ozet, #kutu, .combo-liste {
  scrollbar-width: thin;
  scrollbar-color: var(--kenar-guclu) transparent;
}

/* -------- Dar ekran (kirilma noktalari da 0,8 ile olceklendi) -------- */
