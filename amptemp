def bolme_plan(durum):
    donemler = durum.get("_donemler") or []
    m = durum.get("meta") or {}
    b = durum.get("bolme") or {}

    if len(donemler) >= 2:
        b.setdefault("tur", "zamansal")
        b.setdefault("oot_deger", donemler[-1])
        oneri = ("  Tür        : zamansal (out-of-time)\n"
                 "  Geliştirme : ilk %s dönem\n"
                 "  Test       : %s = %s\n"
                 % (_sayi(len(donemler) - 1), m.get("donem"), b["oot_deger"]))
        gerekce = ("Dönem kolonu birden fazla değer taşıdığı için zamansal "
                   "bölme öneriyorum. Modelin gerçek kullanım koşuluna en yakın "
                   "değerlendirme budur.")
    else:
        b.setdefault("tur", "rastgele")
        b.setdefault("test_oran", 0.20)
        b.setdefault("seed", 42)
        oran = float(b.get("test_oran") or 0.20)
        # Metin uygulamayla birebir: katmanlamayi da birimi de tek yerden,
        # bolme_ayarlari() cozuyor (bkz. akis_durum). Metin burada ayri
        # kural yazarsa uygulanan bolmeden baska bir sey anlatir.
        katmanli = bool(bolme_ayarlari(durum)["katmanla"])
        kimlik = m.get("id")
        oneri = ("  Tür        : rastgele%s\n"
                 "  Geliştirme : %%%s\n  Test       : %%%s\n"
                 "  Seed       : %s\n"
                 % (", hedefe göre katmanlı" if katmanli else "",
                    _sayi(round(100 * (1 - oran))), _sayi(round(100 * oran)),
                    b.get("seed", 42)))
        gerekce = ("Kullanılabilir bir dönem kolonu bulunmadığı için rastgele "
                   "bölme uygulayacağım.")
        if katmanli:
            gerekce += (" Hedef dağılımı iki sette de korunacak biçimde "
                        "katmanlı örnekleme kullanıyorum; düşük temerrüt "
                        "oranlı portföylerde düz rastgele bölme test setini "
                        "pozitif kayıt açısından fakirleştirebiliyor.")
        if kimlik:
            gerekce += (" Bölme %s kimliği üzerinden sabitlenecek: aynı "
                        "kimlik iki sete birden düşmez ve bölme sonraki "
                        "adımlarda değişmez." % kimlik)
            satir = (durum.get("profil") or {}).get("satir") or 0
            if satir * oran > TEST_KIMLIK_LIMITI:
                gerekce += (" Tablo büyük olduğu için kimlik listesi oturum "
                            "dosyasına sığmayabilir; bu durumda bölme veri "
                            "setine kalıcı %s kolonu olarak yazılır."
                            % SPLIT_KOLON)
        else:
            gerekce += (" Kimlik kolonu tanımlı olmadığı için bölme veri "
                        "setine kalıcı %s kolonu olarak yazılacak."
                        % SPLIT_KOLON)
        # Donem kolonu VARKEN rastgele test seciliyse bunu soyle: sessizce
        # uygulanan bir tercih, kullaniciya anlatilmamis bir bolmedir.
        if m.get("donem"):
            gerekce += (" Dönem kolonu tanımlı olduğu halde testi rastgele "
                        "ayırıyorum; zamanla gelen bozulmayı ölçmek "
                        "isterseniz HAZIRLIK sekmesinden zamansal teste "
                        "(son N dönem) geçebilirsiniz.")
    durum["bolme"] = b

    return ("Geliştirme ve test setlerini ayıralım:\n\n%s\n%s\n\n"
            "Bu ayrım sürecin sızıntı sınırıdır. Eksik değer doldurma, "
            "kategorik dönüşüm ve model eğitimi yalnızca geliştirme seti "
            "üzerinden hesaplanacak; test setine hazır değerler uygulanacak.\n\n"
            "Onaylıyor musunuz?" % (oneri, gerekce))

def bolme_uygula(durum):
    # TAM tablo okunuyor: eskiden limit=100000 ile okunup satir sayilari bu
    # KESILMIS tablodan hesaplaniyordu; diger adimlar tam tabloyu okudugu
    # icin kullaniciya yanlis satir sayisi gosteriliyordu.
    veri_seti = durum["veri_seti"]
    df = _df_oku(veri_seti)

    def _split_yaz(kopya):
        yazildi, _ = _yaz(veri_seti, kopya, "/bolme_split.csv")
        return yazildi

    # Bolme BIR KEZ hesaplanip kalici hale getiriliyor; maskeler() bundan
    # sonra hep ayni satirlari ayni sete koyuyor.
    tr, te, notlar = bolme_hazirla(durum, df, yazici=_split_yaz)
    onbellek_temizle(veri_seti)

    # Set sayimlarini bolme_hazirla yaziyor (dort yolun da ayni sayimi
    # uretmesi icin); burada yalnizca toplam ekleniyor.
    b = durum["bolme"]
    b["toplam_satir"] = int(len(df))
    durum["bolme"] = b

    hedef = (durum.get("meta") or {}).get("target")
    oran_not = ""
    if hedef and hedef in df.columns:
        try:
            y = pd.to_numeric(df[hedef], errors="coerce")
            if int(y.nunique(dropna=True)) <= 2:
                oran_not = ("\nHedef oranı: geliştirme %%%s, test %%%s."
                            % (_ond(100.0 * float((y[tr] > 0).mean()), 2),
                               _ond(100.0 * float((y[te] > 0).mean()), 2)))
        except Exception:
            oran_not = ""

    # Val ya da OOT acikken iki sayi tabloyu artik anlatmiyor; dort setin
    # tamami tek satirda gosteriliyor.
    dort = b.get("satir") or {}
    if dort.get("val") or dort.get("oot"):
        notlar = list(notlar) + ["Setler: %s." % bolme_ozeti(durum)]

    ek = ("\n" + "\n".join(notlar)) if notlar else ""
    return ("Bölme tanımlandı: %s satırın %s satırı geliştirme, %s satırı "
            "test.%s%s"
            % (_sayi(b["toplam_satir"]), _sayi(b["train_satir"]),
               _sayi(b["test_satir"]), oran_not, ek))































