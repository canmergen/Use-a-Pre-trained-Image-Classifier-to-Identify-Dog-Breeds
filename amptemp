       dusuyor — pencerede 31 piksel kaliyordu. Kullanicidan bolme
       oncesi tanimlari duzeltmesi istenen ekranda tablonun kaydirma
       ardinda olmasi kabul edilemezdi. Kartlar SILINMEDI: basliga
       basinca aciliyorlar ve acik/kapali durum PANEL CIZIMLERI
       ARASINDA KORUNUYOR (kartAcik), yoksa her backend yanitinda
       kullanicinin actigi kart kendiliginden kapaniyordu. */
    const katli = !!v.kart_kat;
    (v.kartlar || []).forEach(k => {
        const kart = elYap("div", "iskele-kart");
        const acik = katli ? (kartAcik[k.baslik] === true) : true;
        if (katli) kart.classList.add("kart-katlanir");

        if (katli) {
            const bas = document.createElement("button");
