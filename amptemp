import numpy as np
import pandas as pd

# ==================================================================
# ÖDEME ORANI: MÜŞTERİ ÖRNEĞİ
# 202504 satırındaki 12 ay (202404-202503) her müşteri için yan yana: ödeme oranı ve bakiye (KK_RISK).
# Log tablosunda fazla satır olan aylar (202404, 202406, 202410, 202501, 202503) * ile işaretli.
# Tek başına çalışır; bellekte df olması yeter. En sonda bu müşterilerin log tablosundaki ham satırlarını getiren
# SQL'i hazır basar (SQL notebook'ta çalıştırılır).
# ==================================================================
_DON = 202504
_FAZLA = {202404, 202406, 202410, 202501, 202503}
_N_ORNEK = 8

_AYLAR = ["LM"] + [f"L{i}M" for i in range(2, 13)]
_d = pd.to_numeric(df["DONEM"], errors="coerce").to_numpy()
_kk = (df["KK_URUN_FLG"] == "KK").to_numpy() if "KK_URUN_FLG" in df.columns else np.ones(len(df), dtype=bool)
_X = df.loc[(_d == _DON) & _kk]
_ay0 = (_DON // 100) * 12 + _DON % 100 - 1
_takvim = [((_ay0 - j - 1) // 12) * 100 + (_ay0 - j - 1) % 12 + 1 for j in range(12)]     # LM, L2M, ... → YYYYMM


def _seri(on_ek):
    t = pd.DataFrame({ay: pd.to_numeric(_X[f"{on_ek}_{a}"], errors="coerce").to_numpy("float64", na_value=np.nan)
                      for a, ay in zip(_AYLAR, _takvim)})
    return t[sorted(t.columns)]                                # eski aydan yeniye


_odm, _bky = _seri("KK_ODEME_ORANI"), _seri("KK_RISK")
_mbb = _X["MBB_NO"].astype(str).to_numpy() if "MBB_NO" in _X.columns else np.arange(len(_X)).astype(str)
_fazla = [c for c in _odm.columns if c in _FAZLA]
_diger = [c for c in _odm.columns if c not in _FAZLA]

_tam = ((_odm[_fazla] == 100).all(axis=1) & _odm[_diger].isna().all(axis=1)).to_numpy()
_gevsek = ((_odm[202501] == 100) & _odm[202502].isna() & (_odm[202503] == 100)).to_numpy()
def _say(n, pay=None):
    """Türkçe sayı: 12.345 ve (%19,8)."""
    m = f"{int(n):,}".replace(",", ".")
    if pay is None:
        return m
    yuzde = f"{100 * pay:.1f}".replace(".", ",")
    return f"{m} (%{yuzde})"


print(f"{_DON} satırında {_say(len(_odm))} KK müşterisi")
print(f"   Ödeme oranı 202501'de 100, 202502'de boş, 202503'te yine 100 olan: {_say(_gevsek.sum(), _gevsek.mean())}")
print(f"   Bütün * aylarda 100, diğer 7 ayın hepsinde boş olan: {_say(_tam.sum(), _tam.mean())}")

_sec = np.flatnonzero(_tam if _tam.any() else _gevsek)[:_N_ORNEK]
_etiket = [f"{c}{'*' if c in _FAZLA else ''}" for c in _odm.columns]


def _tablo(t, bicim):
    g = t.iloc[_sec].copy()
    g = g.apply(lambda s: s.map(lambda x: "boş" if pd.isna(x) else bicim(x)))
    g.columns = _etiket
    g.insert(0, "MBB_NO", _mbb[_sec])
    return g.to_string(index=False)


with pd.option_context("display.width", 250, "display.max_columns", 50):
    print("\nÖDEME ORANI (aynı müşteriler; * = log tablosunda fazla satır olan ay)")
    print(_tablo(_odm, lambda x: f"{x:.0f}" if x == round(x) else f"{x:.1f}".replace(".", ",")))
    print("\nBAKİYE (KK_RISK, aynı müşteriler ve aylar)")
    print(_tablo(_bky, lambda x: f"{x:,.0f}".replace(",", ".")))

if "MBB_NO" in _X.columns and len(_sec):
    _liste = ", ".join(m if m.isdigit() else f"'{m}'" for m in _mbb[_sec])
    print("\nBu müşterilerin log tablosundaki ham satırları (SQL notebook'ta çalıştırın; borcu gösteren kolonu arıyoruz):\n")
    print(f"""SELECT T2.TARAF_ID, T3.*
FROM DWH_THSP_TARAF_ILIS T2
JOIN DWH_THSP_KK_ODEME_ORAN_LOG T3 ON T2.HESAP_ID = T3.HESAP_ID
WHERE T2.TARAF_ID IN ({_liste})
  AND T3.EKSTRE_KESIM_TARIHI >= DATE '2024-04-01'
  AND T3.EKSTRE_KESIM_TARIHI <  DATE '2025-04-01'
ORDER BY T2.TARAF_ID, T3.HESAP_ID, T3.EKSTRE_KESIM_TARIHI""")
