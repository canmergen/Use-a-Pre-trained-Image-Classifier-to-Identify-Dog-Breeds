def _bd_deger(x):
    if x is None or (isinstance(x, (float, np.floating)) and not np.isfinite(x)):
        return None
    if x is pd.NA:
        return None
    return x.item() if hasattr(x, "item") else x


def _bd_dilim_yerleri(ws, c0, istek):
    """Dilimleyicileri soldan sağa yerleştirir: istek = [(kolon başlığı, en az genişlik, satır, buton kolonu)]."""
    plan, c = [], c0
    for baslik, en_az, n_satir, n_kol in istek:
        c1, gen = c, 0.0
        while gen < en_az:
            gen += ws.column_dimensions[get_column_letter(c)].width or 9
            c += 1
        plan.append((baslik, baslik, c1, c - 1, n_satir, n_kol))
    return plan


def _bd_tablo(ws, S, r, kolonlar, gruplar, satirlar, tablo_adi, dilimler, acilis, katla=False, dilim_yuk=8):
    """Dilimleyici alanı + grup bandı + başlık + satırlar + Excel tablosu. acilis: {anahtar: açılışta görünen değer}.
    dilimler: [(anahtar, en az genişlik, satır, buton kolonu)] soldan sağa tek sıra ya da
              [(anahtar, ilk kolon, son kolon, satır farkı, satır, buton kolonu)] yeri açıkça verilmiş.
    katla: M dışındaki her bloğun ilk kolonu hep görünür, diğerleri Excel kolon gruplamasıyla (+ / -) açılıp kapanır.
    → (başlık satırı, son satır, kolon numaraları)."""
    C = {k[4]: 2 + i for i, k in enumerate(kolonlar)}
    ad = {k[4]: k[1] for k in kolonlar}
    r_bant = r + dilim_yuk if DILIMLEYICI_EKLE else r
    for g in dict.fromkeys(k[0] for k in kolonlar):
        cs = [C[k[4]] for k in kolonlar if k[0] == g]
        S.birlestir(r_bant, cs[0], cs[-1], gruplar[g], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=11, h="center",
                    kenar=_KENAR_B)
        if katla and g != "M":
            for c in cs[1:]:
                ws.column_dimensions[get_column_letter(c)].outline_level = 1
    if katla:
        ws.sheet_properties.outlinePr = Outline(summaryBelow=True, summaryRight=False)   # +/- bloğun ilk kolonunda
        ws.sheet_format.outlineLevelCol = 1
    ws.row_dimensions[r_bant].height = 20
    R0 = r_bant + 1
    for k in kolonlar:
        S.hucre(R0, C[k[4]], k[1], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
    ws.row_dimensions[R0].height = 46
    for i, d in enumerate(satirlar):
        rr = R0 + 1 + i
        for k in kolonlar:
            v = _bd_deger(d.get(k[4]))
            x = ws.cell(rr, C[k[4]], v)
            x.font, x.border = _bd_font, _KENAR
            x.alignment = _bd_hiza["left" if k[4] in _BD_SOL else "center"]
            if k[2]:
                x.number_format = k[2]
            if k[4] in _BD_RENKLI and v is not None:
                renk = _BD_RENKLI[k[4]](v)
                if renk:
                    x.fill = _bd_dolgu.setdefault(renk, PatternFill("solid", fgColor=renk))
                    x.font = _bd_font_k
        if any(str(d.get(a)) != str(b) for a, b in acilis.items() if b is not None):
            ws.row_dimensions[rr].hidden = True                # açılışta yalnızca seçili renk (ve bucket sayısı) görünür
    RS = R0 + max(len(satirlar), 1)
    tab = _tablo_ekle(ws, tablo_adi, R0, RS, 2, [k[1] for k in kolonlar])
    for a, b in acilis.items():
        if b is not None:
            tab.autoFilter.filterColumn.append(FilterColumn(colId=C[a] - 2, filters=Filters(filter=[str(b)])))
    if dilimler and len(dilimler[0]) == 6:
        if DILIMLEYICI_EKLE:
            DILIMLEYICI_PLANI.append({"sayfa": ws.title, "tablo": tablo_adi, "dilimler": [
                (ad[a], ad[a], (c1 - 1, r + o - 1, c2, r + o - 1 + n), k) for a, c1, c2, o, n, k in dilimler]})
    else:
        _dilimleyici_alani(ws, tablo_adi, r, _bd_dilim_yerleri(ws, 2, [(ad[a], g, n, k) for a, g, n, k in dilimler]))
    return R0, RS, C


def _bd_genislik(*kolon_listeleri):
    gen = {}
    for kolonlar in kolon_listeleri:
        for i, k in enumerate(kolonlar):
            gen[2 + i] = max(gen.get(2 + i, 0), k[3])
    return gen


