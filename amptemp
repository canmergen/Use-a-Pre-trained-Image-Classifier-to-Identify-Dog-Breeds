SELECT LAST_DAY(TRUNC(EKSTRE_KESIM_TARIHI))                         AS AY,
       COUNT(*)                                                      AS SATIR,
       COUNT(DISTINCT HESAP_ID)                                      AS HESAP,
       SUM(CASE WHEN ODEME_ORANI = 100 THEN 1 ELSE 0 END)            AS ORAN_100,
       ROUND(AVG(CASE WHEN ODEME_ORANI = 100 THEN 1 ELSE 0 END), 3)  AS ORAN_100_PAYI,
       COUNT(DISTINCT TRUNC(EKSTRE_KESIM_TARIHI))                    AS KESIM_GUNU_SAYISI
FROM DWH_THSP_KK_ODEME_ORAN_LOG
WHERE EKSTRE_KESIM_TARIHI >= DATE '2024-04-01'
  AND EKSTRE_KESIM_TARIHI <  DATE '2025-11-01'
GROUP BY LAST_DAY(TRUNC(EKSTRE_KESIM_TARIHI))
ORDER BY 1;
