    kaydet.type = "button";
    kaydet.className = "ft-mini bf-kaydet";
    kaydet.setAttribute("data-bf", "kaydet");
    kaydet.textContent = BF.kaydediyor ? "Kaydediliyor…" : "Kaydet";
    kaydet.disabled = pasif;
    kaydet.onclick = bfKaydet;
    ayak.appendChild(kaydet);
    kok.appendChild(ayak);

    if (BF.not) {
        const n = elYap("div", "ft-not", BF.not);
        n.setAttribute("data-bf", "not");
        kok.appendChild(n);
    }
    if (BF.hata) {
        const h = elYap("div", "ft-toplu-hata", BF.hata);
        h.setAttribute("role", "alert");
        h.setAttribute("data-bf", "hata");
        kok.appendChild(h);
    }
