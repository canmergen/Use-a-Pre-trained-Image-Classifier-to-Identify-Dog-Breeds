from pyspark import SparkContext
from pyspark.sql import SQLContext, functions as F

sc = SparkContext.getOrCreate()
sqlContext = SQLContext(sc)
spark = sqlContext.sparkSession

def dene(ad, f):
    try:
        print(ad, "->", f())
    except Exception as e:
        print(ad, "-> OLMADI:", type(e).__name__, str(e).splitlines()[0][:200])

def surum(modul):
    m = __import__(modul)
    return getattr(m, "__version__", "var")

def mllib():
    from pyspark.ml.feature import VectorAssembler
    from pyspark.ml.classification import (LogisticRegression, DecisionTreeClassifier,
                                           RandomForestClassifier, GBTClassifier)
    df = (spark.range(2000)
          .select(F.rand(1).alias("x1"), F.rand(2).alias("x2"))
          .withColumn("y", ((F.col("x1") + F.col("x2")) > 1).cast("double")))
    df = VectorAssembler(inputCols=["x1", "x2"], outputCol="f").transform(df)
    for m in (LogisticRegression(featuresCol="f", labelCol="y"),
              DecisionTreeClassifier(featuresCol="f", labelCol="y"),
              RandomForestClassifier(featuresCol="f", labelCol="y", numTrees=5),
              GBTClassifier(featuresCol="f", labelCol="y", maxIter=5)):
        m.fit(df)
    return "LR, DT, RF, GBT çalışıyor"

def jvm_sinif(yol):
    nesne = spark._jvm
    for parca in yol.split("."):
        nesne = getattr(nesne, parca)
    return "VAR" if type(nesne).__name__ == "JavaClass" else "YOK"

dene("Spark sürümü", lambda: spark.version)
dene("Yürütücü sayısı", lambda: spark.conf.get("spark.executor.instances", "?"))
dene("Yürütücü belleği", lambda: spark.conf.get("spark.executor.memory", "?"))
dene("Yürütücü çekirdeği", lambda: spark.conf.get("spark.executor.cores", "?"))
dene("Sürücü belleği", lambda: spark.conf.get("spark.driver.memory", "?"))
dene("Ek paketler", lambda: spark.conf.get("spark.jars.packages", "yok"))
dene("MLlib modelleri", mllib)
dene("LightGBM (Spark jar)", lambda: jvm_sinif("com.microsoft.azure.synapse.ml.lightgbm.LightGBMClassifier"))
dene("XGBoost (Spark jar)", lambda: jvm_sinif("ml.dmlc.xgboost4j.scala.spark.XGBoostClassifier"))
for paket in ("lightgbm", "xgboost", "sklearn", "pyarrow", "polars", "duckdb"):
    dene("Python paketi " + paket, lambda p=paket: surum(p))
dene("Yürütücüde Python", lambda: sc.parallelize([1], 1).map(lambda x: x + 1).collect())
