def _model_etiket(kod, v, aile):
    return f"{_RENK_ADI[kod]} | {v}M {_MODEL_ADI[aile]}"


def _hukum_sinifi(hk):
    return str(hk).split(":")[0].strip() if hk else None


def _dagilim_bolumu(ws, S, r):
    """"Model mi, mevcut skor mu?" dağılım grafiği: her nokta bir model; yatay eksen en iyi mevcut skorun Gini'si,
    dikey eksen modelin Gini'si (14 HÜKÜM, aynı müşteriler). Bir sonraki boş satırı döner."""
    noktalar = []
    for kod, v, a in TUM_MODELLER:
        kk = KIYAS.get((v, a, kod), {})
        mev = [g for g in (kk.get("g_dav", np.nan), kk.get("g_mus", np.nan)) if _sonlu(g)]
        sinif = _hukum_sinifi(kk.get("hukum"))
        if _sonlu(kk.get("g_mod", np.nan)) and mev and sinif in ("MODEL GEREKLİ", "SINIRDA", "MEVCUT SKOR YETER"):
            noktalar.append((sinif, max(mev), kk["g_mod"], _model_etiket(kod, v, a)))
    if not noktalar:
        return r
    S.baslik(r, "Model mi, mevcut skor mu? (OOT Gini, aynı müşteriler üzerinde)")
    r += 1
    wv = _veri_sayfasi()
    for c, metin in enumerate(["Model", "Hüküm", "En iyi mevcut skor Gini", "Model Gini", "", "Eşitlik x", "Eşitlik y",
                               "Eşik x", "Eşik y"], start=1):
        wv.cell(1, c, metin)
    siniflar = [("MODEL GEREKLİ", "Model gerekli", "4CAF50"), ("SINIRDA", "Sınırda", "FFC000"),
                ("MEVCUT SKOR YETER", "Mevcut skor yeter", "7F7F7F")]
    satir, araliklar = 2, []
    for kod_s, ad_s, rk in siniflar:
        nl = sorted((n for n in noktalar if n[0] == kod_s), key=lambda n: n[1])
        if not nl:
            continue
        r1 = satir
        for n in nl:
            for c, deger in enumerate((n[3], ad_s, float(n[1]), float(n[2])), start=1):
                wv.cell(satir, c, deger)
            satir += 1
        araliklar.append((ad_s, rk, r1, satir - 1, len(nl)))
    tum = [n[1] for n in noktalar] + [n[2] for n in noktalar]
    alt = min(0.0, float(np.floor(min(tum) * 10) / 10))
    ust = min(1.0, float(np.ceil(max(tum) * 10) / 10))
    ust = max(ust, alt + 0.1)
    e = KIYAS_GEREKLI_PUAN
    for i, (ex, ey, kx, ky) in enumerate([(alt, alt, alt, alt + e), (ust, ust, ust - e, ust)]):
        for c, deger in zip((6, 7, 8, 9), (ex, ey, kx, ky)):
            wv.cell(2 + i, c, float(deger))
    sc = ScatterChart()
    sc.title = "Model Gini'si ve en iyi mevcut skorun Gini'si"
    sc.style = 13
    sc.width, sc.height = 15.0, 13.0
    sc.legend.position = "b"
    sc.x_axis.title = "En iyi mevcut skorun Gini'si (Davranış ya da Müşteri)"
    sc.y_axis.title = "Modelin Gini'si"
    for ax in (sc.x_axis, sc.y_axis):
        ax.scaling.min, ax.scaling.max = alt, ust
        ax.majorUnit = 0.1
        ax.numFmt = "0%"
        ax.majorGridlines = None
        ax.delete = False
        ax.txPr = _yazi(8)
    for ad_s, rk, r1, r2, n in araliklar:
        s = Series(Reference(wv, min_col=4, min_row=r1, max_row=r2), Reference(wv, min_col=3, min_row=r1, max_row=r2),
                   title=f"{ad_s} ({n})")
        s.marker = Marker(symbol="circle", size=7)
        s.marker.graphicalProperties = GraphicalProperties(solidFill=rk)
        s.marker.graphicalProperties.line.solidFill = "FFFFFF"
        s.graphicalProperties.line.noFill = True               # noktalar arasında çizgi yok
        sc.series.append(s)
    for cx, cy, ad_c, stil in [(6, 7, "Eşitlik: model = mevcut skor", "dash"),
                               (8, 9, f"Model gerekli eşiği (+{_adet(e * 100)} puan)", "sysDot")]:
        s = Series(Reference(wv, min_col=cy, min_row=2, max_row=3), Reference(wv, min_col=cx, min_row=2, max_row=3), title=ad_c)
        s.marker = Marker(symbol="none")
        s.graphicalProperties.line.solidFill = "404040"
        s.graphicalProperties.line.dashStyle = stil
        s.graphicalProperties.line.width = 15000
        sc.series.append(s)
    sc.visible_cells_only = False                             # veri gizli sheet'te
    ws.add_chart(sc, f"B{r}")
    n_ust = sum(1 for n in noktalar if n[2] > n[1])
    n_esik = sum(1 for n in noktalar if n[0] == "MODEL GEREKLİ")
    yuk = 0
    for i, (metin, y, kalin) in enumerate([
        ("Nasıl okunur?", 20, True),
        ("Her nokta bir model (renk x hedef-vade). İki eksen de aynı müşteriler üzerinde ölçülen OOT Gini'dir.", 46, False),
        ("Kesikli çizginin üstündeki modeller, iki mevcut skordan iyi olanından daha iyi ayırıyor; altındakilerde mevcut "
         "skor daha iyi.", 46, False),
        (f"Noktalı çizginin üstü: fark {_adet(e * 100)} puan ve üstü, yani Hüküm \"Model gerekli\".", 32, False),
        ("Renk Hüküm'ü gösterir: yeşil model gerekli, sarı sınırda, gri mevcut skor yeter.", 32, False),
        (f"{len(noktalar)} modelin {n_ust} tanesi kesikli çizginin, {n_esik} tanesi noktalı çizginin üstünde.", 32, True),
    ]):
        S.birlestir(r + i, 7, 10, metin, bold=kalin, dikey="center", kenar=None, fill=_ALT if i == 0 else None)
        ws.row_dimensions[r + i].height = y
        yuk += y
    grafik_pt = 13.0 / 2.54 * 72
    return r + 6 + int(np.ceil(max(0.0, grafik_pt - yuk) / 15.0)) + 2


def _degisken_ozet_metni():
    """Yönetici Özeti "Değişkenler" maddesi: havuz, kalan sayı, sınır ve mevcut skorların modelde kullanımı."""
    parca = []
    h = _ist("n_havuz", DEG_ELEME)
    if N_SEC:
        aralik = (f"{_adet(min(N_SEC))} ile {_adet(max(N_SEC))} arasında (ortanca {_adet(float(np.median(N_SEC)))})"
                  if min(N_SEC) != max(N_SEC) else _adet(N_SEC[0]))
        kismi = (f" (eleme kaydı olan {len(DEG_ELEME)} / {len(DEG_LISTE)} modelde)"
                 if len(DEG_ELEME) < len(DEG_LISTE) else "")
        parca.append((f"Her model elemeden önce ortalama {_adet(h[0])} değişkenlik havuzla başladı{kismi}; neredeyse sabit, "
                      f"birbirine çok benzeyen ve katkısı düşük değişkenler elendikten sonra modellerde {aralik} değişken "
                      f"kaldı (sınır {MAX_DEGISKEN})." if h else
                      f"Modellerde {aralik} değişken var (sınır {MAX_DEGISKEN})."))
        if N_FAZLA:
            parca.append(f"{N_FAZLA} modelde değişken sayısı sınırın üstünde; bu modeller sınır düşürülmeden önce eğitilmiş "
                         "olabilir.")
    parca += [m for m in (_skor_metni(s) for s in KIYAS_SKOR_KODU) if m]
    return " ".join(parca)


