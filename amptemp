# --- Gelecege bakan ve target sizintisi riski tasiyan kolonlari desenle otomatik yakala ---
# Desenler kolon adinin HERHANGI bir yerinde aranir (search) ve buyuk/kucuk harf duyarsizdir.
#   SONRASI / SONRAKI        : RENK_3M_SONRASI, RENK_SONRAKI_2AY, DAV_SKOR_3M_SONRASI ...
#   AKB_GGS_<herhangi>       : Tum AKB_GGS kolonlari
#   AKB_TAKIP_<herhangi>     : AKB_TAKIP_3M, AKB_TAKIP_YY_6M_FLG ...
#   GGS<n>_90_YY             : GGS3_90_YY, GGS6_90_YY, GGS12_90_YY
#   TAKIP_<herhangi>         : TAKIP_FLAG, TAKIP_TARIH_3M ...
#   <n>M_ICINDE_KIRMIZI      : turetilmis target kolonlari
SIZINTI_DESENLERI = [
    re.compile(r'SONRASI', re.IGNORECASE),
    re.compile(r'SONRAKI', re.IGNORECASE),
    re.compile(r'^AKB_GGS_', re.IGNORECASE),
    re.compile(r'^AKB_TAKIP_', re.IGNORECASE),
    re.compile(r'^GGS\d+_90_YY$', re.IGNORECASE),
    re.compile(r'^TAKIP_', re.IGNORECASE),
    re.compile(r'^\d+M_ICINDE_KIRMIZI$', re.IGNORECASE),
]

if 'df' in globals():
    def _dogal_siralama_anahtari(s):
        return [int(x) if x.isdigit() else x.lower() for x in re.split(r'(\d+)', s)]

    def _liste_metni(kolonlar):
        if not kolonlar:
            return "[]"
        _sirali = sorted(kolonlar, key=_dogal_siralama_anahtari)
        return "[" + ", ".join(_sirali) + "]"

    _otomatik = {c for c in df.columns
                 if any(d.search(str(c)) for d in SIZINTI_DESENLERI)}
    _once = set(LEAK_COLS)
    _zaten_olan = _otomatik & _once
    _yeni_eklenen = _otomatik - _once
    LEAK_COLS.update(_otomatik)

    def _liste_yaz(baslik, kolonlar):
        print(f"\n{baslik} ({len(kolonlar)}): {_liste_metni(kolonlar)}")

    _liste_yaz("Otomatik bulunan sizinti kolonu", _otomatik)
    _liste_yaz("Zaten LEAK_COLS icinde olan", _zaten_olan)
    _liste_yaz("Yeni eklenen", _yeni_eklenen)

    _df_de_olmayan = set(LEAK_COLS) - set(df.columns)
    _liste_yaz("LEAK_COLS icinde olup df'te OLMAYAN", _df_de_olmayan)

    # RAW_FEATURES bu hucreden ONCE olusturulduysa yeni sizinti kolonlari icinde kalmis olabilir.
    if 'RAW_FEATURES' in globals():
        _rawda_sizinti = set(RAW_FEATURES) & set(LEAK_COLS)
        if _rawda_sizinti:
            print(f"\n⚠ RAW_FEATURES icinde LEAK_COLS kolonu var ({len(_rawda_sizinti)}): "
                  f"{_liste_metni(_rawda_sizinti)} -> RAW_FEATURES hucresini yeniden calistirin")
else:
    print("⚠ df bellekte yok -> otomatik sizinti taramasi atlandi")

print(f"\nLEAK_COLS ({len(LEAK_COLS)}):", LEAK_COLS)
