        if csi:
            c_max = max(csi, key=csi.get)
            t[f"ek_{d}"] = f"{c_max} ({csi[c_max]:.2f})".replace(".", ",")
        en_kotu.append(di["psi"] if np.isfinite(di["psi"]) else 0.0)
        if t[f"cb_{d}"]:
            en_kotu.append(_ST_ALT + 1e-9)                    # bir değişken belirgin kaydıysa model en az Dikkat
    t["durum"] = _st_durum(max(en_kotu)) if en_kotu else None
    _ST_T_MOD.append(t)
    for d in _ST_DON:
