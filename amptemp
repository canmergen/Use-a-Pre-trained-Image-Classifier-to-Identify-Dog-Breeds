        continue
    gruplar = {}
    for x, m in pk.items():
        gruplar.setdefault(m["ham"], []).append(x)
    for d in [x for x in _ST_DON if x in _st_donem_var]:
        rows, _t0, _hesap = None, time.time(), False
        for ham, xs in gruplar.items():
            p0 = pk[xs[0]]["p"]                                   # havuz bu ham kolon setindeki ilk modelin paketinden
            ds0 = set((p0.get("desen_kodlama") or {}).get("kolonlar", {}))
            havuz = [c for c in _st_havuz(p0) if c not in ds0]
            a_h = (_st_v0, _kod, ham, d)
            lazim_h = a_h not in _ST_ONB and (d == _ST_REF or (_st_v0, _kod, ham, _ST_REF) in _ST_ONB)
            lazim_m = [x for x in xs if (_st_v0, pk[x]["klasor"], _kod, d) not in _ST_ONB
                       and (d == _ST_REF or (_st_v0, pk[x]["klasor"], _kod, _ST_REF) in _ST_ONB)]
            if lazim_h or lazim_m:
                _hesap = True
                if rows is None:
                    rows = _st_satirlar(_kod, d, [c for h in gruplar for c in h])
                eksik = [c for c in ham if c not in rows.columns]
                if eksik:
                    _st_atlanan.append(f"renk {_kod} {d}: ham veride eksik kolon {eksik[:5]}")
                    continue
                X = rows.loc[:, list(ham)]
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore")
                    eng, _ = feature_engineering(X)
                U = _StUretim(X, eng, None)
                if lazim_h:                                   # havuzdaki her değişken (DSN hariç; o modele göre)
                    kat = set(p0["preprocess_schema"].get("categorical", {}))
                    ref_h = None if d == _ST_REF else _ST_ONB[(_st_v0, _kod, ham, _ST_REF)]

                    def _bir(c, U=U, p0=p0, kat=kat, ref_h=ref_h):
                        try:
                            return c, _st_kolon_ist(U.kolon(c, p0), c in kat, ref_h[c] if ref_h else None)
                        except Exception:
                            return c, None

                    with ThreadPoolExecutor(max_workers=_ST_IS) as ex:
                        _ST_ONB[a_h] = {c: r for c, r in ex.map(_bir, havuz) if r is not None}
                for x in lazim_m:                             # modelin skoru ve DSN değişkenleri
                    m = pk[x]
                    ref_m = None if d == _ST_REF else _ST_ONB[(_st_v0, m["klasor"], _kod, _ST_REF)]
                    try:
                        _, skor, _ = _st_girdi(X, eng, m["p"])
                    except Exception as e:
                        _st_atlanan.append(f"{m['klasor']} renk {_kod} {d}: skorlanamadı ({type(e).__name__}: {e})")
                        continue
                    dsn = {}
                    for c in (m["p"].get("desen_kodlama") or {}).get("kolonlar", {}):
                        dsn[c] = _st_kolon_ist(U.kolon(c, m["p"]), False, ref_m["dsn"][c] if ref_m else None)
                    _ST_ONB[(_st_v0, m["klasor"], _kod, d)] = {"skor": _st_skor_ist(skor, ref_m["skor"] if ref_m else None),
                                                               "dsn": dsn}
                del U, eng, X
            # sonuçları topla
            for c, ist in (_ST_ONB.get(a_h) or {}).items():
                g = _ST_DEG.setdefault((_kod, c), {"kod": _kod, "feat": c, "ist": {},
                                                   "kaynak": "HAM" if c in ham else "FE",
                                                   "tur": "kategorik" if "kat" in ist else "sayısal"})
                g["ist"][d] = ist
            for x in xs:
                mm = _ST_ONB.get((_st_v0, pk[x]["klasor"], _kod, d))
                if not mm:
                    continue
                pk[x]["skor"][d] = mm["skor"]
                for c, ist in mm["dsn"].items():                # DSN hedefe göre kodlanır: her modelin kendi değeri
                    g = _ST_DEG.setdefault((_kod, c), {"kod": _kod, "feat": c, "ist": {}, "kaynak": "DSN", "tur": "sayısal"})
                    g.setdefault("dsn_m", {}).setdefault(pk[x]["ad"], {})[d] = ist
        del rows
        _log(f"   renk {_kod} {d}: {_adet(int(((_ST_RENK_A == _kod) & (_ST_DONEM_A == d) & _ST_KK_A).sum()))} müşteri | "
             + (f"hesaplandı ({time.time() - _t0:.0f} sn)" if _hesap else "bellekten"))
    for (k, c), g in _ST_DEG.items():                         # DSN: en çok kayan modelin değerleri, bütün dönemlerde aynı model
        if k == _kod and g.get("dsn_m"):
            g["ist"] = dict(max(g["dsn_m"].values(), key=lambda s: max(
                [i["csi"] for i in s.values() if np.isfinite(i["csi"])], default=-1.0)))
    for x, m in pk.items():                                   # hangi değişken hangi modele girmiş
        for c in m["p"]["features"]:
            g = _ST_DEG.get((_kod, c))
            if g is not None:
                g.setdefault("modeller", []).append(m["ad"])
        if m["skor"]:
            _ST_MOD.append({"kod": _kod, "ad": m["ad"], "v": m["v"], "a": m["a"], "skor": m["skor"]})
    del pk
for _m in _st_atlanan:
    _log(f"   ⚠ {_m}")
if not _ST_DEG:
    raise RuntimeError("Hiçbir değişken için stabilite hesaplanamadı (yukarıdaki uyarılara bakın).")


