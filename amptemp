                    ("TOPLAM satırı", "İki taraftaki toplam oranlar (base rate). Birbirine yakın olmalı; uzaksa iki kitle/hedef tanımı farklıdır."),
                ])
            _tablo_bicim(ws, _bloklar[0].columns, _ILK_SATIR, r)
            ws.freeze_panes = ws.cell(row=_ILK_SATIR + 1, column=1)

        # ---- 4) KAÇAN DİLİM ----
        for _don, _c in analiz_ciktilar.items():
            if _c["kacan"].empty:
                continue
            _sheet_yaz(xl, f"KACAN_DILIM_OOT_{_don}", _c["kacan"],
                f"KAÇAN DİLİM (OOT {_don}): Model ile mevcut skor farklı kişileri riskli dediğinde hangisi haklı?",
                [
                    "KİTLE: " + _KITLE_ORTAK + " DAVRANIŞ ve MÜŞTERİ satırlarının kitlesi aynıdır.",
                    f"İki skor da kitlenin en riskli %{_RISKLI_YZD}'sini 'riskli' sayar. Listeler aynı büyüklükte olduğundan farklı kalan kişiler iki eşit gruba ayrılır.",
                    "Bu iki grubun HEDEF ORANI'nı karşılaştırın: oranı yüksek olan grup haklı skoru gösterir.",
                    f"KAZANAN: NET EK VAKA / KİTLE VAKA mutlak değerce {_yzd(ESIK_BERABER_PAY)} veya altındaysa BERABER, değilse işarete göre MODEL / MEVCUT SKOR.",
                    "Eşik yok: PRED (0/1) değil, model skorunun sıralaması kullanılır.",
                ],
