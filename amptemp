import gc
import io
import re
import time
import warnings

import numpy as np
import pandas as pd
import psutil
import pyarrow.dataset as pads
import pyarrow.fs as pafs
import dataiku

warnings.filterwarnings("ignore", category=pd.errors.PerformanceWarning)

GIRDI_DATASETLER  = ["FPD_TXN_FEATS_2025", "FPD_TXN_FEATS_2026"]
CIKTI_DATASET     = "FPD_TXN_FEATS_ENH"
FEATURE_KLASOR    = "COMPLETE_JSON"
FEATURE_DOSYA     = "feature_birlesik.xlsx"
ALINACAK_DURUMLAR = {"KABUL"}            # RED'ler de istenirse: {"KABUL", "RED"}
S3_ENDPOINT       = "loscdlhp.aknet.akb:9000"   # RENK_GOC_MODEL notebook'undakiyle ayni olmali
DONEM_KOL         = "PERIOD"
BOS_DEGERLER      = {"", "-", "nan", "none", "null"}
YASAK_KALIPLAR    = ["import", "__", "exec(", "eval(", "open(", "lambda"]


def ram(etiket=""):
    vm = psutil.virtual_memory()
    print(f"RAM {etiket}: {vm.used/1e9:.0f} / {vm.total/1e9:.0f} GB (%{vm.percent:.0f} dolu) | bos: {vm.available/1e9:.0f} GB")


ram("baslangic")








def sema_bilgisi(ad):
    d = dataiku.Dataset(ad)
    names, dtypes, date_idx = d.get_dataframe_schema_st(d.read_schema(), int_as_float=True)
    date_cols = {names[i] for i in date_idx} if date_idx else set()
    return names, dtypes, date_cols


sema = {ad: sema_bilgisi(ad) for ad in GIRDI_DATASETLER}
ortak_set = set.intersection(*(set(s[0]) for s in sema.values()))
ortak = [c for c in sema[GIRDI_DATASETLER[0]][0] if c in ortak_set]

print(f"Ortak kolon: {len(ortak):,}")
for ad, (names, _, _) in sema.items():
    disarida = [c for c in names if c not in ortak_set]
    print(f"[{ad}] toplam {len(names):,} kolon | disarida kalan: {len(disarida)} {disarida[:20]}")

if DONEM_KOL not in ortak_set:
    raise ValueError(f"{DONEM_KOL} iki dataset'te ortak degil.")












def oku(ad):
    t0 = time.time()
    d = dataiku.Dataset(ad)
    info = d.get_location_info(sensitive_info=True)["info"]
    cp = info["connectionParams"]
    root = info["path"].replace("s3://", "")
    s3 = pafs.S3FileSystem(
        access_key=cp["accessKey"],
        secret_key=cp["secretKey"],
        endpoint_override=S3_ENDPOINT,
        scheme="https",
        force_virtual_addressing=False,
    )
    dset = pads.dataset(root, filesystem=s3, format="parquet")
    df = dset.to_table(columns=ortak, use_threads=True).to_pandas(self_destruct=True, split_blocks=True)

    _, dtypes, date_cols = sema[ad]
    cast = {c: dtypes[c] for c in ortak if c in dtypes and c not in date_cols}
    df = df.astype(cast)[ortak]

    print(f"[{ad}] {df.shape[0]:,} satir x {df.shape[1]:,} kolon | {time.time() - t0:.0f} sn | "
          f"bellek {df.memory_usage(deep=True).sum()/1e9:.1f} GB")
    ram(f"({ad} sonrasi)")
    return df


df_2025 = oku("FPD_TXN_FEATS_2025")
df_2026 = oku("FPD_TXN_FEATS_2026")












d25 = set(df_2025[DONEM_KOL].dropna().unique())
d26 = set(df_2026[DONEM_KOL].dropna().unique())
print(f"2025 donemleri: {sorted(d25)}")
print(f"2026 donemleri: {sorted(d26)}")
if d25 & d26:
    print(f"UYARI: iki dataset'te de bulunan donemler: {sorted(d25 & d26)}")

df = pd.concat([df_2025, df_2026], ignore_index=True)
del df_2025, df_2026
gc.collect()

print(f"\nBirlesik df: {df.shape[0]:,} satir x {df.shape[1]:,} kolon")
print(df[DONEM_KOL].value_counts().sort_index().to_string())
ram("(birlesim sonrasi)")
















klasor = dataiku.Folder(FEATURE_KLASOR)
with klasor.get_download_stream(FEATURE_DOSYA) as s:
    fx = pd.read_excel(io.BytesIO(s.read()), sheet_name=0)
fx.columns = [str(c).strip() for c in fx.columns]

eksik = {"ad", "formul", "durum"} - set(fx.columns)
if eksik:
    raise ValueError(f"Excel'de beklenen kolon(lar) yok: {eksik}. Mevcut: {list(fx.columns)}")


def bos_mu(x):
    return pd.isna(x) or str(x).strip().lower() in BOS_DEGERLER


fx = fx[fx["durum"].astype(str).str.strip().str.upper().isin(ALINACAK_DURUMLAR)]
fx = fx[~fx["formul"].apply(bos_mu) & ~fx["ad"].apply(bos_mu)].copy()
fx["ad"] = fx["ad"].astype(str).str.strip()
fx["formul"] = fx["formul"].astype(str).str.strip()


def on_kontrol(ad, formul):
    """Formulu calistirmadan once kontrol eder. Sorun yoksa None, varsa neden."""
    if ad in df.columns:
        return "bu isimde kolon zaten var"
    if any(k in formul for k in YASAK_KALIPLAR):
        return "formulde yasak kalip var"
    kullanilan = re.findall(r"df\[\s*['\"]([^'\"]+)['\"]\s*\]", formul)
    yok = [k for k in kullanilan if k not in df.columns]
    if yok:
        return f"veride olmayan kolon: {yok}"
    return None


fx["on_kontrol"] = [on_kontrol(a, f) for a, f in zip(fx["ad"], fx["formul"])]
tekrar_ad = fx["ad"][fx["ad"].duplicated()].tolist()
if tekrar_ad:
    print(f"UYARI: Excel'de birden fazla gecen isimler: {tekrar_ad}")

print(f"Toplam tanim: {len(fx)} | on kontrolden gecen: {fx['on_kontrol'].isna().sum()}")
display(fx[["ad", "tema", "formul", "on_kontrol"]] if "tema" in fx.columns else fx[["ad", "formul", "on_kontrol"]])




















def hesapla(formul):
    """Formulu birlesik df uzerinde calistirir. Donus: (seri, None) veya (None, hata)."""
    try:
        sonuc = eval(formul, {"__builtins__": {}}, {"df": df, "np": np, "pd": pd})
        if np.isscalar(sonuc):
            return None, "formul tek bir sayi dondurdu (seri degil)"
        seri = sonuc if isinstance(sonuc, pd.Series) else pd.Series(np.asarray(sonuc), index=df.index)
        if len(seri) != len(df):
            return None, f"uzunluk uyusmuyor ({len(seri)} != {len(df)})"
        seri = pd.to_numeric(seri, errors="coerce").replace([np.inf, -np.inf], np.nan).astype("float64")
        return seri, None
    except Exception as e:
        return None, f"{type(e).__name__}: {e}"


def dene(ad):
    """Tek bir feature'i hesaplayip ozetini gosterir; df'e EKLEMEZ."""
    satir = fx[fx["ad"] == ad]
    if satir.empty:
        print(f"{ad} Excel'de yok.")
        return None
    formul = satir["formul"].iloc[0]
    print(f"{ad}\nformul: {formul}")
    seri, hata = hesapla(formul)
    if hata:
        print(f"HATA: {hata}")
        return None
    print(f"dolu oran: %{seri.notna().mean()*100:.1f}")
    print(seri.describe().to_string())
    print("\nDonem bazinda ortalama:")
    print(seri.groupby(df[DONEM_KOL]).mean().to_string())
    return seri


# Ornek: ilk gecerli feature'i dene
ilk_ad = fx.loc[fx["on_kontrol"].isna(), "ad"].iloc[0]
_ = dene(ilk_ad)













yeni = {}
rapor = []
t0 = time.time()

for ad, formul, on_hata in zip(fx["ad"], fx["formul"], fx["on_kontrol"]):
    if on_hata:
        rapor.append({"ad": ad, "sonuc": "ELENDI", "neden": on_hata})
        continue
    if ad in yeni:
        rapor.append({"ad": ad, "sonuc": "ELENDI", "neden": "Excel'de tekrar eden isim"})
        continue
    seri, hata = hesapla(formul)
    if hata:
        rapor.append({"ad": ad, "sonuc": "HATA", "neden": hata})
        continue
    dolu = float(seri.notna().mean())
    mn, mx = (seri.min(), seri.max()) if dolu > 0 else (np.nan, np.nan)
    uyari = "tamamen NaN" if dolu == 0 else ("sabit deger" if mn == mx else "")
    rapor.append({"ad": ad, "sonuc": "OK", "neden": uyari,
                  "dolu_oran_yuzde": round(dolu * 100, 1), "min": mn, "max": mx})
    yeni[ad] = seri

rapor_df = pd.DataFrame(rapor)
print(f"Uretilen: {len(yeni)} / {len(fx)} | {time.time() - t0:.0f} sn")
print(rapor_df["sonuc"].value_counts().to_string())
ram("(feature sonrasi)")
display(rapor_df)













df_enh = pd.concat([df, pd.DataFrame(yeni, index=df.index)], axis=1)
del yeni
gc.collect()

print(f"Cikti: {df_enh.shape[0]:,} satir x {df_enh.shape[1]:,} kolon "
      f"({df.shape[1]:,} ortak + {df_enh.shape[1] - df.shape[1]} yeni)")
ram("(ekleme sonrasi)")













t0 = time.time()
dataiku.Dataset(CIKTI_DATASET).write_with_schema(df_enh)
print(f"{CIKTI_DATASET} yazildi | {time.time() - t0:.0f} sn")
