:root {
  /* ===== YAZI OLCEGI - tum arayuz yalnizca bu degerleri kullanir =====
     Tek font: Calibri (urun adindaki font).
     Olcek, onceki tasarimin %80 zoom halidir; ama tarayici zoom'u
     boyutlari kuruslu yapar (14px -> 11.2px) ve Calibri Windows'ta
     kuruslu boyutta bulanik cizilir. Bu yuzden TUM boyutlar tam piksel.
     Yeni bir boyut eklersen de tam piksel ver.
     Calibri'de yalnizca 3 agirlik var: 300 (Light), 400 (Regular),
     700 (Bold). Bu yuzden yalnizca --fw-normal ve --fw-kalin kullanilir.
     Buyuk harf CSS ile DEGIL, HTML/Python'da yazilir (Turkce I/İ). */
  --fs-kucuk:  11px;     /* faz no, sayac, durum cipi */
  --fs-etiket: 12px;     /* BUYUK HARFLI kirmizi etiketler: ANALİTİK SÜREÇ, VERİ SETİ... */
  --fs-govde:  12px;     /* metin, butonlar */
  --fs-baslik: 13px;     /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  15px;     /* urun adi, sayfa basligi */

  --fw-normal: 400;
  --fw-kalin:  700;

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  /* Buyuk harf araligi: az tutuldu, Calibri'nin dar buyuk harfleri
     acildikca seyrek ve farkli bir font gibi gorunuyor */
  --etiket-aralik: .02em;

  /* ===== BILESEN SISTEMI - kose, bosluk, yukseklik, golge ===== */
  --r:         6px;      /* kart, balon, buton, giris kutusu */
  --r-kucuk:   5px;      /* sekme, cip, liste ogesi, ic alan */
  --b-1: 3px;  --b-2: 6px;  --b-3: 10px;  --b-4: 13px;  --b-5: 16px;  --b-6: 19px;
  --btn-h:     29px;     /* tum ana butonlar */
  --btn-h-kucuk: 24px;   /* ikon butonlari, Gonder */
  --serit:     3px;      /* kart solundaki marka vurgu cubugu */
  --halka:     2px;      /* odak ve hover halkasi kalinligi */
  --golge-1:   0 1px 2px rgba(16,24,40,.06);
  --golge-2:   0 5px 13px rgba(16,24,40,.10);

  /* ===== RENK - zemin notr, kirmizi yalnizca vurgu ===== */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-acik: #FDF1F1;
  --kirmizi-halka: rgba(213,17,21,.16);

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #F9FAFB;
  --kenar:        #DDE1E6;          /* kart, balon, form kenarlari */
  --kenar-guclu:  #BFC5CE;
  --kenar-acik:   #EDEFF2;
  /* Yalnizca 3 yapisal ayrac: ust bar alti, sol panel sagi, sag panel solu.
     Notr (mavimsi degil) ve saydam: hangi zeminde olursa olsun hafif kalir. */
  --ayrac:        rgba(0,0,0,.08);

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.66);

  --user-zemin:   #EEF0F3;          /* kullanici balonu: bot'tan ayrissin */

  --gonder-zemin: #111111;
  --gonder-metin: #FFFFFF;

  /* ===== SOHBET ARKA PLANI =====
     Gorsel JS'ten gelir. Uzerinde zemin renginde bir perde var.
     --sohbet-perde-gucu:    acilistaki perde. 0 = gorsel tamamen gorunur,
                             1 = gorsel hic gorunmez
     --sohbet-perde-calisma: sohbet basladiktan sonraki (en az 2 mesaj) perde.
                             Acilista gorsel belirgin, calisirken sakin kalir.
                             Hep ayni kalsin istersen --sohbet-perde-gucu ile
                             ayni degeri ver.
     --sohbet-bulanik:       0px = bulaniklik yok; 4px, 8px... arttikca bulanir */
  --sohbet-gorsel: none;
  --sohbet-perde-gucu:    .42;
  --sohbet-perde-calisma: .8;
  --sohbet-bulanik:       13px;

  --yesil:        #0E8A52;
  --yesil-acik:   #E6F4EC;
  --amber:        #B45309;
  --amber-acik:   #FEF3C7;
  --amber-halka:  rgba(217,119,6,.30);
  --sari:         #EAB308;
  --sari-koyu:    #000000;          /* sari zemin ustundeki metin rengi */
  --sari-acik:    #FDF6D3;

  /* Iki panel de bir tik genisletildi (208/19/264 ve 304/29/432 idi).
     Uc degeri birden buyutmek gerekiyor: yalniz max buyutulurse genis
     ekranda genisler ama 1024-1100 arasinda hicbir sey degismez, cunku
     orada vw degeri kazaniyor. Min degerler olculu artirildi: cekmece
     esigi 944/864px ve orada iki panel yan yana duruyor — min'ler fazla
     buyurse sohbet sutunu okunamayacak kadar daralir. */
  /* Sol panel: dar ekranda 224px, genis ekranda en fazla 296px */
  --panel-en:   clamp(224px, 21vw, 296px);
  /* Sag panel: dar ekranda 328px, genis ekranda en fazla 480px */
  --analiz-en:  clamp(328px, 32vw, 480px);
  /* Ust bar yuksekligi; logo buna gore olceklenir.
     70px'ti: sekiz sayfa once kartlara dorduncu satir (.ozet-alt)
     eklenince icerik 75px'e cikti ve son satir barin altindan
     TASIYORDU (overflow gorunur oldugu icin kirpilmiyor, alttaki
     panelin uzerine biniyordu). Olculen ihtiyac 75px; 78px pay
     birakiyor. Dorduncu satiri buyutursen burayi da buyut. */
  --ustbar-h:   78px;
  --sohbet-yan: 19px;

  /* SOHBETIN TEK GENISLIGI. Ust sinir degil, SABIT genislik: bot
     balonu, kullanici balonu ve sohbete dusen kartlar (.secim-kart,
     .dg-kart, kok seviyesindeki .secenek-kok) hepsi bu degeri alir.
     Icerik kisa olsa da genislik korunur; ekranda tek bir ritim kalir,
     balonlar icerige gore surekli daralip genislemez. */
  /* BLOKLAR EŞİT VE TAM GENİŞLİK: sohbet sütununun tamamını kaplarlar.
     Eskiden min(78%, 720px) idi ve kartlar kendi genişliklerini
     koyduğu için ekranda üç farklı blok eni yan yana duruyordu. */
  --balon-en:     100%;
  --avatar-en:    34px;          /* sohbet avatarı: bot / kullanıcı */
  --avatar-ara:   10px;          /* avatar ile blok arası */
  /* Ardisik balonlar arasindaki SABIT dikey aralik. Bot/kullanici,
     balon/kart ayrimi gozetmeden hepsi ayni bosluga sahip. */
  --balon-ara:    var(--b-4);
  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami.
     Avatar kalktigi icin artik sol girinti yok. */
  --govde-en:     100%;
}

/* -------- KOYU TEMA -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #E03B3E;
  --kirmizi-acik: #2A1517;
  --kirmizi-halka: rgba(255,77,79,.22);

  --zemin:        #111111;
  --yuzey:        #181818;
  --yuzey-alt:    #141414;
  --kenar:        #2E2E2E;
  --kenar-guclu:  #454545;
  --kenar-acik:   #232323;
  --ayrac:        rgba(255,255,255,.10);

  --metin:        #FFFFFF;
  --metin-soluk:  rgba(255,255,255,.68);

  --user-zemin:   #262626;

  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;

  --golge-1:   0 1px 2px rgba(0,0,0,.5);
  --golge-2:   0 5px 13px rgba(0,0,0,.55);

  --yesil:        #3DDC8A;
  --yesil-acik:   #10281B;
  --amber:        #F5B042;
  --amber-acik:   #2A2210;
  /* Koyu zeminde uyari halkasi acik temadaki degerle neredeyse gorunmezdi */
  --amber-halka:  rgba(245,176,66,.42);
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: var(--font);
  font-size: var(--fs-govde);
  font-weight: var(--fw-normal);
  line-height: 1.5;
  /* Rakamlar: satir hizasinda (lining) ve esit genislikte (tabular) */
  font-variant-numeric: lining-nums tabular-nums;
  text-rendering: optimizeLegibility;
  transition: background .2s, color .2s;
}
#kabuk *, #kabuk button, #kabuk input, #kabuk textarea {
  font-family: var(--font);
}
[hidden] { display: none !important; }

/* Doküman başlığı: ürün adıyla aynı boyut, şeridin solunda */
.dok-baslik {
  margin: 0;
  font-size: var(--fs-buyuk); font-weight: var(--fw-kalin);
  letter-spacing: .03em; line-height: 1.3;
  color: var(--kirmizi);
}

/* Kirmizi etiketler: ANALİTİK SÜREÇ, İŞ AKIŞI, VERİ SETİ, SÖZLÜK...,
   dokuman bolum basliklari. Urun adiyla ayni font, agirlik ve renk.
   Renk dogrudan --kirmizi: koyu temada otomatik acik kirmiziya doner.
   Hizalamayi bulunduklari kutu belirler. */
.panel-baslik, .ozet-etiket, .dok-bolum-baslik {
  font-size: var(--fs-etiket); font-weight: var(--fw-kalin);
  letter-spacing: var(--etiket-aralik); line-height: 1.3;
  color: var(--kirmizi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(11px, 1.6vw, 21px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--ayrac); flex-shrink: 0;
  gap: clamp(11px, 1.6vw, 22px);
}
#ustbar-sol { display: flex; align-items: center; gap: var(--b-4); flex-shrink: 0; }
#banner { height: calc(var(--ustbar-h) - 19px); width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: var(--b-4); line-height: 1.3; }
#urun-adi-satir { display: flex; align-items: center; gap: var(--b-2); min-width: 0; }
#urun-adi {
  font-weight: var(--fw-kalin); font-size: var(--fs-buyuk); letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
/* Seçili veri seti ve sözlük: başlığın yanında iki küçük çip.
   Üst şerit kaldırıldı (dört kartın dördü de başka bir panelin
   tekrarıydı); geriye kalan tek kimlik bilgisi bu iki ad. */
.ust-cip {
  max-width: 15ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  padding: 1px var(--b-2); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); background: var(--kenar-acik);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin); color: var(--metin-soluk);
}
.ust-cip[hidden] { display: none; }
#urun-alt {
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  margin-top: 2px; white-space: nowrap;
}

/* Üst şerit: dört kart, VERİ → ELEME → ÜRETİM → MODEL.
   Kırmızı etiket, koyu değer, iki gri alt satır; ulaşılmamış değer ∅. */
#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik);
  border-right: 1px solid var(--kenar-acik);
}
/* Dort satir (etiket / deger / ust / alt) dikeyde ORTALANIR.
   Kolon flex olmasaydi button.ozet-kart'in height:100% kurali satirlari
   ustten hizalar, fazlalik da asagi tasardi. */
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(8px, 1.2vw, 16px);
  border-right: 1px solid var(--kenar-acik);
  line-height: 1.3;
  text-align: center;
  display: flex; flex-direction: column; justify-content: center;
}
.ozet-kart:last-child { border-right: none; }
/* Tıklanabilir kart: düğme olarak çizilir ama görünüm aynı kalır.
   Yalnızca hover/odakta zemin değişir — şerit bir gezinme çubuğu
   gibi görünmesin, ama tıklanabildiği de belli olsun. */
button.ozet-kart {
  font: inherit; color: inherit; background: none;
  border-top: none; border-bottom: none; border-left: none;
  cursor: pointer; height: 100%;
}
button.ozet-kart:hover, button.ozet-kart:focus-visible {
  background: var(--kirmizi-acik);
}
button.ozet-kart:focus-visible {
  outline: var(--halka) solid var(--kirmizi-halka); outline-offset: -2px;
}
.ozet-etiket { display: block; margin-bottom: 2px; }
.ozet-deger {
  display: block;
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--metin-soluk); }
.ozet-ust, .ozet-alt {
  display: block; font-size: var(--fs-govde); color: var(--metin-soluk);
  margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 5px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: var(--b-2); }

#tema-btn, .cekmece-btn {
  display: flex; align-items: center; justify-content: center;
  width: 22px; height: 22px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: var(--r-kucuk); cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn svg, .cekmece-btn svg { width: 12px; height: 12px; }
#tema-btn:hover, .cekmece-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

/* Yeni çalışma düğmesi: Dataiku'nun kendi REFRESH düğmesi bunun hemen
   üstünde duruyor ve ikon tek başına ikisini ayırt etmiyordu. Görünür
   etiket ve daha geniş gövde kasıtlı: komşusuna benzemesin. */
#sifirla-btn {
  display: flex; align-items: center; gap: 5px;
  height: 22px; padding: 0 var(--b-2);
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: var(--r-kucuk); cursor: pointer; color: var(--metin);
  flex-shrink: 0; font-family: var(--font);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); white-space: nowrap;
}
/* SVG ikon: yüksekliği düğmenin metin satırına oturur. width/height
   birlikte verilmezse Safari intrinsic boyut uydurup ikonu şişiriyor. */
#sifirla-btn .sifirla-ikon {
  width: 14px; height: 14px; display: block; flex-shrink: 0;
  color: inherit;   /* currentColor hover kırmızısını da izlesin */
}
#sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
/* Çekmece düğmeleri yalnızca panelin gizlendiği dar ekranlarda görünür */
.cekmece-btn { display: none; }

/* "Yeni Çalışma" düğmesiyle AYNI kutu: aynı yükseklik, kenar, yarıçap ve
   zemin. Rozet çıplak metinken komşusunun yanında hizasız duruyordu ve
   ikisi tek bir öbek gibi okunmuyordu. Tıklanabilir DEĞİL (düğme değil,
   span) — imleç de değişmiyor, bu yüzden düğme sanılmıyor. */
#durum-rozet {
  display: inline-flex; align-items: center; gap: 6px;
  height: 22px; padding: 0 var(--b-2); flex-shrink: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--yesil); display: inline-block; flex-shrink: 0;
}
/* Rozet son isteğin sonucunu gösterir: backend cevap vermiyorsa yeşil kalmaz */
#durum-rozet.mesgul .nokta-yesil { background: var(--sari); }
#durum-rozet.hata   .nokta-yesil { background: var(--kirmizi); }
#durum-rozet.hata { color: var(--kirmizi); }

#sekmeler {
  display: flex; gap: 2px; padding: 2px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: var(--r);
}
.sekme {
  flex: 1; height: 22px; padding: 0 var(--b-5);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: var(--etiket-aralik);
  border: none; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif { background: var(--kirmizi); color: #fff; }

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none !important; }   /* #sayfa-calisma'nin display:flex'ini ezer */
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--ayrac);
  padding: var(--b-5) var(--b-4) 22px; overflow-y: auto;
}

.panel-blok { margin-bottom: var(--b-6); }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik { margin-bottom: var(--b-3); }
.panel-metin {
  margin: 0 0 var(--b-3); font-size: var(--fs-govde); line-height: 1.6; color: var(--metin);
  text-indent: 0;                 /* paragraf basi girintisi yok; istersen 1.5em */
}
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı -------- */
.faz { margin-bottom: 2px; }
/* baseline: ok, numara, ad ve sayac ayni yazi cizgisine oturur */
/* <button>: klavye kullanicisi de fazi acabilsin (Enter/Space dogal) */
.faz-bas {
  position: relative; overflow: hidden;
  display: flex; align-items: baseline; gap: var(--b-2);
  padding: var(--b-2); border-radius: var(--r); cursor: pointer;
  color: var(--metin);
  width: 100%; border: none; background: none; text-align: left;
  font-family: inherit; font-size: var(--fs-govde); line-height: 1.5;
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz-bas:focus-visible {
  outline: none; background: var(--kenar-acik);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
/* ÇALIŞILAN FAZ SARI, GEÇİLEN FAZ YEŞİL.
   Kutu içi sarı zemin (--sari-acik) + sarı/kehribar yazı; solda kalın
   sarı çubuk. Yazı için --sari DEĞİL --amber kullanılıyor: #EAB308
   dolgu olarak iyi ama beyaz zeminde metin olunca kontrast ~1,9:1,
   okunmuyor. --amber aynı sarı/kehribar ailesinden, okunabilir ve koyu
   temada kendi karşılığına (#F5B042) dönüşüyor. */
.faz.aktif > .faz-bas {
  background: var(--sari-acik); color: var(--amber);
  font-weight: var(--fw-kalin);
}
.faz.aktif > .faz-bas .faz-ozet { color: var(--amber); }
.faz.aktif > .faz-bas::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--sari);
}
/* Geçilen faz: aynı kutu yeşile döner. */
.faz.tamam > .faz-bas { background: var(--yesil-acik); color: var(--yesil); }
.faz.tamam > .faz-bas .faz-ozet { color: var(--yesil); }
.faz.tamam > .faz-bas::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--yesil);
}

.faz-ok {
  flex-shrink: 0; width: 8px; text-align: center;
  font-size: var(--fs-govde); transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; min-width: 1.4em;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  color: inherit;                 /* fazin metin rengini alir: siyah / tamamlaninca yesil */
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); line-height: 1.35; color: inherit; }
.faz-ozet {
  font-size: var(--fs-govde); color: inherit; opacity: .72;
  margin-top: 2px; line-height: 1.45;
}
.faz-durum {
  flex-shrink: 0; font-size: var(--fs-kucuk);
  font-weight: var(--fw-kalin); cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 2px 0 var(--b-2) var(--b-3); padding: 0 0 0 var(--b-5);
  display: none; border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: var(--b-2);
  padding: 4px 5px; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 11px; height: 11px;
  border: 1px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 8px; font-weight: var(--fw-kalin);
}
/* Tamamlanan adim: yesil isaret VE yesil kalin yazi. Yazi ince kalinca
   isaretle ayni oge gibi okunmuyordu. */
.faz-adimlar li.tamam { color: var(--yesil); font-weight: var(--fw-kalin); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
/* Tamamlanan adım TIKLANABİLİR: doğrudan o adıma döner. Düğme gibi
   görünmüyor ama tıklanabilir olduğu imleçten ve üzerine gelince
   beliren zeminden anlaşılıyor — liste bir gezinme aracı, düğme
   tarlası değil. Renk ve kalınlık <li>'den miras alınır. */
.faz-adimlar li .adim-git {
  flex: 1 1 auto; min-width: 0; text-align: left;
  padding: 0; margin: 0; border: 0; background: none;
  font: inherit; color: inherit; cursor: pointer;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.faz-adimlar li.tamam:hover { background: var(--yesil-acik); }
.faz-adimlar li.aktif:hover { background: var(--sari-acik); }
/* Gelinmemiş adım tıklanmaz: imleç de öyle söylesin. */
.faz-adimlar li:not(.tamam):not(.aktif) { cursor: not-allowed; }
.faz-adimlar li .adim-git:focus-visible {
  outline: 2px solid var(--kirmizi); outline-offset: 2px; border-radius: 2px;
}
.faz-adimlar li .adim-git:disabled { cursor: not-allowed; opacity: .5; }
/* Calisan adim: yazi da isaretle ayni aileden, kalin.
   RENK NEDEN --sari DEGIL: isaretin dolgusu #EAB308 ve bu bir DOLGU
   olarak iyi duruyor, ama ayni sari beyaz zeminde METIN olunca kontrast
   ~1,9:1 — okunmuyor. --amber ayni sari/kehribar ailesinden ama
   okunabilir, ve koyu temada zaten kendi karsiligina (#F5B042)
   donusuyor. Isaret degismedi. */
.faz-adimlar li.aktif { color: var(--amber); font-weight: var(--fw-kalin); }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 var(--halka) var(--sari-acik);
}

/* ==================== ORTA: ÇALIŞMA ALANI ==================== */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--zemin);
  opacity: var(--sohbet-perde-gucu);
  backdrop-filter: blur(var(--sohbet-bulanik));
  pointer-events: none;
  transition: opacity .5s ease;
}
/* Sohbet basladiginda (en az iki mesaj satiri) perde koyulasir.
   JS gerekmez; satirlar eklenince tarayici kendisi uygular. */
#sohbet-alani:has(.satir ~ .satir)::before {
  opacity: max(var(--sohbet-perde-gucu), var(--sohbet-perde-calisma));
}
#sohbet, #giris-bolge { position: relative; z-index: 1; }

/* Kaydirma YALNIZCA burada */
#sohbet {
  flex: 1; overflow-y: auto;
  padding: var(--b-6) var(--sohbet-yan) var(--b-4);
  scrollbar-gutter: stable;
}

/* Iki kenar, tek genislik. AVATAR YOK: bot metninin sola yapismasini
   engelleyen tek sey oydu. Iki taraf artik yalnizca hizalama ve zemin
   rengiyle ayrisiyor (GORSEL.bot / GORSEL.user sabitleri ve /gorsel/*
   uclari duruyor — banner ayni uclari kullaniyor, balonlarda
   cizilmiyorlar). Dikey aralik --balon-ara ile sabit. */
.satir {
  display: flex; align-items: flex-start;
  margin: 0 0 var(--balon-ara);
  width: 100%; min-width: 0;
}

/* Sohbet avatarı: akışı ilerletenin bir robot olduğu görünür kalsın.
   Yüklenemezse JS kendini gizler (bkz. avatarYap); kırık resim ikonu
   olmayan bir şeyin yerini tutmaktan kötüdür. */
.balon-avatar {
  flex: 0 0 auto; width: var(--avatar-en); height: var(--avatar-en);
  border-radius: 50%; object-fit: cover;
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
}
/* Avatar yalnızca BOT adım bloklarında: akışı yürüten asistanı işaret
   eder. Kullanıcı mesajının ve hata bildiriminin avatarı yok. */
/* Sistem bildirimi: uygulamanın kendi satırı, asistanın cümlesi değil.
   Balon çerçevesi yok; soluk, ince ve sohbetin ritminden ayrı durur. */
.sistem-notu {
  margin: 0 0 var(--balon-ara);
  padding: var(--b-2) var(--b-3);
  border-left: 2px solid var(--kenar-guclu);
  background: var(--yuzey-alt);
  border-radius: 0 var(--r-kucuk) var(--r-kucuk) 0;
  font-size: var(--fs-kucuk); line-height: 1.55; color: var(--metin-soluk);
}
.sistem-notu strong { color: var(--metin); font-weight: var(--fw-kalin); }
.sistem-notu p { margin: 0; }
.sistem-notu p + p { margin-top: 3px; }
.satir.bot       { justify-content: flex-start; }
.satir.kullanici { justify-content: flex-end; }

/* Balon metni kadar UZAR ama genisligi sabittir; yukseklik siniri ve
   ic kaydirma YOK */
.balon {
  min-width: 0; width: 100%;
  padding: var(--b-3) var(--b-4); border-radius: var(--r);
  font-size: var(--fs-govde); line-height: 1.6;
  white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;
}

/* -------- Bot kutusu: balon + (varsa) seçenek kartları -------- */
/* Sütun kalan genişliğin TAMAMINI alır: avatar iki tarafta da aynı yeri
   götürdüğü için bot ve kullanıcı blokları AYNI ende çıkar. */
.balon-sutun {
  display: flex; flex-direction: column; align-items: stretch;
  flex: 1 1 auto; width: auto; min-width: 0;
}

/* Bot: notr yuzey, marka yalnizca solda duz ince cubukta.
   Cubuk ayri ciziliyor; kenar yuvarlakligini takip edip kivrilmiyor. */
.satir.bot .balon {
  position: relative; overflow: hidden;
  width: 100%; max-width: 100%;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  padding-left: calc(var(--b-4) + var(--serit));
  box-shadow: var(--golge-1);
}
.satir.bot .balon::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
/* Secenek tasiyan balonda cubuk yok: kirmizi vurgu yalnizca
   tiklanabilir kartlarda kalir, bilgi metni ile secenekler ayrisir. */
.satir.bot .balon-sutun.secenekli .balon { padding-left: var(--b-4); }
.satir.bot .balon-sutun.secenekli .balon::before { display: none; }
.satir.bot .balon strong { font-weight: var(--fw-kalin); }

/* Kullanici balonu bot balonuyla AYNI genislikte; yalnizca saga
   yapisir ve zemin rengiyle ayrisir. */
.satir.kullanici .balon {
  width: 100%; flex: 1 1 auto;
  background: var(--user-zemin); color: var(--metin);
  border: 1px solid transparent;
}

.satir.bot .balon.hata {
  background: var(--kirmizi-acik); color: var(--kirmizi);
  border-color: var(--kirmizi);
}

/* -------- Seçenek kartları -------- */
.secenek-kok { display: flex; flex-direction: column; gap: var(--b-2); }
.balon-sutun .secenek-kok { width: 0; min-width: 100%; margin-top: var(--b-2); }
/* Balonsuz (kok seviyesinde) secenek kartlari da ayni sutunda,
   ayni genislikte ve sola yapisik basliyor. */
/* Kök seviyesindeki kartlar/ayraçlar da sütunun TAMAMINI kaplar:
   avatar artık bloğun içinde, girinti açmıyor. */
#sohbet > .secenek-kok,
#sohbet > .secim-kart,
#sohbet > .aksiyon-izi { width: auto; margin-left: 0; }
#sohbet > .secenek-kok { margin-bottom: var(--balon-ara); margin-top: 0; }

.secenek {
  position: relative; overflow: hidden;
  display: flex; align-items: center; gap: var(--b-3);
  padding: var(--b-3) var(--b-4) var(--b-3) calc(var(--b-4) + var(--serit));
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  cursor: pointer; text-align: left;
  font-size: var(--fs-govde);
  box-shadow: var(--golge-1);
  transition: border-color .15s, background .15s, box-shadow .15s, opacity .15s;
}
/* Tiklanabilir kart vurgusu: duz cubuk */
.secenek::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kirmizi);
}
.secenek:hover:not(:disabled) {
  border-color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.secenek:disabled { cursor: default; opacity: .45; }
.secenek.secili {
  opacity: 1; background: var(--kirmizi-acik);
  border-color: var(--kirmizi);
}

.secenek-rozet {
  flex-shrink: 0; width: 22px; height: 22px;
  background: var(--zemin); color: var(--metin);
  border: 1px solid var(--kenar); border-radius: 50%;
  font-weight: var(--fw-kalin); font-size: var(--fs-govde);
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, color .15s, border-color .15s;
}
.secenek:hover:not(:disabled) .secenek-rozet,
.secenek.secili .secenek-rozet {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.secenek-govde { min-width: 0; flex: 1; }
.secenek-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); line-height: 1.35; }
.secenek-aciklama {
  font-size: var(--fs-govde); color: var(--metin-soluk);
  line-height: 1.5; margin-top: 2px;
}

/* -------- Seçim formu: dataset seçici -------- */
/* Sohbete dogrudan dusen kart: balonla AYNI genislikte ve sola
   yapisik — kart ile balon ayni sutunda basliyor. */
/* VERI TABLOSU TASIYAN KART BALON GENISLIGINDE DEGIL.
   Sohbet balonlari (bot/kullanici) tek ve sabit genislikte — ekranda
   ritim onunla kuruluyor. Ama dogrulama karti bir MESAJ degil, bes
   kolonlu bir karar tablosu: 720px'e sikistirilinca kategori listesi
   "Davraniss" diye, aciklama kutusu yarim gorunuyordu. Tablo tasiyan
   kart sohbet sutununun tamamini kullanir; hizasi yine sola yapisik,
   yani balonla ayni noktadan baslar. */
.secim-kart.dg-kart { width: 100%; }

.secim-kart {
  position: relative;
  width: auto; margin: 0 0 var(--balon-ara);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-radius: var(--r);
  padding: var(--b-4) var(--b-5) var(--b-5) calc(var(--b-5) + var(--serit));
  box-shadow: var(--golge-1);
}
/* overflow:hidden YOK - acilir liste kartin disina tasabilmeli.
   Cubugun koseleri bu yuzden kendi yuvarlakligiyla kirpiliyor. */
.secim-kart::before {
  content: ""; position: absolute; left: -1px; top: -1px; bottom: -1px;
  width: var(--serit); background: var(--kirmizi);
  border-radius: var(--r) 0 0 var(--r);
}
.secim-kart.kilitli { opacity: .7; }

.secim-baslik { font-weight: var(--fw-kalin); font-size: var(--fs-baslik); margin-bottom: 2px; }

/* Baslik satiri: baslik solda, durum gostergesi sagda */
.secim-bas {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3);
}
/* DUGME DEGIL: bir <span>. Imleci degismez, hover'i yok, basilamaz.
   Eskiden bu bilgi "Seçildi ✓" diye birincil dugmenin uzerine
   yaziliyordu ve basilabilir gorunuyordu. Yeni renk YOK: notr durumda
   --metin-soluk, hazir durumda mevcut --yesil ailesi. */
.secim-durum {
  flex-shrink: 0; white-space: nowrap;
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  color: var(--metin-soluk);
  border: 1px solid var(--kenar); border-radius: 999px;
  padding: 1px 8px; background: var(--yuzey-alt);
}
.secim-durum.hazir {
  color: var(--yesil); background: var(--yesil-acik); border-color: var(--yesil);
}
.secim-durum:empty { display: none; }
.secim-aciklama {
  font-size: var(--fs-govde); line-height: 1.6;
  margin-bottom: var(--b-4); color: var(--metin-soluk);
}

/* Sözlük teyidi kartının tek satırlık özeti: sayılar, cümle değil.
   Doğrulama kartının bloklu özetiyle karışmasın diye ayrı sınıf. */
.teyit-ozet {
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  margin-bottom: var(--b-4); padding-left: var(--b-2);
  border-left: 2px solid var(--kenar-guclu);
}

.secim-govde { display: flex; gap: var(--b-3); flex-wrap: wrap; margin-bottom: var(--b-4); }
.secim-govde .combo { flex: 1; min-width: 160px; }

.secim-satir { display: flex; gap: var(--b-2); align-items: flex-end; margin-bottom: var(--b-3); }
.secim-satir .combo { flex: 1; }

.combo { position: relative; }
.combo label {
  display: block; font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  margin-bottom: var(--b-1); color: var(--metin);
}
.combo-giris {
  width: 100%; height: var(--btn-h); padding: 0 var(--b-3);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde);
  outline: none; background: var(--yuzey); color: var(--metin);
  transition: border-color .15s, box-shadow .15s;
}
.combo-giris::placeholder { color: var(--metin-soluk); }
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }
.combo-giris:disabled { background: var(--yuzey-alt); color: var(--metin-soluk); }

/* Alanın altındaki tek satırlık açıklama: listenin neye göre daraltıldığı
   ("Yalnızca 0/1 değerli kolonlar"). Kullanıcı listede aradığı kolonu
   bulamayınca cevabı burada bulmalı. Uyarı hâli (daraltılamadı) amber. */
.alan-not {
  margin-top: var(--b-1);
  font-size: var(--fs-kucuk); line-height: 1.35; color: var(--metin-soluk);
}
.alan-not-uyari { color: var(--amber); }

/* Listeyi acan ok dugmesi. Liste artik odaklaninca kendiliginden
   acilmiyor; gorunur tek acma yolu bu (klavye: ArrowDown). */
.combo { position: relative; }
/* Giriş + ok düğmesi + açılır liste TEK kapsayıcıda; konumlandırma
   buna göre yapılır. Açıklama satırı (.alan-not) dışarıda kalır, yoksa
   .combo uzayıp ok düğmesini ve listeyi aşağı kaydırıyordu. */
.combo-alan { position: relative; }

.combo-ok {
  position: absolute; right: 1px; bottom: 1px;
  width: calc(var(--btn-h) - 2px); height: calc(var(--btn-h) - 2px);
  display: flex; align-items: center; justify-content: center;
  padding: 0; border: none; background: none; cursor: pointer;
  color: var(--metin-soluk); border-radius: var(--r-kucuk);
}
.combo-ok:hover { color: var(--kirmizi); background: var(--kirmizi-acik); }
.combo-ok svg { transition: transform .15s; }
.combo:has(.combo-liste.acik) .combo-ok svg { transform: rotate(180deg); }
.combo:has(.combo-liste.acik) .combo-ok { color: var(--kirmizi); }
/* Ok dugmesi metnin ustune binmesin */
.combo-giris { padding-right: var(--btn-h); }
.combo-giris:disabled ~ .combo-ok { display: none; }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: var(--b-1) 0 0; padding: var(--b-1); list-style: none;
  background: var(--yuzey); border: 1px solid var(--kenar);
  border-radius: var(--r); box-shadow: var(--golge-2);
  max-height: 208px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
/* Sohbet alani kaydirilabilir oldugu icin kart hep en altta kalir;
   asagi sigmayan liste YUKARI acilir (JS olcup .yukari ekler). */
.combo-liste.yukari {
  top: auto; bottom: 100%;
  margin: 0 0 var(--b-1);
}
.combo-liste li {
  padding: 5px 8px; border-radius: var(--r-kucuk); cursor: pointer;
  font-size: var(--fs-govde); color: var(--metin);
}
.combo-liste li:hover,
.combo-liste li.vurgu { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; color: var(--metin-soluk); }
.combo-liste li.bos:hover { background: none; color: var(--metin-soluk); }

.secim-yuvarlak {
  flex-shrink: 0; width: var(--btn-h); height: var(--btn-h); padding: 0;
  border-radius: var(--r-kucuk); cursor: pointer;
  font-size: 15px; font-weight: var(--fw-kalin); line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.secim-yuvarlak:disabled { opacity: .4; cursor: not-allowed; }

.secim-yuvarlak.ekle { background: var(--kirmizi); color: #fff; border: none; }
.secim-yuvarlak.ekle:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.secim-yuvarlak.sil {
  width: 20px; height: 20px; font-size: 12px;
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
}
.secim-yuvarlak.sil:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}

.secim-rozetler { display: flex; flex-direction: column; gap: 5px; margin-bottom: var(--b-4); }
/* Uzun veri seti adi rozeti tasirip "−" butonunu ekran disina itmesin */
.secim-rozet {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); padding: 4px 5px 4px var(--b-3);
  font-size: var(--fs-govde);
  min-width: 0; max-width: 100%;
}
.secim-rozet > span {
  min-width: 0; flex: 1;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.secim-onay {
  height: var(--btn-h); padding: 0 var(--b-6);
  background: var(--kirmizi); color: #fff;
  border: none; border-radius: var(--r);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  cursor: pointer; white-space: nowrap;
}
.secim-onay:hover:not(:disabled) { background: var(--kirmizi-koyu); }
.secim-onay:disabled {
  background: var(--kenar-acik); color: var(--metin-soluk); cursor: not-allowed;
}
/* Ikincil (vazgec) dugmesi: onay kartinda kirmizinin yaninda notr durur */
.secim-onay.ikincil {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.secim-onay.ikincil:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}
.onay-dugmeler { display: flex; gap: var(--b-2); flex-wrap: wrap; }
/* Ucuncul (Geri): duz metin dugme - kirmizi/notr dugmelerin yaninda
   bir eylem degil, bir cikis gibi dursun */
.secim-onay.ucuncul {
  background: none; color: var(--metin-soluk);
  border: none; padding: 0 var(--b-3); font-weight: var(--fw-normal);
}
.secim-onay.ucuncul:hover:not(:disabled) {
  background: none; color: var(--kirmizi); text-decoration: underline;
}
.secim-onay.ucuncul:disabled { background: none; opacity: .5; }

/* -------- Girdi doğrulama kartı (secim_alani.tip = "dogrulama") --------
   YENI RENK DEGISKENI YOK: kart yalnizca mevcut paleti kullanir
   (--kirmizi, --amber, --yesil, --metin-soluk, --kenar...), bu yuzden
   koyu tema #kabuk.koyu altindaki degisken devriyle kendiliginden
   calisir. Onek: .dg-* ; govde mevcut .secim-* yapisini surdurur. */
/* Genisligi ve sol hizasi .secim-kart'tan gelir (--balon-en):
   dogrulama karti da balonla ayni sutunda, ayni genislikte durur.
   Bes kolonlu karar tablosu bu genislige table-layout:fixed ile
   sigiyor; --govde-en ile genisletme KALDIRILDI. */

.dg-bas {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3);
}
.dg-rozet {
  flex-shrink: 0;
  background: var(--yesil-acik); color: var(--yesil);
  border: 1px solid var(--yesil); border-radius: 999px;
  padding: 1px 8px; white-space: nowrap;
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
}
.dg-aciklama { margin-bottom: var(--b-3); }

.dg-ozet { display: flex; flex-wrap: wrap; gap: var(--b-2); margin-bottom: var(--b-3); }
.dg-ozet-blok {
  flex: 1 1 200px; min-width: 0;
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); padding: var(--b-2) var(--b-3);
}
.dg-ozet-etiket {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
  text-transform: uppercase; letter-spacing: var(--etiket-aralik);
}
/* Uzun veri seti adi blogu tasirmasin */
.dg-ozet-deger {
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dg-ozet-alt { font-size: var(--fs-kucuk); color: var(--metin-soluk); line-height: 1.5; }

.dg-kapsam { margin-bottom: var(--b-4); }
.dg-cubuk {
  height: 5px; border-radius: 999px;
  background: var(--kenar-acik); overflow: hidden;
}
.dg-cubuk-dolu { height: 100%; border-radius: 999px; background: var(--amber); }
.dg-cubuk-dolu.dg-tam { background: var(--yesil); }
.dg-kapsam-metin {
  margin-top: var(--b-1); font-size: var(--fs-kucuk); color: var(--metin-soluk);
}

.dg-tablo-bas {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3); flex-wrap: wrap; margin-bottom: var(--b-1);
}
.dg-tablo-baslik { font-size: var(--fs-govde); font-weight: var(--fw-kalin); }
.dg-toplu { display: flex; gap: var(--b-2); }
.dg-toplu-btn {
  height: var(--btn-h-kucuk); padding: 0 var(--b-3);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-kucuk); cursor: pointer; white-space: nowrap;
}
.dg-toplu-btn:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}
.dg-toplu-btn:disabled { opacity: .4; cursor: not-allowed; }

/* Kartın TEK not satırı (SÖZLEŞME7 §2): üç ayrı soluk paragraf
   (tablo açıklaması + kapsam notu + öneri notu) buraya indi. */
.dg-not {
  font-size: var(--fs-kucuk); color: var(--metin-soluk); line-height: 1.5;
  margin: var(--b-1) 0 var(--b-3); padding-left: var(--b-2);
  border-left: 2px solid var(--kenar-guclu);
}
/* Öneri alınamadıysa: uyarı tonu. Soluk gri bırakmak, bilgilendirme
   notuyla gerçek bir aksaklığı aynı ağırlıkta gösterirdi. */
.dg-oneri-hata {
  margin: 0 0 var(--b-3); padding: var(--b-2) var(--b-3);
  font-size: var(--fs-govde); line-height: 1.5;
  color: var(--amber); background: var(--amber-acik);
  border: 1px solid var(--amber); border-radius: var(--r-kucuk);
}
/* 200 satir cizilebilir: sanallastirma yok ama kart sohbeti yutmasin */
.dg-tablo-sar {
  max-height: 340px; overflow-y: auto;
  border: 1px solid var(--kenar); border-radius: var(--r-kucuk);
  margin-bottom: var(--b-3);
}
.dg-tablo {
  width: 100%; border-collapse: collapse; table-layout: fixed;
  font-size: var(--fs-govde);
}
.dg-tablo th {
  position: sticky; top: 0; z-index: 1;
  text-align: left; padding: 5px var(--b-2);
  background: var(--yuzey-alt); color: var(--metin-soluk);
  border-bottom: 1px solid var(--kenar);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  text-transform: uppercase; letter-spacing: var(--etiket-aralik);
  white-space: nowrap;
}
/* Dört kolon: Değişken | Tip | Açıklama | Sözlüğe Ekle.
   Açıklama kalan genişliği alır - kullanıcının YAZDIĞI kolon o, en
   geniş olmalı. Kutu kolonu sabit ve dar; başlık iki satıra sarabilir. */
.dg-tablo th:nth-child(1) { width: 28%; }
.dg-tablo th:nth-child(2) { width: 11%; }
.dg-tablo th:nth-child(4) { width: 62px; white-space: normal; }
.dg-tablo td {
  padding: 3px var(--b-2); border-bottom: 1px solid var(--kenar-acik);
  vertical-align: middle;
}
.dg-tablo tr:last-child td { border-bottom: none; }
/* Uzun kolon adi tabloyu tasirmasin; tamami ipucunda */
.dg-kolon {
  font-weight: var(--fw-kalin);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.dg-tip { color: var(--metin-soluk); font-size: var(--fs-kucuk); }

.dg-giris {
  width: 100%; height: var(--btn-h-kucuk); padding: 0 var(--b-2);
  border: 1px solid var(--kenar); border-radius: var(--r-kucuk);
  background: var(--yuzey); color: var(--metin);
  font-size: var(--fs-govde); outline: none;
  transition: border-color .15s, box-shadow .15s;
}
.dg-giris::placeholder { color: var(--metin-soluk); }
.dg-giris:focus {
  border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.dg-giris:disabled { background: var(--yuzey-alt); color: var(--metin-soluk); }
/* Noksan satir: "sözlüğe ekle" secili ama aciklama bos */
.dg-satir.dg-noksan { background: var(--amber-acik); }
.dg-giris.dg-noksan { border-color: var(--amber); box-shadow: 0 0 0 var(--halka) var(--amber-halka); }

/* SOZLUGE EKLE: isaretli -> eklenir, isaretsiz -> haric tutulur.
   Iki durumlu dugme yerine kutu; durumu kendi gosterir. accent-color
   mevcut marka degiskeninden gelir, YENI RENK YOK. */
.dg-ekle-hucre { text-align: center; }
.dg-ekle {
  width: 15px; height: 15px; margin: 0;
  accent-color: var(--kirmizi); cursor: pointer;
}
.dg-ekle:disabled { opacity: .4; cursor: not-allowed; }

.dg-kalan {
  font-size: var(--fs-kucuk); color: var(--amber); line-height: 1.5;
  background: var(--amber-acik); border: 1px solid var(--amber);
  border-radius: var(--r-kucuk); padding: 4px var(--b-3);
  margin-bottom: var(--b-3);
}
/* Birincil dugme neden pasif: gerekce EKRANDA yazar */
.dg-gerekce {
  font-size: var(--fs-kucuk); color: var(--amber); font-weight: var(--fw-kalin);
  margin-bottom: var(--b-2);
}
.dg-dugmeler { align-items: center; }
/* SÖZLEŞME7 §4: doğrulama kartının birincil düğmesi diğer birincil
   düğmelerle AYNI görünür. .dg-birincil bir kanca sınıfıdır, görünümü
   .secim-onay taşır; burada (ve başka hiçbir yerde) zemin/kenar/yazı
   biçimi EZİLMEZ — kilitli hâli de ortak .secim-onay:disabled kuralı. */

/* -------- Aksiyon izi -------- */
/* "Onayla ve Uygula" gibi buton aksiyonlari sohbete KULLANICI BALONU
   basmaz; ince bir ayrac uzerinde sessiz bir iz birakir. Balon degildir:
   zemin ve kenar yok, genisligi de balonun sabit genisligi degil. */
.aksiyon-izi {
  display: flex; align-items: center; gap: var(--b-3);
  margin: 0 0 var(--balon-ara);
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
}
.aksiyon-izi::before,
.aksiyon-izi::after {
  content: ""; flex: 1 1 auto; height: 1px; min-width: var(--b-5);
  background: var(--kenar-acik);
}
.aksiyon-izi span {
  flex: 0 1 auto; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* -------- Çalışıyor göstergesi -------- */
/* Tek basina ziplayan nokta "dondu" hissi veriyordu: adim adi,
   gecen sure ve iptal dugmesi ayni balonda. */
.balon.calisiyor { min-width: 15rem; }
.calisma-ust { display: flex; align-items: center; gap: var(--b-2); }
.calisma-adim {
  font-weight: var(--fw-kalin); font-size: var(--fs-govde); color: var(--metin);
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.calisma-alt {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--b-3); margin-top: var(--b-2);
}
.calisma-sure { font-size: var(--fs-govde); color: var(--metin-soluk); }
.calisma-iptal {
  height: var(--btn-h-kucuk); padding: 0 var(--b-3);
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer;
}
.calisma-iptal:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi);
}
.calisma-iptal:disabled { opacity: .45; cursor: not-allowed; }

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 5px; height: 5px; margin-right: 3px;
  border-radius: 50%; background: var(--metin-soluk); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-2px); }
}

/* -------- Aksiyon butonları ve yazı kutusu -------- */
#giris-bolge {
  padding: var(--b-3) var(--sohbet-yan) var(--b-5);
  padding-right: calc(var(--sohbet-yan) + 6px);   /* #sohbet scrollbar payi */
  flex-shrink: 0;
}
/* ---- Adım bloğu ----
   Onay düğmeleri sohbetin altındaki ortak şeritten blokların İÇİNE
   taşındı (#aksiyonlar kaldırıldı). Blok = başlık satırı + gövde +
   (onay bekliyorsa) düğme satırı. */
.adim-blok {
  border: 1px solid var(--kenar); border-radius: var(--r);
  background: var(--yuzey); box-shadow: var(--golge-1);
  padding: var(--b-3) var(--b-4) var(--b-4);
}
/* Blok içindeki balon kendi çerçevesini bırakır: çerçeve artık bloğun. */
.adim-blok > .balon {
  border: 0; background: none; box-shadow: none;
  padding: 0; width: 100%; max-width: none;
}
/* Gövdesi boş blok (yalnız düğme taşıyor) balon boşluğu bırakmasın */
.adim-blok > .balon:empty { display: none; }

/* Başlık satırı: adım adı solda, Geri Dön SAĞ ÜSTTE */
.blok-bas {
  display: flex; align-items: center; gap: var(--b-3);
  margin-bottom: var(--b-3);
}
/* Adım adı MARKA KIRMIZISI: iş akışı başlıkları ekranın omurgası,
   soluk gri kalınca blok "kapalı" gibi duruyordu. */
.blok-ad {
  flex: 1 1 auto; min-width: 0;
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  letter-spacing: .04em; text-transform: uppercase;
  color: var(--kirmizi);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* ---- Geri Dön ----
   Metin düğmesiydi ve görünmüyordu. Artık DOLU bir ikincil düğme:
   kendi zemini, belirgin kenarı, koyu yazısı ve bir ← oku var.
   KIRMIZI DEĞİL: başlık zaten kırmızı ve bloğun altındaki "Onayla ve
   Uygula" dolu kırmızı; üçüncü bir kırmızı, asıl eylemin hangisi
   olduğunu belirsizleştirirdi. Nötr ama dolu durunca hem görünür hem
   ikincil kalıyor. */
.blok-geri {
  flex: 0 0 auto;
  display: inline-flex; align-items: center; gap: 5px;
  height: var(--btn-h-kucuk); padding: 0 var(--b-3);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  background: var(--yuzey-alt); color: var(--metin);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r-kucuk);
  cursor: pointer; white-space: nowrap;
  box-shadow: var(--golge-1);
  transition: background .15s, border-color .15s, color .15s;
}
.blok-geri .geri-ok { font-size: 13px; line-height: 1; }
.blok-geri:hover:not(:disabled) {
  background: var(--kirmizi-acik); color: var(--kirmizi);
  border-color: var(--kirmizi);
}
.blok-geri:focus-visible {
  outline: 2px solid var(--kirmizi); outline-offset: 2px;
}
.blok-geri:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }

/* Bloğun alt düğmeleri */
.blok-dugmeler {
  display: flex; gap: var(--b-2); margin-top: var(--b-4);
}

/* ---- Adım bloğunun İÇİNDEKİ kartlar ----
   Bir adım birden fazla ekran üretebiliyor (seçim formu, sonra
   doğrulama kartı). Hepsi o adımın TEK bloğunda duruyor; kartlar kendi
   çerçevelerini bırakır, yoksa çerçeve içinde çerçeve olurdu. Aralarına
   ince bir ayraç girer: aynı adımın iki ayrı ekranı olduğu görünsün. */
.adim-blok > .secim-kart {
  width: auto; margin: 0; padding: 0;
  background: none; border: 0; box-shadow: none;
}
.adim-blok > .secim-kart::before { display: none; }   /* sol kırmızı çubuk */
.adim-blok > .secim-kart + .secim-kart,
.adim-blok > .balon + .secim-kart {
  margin-top: var(--b-4); padding-top: var(--b-4);
  border-top: 1px solid var(--kenar-acik);
}
/* Bloğun içindeki balon da çerçevesiz: çerçeve artık bloğun. */
.adim-blok > .balon {
  border: 0; background: none; box-shadow: none; padding: 0;
  width: 100%; max-width: none;
}
.adim-blok > .balon:empty { display: none; }
.adim-blok > .balon + .balon { margin-top: var(--b-3); }

/* ---- Karar kartı ----
   Tamamlanmış adımda VERİLEN KARAR, sayfa yenilendikten sonra. Adımın
   canlı kartları oturumda saklanmıyor; burada etiket/değer çiftleri
   salt okunur olarak geri gelir. Form gibi görünmemeli: tıklanacak
   hiçbir şey yok, bu yüzden giriş kutusu değil, satır düzeni. */
.karar-kart {
  display: flex; flex-direction: column; gap: var(--b-2);
  margin-top: var(--b-3);
}
.adim-blok > .balon + .karar-kart,
.adim-blok > .secim-kart + .karar-kart {
  margin-top: var(--b-4); padding-top: var(--b-4);
  border-top: 1px solid var(--kenar-acik);
}
.karar-satir {
  display: flex; align-items: baseline; gap: var(--b-3);
  font-size: var(--fs-govde); line-height: 1.45;
}
.karar-etiket {
  flex: 0 0 auto; min-width: 132px;
  color: var(--metin-soluk);
}
.karar-deger {
  flex: 1 1 auto; min-width: 0;
  color: var(--metin); font-weight: var(--fw-kalin);
  overflow-wrap: anywhere;
}

.aksiyon {
  flex: 1; height: var(--btn-h); padding: 0 var(--b-4);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  border-radius: var(--r); cursor: pointer; white-space: nowrap;
  text-align: center;
  transition: background .15s, border-color .15s, color .15s;
}
.aksiyon:disabled { opacity: .45; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff; border: 1px solid var(--kirmizi);
}
.aksiyon.onayla:hover:not(:disabled) {
  background: var(--kirmizi-koyu); border-color: var(--kirmizi-koyu);
}

.aksiyon.degistir, .aksiyon.geri {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar-guclu);
}
.aksiyon.degistir:hover:not(:disabled),
.aksiyon.geri:hover:not(:disabled) {
  background: var(--yuzey-alt); border-color: var(--metin-soluk);
}

#giris {
  width: var(--govde-en); margin: 0;
  display: flex; gap: var(--b-2); align-items: center;
  background: var(--yuzey);
  border: 1px solid var(--kenar-guclu); border-radius: var(--r);
  padding: 2px 2px 2px var(--b-4);
  box-shadow: var(--golge-1);
  transition: border-color .15s, box-shadow .15s;
}
#giris:focus-within { border-color: var(--kirmizi); box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka); }

/* ---- Kilitli giriş ----
   Ekranda kart/form varken kullanıcı cümle yazmıyor, form dolduruyor.
   Kutu soluk ve pasif; yanındaki "Soru Sor" kilidi o tur için açar —
   akış her an serbest soru kabul ediyor, kilit bunu yok etmemeli. */
#giris-bolge.kilitli #giris {
  background: var(--yuzey-alt); border-style: dashed;
  box-shadow: none;
}
#giris-bolge.kilitli #kutu { cursor: not-allowed; }

/* Kilit notu kutunun YERİNE geçer (üstüne binmez): metin sarabilsin,
   kutu da metin kadar yükselsin. Placeholder bu sırada boş. */
#giris-bolge.kilitli #kutu { display: none; }
.kutu-kilit-not {
  flex: 1; padding: 5px 0;
  font-size: var(--fs-govde); line-height: 1.5;
  color: var(--metin-soluk);
  user-select: none;
}
.kutu-kilit-not strong {
  font-weight: var(--fw-kalin); color: var(--metin);
}

#kutu {
  flex: 1; padding: 5px 0; border: none;
  background: transparent; color: var(--metin);
  font-size: var(--fs-govde); line-height: 1.5;
  resize: none; outline: none; max-height: 77px; overflow-y: auto;
}
#kutu::placeholder { color: var(--metin-soluk); }

#gonder {
  height: var(--btn-h-kucuk); padding: 0 var(--b-5);
  background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: var(--r-kucuk);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { opacity: .85; }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--ayrac);
  display: flex; flex-direction: column; overflow: hidden;
}

/* Sürükleme tutamakları KALDIRILDI (kullanıcı isteği): iki panel de
   CSS'teki clamp() genişliğinde sabit duruyor. Değişken teyit tablosu
   varsayılan genişliğe zaten sığdığı için (bkz. --ft-en) sürükleme
   hiçbir ekranda gerekli değil. */

/* Sözlük teyidi düğmesi: panelin ALTINDA sabit şerit. Gövde kayarken
   düğme yerinde kalır; kullanıcı 1.042 satırın sonuna inmek zorunda
   değil. */
#analiz-alt {
  flex-shrink: 0; padding: var(--b-3) var(--b-5);
  border-top: 1px solid var(--kenar); background: var(--yuzey);
}
#analiz-alt[hidden] { display: none; }
#analiz-alt .secim-onay { width: 100%; }

/* Sekmeler 3 sutunlu izgara: her genislikte duzenli 2 satir (3 + 3),
   esit genislikte ve ortali. Yeni sekme eklenirse ayni izgaraya oturur. */
#analiz-sekmeler {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--b-1);
  padding: var(--b-4) var(--b-5) var(--b-3);
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  flex-shrink: 0;
}
.analiz-sekme {
  min-width: 0; height: 24px; padding: 0 var(--b-2);
  text-align: center; overflow: hidden; text-overflow: ellipsis;
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); letter-spacing: .02em;
  border: 1px solid transparent; background: none; border-radius: var(--r-kucuk);
  cursor: pointer; color: var(--metin-soluk); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); color: var(--metin); }
/* Backend'e henüz baglanmamis sekmeler bir sure SOLUK gosteriliyordu
   (opacity: .7). Tek bagli sekme VALIDASYON oldugu icin o tek basina koyu
   kaliyor ve sekme seridi bozuk gorunuyordu. Bilgi zaten iki yerden
   veriliyor: sekmenin title'i ("Hazirlaniyor - ...") ve tiklaninca cikan
   "Hazirlaniyor" karti. Bu yuzden renk/opaklik farki kaldirildi; tum
   sekme etiketleri ayni tonda. .hazir-degil sinifi title'i tasiyan
   semantik isaret olarak duruyor. */
.analiz-sekme.aktif {
  background: var(--kirmizi-acik); color: var(--kirmizi); border-color: var(--kirmizi-halka);
}

#analiz-govde { flex: 1; overflow-y: auto; padding: var(--b-4) var(--b-5) var(--b-6); }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: var(--r);
  padding: var(--b-4); margin-bottom: var(--b-3); box-shadow: var(--golge-1);
}
.iskele-baslik {
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin); margin-bottom: var(--b-2); color: var(--metin);
}
/* "Hazırlanıyor" notu: sekmenin verisi henüz bağlı değil */
.iskele-kart.hazirlaniyor { border-style: dashed; background: var(--yuzey-alt); }

/* ---- Katlanabilir özet kartı (sözlük teyidi adımı) ----
   Ölçüm (1440x900, 1.042 kolon): iki özet kartı açıkken değişken
   tablosunun başlığı y=869'a düşüyordu — 900 piksellik pencerede 31
   piksel. Bölme öncesi tanımların düzeltileceği ekranda tablo kaydırma
   ardında kalamaz. Kartlar silinmedi, katlandı.
   Katlıyken kart kendi özetini başlıkta taşır; başlık bir <button>,
   çünkü klavyeyle de açılıp kapanabilmeli. */
.iskele-kart.kart-katlanir { padding-block: var(--b-2); }
.kart-kat-bas {
  display: flex; align-items: baseline; gap: var(--b-2);
  width: 100%; margin: 0; padding: 0;
  background: none; border: 0; cursor: pointer; text-align: left;
  font: inherit; font-size: var(--fs-baslik); font-weight: var(--fw-kalin);
  color: var(--metin);
}
.kart-kat-bas:hover .kart-ad { color: var(--kirmizi); }
.kart-kat-bas:focus-visible { outline: 2px solid var(--kirmizi); outline-offset: 2px; }
.kart-ok { flex: 0 0 auto; font-size: 10px; color: var(--metin-soluk); }
.kart-ad { flex: 0 0 auto; }
/* Özet SAĞDA ve tek satır: uzarsa kırpılır, tamamı kart açılınca görünür */
.kart-ozet {
  flex: 1 1 auto; min-width: 0; text-align: right;
  font-size: var(--fs-kucuk); font-weight: var(--fw-normal);
  color: var(--metin-soluk);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.iskele-satir {
  display: flex; justify-content: space-between; gap: var(--b-3);
  font-size: var(--fs-govde); padding: 5px 0; color: var(--metin-soluk);
}
.iskele-deger {
  font-size: var(--fs-govde);
  color: var(--metin); background: var(--kenar-acik);
  padding: 0 var(--b-2); border-radius: var(--r-kucuk);
}
.iskele-grafik {
  height: 69px; border-radius: var(--r-kucuk); margin-top: var(--b-1);
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 5px,
    var(--yuzey) 5px, var(--yuzey) 10px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin-soluk); font-size: var(--fs-govde);
}

/* -------- Durum çipi (validasyon ve ileride tüm durumlar) -------- */
.cip {
  display: inline-flex; align-items: center; gap: 4px;
  height: 18px; padding: 0 var(--b-2);
  border-radius: var(--r-kucuk);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin); letter-spacing: .05em;
  white-space: nowrap;
}
.cip::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%; background: currentColor;
}
.cip.gecti    { background: var(--yesil-acik);  color: var(--yesil); }
.cip.kosullu  { background: var(--amber-acik);  color: var(--amber); }
.cip.kaldi    { background: var(--kirmizi-acik); color: var(--kirmizi); }
/* Hesaplanamadi: hesap denendi ama guvenilir sonuc cikmadi (NaN skor,
   yetersiz bin). "Veri yok"tan farkli oldugu icin amber. */
.cip.hesaplanamadi { background: var(--amber-acik); color: var(--amber); }
.cip.bekliyor,
.cip.veri_yok { background: var(--kenar-acik);  color: var(--metin-soluk); }

/* -------- Validasyon sekmesi -------- */
.val-sonuc {
  display: flex; align-items: center; justify-content: space-between; gap: var(--b-3);
}
.val-model { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 2px; }
.val-ozet  { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-2); }

/* Sonuc kartinin sol cubugu genel sonucun rengini alir */
.iskele-kart.val-kart {
  position: relative; overflow: hidden;
  padding-left: calc(var(--b-4) + var(--serit));
}
.iskele-kart.val-kart::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0;
  width: var(--serit); background: var(--kenar-guclu);
}
.iskele-kart.val-kart.gecti::before   { background: var(--yesil); }
.iskele-kart.val-kart.kosullu::before { background: var(--amber); }
.iskele-kart.val-kart.kaldi::before   { background: var(--kirmizi); }

.val-satir {
  display: flex; align-items: flex-start; justify-content: space-between;
  gap: var(--b-3); padding: 8px 0;
  border-bottom: 1px solid var(--kenar-acik);
}
.val-satir:first-of-type { padding-top: 0; }
.val-satir:last-child { border-bottom: none; padding-bottom: 0; }
.val-sol { min-width: 0; }
.val-ad { font-weight: var(--fw-kalin); color: var(--metin); }
.val-esik { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 1px; }
.val-sag {
  flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: var(--b-1);
}
.val-deger { font-size: var(--fs-baslik); font-weight: var(--fw-kalin); color: var(--metin); }
.val-not { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: var(--b-1); }

/* -------- Backend'e bağlı panel sekmeleri (VERİ / EKSİK DEĞER / SFA) ----- */
/* Kartın hangi adımdan sonra dolacağını söyleyen not */
.panel-not {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
  margin: calc(-1 * var(--b-1)) 0 var(--b-2);
}
/* Uzun etiket taşmasın; tam metin title'da */
.panel-etiket { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.iskele-satir > .iskele-deger { flex-shrink: 0; max-width: 62%; overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }

.panel-tablo {
  width: 100%; border-collapse: collapse; table-layout: fixed;
  font-size: var(--fs-kucuk); color: var(--metin);
}
.panel-tablo th {
  text-align: left; font-weight: var(--fw-kalin); color: var(--metin-soluk);
  letter-spacing: .04em; padding: 0 var(--b-2) 5px 0;
  border-bottom: 1px solid var(--kenar);
}
.panel-tablo th:last-child, .panel-tablo td:last-child { padding-right: 0; }
.panel-tablo td {
  padding: 5px var(--b-2) 5px 0;
  border-bottom: 1px solid var(--kenar-acik);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.panel-tablo tr:last-child td { border-bottom: none; }
/* İlk kolon değişken adıdır: yer verilir ama taşma kırpılır */
.panel-tablo th:first-child, .panel-tablo .panel-ad { width: 38%; }
.panel-tablo .panel-ad { font-weight: var(--fw-kalin); }

/* ==================== DEĞİŞKEN TABLOSU ====================
   1.042 satır olabiliyor: tablo sanallaştırılıyor, yani gövdede yalnızca
   görünür pencere + tampon duruyor. Bunun tek şartı SABİT satır
   yüksekliği — --ft-satir-h, app.js'teki FT_SATIR_H ile AYNI olmalı.
   Dört kolon (DEĞİŞKEN / TİP / SÖZLÜK TANIMI / NULL %) + satır başında
   onay kutusu; başlık ve satırlar aynı ızgara şablonunu paylaşır. */
:root {
  --ft-satir-h: 26px;
  /* Sekiz kolon 720px istiyordu; dört kolonda satır dar panele
     sığıyor ve yatay kaydırma çoğu ekranda hiç gerekmiyor. */
  /* --ft-en, ızgaranın GERÇEK asgari genişliğiyle AYNI olmalı.
     430px yazıyordu ama ızgara 26+110+68+150+62 = 416 + dört boşluk
     (4x6=24) = 440px istiyordu. Varsayılan panel genişliğinde
     (.ft-govde iç genişliği 430px) NULL % sütununun 10 pikseli
     kesiliyordu: ekranda "%" görünüp sayı görünmüyordu. Asgariler
     aşağıda kısıldı; yeni toplam 26+96+68+134+52 = 376 + 24 = 400.
     400 SEÇİLDİ, 416 DEĞİL: .ft-govde dikey kaydırma çubuğunu da
     taşıyor ve .ft-tablo'nun iç genişliği 1440px pencerede 406px
     kalıyor. 416 asgari, satırı çubuğun altından 10px taşırıyordu —
     kesilme kaybolmuyor, yalnızca yatay kaydırmaya dönüşüyordu. */
  --ft-en: 400px;          /* satırın en az genişliği: kolonlar ezilmesin */
  --ft-govde-h: 360px;     /* kaydırılabilir pencere yüksekliği */
}
.ft-kart { padding: var(--b-3); }
/* Başlık şeridi TEK SATIR: sayılar ve sözlük adı aynı satırda,
   aralarında nokta ayracı. Uzun sözlük adı kırpılır (min-width: 0). */
.ft-ust {
  display: flex; align-items: baseline; flex-wrap: nowrap;
  gap: 5px; margin-bottom: var(--b-2);
}
.ft-sayac {
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  white-space: nowrap; flex-shrink: 0;
}
.ft-ayrac { font-size: var(--fs-govde); color: var(--metin-soluk); flex-shrink: 0; }
.ft-kaynak {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
}

.ft-filtreler { display: flex; flex-direction: column; gap: var(--b-2); }
.ft-ara, .ft-secim, .ft-esik-kutu {
  font-family: var(--font); font-size: var(--fs-govde); color: var(--metin);
  background: var(--yuzey); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); height: var(--btn-h-kucuk); padding: 0 var(--b-2);
}
.ft-ara { width: 100%; }
.ft-ara:focus, .ft-secim:focus, .ft-esik-kutu:focus {
  outline: none; border-color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.ft-filtre-satir { display: flex; flex-wrap: wrap; gap: var(--b-2); align-items: center; }
.ft-filtre-satir .ft-secim { flex: 1 1 120px; min-width: 0; }
.ft-esik {
  display: flex; align-items: center; gap: 5px;
  font-size: var(--fs-govde); color: var(--metin-soluk); white-space: nowrap;
}
.ft-esik-kutu { width: 56px; }

.ft-toplu {
  display: flex; align-items: center; gap: var(--b-2); flex-wrap: wrap;
  margin-top: var(--b-2); padding-top: var(--b-2);
  border-top: 1px solid var(--kenar-acik);
}
.ft-toplu-sayi { font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin); }
.ft-toplu .ft-secim { flex: 1 1 150px; min-width: 0; }
.ft-mini {
  font-family: var(--font); font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  height: var(--btn-h-kucuk); padding: 0 var(--b-3); cursor: pointer;
  color: var(--metin); background: var(--yuzey);
  border: 1px solid var(--kenar); border-radius: var(--r-kucuk);
}
.ft-mini:hover:not(:disabled) {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
.ft-mini:disabled, .ft-secim:disabled { opacity: .5; cursor: default; }

.ft-not { font-size: var(--fs-govde); color: var(--yesil); margin-top: var(--b-2); }
.ft-toplu-hata {
  font-size: var(--fs-govde); color: var(--kirmizi); margin-top: var(--b-2);
  background: var(--kirmizi-acik); border: 1px solid var(--kirmizi-halka);
  border-radius: var(--r-kucuk); padding: var(--b-2);
}
.ft-not[hidden], .ft-toplu-hata[hidden], .ft-detay[hidden] { display: none; }

.ft-tablo { margin-top: var(--b-3); overflow-x: auto; }
.ft-satir {
  display: grid;
  /* NULL % 62 -> 52px: içeriği en fazla "%100,0", 52px buna yetiyor.
     DEĞİŞKEN asgarisi 110 -> 96px: uzun ad zaten kırpılıyor, tamamı
     ipucunda. İkisi birlikte ızgarayı varsayılan panel genişliğine
     sığdırıyor (bkz. --ft-en). */
  grid-template-columns: 26px minmax(96px, 1.4fr) 68px minmax(134px, 2.4fr) 52px;
  align-items: center; gap: var(--b-2);
  min-width: var(--ft-en); height: var(--ft-satir-h);
  border-bottom: 1px solid var(--kenar-acik);
}
/* Çalışma kopyası yoksa onay kutusu sütunu hiç çizilmiyor.
   Sınıf JS'ten geliyor; :has() kullanılmadı, Dataiku'nun gömdüğü eski
   WebView'lerde destek yok. */
.ft-tablo.salt-okunur .ft-satir {
  grid-template-columns: minmax(96px, 1.4fr) 68px minmax(134px, 2.4fr) 52px;
}
.ft-hucre {
  min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: var(--fs-govde); color: var(--metin);
}
.ft-satir .ft-ad { font-weight: var(--fw-kalin); }
.ft-sayi { text-align: right; }
.ft-sec { display: flex; align-items: center; justify-content: center; }

.ft-baslik {
  position: sticky; top: 0; z-index: 1; background: var(--yuzey);
  border-bottom: 1px solid var(--kenar);
}
.ft-bas {
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  letter-spacing: var(--etiket-aralik); color: var(--metin-soluk); cursor: pointer;
}
.ft-bas:hover { color: var(--kirmizi); }
.ft-bas:focus-visible {
  outline: none; color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}

.ft-govde {
  position: relative; height: var(--ft-govde-h); overflow-y: auto;
  min-width: var(--ft-en);
}
/* Yer tutucu: yüksekliği TÜM satırların toplamı, içinde yalnızca
   görünen pencere duruyor. Kaydırma çubuğu gerçek uzunluğu gösterir. */
.ft-yer { position: relative; width: 100%; }
.ft-yer > .ft-satir { position: absolute; left: 0; right: 0; }
.ft-satir:hover { background: var(--kenar-acik); }
.ft-satir.acik { background: var(--kirmizi-acik); }
.ft-satir.hatali { background: var(--amber-acik); }
.ft-bos {
  padding: var(--b-4) 0; font-size: var(--fs-govde); color: var(--metin-soluk);
}

/* SÖZLÜK TANIMI hücresi düzenlenebilir: kutu satır yüksekliğine
   sığsın diye 20px ve ince kenarlı. Yeni renk yok; mevcut yüzey/kenar
   değişkenleri koyu temada kendiliğinden dönüyor. */
.ft-tanim-giris {
  width: 100%; min-width: 0; height: 20px; padding: 0 4px;
  font-family: var(--font); font-size: var(--fs-govde); color: var(--metin);
  background: var(--yuzey); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk);
}
.ft-tanim-giris:focus {
  outline: none; border-color: var(--kirmizi);
  box-shadow: 0 0 0 var(--halka) var(--kirmizi-halka);
}
.ft-tanim-giris::placeholder { color: var(--metin-soluk); }
.ft-tanim.bekliyor { opacity: .6; }
/* Süreç dışı bırakılan satır soluk: ayrı bir DURUM kolonu yok, kararı
   satırın kendisi gösteriyor. */
.ft-satir.ft-disi .ft-hucre { opacity: .55; }
.ft-satir.ft-disi .ft-ad { text-decoration: line-through; }
/* Yazma hatası satırın sağ ucunda, satırın ÜSTÜNE biniyor: ızgaraya
   yeni bir hücre olarak eklenseydi satır ikinci sıraya taşar ve sabit
   satır yüksekliği (sanallaştırmanın tek varsayımı) bozulurdu.
   Tam metin title'da. */
.ft-hata {
  position: absolute; right: 0; top: 0; height: 100%;
  display: flex; align-items: center; max-width: 60%;
  padding: 0 var(--b-2); background: var(--amber-acik);
  border-left: 1px solid var(--amber-halka);
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  color: var(--kirmizi); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.ft-detay {
  margin-top: var(--b-3); padding: var(--b-3);
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk);
}
.ft-detay-ad {
  font-size: var(--fs-baslik); font-weight: var(--fw-kalin);
  color: var(--metin); margin-bottom: var(--b-2);
}
.ft-detay-satir {
  display: flex; justify-content: space-between; gap: var(--b-3);
  font-size: var(--fs-govde); padding: 3px 0;
}
.ft-detay-etiket { color: var(--metin-soluk); flex-shrink: 0; }
/* Sözlük tanımı TAM METİN: kırpılmaz, satır kaydırılır */
.ft-detay-deger { color: var(--metin); text-align: right; word-break: break-word; }
.ft-detay .ft-mini { margin-top: var(--b-2); }

/* ==================== Set seçici (analiz panelinin tepesi) ========== */
/* Dar panelde (304px) beş düğme tek satıra sığmayabilir; sarılıyor.
   Yeni renk değişkeni YOK: hepsi mevcut değişkenlerden, böylece koyu
   temada ayrıca override gerekmiyor. */
.set-secici {
  display: flex; flex-direction: column; gap: var(--b-1);
  margin-bottom: var(--b-3);
}
.set-dugmeler { display: flex; flex-wrap: wrap; gap: var(--b-1); }
.set-dugme {
  font-family: var(--font); font-size: var(--fs-govde); font-weight: var(--fw-kalin);
  height: var(--btn-h-kucuk); padding: 0 var(--b-2); cursor: pointer;
  color: var(--metin-soluk); background: var(--yuzey);
  border: 1px solid var(--kenar); border-radius: var(--r-kucuk);
}
.set-dugme:hover:not(:disabled) {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
.set-dugme.secili {
  color: var(--kirmizi); background: var(--kirmizi-acik); border-color: var(--kirmizi);
}
/* SFA'da seçici pasif: tıklanamaz ama hangi sete kilitli olduğu görünür */
.set-dugme:disabled { opacity: .5; cursor: default; }
.set-not, .set-kapsam {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
}
.set-kapsam { margin: calc(-1 * var(--b-2)) 0 var(--b-3); }

/* ==================== Bölme formu (HAZIRLIK) ==================== */
/* İki aşama: "test nasıl ayrılsın?" ve "kalan train nasıl kullanılsın?".
   Her aşama kendi başlığı + düğme şeridi + o aşamaya ait alanlar. */
.bf-asama { margin-top: var(--b-3); }
.bf-asama-baslik {
  font-size: var(--fs-kucuk); font-weight: var(--fw-kalin);
  color: var(--metin-soluk); letter-spacing: var(--etiket-aralik);
  margin-bottom: var(--b-1);
}
/* 1. aşamanın iki alanı şeridin hemen altında: üst çizgi tekrarlanmasın */
.bf-asama-alanlar { margin-top: var(--b-1); padding-top: 0; border-top: none; }
.bf-hazir { display: flex; flex-wrap: wrap; gap: var(--b-1); align-items: center; }
.bf-hazir-btn.secili {
  color: var(--kirmizi); background: var(--kirmizi-acik); border-color: var(--kirmizi);
}
.bf-ozel {
  font-size: var(--fs-kucuk); color: var(--metin-soluk);
  border: 1px dashed var(--kenar); border-radius: var(--r-kucuk);
  padding: 0 var(--b-2); height: var(--btn-h-kucuk);
  display: inline-flex; align-items: center;
}
.bf-ozel.secili {
  color: var(--amber); background: var(--amber-acik); border-color: var(--amber);
  border-style: solid;
}

/* Özet satırı: kaydedilmiş hal net, tahmini hal kesikli çerçeveli */
.bf-ozet {
  margin-top: var(--b-3); padding: var(--b-2);
  font-size: var(--fs-govde); font-weight: var(--fw-kalin); color: var(--metin);
  background: var(--yuzey-alt); border: 1px solid var(--kenar);
  border-radius: var(--r-kucuk); word-break: break-word;
}
.bf-ozet.tahmin { border-style: dashed; color: var(--metin-soluk); }
.bf-not { margin-top: var(--b-1); }

.bf-uyarilar { margin-top: var(--b-2); display: flex; flex-direction: column; gap: var(--b-1); }
.bf-uyari {
  font-size: var(--fs-govde); color: var(--amber);
  background: var(--amber-acik); border: 1px solid var(--amber-halka);
  border-radius: var(--r-kucuk); padding: var(--b-2);
}

.bf-alanlar {
  margin-top: var(--b-3); padding-top: var(--b-2);
  border-top: 1px solid var(--kenar-acik);
}
.bf-satir {
  display: flex; flex-wrap: wrap; align-items: center;
