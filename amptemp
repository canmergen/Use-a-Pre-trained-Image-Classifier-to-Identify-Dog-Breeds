    _ad = next(a for k, a, _ in RENKLER if k == _kod)
    _pk = {}
    for v, a in _mr:
        klasor = MODELLER[(v, a)]["klasor"]
        paket, hata = _st_paket(klasor, _kod, _ad)
        if paket is None:
            _st_atlanan.append(f"{klasor} renk {_kod}: {hata}")
            continue
        ref = int(ST_REFERANS or paket.get("train_donem") or 0)
        if not ref:
            _st_atlanan.append(f"{klasor} renk {_kod}: model paketinde train dönemi yok (ST_REFERANS'a yazın)")
            continue
        if ref not in _st_donem_var:
            _st_atlanan.append(f"{klasor} renk {_kod}: referans dönem {ref} ham veride yok")
            continue
        _pk[(v, a)] = {"paket": paket, "klasor": klasor, "ref": ref, "oot": paket.get("oot_donem"),
                       "ham": tuple(paket["required_raw_features"]), "ist": {}, "kontrol": {}, "kitle": {}, "es": None}
    if not _pk:
        continue
    # dönemler: önce referans (sınırlar ondan), sonra karşılaştırılanlar
    _gerek = {}
    for (v, a), m in _pk.items():
        for d in [m["ref"]] + list(_ST_DON.values()):
            anahtar = (_st_veri_anahtari, m["klasor"], _kod, m["ref"], d, tuple(m["paket"]["features"]))
            if anahtar in _ST_ONBELLEK:
                m["ist"][d], m["kitle"][d], kn = _ST_ONBELLEK[anahtar]
                if kn is not None:
                    m["kontrol"][d] = kn
            elif d in _st_donem_var:
                _gerek.setdefault(d, []).append((v, a))
    _sira = sorted(_gerek, key=lambda d: (0 if any(_pk[x]["ref"] == d for x in _gerek[d]) else 1, d))
    for d in _sira:
        _hamlar = {}
        for x in _gerek[d]:
            _hamlar.setdefault(_pk[x]["ham"], []).append(x)
        _kol = list(dict.fromkeys(c for h in _hamlar for c in h)) + ["MBB_NO"]
        _rows, _n_kitle, _kitle_k = _st_satirlar(_kod, d, _kol)
        if not len(_rows):
            continue
        _mbb = _rows["MBB_NO"].to_numpy() if "MBB_NO" in _rows.columns else None
        for ham, xs in _hamlar.items():
            eksik = [c for c in ham if c not in _rows.columns]
            if eksik:
                for x in xs:
                    _st_atlanan.append(f"{_pk[x]['klasor']} renk {_kod} {d}: ham veride eksik kolon {eksik[:5]}")
                continue
            X = _rows.loc[:, list(ham)]
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                eng, _ = feature_engineering(X)
            for x in xs:
                m = _pk[x]
                ref_ist = None if d == m["ref"] else m["ist"].get(m["ref"])
                if d != m["ref"] and ref_ist is None:
                    continue                                  # referans dönem veride yok
                try:
                    F, skor, turler = _st_girdi(X, eng, m["paket"])
                except Exception as e:
                    _st_atlanan.append(f"{m['klasor']} renk {_kod} {d}: skorlanamadı ({type(e).__name__}: {e})")
                    continue
                m["ist"][d] = _st_ozellik(F, skor, turler, ref_ist)
                m["ist"][d]["turler"] = turler
                m["kitle"][d] = _n_kitle
                kn = None
                kontrol_d = ({m["ref"], int(m["oot"] or 0)} if ST_SKOR_KONTROL == "HEPSI"
                             else {int(m["oot"] or 0)} if ST_SKOR_KONTROL == "OOT" else set())
                if d in kontrol_d:
                    if m["es"] is None:                       # eğitim skorları modelde bir kez okunur
                        m["es"] = _st_egitim_skorlari(m["klasor"], _kod, _ad, kontrol_d)
                    kn = _st_uretim(m["es"].get(d), _kitle_k, _mbb, skor, x[1])
                    m["kontrol"][d] = kn
                _ST_ONBELLEK[(_st_veri_anahtari, m["klasor"], _kod, m["ref"], d, tuple(m["paket"]["features"]))] = (
                    m["ist"][d], _n_kitle, kn)
                del F, skor
            del eng, X
        del _rows, _kitle_k
        _log(f"   renk {_kod} {d}: {len(_gerek[d])} model ({_adet(_n_kitle)} müşteri"
             + (f", örnek {_adet(ST_ORNEK_N)}" if ST_ORNEK_N and _n_kitle > ST_ORNEK_N else "") + ")")
    for (v, a), m in _pk.items():
        if not m["ist"]:
            continue
        _ST_SONUC.append({"kod": _kod, "vade": v, "aile": a, **{k: m[k] for k in ("klasor", "ref", "oot", "ist", "kontrol",
                                                                                  "kitle")}})
    del _pk
for _m in _st_atlanan:
    _log(f"   ⚠ {_m}")
if not _ST_SONUC:
    raise RuntimeError("Hiçbir model için stabilite hesaplanamadı (yukarıdaki uyarılara bakın).")
_st_reflar = sorted({s["ref"] for s in _ST_SONUC})
if len(_st_reflar) > 1:
    _log(f"   ⚠ Modellerin train dönemleri farklı: {_st_reflar}; her model kendi train dönemiyle karşılaştırıldı")
