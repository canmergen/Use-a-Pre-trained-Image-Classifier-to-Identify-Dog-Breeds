            ])

        # ---- 3) BUCKET20 ----
        for _sheet, (_bloklar, _col, _isaret, _ad_tr, _don) in bucket_sheetler.items():
            r = _ILK_SATIR - 1
            for _i, b in enumerate(_bloklar):
                b.to_excel(xl, sheet_name=_sheet, index=False, startrow=r,
