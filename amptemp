def _st_deger(x):
    if x is None or (isinstance(x, (float, np.floating)) and not np.isfinite(x)):
        return None
    return x.item() if hasattr(x, "item") else x


def _st_tablo(ws, S, r, kolonlar, gruplar, satirlar, tablo_adi, dilimler):
    """Dilimleyici alanı + grup bandı + başlık + satırlar + Excel tablosu. dilimler: [(anahtar, buton kolonu, genişlik)]."""
    C = {k[4]: 2 + i for i, k in enumerate(kolonlar)}
    ad = {k[4]: k[1] for k in kolonlar}
    r_bant = r + 7 if DILIMLEYICI_EKLE else r
    for g in dict.fromkeys(k[0] for k in kolonlar):
        cs = [C[k[4]] for k in kolonlar if k[0] == g]
        S.birlestir(r_bant, cs[0], cs[-1], gruplar[g], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=11, h="center",
                    kenar=_KENAR_B)
    ws.row_dimensions[r_bant].height = 20
    R0 = r_bant + 1
    for k in kolonlar:
        S.hucre(R0, C[k[4]], k[1], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
    ws.row_dimensions[R0].height = 46
    for i, d in enumerate(satirlar):
        rr = R0 + 1 + i
        for k in kolonlar:
            v = _st_deger(d.get(k[4]))
            x = S.hucre(rr, C[k[4]], v, fmt=k[2], wrap=False, dikey="center", size=10,
                        h="left" if k[2] is None and k[4] not in ("durum",) else "center")
            if k[4] == "durum" and v in _ST_DURUM_RENK:
                x.fill = PatternFill("solid", fgColor=_ST_DURUM_RENK[v])
                x.font = Font(name=YAZI_TIPI, bold=True, size=10)
        ws.row_dimensions[rr].height = 16
    RS = R0 + max(len(satirlar), 1)
    _tablo_ekle(ws, tablo_adi, R0, RS, 2, [k[1] for k in kolonlar])
    plan, c = [], 2
    for anahtar, n_buton, gen in dilimler:
        plan.append((ad[anahtar], ad[anahtar], c, c + gen - 1, 4, n_buton))
        c += gen
    _dilimleyici_alani(ws, tablo_adi, r, plan)
    return R0, RS, C


