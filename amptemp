def _st_grafik_yerlesimi(kitap):
    """Grafiklerde yazılar üst üste binmesin: başlık üstte, açıklama (legend) altta ve ikisi de çizim alanının dışında;
    çizim alanı aradaki boşluğa sabitlenir. Bütün sheet'lerdeki grafiklere uygulanır; tekrar çağırmak zararsızdır."""
    from openpyxl.chart import BarChart
    from openpyxl.chart.layout import Layout, ManualLayout
    from openpyxl.drawing.text import CharacterProperties, ParagraphProperties

    def _satir(uzunluk_cm, en_cm):
        return max(1, int(np.ceil(uzunluk_cm / max(en_cm - 1.2, 3.0))))

    def _metin(t):
        try:
            return "".join(r.t or "" for p in t.tx.rich.p for r in (p.r or []))
        except Exception:
            return ""

    for w in kitap.worksheets:
        for ch in getattr(w, "_charts", []):
            en, boy = float(ch.width or 15.0), float(ch.height or 7.5)
            ust, alt, sol, sag = 0.3, 0.3, 0.25, 0.45
            if ch.title is not None:
                ch.title.overlay = False
                for p in ch.title.tx.rich.p:
                    p.pPr = ParagraphProperties(defRPr=CharacterProperties(sz=1200, b=True))
                    for r in (p.r or []):
                        r.rPr = CharacterProperties(sz=1200, b=True)
                ust = 0.5 + 0.65 * _satir(len(_metin(ch.title)) * 0.25, en)
            if ch.legend is not None:
                ch.legend.overlay = False
                ch.legend.position = "b"
                adlar = []
                for s in ch.series:
                    ad = getattr(getattr(s, "tx", None), "v", None)
                    adlar.append(len(ad) if ad else 25)
                alt = 0.45 + 0.5 * _satir(sum(n * 0.2 + 1.2 for n in adlar), en)
            yatay = isinstance(ch, BarChart) and ch.type == "bar"
            alt_eksen, sol_eksen = (ch.y_axis, ch.x_axis) if yatay else (ch.x_axis, ch.y_axis)
            if getattr(alt_eksen, "title", None) is not None:
                alt += 0.9
            if getattr(sol_eksen, "title", None) is not None:
                sol += 1.0
            ch.layout = Layout(manualLayout=ManualLayout(
                layoutTarget="outer", xMode="edge", yMode="edge", x=sol / en, y=ust / boy,
                w=max(0.3, 1.0 - (sol + sag) / en), h=max(0.3, 1.0 - (ust + alt) / boy)))


def _st_dilimleyicileri_birlestir(veri):
    """Excel bir sheet'te tek dilimleyici listesi (extLst > ext) ve tek dilimleyici parçası (xl/slicers/slicerN.xml) bekler.
    Bu sheet'te üç tablonun dilimleyicisi var; her tablo ayrı liste ve parça eklediği için Excel dosyayı "onarmak" isterdi.
    Aynı sheet'in dilimleyicileri, Excel'in kendi kaydettiği gibi, tek parçada ve tek listede birleştirilir."""
    import posixpath
    from xml.etree import ElementTree as _ET
    uri = globals().get("_URI_SAYFA", "{3A4CF648-6AED-40f4-86FF-DC5316D8AED3}")
    desen_ext = re.compile(r'<(?P<on>(?:\w+:)?)ext uri="' + re.escape(uri) + r'"[^>]*>(?P<ic>.*?)</(?P=on)ext>', re.S)
    desen_rel = re.compile(r"<Relationship\b[^>]*/>")
    zin = zipfile.ZipFile(BytesIO(veri))
    sira = [i.filename for i in zin.infolist()]
    z = {ad: zin.read(ad) for ad in sira}
    silinen, birlesen = set(), 0

    def _ozellik(etiket, ad):
        m = re.search(rf'\b{ad}="([^"]*)"', etiket)
        return m.group(1) if m else None

    for ad in sira:
        if not (ad.startswith("xl/worksheets/") and ad.endswith(".xml")):
            continue
        s = z[ad].decode("utf-8")
        bul = list(desen_ext.finditer(s))
        refler = [r for m in bul for r in re.findall(r"<x14:slicer\b[^>]*/>", m.group("ic"))]
        if len(bul) < 2 and len(refler) < 2:
            continue
        rels_ad = posixpath.join(posixpath.dirname(ad), "_rels", posixpath.basename(ad) + ".rels")
        rels = z[rels_ad].decode("utf-8")
        hedef = {}
        for r in desen_rel.findall(rels):
            t = _ozellik(r, "Target") or ""
            hedef[_ozellik(r, "Id")] = (r, t[1:] if t.startswith("/") else posixpath.normpath(
                posixpath.join(posixpath.dirname(ad), t)))
        idler = [re.search(r'r:id="([^"]+)"', r).group(1) for r in refler]
        parcalar = [hedef[i][1] for i in idler]
        govde = []
        for p in parcalar:
            m = re.search(r"<(?P<on>(?:\w+:)?)slicers\b[^>]*>(?P<ic>.*)</(?P=on)slicers>", z[p].decode("utf-8"), re.S)
            govde.append(m.group("ic"))
        ilk = z[parcalar[0]].decode("utf-8")
        m = re.search(r"(<(?P<on>(?:\w+:)?)slicers\b[^>]*>).*(</(?P=on)slicers>)", ilk, re.S)
        ilk = ilk[:m.start()] + m.group(1) + "".join(govde) + m.group(3) + ilk[m.end():]
        _ET.fromstring(ilk.encode("utf-8"))
        z[parcalar[0]] = ilk.encode("utf-8")
        for i, p in zip(idler[1:], parcalar[1:]):
            rels = rels.replace(hedef[i][0], "", 1)
            silinen.add(p)
        z[rels_ad] = rels.encode("utf-8")
        tek = s[bul[0].start():bul[0].end()]
        tek = re.sub(r"(<x14:slicerList\b[^>]*>).*?(</x14:slicerList>)", lambda k: k.group(1) + refler[0] + k.group(2),
                     tek, count=1, flags=re.S)
        for k in reversed(bul[1:]):
            s = s[:k.start()] + s[k.end():]
        s = s[:bul[0].start()] + tek + s[bul[0].end():]
        _ET.fromstring(s.encode("utf-8"))
        z[ad] = s.encode("utf-8")
        birlesen += 1
    if not birlesen:
        return veri
    if silinen:
        ct = z["[Content_Types].xml"].decode("utf-8")
        for p in silinen:
            ct = re.sub(r'<Override\b[^>]*PartName="/' + re.escape(p) + r'"[^>]*/>', "", ct)
        z["[Content_Types].xml"] = ct.encode("utf-8")
    cikti = BytesIO()
    with zipfile.ZipFile(cikti, "w", zipfile.ZIP_DEFLATED) as zo:
        for ad in sira:
            if ad not in silinen:
                zo.writestr(ad, z[ad])
    return cikti.getvalue()


def _st_gorselleri_tazele():
    """openpyxl ilk kayıtta görsel akışlarını kapatır; ikinci kayıt için görselleri son yazılan dosyadan geri yükler."""
    imgs = [img for w in wb.worksheets for img in getattr(w, "_images", [])]
