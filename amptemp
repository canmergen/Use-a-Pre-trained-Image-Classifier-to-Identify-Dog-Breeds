def _bd_ek_diziler(M, mbb, donem):
    """Bucket detayı için dönemin bütün satırlarında: limit, risk, takip / gecikme bayrakları ve aynı dönemin FPD'si
    (bucket raporundaki gibi her satır kendi müşteri + dönem kaydıyla eşlenir)."""
    def sayi(c):
        if c is None or c not in M.columns:
            return None
        return pd.to_numeric(M[c], errors="coerce").astype("float64").to_numpy()

    out = {"limit": sayi(_BD_LIMIT), "risk": sayi(_BD_RISK), "ek": {c: sayi(c) for c in _BD_EK if c in M.columns},
           "fpd": {}}
    if _BD_FPD is not None:
        if donem in _BD_FPD_P:
            m = pd.DataFrame({"MBB_NO": pd.array(mbb, dtype="Int64")}).merge(
                _BD_FPD_P[donem][["MBB_NO"] + _BD_FPD_ADLAR], on="MBB_NO", how="left", validate="many_to_one")
            out["fpd"] = {h: m[h].to_numpy(dtype="float64", na_value=np.nan) for h in _BD_FPD_ADLAR}
        else:
            out["fpd"] = {h: np.full(len(mbb), np.nan) for h in _BD_FPD_ADLAR}
    return out


def _bd_ileri(mbb, donem):
    """Bölüm 3: dönemin tekil müşterileri (ilk satır) ile aynı ve sonraki DONEMLER'deki FPD kayıtları.
    → {FPD dönemi: {"i": satır no, hedefler: değerler, "FSKOR": değerler ya da None}}."""
    if _BD_FPD is None:
        return {}
    d = pd.DataFrame({"MBB_NO": pd.array(mbb, dtype="Int64"), "_i": np.arange(len(mbb))})
    d = d.dropna(subset=["MBB_NO"]).drop_duplicates("MBB_NO", keep="first")
    out = {}
    for p in _BD_DON:
        if p < donem or p not in _BD_FPD_P:
            continue
        m = d.merge(_BD_FPD_P[p], on="MBB_NO", how="left", validate="one_to_one")
        m = m[m[_BD_FPD_ADLAR].notna().any(axis=1)]
        out[p] = {"i": m["_i"].to_numpy(), "FSKOR": (m["FSKOR"].to_numpy(dtype="float64", na_value=np.nan)
                                                      if _bd_fpd_skorlu else None),
                  **{h: m[h].to_numpy(dtype="float64", na_value=np.nan) for h in _BD_FPD_ADLAR}}
    return out


def _bd_rol(paket, donem):
    if int(paket.get("train_donem", -1) or -1) == donem:
        return "train"
    if int(paket.get("oot_donem", -1) or -1) == donem:
        return "oot"
    return ""


def _bd_donem_etiket(donem, rol):
    return f"{donem} Eğitim" if rol == "train" else f"{donem} OOT" if rol == "oot" else str(donem)


def _bd_hesapla(mdl, kod, donem, paket, skor, M, mbb, oz, ek, ileri, pc):
    """Bir model x dönemin bütün sonuçları (özet, bucket satırları, FPD satırları)."""
    v, aile, ufuk = mdl["vade"], mdl["aile"], mdl["ufuk"]
    kaynak, pencere = _bd_kaynak(v, aile, ufuk)
    kisa, uzun = _bd_durum(kaynak, pencere, donem)
    y = _bd_hedef(M, v, aile, ufuk) if kisa != "Yok" else np.full(len(skor), np.nan)
    kitle = np.isfinite(y) if kisa != "Yok" else np.ones(len(skor), dtype=bool)
    yk, sk = y[kitle], skor[kitle]
    ekk = {"limit": None if ek["limit"] is None else ek["limit"][kitle],
           "risk": None if ek["risk"] is None else ek["risk"][kitle],
           "ek": {c: a[kitle] for c, a in ek["ek"].items()}, "fpd": {h: a[kitle] for h, a in ek["fpd"].items()}}
    rol = _bd_rol(paket, donem)
    ortak = {"kod": kod, "kl": mdl["klasor"], "seg": _seg_etiket(kod), "ad": f"{v}M {mdl['model']}",
             "model": mdl["model"], "vade": v, "donem": _bd_donem_etiket(donem, rol), "durum_kisa": kisa}
    b20, b100 = _bd_bucket(yk, sk, 20, ekk), _bd_bucket(yk, sk, 100, ekk)
    vaka = float(np.nansum(yk)) if kisa != "Yok" else np.nan
    gini = _bd_gini(yk, sk) if kisa != "Yok" else np.nan
    oran20 = b20["oran"].to_numpy(dtype="float64")
    mono = float(np.mean(np.diff(oran20) < 0)) if np.isfinite(oran20).sum() > 1 else np.nan
    cap100, prec100 = b100["cap"].to_numpy(dtype="float64"), b100["prec"].to_numpy(dtype="float64")
    ozet = {**ortak, "n": int(len(sk)), "vaka": vaka, "oran": vaka / len(sk) if len(sk) and np.isfinite(vaka) else np.nan,
            "ort": float(np.mean(sk)) if len(sk) else np.nan, "gini": gini,
            **{f"r{x}": cap100[x - 1] for x in (1, 5, 10, 20)}, **{f"p{x}": prec100[x - 1] for x in (1, 5, 10, 20)},
            "lift1": float(b20["lift"].iloc[0]), "mono": mono, "durum": uzun,
            "kontrol": _bd_kontrol(oz, rol, len(sk), vaka, gini)}
    bucket = []
    for nb, g in ((20, b20), (100, b100)):
        for r in g.to_dict("records"):
            r["b"] = int(r["b"])
            bucket.append({**ortak, "nb": nb, **r})
    b3 = []
    for p, j in ileri.items():
        ay = _bd_ay_fark(donem, p)
        for h in _BD_FPD_ADLAR:
            sec = np.isfinite(j[h]) & (np.isfinite(j["FSKOR"]) if j["FSKOR"] is not None else True)
            if not sec.any():
                continue
            sat = _bd_fpd_bolum3(j[h][sec], skor[j["i"][sec]], j["FSKOR"][sec] if j["FSKOR"] is not None else None)
            b3.append({**ortak, "fdonem": p, "ay": ay, "fh": h, "_sira": (_BD_FPD_ADLAR.index(h), p, -donem), **sat})
    b4, b5 = [], []
    if pc is not None:                                         # PredCs: modelin hedefinde, PredCs'si dolu bütün kitle
        pk = pc[kitle]
        ok = np.isfinite(pk)
        if ok.any():
            yo, so, po = yk[ok], sk[ok], _BD_PC_YON * pk[ok]
            sat = {**ortak, "hd": kisa, "nk": int(len(sk)), "pd": int(ok.sum()), "pdp": float(ok.mean()),
                   **_bd_fpd_bolum2(pd.DataFrame({"Y": yo, "SKOR": so, "FSKOR": po}), "Y")}
            sat["hk"] = _bd_hukum(sat).replace("FPD SKORU YETER", "PREDCS YETER")
            if sat.get("sonuc"):
                sat["sonuc"] = sat["sonuc"].replace("FPD skoru", "PredCs")
            b4.append(sat)
            fo = {h: a[ok] for h, a in ekk["fpd"].items()}
            for nb in (20, 100):
                gp = _bd_bucket(yo, po, nb, {"fpd": fo}).to_dict("records")
                gm = _bd_bucket(yo, so, nb, {}).to_dict("records")
                for a, c in zip(gp, gm):
                    alt, ust = (a["s_alt"], a["s_ust"]) if _BD_PC_YON == 1 else (-a["s_ust"], -a["s_alt"])
                    r = {**ortak, "nb": nb, "b": int(a["b"]), "p_n": a["n"], "p_alt": alt, "p_ust": ust,
                         **{f"p_{k}": a[k] for k in ("vaka", "oran", "lift", "cap", "prec")},
                         "m_n": c["n"], **{f"m_{k}": c[k] for k in ("vaka", "oran", "lift", "cap", "prec")},
                         "rfark": c["cap"] - a["cap"]}
                    for h in fo:
                        r[f"f_{h}_e"], r[f"f_{h}_o"] = a[f"f_{h}_e"], a[f"f_{h}_o"]
                    b5.append(r)
    b1, b2 = [], []
    if _BD_FPD is not None:
        d = pd.DataFrame({"MBB_NO": mbb, "DONEM": donem, "HDF": y, "SKOR": skor})
        if kisa != "Yok":
            d = d[kitle]
        d = d.dropna(subset=["MBB_NO"]).drop_duplicates(["MBB_NO", "DONEM"], keep="first").reset_index(drop=True)
        d["DONEM"] = d["DONEM"].astype("Int64")
        d["GRUP"] = _bd_ata(d["SKOR"].to_numpy(), _BD_N_GRUP)
        d = d.merge(_BD_FPD.rename(columns={"_key": "MBB_NO", "_donem": "DONEM"}), on=["MBB_NO", "DONEM"], how="left")
        for h in _BD_FPD_ADLAR:
            b1.append({**ortak, "fh": h, "hd": kisa, **_bd_fpd_bolum1(d, h)})
        if _bd_fpd_skorlu:                                    # FPD hedefleri Bölüm 3'te (0 ay önce satırları)
            dm = d[d[_BD_FPD_ADLAR].notna().any(axis=1) & d["FSKOR"].notna()]
            sat = {**ortak, "hedef": "Model hedefi", "hd": kisa, **_bd_fpd_bolum2(dm, "HDF")}
            sat["hk"] = _bd_hukum(sat)
            b2.append(sat)
    return {"ozet": ozet, "bucket": bucket, "b1": b1, "b2": b2, "b3": b3, "b4": b4, "b5": b5}


