                                  "da gösterir.")}[tip]
        return _AILE_ADI["GIZLI"], a[0], a[1]

    m = re.match(r"^(INT_.+)_INTD_(LM|L3M|L6M|L9M|L12M)_(L3M|L6M|L9M|L12M)$", ad)
    if m:
        aile, y, u = m.groups()
        ia = _INT_AILE_ACIKLAMA.get(aile)
        ne = f"{aile} ({ia})" if ia else aile
        return (_AILE_ADI["INT"], f"{ne}: {_PENCERE_ADI[y]} penceresi değeri / {_PENCERE_ADI[u]} penceresi değeri "
