    r += 1
    for e, m, yuk in [
        ("Karşılaştırılan modeller", f"Her vade için iki model: {KT_TAKIP_AD} X ay içinde takibe düşenleri hedefler. "
                                     f"{KT_TK_AD} aynı takip hedefine ek olarak X. ayın sonunda Kırmızı olanları da hedef "
                                     "sayar. İki modelde takip aynıdır; aradaki tek fark X ay sonra Kırmızı olanlardır. 6M ve "
                                     "12M ayrı bloklardadır.", 46),
        ("Sorulan soru", f"{KT_TK_AD} Kırmızı olanları da hedeflediği için takibe düşecek (batık) müşterileri {KT_TAKIP_AD} "
                         "kadar yakalıyor mu? İki model aynı müşterileri mi riskli buluyor, hangisi neyi kaçırıyor?", 32),
        ("Kimler üzerinde", f"{OOT_DONEMI} döneminde iki modelden en az birinin skorladığı müşteriler. İki modelin OOT "
                            "müşteri listeleri MBB_NO ve dönemle full outer join yapılır; bir modelde olmayan müşterinin o "
                            "modeldeki grubu \"Yok\" yazılır ve o model onu riskli saymamış olur. Her renk segmentinin kendi "
                            "modeli vardır.", 46),
        ("20'li gruplar", f"Her model kendi müşterilerini skora göre en riskliden en az riskliye 20 eşit gruba ayırır: B1 = en "
                          f"riskli %5, B20 = en az riskli %5. Riskli = en riskli %{KT_RISKLI_YZD} (B1-B{_KT_UST}).", 32),
        ("Batık", f"Müşterinin X ay içinde takibe düşmesi: iki modelin ortak hedefi ve bu sayfanın ana ölçüsü. Takip veya "
                  f"kırmızı: {KT_TK_AD}nin hedefi (X ay içinde takip ya da X. ayın sonunda Kırmızı); iki model bu hedefte de "
                  "ölçülür.", 32),
        ("Nasıl okunur", f"Yakalama: bütün batıkların yüzde kaçı o modelin en riskli %{KT_RISKLI_YZD}'sinde. Sonuç: yalnızca "
                         f"{KT_TAKIP_AD}nin riskli dediği grup ile yalnızca {KT_TK_AD}nin riskli dediği grubun batık oranı "
                         f"karşılaştırılır; fark {_adet(KT_BERABER_PUAN * 100)} puandan küçükse \"Fark yok\". {KT_TAKIP_AD} "
                         f"lehine net ek batık = yalnız {_KT_T} riskli gruptaki batık - yalnız {_KT_TK} riskli gruptaki batık.", 46),
    ]:
        S.satir(r, e, m, yuk)
        r += 1

    detay = pd.concat([b["detay"] for b in bloklar], ignore_index=True) if bloklar else pd.DataFrame()
    n_det = len(detay)
    # detay tablonun yeri (formüller için baştan hesaplanır): her blok sabit satır sayısı kaplar
    n_renk_max = max(len(b["ozet"]) for b in bloklar) if bloklar else 0
    _grafik_cm = max(7.5, 3.0 + 1.1 * n_renk_max)
    _grafik_satir = _cm_satir(_grafik_cm)
    _matris_satir = 1 + 1 + 1 + (len(_KT_GRUPLAR) + 2) + 1 + 1 + (len(_KT_GRUPLAR) + 2) + 1 + 1
    _blok_satir = 1 + 1 + 1 + 1 + n_renk_max + 1 + _grafik_satir + _matris_satir
    d0 = r + 1 + len(bloklar) * (_blok_satir + 1) + 2          # detay başlık satırı
    dh, dsn = d0 + 1, d0 + 1 + n_det                          # detay tablo başlığı ve son satırı

    def rng(c):
        col = L(2 + list(detay.columns).index(c))
        return f"${col}${dh + 1}:${col}${dsn}"

    renk_secenek = ["Tümü"] + [_seg_etiket(k) for k, _, _ in RENKLER]
    for b in bloklar:
        v, oz = b["vade"], b["ozet"]
        r += 1
        bas = r
        S.baslik(r, f"{v} Ay: {KT_TAKIP_AD} ({v}M Takip) ve {KT_TK_AD} ({v}M Takip + {v}M Sonra Kırmızı)")
        r += 1
        bi = b["bilgi"]
        S.not_satiri(r, f"{KT_TAKIP_AD}: {bi['t_klasor']} | {KT_TK_AD}: {bi['tk_klasor']} | Kitle {_adet(bi['n'])} kişi: "
                        f"ikisinde de {_adet(bi['iki'])}, yalnız {_KT_T} modelinde {_adet(bi['yalniz_t'])}, yalnız {_KT_TK} "
                        f"modelinde {_adet(bi['yalniz_tk'])}"
                        + (f" | df_raw'dan tamamlanan hedef: batık {_adet(bi['doldurulan'][0])}, takip veya kırmızı "
                           f"{_adet(bi['doldurulan'][1])}" if any(bi["doldurulan"]) else "")
                        + (f" | hedefi bilinmeyen (oranlara girmez): batık {_adet(bi['batik_bos'])}, takip veya kırmızı "
                           f"{_adet(bi['tk_bos'])}" if bi["batik_bos"] or bi["tk_bos"] else ""), yuk=30)
        r += 1
        for g in dict.fromkeys(k[0] for k in _KT_KOL):          # grup bandı
            cs = [_KT_C[k[3]] for k in _KT_KOL if k[0] == g]
            S.birlestir(r, cs[0], cs[-1], _KT_GRUP_ADI[g], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, size=10,
                        h="center", kenar=_KENAR_B)
        S.birlestir(r, 2, 2, "", fill=_BOLUM, kenar=_KENAR_B)
        ws.row_dimensions[r].height = 30
        r += 1
        hr = r                                                # özet başlığı
        S.hucre(r, 2, "Renk Segmenti", bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
        for k in _KT_KOL:
            S.hucre(r, _KT_C[k[3]], k[1], bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
        ws.row_dimensions[r].height = 72
        r += 1
        for etiket, d in oz:
            toplam = etiket == "Toplam"
            S.hucre(r, 2, etiket, bold=toplam, fill=_ALT if toplam else None, dikey="center")
            for k in _KT_KOL:
                x = S.hucre(r, _KT_C[k[3]], _kt_deger(d[k[3]]), fmt=k[2], h="center", dikey="center", size=10,
                            bold=toplam, fill=_ALT if toplam else None)
                if k[3] == "sonuc":
                    x.fill = PatternFill("solid", fgColor=KT_SONUC_RENK.get(d["sonuc"], "FFFFFF"))
                    x.font = Font(name=YAZI_TIPI, bold=True, size=10)
            ws.row_dimensions[r].height = 18
            r += 1
        rs = r - 1
        for c1 in ("yak_t", "yak_k", "st_o", "sk_o"):          # yüksek yakalama / oran koyu
            c = L(_KT_C[c1])
            ws.conditional_formatting.add(f"{c}{hr + 1}:{c}{rs}", ColorScaleRule(
                start_type="min", start_color="FFFFFF", end_type="max", end_color="F4B6B7"))
        r += 1                                                # boşluk
        # ---- grafikler ----
        ch1 = _cubuk_grafik(ws, f"Batığı yakalama: en riskli %{KT_RISKLI_YZD}'de batıkların yüzde kaçı var",
                            [(_KT_C["yak_t"], KT_TAKIP_AD, "404040"), (_KT_C["yak_k"], KT_TK_AD, AKBANK_KIRMIZI),
                             (_KT_C["yak_u"], "İkisinden biri", "A6A6A6")], 2, hr, rs, "0%", "0%", 17.0, _grafik_cm,
                            _eksen_siniri([d[k] for _, d in oz for k in ("yak_t", "yak_k", "yak_u")]))
        ch2 = _cubuk_grafik(ws, "Yalnızca birinin riskli dediği müşterilerde batık oranı",
                            [(_KT_C["st_o"], f"Yalnız {_KT_T} riskli", "404040"),
                             (_KT_C["sk_o"], f"Yalnız {_KT_TK} riskli", AKBANK_KIRMIZI)], 2, hr, rs, "0%", "0.0%", 17.0,
                            _grafik_cm, _eksen_siniri([d[k] for _, d in oz for k in ("st_o", "sk_o")]))
        ws.add_chart(ch1, f"B{r}")
        ws.add_chart(ch2, f"{L(_KT_C['st_n'])}{r}")
        r += _grafik_satir
        # ---- 20x20 tablolar (formülle detay tablodan; renk seçimine göre) ----
        S.hucre(r, 2, "Renk segmenti seç:", bold=True, dikey="center", kenar=None)
        S.birlestir(r, 3, 5, "Tümü", bold=True, h="center", dikey="center", fill=PatternFill("solid", fgColor="FFF2CC"))
        dv = DataValidation(type="list", formula1='"' + ",".join(renk_secenek) + '"', allow_blank=False,
                            showDropDown=False)
        dv.error, dv.errorTitle = "Listeden bir renk segmenti seçin.", "Renk segmenti"
        ws.add_data_validation(dv)
        dv.add(f"C{r}")
        S.birlestir(r, 6, 24, "Aşağıdaki iki tablo seçilen renk segmentine göre yeniden hesaplanır (Tümü: bütün renkler).",
                    italic=True, renk="595959", size=10, kenar=None, dikey="center")
        ws.row_dimensions[r].height = 20
        sec_ref = f"${L(3)}${r}"
        renk_krit = f'IF({sec_ref}="Tümü","*",{sec_ref})'
        r += 1
        if not n_det:
            S.not_satiri(r, "Detay veri yok; 20x20 tablolar yazılamadı.")
            r = bas + _blok_satir
            continue
        for baslik_m, tur in ((f"Kişi sayısı: satır = {KT_TAKIP_AD}nin grubu, kolon = {KT_TK_AD}nin grubu ({v}M)", "kisi"),
                              (f"Batık oranı: satır = {KT_TAKIP_AD}nin grubu, kolon = {KT_TK_AD}nin grubu ({v}M)", "oran")):
            r += 1
            S.birlestir(r, 2, 3 + len(_KT_GRUPLAR), baslik_m, bold=True, fill=_ALT, dikey="center")
            ws.row_dimensions[r].height = 18
            r += 1
            mh = r
            S.hucre(r, 2, f"{_KT_T} ↓  {_KT_TK} →", bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center",
                    kenar=_KENAR_B, size=9)
            for j, g in enumerate(_KT_GRUPLAR + ["Toplam"]):
                S.hucre(r, 3 + j, g, bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
            ws.row_dimensions[r].height = 30
            r += 1
            for gt in _KT_GRUPLAR + ["Toplam"]:
                toplam_s = gt == "Toplam"
                S.hucre(r, 2, gt, bold=True, fill=_ALT if toplam_s else None, h="center")
                for j, gk in enumerate(_KT_GRUPLAR + ["Toplam"]):
                    toplam_k = gk == "Toplam"
                    kt = '"*"' if toplam_s else f"$B{r}"                 # satır: Takip modelinin grubu
                    kk = '"*"' if toplam_k else f"{L(3 + j)}${mh}"       # kolon: Takip + Kırmızı modelinin grubu
                    ortak = (f'{rng("Vade")},{v},{rng("Renk Segmenti")},{renk_krit},'
                             f'{rng(_KT_D_T)},{kt},{rng(_KT_D_K)},{kk}')
                    if tur == "kisi":
                        f = f'=SUMIFS({rng("Kişi")},{ortak})'
                        fmt = "#,##0"
                    else:
                        f = f'=IFERROR(SUMIFS({rng("Batık vaka")},{ortak})/SUMIFS({rng("Batığı bilinen")},{ortak}),"")'
                        fmt = "0.0%"
                    S.hucre(r, 3 + j, f, fmt=fmt, h="center", size=9, bold=toplam_s or toplam_k,
                            fill=_ALT if (toplam_s or toplam_k) else None)
                ws.row_dimensions[r].height = 15
                r += 1
            ilk, son = f"{L(3)}{mh + 1}", f"{L(2 + len(_KT_GRUPLAR))}{mh + len(_KT_GRUPLAR)}"
            ws.conditional_formatting.add(f"{ilk}:{son}", ColorScaleRule(
                start_type="min", start_color="FFFFFF", end_type="max",
                end_color="9DC3E6" if tur == "kisi" else "F8696B"))
        S.not_satiri(r, f"Sol üstteki {_KT_UST}x{_KT_UST} kare: ikisinin de riskli dediği müşteriler. Üst satırlar (B1-B{_KT_UST}) "
                        f"{KT_TAKIP_AD}nin, sol kolonlar (B1-B{_KT_UST}) {KT_TK_AD}nin riskli dedikleri. Köşegenden "
                        "uzaklaştıkça iki model aynı müşteriye farklı risk veriyor. Yok: müşteri o modelde yok.", yuk=30)
        r = bas + _blok_satir
    # ---- detay tablo ----
    if n_det:
        S.baslik(d0, f"Detay: vade x renk x {KT_TAKIP_AD} grubu x {KT_TK_AD} grubu (20x20 tabloların kaynağı; "
                     "filtrelenebilir)", c2=1 + len(detay.columns))
        for j, c in enumerate(detay.columns):
            S.hucre(dh, 2 + j, c, bold=True, fill=_BOLUM, renk=BASLIK_YAZI, h="center", kenar=_KENAR_B, size=10)
        ws.row_dimensions[dh].height = 32
        fmts = {"Kişi": "#,##0", "Batığı bilinen": "#,##0", "Batık vaka": "#,##0", "Batık oranı": "0.0%",
                "Takip veya kırmızı bilinen": "#,##0", "Takip veya kırmızı vaka": "#,##0", "Takip veya kırmızı oranı": "0.0%"}
        for i, row in enumerate(detay.itertuples(index=False), start=dh + 1):
            for j, val in enumerate(row):
                c = detay.columns[j]
                x = ws.cell(i, 2 + j, _kt_deger(val.item() if hasattr(val, "item") else val))
                x.font = Font(name=YAZI_TIPI, size=10)
                if c in fmts:
                    x.number_format = fmts[c]
        _tablo_ekle(ws, "Takip_TakipKirmizi_Detay", dh, dsn, 2, list(detay.columns))
    _yazdir(ws)
    return ws


