    for t, h in enumerate(fpd_adlar):
        tablolar.append((f"{h} oranı (vaka / kişi): {yon}", "0.00%", "F8696B", (1 + t, 0)))
    for t, (baslik_m, fmt, renk, kaynak) in enumerate(tablolar):
