def _fk_grafik_yerlesimi(kitap):
    """Grafiklerde yazılar üst üste binmesin: başlık üstte, açıklama (legend) altta ve ikisi de çizim alanının dışında;
    çizim alanı (eksen etiketleri dahil) aradaki boşluğa sabitlenir. Boşluklar başlığın ve açıklamanın uzunluğuna göre
    cm olarak hesaplanır. Başlık 12 punto kalın. Bütün sheet'lerdeki grafiklere uygulanır; tekrar çağırmak zararsızdır."""
    from openpyxl.chart import BarChart
    from openpyxl.chart.layout import Layout, ManualLayout
    from openpyxl.drawing.text import CharacterProperties, ParagraphProperties

    def _satir(uzunluk_cm, en_cm):
        return max(1, int(np.ceil(uzunluk_cm / max(en_cm - 1.2, 3.0))))

    def _metin(t):
        try:
            return "".join(r.t or "" for p in t.tx.rich.p for r in (p.r or []))
        except Exception:
            return ""

    for w in kitap.worksheets:
        for ch in getattr(w, "_charts", []):
            en, boy = float(ch.width or 15.0), float(ch.height or 7.5)
            ust, alt, sol, sag = 0.3, 0.3, 0.25, 0.45
            if ch.title is not None:
                ch.title.overlay = False
                for p in ch.title.tx.rich.p:
                    p.pPr = ParagraphProperties(defRPr=CharacterProperties(sz=1200, b=True))
                    for r in (p.r or []):
                        r.rPr = CharacterProperties(sz=1200, b=True)
                ust = 0.5 + 0.65 * _satir(len(_metin(ch.title)) * 0.25, en)
            if ch.legend is not None:
                ch.legend.overlay = False
                ch.legend.position = "b"
                adlar = []
                for s in ch.series:
                    ad = getattr(getattr(s, "tx", None), "v", None)
                    adlar.append(len(ad) if ad else 25)
                alt = 0.45 + 0.5 * _satir(sum(n * 0.2 + 1.2 for n in adlar), en)
            yatay = isinstance(ch, BarChart) and ch.type == "bar"
            alt_eksen, sol_eksen = (ch.y_axis, ch.x_axis) if yatay else (ch.x_axis, ch.y_axis)
            if getattr(alt_eksen, "title", None) is not None:
                alt += 0.9
            if getattr(sol_eksen, "title", None) is not None:
                sol += 1.0
            ch.layout = Layout(manualLayout=ManualLayout(
                layoutTarget="outer", xMode="edge", yMode="edge", x=sol / en, y=ust / boy,
                w=max(0.3, 1.0 - (sol + sag) / en), h=max(0.3, 1.0 - (ust + alt) / boy)))


def _fk_gorselleri_tazele():
    """openpyxl ilk kayıtta görsel akışlarını kapatır; yeniden kayıt için görselleri son yazılan dosyadan geri yükler."""
    imgs = [img for w in wb.worksheets for img in getattr(w, "_images", [])]
    if not imgs:
        return
    medya = {}
    if isinstance(globals().get("_veri"), (bytes, bytearray)):
