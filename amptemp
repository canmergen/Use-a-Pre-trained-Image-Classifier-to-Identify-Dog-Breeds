import numpy as np
import pandas as pd

# ==================================================================
# ÖDEME ORANI TEMİZLİĞİ: o ay bakiyesi (KK_RISK) 0'dan büyük değilse ödeme oranı 100 → boş.
# Neden: log tablosu borcu olmayan kartları 202404, 202406, 202410, 202501 ve 202503'te 100 yazmış, diğer aylarda hiç
# yazmamış. Kural bütün aylara aynı uygulandığı için aylar tutarlı olur.
# Bakiye 0, eksi ya da boşsa ve ödeme oranı 100 ise boş yapılır; bakiye 0'dan büyükse 100 aynen kalır. 100 dışındaki
# değerlere dokunulmaz.
# SIRA: ham veri (df) yüklendikten hemen sonra; 21, 22, 23 ve pipeline'dan ÖNCE. Eğitim verisi de değiştiği için
# pipeline yeniden çalıştırılmalı. Hücreyi iki kez çalıştırmak zararsız (ikincide değişen 0 olur).
# ==================================================================
_TM_AYLAR = ["LM"] + [f"L{i}M" for i in range(2, 13)]
_tm_eksik = [k for a in _TM_AYLAR for k in (f"KK_ODEME_ORANI_{a}", f"KK_RISK_{a}") if k not in df.columns]
if _tm_eksik:
    raise RuntimeError(f"df'te eksik kolon: {_tm_eksik[:6]}")

_tm_don = pd.to_numeric(df["DONEM"], errors="coerce").to_numpy()
_tm_kk = (df["KK_URUN_FLG"] == "KK").to_numpy() if "KK_URUN_FLG" in df.columns else np.ones(len(df), dtype=bool)
_tm_ay0 = (_tm_don // 100) * 12 + _tm_don % 100 - 1                    # dönemin ay sırası (NaN dönem → NaN)
_tm_say = {}                                                         # takvim ayı → [n, boş önce, 100 önce, değişen]
_tm_toplam = 0

for j, a in enumerate(_TM_AYLAR):
    o_kol, r_kol = f"KK_ODEME_ORANI_{a}", f"KK_RISK_{a}"
    o = pd.to_numeric(df[o_kol], errors="coerce").to_numpy("float64", na_value=np.nan)
    r = pd.to_numeric(df[r_kol], errors="coerce").to_numpy("float64", na_value=np.nan)
    degis = (o == 100) & ~(r > 0)                                    # bakiye 0, eksi ya da boş
    # rapor (yalnızca KK müşterileri): takvim ayı bazında önce / sonra
    ay = _tm_ay0 - (j + 1)
    ok = _tm_kk & np.isfinite(ay)
    if ok.any():
        k = ay[ok].astype(np.int64)
        k0 = int(k.min())
        n_ = np.bincount(k - k0)
        b_ = np.bincount(k - k0, weights=np.isnan(o[ok]))
        y_ = np.bincount(k - k0, weights=(o[ok] == 100))
        d_ = np.bincount(k - k0, weights=degis[ok])
        for i in np.flatnonzero(n_):
            s = _tm_say.setdefault(k0 + int(i), [0, 0, 0, 0])
            s[0] += int(n_[i]); s[1] += int(b_[i]); s[2] += int(y_[i]); s[3] += int(d_[i])
    if degis.any():
        df.loc[degis, o_kol] = np.nan
        _tm_toplam += int(degis.sum())


def _tm_y(x):
    return "%" + f"{100 * x:.1f}".replace(".", ",")


_tm_rapor = pd.DataFrame([{"Takvim ayı": f"{k // 12}{k % 12 + 1:02d}", "Değer": f"{s[0]:,}".replace(",", "."),
                           "Boş önce": _tm_y(s[1] / s[0]), "100 önce": _tm_y(s[2] / s[0]),
                           "Boş sonra": _tm_y((s[1] + s[3]) / s[0]), "100 sonra": _tm_y((s[2] - s[3]) / s[0]),
                           "Değişen": _tm_y(s[3] / s[0])} for k, s in sorted(_tm_say.items())])
print(f"Ödeme oranı temizlendi: {_tm_toplam:,}".replace(",", ".") + " değer 100 → boş "
      "(bakiyesi 0'dan büyük olmayan aylar).")
print("Takvim ayı bazında, bütün dönem satırları birlikte (KK müşterileri). Temizlikten sonra * aylar diğerlerinden "
      "ayrışmamalı:")
with pd.option_context("display.width", 200, "display.max_rows", 100):
    print(_tm_rapor.to_string(index=False))

