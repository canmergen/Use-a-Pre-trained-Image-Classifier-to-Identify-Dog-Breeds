def _kt_bedel(d):
    tr = (d["GT"] >= 1) & (d["GT"] <= _KT_UST)
    kr = (d["GK"] >= 1) & (d["GK"] <= _KT_UST)
    ur, th = tr | kr, d["TH"].astype(bool)
    bil, y = d["BATIK"].notna(), d["BATIK"].fillna(0)
    kbil, ky = d["TKH"].notna(), d["TKH"].fillna(0)
    iyi = bil & (y == 0)
    n_iyi, vaka = int(iyi.sum()), float(y[bil].sum())

    def ters(m):                                              # iyi müşterinin yüzde kaçı işaretli
        return float((m & iyi).sum()) / n_iyi if n_iyi else np.nan

    def isabet(m):
        k = m & bil
        return float(y[k].mean()) if k.any() else np.nan

    def yak(m):
        return float(y[m & bil].sum()) / vaka if vaka > 0 else np.nan

    def akibet(m):                                            # takip / takip yok ama Kırmızı / ikisi de değil / erken
        b = m & bil & kbil
        nb = int(b.sum())
        e = m & iyi & d["ERKEN"].notna()
        erken = float(d.loc[e, "ERKEN"].mean()) if e.any() else np.nan
        if not nb:
            return np.nan, np.nan, np.nan, erken
        return (float((b & (y == 1)).sum()) / nb, float((b & (y == 0) & (ky == 1)).sum()) / nb,
                float((b & (y == 0) & (ky == 0)).sum()) / nb, erken)

    st, sk = tr & ~kr, kr & ~tr
    ek_iyi, ek_batik = int((sk & iyi).sum()), float(y[sk & bil].sum())
    yu, ay = yak(ur), yak(th)
    if vaka == 0 or not np.isfinite(yu) or not np.isfinite(ay):
        bs = "Vaka yok"
    elif yu - ay < KT_BERABER_PUAN:
        bs = f"Aynı hacimde {KT_TAKIP_AD} yeterli"
    else:
        bs = f"İkisinden biri {(yu - ay) * 100:.1f} puan fazla yakalıyor".replace(".", ",")
    at, ak = akibet(st), akibet(sk)
    return {"iy_n": n_iyi, "gy_o": float(ky[kbil].mean()) if kbil.any() else np.nan,
            "fa_t": ters(tr), "fa_k": ters(kr), "fa_u": ters(ur), "is_t": isabet(tr), "is_k": isabet(kr), "is_u": isabet(ur),
            "mk_n": int(sk.sum()), "mk_i": ek_iyi, "mk_o": ek_iyi / ek_batik if ek_batik > 0 else np.nan,
            "ah_h": float(th.sum()) / len(d) if len(d) else np.nan, "ah_y": ay, "ah_f": ters(th),
            "ah_d": (yu - ay) * 100 if np.isfinite(yu) and np.isfinite(ay) else np.nan,
            "dt_b": at[0], "dt_k": at[1], "dt_h": at[2], "dt_e": at[3],
            "dk_b": ak[0], "dk_k": ak[1], "dk_h": ak[2], "dk_e": ak[3], "bs": bs}


_KT_D_T, _KT_D_K = f"{KT_TAKIP_AD} grubu", f"{KT_TK_AD} grubu"   # detay tablo kolon adları


def _kt_detay(J, v):
    g = (J.assign(_b=J["BATIK"].notna(), _k=J["TKH"].notna())
          .groupby(["RENK", "GT", "GK"], sort=True)
          .agg(kisi=("MBB_NO", "size"), b_bil=("_b", "sum"), b_vaka=("BATIK", "sum"),
               k_bil=("_k", "sum"), k_vaka=("TKH", "sum")).reset_index())
    lab = (lambda x: f"B{int(x)}" if x > 0 else "Yok")
    return pd.DataFrame({
        "Vade": v, "Renk Segmenti": g["RENK"].map(_seg_etiket), _KT_D_T: g["GT"].map(lab), _KT_D_K: g["GK"].map(lab),
        "Kişi": g["kisi"].astype(int), "Batığı bilinen": g["b_bil"].astype(int),
        "Batık vaka": g["b_vaka"].fillna(0).astype(int),
        "Batık oranı": np.where(g["b_bil"] > 0, g["b_vaka"] / g["b_bil"].where(g["b_bil"] > 0), np.nan),
        "Takip veya kırmızı bilinen": g["k_bil"].astype(int), "Takip veya kırmızı vaka": g["k_vaka"].fillna(0).astype(int),
        "Takip veya kırmızı oranı": np.where(g["k_bil"] > 0, g["k_vaka"] / g["k_bil"].where(g["k_bil"] > 0), np.nan)})


