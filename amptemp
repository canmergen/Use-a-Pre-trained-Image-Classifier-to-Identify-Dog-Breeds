def _bd_kontrol(oz, rol, n, vaka, gini):
    """Eğitim özetiyle karşılaştırma: kitle, vaka (ve OOT'de Gini) aynı mı."""
    if oz is None or rol not in ("train", "oot"):
        return ""
    g = lambda k: pd.to_numeric(oz.get(k), errors="coerce")
    if rol == "train":
        en = g("n_train") + g("n_val")
        ev = (g("bad_train") + g("bad_val") if pd.notna(g("bad_train")) and pd.notna(g("bad_val"))
              else g("target_rate") * g("n_train") + g("val_target_rate") * g("n_val"))
        eg = np.nan
    else:
        en = g("n_oot")
        ev = g("bad_oot") if pd.notna(g("bad_oot")) else g("oot_target_rate") * g("n_oot")
        eg = g("oot_gini")
    if not np.isfinite(en):
        return ""
    tol = 0 if (rol == "train" and pd.notna(g("bad_train"))) or (rol == "oot" and pd.notna(g("bad_oot"))) \
        else max(1.0, 0.0001 * en)
    fark = []
    if int(en) != int(n):
        fark.append(f"kitle (eğitimde {_adet(en)})")
    if not (np.isfinite(ev) and np.isfinite(vaka) and abs(ev - vaka) <= tol):
        fark.append(f"vaka (eğitimde {_adet(ev) if np.isfinite(ev) else '?'})")
    if np.isfinite(eg) and np.isfinite(gini) and abs(eg - gini) > 0.0006:
        fark.append(f"Gini (eğitimde %{eg * 100:.1f})".replace(".", ","))
    return "Aynı" if not fark else "Farklı: " + ", ".join(fark)


