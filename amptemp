             f"sonra {adim_metni} atılır" if adim_ust else f"Her turda {adim_metni} atılır")
    for e, m, yuk in [
        ("Aday havuzu", (f"Önceki koşularda modellere giren feature'ların birleşimi olan sabit liste ({int(havuz)} ad; ham kolon, "
                         "feature engineering ve desen feature'ları). Listede olmayan hiçbir kolon modele aday olmaz."
                         if havuz else "Sabit aday havuzu tanımlı değildi: feature engineering sonrası bütün kolonlar aday.")
         + (f" Elemeye giren aday sayısı: {int(aday)}." if aday else ""), 32),
        ("Limit ve risk", "Yönetim kararı: kart limitiyle ilgili her şey (ham KK_LIMIT kolonları ve yalnızca limitten üretilen "
                          "feature'lar) ve ham kart bakiyesi kolonları (KK_RISK_LM..L12M) modele aday değildir. Risk özetleri "
                          "(min, maks, ortalama, trend), kullanım oranı (risk / limit) ve başka göstergelerle etkileşimler "
                          "adaydır. Ham kolonlar veride kalır; kullanım oranı onlardan hesaplanır.", 32),
        ("Ön eleme", ("Havuzdaki adaylara SHAPRFECV'den önce iki eleme uygulandı: en sık değerinin payı %99'u aşan "
                      "(neredeyse sabit) kolonlar ve birbiriyle |Spearman| > 0,90 olan çiftlerde hedefle ilişkisi zayıf olan "
                      "atıldı. Aynı bilgiyi iki kez taşıyan feature'lar seçim aralığındaki yerleri doldurmaz. Elemeye giren "
                      "aday sayısı bu yüzden renkten renge değişir (tabloda)."
                      if _sn_ilk("onel") != 0 else
                      "Sabit havuzda sabit değer ve korelasyon elemesi uygulanmadı; bütün adaylar SHAPRFECV'ye girdi. "
                      "Seçilen sette birbirine çok benzeyen (|Spearman| > 0,90) feature çifti sayısı tabloda."), 32),
        ("SHAPRFECV", "Yalnızca train ile, 3 katlı çapraz doğrulama: her turda bir LightGBM eleme modeli (sabit parametre) "
                      "kurulur, modelin görmediği parçada CV Gini ve Capture@10 ölçülür ve her feature'ın SHAP önemi "
                      "(tahmine ortalama mutlak katkısı) hesaplanır; önemi en düşük feature'lar atılır. " + eleme + ".", 44),
        ("Seçim kuralı", f"Feature sayısı {aralik} (iki uç dahil) olan setler arasında CV Gini'si en yüksek set bulunur"
                         + (f"; Gini'si ona {_sn_yzd(tol, 1).lstrip('%')} puan yakın setlerin EN AZ feature'lısı seçilir. "
                            "Amaç: en az feature'la, en yüksek Gini'den çok uzaklaşmadan aynı etkiyi almak. Örnek: en yüksek "
                            "50 feature'da %49,26 ise %48,76 ve üstü olan en küçük set (25'te %48,85 ise 25) seçilir; eğri "
                            "ortada tepe yapıyorsa (ör. en yüksek 35'te) karşılaştırma o setle yapılır."
                            if tol and np.isfinite(tol) and tol > 0 else " ve o seçilir.")
                         + " Gini, sıralamanın tamamını ölçtüğü için Capture@10'dan kararlıdır.", 44),
        ("Nihai model", "Seçilen feature'larla Optuna" + (f" ({n_iter} deneme)" if n_iter else "") + ": amaç val Capture@10; "
                        "train - val Gini farkı eşiği aşan deneme cezalanır. Nihai model yalnızca train'de eğitilir; OOT "
                        "hiçbir karara girmez, yalnızca raporlanır.", 32),
        ("Feature sayısı modelleri", f"Her model klasöründe {SN_MODELRUN_KLASOR}/renk_<kod>_<ad>/ altında seçim aralığındaki "
                                     "her feature sayısı ve bütün adaylar için birer model (modelrunwith<N>feats.pkl, nihai "
                                     "modelin parametreleriyle) ve hangi feature'larla kurulduğu (modelrun_featurelar.csv).", 32),
        ("Grafikler", f"Her model x renk için eleme boyunca CV Gini: '{SN_GRAFIK_SAYFA}' sheet'i.", 18),
        ("CV Gini ile nihai Gini", "CV Gini'ler eleme modelinden (sabit parametre, train içi) gelir; nihai modelin train / val "
                                   "/ OOT Gini'siyle aynı olmaz. Setleri birbiriyle karşılaştırmak içindir.", 32),
    ]:
        S.satir(r, e, m, yuk)
        r += 1
    r += 1
    S.baslik(r, "Kullanılan modeller (her model x renk segmenti)", c2=son)
    r += 2
    dilim = [("seg", 46, 4, N_RENK), ("model", 34, 7, 1), ("vade", 16, 4, 3)]
    R0, RS, C = _bd_tablo(ws, S, r, _SN_K_MODEL, _SN_G_MODEL, _SN_MODELLER, "Sunum_Model_Secim", dilim, {})
    for k in ("cv_sec", "g_oot"):
        L = get_column_letter(C[k])
        ws.conditional_formatting.add(f"{L}{R0 + 1}:{L}{RS}", ColorScaleRule(
            start_type="min", start_color="FFFFFF", end_type="max", end_color="63BE7B"))
    r = RS + 3
    S.baslik(r, "Seçilen feature'lar (her model x renk; nihai modelde SHAP payına göre sıralı)", c2=son)
    r += 2
    _bd_tablo(ws, S, r, _SN_K_FEAT, _SN_G_FEAT, _SN_SECILEN, "Sunum_Secilen_Featurelar", dilim,
              {"seg": _bd_acilis_renk(_SN_SECILEN)} if _SN_SECILEN else {})
    _yazdir(ws)
    return ws


