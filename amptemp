                     pasif || zamansal, v => bfDegistir("test_oran", v))));
    kok.appendChild(testAlan);

    // ---- 2. asama: kalan train nasil kullanilir ----
    kok.appendChild(bfTrainKullanimiCiz(al));

    // ---- ozet satiri ----
    const degisti = bfDegisti();
    const sunucuOzeti = (BF.ozet !== null && BF.ozet !== undefined)
