# AKTİF HEDEFLER
# - NO:3  X_TAKIP (X = 3M / 6M / 12M)          -> X içinde GGS X/90 veya takibe düşüş = 1, düşmeyiş = 0
# - NO:5  X_SONRA_KIRMIZI_VE_TAKIP (6M / 12M)   -> X sonunda Kırmızı OR X içinde takip = 1, değil = 0 (union)
# - NO:6  X_SONRA_KIRMIZI_MIN3 (6M / 12M)       -> X içinde takibe gidenler (AKB_TAKIP_YY_XM_FLG == 1) kitleden elenir,
#                                                  kalan kitlede X sonunda Kırmızı AND X içinde en az 3 ay Kırmızı = 1, değil = 0
# - NO:7  X_SONRA_KIRMIZI_MIN3_VE_TAKIP (6M / 12M) -> (X sonunda Kırmızı AND X içinde en az 3 ay Kırmızı) OR X içinde takip = 1,
#                                                  değil = 0 (NO:5'in Kırmızı tarafına "en az 3 ay Kırmızı" şartı eklenmiş hali)
# YORUMA ALINAN HEDEFLER (kodları aşağıda duruyor, çalışmaz)
# - NO:1  X_KIRMIZI_RENGE_GOC          -> X içinde takibe gidenler (AKB_TAKIP_YY_XM_FLG == 1) kitleden elenir,
#                                         kalan kitlede seçilen ay sonrası X sonunda Kırmızı'ya geçiş = 1, geçmeyiş = 0
# - NO:2  X_ICINDE_KIRMIZI_RENGE_GOC   -> X içinde takibe gidenler (AKB_TAKIP_YY_XM_FLG == 1) kitleden elenir,
#                                         kalan kitlede X içinde herhangi bir ay Kırmızı = 1, değil = 0
# - NO:4  X_ICINDE_KIRMIZI_TAKIP       -> X içinde Kırmızı OR X içinde takip = 1, değil = 0 (union)
# - NO:5  3M_SONRA_KIRMIZI_VE_TAKIP    -> yalnızca 3M olanı yoruma alındı
# Yoruma alınan bir dalı yeniden açarken: zincirin ilk dalı "if", sonrakiler "elif" olmalı (şu an ilk dal 3M_TAKIP).

KIRMIZI_MIN_AY = 3            # NO:6 ve NO:7: X ay içinde en az kaç ay Kırmızı olmalı


def _kirmizi_ay_sayisi(frame, x):
    """Sonraki x ayın kaçında renk Kırmızı: RENK_SONRAKI_AY, RENK_SONRAKI_2AY ... RENK_SONRAKI_<x>AY.
    Toplam sayıdır (ayların art arda olması gerekmez); rengi boş olan ay Kırmızı sayılmaz.
    df'e kolon eklenmez (yeni kolon feature listesine sızmasın diye); satır sırasıyla dizi döner."""
    kolonlar = ['RENK_SONRAKI_AY'] + [f'RENK_SONRAKI_{i}AY' for i in range(2, x + 1)]
    eksik = [c for c in kolonlar if c not in frame.columns]
    if eksik:
        raise KeyError(f"Kırmızı ay sayısı için gereken kolon(lar) df'te yok: {eksik}")
    sayi = np.zeros(len(frame), dtype="int16")
    for c in kolonlar:
        sayi += (frame[c] == "1-Kırmızı").to_numpy()
    return sayi


def _kalici_kirmizi(frame, x):
    """NO:6 / NO:7'nin Kırmızı şartı: x ay sonra Kırmızı AND x ay içinde en az KIRMIZI_MIN_AY ay Kırmızı.
    Dönen: (şartı sağlayanlar, x ay sonra Kırmızı olanlar) iki bool dizi; ikincisi yalnızca print içindir."""
    sonra = (frame[f"RENK_{x}M_SONRASI"] == "1-Kırmızı").to_numpy()
    return sonra & (_kirmizi_ay_sayisi(frame, x) >= KIRMIZI_MIN_AY), sonra


