def _kt_ozet(d):
    gr = (d["GB"] >= 1) & (d["GB"] <= _KT_UST)
    tr = (d["TB"] >= 1) & (d["TB"] <= _KT_UST)
    bil, y = d["BATIK"].notna(), d["BATIK"].fillna(0)
    gbil, gy = d["GOC"].notna(), d["GOC"].fillna(0)
    vaka, gvaka = float(y[bil].sum()), float(gy[gbil].sum())

    def oran(m):
        k = m & bil
        return float(y[k].mean()) if k.any() else np.nan

    def yak(m):
        return float(y[m & bil].sum()) / vaka if vaka > 0 else np.nan

    def gyak(m):
        return float(gy[m & gbil].sum()) / gvaka if gvaka > 0 else np.nan

    sg, st, ir, it = gr & ~tr, tr & ~gr, gr & tr, ~gr & ~tr
    o_sg, o_st = oran(sg), oran(st)
    fark = o_st - o_sg
    if vaka == 0:
        sonuc = "Vaka yok"
    elif not np.isfinite(fark) or abs(fark) < KT_BERABER_PUAN:
        sonuc = "Fark yok"
    else:
        sonuc = "Takip modeli daha isabetli" if fark > 0 else "Göç modeli daha isabetli"
    return {"n": len(d), "iki": int(((d["GB"] > 0) & (d["TB"] > 0)).sum()),
            "yg": int(((d["GB"] > 0) & (d["TB"] == 0)).sum()), "yt": int(((d["GB"] == 0) & (d["TB"] > 0)).sum()),
            "vaka": vaka, "oran": float(y[bil].mean()) if bil.any() else np.nan,
            "yak_g": yak(gr), "yak_t": yak(tr), "yak_u": yak(gr | tr),
            "sg_n": int(sg.sum()), "sg_v": float(y[sg & bil].sum()), "sg_o": o_sg,
            "st_n": int(st.sum()), "st_v": float(y[st & bil].sum()), "st_o": o_st,
            "ir_n": int(ir.sum()), "ir_o": oran(ir), "it_n": int(it.sum()), "it_o": oran(it),
            "ort": float(ir.sum()) / float(tr.sum()) if tr.any() else np.nan,
            "gy_g": gyak(gr), "gy_t": gyak(tr),
            "net": float(y[st & bil].sum() - y[sg & bil].sum()), "sonuc": sonuc}


def _kt_detay(J, v):
    g = (J.assign(_b=J["BATIK"].notna(), _g=J["GOC"].notna())
          .groupby(["RENK", "GB", "TB"], sort=True)
          .agg(kisi=("MBB_NO", "size"), b_bil=("_b", "sum"), b_vaka=("BATIK", "sum"),
               g_bil=("_g", "sum"), g_vaka=("GOC", "sum")).reset_index())
    lab = (lambda x: f"B{int(x)}" if x > 0 else "Yok")
    return pd.DataFrame({
        "Vade": v, "Renk Segmenti": g["RENK"].map(_seg_etiket), "Göç grubu": g["GB"].map(lab),
        "Takip grubu": g["TB"].map(lab), "Kişi": g["kisi"].astype(int), "Batığı bilinen": g["b_bil"].astype(int),
        "Batık vaka": g["b_vaka"].fillna(0).astype(int),
        "Batık oranı": np.where(g["b_bil"] > 0, g["b_vaka"] / g["b_bil"].where(g["b_bil"] > 0), np.nan),
        "Kırmızı veya takip bilinen": g["g_bil"].astype(int), "Kırmızı veya takip vaka": g["g_vaka"].fillna(0).astype(int),
        "Kırmızı veya takip oranı": np.where(g["g_bil"] > 0, g["g_vaka"] / g["g_bil"].where(g["g_bil"] > 0), np.nan)})


