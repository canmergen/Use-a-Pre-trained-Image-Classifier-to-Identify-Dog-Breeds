SHAP_SET_GINI_TOL = 0.001     # SHAP set secimi: Gini toleransi tabani (1-SE buyukse o).
SHAP_GINI_TOL_MAX = 0.01      # SHAP set secimi: Gini toleransi ust siniri.
SHAP_GINI_TOL = 0.003         # Optuna deneme secimi: Gini toleransi.
# Optuna deneme seçimi: Capture eşitlik bandı = min(1-SE, SHAP_MAX_KAYIP x tavan).
OPTUNA_CAPTURE_SE_KATSAYI = 1.0
# True: taban tolerans rengin Capture tavanıyla çarpılır; False: 0.003 sabit.
