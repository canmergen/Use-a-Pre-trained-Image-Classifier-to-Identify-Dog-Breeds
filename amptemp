def _fk_s3_dataset():
    import pyarrow.fs as pafs
    import pyarrow.dataset as pads
    info = dataiku.Dataset(FK_FPD_DATASET).get_location_info(sensitive_info=True)["info"]
    yol = info.get("path", "")
    if not yol.startswith("s3://"):
        raise RuntimeError(f"dataset S3'te değil (path: {yol or 'yok'})")
    cp = info["connectionParams"]
    s3 = pafs.S3FileSystem(access_key=cp["accessKey"], secret_key=cp["secretKey"], endpoint_override=FK_S3_ENDPOINT,
                           scheme=FK_S3_SCHEME, force_virtual_addressing=False)
    return pads.dataset(yol.replace("s3://", ""), filesystem=s3, format="parquet")


def _fk_skor_adaylari(sema):
    """FPD şemasında skor olabilecek kolonlar (anahtar ve hedef kolonları hariç)."""
    haric = {FK_FPD_KEY.upper(), FK_FPD_DONEM.upper(), *[c.upper() for c in FK_FPD_HEDEFLER.values()]}
    kelime = {"SKOR", "SKORU", "SCORE", "PROB", "PROBABILITY", "PRED", "PD"}
    return [c for c in sema if c.upper() not in haric and (set(re.split(r"[_\W]+", c.upper())) & kelime)]


def _fk_fpd_oku(donemler):
    """→ (FPD tablosu: _key, _donem, <hedef adları>, FSKOR_HAM | None, bilgi sözlüğü)."""
    bilgi = {"kaynak": None, "skor_kolonu": None, "adaylar": [], "yon": None, "yon_auc": None, "ham": 0, "tekil": 0}
    ds, sema = None, None
    try:
        ds = _fk_s3_dataset()
        sema = list(ds.schema.names)
        bilgi["kaynak"] = "S3 (pyarrow)"
    except Exception as e:
        _log(f"   ℹ FPD S3 hızlı okuma kullanılamadı ({type(e).__name__}: {str(e)[:120]}); Dataiku API ile okunacak")
        sema = [c["name"] for c in dataiku.Dataset(FK_FPD_DATASET).read_schema()]
        bilgi["kaynak"] = "Dataiku API"
    gercek = {c.upper(): c for c in sema}
    gerekli = [FK_FPD_KEY, FK_FPD_DONEM] + list(FK_FPD_HEDEFLER.values())
    eksik = [c for c in gerekli if c.upper() not in gercek]
    if eksik:
        raise KeyError(f"{FK_FPD_DATASET} içinde kolon yok: {eksik}")
    bilgi["adaylar"] = _fk_skor_adaylari(sema)
    if FK_FPD_SKOR_KOLONU:
        if str(FK_FPD_SKOR_KOLONU).upper() not in gercek:
            raise KeyError(f"FK_FPD_SKOR_KOLONU = {FK_FPD_SKOR_KOLONU} FPD tablosunda yok. Adaylar: {bilgi['adaylar'][:20]}")
        bilgi["skor_kolonu"] = gercek[str(FK_FPD_SKOR_KOLONU).upper()]
    elif len(bilgi["adaylar"]) == 1 or len([c for c in bilgi["adaylar"] if "FPD" in c.upper()]) == 1:
        fpdli = [c for c in bilgi["adaylar"] if "FPD" in c.upper()]
        bilgi["skor_kolonu"] = fpdli[0] if len(fpdli) == 1 else bilgi["adaylar"][0]
        _log(f"   FPD skoru olarak {bilgi['skor_kolonu']} kullanılıyor (adaylar: {bilgi['adaylar'][:10]}; değilse "
             "FK_FPD_SKOR_KOLONU'na yazın)")
    else:
        _log(f"   ⚠ FPD skoru kolonu belirlenemedi ({len(bilgi['adaylar'])} aday: {bilgi['adaylar'][:15]}); "
             "FK_FPD_SKOR_KOLONU'na yazın. Bölüm 2 (FPD skoru ile kıyas) yazılmayacak")
    kol = [gercek[c.upper()] for c in gerekli] + ([bilgi["skor_kolonu"]] if bilgi["skor_kolonu"] else [])
    don_kol = gercek[FK_FPD_DONEM.upper()]
    if ds is not None:
        import pyarrow as pa
        import pyarrow.compute as pc
        tip = ds.schema.field(don_kol).type
        degerler = [str(d) for d in donemler] if pa.types.is_string(tip) else [int(d) for d in donemler]
        try:
            ham = ds.to_table(columns=kol, filter=pc.field(don_kol).isin(degerler), use_threads=True).to_pandas()
        except Exception:
            ham = ds.to_table(columns=kol, use_threads=True).to_pandas()
            ham = ham[_fk_tamsayi(ham[don_kol]).isin(list(donemler))]
    else:
        parca = []
        for i, ch in enumerate(dataiku.Dataset(FK_FPD_DATASET).iter_dataframes(chunksize=FK_CHUNK, columns=kol), start=1):
            parca.append(ch[_fk_tamsayi(ch[don_kol]).isin(list(donemler))])
            _log(f"   FPD parça {i}: OOT dönemlerinden {sum(len(p) for p in parca):,} satır")
        ham = pd.concat(parca, ignore_index=True) if parca else pd.DataFrame(columns=kol)
    bilgi["ham"] = len(ham)
    f = pd.DataFrame({"_key": _fk_tamsayi(ham[gercek[FK_FPD_KEY.upper()]]), "_donem": _fk_tamsayi(ham[don_kol])})
    for ad, c in FK_FPD_HEDEFLER.items():
        v = pd.to_numeric(ham[gercek[c.upper()]], errors="coerce")
        f[ad] = v.where(v.isin([0, 1]))
    if bilgi["skor_kolonu"]:
        f["FSKOR_HAM"] = pd.to_numeric(ham[bilgi["skor_kolonu"]], errors="coerce")
    del ham
    f = f.dropna(subset=["_key", "_donem"])
    if bilgi["skor_kolonu"]:                                  # yön: büyük skor riskli mi
        h_yon = "TKP_ST_5M90" if "TKP_ST_5M90" in FK_FPD_HEDEFLER else _FK_HEDEF_ADLARI[0]
        g = _fk_gini(f[h_yon], f["FSKOR_HAM"])
        bilgi["yon_auc"] = g
        bilgi["yon"] = int(FK_FPD_SKOR_YON) if FK_FPD_SKOR_YON in (1, -1) else (1 if not np.isfinite(g) or g >= 0 else -1)
        f["FSKOR"] = bilgi["yon"] * f["FSKOR_HAM"]
        _gm = f"{g * 100:.1f}" if np.isfinite(g) else "hesaplanamadı"
        _log(f"   FPD skoru {bilgi['skor_kolonu']}: büyük skor = {'riskli' if bilgi['yon'] == 1 else 'iyi'} "
             f"({'ayardan' if FK_FPD_SKOR_YON in (1, -1) else 'veriden'}; ham skorun {h_yon} Gini'si {_gm})")
    agg = {ad: "max" for ad in FK_FPD_HEDEFLER}
    if bilgi["skor_kolonu"]:
        agg["FSKOR"] = "max"                                  # aynı dönemde birden çok kayıt: en riskli skor
    f = f.groupby(["_key", "_donem"], as_index=False).agg(agg)
    bilgi["tekil"] = len(f)
    _log(f"   FPD hazır ({bilgi['kaynak']}): OOT dönemlerinde {bilgi['ham']:,} satır | {bilgi['tekil']:,} tekil (müşteri, dönem)")
    return f, bilgi


