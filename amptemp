# Her denemede capture / gini / bucket / parametre satırı basılır.
TRIAL_LOG = True
# True: her denemede OOT de skorlanır (yalnızca log, seçime girmez; ~%25 yavaş).
TRIAL_OOT = False

# --- SHAPRFECV AYARLARI ----------------------------------------------------------
# Yalnızca train, SHAP_CV katlı CV; skor Optuna ile aynı Capture@10.
SHAP_AKTIF = True
SHAP_CV = 3
# SHAP_STEP_ESIK altındaki turlarda kalanların bu payı atılır.
SHAP_STEP = 0.15
SHAP_MIN_FEATURES = 15
# SERT UST SINIR: secilen set hicbir durumda bunu gecmez (SHAP ve yedek secim).
SHAP_MAX_FEATURES = 25
SHAP_N_ESTIMATORS = 160
SHAP_SPW_CAP = 20.0          # Pozitif agirligini Optuna araliginda makul tut.
