# ==================================================================
# 3) HESAPLAR: bucket, Gini, FPD (20. hücreyle aynı tanımlar)
# ==================================================================
def _bd_ata(skor, nb):
    """Sıra bazlı eşit bölme; 1 = en yüksek skor (bucket raporu ve 20 ile aynı)."""
    s = np.asarray(skor, dtype="float64")
    n = len(s)
    if n == 0:
        return np.array([], dtype=int)
    order = np.argsort(s, kind="stable")
    r = np.empty(n, dtype="float64")
    r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
    return (nb - np.searchsorted(edges[1:-1], r, side="left")).astype(int)


def _bd_gini(y, s):
    y = np.asarray(y, dtype="float64")
    s = np.asarray(s, dtype="float64")
    ok = np.isfinite(y) & np.isfinite(s)
    y, s = y[ok], s[ok]
    n1 = float((y == 1).sum())
    n0 = float(len(y) - n1)
    if n1 == 0 or n0 == 0:
        return np.nan
    rank = pd.Series(s).rank(method="average").to_numpy()
    auc = (rank[y == 1].sum() - n1 * (n1 + 1) / 2.0) / (n1 * n0)
    return float(2.0 * auc - 1.0)


def _bd_bol(a, b):
    """a / b; b = 0 ya da boşsa NaN."""
    b = np.asarray(b, dtype="float64")
    return np.asarray(a, dtype="float64") / np.where(b > 0, b, np.nan)


_BD_HEDEF_KOL = ["vaka", "oran", "base", "lift", "tavan", "lift_tp", "cum_bad", "cap", "prec", "fpr",
                 "limit_bad", "risk_bad", "dr_risk"]


def _bd_bucket(y, s, nb, ek):
    """20 / 100 eşit grup tablosu; bucket raporundaki kolonlar + kümülatif precision / recall / yanlış alarm.
    ek: {"limit", "risk": dizi ya da None, "ek": {kolon: dizi}, "fpd": {hedef: dizi}, "pc": PredCs dizisi,
    "pcf": {FPD hedefi: dizi}} (y ve s ile aynı satırlar). pcf: PredCs'si dolu müşterilerdeki FPD vaka sayıları için.
    y tamamen boşsa (hedef yok) hedefe bağlı kolonlar boş kalır."""
    N = len(s)
    b = _bd_ata(s, nb)
    i = b - 1

    def say(w=None):
        if not N:
            return np.zeros(nb)
        return np.bincount(i, weights=w, minlength=nb)[:nb].astype("float64")

    n = say()
    sg = pd.Series(s).groupby(b).agg(["min", "mean", "max"]).reindex(range(1, nb + 1))
    g = {"b": np.arange(1, nb + 1), "n": n, "n_pct": n / N if N else np.full(nb, np.nan),
         "kum": np.cumsum(n) / max(N, 1), "s_alt": sg["min"].to_numpy(), "s_ort": sg["mean"].to_numpy(),
         "s_ust": sg["max"].to_numpy()}
    hedef = bool(np.isfinite(y).any())
    if hedef:
        y0 = np.nan_to_num(np.asarray(y, dtype="float64"))
        v = say(y0)
        top = float(v.sum())
        genel = top / N if N else np.nan
        tavan = min(1.0 / genel, nb) if genel > 0 else np.nan
        cn, cv = np.cumsum(n), np.cumsum(v)
        g.update(vaka=v, oran=_bd_bol(v, n), base=np.full(nb, genel), tavan=np.full(nb, tavan), cum_bad=cv,
                 cap=cv / top if top > 0 else np.full(nb, np.nan), prec=_bd_bol(cv, cn),
                 fpr=(cn - cv) / (N - top) if N - top > 0 else np.full(nb, np.nan))
        g["lift"] = g["oran"] / genel if genel > 0 else np.full(nb, np.nan)
        g["lift_tp"] = g["lift"] / tavan
    else:
        g.update({k: np.full(nb, np.nan) for k in _BD_HEDEF_KOL})
    for k in ("limit", "risk"):
        a = ek.get(k)
        if a is None:
            continue
        a0 = np.nan_to_num(a)                                   # boş tutarlar toplama girmez (bucket raporu gibi)
        g[k] = say(a0)
        if hedef:
            g[f"{k}_bad"] = say(a0 * y0)
    if hedef and ek.get("risk") is not None:
        g["dr_risk"] = _bd_bol(g["risk_bad"], g["risk"])
    for c, a in ek.get("ek", {}).items():                      # oran = 1 olanlar / dolu olanlar
        dolu = np.isfinite(a)
        adet = say(np.where(dolu, a, 0.0))
        g[f"e_{c}_a"], g[f"e_{c}_o"] = adet, _bd_bol(adet, say(dolu.astype("float64")))
    for h, a in ek.get("fpd", {}).items():                     # FPD: aynı müşteri ve dönemde kaydı olanlar
        dolu = np.isfinite(a)
        e, f1 = say(dolu.astype("float64")), say(np.where(dolu, a, 0.0))
        g[f"f_{h}_e"], g[f"f_{h}_1"], g[f"f_{h}_o"] = e, f1, _bd_bol(f1, e)
        g[f"f_{h}_t"] = _bd_bol(f1, n)                          # bütün müşterilerde: FPD kaydı olmayan 0 sayılır
    a = ek.get("pc")
    if a is not None:                                          # PredCs: dolu olan eşleşen sayılır
        dolu = np.isfinite(a)
        e = say(dolu.astype("float64"))
        g["pc_e"], g["pc_pay"], g["pc_o"] = e, _bd_bol(e, n), _bd_bol(say(np.where(dolu, a, 0.0)), e)
        for h, f in ek.get("pcf", {}).items():                 # PredCs'li müşterilerde FPD vaka (FPD kaydı yoksa 0)
            g[f"pc_f_{h}"] = say(np.where(dolu & np.isfinite(f), f, 0.0))
    return pd.DataFrame(g)


def _bd_fpd_bolum1(d, h):
    """20'deki bölüm 1 satırı (d: modelin dönem müşterileri + FPD kolonları + GRUP)."""
    esl = d[h].notna()
    y = d.loc[esl, h].to_numpy(dtype="float64")
    fe, fv = int(esl.sum()), float(y.sum()) if esl.any() else 0.0
    top = (d["GRUP"] <= _BD_UST).to_numpy()
    az = min(fv, fe - fv) < _BD_MIN_VAKA
    hb = d["HDF"].notna()
    hv = float(d.loc[hb, "HDF"].sum())
    sat = {"n": len(d), "fe": fe, "fep": fe / len(d) if len(d) else np.nan, "fv": fv,
           "fo": fv / fe if fe else np.nan,
           "mg": _bd_gini(d.loc[hb, "HDF"], d.loc[hb, "SKOR"]),
           "my": float(d.loc[hb & top, "HDF"].sum()) / hv if hv > 0 else np.nan,
           "fg": np.nan, "fy": np.nan, "fo20": np.nan, "lift": np.nan}
    if not az:
        e_top = top[esl.to_numpy()]
        sat["fg"] = _bd_gini(y, d.loc[esl, "SKOR"])
        sat["fy"] = float(y[e_top].sum()) / fv
        sat["fo20"] = float(y[e_top].mean()) if e_top.any() else np.nan
        sat["lift"] = sat["fo20"] / sat["fo"] if sat["fo"] else np.nan
    g = d.loc[esl, "GRUP"].to_numpy()
    for i in range(1, _BD_N_GRUP + 1):
        m = g == i
        sat[f"b{i}"] = float(y[m].mean()) if m.any() else np.nan
    return sat


def _bd_fpd_bolum2(dm, ycol):
    """20'deki bölüm 2 satırı (dm: ortak kitle; ycol: hedef kolonu)."""
    dm = dm[dm[ycol].notna()]
    y = dm[ycol].to_numpy(dtype="float64")
    n, v = len(y), float(y.sum())
    sat = {"n": n, "v": v, "o": v / n if n else np.nan}
    if n == 0:
        return sat
    s_m, s_f = dm["SKOR"].to_numpy(dtype="float64"), dm["FSKOR"].to_numpy(dtype="float64")
    az = min(v, n - v) < _BD_MIN_VAKA
    mr, fr = _bd_ata(s_m, _BD_N_GRUP) <= _BD_UST, _bd_ata(s_f, _BD_N_GRUP) <= _BD_UST
    if not az:
        sat.update(gm=_bd_gini(y, s_m), gf=_bd_gini(y, s_f))
        sat["gfark"] = sat["gm"] - sat["gf"]
        sat["ym"], sat["yf"] = float(y[mr].sum()) / v, float(y[fr].sum()) / v
    sm, sf, ir, it = mr & ~fr, fr & ~mr, mr & fr, ~mr & ~fr
    o = (lambda m: float(y[m].mean()) if m.any() else np.nan)
    sat.update(sm_n=int(sm.sum()), sm_o=o(sm), sf_n=int(sf.sum()), sf_o=o(sf), ir_n=int(ir.sum()), ir_o=o(ir),
               it_o=o(it), ort=float(ir.sum()) / float(fr.sum()) if fr.any() else np.nan,
               net=float(y[sm].sum() - y[sf].sum()))
    fark = sat["sm_o"] - sat["sf_o"]
    sat["sonuc"] = ("Vaka yok" if v == 0 else "Fark yok" if not np.isfinite(fark) or abs(fark) < _BD_BERABER_PUAN
                    else "Model daha isabetli" if fark > 0 else "FPD skoru daha isabetli")
    sat["az"] = az
    return sat


def _bd_hukum(sat):
    if sat.get("az", True) or not np.isfinite(sat.get("gfark", np.nan)):
        return "YETERSİZ VAKA"
    return ("MODEL GEREKLİ" if sat["gfark"] >= _BD_GEREKLI_PUAN else "SINIRDA" if sat["gfark"] > 0 else "FPD SKORU YETER")


def _bd_hukum3(sat, skorlu):
    """Bölüm 3: model FPD'yi öngörebiliyor mu (FPD hedefinde; eşik Bölüm 2'deki Gini puanı)."""
    gm = sat.get("gm", np.nan)
    if sat.get("az", True) or not np.isfinite(gm):
        return "YETERSİZ VAKA"
    if gm < _BD_GEREKLI_PUAN:
        return "ÖNGÖRMÜYOR"
    if not skorlu or not np.isfinite(sat.get("gfark", np.nan)):
        return "ÖNGÖRÜYOR"
    if sat["gfark"] >= _BD_GEREKLI_PUAN:
        return "ÖNGÖRÜYOR: FPD SKORUNDAN İYİ"
    if sat["gfark"] > -_BD_GEREKLI_PUAN:
        return "ÖNGÖRÜYOR: FPD SKORU KADAR"
    return "KISMEN: FPD SKORUNDAN ZAYIF"


def _bd_fpd_bolum3(y, s_m, s_f):
    """Bölüm 3 satırı: FPD hedefi (y), modelin skor dönemindeki skoru (s_m), FPD skoru (s_f; yoksa None).
    Aynı müşteriler; hesap Bölüm 2 ile aynı (0 ay önce = Bölüm 2'nin FPD hedefli satırı)."""
    if s_f is not None:
        sat = _bd_fpd_bolum2(pd.DataFrame({"Y": y, "SKOR": s_m, "FSKOR": s_f}), "Y")
        gm, gf = sat.get("gm", np.nan), sat.get("gf", np.nan)
        sat["guc"] = gm / gf if np.isfinite(gm) and np.isfinite(gf) and gf > 0 else np.nan
    else:
        n, v = len(y), float(np.sum(y))
        sat = {"n": n, "v": v, "o": v / n if n else np.nan, "az": n == 0 or min(v, n - v) < _BD_MIN_VAKA}
        if not sat["az"]:
            sat["gm"] = _bd_gini(y, s_m)
            sat["ym"] = float(y[_bd_ata(s_m, _BD_N_GRUP) <= _BD_UST].sum()) / v
    sat["hk3"] = _bd_hukum3(sat, s_f is not None)
    return sat


def _bd_fpd_sonuc(az, gfark):
    return ("YETERSİZ VAKA" if az or not np.isfinite(gfark) else "MODEL DAHA İYİ" if gfark >= _BD_GEREKLI_PUAN else
            "PREDCS DAHA İYİ" if gfark <= -_BD_GEREKLI_PUAN else "BENZER")


def _bd_fpd_kiyas(f, so, po, g_m, g_p):
    """Gerçekleşen FPD'de model ve PredCs (aynı müşteriler: PredCs'li kitle). f: FPD hedefi (kaydı olmayanda boş);
    so, po: model skoru ve PredCs (büyük = riskli); g_m, g_p: iki skorun bu kitledeki 20 grubu.
    İki taban: bütün müşteriler (FPD kaydı olmayan 0 sayılır; ..._t alanları) ve yalnızca FPD kaydı olanlar."""
    e = np.isfinite(f)
    f0 = np.nan_to_num(f)
    n, fe, fv = len(f), int(e.sum()), float(f0.sum())
    sat = {"fe": fe, "fep": fe / n if n else np.nan, "fv": fv, "fo": fv / fe if fe else np.nan,
           "fot": fv / n if n else np.nan}
    az_t = n == 0 or min(fv, n - fv) < _BD_MIN_VAKA           # bütün müşteriler
    if not az_t:
        sat["gmt"], sat["gpt"] = _bd_gini(f0, so), _bd_gini(f0, po)
        sat["gfarkt"] = sat["gmt"] - sat["gpt"]
        for on, g in (("m", g_m), ("p", g_p)):
            ust = g <= _BD_UST
            sat[f"y{on}"] = float(f0[ust].sum()) / fv           # yakalama iki tabanda da aynı
            sat[f"o{on}t"] = float(f0[ust].mean()) if ust.any() else np.nan
    sat["sonuct"] = _bd_fpd_sonuc(az_t, sat.get("gfarkt", np.nan))
    az = fe == 0 or min(fv, fe - fv) < _BD_MIN_VAKA           # yalnızca FPD kaydı olanlar
    if not az:
        sat["gm"], sat["gp"] = _bd_gini(f[e], so[e]), _bd_gini(f[e], po[e])
        sat["gfark"] = sat["gm"] - sat["gp"]
        for on, g in (("m", g_m), ("p", g_p)):
            ust = e & (g <= _BD_UST)
            sat[f"o{on}"] = float(f[ust].mean()) if ust.any() else np.nan
    sat["sonuc3"] = _bd_fpd_sonuc(az, sat.get("gfark", np.nan))
    return sat


def _bd_beklenen_gini(p, s):
    """Sonuç her müşteride p olasılığıyla gerçekleşirse s skorunun Gini'si (beklenen değer): müşteri p ağırlığıyla vaka,
    1 - p ağırlığıyla vaka değil sayılır. p olasılık değilse (0 ile 1 dışında) boş."""
    p, s = np.asarray(p, dtype="float64"), np.asarray(s, dtype="float64")
    ok = np.isfinite(p) & np.isfinite(s)
    p, s = p[ok], s[ok]
    if not len(p) or p.min() < 0 or p.max() > 1:
        return np.nan
    top_p, top_q = float(p.sum()), float((1.0 - p).sum())
    if top_p <= 0 or top_q <= 0:
        return np.nan
    _, yer = np.unique(s, return_inverse=True)                 # aynı skorlular yarım sayılır
    pg, qg = np.bincount(yer, weights=p), np.bincount(yer, weights=1.0 - p)
    auc = float((pg * (np.cumsum(qg) - qg + 0.5 * qg)).sum() / (top_p * top_q))
    return 2.0 * auc - 1.0


def _bd_ay_fark(once, sonra):
    return (int(sonra) // 100 * 12 + int(sonra) % 100) - (int(once) // 100 * 12 + int(once) % 100)


def _bd_fpd_s3():
    import pyarrow.fs as pafs
    import pyarrow.dataset as pads
    info = dataiku.Dataset(_BD_FPD_DATASET).get_location_info(sensitive_info=True)["info"]
    yol = info.get("path", "")
    if not yol.startswith("s3://"):
        raise RuntimeError(f"dataset S3'te değil (path: {yol or 'yok'})")
    cp = info["connectionParams"]
    s3 = pafs.S3FileSystem(access_key=cp["accessKey"], secret_key=cp["secretKey"], endpoint_override=_BD_S3_ENDPOINT,
                           scheme=_BD_S3_SCHEME, force_virtual_addressing=False)
    return pads.dataset(yol.replace("s3://", ""), filesystem=s3, format="parquet")


def _bd_fpd_oku(donemler):
    """FPD tablosu (_key, _donem, hedefler, FSKOR) ve bilgi; 20'deki okumanın bütün dönemler için olanı."""
    bilgi = {"kaynak": None, "skor_kolonu": None, "yon": None, "ham": 0, "tekil": 0, "donem_say": {}}
    ds = None
    try:
        ds = _bd_fpd_s3()
        sema = list(ds.schema.names)
        bilgi["kaynak"] = "S3 (pyarrow)"
    except Exception as e:
        _log(f"   ℹ FPD S3 hızlı okuma kullanılamadı ({type(e).__name__}); Dataiku API ile okunacak")
        sema = [c["name"] for c in dataiku.Dataset(_BD_FPD_DATASET).read_schema()]
        bilgi["kaynak"] = "Dataiku API"
    gercek = {c.upper(): c for c in sema}
    gerekli = [_BD_FPD_KEY, _BD_FPD_DONEM] + list(_BD_FPD_HEDEFLER.values())
    eksik = [c for c in gerekli if c.upper() not in gercek]
    if eksik:
        raise KeyError(f"{_BD_FPD_DATASET} içinde kolon yok: {eksik}")
    if _BD_FPD_SKOR_KOLONU and str(_BD_FPD_SKOR_KOLONU).upper() in gercek:
        bilgi["skor_kolonu"] = gercek[str(_BD_FPD_SKOR_KOLONU).upper()]
    else:
        _log(f"   ⚠ FPD skoru kolonu ({_BD_FPD_SKOR_KOLONU}) FPD tablosunda yok: Bölüm 2 yazılmayacak")
    kol = [gercek[c.upper()] for c in gerekli] + ([bilgi["skor_kolonu"]] if bilgi["skor_kolonu"] else [])
    don_kol = gercek[_BD_FPD_DONEM.upper()]
    if ds is not None:
        import pyarrow as pa
        import pyarrow.compute as pc
        tip = ds.schema.field(don_kol).type
        degerler = [str(d) for d in donemler] if pa.types.is_string(tip) else [int(d) for d in donemler]
        try:
            ham = ds.to_table(columns=kol, filter=pc.field(don_kol).isin(degerler), use_threads=True).to_pandas()
        except Exception:
            ham = ds.to_table(columns=kol, use_threads=True).to_pandas()
            ham = ham[_bd_tamsayi(ham[don_kol]).isin(list(donemler))]
    else:
        parca = []
        for i, ch in enumerate(dataiku.Dataset(_BD_FPD_DATASET).iter_dataframes(chunksize=2_000_000, columns=kol), 1):
            parca.append(ch[_bd_tamsayi(ch[don_kol]).isin(list(donemler))])
        ham = pd.concat(parca, ignore_index=True) if parca else pd.DataFrame(columns=kol)
    bilgi["ham"] = len(ham)
    f = pd.DataFrame({"_key": _bd_tamsayi(ham[gercek[_BD_FPD_KEY.upper()]]), "_donem": _bd_tamsayi(ham[don_kol])})
    for ad, c in _BD_FPD_HEDEFLER.items():
        v = pd.to_numeric(ham[gercek[c.upper()]], errors="coerce")
        f[ad] = v.where(v.isin([0, 1]))
    if bilgi["skor_kolonu"]:
        f["FSKOR_HAM"] = pd.to_numeric(ham[bilgi["skor_kolonu"]], errors="coerce")
    del ham
    f = f.dropna(subset=["_key", "_donem"])
    if bilgi["skor_kolonu"]:
        h_yon = "TKP_ST_5M90" if "TKP_ST_5M90" in _BD_FPD_HEDEFLER else list(_BD_FPD_HEDEFLER)[0]
        g = _bd_gini(f[h_yon], f["FSKOR_HAM"])
        bilgi["yon"] = (int(_BD_FPD_SKOR_YON) if _BD_FPD_SKOR_YON in (1, -1)
                        else (1 if not np.isfinite(g) or g >= 0 else -1))
        f["FSKOR"] = bilgi["yon"] * f["FSKOR_HAM"]
    agg = {ad: "max" for ad in _BD_FPD_HEDEFLER}
    if bilgi["skor_kolonu"]:
        agg["FSKOR"] = "max"
    f = f.groupby(["_key", "_donem"], as_index=False).agg(agg)
    bilgi["tekil"] = len(f)
