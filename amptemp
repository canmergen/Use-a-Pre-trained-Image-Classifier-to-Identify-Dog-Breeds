def _fu_cocuklar(yol):
    det = mf.get_path_details(yol) or {}
    return det.get("children") or []


def _fu_dosyalar(klasor):
    ad = [c["name"] for c in _fu_cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition() if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


def _fu_klasorler():
    kl = sorted(c["name"] for c in _fu_cocuklar("/") if c.get("directory"))
    if not kl:
        kl = sorted({p.strip("/").split("/")[0] for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    out = []
    for ad in kl:
        m = _FU_KLASOR_RE.match(ad)
        if m and ad.upper() not in {h.upper() for h in HARIC_KLASORLER}:
            out.append({"klasor": ad, "vade": int(m.group(1)), "aile": m.group(2), "oot": int(m.group(3))})
    return out


_FU_PAKET = {}


def fu_paket(klasor, kod):
    """Model paketi (model.pkl); hücre içinde bir kez okunur."""
    if (klasor, kod) not in _FU_PAKET:
        ad = next(a for k, a, _ in _FU_RENKLER if k == kod)
        with mf.get_download_stream(f"/{klasor}/renk_{kod}_{ad}_model.pkl") as s:
            ham = s.read()
        with warnings.catch_warnings():
            warnings.filterwarnings("ignore", message=r"Trying to unpickle estimator")
            paket = pickle.loads(ham)
        gerekli = {"model", "features", "required_raw_features", "engineered_features", "preprocess_schema"}
        if not isinstance(paket, dict) or not gerekli <= set(paket):
            raise ValueError("skorlama paketi değil")
        _FU_PAKET[(klasor, kod)] = paket
    return _FU_PAKET[(klasor, kod)]


def _fu_csv(klasor, dosya, usecols=None):
    """round_trip: CSV'deki sayı birebir aynı float olarak okunur. pandas'ın varsayılan okuyucusu son basamakta
    (1e-16 mertebesinde) yuvarlama yapabiliyor; skoru tam eşitlikle karşılaştırmak için bu gerekli."""
    with mf.get_download_stream(f"/{klasor}/{dosya}") as s:
        return pd.read_csv(s, usecols=usecols, float_precision="round_trip")


