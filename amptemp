def _kt_ozet(d):
    tr = (d["GT"] >= 1) & (d["GT"] <= _KT_UST)               # Takip modeli riskli diyor
    kr = (d["GK"] >= 1) & (d["GK"] <= _KT_UST)               # Takip + Kırmızı modeli riskli diyor
    bil, y = d["BATIK"].notna(), d["BATIK"].fillna(0)
    kbil, ky = d["TKH"].notna(), d["TKH"].fillna(0)
    vaka, kvaka = float(y[bil].sum()), float(ky[kbil].sum())

    def oran(m):
        k = m & bil
        return float(y[k].mean()) if k.any() else np.nan

    def yak(m):
        return float(y[m & bil].sum()) / vaka if vaka > 0 else np.nan

    def kyak(m):
        return float(ky[m & kbil].sum()) / kvaka if kvaka > 0 else np.nan

    st, sk, ir, it = tr & ~kr, kr & ~tr, tr & kr, ~tr & ~kr
    o_st, o_sk = oran(st), oran(sk)
    fark = o_st - o_sk
    if vaka == 0:
        sonuc = "Vaka yok"
    elif not np.isfinite(fark) or abs(fark) < KT_BERABER_PUAN:
        sonuc = "Fark yok"
    else:
        sonuc = f"{KT_TAKIP_AD} daha isabetli" if fark > 0 else f"{KT_TK_AD} daha isabetli"
    return {"n": len(d), "iki": int(((d["GT"] > 0) & (d["GK"] > 0)).sum()),
            "yt": int(((d["GT"] > 0) & (d["GK"] == 0)).sum()), "yk": int(((d["GT"] == 0) & (d["GK"] > 0)).sum()),
            "vaka": vaka, "oran": float(y[bil].mean()) if bil.any() else np.nan,
            "yak_t": yak(tr), "yak_k": yak(kr), "yak_u": yak(tr | kr),
            "st_n": int(st.sum()), "st_v": float(y[st & bil].sum()), "st_o": o_st,
            "sk_n": int(sk.sum()), "sk_v": float(y[sk & bil].sum()), "sk_o": o_sk,
            "ir_n": int(ir.sum()), "ir_o": oran(ir), "it_n": int(it.sum()), "it_o": oran(it),
            "ort": float(ir.sum()) / float(tr.sum()) if tr.any() else np.nan,
            "gy_t": kyak(tr), "gy_k": kyak(kr),
            "net": float(y[st & bil].sum() - y[sk & bil].sum()), "sonuc": sonuc}


_KT_D_T, _KT_D_K = f"{KT_TAKIP_AD} grubu", f"{KT_TK_AD} grubu"   # detay tablo kolon adları


def _kt_detay(J, v):
    g = (J.assign(_b=J["BATIK"].notna(), _k=J["TKH"].notna())
          .groupby(["RENK", "GT", "GK"], sort=True)
          .agg(kisi=("MBB_NO", "size"), b_bil=("_b", "sum"), b_vaka=("BATIK", "sum"),
               k_bil=("_k", "sum"), k_vaka=("TKH", "sum")).reset_index())
    lab = (lambda x: f"B{int(x)}" if x > 0 else "Yok")
    return pd.DataFrame({
        "Vade": v, "Renk Segmenti": g["RENK"].map(_seg_etiket), _KT_D_T: g["GT"].map(lab), _KT_D_K: g["GK"].map(lab),
        "Kişi": g["kisi"].astype(int), "Batığı bilinen": g["b_bil"].astype(int),
        "Batık vaka": g["b_vaka"].fillna(0).astype(int),
        "Batık oranı": np.where(g["b_bil"] > 0, g["b_vaka"] / g["b_bil"].where(g["b_bil"] > 0), np.nan),
        "Takip veya kırmızı bilinen": g["k_bil"].astype(int), "Takip veya kırmızı vaka": g["k_vaka"].fillna(0).astype(int),
        "Takip veya kırmızı oranı": np.where(g["k_bil"] > 0, g["k_vaka"] / g["k_bil"].where(g["k_bil"] > 0), np.nan)})


