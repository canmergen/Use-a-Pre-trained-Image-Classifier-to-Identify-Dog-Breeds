   yazılmak zorunda. */
const DOKUMAN_DOSYA_ADI = "model_gelistirme_dokumani.docx";

const DOK = {
    govde: null,        // son /dokuman yanıtı
    yukleniyor: false,
    hata: "",
    duzenlenen: null,   // düzenleme kutusu açık olan bölümün anahtarı
    taslak: "",         // textarea'daki yarım metin
