# 2) HESAP: her renkte referans önce; FE her renk x dönem x ham kolon setinde bir kez
# ==================================================================
if "_ST_ONBELLEK" not in globals():
    _ST_ONBELLEK = {}
_st_anahtar0 = (id(_ST_VERI), len(_ST_VERI))
for _k in [k for k in _ST_ONBELLEK if k[0] != _st_anahtar0]:
    del _ST_ONBELLEK[_k]                                     # ham veri yeniden çekildiyse eski hesaplar silinir
_st_donem_var = set(pd.to_numeric(_ST_VERI["DONEM"], errors="coerce").dropna().astype(int).unique())
_st_yok = [d for d in _ST_DON if d not in _st_donem_var]
if _ST_REF in _st_yok:
    raise RuntimeError(f"Referans dönem {_ST_REF} ham veride yok.")
_log(f"Stabilite: referans {_ST_REF} | karşılaştırılan {', '.join(map(str, _ST_KARS))} | {len(TUM_MODELLER)} model"
     + (f" | ⚠ veride olmayan dönem: {_st_yok}" if _st_yok else ""))
_ST_SONUC, _st_atlanan, _st_ref_farkli = [], [], set()
for _kod, _ad, _ in RENKLER:
    _pk = {}
    for kod, v, a in TUM_MODELLER:
        if kod != _kod or kod not in MODELLER[(v, a)]["renkler"]:
            continue
        paket, hata = _st_paket(MODELLER[(v, a)]["klasor"], _kod, _ad)
        if paket is None:
            _st_atlanan.append(f"{MODELLER[(v, a)]['klasor']} renk {_kod}: {hata}")
            continue
        if int(paket.get("train_donem") or _ST_REF) != _ST_REF:
            _st_ref_farkli.add(int(paket.get("train_donem")))
        _pk[(v, a)] = {"paket": paket, "klasor": MODELLER[(v, a)]["klasor"], "ham": tuple(paket["required_raw_features"]),
                       "ist": {}, "kitle": {}}
    if not _pk:
        continue
    for d in [x for x in _ST_DON if x in _st_donem_var]:
        lazim = []
        for x, m in _pk.items():
            anahtar = (_st_anahtar0, m["klasor"], _kod, _ST_REF, d, tuple(m["paket"]["features"]))
            if anahtar in _ST_ONBELLEK:
                m["ist"][d], m["kitle"][d] = _ST_ONBELLEK[anahtar]
            elif d == _ST_REF or _ST_REF in m["ist"]:
                lazim.append(x)
        if not lazim:
            continue
        hamlar = {}
        for x in lazim:
            hamlar.setdefault(_pk[x]["ham"], []).append(x)
        rows = _st_satirlar(_kod, d, [c for h in hamlar for c in h])
        n_kitle = len(rows)
        for ham, xs in hamlar.items():
            eksik = [c for c in ham if c not in rows.columns]
            if eksik:
                _st_atlanan.extend(f"{_pk[x]['klasor']} renk {_kod} {d}: ham veride eksik kolon {eksik[:5]}" for x in xs)
                continue
            X = rows.loc[:, list(ham)]
            with warnings.catch_warnings():
                warnings.simplefilter("ignore")
                eng, _ = feature_engineering(X)
            for x in xs:
                m = _pk[x]
                try:
                    F, skor, turler = _st_girdi(X, eng, m["paket"])
                except Exception as e:
                    _st_atlanan.append(f"{m['klasor']} renk {_kod} {d}: skorlanamadı ({type(e).__name__}: {e})")
                    continue
                m["ist"][d] = _st_ozellik(F, skor, turler, None if d == _ST_REF else m["ist"][_ST_REF])
                m["kitle"][d] = len(X)
                _ST_ONBELLEK[(_st_anahtar0, m["klasor"], _kod, _ST_REF, d, tuple(m["paket"]["features"]))] = (
                    m["ist"][d], len(X))
                del F, skor
            del eng, X
        del rows
        _log(f"   renk {_kod} {d}: {len(lazim)} model ({_adet(n_kitle)} müşteri)")
    for (v, a), m in _pk.items():
        if _ST_REF in m["ist"]:
            _ST_SONUC.append({"kod": _kod, "vade": v, "aile": a, "klasor": m["klasor"], "ist": m["ist"], "kitle": m["kitle"]})
    del _pk
for _m in _st_atlanan:
    _log(f"   ⚠ {_m}")
if _st_ref_farkli:
    _log(f"   ⚠ Bazı modellerin eğitim dönemi {sorted(_st_ref_farkli)}; hepsi referans {_ST_REF} ile karşılaştırıldı")
if not _ST_SONUC:
    raise RuntimeError("Hiçbir model için stabilite hesaplanamadı (yukarıdaki uyarılara bakın).")


# ==================================================================
# 3) TABLOLAR: dönem özeti, bozulan değişkenler (renk x değişken), model PSI / HHI, skor grupları
# ==================================================================
def _st_ad(s):
    return f"{s['vade']}M {_MODEL_ADI[s['aile']]}"


_ST_DEG = {}                                                  # (renk, değişken) → aynı renkteki modeller arasında en yüksek CSI
for s in _ST_SONUC:
    r = s["ist"][_ST_REF]
    for c, f in r["feat"].items():
        g = _ST_DEG.setdefault((s["kod"], c), {"seg": _seg_etiket(s["kod"]), "feat": c, "tur": f["tur"], "modeller": [],
                                                "bos_R": f["bos"], "ort_R": f["ort"],
                                                "hhi_R": float(np.sum(np.asarray(f["pay"]) ** 2))})
        g["modeller"].append(_st_ad(s))
        for d in _ST_KARS:
            fd = s["ist"].get(d, {}).get("feat", {}).get(c)
            if fd is None:
                continue
            if not np.isfinite(g.get(f"csi_{d}", np.nan)) or fd["csi"] > g[f"csi_{d}"]:
                g[f"csi_{d}"], g[f"bos_{d}"], g[f"ort_{d}"] = fd["csi"], fd["bos"], fd["ort"]
                g[f"hhi_{d}"] = float(np.sum(np.asarray(fd["pay"]) ** 2))   # değişkenin dilimlerindeki yığılma
_ST_T_DEG = []
for g in _ST_DEG.values():
    csiler = [g[f"csi_{d}"] for d in _ST_KARS if np.isfinite(g.get(f"csi_{d}", np.nan))]
    g["csi_max"] = max(csiler) if csiler else np.nan
    g["durum"] = _st_durum(g["csi_max"]) if csiler else None
    g["n_model"] = len(g["modeller"])
    g["model_listesi"] = ", ".join(g["modeller"])
    _ST_T_DEG.append(g)
_ST_T_DEG.sort(key=lambda g: (-(g["csi_max"] if np.isfinite(g["csi_max"]) else -1), g["seg"]))

_ST_T_MOD, _ST_T_GRUP = [], []
for s in sorted(_ST_SONUC, key=lambda s: (s["kod"], s["vade"], s["aile"])):
    ortak = {"seg": _seg_etiket(s["kod"]), "model": _MODEL_ADI[s["aile"]], "vade": s["vade"]}
    t = {**ortak, "n_R": s["kitle"].get(_ST_REF), "hhi_R": s["ist"][_ST_REF]["hhi"]}
    en_kotu = []
    for d in _ST_KARS:
        di = s["ist"].get(d)
        t[f"n_{d}"] = s["kitle"].get(d)
        if not di:
            continue
        csi = {c: f["csi"] for c, f in di["feat"].items() if np.isfinite(f["csi"])}
        t[f"psi_{d}"], t[f"hhi_{d}"] = di["psi"], di["hhi"]
