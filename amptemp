# ------------------------------------------------------------------
# Her model klasöründen renk_<kod>_<ad>_bucket20_train_val_oot.xlsx okunur,
# yalnızca kume = OOT satırları ve BUCKET_KOLONLARI alınır (değer hesaplanmaz).
# Her renk ayrı sheet. Vadeler yan yana (3M | boş kolon | 6M | boş kolon | 12M),
# her vadede modeller BLOK_SIRASI'na göre alt alta; bloklar arasında bir boş satır.
# Blok başlığı: "<X>M_<hedef> - Train: <train dönemi> OOT: <OOT dönemi>"
# (dönemler modelin model.pkl dosyasındaki train_donem / oot_donem'den).
# ==================================================================
def _donem_metni(x):
    if x is None:
        return "?"
    if isinstance(x, (list, tuple, set, np.ndarray, pd.Index)):
        return ", ".join(sorted({_donem_metni(i) for i in x}))
    try:
        return str(int(float(x)))
    except (TypeError, ValueError):
        return str(x)


def _donemler(klasor, dosyalar, oot_klasor):
    """Klasördeki ilk model.pkl'den (train dönemi, OOT dönemi) metni."""
    for ad in dosyalar:
        if not re.match(r"^renk_\d+_.+_model\.pkl$", ad):
            continue
        try:
            with mf.get_download_stream(f"/{klasor}/{ad}") as s:
                ham = s.read()
            # sklearn sürümü farklıysa çıkan "Trying to unpickle estimator" uyarısı (yalnızca o) kapatılır
            with warnings.catch_warnings():
                warnings.filterwarnings("ignore", message=r"Trying to unpickle estimator")
                paket = pickle.loads(ham)
            return (_donem_metni(paket.get("train_donem")),
                    _donem_metni(paket.get("oot_donem", oot_klasor)))
        except Exception as e:
            _log(f"   ⚠ {klasor}/{ad} okunamadı ({type(e).__name__}); başlıkta Train dönemi '?' yazılacak")
            break
    return "?", str(oot_klasor)


def _kolon_bul(kolmap, ad):
    """Büyük / küçük harf duyarsız kolon eşleme; '<X>_ADET' yoksa eki olmayan '<X>' de denenir."""
    u = ad.upper()
    if u in kolmap:
        return kolmap[u]
    if u.endswith("_ADET") and u[:-5] in kolmap:
        return kolmap[u[:-5]]
    return None


def _sayiya(s):
    """Metin olarak yazılmış sayıları ('0.6133') sayıya çevirir; çevrilemeyen varsa dokunmaz."""
    v = pd.to_numeric(s, errors="coerce")
    return v if int(v.notna().sum()) == int(pd.Series(s).notna().sum()) else s


def _bucket_blogu(klasor, dosyalar, kod, ad):
    """Bir model klasörünün bir rengi için OOT bucket satırları (BUCKET_KOLONLARI sırasıyla).
    Dönen: (tablo | None, eksik kolonlar)"""
    dosya = f"renk_{kod}_{ad}_bucket20_train_val_oot.xlsx"
    with mf.get_download_stream(f"/{klasor}/{dosya}") as s:
        sayfalar = pd.read_excel(BytesIO(s.read()), sheet_name=None)
    tablo, kolmap = None, None
    for sh_ad, sh in sayfalar.items():                     # DETAY sheet'i değil, ana tablo
        km = {str(c).strip().upper(): c for c in sh.columns}
        if str(sh_ad).upper().endswith("_DETAY") or not {"KUME", "BUCKET"} <= set(km):
            continue
        tablo, kolmap = sh, km
        break
    if tablo is None:
        return None, ["kume / bucket kolonları"]
    tablo = tablo[tablo[kolmap["KUME"]].astype(str).str.strip().str.upper() == "OOT"]
    tablo = (tablo.assign(_b=pd.to_numeric(tablo[kolmap["BUCKET"]], errors="coerce"))
                  .sort_values("_b", kind="stable"))
    cikti, eksik = pd.DataFrame(index=range(len(tablo))), []
    for k in BUCKET_KOLONLARI:
        c = _kolon_bul(kolmap, k)
        if c is None:
            cikti[k] = np.nan
            eksik.append(k)
        else:
            v = tablo[c].reset_index(drop=True)
            cikti[k] = v if k.lower() in ("renk", "kume") else _sayiya(v)

    g_eksik = [k for k in eksik if k in GINI_KOLONLARI]
    oz = f"renk_{kod}_{ad}_ozet.csv"
    if g_eksik and oz in dosyalar and len(cikti):
        with mf.get_download_stream(f"/{klasor}/{oz}") as s:
            o = pd.read_csv(s)
        okol = {str(c).strip().upper(): c for c in o.columns}
        for k in g_eksik:
            if k.upper() in okol and len(o):
                cikti[k] = pd.to_numeric(o[okol[k.upper()]], errors="coerce").iloc[0]
                eksik.remove(k)
    return cikti, eksik


_K = len(BUCKET_KOLONLARI)
_INCE = Side(style="thin", color="BFBFBF")
_KENAR = Border(left=_INCE, right=_INCE, top=_INCE, bottom=_INCE)
_BASLIK_DOLGU = PatternFill("solid", fgColor="C00000")
_KOLON_DOLGU = PatternFill("solid", fgColor="F2F2F2")
_SKALA = dict(start_type="min", start_color="F8696B",
              mid_type="percentile", mid_value=50, mid_color="FFEB84",
              end_type="max", end_color="63BE7B")


def _bicim(ad):
    u = ad.upper()
    if u in ("RENK", "KUME"):
        return None
    if u in ("BAD_RATE", "CAPTURE") or "_ORAN" in u:      # ..._ORAN ve FPD_1_ORAN_...
        return "0.00%"
    if u in ("BUCKET", "N", "BAD", "LIMIT_SUM", "RISK_SUM", "LIMIT_SUM_BAD", "RISK_SUM_BAD") or "_ADET" in u:
        return "0"
    return "0.0000"


def _genislik(ad):
    """Kolon genişliği: başlık sığsın; limit / risk toplamları (10-11 hane) ### görünmesin."""
    w = round(len(ad) * 1.15) + 2
    if ad.upper() in ("LIMIT_SUM", "RISK_SUM", "LIMIT_SUM_BAD", "RISK_SUM_BAD"):
        w = max(w, 14)
    return max(9, min(40, w))


def _hucre(v):
    """Excel'e yazılacak değer: NaN → boş, numpy tipleri → Python tipleri."""
    try:
        if pd.isna(v):
            return None
    except (TypeError, ValueError):
        pass
    if isinstance(v, np.integer):
        return int(v)
    if isinstance(v, np.floating):
        return float(v)
    return v


def _blok_yaz(ws, r0, c0, baslik, tablo):
    """r0: başlık satırı, c0: bloğun ilk kolonu. Başlık + kolon adları + bucket satırları."""
    ws.merge_cells(start_row=r0, start_column=c0, end_row=r0, end_column=c0 + _K - 1)
    h = ws.cell(row=r0, column=c0, value=baslik)
    h.fill = _BASLIK_DOLGU
    h.font = Font(bold=True, color="FFFFFF")
    h.alignment = Alignment(horizontal="center", vertical="center")
    for j, ad in enumerate(BUCKET_KOLONLARI):
        c = ws.cell(row=r0 + 1, column=c0 + j, value=ad)
        c.fill, c.font, c.border = _KOLON_DOLGU, Font(bold=True), _KENAR
        c.alignment = Alignment(horizontal="center")
        _fmt = _bicim(ad)
        for i, v in enumerate(tablo[ad].tolist()):
            hc = ws.cell(row=r0 + 2 + i, column=c0 + j, value=_hucre(v))
            hc.border = _KENAR
            if _fmt:
                hc.number_format = _fmt
    if len(tablo):
        for ad in RENK_SKALASI_KOLONLARI:
            if ad in BUCKET_KOLONLARI:
                L = get_column_letter(c0 + BUCKET_KOLONLARI.index(ad))
                ws.conditional_formatting.add(f"{L}{r0 + 2}:{L}{r0 + 1 + len(tablo)}",
                                              ColorScaleRule(**_SKALA))


_oot_say = pd.Series([m["oot"] for m in MODEL_KLASORLERI]).value_counts()
_oot_sec = (int(str(BUCKET_OOT).upper().replace("OOT", "")) if BUCKET_OOT
            else max(_oot_say.index, key=lambda o: (_oot_say[o], o)))
_bkl = [m for m in MODEL_KLASORLERI if m["oot"] == _oot_sec]
_disarida = [m["klasor"] for m in MODEL_KLASORLERI if m["oot"] != _oot_sec]
_log(f"=== {BUCKET_DOSYA.lstrip('/')}: OOT{_oot_sec} | {len(_bkl)} model klasörü ===")
if _disarida:
    _log(f"ⓘ OOT{_oot_sec} olmayan klasörler bu Excel'e alınmadı: {_disarida}")

_bloklar, _renk_adlari, _eksik_say = {}, {}, {}      # renk kodu → {(vade, aile): (başlık, tablo)}
for m_kl in _bkl:
    klasor = m_kl["klasor"]
    dosyalar = _dosyalar(klasor)
    _tr, _oot = _donemler(klasor, dosyalar, m_kl["oot"])
    _baslik = f"{m_kl['vade']}M_{HEDEF_AILELERI[m_kl['aile']][2]} - Train: {_tr} OOT: {_oot}"
    _renkler = sorted({(int(r.group(1)), r.group(2)) for ad in dosyalar if (r := BUCKET_DOSYA_RE.match(ad))})
    if not _renkler:
        _log(f"   ⚠ {klasor}: bucket20 dosyası yok, atlandı")
        continue
    for kod, ad in _renkler:
        try:
            tablo, eksik = _bucket_blogu(klasor, dosyalar, kod, ad)
        except Exception as e:
            _log(f"   ⚠ {klasor}/renk_{kod}_{ad}: okunamadı ({type(e).__name__}: {str(e)[:120]}), atlandı")
            continue
        if tablo is None or tablo.empty:
            _log(f"   ⚠ {klasor}/renk_{kod}_{ad}: OOT bucket satırı yok, atlandı")
            continue
        for k in eksik:
            _eksik_say[k] = _eksik_say.get(k, 0) + 1
        _bloklar.setdefault(kod, {})[(m_kl["vade"], m_kl["aile"])] = (_baslik, tablo)
        _renk_adlari[kod] = ad
    _log(f"   {klasor}: {_baslik} | {len(_renkler)} renk")
if _eksik_say:
    _log(f"⚠ Bucket dosyalarında bulunamayan kolonlar (boş yazıldı): "
         + ", ".join(f"{k} ({n} tabloda)" for k, n in _eksik_say.items()))

if not _bloklar:
    _log(f"⚠ Hiç bucket20 tablosu okunamadı; {BUCKET_DOSYA} yazılmadı")
else:
    _vadeler = sorted({v for bl in _bloklar.values() for v, _ in bl})
    _aile_sira = [a for a in BLOK_SIRASI if any(a == x for bl in _bloklar.values() for _, x in bl)]
    _aile_sira += [a for a in HEDEF_AILELERI if a not in _aile_sira
                   and any(a == x for bl in _bloklar.values() for _, x in bl)]

    wb = Workbook()
    wb.remove(wb.active)
    for kod in sorted(_bloklar):
        bl = _bloklar[kod]
        ws = wb.create_sheet(str(BUCKET_SHEET_ADLARI.get(kod, f"{kod}-{_renk_adlari[kod]}"))[:31])

        # Her bloğun dikey yeri (slot)
        if HEDEFE_GORE_HIZALA:
            yer = {k: _aile_sira.index(k[1]) for k in bl}
        else:
            yer = {}
            for v in _vadeler:
                for i, a in enumerate([a for a in _aile_sira if (v, a) in bl]):
                    yer[(v, a)] = i
        n_slot = max(yer.values()) + 1
        yukseklik = [0] * n_slot
        dolu = [False] * n_slot
        for k, (_, t) in bl.items():
            yukseklik[yer[k]] = max(yukseklik[yer[k]], len(t))
            dolu[yer[k]] = True
        satir, bas = 1, {}
        for i in range(n_slot):
            if dolu[i]:
                bas[i] = satir
                satir += 2 + yukseklik[i] + 1               # başlık + kolon adları + satırlar + boş satır

        for vi, v in enumerate(_vadeler):
            c0 = 1 + vi * (_K + 1)                          # vadeler arasında bir boş kolon
            for k, (baslik, t) in bl.items():
                if k[0] == v:
                    _blok_yaz(ws, bas[yer[k]], c0, baslik, t)
            for j, ad in enumerate(BUCKET_KOLONLARI):
                ws.column_dimensions[get_column_letter(c0 + j)].width = (
                    12 if ad.lower() == "renk" else _genislik(ad))
            if vi < len(_vadeler) - 1:
                ws.column_dimensions[get_column_letter(c0 + _K)].width = 3

    buf2 = BytesIO()
    wb.save(buf2)
    buf2.seek(0)
    mf.upload_stream(BUCKET_DOSYA, buf2)
    _log(f"✓ {MAIN_FOLDER}{BUCKET_DOSYA} yazıldı | {len(_bloklar)} renk sheet'i | vadeler: "
         + ", ".join(f"{v}M" for v in _vadeler) + " | blok sırası: "
         + ", ".join(HEDEF_AILELERI[a][2] for a in _aile_sira))
