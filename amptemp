# ==============================================================
# RENK BAZLI - TRAIN / VAL / OOT BUCKET RAPORU (EXCEL) + FPD
# Skorlar pipeline'dan gelir: once bellekteki secilen_modeller,
# yoksa pipeline'in kaydettigi skor dosyalari. Model YENIDEN EGITILMEZ.
# 20'lik raporda ilk 4 bucket alt dilimlere bolunur (DETAY sheet'i).
# FPD hedefleri musteri (MBB) + donem bazinda eslenip her bucket'a eklenir.
# RAPOR_BAYRAKLARI (takip, sonraki gecikme) her bucket'ta adet / oran olarak raporlanir;
# LEAK_COLS'ta olmalari sorun degil, modele girmezler, yalnizca raporda kullanilirlar.
# ==============================================================
import time
from io import BytesIO
import numpy as np
import pandas as pd
import dataiku

MODEL_RENKLER = [1, 2, 3, 4, 5, 6]

LIMIT_COL = 'KK_LIMIT'                 # limit kolonu (ham veride)
RISK_COL = 'KK_RISK'                   # risk kolonu
# Bucket bazinda adet / orani raporlanacak bayraklar (df'teki kolonlar).
# Deger > 0 olay sayilir (0/1 bayrakta adet = toplam); bos deger paydaya girmez.
RAPOR_BAYRAKLARI = [
    'AKB_TAKIP_YY_12M_FLG',
    'AKB_GECIKME_SONRAKI_3M',
    'AKB_GECIKME_SONRAKI_6M',
    'AKB_GECIKME_SONRAKI_12M',
]

# Bucket basina EN AZ bu kadar batan olsun; altina duserse bucket sayisi
# otomatik iner. 0 = KAPALI, her renk hep istenen bucket sayisini kullanir.
MIN_BAD_PER_BUCKET = 0
MIN_BUCKET = 5                         # adaptif acikken bundan asagi inmiyoruz

CAPTURE_PCT = 0.10
BUCKET_DEGERLERI = [20, 100]           # tek run'da hem 20'lik hem 100'luk cikti

# DETAY: DETAY_NB'lik raporda {ana bucket: alt dilim sayisi}.
# 20'likte bucket 1 (%5) -> 10 x %0.5, bucket 2-3-4 (%5) -> 5 x %1.
DETAY_NB = 20
DETAY_BOLME = {1: 10, 2: 5, 3: 5, 4: 5}

# FPD: baska projedeki dataset, "PROJE_KEY.DATASET_ADI"
FPD_AKTIF = True
FPD_YENIDEN_OKU = False                # True: bellekteki FPD tablosu yerine yeniden okur
FPD_DATASET = "BKATBALTERNATIFVERISKORKARTIPROJECT.FPD_CS_MODEL_INPUTS_2025_2026"
FPD_KEY_COL = "MBB"                    # musteri no (df'deki MBB_NO ile eslesir)
FPD_DONEM_COL = "PERIOD"               # YYYYMM
FPD_HEDEFLER = {                       # kisa ad -> kolon adi
    "TKP_5M90": "TGT_CS_ALL_TKP_5M90",
    "TKP_ST_5M90": "TGT_CS_ALL_TKP_ST_5M90",
}
VERI_KEY_COL = 'MBB_NO'                # df'deki musteri no
S3_ENDPOINT = "loscdlhp.aknet.akb:9000"
S3_SCHEME = "https"
CHUNK = 2_000_000                      # yedek yol (iter_dataframes) icin parca boyu

FPD_OKUNACAK = [FPD_KEY_COL, FPD_DONEM_COL] + list(FPD_HEDEFLER.values())
_SKOR_ONBELLEK = {}


def _log(mesaj):
    print(f'[{time.strftime("%H:%M:%S")}] {mesaj}', flush=True)


