def _fu_sayfa(wb, ad, kolonlar, satirlar, tablo, ilk=False):
    ws = wb.active if ilk else wb.create_sheet(ad)
    ws.title = ad
    ws.sheet_view.showGridLines = False
    ince = Side(style="thin", color="BFBFBF")
    for j, (k, b, f, g) in enumerate(kolonlar, 1):
        x = ws.cell(1, j, b)
        x.font = Font(name=_FU_YAZI, bold=True, color=_FU_BASLIK, size=10)
        x.fill = PatternFill("solid", fgColor=_FU_KIRMIZI)
        x.alignment = Alignment(wrap_text=True, horizontal="center", vertical="center")
        ws.column_dimensions[get_column_letter(j)].width = g
    ws.row_dimensions[1].height = 46
    for i, s in enumerate(satirlar, 2):
        for j, (k, b, f, g) in enumerate(kolonlar, 1):
            v = s.get(k)
            if isinstance(v, (float, np.floating)) and not np.isfinite(v):
                v = None
            x = ws.cell(i, j, v.item() if hasattr(v, "item") else v)
            x.font = Font(name=_FU_YAZI, size=10)
            x.border = Border(bottom=ince)
            if f:
                x.number_format = f
            if k == "durum":
                x.fill = PatternFill("solid", fgColor="C6EFCE" if v == "Birebir aynı" else "F4B6B7")
    if satirlar:
        ref = f"A1:{get_column_letter(len(kolonlar))}{len(satirlar) + 1}"
        t = Table(displayName=tablo, ref=ref)
        t.tableStyleInfo = TableStyleInfo(name="TableStyleLight1", showRowStripes=False)
        ws.add_table(t)
    return ws


