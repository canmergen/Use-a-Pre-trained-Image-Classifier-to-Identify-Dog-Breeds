        return
    medya = {}
    if isinstance(globals().get("_veri"), (bytes, bytearray)):
        with zipfile.ZipFile(BytesIO(_veri)) as z:
            for ad in z.namelist():
                m = re.match(r"xl/media/image(\d+)\.\w+$", ad)
                if m:
                    medya[int(m.group(1))] = z.read(ad)
    for i, img in enumerate(imgs, 1):
        if getattr(img.ref, "closed", False):
            if i in medya:
                img.ref = BytesIO(medya[i])
            else:
                raise RuntimeError("Görsel verisi bulunamadı: önce 18. hücreyi yeniden çalıştırın, sonra bu hücreyi.")


