import numpy as np
import pandas as pd

# 23 EK) KK_ODEME_ORANI'nın boş / 100 kodlaması kart bakiyesine (KK_RISK) göre, takvim ayı bazında (202511 satırları).
# Bakiyesi 0 (ya da eksi) olan müşterilerde bazı aylarda ODM = 100, bazı aylarda boş çıkıyorsa kodlama aydan aya değişiyor.
_V = _OK_V if "_OK_V" in globals() else df
_DON = 202511
_d = pd.to_numeric(_V["DONEM"], errors="coerce").to_numpy()
_kk = (_V["KK_URUN_FLG"] == "KK").to_numpy() if "KK_URUN_FLG" in _V.columns else np.ones(len(_V), dtype=bool)
_pos = np.flatnonzero((_d == _DON) & _kk)
_ay0 = (_DON // 100) * 12 + _DON % 100 - 1


def _y(x):
    return f"%{100 * x:.1f}".replace(".", ",")


_sat = []
for j, a in enumerate(["LM"] + [f"L{i}M" for i in range(2, 13)]):
    o = pd.to_numeric(_V[f"KK_ODEME_ORANI_{a}"].iloc[_pos], errors="coerce").to_numpy("float64", na_value=np.nan)
    r = pd.to_numeric(_V[f"KK_RISK_{a}"].iloc[_pos], errors="coerce").to_numpy("float64", na_value=np.nan)
    ay = _ay0 - (j + 1)
    for grup, m in (("bakiye 0", r == 0), ("bakiye eksi", r < 0), ("bakiye artı", r > 0), ("bakiye boş", np.isnan(r))):
        if m.any():
            _sat.append({"Takvim ayı": f"{ay // 12}{ay % 12 + 1:02d}", "Bakiye": grup, "Müşteri payı": _y(m.mean()),
                         "ODM boş": _y(np.isnan(o[m]).mean()), "ODM = 100": _y(np.mean(o[m] == 100)),
                         "ODM diğer": _y(np.mean(np.isfinite(o[m]) & (o[m] != 100)))})
print(pd.DataFrame(_sat).sort_values(["Takvim ayı", "Bakiye"]).to_string(index=False))
