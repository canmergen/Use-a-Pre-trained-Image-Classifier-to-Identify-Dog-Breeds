def _bolme_kilidi(durum):
    """(kilitli, neden). Bolme uygulanmis VE bolmeye bagli bir adim
    calismissa form kilitlenir: degistirmek o analizleri gecersiz kilar."""
    b = durum.get("bolme") or {}
    if not b.get("kalici"):
        return False, ""
    calisan = [k for k in BOLME_BAGIMLI if durum.get(k)]
    if not calisan:
        return False, ""
    return True, ("Bölme uygulandı ve sonraki adımlar bu bölme üzerinde "
                  "çalıştı (%s). Bölmeyi değiştirmek bu analizleri geçersiz "
                  "kılar; devam etmeden önce onayınızı isterim."
                  % ", ".join(ADIMLAR.get(k, {}).get("baslik") or k
                              for k in calisan))


def bolme_formu(durum):
    """HAZIRLIK sekmesindeki bolme formu.

    Alanlarin degerleri bolme_ayarlari()'ndan geliyor; form ile fiilen
    uygulanan bolme ayni kaynaktan okunmali, yoksa kullanici ekranda
    baska, veride baska bir bolme gorur."""
    a = bolme_ayarlari(durum)
    m = durum.get("meta") or {}
    kilitli, neden = _bolme_kilidi(durum)

    birim = {"deger": a["birim"], "secenekler": ["satir", "kimlik"],
             "kilitli": not bool(m.get("id"))}
    if not m.get("id"):
        birim["not"] = "kimlik kolonu tanımlı değil"

    donemler = list(durum.get("_donemler") or [])
    oot = {"deger": {"tur": a["oot_tanim"]["tur"],
                     "deger": a["oot_tanim"]["deger"],
                     "adet": a["oot_tanim"]["adet"]},
           "donemler": donemler}
    if not m.get("donem"):
        oot["not"] = "dönem kolonu tanımlı değil"

    # 1. ASAMA: test nasil ayrilir. Donem kolonu yoksa zamansal secenek
    # kilitli gorunur — sebebini yazmadan pasif bir dugme birakmak
    # kullaniciya "bozuk" hissi veriyor.
    test_tanim = {"deger": a["test_tanim"],
                  "secenekler": ["zamansal", "rastgele"],
                  "kilitli_secenekler": [] if m.get("donem") else ["zamansal"]}
    if not m.get("donem"):
        test_tanim["not"] = ("Dönem kolonu tanımlı olmadığı için zamansal "
                             "test kurulamıyor; test oranla ayrılır.")
    else:
        test_tanim["not"] = ("Zamansal testte son N dönem test olur; bu set "
                             "aynı zamanda OOT'dur, ayrıca bir OOT seti "
                             "açılmaz.")

    # 2. ASAMA: kalan train nasil kullanilir. Dort secenek TEK alanda;
    # val_var ve cv ince ayar olarak ayrica duruyor.
    return {
        "duzenlenebilir": not kilitli,
        "alanlar": {
            "test_tanim": test_tanim,
            "oot_adet": {"deger": a["oot_adet"], "donemler": donemler,
                         "kilitli": not bool(m.get("donem"))},
            "test_oran": {"deger": a["test_oran"],
                          "kilitli": a["test_tanim"] == "zamansal"},
            "train_kullanimi": {
                "deger": a["train_kullanimi"],
                "secenekler": ["full", "val", "full_cv", "val_cv"],
                "basliklar": TRAIN_KULLANIMI_BASLIK},
            "birim": birim,
            "val_var": {"deger": a["val_var"]},
            "val_oran": {"deger": a["val_oran"],
                         "kilitli": not a["val_var"]},
            "cv": {"deger": a["cv"],
                   "secenekler": ["yok", "kfold", "zaman"]},
            "kat": {"deger": a["kat"], "kilitli": a["cv"] == "yok"},
            "katmanla": {"deger": a["katmanla"]},
            "oot_tanim": oot,
            "seed": {"deger": a["seed"]},
        },
        "ozet": bolme_ozeti(durum),
        "uyarilar": bolme_uyarilari(durum),
        "kilitli": kilitli,
        "kilit_nedeni": neden,
    }


def hazirlik_paneli(durum):
    """HAZIRLIK sekmesi: bolme formu + eksik deger ozeti + donusumler."""
    temel = eksik_paneli(durum)
    veri = dict(temel)
    veri["kartlar"] = list(temel.get("kartlar") or []) + [_donusum_karti(durum)]
    # Form profil beklemeden gorunur: bolme profilden ONCEKI adim, sekme
    # "bekliyor" durumundayken de kullanici bolmesini duzenleyebilmeli.
    veri["bolme_formu"] = bolme_formu(durum)
    return veri


# --------------------------------------------------------------------------
# SFA sekmesi
# --------------------------------------------------------------------------
def sfa_paneli(durum):
    """SFA sekmesi. Kaynak: durum["sfa"] ozeti + sfa_uygula'nin yazdigi
    IV'ye gore ilk 20 satir; tam tablo dataset'te kalir."""
    s = durum.get("sfa") or {}
    if s.get("analiz_edilen") is None:
        return _bekleyen_panel(SFA_ADIMI)

    olculen = _tam(s.get("analiz_edilen"), 0)
    gecen = _tam(s.get("pass_adet"), 0)
    atlanan = len(s.get("atlanan") or [])
    sizinti = len(s.get("sizinti") or [])
    pass_oran = _oran(gecen, olculen)

    ozet_kart = _kart("Tek değişken analizi", [
        ("Ölçülen değişken", _sayi(olculen), SFA_ADIMI),
        ("PASS", "%s  (%s)" % (_sayi(gecen),
                               _yuzde(pass_oran, 1)
                               if pass_oran is not None else "—"), SFA_ADIMI),
        ("Atlanan (ölçülemedi)", _sayi(atlanan), SFA_ADIMI),
        ("Sızıntı şüpheli", _sayi(sizinti), SFA_ADIMI),
        ("Tam tablo", s.get("tablo_dataset") or "proje hafızası", None),
    ])

    esik_kart = _kart("Eşikler", [
        ("IV", "> %s" % _ond(sfa_mod.IV_ESIK, 2), None),
        ("C-value", "> %s" % _ond(sfa_mod.C_ESIK, 2), None),
        ("Sızıntı şüphesi", "C-value > %s" % _ond(sfa_mod.SIZINTI_ESIK, 2), None),
        ("Kategorik seviye sınırı", _sayi(sfa_mod.KATEGORIK_MAX), None),
    ])

    satirlar = [[r.get("FEATURE"),
                 _ond(r.get("IV"), 3),
                 _ond(r.get("C_VALUE"), 3),
                 r.get("SFA_RESULT") or "",
                 r.get("NOT") or ""]
                for r in (s.get("ilk20") or [])]

    veri = {"durum": "hazir", "kartlar": [ozet_kart, esik_kart]}
    if satirlar:
        veri["tablo"] = {
            "baslik": "Bilgi değerine göre ilk %d değişken" % len(satirlar),
            "kolonlar": ["FEATURE", "IV", "C-VALUE", "SONUÇ", "NOT"],
            "satirlar": satirlar,
            "toplam": olculen + atlanan,
            "gosterilen": len(satirlar),
        }
    return veri




















:root {
  /* ===== YAZI OLCEGI - tum arayuz yalnizca bu degerleri kullanir =====
     Tek font: Calibri (urun adindaki font).
     Olcek, onceki tasarimin %80 zoom halidir; ama tarayici zoom'u
     boyutlari kuruslu yapar (14px -> 11.2px) ve Calibri Windows'ta
     kuruslu boyutta bulanik cizilir. Bu yuzden TUM boyutlar tam piksel.
     Yeni bir boyut eklersen de tam piksel ver.
     Calibri'de yalnizca 3 agirlik var: 300 (Light), 400 (Regular),
     700 (Bold). Bu yuzden yalnizca --fw-normal ve --fw-kalin kullanilir.
     Buyuk harf CSS ile DEGIL, HTML/Python'da yazilir (Turkce I/İ). */
  --fs-kucuk:  11px;     /* faz no, sayac, durum cipi */
  --fs-etiket: 12px;     /* BUYUK HARFLI kirmizi etiketler: ANALİTİK SÜREÇ, VERİ SETİ... */
  --fs-govde:  12px;     /* metin, butonlar */
  --fs-baslik: 13px;     /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  15px;     /* urun adi, sayfa basligi */

  --fw-normal: 400;
  --fw-kalin:  700;

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  /* Buyuk harf araligi: az tutuldu, Calibri'nin dar buyuk harfleri
     acildikca seyrek ve farkli bir font gibi gorunuyor */
  --etiket-aralik: .02em;

  /* ===== BILESEN SISTEMI - kose, bosluk, yukseklik, golge ===== */
  --r:         6px;      /* kart, balon, buton, giris kutusu */
  --r-kucuk:   5px;      /* sekme, cip, liste ogesi, ic alan */
  --b-1: 3px;  --b-2: 6px;  --b-3: 10px;  --b-4: 13px;  --b-5: 16px;  --b-6: 19px;
  --btn-h:     29px;     /* tum ana butonlar */
  --btn-h-kucuk: 24px;   /* ikon butonlari, Gonder */
  --serit:     3px;      /* kart solundaki marka vurgu cubugu */
  --halka:     2px;      /* odak ve hover halkasi kalinligi */
  --golge-1:   0 1px 2px rgba(16,24,40,.06);
  --golge-2:   0 5px 13px rgba(16,24,40,.10);

  /* ===== RENK - zemin notr, kirmizi yalnizca vurgu ===== */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-acik: #FDF1F1;
  --kirmizi-halka: rgba(213,17,21,.16);

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #F9FAFB;
  --kenar:        #DDE1E6;          /* kart, balon, form kenarlari */
  --kenar-guclu:  #BFC5CE;
  --kenar-acik:   #EDEFF2;
  /* Yalnizca 3 yapisal ayrac: ust bar alti, sol panel sagi, sag panel solu.
     Notr (mavimsi degil) ve saydam: hangi zeminde olursa olsun hafif kalir. */
  --ayrac:        rgba(0,0,0,.08);

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.66);

  --user-zemin:   #EEF0F3;          /* kullanici balonu: bot'tan ayrissin */

  --gonder-zemin: #111111;
  --gonder-metin: #FFFFFF;

  /* ===== SOHBET ARKA PLANI =====
     Gorsel JS'ten gelir. Uzerinde zemin renginde bir perde var.
     --sohbet-perde-gucu:    acilistaki perde. 0 = gorsel tamamen gorunur,
                             1 = gorsel hic gorunmez
     --sohbet-perde-calisma: sohbet basladiktan sonraki (en az 2 mesaj) perde.
                             Acilista gorsel belirgin, calisirken sakin kalir.
                             Hep ayni kalsin istersen --sohbet-perde-gucu ile
                             ayni degeri ver.
     --sohbet-bulanik:       0px = bulaniklik yok; 4px, 8px... arttikca bulanir */
  --sohbet-gorsel: none;
  --sohbet-perde-gucu:    .42;
  --sohbet-perde-calisma: .8;
  --sohbet-bulanik:       13px;

  --yesil:        #0E8A52;
  --yesil-acik:   #E6F4EC;
  --amber:        #B45309;
  --amber-acik:   #FEF3C7;
  --amber-halka:  rgba(217,119,6,.30);
  --sari:         #EAB308;
  --sari-koyu:    #000000;          /* sari zemin ustundeki metin rengi */
  --sari-acik:    #FDF6D3;

  /* Iki panel de bir tik genisletildi (208/19/264 ve 304/29/432 idi).
     Uc degeri birden buyutmek gerekiyor: yalniz max buyutulurse genis
     ekranda genisler ama 1024-1100 arasinda hicbir sey degismez, cunku
     orada vw degeri kazaniyor. Min degerler olculu artirildi: cekmece
     esigi 944/864px ve orada iki panel yan yana duruyor — min'ler fazla
     buyurse sohbet sutunu okunamayacak kadar daralir. */
  /* Sol panel: dar ekranda 224px, genis ekranda en fazla 296px */
  --panel-en:   clamp(224px, 21vw, 296px);
  /* Sag panel: dar ekranda 328px, genis ekranda en fazla 480px */
  --analiz-en:  clamp(328px, 32vw, 480px);
  --avatar:     24px;
  --girinti:    32px;              /* avatar (24px) + bosluk (8px) */
  /* Ust bar yuksekligi; logo buna gore olceklenir.
     70px'ti: sekiz sayfa once kartlara dorduncu satir (.ozet-alt)
     eklenince icerik 75px'e cikti ve son satir barin altindan
     TASIYORDU (overflow gorunur oldugu icin kirpilmiyor, alttaki
     panelin uzerine biniyordu). Olculen ihtiyac 75px; 78px pay
     birakiyor. Dorduncu satiri buyutursen burayi da buyut. */
  --ustbar-h:   78px;
  --sohbet-yan: 19px;

  /* LLM balonu icin UST SINIR. Icerik kisaysa daha dar kalir. */
  --balon-en:     min(calc(100% - var(--girinti)), 42rem);
  /* Secenek karti tasiyan balonun ALT SINIRI - kartlar ezilmesin */
  --secenekli-en: min(calc(100% - var(--girinti)), 24rem);
  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami */
  --govde-en:     calc(100% - var(--girinti));
}

