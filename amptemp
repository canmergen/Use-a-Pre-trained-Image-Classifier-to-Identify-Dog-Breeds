# 4) ÇALIŞTIR VE RENK_Model_Sonuclar.xlsx'i YENİDEN YAZ
# ==================================================================
def _kt_gorselleri_tazele():
    """openpyxl ilk kayıtta görsel akışlarını kapatır; ikinci kayıt için görselleri son yazılan dosyadan geri yükler."""
    imgs = [img for w in wb.worksheets for img in getattr(w, "_images", [])]
    if not imgs:
        return
    medya = {}
    if isinstance(globals().get("_veri"), (bytes, bytearray)):
        with zipfile.ZipFile(BytesIO(_veri)) as z:
            for ad in z.namelist():
                m = re.match(r"xl/media/image(\d+)\.\w+$", ad)
                if m:
                    medya[int(m.group(1))] = z.read(ad)
    for i, img in enumerate(imgs, 1):
        if getattr(img.ref, "closed", False):
            if i in medya:
                img.ref = BytesIO(medya[i])
            else:
                raise RuntimeError("Görsel verisi bulunamadı: önce 18. hücreyi yeniden çalıştırın, sonra bu hücreyi.")


_KT_BLOKLAR = []
for _v in KT_VADELER:
    _r = _kt_vade_verisi(_v)
    if _r is None:
        continue
    _J, _bilgi = _r
    _oz = [(_seg_etiket(k), _kt_ozet(_J[_J["RENK"] == k])) for k, _, _ in RENKLER if (_J["RENK"] == k).any()]
    _oz.append(("Toplam", _kt_ozet(_J)))
    _KT_BLOKLAR.append({"vade": _v, "bilgi": _bilgi, "ozet": _oz, "detay": _kt_detay(_J, _v)})
    _t = _oz[-1][1]
    _log(f"   {_v}M toplam: batık oranı {_yuzde(_t['oran']) if np.isfinite(_t['oran']) else '...'} | yakalama göç "
         f"{_yuzde(_t['yak_g']) if np.isfinite(_t['yak_g']) else '...'}, takip "
         f"{_yuzde(_t['yak_t']) if np.isfinite(_t['yak_t']) else '...'}, ikisinden biri "
         f"{_yuzde(_t['yak_u']) if np.isfinite(_t['yak_u']) else '...'} | sonuç: {_t['sonuc']}")
    del _J
if not _KT_BLOKLAR:
    raise RuntimeError(f"Karşılaştırılacak vade yok: {KT_VADELER} için iki model klasörü de (OOT{_oot}) bulunamadı.")

_kt_gorselleri_tazele()
_kt_ws = _kt_sayfa(_KT_BLOKLAR)
wb._sheets.remove(_kt_ws)                                     # Mevcut Skor Karşılaştırma'dan hemen sonra
_kt_i = wb.sheetnames.index(KARSILASTIRMA_SAYFA) + 1 if KARSILASTIRMA_SAYFA in wb.sheetnames else len(wb._sheets)
wb._sheets.insert(_kt_i, _kt_ws)
if _VERI_WS:                                                  # gizli grafik verisi en sonda kalsın
    wb._sheets.remove(_VERI_WS[0])
    wb._sheets.append(_VERI_WS[0])
wb.active = 0
wb.calculation.fullCalcOnLoad = True                          # 20x20 formülleri açılışta hesaplansın
_buf = BytesIO()
wb.save(_buf)
_veri = _buf.getvalue()
_n_dilim = 0
if DILIMLEYICI_PLANI:
    try:
        _veri, _n_dilim = _dilimleyici_ekle(_veri, DILIMLEYICI_PLANI)
    except Exception as e:
        _log(f"⚠ Dilimleyiciler eklenemedi ({type(e).__name__}: {e}); dosya dilimleyicisiz yazılıyor, tablo filtreleri çalışır")
mf.upload_stream(CIKTI_DOSYA, BytesIO(_veri))
_kt_vadeler_metni = ", ".join(str(b["vade"]) + "M" for b in _KT_BLOKLAR)
_log(f"✓ {MAIN_FOLDER}{CIKTI_DOSYA} yeniden yazıldı | yeni sheet: {KT_SAYFA} ({_kt_vadeler_metni}) | "
     f"sheet'ler: {', '.join(wb.sheetnames)} | dilimleyici: {_n_dilim}")
