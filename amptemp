import re
import time
import numpy as np
import pandas as pd
import dataiku
import pyarrow.fs as pafs
import pyarrow.dataset as pads
from io import BytesIO

# =====================================================================
# AYARLAR
# =====================================================================
MAIN_FOLDER      = "GOC_MODEL_RESULTS"
CIKTI_DOSYA      = "/fpd_bucket_ozet.xlsx"      # kök dizine tek dosya

# Başka projedeki dataset: "PROJE_KEY.DATASET_ADI"
FPD_DATASET      = "BKATBALTERNATIFVERISKORKARTIPROJECT.FPD_CS_MODEL_INPUTS_2025_2026"
FPD_KEY_COL      = "MBB"                        # müşteri no (skor dosyasındaki mbb_no ile eşleşir)
FPD_DONEM_COL    = "PERIOD"                     # YYYYMM
FPD_HEDEFLER     = {                            # kısa ad -> kolon adı
    "TKP_5M90":    "TGT_CS_ALL_TKP_5M90",
    "TKP_ST_5M90": "TGT_CS_ALL_TKP_ST_5M90",
}

# S3 hızlı okuma (RENK_MDL_ALL_INP_2 okumasındaki ayarların aynısı)
S3_ENDPOINT      = "loscdlhp.aknet.akb:9000"
S3_SCHEME        = "https"

# Skor dosyasındaki kolon adları
SKOR_SET_COL     = "set_adi"
SKOR_KEY_COL     = "mbb_no"
SKOR_DONEM_COL   = "donem"
SKOR_Y_COL       = "target_actual"
SKOR_SCORE_COL   = "target_score"

CHUNK            = 2_000_000                    # yedek yol (iter_dataframes) için parça boyu
BUCKET_DOSYA_RE  = re.compile(r"^(renk_\d+_.+?)_bucket(\d+)_train_val_oot\.xlsx$")

mf = dataiku.Folder(MAIN_FOLDER)
_T0 = time.time()


def _log(mesaj):
    """Geçen süreyle birlikte anında ekrana basar."""
    dk, sn = divmod(int(time.time() - _T0), 60)
    print(f"[{dk:02d}:{sn:02d}] {mesaj}", flush=True)


def _yeni_kolonlar(ad):
    return [f"FPD_ESLESEN_ADET_{ad}", f"FPD_1_ADET_{ad}", f"FPD_1_ORAN_{ad}"]

TUM_YENI_KOLONLAR = [c for ad in FPD_HEDEFLER for c in _yeni_kolonlar(ad)]
FPD_OKUNACAK     = [FPD_KEY_COL, FPD_DONEM_COL] + list(FPD_HEDEFLER.values())


# =====================================================================
# YARDIMCILAR
# =====================================================================
def _sayi(s):
    """'182753.0' / 182753 / '182753' değerlerini aynı Int64 değere çevirir."""
    return pd.to_numeric(s, errors="coerce").round().astype("Int64")


def _cocuklar(yol):
    det = mf.get_path_details(yol) or {}
    return det.get("children") or []


def _alt_klasorler():
    kl = sorted(c["name"] for c in _cocuklar("/") if c.get("directory"))
    if not kl:
        kl = sorted({p.strip("/").split("/")[0]
                     for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    return kl


def _dosyalar(klasor):
    ad = [c["name"] for c in _cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition()
              if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


def _bucket_ata(score, nb):
    """Bucket raporundaki mantığın aynısı: rank bazlı, 1 = en yüksek skor."""
    score = np.asarray(score, dtype="float64")
    n = len(score)
    order = np.argsort(score, kind="stable")
    r = np.empty(n, dtype="float64")
    r[order] = np.arange(1, n + 1, dtype="float64")
    edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
    return nb - np.searchsorted(edges[1:-1], r, side="left")


def _fpd_oku_s3():
    """Parquet'i S3'ten pyarrow ile, sadece gereken 4 kolonu okuyarak getirir."""
    info = dataiku.Dataset(FPD_DATASET).get_location_info(sensitive_info=True)["info"]
    yol = info.get("path", "")
    if not yol.startswith("s3://"):
        raise RuntimeError(f"dataset S3'te değil (path: {yol or 'yok'})")
    cp = info["connectionParams"]
    s3 = pafs.S3FileSystem(
        access_key=cp["accessKey"],
        secret_key=cp["secretKey"],
        endpoint_override=S3_ENDPOINT,
        scheme=S3_SCHEME,
        force_virtual_addressing=False,
    )
    dset = pads.dataset(yol.replace("s3://", ""), filesystem=s3, format="parquet")

    # Kolon adlarını büyük/küçük harf duyarsız eşle (parquet'teki gerçek ad kullanılır)
    gercek = {n.upper(): n for n in dset.schema.names}
    eksik = [c for c in FPD_OKUNACAK if c.upper() not in gercek]
    if eksik:
        raise RuntimeError(f"parquet'te kolon yok: {eksik}")
    kolonlar = [gercek[c.upper()] for c in FPD_OKUNACAK]

    _log(f"   S3 kaynağı: {yol} | {dset.count_rows():,} satır x {len(dset.schema)} kolon, "
         f"okunan: {len(kolonlar)} kolon")
    df = dset.to_table(columns=kolonlar, use_threads=True).to_pandas(self_destruct=True)
    df.columns = FPD_OKUNACAK                     # ayarlardaki adlara geri çevir
    return df


def _fpd_oku_dataiku():
    """Yedek yol: Dataiku API ile parça parça okuma."""
    parcalar = []
    for i, ch in enumerate(dataiku.Dataset(FPD_DATASET).iter_dataframes(
            chunksize=CHUNK, columns=FPD_OKUNACAK), start=1):
        parcalar.append(ch)
        _log(f"   parça {i}: toplam {sum(len(p) for p in parcalar):,} satır okundu")
    return pd.concat(parcalar, ignore_index=True)


def _fpd_yukle():
    _log(f"FPD okunuyor: {FPD_DATASET}")
    try:
        ham = _fpd_oku_s3()
        _log("   S3 (pyarrow) ile okundu")
    except Exception as ex:
        _log(f"   ⚠ S3 hızlı okuma kullanılamadı ({ex}); Dataiku API ile okunuyor")
        ham = _fpd_oku_dataiku()
    n_ham = len(ham)

    f = pd.DataFrame({
        "_key":   _sayi(ham[FPD_KEY_COL]),
        "_donem": _sayi(ham[FPD_DONEM_COL]),
        **{ad: pd.to_numeric(ham[kol], errors="coerce") for ad, kol in FPD_HEDEFLER.items()},
    })
    del ham

    eksik = f["_key"].isna() | f["_donem"].isna()
    if eksik.any():
        _log(f"⚠ {FPD_KEY_COL} veya {FPD_DONEM_COL} boş olan {int(eksik.sum()):,} satır atıldı")
        f = f[~eksik]

    for ad, kol in FPD_HEDEFLER.items():
        gecersiz = f[ad].notna() & ~f[ad].isin([0, 1])
        if gecersiz.any():
            _log(f"⚠ {kol}: 0/1 dışı {int(gecersiz.sum()):,} değer boş sayıldı")
        f[ad] = f[ad].where(f[ad].isin([0, 1]))

    # Aynı müşterinin aynı dönemde birden çok kaydı varsa: biri 1 ise 1
    tekrar = int(f.duplicated(["_key", "_donem"]).sum())
    f = f.groupby(["_key", "_donem"], as_index=False)[list(FPD_HEDEFLER)].max()

    _log(f"FPD hazır: {n_ham:,} ham satır | {len(f):,} tekil (mbb, dönem) | "
         f"aynı dönemde tekrar eden: {tekrar:,} (MAX ile birleştirildi)")
    print("FPD dönem dağılımı (tekil müşteri):", flush=True)
    print(f.groupby("_donem").size().rename("adet").to_string(), flush=True)
    return f


def _sheet_zenginlestir(sh, skor, sheet_adi):
    sh = sh.drop(columns=[c for c in TUM_YENI_KOLONLAR if c in sh.columns])
    kol = {str(c).lower(): c for c in sh.columns}
    if "bucket" not in kol:
        return None, None

    if "kume" in kol:
        kume = sh[kol["kume"]].astype(str).str.strip().str.upper()
    else:
        m = re.search(r"TRAIN|VAL|OOT", str(sheet_adi).upper())
        if not m:
            return None, None
        kume = pd.Series(m.group(0), index=sh.index)
    bucket = pd.to_numeric(sh[kol["bucket"]], errors="coerce")

    agg = {"_n": ("_y", "size"), "_bad": ("_y", "sum")}
    for ad in FPD_HEDEFLER:
        agg[f"FPD_ESLESEN_ADET_{ad}"] = (ad, "count")
        agg[f"FPD_1_ADET_{ad}"]       = (ad, "sum")

    parcalar = []
    for k in kume.dropna().unique():
        satir = kume == k
        if "n_bucket" in kol:
            nb = int(pd.to_numeric(sh.loc[satir, kol["n_bucket"]], errors="coerce").max())
        else:
            nb = int(bucket[satir].max())
        d = skor[skor["_kume"] == k]
        if d.empty:
            continue
        d = d.assign(bucket=_bucket_ata(d["_score"].to_numpy(), nb))
        g = d.groupby("bucket").agg(**agg).reset_index()
        g["_kume"] = k
        parcalar.append(g)

    if not parcalar:
        return None, {"hata": f"skor dosyasında eşleşen küme yok: {sorted(kume.unique())}"}

    oz = pd.concat(parcalar, ignore_index=True)
    for ad in FPD_HEDEFLER:
        oz[f"FPD_1_ADET_{ad}"] = oz[f"FPD_1_ADET_{ad}"].astype("int64")
        oz[f"FPD_1_ORAN_{ad}"] = (oz[f"FPD_1_ADET_{ad}"]
                                  / oz[f"FPD_ESLESEN_ADET_{ad}"].replace(0, np.nan)).round(4)

    anahtar = pd.DataFrame({"_kume": kume.values, "bucket": bucket.values})
    birles = anahtar.merge(oz, on=["_kume", "bucket"], how="left")
    birles.index = sh.index

    qa = {"satir": len(sh), "bulunamayan": int(birles["_n"].isna().sum())}
    if "n" in kol:
        qa["n_fark"] = int((birles["_n"] != pd.to_numeric(sh[kol["n"]], errors="coerce")).sum())
    if "bad" in kol:
        qa["bad_fark"] = int((birles["_bad"] != pd.to_numeric(sh[kol["bad"]], errors="coerce")).sum())

    sh = sh.copy()
    for c in TUM_YENI_KOLONLAR:
        sh[c] = birles[c]
    return sh, qa


# =====================================================================
# ANA DÖNGÜ (klasörlere yazmaz, sadece okur)
# =====================================================================
_log("Başladı")
fpd = _fpd_yukle()
skor_kolonlari = {SKOR_SET_COL, SKOR_KEY_COL, SKOR_DONEM_COL, SKOR_Y_COL, SKOR_SCORE_COL}
toplanan = {}      # "BUCKET20" / "BUCKET100" -> [df, ...]
qa_log, eslesme_log = [], []

klasorler = _alt_klasorler()
_log(f"{len(klasorler)} klasör bulundu: {klasorler}")

for ki, klasor in enumerate(klasorler, start=1):
    dosyalar = _dosyalar(klasor)
    gruplar = {}
    for ad in dosyalar:
        m = BUCKET_DOSYA_RE.match(ad)
        if m:
            gruplar.setdefault(m.group(1), []).append((ad, int(m.group(2))))
    if not gruplar:
        _log(f"[{ki}/{len(klasorler)}] {klasor}: bucket dosyası yok, atlandı")
        continue

    _log(f"=== [{ki}/{len(klasorler)}] {klasor} ({len(gruplar)} renk) ===")
    for onek, xlsx_listesi in sorted(gruplar.items()):
        skor_ad = f"{onek}_musteri_skorlari.csv"
        if skor_ad not in dosyalar:
            _log(f"  ⚠ {skor_ad} yok, {onek} atlandı")
            continue

        _log(f"  {onek}: skor dosyası okunuyor")
        with mf.get_download_stream(f"/{klasor}/{skor_ad}") as s:
            skor = pd.read_csv(s, usecols=lambda c: c in skor_kolonlari)
        eksik = skor_kolonlari - set(skor.columns)
        if eksik:
            _log(f"  ⚠ {skor_ad} içinde eksik kolon: {eksik}, atlandı")
            continue

        skor = pd.DataFrame({
            "_kume":  skor[SKOR_SET_COL].astype(str).str.strip().str.upper(),
            "_key":   _sayi(skor[SKOR_KEY_COL]),
            "_donem": _sayi(skor[SKOR_DONEM_COL]),
            "_y":     pd.to_numeric(skor[SKOR_Y_COL], errors="coerce"),
            "_score": pd.to_numeric(skor[SKOR_SCORE_COL], errors="coerce"),
        }).merge(fpd, on=["_key", "_donem"], how="left")   # müşteri + aynı dönem

        for (kume_ad, donem), g in skor.groupby(["_kume", "_donem"]):
            eslesme_log.append({"KLASOR": klasor, "renk": onek, "kume": kume_ad,
                                "donem": donem, "musteri": len(g),
                                **{f"eslesme_{ad}": round(g[ad].notna().mean(), 4)
                                   for ad in FPD_HEDEFLER}})
        es = " | ".join(f"{ad} %{skor[ad].notna().mean() * 100:.1f}" for ad in FPD_HEDEFLER)
        _log(f"  {onek}: {len(skor):,} satır | dönemler "
             f"{sorted(skor['_donem'].dropna().unique())} | eşleşme {es}")

        for xlsx_ad, nb_dosya in sorted(xlsx_listesi):
            with mf.get_download_stream(f"/{klasor}/{xlsx_ad}") as s:
                sheets = pd.read_excel(BytesIO(s.read()), sheet_name=None)

            for sh_ad, sh in sheets.items():
                yeni, qa = _sheet_zenginlestir(sh, skor, sh_ad)
                if qa is not None:
                    qa_log.append({"KLASOR": klasor, "dosya": xlsx_ad, "sheet": sh_ad, **qa})
                if yeni is not None:
                    yeni.insert(0, "KLASOR", klasor)
                    toplanan.setdefault(f"BUCKET{nb_dosya}", []).append(yeni)
            _log(f"    ✓ {xlsx_ad} işlendi")

# --- Tek Excel: her bucket sayısı ayrı sheet + QA + eşleşme -----------
_log("Excel yazılıyor")
buf = BytesIO()
with pd.ExcelWriter(buf, engine="openpyxl") as xl:
    for sh_ad in sorted(toplanan, key=lambda x: int(x.replace("BUCKET", ""))):
        tablo = pd.concat(toplanan[sh_ad], ignore_index=True)
        n0 = len(tablo)
        tablo = tablo.drop_duplicates()               # aynı satır iki sheet'te varsa tek kalsın
        bas = [c for c in tablo.columns if c not in TUM_YENI_KOLONLAR]
        tablo = tablo[bas + TUM_YENI_KOLONLAR]        # 6 FPD kolonu en sonda
        tablo.to_excel(xl, sheet_name=sh_ad, index=False)
        _log(f"{sh_ad}: {len(tablo):,} satır (tekrar atılan: {n0 - len(tablo):,})")
    pd.DataFrame(qa_log).to_excel(xl, sheet_name="QA", index=False)
    pd.DataFrame(eslesme_log).to_excel(xl, sheet_name="ESLESME_DONEM", index=False)
buf.seek(0)
mf.upload_stream(CIKTI_DOSYA, buf)
_log(f"✓ {MAIN_FOLDER}{CIKTI_DOSYA} yazıldı; klasörlerdeki dosyalara dokunulmadı")

qa_df = pd.DataFrame(qa_log)
print("\n===== QA (n_fark / bad_fark / bulunamayan hepsi 0 olmalı) =====", flush=True)
print(qa_df.to_string(index=False) if not qa_df.empty else "Hiç bucket sheet'i işlenmedi", flush=True)
