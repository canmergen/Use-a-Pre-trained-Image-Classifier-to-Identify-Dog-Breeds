# --- SHAPRFECV (yerel; probatus / shap paketi gerekmez) -----------------------
# probatus 3.1.2 ShapRFECV ile ayni dongu: her turda CV fold'larinda model
# egitilir, train/val skoru alinir, SHAP validation fold'unda hesaplanir,
# ortalama |SHAP| en dusuk feature'lar step oraninda elenir. Rapor kolonlari ve
# get_reduced_features_set ayni. SHAP: LightGBM pred_contrib (TreeSHAP).
class Scorer:
    def __init__(self, metric_name, custom_scorer):
        self.metric_name = metric_name
        self.scorer = custom_scorer

    def score(self, model, X, y):
        return float(self.scorer(model, X, y))


class ShapRFECV:
    def __init__(self, model, step=0.15, min_features_to_select=1, cv=None,
                 scoring=None, n_jobs=1):
        if not isinstance(step, (int, float)) or step <= 0:
            raise ValueError(f'Gecersiz step: {step}')
        self.model = model
        self.step = step
        self.min_features_to_select = max(int(min_features_to_select), 1)
        self.cv = cv
        self.scorer = scoring
        self.report_df = pd.DataFrame()

    def _silinecek_sayisi(self, n):
        k = self.step if isinstance(self.step, int) else max(int(np.floor(n * self.step)), 1)
        return max(min(k, n - self.min_features_to_select), 0)

    @staticmethod
    def _gini(y, p):
        # AUC sinifa gore alt orneklemeden etkilenmez; agirlik gerekmez.
        y = np.asarray(y)
        if len(np.unique(y)) < 2:
            return np.nan
        return 2 * roc_auc_score(y, p) - 1

    @staticmethod
    def _shap_degerleri(model, X):
        katki = np.asarray(model.predict(X, pred_contrib=True), dtype='float64')
        if katki.ndim != 2 or katki.shape[1] != X.shape[1] + 1:
            raise ValueError(f'pred_contrib boyutu beklenmedik: {katki.shape}')
        return katki[:, :-1]

    def fit_compute(self, X, y, sample_weight=None, check_additivity=False):
        _obj = list(X.columns[X.dtypes == object])
        if _obj:
            X = X.copy()
            for c in _obj:
                X[c] = X[c].astype('category')
        y = pd.Series(np.asarray(y), index=X.index)
        sw = None if sample_weight is None else np.asarray(sample_weight, dtype='float64')
        splits = list(self.cv.split(X, y)) if hasattr(self.cv, 'split') else list(self.cv)

        satirlar = []
        _t0 = time.time()
        mevcut = kalan = list(X.columns)
        while len(mevcut) > self.min_features_to_select:
            mevcut = kalan
            Xc = X[mevcut]
            shap_parcalar, s_tr, s_va, g_va = [], [], [], []
            for itr, iva in splits:
                m = clone(self.model)
                if sw is None:
                    m.fit(Xc.iloc[itr], y.iloc[itr])
                else:
                    m.fit(Xc.iloc[itr], y.iloc[itr], sample_weight=sw[itr])
                s_tr.append(self.scorer.score(m, Xc.iloc[itr], y.iloc[itr]))
                s_va.append(self.scorer.score(m, Xc.iloc[iva], y.iloc[iva]))
                g_va.append(self._gini(y.iloc[iva], m.predict_proba(Xc.iloc[iva])[:, 1]))
                shap_parcalar.append(self._shap_degerleri(m, Xc.iloc[iva]))
            onem = np.abs(np.concatenate(shap_parcalar, axis=0)).mean(axis=0)
            sira = np.argsort(-onem, kind='mergesort')
            k = self._silinecek_sayisi(len(mevcut))
            silinen = [mevcut[i] for i in sira[len(mevcut) - k:]] if k else []
            _sil = set(silinen)
            kalan = [c for c in mevcut if c not in _sil]
            satirlar.append({
                'num_features': len(mevcut), 'features_set': list(mevcut),
                'eliminated_features': silinen,
                'train_metric_mean': float(np.mean(s_tr)), 'train_metric_std': float(np.std(s_tr)),
                'val_metric_mean': float(np.mean(s_va)), 'val_metric_std': float(np.std(s_va)),
                'val_gini_mean': float(np.nanmean(g_va)), 'val_gini_std': float(np.nanstd(g_va)),
            })
            if globals().get('SHAP_ILERLEME', True):
                print(f'    tur {len(satirlar):>2}: {len(mevcut):>3} feature | '
                      f'CV Capture={np.mean(s_va):.4f} Gini={np.nanmean(g_va):.4f} | '
                      f'{(time.time() - _t0) / 60:.1f} dk', flush=True)
        self.report_df = pd.DataFrame(satirlar, index=range(1, len(satirlar) + 1))
        return self.report_df

    def get_reduced_features_set(self, num_features):
        eslesen = self.report_df[self.report_df['num_features'] == num_features]
        if eslesen.empty:
            raise ValueError(f'{num_features} feature hicbir turda olusmadi: '
                             f'{sorted(self.report_df["num_features"].unique())}')
        return list(eslesen.iloc[0]['features_set'])

