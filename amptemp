# ==============================================================================
# FEATURE ENGINEERING (v6)
# feature_engineering(df) -> (df_eng, yeni_feature_isimleri)
# _window, _exist, _sdiv, _summ, _trend_delta 5. hücreden gelir, burada yeniden
# tanımlanmaz.
#
# NE YAPAR
# Her müşterinin son 12 aylık geçmişinden (renk, DAV, MMS, KKB skoru, kart limit /
# borç / ödeme oranı, INT pencereleri, TAUM, hazır skorlar) özet feature'lar üretir.
# Her değer yalnızca o satırın kendi geçmişinden, sabit kurallarla hesaplanır.
# Hedef (TARGET), başka müşteriler, örneklem ya da veriden öğrenilen bir tablo
# kullanılmaz: target encoding yok. Aynı satır her zaman aynı sonucu verir.
#
# İSİMLENDİRME
# - Aylar: LM = model ayından 1 ay önce (en yeni ay), L2M = 2 ay önce ... L12M.
# - Özetlerde L3M / L6M / L12M = LM dahil son 3 / 6 / 12 ay penceresi;
#   4_6 = L4M..L6M, 7_12 = L7M..L12M.
# - AY_* feature'ları olayın kaç ay geride olduğunu verir: 0 = LM, 1 = L2M,
#   2 = L3M ... 11 = L12M. Olay 12 ayda yoksa NaN. Geçişlerde değer geçişin yeni
#   ayıdır: AY_SON_KOTULESME = 2, rengin L4M'den L3M'e kötüleştiği demektir.
# - _ADET: sayım. _SERI / _SERI_SIMDI: LM'den geriye kesintisiz ay sayısı.
#   _FLG: 0/1 bayrak. _TREND: yakın pencere ortalaması - uzak pencere ortalaması.
# - Renk kodu: küçük = kötü (1 KIRMIZI, 2 TURUNCU, 3 SARI, 4 ACK_YESIL, 5 YESIL,
#   6 KOY_YESIL). 0 = INAKTIF, renk sayılmaz. Risk rengi = KIRMIZI veya TURUNCU.
# - Yön: renk, KKB, DAV ve ödeme oranında düşüş kötü; MMS ve kart kullanımında
#   (KKU = KK_RISK / KK_LIMIT) artış kötü.
#
# EKSİK DEĞER
# Ölçülemeyen değer NaN kalır: ilgili ay boşsa bayrak 0 değil NaN olur, oranlar
# 12'ye değil geçerli ay sayısına bölünür. Eski ailelerde geçersiz bölme -99
# (5. hücre _sdiv); yeni ailelerde NaN. Yeni aileler float32.
# Hücre 8'deki preprocess() bu yüzden kullanılmaz (boşları 0 / -1 yapar).
#
# ÖRNEK MÜŞTERİ: aşağıdaki tüm örnek değerler bu müşteri için kodla hesaplandı.
#                 LM   L2M   L3M   L4M   L5M   L6M   L7M  L8M  L9M L10M L11M L12M
#   RENK           2     1     1     3     4     4     5    5    5    5    5    5
#   KK_LIMIT    8000  8000  8000 10000 10000 10000 10000 (L12M'ye kadar 10000)
#   KK_RISK     7600  7800  7500  7000  6000  5000  4000 3500 3000 2500    0    0
#   KKU (oran)  0.95 0.975  0.94  0.70  0.60  0.50  0.40 0.35 0.30 0.25    0    0
#   ODEME (%)     25    10    10    15    30    50    60   80  100  100  100  100
#   KKB_SKOR    1150  1180  1250  1300  1350  1380  1400 1400 1410 1400 1420 1410
#   DAV_SKOR     400   420   450   500   520   530   540  540  545  540  550  545
#   MMS            8     7     7     5     4     4     3    3    3    3    3    3
# Hikaye: 6 ay YESIL, L6M'den itibaren düşüş, L3M ve L2M'de KIRMIZI, LM'de
# TURUNCU'ya bir basamak toparlanma. Banka L3M'de limiti 10000'den 8000'e indirmiş;
# kullanım %95'e çıkmış; ödeme oranı %100'den %10-25'e düşmüş; KKB ve DAV düşüyor,
# MMS artıyor.
#
# AİLELER (önek, adet, ne ölçer). Her fonksiyonun üstünde ürettiği her feature için:
#   Nasıl  = nasıl hesaplandığı, Anlamı = değerin ne söylediği,
#   Örnek  = yukarıdaki örnek müşteri için hesabın kendisi.
# Eski hücreden gelen 7 fonksiyon (213 feature, hatalar düzeltildi):
#   RENK_*                        renk ortalama / min / max / trend / sayımlar
#   DAV_*, MMS_*, KKB_SKOR_*, ODM_*  skorların ve ödeme oranının pencere özetleri
#   KK_LIMIT_*, KK_RISK_*, KK_LKO_*  kart limit / borç / kullanım özetleri
#   TAUM_*, AKB_TAUM_ORAN, ODEME_*, BSVR_*, SDM_/SHM_EKOD_DELTA  hazır kolon oranları
# Yeni 11 fonksiyon (274 feature; INT ve DS sayısı veride bulunan kolonlara göre):
#   RENK_Y_*        62  renk geçmişi bir yol olarak (düşüş, seri, giriş / çıkış)
#   <P>_D_*         85  DAV / MMS / KKB / ODM / KKU serilerinin eğim, ivme, seri
#   ESZ_*           15  aynı dönemde kaç gösterge birlikte bozuldu
#   GIZLI_*          6  renk bozulmamışken diğer göstergelerin bozulması
#   INT_*_INTD_*   ~23  INT pencerelerinde yakın / uzak oranı, aktivite durdu mu
#   BV_*             4  kart borcu ve varlık (TAUM) birlikte
#   KK_O_*          20  limit düşüş / artış, kullanım eşikleri, sıfır borç
#   OK_*             7  aynı ayda düşük ödeme + yüksek kullanım
#   YB_*            30  müşteri için yeni başlayan olaylar
#   OG_*            15  son renk düşüşünden önce göstergeler bozulmuş muydu
#   DS_*            ~7  hazır model skorlarının renk yolu ile çarpımları
# Pipeline ayrıca DSN_* (desen kodlaması) ekler; açıklaması pipeline başında.
#
# ESKİ HÜCREYE GÖRE FARKLAR
# - INAKTIF (0) renk ortalama / min / max / risk sayımlarına girmiyor (eskiden 0,
#   kırmızıdan kötü bir renk gibi ortalamayı aşağı çekiyordu).
# - Oranlar geçerli ay sayısına bölünüyor; karşılaştırma bayrakları eksik ayda NaN.
# - KK_LKO limit 0 / boşsa -99 değil NaN; -99'lar LKO özetlerine karışmıyor.
# - KKB_SKOR_CHG_L3M çıkarıldı (KKB_SKOR_DELTA_1_3 ile aynıydı).
# - Aynı isimli bazı kolonların değeri değişti: eski hücreyle eğitilmiş bir model
#   bu FE ile skorlanmamalı, yeniden eğitim gerekir.
# ==============================================================================
"""RENK_GOC_MODEL | Feature engineering (v6). feature_engineering(df) -> (df_eng, yeni_feature_isimleri)."""

import numpy as np
import pandas as pd


def _fe_ayarlar():
    """Feature engineering ayarlari. Tum fonksiyonlar buradan okur."""
    return {
        'AYLAR_12': ['LM'] + [f'L{i}M' for i in range(2, 13)],

        'RENK_RISK_ESIK': 2,

        'SERI_TANIM': {
            'DAV_SKOR':       ('DAV', False),
            'MMS':            ('MMS', False),
            'KKB_SKOR':       ('KKB', True),
            'KK_ODEME_ORANI': ('ODM', False),
        },

        'SERI_YON': {
            'RENK':           +1,
            'KKB_SKOR':       +1,
            'KK_ODEME_ORANI': +1,
            'KK_KULLANIM':    -1,
            'DAV_SKOR':       +1,
            'MMS':            -1,
        },

        'DIS_SKORLAR': ['PRED_BK_12_AY_TOP', 'PRED_BK_12_AY_TOP_PERC', 'PredCs',
                        'EXPECTED_LOSS', 'LTV', 'LTV_WITH_LOSS'],

        'INT_PENCERELER': ('LM', 'L3M', 'L6M', 'L9M', 'L12M'),
        'KKU_ESIKLER': (0.8, 0.9, 1.0),
        'KKU_YUKSEK': 0.8, 'KKU_DUSUK': 0.3,
        'ODM_DUSUK': 20, 'ODM_TAM': 100,
        'YENI_FEATURE_DTYPE': np.float32,
    }


def _sayi(df, c):
    """Kolonu float64 diziye cevirir; metin, bos ve NA -> NaN."""
    return pd.to_numeric(df[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)


def _sayi_mat(df, cols):
    return np.column_stack([_sayi(df, c) for c in cols]) if cols else np.empty((len(df), 0))


def _renk_kodlari():
    """COLOR_MAP'ten (inaktif kod, aktif renk kodlari, kirmizi kodu)."""
    inaktif = [k for k, v in COLOR_MAP.items() if str(v).upper() == 'INAKTIF']
    aktif = sorted(k for k in COLOR_MAP if k not in inaktif)
    if not aktif or str(COLOR_MAP[aktif[0]]).upper() != 'KIRMIZI':
        raise ValueError('COLOR_MAP: aktif renklerin en kucuk kodu KIRMIZI degil; '
                         'renk yonu varsayimi (kucuk kod = kotu) gecersiz.')
    return (inaktif[0] if inaktif else None), np.array(aktif, dtype='float64'), float(aktif[0])


def _renk_aktif_df(df, cols):
    """RENK lag kolonlarinda INAKTIF (0) ve gecersiz kodlar NaN."""
    _, aktif, _ = _renk_kodlari()
    A = _sayi_mat(df, cols)
    return pd.DataFrame(np.where(np.isin(A, aktif), A, np.nan), index=df.index, columns=cols)


# ------------------------------------------------------------------------------
# RENK_* (eski aile, 33 feature). Kaynak: RENK_LM..RENK_L12M renk kodları.
# INAKTIF (0) aylar ortalama / min / max / medyan / trend hesabına girmez.
# Pencere: L3M = LM, L2M, L3M; L6M = LM..L6M; L12M = LM..L12M.
#
#   RENK_AVG_L3M, RENK_AVG_L6M, RENK_AVG_L12M
#     Nasıl : Penceredeki aktif renk kodlarının ortalaması; geçerli ay sayısına bölünür.
#     Anlamı: Dönemin ortalama renk seviyesi. Küçük = kötü (1 KIRMIZI ... 6 KOY_YESIL).
#     Örnek : L3M: (2 + 1 + 1) / 3 = 1.33; L6M: (2+1+1+3+4+4) / 6 = 2.5; L12M: 45 / 12 = 3.75.
#
#   RENK_STD_L3M, RENK_STD_L6M, RENK_STD_L12M
#     Nasıl : Penceredeki aktif renk kodlarının standart sapması (n-1 ile); tek ay varsa 0.
#     Anlamı: Renk ne kadar oynak. 0 = dönem boyunca hep aynı renk.
#     Örnek : L3M: 2, 1, 1 → 0.58; L6M: 1.38; L12M: 1.60.
#
#   RENK_MIN_L3M, RENK_MIN_L6M, RENK_MIN_L12M
#     Nasıl : Penceredeki en küçük renk kodu.
#     Anlamı: Dönemde görülen en kötü renk.
#     Örnek : L3M, L6M, L12M: üçünde de KIRMIZI → 1.
#
#   RENK_MAX_L3M, RENK_MAX_L6M, RENK_MAX_L12M
#     Nasıl : Penceredeki en büyük renk kodu.
#     Anlamı: Dönemde görülen en iyi renk.
#     Örnek : L3M: 2; L6M: 4 (L5M, L6M ACK_YESIL); L12M: 5 (YESIL).
#
#   RENK_MED_L3M, RENK_MED_L6M, RENK_MED_L12M
#     Nasıl : Penceredeki aktif renk kodlarının medyanı (çift sayıda ayda ortadaki iki değerin
#             ortalaması).
#     Anlamı: Uç aylardan etkilenmeyen tipik renk.
#     Örnek : L3M: 1, 1, 2 → 1; L6M: 1,1,2,3,4,4 → (2+3)/2 = 2.5; L12M: ortadaki 4 ve 5 → 4.5.
#
#   RENK_TREND_3_46
#     Nasıl : Son 3 ayın ortalaması (LM..L3M) - önceki 3 ayın ortalaması (L4M..L6M).
#     Anlamı: Negatif = son 3 ay öncesine göre kötüleşmiş; pozitif = iyileşmiş.
#     Örnek : (2+1+1)/3 - (3+4+4)/3 = 1.33 - 3.67 = -2.33.
#
#   RENK_TREND_6_712
#     Nasıl : Son 6 ayın ortalaması (LM..L6M) - L7M..L12M ortalaması.
#     Anlamı: Negatif = son yarım yıl önceki yarım yıla göre kötü.
#     Örnek : 2.5 - (5+5+5+5+5+5)/6 = 2.5 - 5 = -2.5.
#
#   RENK_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayda kaç basamak değişti. Pozitif = iyileşme, negatif = kötüleşme.
#     Örnek : 2 - 1 = +1 (KIRMIZI'dan TURUNCU'ya).
#
#   RENK_DELTA_1_3
#     Nasıl : LM - L3M.
#     Anlamı: Son iki ayda toplam kaç basamak değişti.
#     Örnek : 2 - 1 = +1.
#
#   RENK_CNT_INAKTIF, RENK_CNT_KIRMIZI, RENK_CNT_TURUNCU, RENK_CNT_SARI, RENK_CNT_ACK_YESIL,
#   RENK_CNT_YESIL, RENK_CNT_KOY_YESIL
#     Nasıl : Son 12 ayda o renk koduyla geçen ay sayısı (COLOR_MAP'teki her kod için bir
#             feature).
#     Anlamı: Müşterinin 12 ayının renk dağılımı.
#     Örnek : KIRMIZI 2 (L2M, L3M), TURUNCU 1 (LM), SARI 1 (L4M), ACK_YESIL 2 (L5M, L6M), YESIL
#             6 (L7M..L12M), KOY_YESIL 0, INAKTIF 0.
#
#   RENK_CNT_RISK
#     Nasıl : RENK_CNT_KIRMIZI + RENK_CNT_TURUNCU.
#     Anlamı: 12 ayın kaçında risk renginde.
#     Örnek : 2 + 1 = 3.
#
#   RENK_CNT_GOOD
#     Nasıl : Kodu 4 ve üstü (ACK_YESIL, YESIL, KOY_YESIL) olan ay sayısı.
#     Anlamı: 12 ayın kaçında iyi renkte.
#     Örnek : 2 + 6 + 0 = 8.
#
#   RENK_RISK_RATIO
#     Nasıl : RENK_CNT_RISK / aktif renkli ay sayısı.
#     Anlamı: Aktif ayların ne kadarı riskte geçti (0-1).
#     Örnek : 3 / 12 = 0.25.
#
#   RENK_RISK_IN_L3M
#     Nasıl : Son 3 ayda (LM, L2M, L3M) en az bir risk rengi varsa 1, yoksa 0; üç ay da boş /
#             inaktifse NaN.
#     Anlamı: Müşteri son 3 ayda riske dokundu mu.
#     Örnek : LM TURUNCU → 1.
#
#   RENK_DECLINING
#     Nasıl : LM < L2M < L3M ise 1; üç aydan biri boş / inaktifse NaN.
#     Anlamı: Üç ay üst üste iki kez kötüleşme.
#     Örnek : 2 < 1 değil → 0.
#
#   RENK_IMPROVING
#     Nasıl : LM > L2M > L3M ise 1; üç aydan biri boş / inaktifse NaN.
#     Anlamı: Üç ay üst üste iki kez iyileşme.
#     Örnek : 2 > 1 ama 1 > 1 değil → 0.
#
#   RENK_MODE_L12M
#     Nasıl : 12 ayın en sık renk kodu (INAKTIF dahil; eşitlikte küçük kod).
#     Anlamı: Müşterinin "normal" rengi.
#     Örnek : YESIL 6 ay → 5.
# ------------------------------------------------------------------------------
def _renk_features(df):
    out = {}
    all12 = _exist(df, _window('RENK')['all'])
    r3 = _exist(df, _window('RENK')['w3'])

    if not all12:
        return out

    aktif_df = _renk_aktif_df(df, all12)
    _summ(aktif_df, 'RENK', out, add_med=True)
    _trend_delta(aktif_df, 'RENK', out)
    if {'RENK_LM', 'RENK_L3M'}.issubset(aktif_df.columns):
        out['RENK_DELTA_1_3'] = aktif_df['RENK_LM'] - aktif_df['RENK_L3M']

    idx = df.index
    M = _sayi_mat(df, all12)
    A = aktif_df.to_numpy(dtype="float64", na_value=np.nan)
    gecerli = (~np.isnan(A)).sum(axis=1)

    def _cnt_eq(v):
        """(df[all12] == v).sum(axis=1) ile ayni; NaN == v zaten False."""
        return pd.Series((M == v).sum(axis=1), index=idx)

    def _mode_first():
        """df[all12].mode(axis=1)[0] ile ayni."""
        finite = M[~np.isnan(M)]
        if finite.size == 0:
            return pd.Series(np.full(len(df), np.nan), index=idx)
        uniq = np.unique(finite)
        if uniq.size > 64:
            return pd.DataFrame(M, index=idx).mode(axis=1)[0]
        counts = np.empty((len(df), uniq.size), dtype=np.int8)
        for j, u in enumerate(uniq):
            counts[:, j] = (M == u).sum(axis=1)
        best = counts.argmax(1)
        res = uniq[best]
        res[counts.max(axis=1) == 0] = np.nan
        return pd.Series(res, index=idx)

    for v, n in COLOR_MAP.items():
        out[f'RENK_CNT_{n}'] = _cnt_eq(v)
    out['RENK_CNT_RISK'] = out['RENK_CNT_KIRMIZI'] + out['RENK_CNT_TURUNCU']
    out['RENK_CNT_GOOD'] = pd.Series((M >= 4).sum(axis=1), index=idx)

    out['RENK_RISK_RATIO'] = pd.Series(
        np.where(gecerli > 0, out['RENK_CNT_RISK'].to_numpy() / np.maximum(gecerli, 1), np.nan),
        index=idx)

    if r3:
        R3 = _renk_aktif_df(df, r3).to_numpy(dtype="float64", na_value=np.nan)
        olculdu = (~np.isnan(R3)).any(axis=1)
        out['RENK_RISK_IN_L3M'] = pd.Series(
            np.where(olculdu, (R3 <= _fe_ayarlar()['RENK_RISK_ESIK']).any(axis=1), np.nan), index=idx)

    if {'RENK_LM', 'RENK_L2M', 'RENK_L3M'}.issubset(aktif_df.columns):
        a, b, c = (aktif_df[k].to_numpy(dtype="float64", na_value=np.nan)
                   for k in ('RENK_LM', 'RENK_L2M', 'RENK_L3M'))
        tam = ~(np.isnan(a) | np.isnan(b) | np.isnan(c))
        out['RENK_DECLINING'] = pd.Series(np.where(tam, (a < b) & (b < c), np.nan), index=idx)
        out['RENK_IMPROVING'] = pd.Series(np.where(tam, (a > b) & (b > c), np.nan), index=idx)

    out['RENK_MODE_L12M'] = _mode_first()
    return out


# ------------------------------------------------------------------------------
# DAV_* (eski aile, 17 feature). Kaynak: DAV_SKOR_LM..L12M. Yön ayarında yüksek = iyi.
# Değerler: 400, 420, 450, 500, 520, 530, 540, 540, 545, 540, 550, 545 (LM'den geriye).
#
#   DAV_AVG_L3M, DAV_AVG_L6M, DAV_AVG_L12M
#     Nasıl : Penceredeki dolu ayların ortalaması.
#     Anlamı: Dönemin ortalama DAV skoru.
#     Örnek : L3M: (400+420+450)/3 = 423.3; L6M: 2820/6 = 470; L12M: 6080/12 = 506.7.
#
#   DAV_STD_L3M, DAV_STD_L6M, DAV_STD_L12M
#     Nasıl : Penceredeki dolu ayların standart sapması (n-1).
#     Anlamı: Skorun oynaklığı.
#     Örnek : L3M: 25.2; L6M: 54.4; L12M: 53.1.
#
#   DAV_MIN_L3M, DAV_MIN_L6M, DAV_MIN_L12M
#     Nasıl : Penceredeki en düşük skor.
#     Anlamı: Dönemin en kötü skoru.
#     Örnek : L3M, L6M, L12M: 400 (LM).
#
#   DAV_MAX_L3M, DAV_MAX_L6M, DAV_MAX_L12M
#     Nasıl : Penceredeki en yüksek skor.
#     Anlamı: Dönemin en iyi skoru.
#     Örnek : L3M: 450; L6M: 530; L12M: 550.
#
#   DAV_TREND_3_46
#     Nasıl : Son 3 ay ortalaması - L4M..L6M ortalaması.
#     Anlamı: Negatif = skor son 3 ayda düşmüş.
#     Örnek : 423.3 - (500+520+530)/3 = 423.3 - 516.7 = -93.3.
#
#   DAV_TREND_6_712
#     Nasıl : Son 6 ay ortalaması - L7M..L12M ortalaması.
#     Anlamı: Negatif = son yarım yıl öncekinden kötü.
#     Örnek : 470 - 3260/6 = 470 - 543.3 = -73.3.
#
#   DAV_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayki değişim.
#     Örnek : 400 - 420 = -20.
#
#   DAV_CV_12M
#     Nasıl : DAV_STD_L12M / DAV_AVG_L12M; ortalama 0 / boşsa -99.
#     Anlamı: Ortalamaya göre oynaklık (ölçekten bağımsız).
#     Örnek : 53.1 / 506.7 = 0.105.
#
#   DAV_RANGE_12M
#     Nasıl : DAV_MAX_L12M - DAV_MIN_L12M.
#     Anlamı: 12 aydaki en geniş salınım.
#     Örnek : 550 - 400 = 150.
# ------------------------------------------------------------------------------
def _dav_features(df):
    out = {}
    _summ(df, 'DAV_SKOR', out, prefix='DAV', add_med=False)
    _trend_delta(df, 'DAV_SKOR', out, prefix='DAV')
    if 'DAV_AVG_L12M' in out and 'DAV_STD_L12M' in out:
        out['DAV_CV_12M'] = pd.Series(
            _sdiv(out['DAV_STD_L12M'], out['DAV_AVG_L12M']),
            index=df.index, copy=False)
        out['DAV_RANGE_12M'] = out['DAV_MAX_L12M'] - out['DAV_MIN_L12M']
    return out


# ------------------------------------------------------------------------------
# MMS_* (eski aile, 16 feature). Kaynak: MMS_LM..L12M. Yön ayarında artış = kötü.
# Değerler: 8, 7, 7, 5, 4, 4, 3, 3, 3, 3, 3, 3 (LM'den geriye).
#
#   MMS_AVG_L3M, MMS_AVG_L6M, MMS_AVG_L12M
#     Nasıl : Penceredeki dolu ayların ortalaması.
#     Anlamı: Dönemin ortalama MMS değeri.
#     Örnek : L3M: (8+7+7)/3 = 7.33; L6M: 35/6 = 5.83; L12M: 53/12 = 4.42.
#
#   MMS_STD_L3M, MMS_STD_L6M, MMS_STD_L12M
#     Nasıl : Standart sapma (n-1).
#     Anlamı: Oynaklık.
#     Örnek : L3M: 0.58; L6M: 1.72; L12M: 1.88.
#
#   MMS_MIN_L3M, MMS_MIN_L6M, MMS_MIN_L12M
#     Nasıl : Penceredeki en düşük değer.
#     Anlamı: Dönemin en iyi MMS değeri.
#     Örnek : L3M: 7; L6M: 4; L12M: 3.
#
#   MMS_MAX_L3M, MMS_MAX_L6M, MMS_MAX_L12M
#     Nasıl : Penceredeki en yüksek değer.
#     Anlamı: Dönemin en kötü MMS değeri.
#     Örnek : L3M, L6M, L12M: 8 (LM).
#
#   MMS_TREND_3_46
#     Nasıl : Son 3 ay ortalaması - L4M..L6M ortalaması.
#     Anlamı: Pozitif = MMS artmış (kötü).
#     Örnek : 7.33 - (5+4+4)/3 = 7.33 - 4.33 = +3.0.
#
#   MMS_TREND_6_712
#     Nasıl : Son 6 ay ortalaması - L7M..L12M ortalaması.
#     Anlamı: Pozitif = son yarım yıl öncekinden kötü.
#     Örnek : 5.83 - 3 = +2.83.
#
#   MMS_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayki değişim; pozitif = kötüleşme.
#     Örnek : 8 - 7 = +1.
#
#   MMS_CV_12M
#     Nasıl : MMS_STD_L12M / MMS_AVG_L12M; ortalama 0 / boşsa -99.
#     Anlamı: Ortalamaya göre oynaklık.
#     Örnek : 1.88 / 4.42 = 0.43.
# ------------------------------------------------------------------------------
def _mms_features(df):
    out = {}
    _summ(df, 'MMS', out, add_med=False)
    _trend_delta(df, 'MMS', out)
    if 'MMS_AVG_L12M' in out and 'MMS_STD_L12M' in out:
        out['MMS_CV_12M'] = pd.Series(
            _sdiv(out['MMS_STD_L12M'], out['MMS_AVG_L12M']),
            index=df.index, copy=False)
    return out


# ------------------------------------------------------------------------------
# Hazır pencere kolonlarından oranlar (eski aile, 8 feature). Ham kolon yoksa üretilmez.
# Geçersiz bölme -99. Örnek müşterinin bu kolonlardaki değerleri:
# TAUM_TUT_AVG_3M 20000, TAUM_TUT_AVG_4_6M 30000, TAUM_TUT_AVG_6M 25000,
# SM_AKB_TAUM_TUT_AVG_L3M 5000, BRY_KK_TOPLAM_ODEME_ORANI_L3M 15, _L6M 35,
# INT_SDM_BSVR_ADT_L3M 2, _L6M 5, INT_SDM_A_EKOD_LM 3, _L3M 1, INT_SHM_A_EKOD_LM 0, _L3M 2.
#
#   TAUM_TREND_3_46
#     Nasıl : TAUM_TUT_AVG_3M - TAUM_TUT_AVG_4_6M.
#     Anlamı: Varlık (TAUM) son 3 ayda önceki 3 aya göre ne kadar değişti; negatif = azalma.
#     Örnek : 20000 - 30000 = -10000.
#
#   TAUM_RATIO_3_6
#     Nasıl : TAUM_TUT_AVG_3M / TAUM_TUT_AVG_6M.
#     Anlamı: 1'in altı = son 3 ay ortalaması 6 aylık ortalamanın altında (varlık azalıyor).
#     Örnek : 20000 / 25000 = 0.8.
#
#   AKB_TAUM_ORAN
#     Nasıl : SM_AKB_TAUM_TUT_AVG_L3M / TAUM_TUT_AVG_3M.
#     Anlamı: SM_AKB kaleminin toplam varlık içindeki payı.
#     Örnek : 5000 / 20000 = 0.25.
#
#   ODEME_TREND
#     Nasıl : BRY_KK_TOPLAM_ODEME_ORANI_L3M - BRY_KK_TOPLAM_ODEME_ORANI_L6M.
#     Anlamı: Toplam kart ödeme oranı son 3 ayda 6 aylık değere göre kaç puan değişti; negatif =
#             düşüş.
#     Örnek : 15 - 35 = -20.
#
#   ODEME_AVG
#     Nasıl : (BRY_KK_TOPLAM_ODEME_ORANI_L3M + _L6M) / 2.
#     Anlamı: İki pencerenin ortalama ödeme oranı.
#     Örnek : (15 + 35) / 2 = 25.
#
#   BSVR_RATIO_3_6
#     Nasıl : INT_SDM_BSVR_ADT_L3M / INT_SDM_BSVR_ADT_L6M.
#     Anlamı: 6 aylık değerin ne kadarının son 3 ayda oluştuğu (pencereler kümülatif adetse).
#     Örnek : 2 / 5 = 0.4.
#
#   SDM_EKOD_DELTA
#     Nasıl : INT_SDM_A_EKOD_LM - INT_SDM_A_EKOD_L3M.
#     Anlamı: Kolonun LM ile L3M arasındaki farkı.
#     Örnek : 3 - 1 = +2.
#
#   SHM_EKOD_DELTA
#     Nasıl : INT_SHM_A_EKOD_LM - INT_SHM_A_EKOD_L3M.
#     Anlamı: Kolonun LM ile L3M arasındaki farkı.
#     Örnek : 0 - 2 = -2.
# ------------------------------------------------------------------------------
def _ratio_features(df):
    out = {}

    def _var(*cols):
        return set(cols).issubset(df.columns)

    def v(c):
        return _sayi(df, c)

    if _var('TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_4_6M'):
        out['TAUM_TREND_3_46'] = v('TAUM_TUT_AVG_3M') - v('TAUM_TUT_AVG_4_6M')
    if _var('TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_6M'):
        out['TAUM_RATIO_3_6'] = _sdiv(v('TAUM_TUT_AVG_3M'), v('TAUM_TUT_AVG_6M'))
    if _var('SM_AKB_TAUM_TUT_AVG_L3M', 'TAUM_TUT_AVG_3M'):
        out['AKB_TAUM_ORAN'] = _sdiv(v('SM_AKB_TAUM_TUT_AVG_L3M'), v('TAUM_TUT_AVG_3M'))
    if _var('BRY_KK_TOPLAM_ODEME_ORANI_L3M', 'BRY_KK_TOPLAM_ODEME_ORANI_L6M'):
        o3, o6 = v('BRY_KK_TOPLAM_ODEME_ORANI_L3M'), v('BRY_KK_TOPLAM_ODEME_ORANI_L6M')
        out['ODEME_TREND'] = o3 - o6
        out['ODEME_AVG'] = (o3 + o6) / 2
    if _var('INT_SDM_BSVR_ADT_L3M', 'INT_SDM_BSVR_ADT_L6M'):
        out['BSVR_RATIO_3_6'] = _sdiv(v('INT_SDM_BSVR_ADT_L3M'), v('INT_SDM_BSVR_ADT_L6M'))
    if _var('INT_SDM_A_EKOD_LM', 'INT_SDM_A_EKOD_L3M'):
        out['SDM_EKOD_DELTA'] = v('INT_SDM_A_EKOD_LM') - v('INT_SDM_A_EKOD_L3M')
    if _var('INT_SHM_A_EKOD_LM', 'INT_SHM_A_EKOD_L3M'):
        out['SHM_EKOD_DELTA'] = v('INT_SHM_A_EKOD_LM') - v('INT_SHM_A_EKOD_L3M')
    return out


# ------------------------------------------------------------------------------
# KKB_SKOR_* (eski aile, 35 feature). Kaynak: KKB_SKOR_LM..L12M. Skor 0 ise "sorgu yok"
# sayılır ve hesaba girmez. Yüksek = iyi. Pencereler: L3M, L6M, L12M, L4_6M = L4M..L6M,
# L6_9M = L6M..L9M. Değerler: 1150, 1180, 1250, 1300, 1350, 1380, 1400, 1400, 1410, 1400,
# 1420, 1410 (LM'den geriye).
#
#   KKB_SKOR_AVG_L3M, KKB_SKOR_AVG_L6M, KKB_SKOR_AVG_L12M, KKB_SKOR_AVG_L4_6M,
#   KKB_SKOR_AVG_L6_9M
#     Nasıl : Penceredeki geçerli (0 ve boş dışı) skorların ortalaması.
#     Anlamı: Dönemin ortalama KKB skoru.
#     Örnek : L3M: (1150+1180+1250)/3 = 1193.3; L6M: 1268.3; L12M: 1337.5; L4_6M:
#             (1300+1350+1380)/3 = 1343.3; L6_9M: (1380+1400+1400+1410)/4 = 1397.5.
#
#   KKB_SKOR_STD_L3M, KKB_SKOR_STD_L6M, KKB_SKOR_STD_L12M, KKB_SKOR_STD_L4_6M,
#   KKB_SKOR_STD_L6_9M
#     Nasıl : Standart sapma (n-1); tek geçerli ay varsa 0.
#     Anlamı: Skorun oynaklığı.
#     Örnek : L3M 51.3; L6M 92.0; L12M 95.4; L4_6M 40.4; L6_9M 12.6.
#
#   KKB_SKOR_MIN_L3M, KKB_SKOR_MIN_L6M, KKB_SKOR_MIN_L12M, KKB_SKOR_MIN_L4_6M,
#   KKB_SKOR_MIN_L6_9M
#     Nasıl : Penceredeki en düşük skor.
#     Anlamı: Dönemin en kötü skoru.
#     Örnek : L3M, L6M, L12M 1150; L4_6M 1300; L6_9M 1380.
#
#   KKB_SKOR_MAX_L3M, KKB_SKOR_MAX_L6M, KKB_SKOR_MAX_L12M, KKB_SKOR_MAX_L4_6M,
#   KKB_SKOR_MAX_L6_9M
#     Nasıl : Penceredeki en yüksek skor.
#     Anlamı: Dönemin en iyi skoru.
#     Örnek : L3M 1250; L6M 1380; L12M 1420; L4_6M 1380; L6_9M 1410.
#
#   KKB_SKOR_MED_L3M, KKB_SKOR_MED_L6M, KKB_SKOR_MED_L12M, KKB_SKOR_MED_L4_6M,
#   KKB_SKOR_MED_L6_9M
#     Nasıl : Penceredeki skorların medyanı.
#     Anlamı: Tipik skor.
#     Örnek : L3M 1180; L6M (1250+1300)/2 = 1275; L12M (1380+1400)/2 = 1390; L4_6M 1350; L6_9M
#             1400.
#
#   KKB_SKOR_TREND_3_46
#     Nasıl : KKB_SKOR_AVG_L3M - KKB_SKOR_AVG_L4_6M.
#     Anlamı: Negatif = skor son 3 ayda önceki 3 aya göre düşmüş.
#     Örnek : 1193.3 - 1343.3 = -150.
#
#   KKB_SKOR_TREND_6_79
#     Nasıl : KKB_SKOR_AVG_L6M - L7M..L9M ortalaması.
#     Anlamı: Negatif = son yarım yıl önceki çeyreğe göre düşük.
#     Örnek : 1268.3 - (1400+1400+1410)/3 = 1268.3 - 1403.3 = -135.
#
#   KKB_SKOR_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayki değişim.
#     Örnek : 1150 - 1180 = -30.
#
#   KKB_SKOR_DELTA_PCT_1_2
#     Nasıl : (LM - L2M) / L2M; L2M yoksa -99.
#     Anlamı: Son ayki göreli değişim.
#     Örnek : -30 / 1180 = -0.025 (%2.5 düşüş).
#
#   KKB_SKOR_DELTA_1_3
#     Nasıl : LM - L3M.
#     Anlamı: Son iki aydaki toplam değişim.
#     Örnek : 1150 - 1250 = -100.
#
#   KKB_SKOR_LM_BELOW_AVG12_FLG
#     Nasıl : LM < KKB_SKOR_AVG_L12M ise 1; biri yoksa NaN.
#     Anlamı: Bugünkü skor müşterinin 12 aylık ortalamasının altında mı.
#     Örnek : 1150 < 1337.5 → 1.
#
#   KKB_SKOR_VALID_CNT_L12M, KKB_SKOR_ZERO_CNT_L12M, KKB_SKOR_NULL_CNT_L12M
#     Nasıl : 12 ayda geçerli skor olan ay / skoru tam 0 olan ay / boş ay sayısı.
#     Anlamı: Skor geçmişinin ne kadar dolu olduğu; ZERO çok = sık sık sorgu yok.
#     Örnek : 12 ayın hepsinde skor var → 12 / 0 / 0.
#
#   KKB_SKOR_EVER_QUERIED_FLG
#     Nasıl : KKB_SKOR_VALID_CNT_L12M > 0 ise 1.
#     Anlamı: 12 ayda en az bir geçerli KKB skoru var mı.
#     Örnek : 12 > 0 → 1.
# ------------------------------------------------------------------------------
def _kkb_features(df):
    """KKB skor lag serilerinden ozet / trend / degisim feature'lari."""
    base = 'KKB_SKOR'
    months = _fe_ayarlar()['AYLAR_12']
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return {}

    out = {}
    idx = df.index

    pos = {c: j for j, c in enumerate(cols)}
    R = _sayi_mat(df, cols)

    raw_nan = np.isnan(R)
    V = np.where(raw_nan | (R == 0), np.nan, R)
    ok = ~np.isnan(V)

    def _idx(keys):
        """Pencerede fiilen var olan kolonlarin matris indeksleri."""
        return [pos[f'{base}_{k}'] for k in keys if f'{base}_{k}' in pos]

    def _stats(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        empty = cnt == 0
        safe = np.maximum(cnt, 1)
        tot = np.where(ok[:, j], s, 0.0).sum(axis=1)
        avg = tot / safe
        avg[empty] = np.nan
        ss = np.sort(s, axis=1)
        c2 = cnt[:, None]
        lo = np.take_along_axis(ss, np.maximum(c2 - 1, 0) // 2, 1)[:, 0]
        hi = np.take_along_axis(ss, np.maximum(c2, 1) // 2, 1)[:, 0]
        med = (lo + hi) * 0.5
        mn = ss[:, 0].copy()
        mx = np.take_along_axis(ss, np.maximum(c2 - 1, 0), 1)[:, 0]
        med[empty] = np.nan
        mx[empty] = np.nan
        dev = np.where(ok[:, j], s - avg[:, None], 0.0)
        std = np.sqrt(np.einsum('ij,ij->i', dev, dev) / np.maximum(cnt - 1, 1))
        std[np.isnan(std)] = 0.0
        std[cnt <= 1] = 0.0
        return avg, std, mn, mx, med

    def _mean(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        m = np.where(ok[:, j], s, 0.0).sum(axis=1) / np.maximum(cnt, 1)
        m[cnt == 0] = np.nan
        return m

    windows = {
        '3M':   ['LM', 'L2M', 'L3M'],
        '6M':   ['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'],
        '12M':  months,
        '4_6M': ['L4M', 'L5M', 'L6M'],
        '6_9M': ['L6M', 'L7M', 'L8M', 'L9M'],
    }

    for tag, keys in windows.items():
        j = _idx(keys)
        if not j:
            continue
        avg, std, mn, mx, med = _stats(j)
        out[f'{base}_AVG_L{tag}'] = pd.Series(avg, index=idx, copy=False)
        out[f'{base}_STD_L{tag}'] = pd.Series(std, index=idx, copy=False)
        out[f'{base}_MIN_L{tag}'] = pd.Series(mn, index=idx, copy=False)
        out[f'{base}_MAX_L{tag}'] = pd.Series(mx, index=idx, copy=False)
        out[f'{base}_MED_L{tag}'] = pd.Series(med, index=idx, copy=False)

    j3, j46 = _idx(['LM', 'L2M', 'L3M']), _idx(['L4M', 'L5M', 'L6M'])
    j6 = _idx(['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'])
    j79 = _idx(['L7M', 'L8M', 'L9M'])
    if j3 and j46:
        out[f'{base}_TREND_3_46'] = pd.Series(_mean(j3) - _mean(j46),
                                              index=idx, copy=False)
    if j6 and j79:
        out[f'{base}_TREND_6_79'] = pd.Series(_mean(j6) - _mean(j79),
                                              index=idx, copy=False)

    lm, l2, l3 = f'{base}_LM', f'{base}_L2M', f'{base}_L3M'
    if lm in pos and l2 in pos:
        d = V[:, pos[lm]] - V[:, pos[l2]]
        out[f'{base}_DELTA_1_2'] = pd.Series(d, index=idx, copy=False)
        out[f'{base}_DELTA_PCT_1_2'] = _sdiv(d, V[:, pos[l2]])
    if lm in pos and l3 in pos:
        d13 = V[:, pos[lm]] - V[:, pos[l3]]
        out[f'{base}_DELTA_1_3'] = pd.Series(d13, index=idx, copy=False)

    if f'{base}_AVG_L12M' in out and lm in pos:
        lm_v = V[:, pos[lm]]
        avg12 = out[f'{base}_AVG_L12M'].to_numpy(dtype="float64")
        flg = np.where(np.isnan(lm_v) | np.isnan(avg12), np.nan,
                       (lm_v < avg12).astype("float64"))
        out[f'{base}_LM_BELOW_AVG12_FLG'] = pd.Series(flg, index=idx, copy=False)

    out[f'{base}_VALID_CNT_L12M'] = pd.Series(ok.sum(axis=1), index=idx, copy=False)
    out[f'{base}_ZERO_CNT_L12M'] = pd.Series((R == 0).sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_NULL_CNT_L12M'] = pd.Series(raw_nan.sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_EVER_QUERIED_FLG'] = (out[f'{base}_VALID_CNT_L12M'] > 0).astype(int)
    return out


def _oran_nan(a, b):
    """a / b; b <= 0 veya NaN ise NaN (sentinel YOK)."""
    a = np.asarray(a, dtype='float64')
    b = np.asarray(b, dtype='float64')
    gecerli = np.isfinite(a) & np.isfinite(b) & (b > 0)
    return np.where(gecerli, a / np.where(gecerli, b, 1.0), np.nan)


# ------------------------------------------------------------------------------
# KK_LIMIT_*, KK_RISK_*, KK_LKO_* (eski aile, 78 feature). KK_LIMIT = kart limiti, KK_RISK =
# kart borcu, KK_LKO = kullanım = KK_RISK / KK_LIMIT (limit <= 0 veya boşsa NaN).
# Örnek: limit LM..L3M 8000, L4M..L12M 10000; borç 7600, 7800, 7500, 7000, 6000, 5000, 4000,
# 3500, 3000, 2500, 0, 0; kullanım 0.95, 0.975, 0.94, 0.70, 0.60, 0.50, 0.40 ... 0, 0.
#
#   KK_LKO_LM, KK_LKO_L2M, KK_LKO_L3M, KK_LKO_L4M, KK_LKO_L5M, KK_LKO_L6M, KK_LKO_L7M,
#   KK_LKO_L8M, KK_LKO_L9M, KK_LKO_L10M, KK_LKO_L11M, KK_LKO_L12M
#     Nasıl : Her ay için KK_RISK_<ay> / KK_LIMIT_<ay>.
#     Anlamı: O ay limitin ne kadarı kullanılmış. 1 = limit dolu, 1 üstü = limit aşılmış.
#     Örnek : LM: 7600 / 8000 = 0.95; L4M: 7000 / 10000 = 0.70; L11M: 0 / 10000 = 0.
#
#   KK_LIMIT_AVG_L3M, KK_LIMIT_AVG_L6M, KK_LIMIT_AVG_L12M; KK_RISK_AVG_L3M, KK_RISK_AVG_L6M,
#   KK_RISK_AVG_L12M; KK_LKO_AVG_L3M, KK_LKO_AVG_L6M, KK_LKO_AVG_L12M
#     Nasıl : Penceredeki dolu ayların ortalaması.
#     Anlamı: Dönemin ortalama limiti / borcu / kullanımı.
#     Örnek : Limit 8000 / 9000 / 9500; borç 7633 / 6817 / 4492; kullanım 0.954 / 0.777 / 0.497.
#
#   KK_LIMIT_STD_L3M, KK_LIMIT_STD_L6M, KK_LIMIT_STD_L12M; KK_RISK_STD_L3M, KK_RISK_STD_L6M,
#   KK_RISK_STD_L12M; KK_LKO_STD_L3M, KK_LKO_STD_L6M, KK_LKO_STD_L12M
#     Nasıl : Standart sapma (n-1).
#     Anlamı: Dönem içindeki oynaklık.
#     Örnek : Limit 0 / 1095 / 905; borç 153 / 1100 / 2800; kullanım 0.019 / 0.204 / 0.344.
#
#   KK_LIMIT_MIN_L3M, KK_LIMIT_MIN_L6M, KK_LIMIT_MIN_L12M; KK_RISK_MIN_L3M, KK_RISK_MIN_L6M,
#   KK_RISK_MIN_L12M; KK_LKO_MIN_L3M, KK_LKO_MIN_L6M, KK_LKO_MIN_L12M
#     Nasıl : Penceredeki en küçük değer.
#     Anlamı: Dönemin en düşük limiti / borcu / kullanımı.
#     Örnek : Limit 8000 / 8000 / 8000; borç 7500 / 5000 / 0; kullanım 0.94 / 0.50 / 0.
#
#   KK_LIMIT_MAX_L3M, KK_LIMIT_MAX_L6M, KK_LIMIT_MAX_L12M; KK_RISK_MAX_L3M, KK_RISK_MAX_L6M,
#   KK_RISK_MAX_L12M; KK_LKO_MAX_L3M, KK_LKO_MAX_L6M, KK_LKO_MAX_L12M
#     Nasıl : Penceredeki en büyük değer.
#     Anlamı: Dönemin en yüksek limiti / borcu / kullanımı.
#     Örnek : Limit 8000 / 10000 / 10000; borç 7800 / 7800 / 7800; kullanım 0.975 / 0.975 /
#             0.975.
#
#   KK_LIMIT_MED_L3M, KK_LIMIT_MED_L6M, KK_LIMIT_MED_L12M; KK_RISK_MED_L3M, KK_RISK_MED_L6M,
#   KK_RISK_MED_L12M; KK_LKO_MED_L3M, KK_LKO_MED_L6M, KK_LKO_MED_L12M
#     Nasıl : Penceredeki değerlerin medyanı.
#     Anlamı: Tipik değer.
#     Örnek : Limit 8000 / 9000 / 10000; borç 7600 / 7250 / 4500; kullanım 0.95 / 0.82 / 0.45.
#
#   KK_LIMIT_TREND_3_46, KK_RISK_TREND_3_46, KK_LKO_TREND_3_46
#     Nasıl : Son 3 ay ortalaması - L4M..L6M ortalaması.
#     Anlamı: Pozitif = son 3 ayda artmış (borç ve kullanımda kötü, limitte iyi).
#     Örnek : Limit 8000 - 10000 = -2000; borç 7633 - 6000 = +1633; kullanım 0.954 - 0.60 =
#             +0.354.
#
#   KK_LIMIT_TREND_6_712, KK_RISK_TREND_6_712, KK_LKO_TREND_6_712
#     Nasıl : Son 6 ay ortalaması - L7M..L12M ortalaması.
#     Anlamı: Pozitif = son yarım yıl öncekinden yüksek.
#     Örnek : Limit 9000 - 10000 = -1000; borç 6817 - 2167 = +4650; kullanım 0.777 - 0.217 =
#             +0.560.
#
#   KK_LIMIT_DELTA_1_2, KK_RISK_DELTA_1_2, KK_LKO_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayki değişim.
#     Örnek : Limit 0; borç 7600 - 7800 = -200; kullanım 0.95 - 0.975 = -0.025.
#
#   KK_LIMIT_DELTA_PCT_LM_L2M, KK_RISK_DELTA_PCT_LM_L2M, KK_LKO_DELTA_PCT_LM_L2M
#     Nasıl : (LM - L2M) / L2M; L2M 0 / boşsa -99.
#     Anlamı: Son ayki göreli değişim.
#     Örnek : Limit 0; borç -200 / 7800 = -0.026; kullanım -0.025 / 0.975 = -0.026.
#
#   KK_LIMIT_INC_LM_L2M_FLG, KK_RISK_INC_LM_L2M_FLG, KK_LKO_INC_LM_L2M_FLG
#     Nasıl : LM > L2M ise 1; iki aydan biri boşsa NaN.
#     Anlamı: Son ayda arttı mı.
#     Örnek : Limit 8000 = 8000 → 0; borç 7600 < 7800 → 0; kullanım 0.95 < 0.975 → 0.
#
#   KK_LIMIT_DEC_LM_L2M_FLG, KK_RISK_DEC_LM_L2M_FLG, KK_LKO_DEC_LM_L2M_FLG
#     Nasıl : LM < L2M ise 1; iki aydan biri boşsa NaN.
#     Anlamı: Son ayda azaldı mı.
#     Örnek : Limit 0, borç 1 (7600 < 7800), kullanım 1.
#
#   KK_LIMIT_LM_TO_AVG_L3M, KK_RISK_LM_TO_AVG_L3M, KK_LKO_LM_TO_AVG_L3M
#     Nasıl : LM / son 3 ay ortalaması; payda 0 / boşsa -99.
#     Anlamı: Bugünkü değer son 3 ayın ortalamasına göre; 1 üstü = ortalamanın üstünde.
#     Örnek : Limit 8000 / 8000 = 1; borç 7600 / 7633 = 0.996; kullanım 0.95 / 0.954 = 0.996.
# ------------------------------------------------------------------------------
def _kk_features(df):
    """KK limit / risk / limit-kullanim-orani (LKO) ozetleri."""
    out = {}
    months = _fe_ayarlar()['AYLAR_12']

    for m in months:
        lim, rsk = f'KK_LIMIT_{m}', f'KK_RISK_{m}'
        if lim in df.columns and rsk in df.columns:
            out[f'KK_LKO_{m}'] = pd.Series(_oran_nan(_sayi(df, rsk), _sayi(df, lim)), index=df.index)
    lko = pd.DataFrame(out, index=df.index)

    _summ(df, 'KK_LIMIT', out, add_med=True)
    _summ(df, 'KK_RISK', out, add_med=True)
    _summ(lko, 'KK_LKO', out, add_med=True)

    _trend_delta(df, 'KK_LIMIT', out)
    _trend_delta(df, 'KK_RISK', out)
    _trend_delta(lko, 'KK_LKO', out)

    for base, data in (('KK_LIMIT', df), ('KK_RISK', df), ('KK_LKO', lko)):
        lm, l2 = f'{base}_LM', f'{base}_L2M'
        if lm not in data.columns:
            continue
        a = _sayi(data, lm)
        if l2 in data.columns:
            b = _sayi(data, l2)
            out[f'{base}_DELTA_PCT_LM_L2M'] = _sdiv(a - b, b)
            tam = ~(np.isnan(a) | np.isnan(b))
            out[f'{base}_INC_LM_L2M_FLG'] = pd.Series(np.where(tam, a > b, np.nan), index=df.index)
            out[f'{base}_DEC_LM_L2M_FLG'] = pd.Series(np.where(tam, a < b, np.nan), index=df.index)
        w3 = _exist(data, _window(base)['w3'])
        if w3:
            out[f'{base}_LM_TO_AVG_L3M'] = _sdiv(a, _ort(_sayi_mat(data, w3), 0, len(w3)))
    return out


# ------------------------------------------------------------------------------
# ODM_* (eski aile, 26 feature). Kaynak: KK_ODEME_ORANI_LM..L12M = kart ödemesi / ekstre, yüzde.
# Düşük ödeme < %20, tam ödeme >= %100 (_fe_ayarlar). Oran 0-1 ölçeğinde görünürse uyarı basılır.
# Değerler: 25, 10, 10, 15, 30, 50, 60, 80, 100, 100, 100, 100 (LM'den geriye).
#
#   ODM_AVG_L3M, ODM_AVG_L6M, ODM_AVG_L12M
#     Nasıl : Penceredeki dolu ayların ortalaması.
#     Anlamı: Dönemin ortalama ödeme oranı.
#     Örnek : L3M: (25+10+10)/3 = 15; L6M: 140/6 = 23.3; L12M: 680/12 = 56.7.
#
#   ODM_STD_L3M, ODM_STD_L6M, ODM_STD_L12M
#     Nasıl : Standart sapma (n-1).
#     Anlamı: Ödeme davranışının oynaklığı.
#     Örnek : L3M 8.7; L6M 15.4; L12M 38.0.
#
#   ODM_MIN_L3M, ODM_MIN_L6M, ODM_MIN_L12M
#     Nasıl : Penceredeki en düşük ödeme oranı.
#     Anlamı: Dönemin en kötü ödemesi.
#     Örnek : L3M, L6M, L12M: 10.
#
#   ODM_MAX_L3M, ODM_MAX_L6M, ODM_MAX_L12M
#     Nasıl : Penceredeki en yüksek ödeme oranı.
#     Anlamı: Dönemin en iyi ödemesi.
#     Örnek : L3M 25; L6M 50; L12M 100.
#
#   ODM_MED_L3M, ODM_MED_L6M, ODM_MED_L12M
#     Nasıl : Medyan.
#     Anlamı: Tipik ödeme oranı.
#     Örnek : L3M 10; L6M (15+25)/2 = 20; L12M (50+60)/2 = 55.
#
#   ODM_TREND_3_46
#     Nasıl : Son 3 ay ortalaması - L4M..L6M ortalaması.
#     Anlamı: Negatif = ödeme son 3 ayda düşmüş.
#     Örnek : 15 - (15+30+50)/3 = 15 - 31.7 = -16.7.
#
#   ODM_TREND_6_712
#     Nasıl : Son 6 ay ortalaması - L7M..L12M ortalaması.
#     Anlamı: Negatif = son yarım yıl öncekinden az ödeme.
#     Örnek : 23.3 - 540/6 = 23.3 - 90 = -66.7.
#
#   ODM_DELTA_1_2
#     Nasıl : LM - L2M.
#     Anlamı: Son ayki değişim.
#     Örnek : 25 - 10 = +15.
#
#   ODM_CV_12M
#     Nasıl : ODM_STD_L12M / ODM_AVG_L12M; ortalama 0 / boşsa -99.
#     Anlamı: Ortalamaya göre oynaklık.
#     Örnek : 38.0 / 56.7 = 0.67.
#
#   ODM_LOW_CNT_L12M
#     Nasıl : 12 ayda ödeme oranı %20'nin altında olan ay sayısı.
#     Anlamı: Düşük ödeme sıklığı.
#     Örnek : L2M 10, L3M 10, L4M 15 → 3.
#
#   ODM_FULL_CNT_L12M
#     Nasıl : 12 ayda ödeme oranı %100 ve üstü olan ay sayısı.
#     Anlamı: Tam ödeme sıklığı.
#     Örnek : L9M..L12M → 4.
#
#   ODM_LOW_RATIO_L12M
#     Nasıl : ODM_LOW_CNT_L12M / dolu ay sayısı.
#     Anlamı: Ödeme yapılan ayların ne kadarı düşük.
#     Örnek : 3 / 12 = 0.25.
#
#   ODM_LOW_IN_L3M
#     Nasıl : Son 3 ayda en az bir ay < %20 ise 1; üç ay da boşsa NaN.
#     Anlamı: Son 3 ayda düşük ödeme oldu mu.
#     Örnek : L2M 10 → 1.
#
#   ODM_LM_BELOW_AVG
#     Nasıl : LM < ODM_AVG_L12M ise 1; biri yoksa NaN.
#     Anlamı: Bu ayki ödeme müşterinin 12 aylık ortalamasının altında mı.
#     Örnek : 25 < 56.7 → 1.
#
#   ODM_LM_TO_AVG_L12M
#     Nasıl : LM / ODM_AVG_L12M; payda 0 / boşsa -99.
#     Anlamı: Bu ayki ödeme 12 aylık ortalamanın kaç katı.
#     Örnek : 25 / 56.7 = 0.44.
#
#   ODM_DECLINING_3M
#     Nasıl : LM < L2M < L3M ise 1; biri boşsa NaN.
#     Anlamı: Ödeme oranı üst üste iki ay düştü mü.
#     Örnek : 25 < 10 değil → 0.
# ------------------------------------------------------------------------------
def _odeme_features(df):
    """KK odeme orani (paid/statement) davranis ozetleri."""
    out = {}
    base = 'KK_ODEME_ORANI'
    months = _fe_ayarlar()['AYLAR_12']
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return out

    A = _fe_ayarlar()
    dusuk, tam_esik = A['ODM_DUSUK'], A['ODM_TAM']
    idx = df.index
    S = _sayi_mat(df, cols)
    ok = ~np.isnan(S)
    gecerli = ok.sum(axis=1)

    if not getattr(_odeme_features, '_olcek_uyarisi', False) and ok.any():
        _q99 = float(np.nanquantile(S[ok], 0.99))
        if _q99 <= 1.5:
            print(f'  ⚠ KK_ODEME_ORANI 99. yuzdelik={_q99:.3f}: 0-1 olcegi olabilir; '
                  f'ODM_LOW (<{dusuk}) ve ODM_FULL (>={tam_esik}) esikleri yuzde varsayar.')
        _odeme_features._olcek_uyarisi = True

    _summ(df, base, out, prefix='ODM', add_med=True)
    _trend_delta(df, base, out, prefix='ODM')

    if 'ODM_AVG_L12M' in out and 'ODM_STD_L12M' in out:
        out['ODM_CV_12M'] = pd.Series(
            _sdiv(out['ODM_STD_L12M'], out['ODM_AVG_L12M']),
            index=idx, copy=False)

    out['ODM_LOW_CNT_L12M'] = pd.Series((S < dusuk).sum(axis=1), index=idx, copy=False)
    out['ODM_FULL_CNT_L12M'] = pd.Series((S >= tam_esik).sum(axis=1), index=idx, copy=False)
    out['ODM_LOW_RATIO_L12M'] = pd.Series(
        np.where(gecerli > 0, (S < dusuk).sum(axis=1) / np.maximum(gecerli, 1), np.nan),
        index=idx)

    r3 = _exist(df, [f'{base}_LM', f'{base}_L2M', f'{base}_L3M'])
    if r3:
        j = [cols.index(c) for c in r3]
        olculdu = ok[:, j].any(axis=1)
        out['ODM_LOW_IN_L3M'] = pd.Series(
            np.where(olculdu, (S[:, j] < dusuk).any(axis=1), np.nan), index=idx)

    if 'ODM_AVG_L12M' in out and f'{base}_LM' in df.columns:
        lm_v = _sayi(df, f'{base}_LM')
        avg = np.asarray(out['ODM_AVG_L12M'], dtype='float64')
        out['ODM_LM_BELOW_AVG'] = pd.Series(
            np.where(np.isnan(lm_v) | np.isnan(avg), np.nan, lm_v < avg), index=idx)
        out['ODM_LM_TO_AVG_L12M'] = _sdiv(lm_v, avg)

    if {f'{base}_LM', f'{base}_L2M', f'{base}_L3M'}.issubset(df.columns):
        a, b, c = (_sayi(df, f'{base}_{k}') for k in ('LM', 'L2M', 'L3M'))
        tam = ~(np.isnan(a) | np.isnan(b) | np.isnan(c))
        out['ODM_DECLINING_3M'] = pd.Series(np.where(tam, (a < b) & (b < c), np.nan), index=idx)
    return out


def _seri_matrisi(df, base, sifir_gecersiz=False):
    """[LM, L2M, ..., L12M] matrisi; eksik ay kolonu NaN. Hic kolon yoksa None."""
    cols = [f'{base}_{m}' for m in _fe_ayarlar()['AYLAR_12']]
    if not any(c in df.columns for c in cols):
        return None
    M = np.full((len(df), len(cols)), np.nan)
    for j, c in enumerate(cols):
        if c in df.columns:
            M[:, j] = _sayi(df, c)
    if sifir_gecersiz:
        M[M == 0] = np.nan
    return M


def _ilk_true(mask):
    """Her satirda EN YENI True'nun sutun indeksi (= kac ay once); yoksa NaN."""
    var = mask.any(axis=1)
    i = mask.argmax(axis=1).astype('float64')
    i[~var] = np.nan
    return i


def _son_true(mask):
    """Her satirda EN ESKI True'nun sutun indeksi; yoksa NaN."""
    var = mask.any(axis=1)
    i = (mask.shape[1] - 1 - mask[:, ::-1].argmax(axis=1)).astype('float64')
    i[~var] = np.nan
    return i


def _seri_simdi(mask):
    """En yeni aydan geriye kesintisiz True sayisi."""
    return np.cumprod(mask, axis=1).sum(axis=1)


def _son_donem_sure(mask):
    """En yeni True aydan geriye (eskiye) kesintisiz True sayisi: son donemin uzunlugu; True yoksa 0."""
    T = mask.shape[1]
    i = np.nan_to_num(_ilk_true(mask), nan=T).astype(int)
    once = np.arange(T)[None, :] < i[:, None]
    return (np.cumprod(np.where(once, True, mask), axis=1).astype(bool) & ~once).sum(axis=1)


def _en_uzun_seri(mask):
    """Penceredeki en uzun kesintisiz True dizisi."""
    cur = np.zeros(mask.shape[0])
    best = np.zeros(mask.shape[0])
    for j in range(mask.shape[1]):
        cur = np.where(mask[:, j], cur + 1, 0.0)
        best = np.maximum(best, cur)
    return best


def _hareketler(M):
    """d[:, t] = M[:, t] - M[:, t+1]  (yeni - eski, t ay onceki gecis)."""
    yeni, eski = M[:, :-1], M[:, 1:]
    pair = np.isfinite(yeni) & np.isfinite(eski)
    d = np.where(pair, yeni - eski, 0.0)
    return d, pair


def _ort(M, a, b):
    Y = M[:, a:b]
    ok = np.isfinite(Y)
    n = ok.sum(axis=1)
    m = np.where(ok, Y, 0.0).sum(axis=1) / np.maximum(n, 1)
    m[n == 0] = np.nan
    return m


def _egim(M, W, min_n=3):
    """Ilk W ay icin OLS egimi (birim: aylik degisim). Pozitif = zamanla artis."""
    Y = M[:, :W]
    ok = np.isfinite(Y)
    x = -np.arange(Y.shape[1], dtype='float64')[None, :]
    n = ok.sum(axis=1)
    nn = np.maximum(n, 1)
    xm = np.where(ok, x, 0.0).sum(axis=1) / nn
    ym = np.where(ok, Y, 0.0).sum(axis=1) / nn
    dx = np.where(ok, x - xm[:, None], 0.0)
    dy = np.where(ok, Y - ym[:, None], 0.0)
    sxx = (dx * dx).sum(axis=1)
    sxy = (dx * dy).sum(axis=1)
    return np.where((n >= min_n) & (sxx > 0), sxy / np.where(sxx > 0, sxx, 1.0), np.nan)


def _yon_degisim(d, pair):
    """Sifir olmayan hareketler dizisinde yonun kac kez tersine dondugu."""
    s = np.where(pair, np.sign(d), 0.0)
    son = np.zeros(s.shape[0])
    cnt = np.zeros(s.shape[0])
    for j in range(s.shape[1] - 1, -1, -1):
        cur = s[:, j]
        cnt += (cur != 0) & (son != 0) & (cur != son)
        son = np.where(cur != 0, cur, son)
    return cnt


def _son_iki_hareket(d, pair):
    """En yeni ve bir onceki SIFIR OLMAYAN hareketin isareti / buyuklugu / zamani."""
    nz = pair & (d != 0)
    sira = np.cumsum(nz, axis=1)
    i1 = _ilk_true(nz)
    i2 = _ilk_true(nz & (sira == 2))
    ar = np.arange(d.shape[0])

    def _al(i, arr):
        ok = np.isfinite(i)
        ii = np.where(ok, i, 0).astype(int)
        return np.where(ok, arr[ar, ii], 0.0)

    return (_al(i1, np.sign(d)), _al(i2, np.sign(d)), i1, _al(i1, np.abs(d)))


def _float_ciktilar(out, idx, bos_satir=None):
    """dict -> float32 Series; hic gecerli gozlemi olmayan satirlar NaN."""
    res = {}
    for k, v in out.items():
        a = np.asarray(v, dtype='float64')
        if bos_satir is not None and not k.endswith('_GECERLI_AY'):
            a = np.where(bos_satir, np.nan, a)
        res[k] = pd.Series(a.astype(_fe_ayarlar()['YENI_FEATURE_DTYPE']), index=idx)
    return res


