_SURE = {'ad': None, 't': 0.0, 'dk': {}}


def _adim(ad=None):
    """Onceki adimin suresini yazar, yeni adimi baslatir (ad=None: bitir)."""
    t = time.time()
    if _SURE['ad'] is not None:
        _SURE['dk'][_SURE['ad']] = _SURE['dk'].get(_SURE['ad'], 0.0) + (t - _SURE['t']) / 60
    _SURE['ad'], _SURE['t'] = ad, t


def _desen_dagilim(train, val, oot, cols):
    satir = []
    for c in cols:
        r = {'feature': c}
        for ad, fr in (('train', train), ('val', val), ('oot', oot)):
            v = pd.to_numeric(fr[c], errors='coerce')
            r[f'{ad}_ort'], r[f'{ad}_std'] = float(v.mean()), float(v.std())
        satir.append(r)
    return pd.DataFrame(satir)


# --- PAKETLE SKORLAMA: canlıda ham veriden skor (eğitimle aynı yol) ----------
def renk_goc_skorla(df_raw, paket, fe_fn=None, renk_kontrol=True):
    """Ham satirlardan model paketiyle skor uretir (canli skorlama ile egitimin ayni yolu).

    df_raw: paket['required_raw_features'] kolonlarini iceren ham veri.
    fe_fn : egitimde kullanilan feature_engineering fonksiyonu (varsayilan: global).
    renk_kontrol: df_raw'da RENK varsa, tum satirlar paketin renginde olmali.
    """
    fe_fn = fe_fn or globals()['feature_engineering']
    if renk_kontrol:
        if 'RENK' not in df_raw.columns:
            raise KeyError("Renk kontrolu icin df_raw'da RENK kolonu gerekli (renk_kontrol=False ile kapatilabilir).")
        yanlis = int((pd.to_numeric(df_raw['RENK'], errors='coerce') != paket['renk_kod']).sum())
        if yanlis:
            raise ValueError(f"{yanlis:,} satir {paket['etiket']} modelinin renginde degil.")
    raw = list(paket['required_raw_features'])
    eksik = [c for c in raw if c not in df_raw.columns]
    if eksik:
        raise KeyError(f'Skorlama icin eksik ham kolon: {eksik[:10]}')
    X = df_raw.loc[:, raw]
    eng, _ = fe_fn(X)
    yeni = [c for c in paket['engineered_features'] if c in eng.columns and c not in raw]
    frame = pd.concat([X, eng.loc[:, yeni]], axis=1)
    for c in raw:
        if c in eng.columns and not eng[c].equals(X[c]):
            frame[c] = eng[c]
    schema = paket['preprocess_schema']
    if schema.get('mode') != 'train_fitted_native':
        raise NotImplementedError('Yalnizca train_fitted_native preprocess skorlanabilir.')
    feats = list(paket['features'])
    desen = paket.get('desen_kodlama') or {}
    ds_kolon = desen.get('kolonlar', {})
    kolonlar = {}
    for c in feats:
        if c in ds_kolon:
            continue
        if c in schema['categorical']:
            kolonlar[c] = _kat_metin(frame[c]).astype(
                pd.CategoricalDtype(categories=schema['categorical'][c]))
        else:
            kolonlar[c] = pd.to_numeric(frame[c], errors='coerce')
    ds_cols = [c for c in feats if c in ds_kolon]
    if ds_cols:
        anahtar = _desen_anahtarlari(frame)
        for c in ds_cols:
            ad, tur = ds_kolon[c]
            dolgu = desen['haritalar'][ad]['nadir_oran'] if tur == 'oran' else 0.0
            kolonlar[c] = pd.Series(
                anahtar[ad].map(desen['haritalar'][ad][tur]).fillna(dolgu).to_numpy(dtype='float64'),
                index=frame.index)
    sonuc = pd.DataFrame(kolonlar, index=frame.index)
    return pd.Series(paket['model'].predict_proba(sonuc[feats])[:, 1], index=frame.index)


# ==============================================================================
# DESEN KODLAMASI (DSN_*): PIPELINE'DA ÜRETİLEN TEK FEATURE AİLESİ (10 feature)
# Hedef (TARGET) hiçbir adımda kullanılmaz. FE hücresindeki feature'lardan farkı: değer
# satırın kendi geçmişinden değil, train'deki gerçek müşterilerden kurulan bir tablodan
# okunur. Bu yüzden FE'de değil burada, train / val ayrımından sonra üretilir; tablo
# yalnızca train'den kurulur ve model paketine yazılır ('desen_kodlama').
# Örnek müşteri FE hücresindeki müşteridir: renk LM'den geriye 2, 1, 1, 3, 4, 4, 5 ...;
# kullanım 0.95, 0.975, 0.94, 0.70 ...; ödeme oranı %25, %10, %10, %15 ...
#
# ADIM 1: DESEN. Her müşteri için kendi aylarından 5 desen anahtarı.
#   RENK3
#     Nasıl : LM, L2M, L3M renk kodları '|' ile birleştirilir; 0 = inaktif, X = boş.
#     Örnek : 2, 1, 1 → '2|1|1'
#
#   RENK_HAREKET5
#     Nasıl : LM..L6M arasındaki 5 geçiş, yeniden eskiye: renk yükseldiyse '+', düştüyse
#             '-', aynıysa '0', iki aydan biri boş / inaktifse 'X'.
#     Örnek : L2M → LM 1 → 2 '+', L3M → L2M 1 → 1 '0', L4M → L3M 3 → 1 '-',
#             L5M → L4M 4 → 3 '-', L6M → L5M 4 → 4 '0' → '+|0|-|-|0'
#
#   KKU3
#     Nasıl : LM, L2M, L3M kart kullanımı (KK_RISK / KK_LIMIT) dilime çevrilir:
#             a < 0.3, b 0.3-0.8, c 0.8-0.9, d >= 0.9, X boş.
#     Örnek : 0.95, 0.975, 0.94 → 'd|d|d'
#
#   ODM3
#     Nasıl : LM, L2M, L3M ödeme oranı dilime çevrilir: a < %20, b %20-100, c >= %100, X boş.
#     Örnek : 25, 10, 10 → 'b|a|a'
#
#   RENK_KKU_ODM_LM
#     Nasıl : LM rengi | LM kullanım dilimi | LM ödeme dilimi.
#     Örnek : 2, d, b → '2|d|b'
#
# ADIM 2: TABLO. Yalnızca train.
#   Nasıl : Her train müşterisi için desen bir ay geriden çıkarılır (aynı kurallar LM yerine
#           L2M'den başlar: RENK3 = L2M|L3M|L4M gibi) ve yanına sonucu yazılır: LM rengi
#           L2M'den kötü mü (1 / 0). LM veya L2M'de rengi aktif olmayan müşteri tabloya
#           girmez. Desen başına: oran = sonucu 1 olan müşteri / desendeki müşteri;
#           pay = desendeki müşteri / tablodaki tüm müşteri.
#   Örnek : Örnek müşterinin tablodaki satırı: RENK3 '1|1|3', RENK_HAREKET5 '0|-|-|0|-',
#           KKU3 'd|d|b', ODM3 'a|a|a', RENK_KKU_ODM_LM '1|d|a'; sonuç: LM 2, L2M 1,
#           renk kötüleşmedi → 0.
#
#   Nadir desen
#     Nasıl : DESEN_MIN_N (100)'den az müşterisi olan desenler tek bir "nadir" grupta
#             birleşir; hepsinin oranı bu grubun gerçek oranıdır (gruptaki 1'ler / gruptaki
#             müşteri). Payları kendi gerçek paylarıdır. Hiç nadir desen yoksa nadir oran
#             tüm tablonun oranıdır.
#     Örnek : A deseni 4.000 müşteri, 1.200'ü kötüleşmiş → 0.30. B 40 müşteri (10 kötüleşme)
#             ve C 60 müşteri (15 kötüleşme) 100'den az → nadir grup (10 + 15) / (40 + 60)
#             = 0.25; B de C de 0.25 alır (sayılar örnek).
#   Uydurma ya da rastgele gözlem eklenmez; her sayı train'deki gerçek müşterilerden.
#
# ADIM 3: UYGULAMA. Train, val, OOT ve canlı skorlamada müşterinin bugünkü deseni
#   (ADIM 1, LM'den başlayarak) tabloda aranır. Train'de hiç görülmemiş desen:
#   oran = nadir oran, pay = 0.
#
# FEATURE'LAR
#   DSN_RENK3_KOT_ORAN, DSN_RENK_HAREKET5_KOT_ORAN, DSN_KKU3_KOT_ORAN, DSN_ODM3_KOT_ORAN,
#   DSN_RENK_KKU_ODM_LM_KOT_ORAN
#     Nasıl : Müşterinin bugünkü desenine karşılık gelen tablodaki oran.
#     Anlamı: "Geçmişte bu desende olan müşterilerin yüzde kaçının rengi bir sonraki ay
#             kötüleşti." Yüksek = bu desen genelde renk düşüşüyle devam ediyor.
#     Örnek : Bugünkü RENK3 '2|1|1'; tabloda '2|1|1' deseni 4.000 müşteri, 1.200 kötüleşme
#             → DSN_RENK3_KOT_ORAN = 1.200 / 4.000 = 0.30 (sayılar örnek).
#
#   DSN_RENK3_PAY, DSN_RENK_HAREKET5_PAY, DSN_KKU3_PAY, DSN_ODM3_PAY, DSN_RENK_KKU_ODM_LM_PAY
#     Nasıl : Müşterinin bugünkü deseninin tablodaki payı; görülmemişse 0.
#     Anlamı: Desen ne kadar yaygın. Küçük pay = az görülen desen, oranı az gözleme dayanır;
#             model oranı payla birlikte okuyabilir.
#     Örnek : '2|1|1' deseni 4.000 müşteri, tablo 400.000 müşteri → 4.000 / 400.000 = 0.01
#             (sayılar örnek).
#
# Hedefle ilişkisi: tablonun sonucu LM'deki renk değişimidir; model hedefi (TARGET) hiç
# kullanılmaz. Desen ve sonuç model tarihinden önce bilinen aylardan.
# ==============================================================================
def _desen_num(frame, c):
    if c not in frame.columns:
        return np.full(len(frame), np.nan)
    return pd.to_numeric(frame[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)


def _desen_bin(v, sinirlar, etiketler):
    out = np.full(len(v), 'X', dtype=object)
    ok = np.isfinite(v)
    out[ok] = np.asarray(etiketler, dtype=object)[np.digitize(v[ok], sinirlar)]
    return out


def _desen_birlestir(parcalar):
    res = parcalar[0].astype(str)
    for p in parcalar[1:]:
        res = np.char.add(np.char.add(res, '|'), p.astype(str))
    return res


_DESEN_AYLAR = ['LM'] + [f'L{i}M' for i in range(2, 13)]


def _desen_anahtarlari(frame, kaydir=0):
    """Satir bazli desen anahtarlari (renk, kullanim, odeme).

    kaydir=0: guncel desen (LM ve oncesi). kaydir=1: bir ay onceki desen
    (L2M ve oncesi); tablo kurulurken sonucu LM olan desen olarak kullanilir."""
    aylar = _DESEN_AYLAR[kaydir:kaydir + 6]
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != 'INAKTIF']
    R = np.column_stack([_desen_num(frame, f'RENK_{m}') for m in aylar])
    Rk = np.where(np.isin(R, aktif) | (R == 0), R, np.nan)
    renk_str = np.where(np.isfinite(Rk), np.nan_to_num(Rk).astype(int).astype(str), 'X')
    anahtar = {'RENK3': _desen_birlestir([renk_str[:, j] for j in range(3)])}

    Ra = np.where(np.isin(R, aktif), R, np.nan)
    hareket = []
    for j in range(5):
        a, b = Ra[:, j], Ra[:, j + 1]
        ok = np.isfinite(a) & np.isfinite(b)
        h = np.where(a < b, '-', np.where(a > b, '+', '0'))
        hareket.append(np.where(ok, h, 'X'))
    anahtar['RENK_HAREKET5'] = _desen_birlestir(hareket)

    U = []
    for m in aylar[:3]:
        lim, rsk = _desen_num(frame, f'KK_LIMIT_{m}'), _desen_num(frame, f'KK_RISK_{m}')
        ok = np.isfinite(lim) & np.isfinite(rsk) & (lim > 0)
        U.append(np.where(ok, rsk / np.where(ok, lim, 1.0), np.nan))
    kku = [_desen_bin(u, [0.3, 0.8, 0.9], ['a', 'b', 'c', 'd']) for u in U]
    odm = [_desen_bin(_desen_num(frame, f'KK_ODEME_ORANI_{m}'), [20, 100], ['a', 'b', 'c'])
           for m in aylar[:3]]
    anahtar['KKU3'] = _desen_birlestir(kku)
    anahtar['ODM3'] = _desen_birlestir(odm)
    anahtar['RENK_KKU_ODM_LM'] = _desen_birlestir([renk_str[:, 0], kku[0], odm[0]])
    return {k: pd.Series(v, index=frame.index) for k, v in anahtar.items()}


def _desen_harita(k, y):
    """Desen basina gercek oran ve musteri sayisi; DESEN_MIN_N'den az gozlemli desenler
    tek 'nadir' grupta birlesir ve o grubun gercek oranini alir. (oran, sayi, nadir_oran)"""
    g = pd.DataFrame({'k': k.to_numpy(), 'y': np.asarray(y, dtype='float64')}).groupby('k')['y'].agg(['sum', 'count'])
    az = g['count'] < DESEN_MIN_N
    kaynak = g.loc[az] if az.any() else g
    nadir_oran = float(kaynak['sum'].sum() / kaynak['count'].sum())
    oran = (g['sum'] / g['count']).where(~az, nadir_oran)
    return oran, g['count'], nadir_oran


def _lm_kotulesme(frame):
    """LM'de renk L2M'ye gore kotulesti mi (kucuk kod = kotu); iki ay da aktif degilse NaN."""
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != 'INAKTIF']
    a, b = _desen_num(frame, 'RENK_LM'), _desen_num(frame, 'RENK_L2M')
    ok = np.isin(a, aktif) & np.isin(b, aktif)
    return np.where(ok, (a < b).astype('float64'), np.nan)


def _desen_kodla(train, val, oot):
    """Hedefsiz desen kodlamasi: tablo train'den, sonuc LM renk kotulesmesi. (yeni_kolonlar, paket)"""
    k_fit = _desen_anahtarlari(train, kaydir=1)
    y = _lm_kotulesme(train)
    ok = np.isfinite(y)
    if not ok.any():
        return [], None
    genel_oran = float(y[ok].mean())
    guncel = [(fr, _desen_anahtarlari(fr)) for fr in (train, val, oot)]
    yeni = []
    paket = {'genel_oran': genel_oran, 'min_n': DESEN_MIN_N, 'sonuc': 'LM renk kotulesmesi (L2M ile)',
             'n_tablo': int(ok.sum()), 'haritalar': {}, 'kolonlar': {}}
    for ad, k in k_fit.items():
        o, n, nadir_oran = _desen_harita(k[ok], y[ok])
        pay = n / int(ok.sum())
        c_o, c_p = f'DSN_{ad}_KOT_ORAN', f'DSN_{ad}_PAY'
        for fr, anahtar in guncel:
            fr[c_o] = anahtar[ad].map(o).fillna(nadir_oran).to_numpy()
            fr[c_p] = anahtar[ad].map(pay).fillna(0).to_numpy()
        yeni += [c_o, c_p]
        paket['haritalar'][ad] = {'oran': o.to_dict(), 'pay': pay.to_dict(), 'nadir_oran': nadir_oran}
        paket['kolonlar'][c_o] = (ad, 'oran')
        paket['kolonlar'][c_p] = (ad, 'pay')
    return yeni, paket


