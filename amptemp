        t = pd.DataFrame({"MBB_NO": pd.to_numeric(t["mbb_no"], errors="coerce"),
                          "DONEM": pd.to_numeric(t["donem"], errors="coerce"),
                          "HDF": pd.to_numeric(t.get("target_actual"), errors="coerce"),
                          "SKOR": pd.to_numeric(t["target_score"], errors="coerce")})
        t = t.dropna(subset=["MBB_NO", "DONEM", "SKOR"])
        n_dup = int(t.duplicated(["MBB_NO", "DONEM"]).sum())
        t = t.drop_duplicates(["MBB_NO", "DONEM"], keep="first").reset_index(drop=True)
        t["GRUP"] = _kt_grupla(t["SKOR"].to_numpy())
        t["RENK"] = kod
