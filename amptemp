def _gt_yol(klasor, dosya=''):
    k = '/' + str(klasor).strip('/')
    return k + ('/' + str(dosya).lstrip('/') if dosya else '')


def _gt_yol_detay(yol):
    try:
        d = mf.get_path_details(_gt_yol(yol))
    except Exception:
        return None
    if not isinstance(d, dict) or d.get('exists') is False:
        return None
    return d


def _gt_dosya_var(yol):
    d = _gt_yol_detay(yol)
    return bool(d) and not bool(d.get('directory', False))


def _gt_dosya_adi(m, RENK_KOD, renk_adi, ek):
    return f"{MODELLER[m]['onek']}renk_{RENK_KOD}_{renk_adi}_{ek}"


def _gt_bayt_oku(klasor, dosya):
    with mf.get_download_stream(_gt_yol(klasor, dosya)) as s:
        return s.read()


def _gt_paket_oku(m, RENK_KOD, renk_adi):
    """Rengin model paketini (pipeline'ın model.pkl'i) okur; dosya yoksa None."""
    ad = _gt_dosya_adi(m, RENK_KOD, renk_adi, 'model.pkl')
    if not _gt_dosya_var(_gt_yol(MODELLER[m]['klasor'], ad)):
        return None
    ham = _gt_bayt_oku(MODELLER[m]['klasor'], ad)
    # Model başka bir scikit-learn sürümünde kaydedildiyse sklearn "Trying to unpickle
    # estimator ..." uyarısı verir (LGBMClassifier içindeki LabelEncoder için; yalnızca
    # 0/1 sınıf etiketlerini tutar). Sadece bu uyarı, sadece burada kapatılır. Sürüm farkı
    # KAYNAK_KONTROL'de yazılır; skora etkisi aynı sheet'teki MAKS SKOR FARKI ile ölçülür.
    with warnings.catch_warnings():
        warnings.filterwarnings('ignore', message=r'Trying to unpickle estimator')
        return pickle.loads(ham)


def _gt_surum_metni(paket):
    """Modelin eğitildiği sürüm → bu kernel (lightgbm / sklearn)."""
    s = paket.get('surumler') or {}
    egitim = f"lightgbm {s.get('lightgbm', '?')} / sklearn {s.get('sklearn', '?')}"
    kernel = f"lightgbm {lightgbm.__version__} / sklearn {sklearn.__version__}"
    return egitim if egitim == kernel else f"{egitim} → bu kernel: {kernel}"


def _gt_kayit_oku(m, RENK_KOD, renk_adi):
    """Modelin tam skor dosyası (train + val + oot), TRAIN ve OOT dönemi.
    index = MBB_NO|DONEM anahtarı; çift anahtar eşleşmez, atılır. Dosya yoksa (None, 0)."""
    ad = _gt_dosya_adi(m, RENK_KOD, renk_adi, 'musteri_skorlari.csv')
    if not _gt_dosya_var(_gt_yol(MODELLER[m]['klasor'], ad)):
        return None, 0
    ham = _gt_bayt_oku(MODELLER[m]['klasor'], ad)
    k = pd.read_csv(BytesIO(ham), usecols=['mbb_no', 'donem', 'target_actual', 'target_score'],
                    dtype={'mbb_no': str})
    del ham
    k['donem'] = pd.to_numeric(k['donem'], errors='coerce')
    k = k.loc[k['donem'].isin([ANALIZ_TRAIN_DONEM, ANALIZ_OOT_DONEM])]
    k.index = pd.Index(_gt_anahtar(k['mbb_no'], k['donem']))
    cift = k.index.duplicated(keep=False)
    return k.loc[~cift], int(cift.sum())


def _gt_id_metin(s):
    """MBB_NO'yu karşılaştırılabilir metne çevirir. Sayıya çevrilebilen değer tam sayı
    metnine döner ('000123', '123', 123, 123.0 → '123'); df ve df_raw'da kolon tipi farklı
    olsa da (metin / sayı) iki taraf aynı anahtarı üretir. Sayı olmayan değer metin kalır."""
    t = pd.Series(s).astype(str).str.strip().str.replace(r'\.0+$', '', regex=True)
    v = pd.to_numeric(t, errors='coerce')
    ok = v.notna().to_numpy()
    out = t.to_numpy(dtype=object)
    out[ok] = v[ok].astype('int64').astype(str).to_numpy(dtype=object)
    return pd.Series(out, index=t.index)


def _gt_renk_kod(s):
    """RENK etiketi ('1-Kırmızı') veya kodu (1) → sayısal kod (float, boş = NaN)."""
    if pd.api.types.is_numeric_dtype(s):
        return pd.to_numeric(s, errors='coerce').astype('float64')
    return pd.to_numeric(s.astype(str).str.split('-').str[0].str.strip(),
                         errors='coerce').astype('float64')


def _gt_anahtar(mbb, donem):
    d = pd.to_numeric(pd.Series(donem), errors='coerce').astype('Int64').astype(str)
    return _gt_id_metin(mbb).to_numpy(dtype=object) + '|' + d.to_numpy(dtype=object)


def _gt_anahtar_haritasi(tablo):
    """Tablonun TRAIN / OOT satırları: anahtar -> satır sırası (iloc). Tekrar eden anahtarın
    ilki alınır; tekrar sayısı da döner."""
    d = pd.to_numeric(tablo['DONEM'], errors='coerce')
    m = d.isin([ANALIZ_TRAIN_DONEM, ANALIZ_OOT_DONEM]).to_numpy()
    poz = np.flatnonzero(m)
    a = pd.Index(_gt_anahtar(tablo[ID_COL].to_numpy()[m], d.to_numpy()[m]))
    tekrar = a.duplicated(keep='first')
    return pd.Series(poz[~tekrar], index=a[~tekrar]), int(tekrar.sum())


def _gt_donusum_ogren(kolonlar):
    """df_raw kolonlarını df biçimine çevirme kuralı, iki tabloda birlikte bulunan
    müşteri-dönemlerden öğrenilir:
      - iki tarafta değerler aynıysa kolon olduğu gibi alınır,
      - df_raw değeri df'te hep aynı değere karşılık geliyorsa (ör. '1-Kırmızı' -> 1)
        bu eşleme tablosu kullanılır,
      - ikisi de değilse kolon 'eşlenemeyen' sayılır.
    Kural sonra model.pkl skoru kayıtlı skorla karşılaştırılarak doğrulanır."""
    if _GT_DF is None:
        return {}, [], 0
    ortak = _GT_DF_HARITA.index.intersection(_GT_HAM_HARITA.index)
    if len(ortak) == 0:
        return {}, list(kolonlar), 0
    rs = np.random.RandomState(KONTROL_TOHUM)
    ornek = ortak[np.sort(rs.choice(len(ortak), min(DONUSUM_ORNEK_N, len(ortak)), replace=False))]
    D = _GT_DF.iloc[_GT_DF_HARITA.loc[ornek].to_numpy()]
    H = _GT_HAM.iloc[_GT_HAM_HARITA.loc[ornek].to_numpy()]
    donusum, sorunlu = {}, []
    for c in kolonlar:
        if c not in D.columns or c not in H.columns:
            sorunlu.append(c)
            continue
        d, h = D[c].reset_index(drop=True), H[c].reset_index(drop=True)
        dn, hn = pd.to_numeric(d, errors='coerce'), pd.to_numeric(h, errors='coerce')
        d_say = int(d.notna().sum()) == int(dn.notna().sum())
        h_say = int(h.notna().sum()) == int(hn.notna().sum())
        if d_say and h_say:
            esit = (dn.isna() & hn.isna()) | np.isclose(dn.to_numpy(dtype='float64'),
                                                         hn.to_numpy(dtype='float64'),
                                                         rtol=1e-12, atol=0.0)
            if bool(esit.all()):
                continue
            sorunlu.append(c)
            continue
        if not d_say and not h_say:
            ayni = (d.isna() == h.isna()) & ((d.astype(str) == h.astype(str)) | d.isna())
            if bool(ayni.all()):
                continue
        hs = h.astype(str).where(h.notna(), '<NA>')
        g = pd.DataFrame({'h': hs, 'd': d}).drop_duplicates()
        if g['h'].duplicated().any() or g['h'].nunique() > 5000:
            sorunlu.append(c)
            continue
        donusum[c] = dict(zip(g['h'], g['d']))
    return donusum, sorunlu, len(ornek)


def _gt_ham_satirlar(raw_idx, kolonlar, zorla_ham=False):
    """İstenen satırların (df_raw index etiketi) ham kolonları, df biçiminde.
    Müşteri-dönem df'te varsa df'ten alınır; yoksa (ya da zorla_ham) df_raw'dan alınıp
    öğrenilen kuralla çevrilir. Dönen: (çerçeve, satır df_raw'dan mı geldi (bool dizi),
    eşleme tablosunda olmayan değer sayısı)."""
    raw_idx = pd.Index(raw_idx)
    anahtar = _gt_taban.loc[raw_idx, '_anahtar'].to_numpy()
    if _GT_DF is not None and not zorla_ham:
        dpoz = _GT_DF_HARITA.reindex(anahtar).to_numpy()
    else:
        dpoz = np.full(len(raw_idx), np.nan)
    df_den = ~np.isnan(dpoz.astype('float64'))
    parca = []
    if df_den.any():
        Xd = _GT_DF.iloc[dpoz[df_den].astype('int64')][kolonlar].copy()
        Xd.index = raw_idx[df_den]
        parca.append(Xd)
    bilinmeyen = 0
    if (~df_den).any():
        Xh = _GT_HAM.loc[raw_idx[~df_den], kolonlar].copy()
        for c, harita in _GT_DONUSUM.items():
            if c in Xh.columns:
                hs = Xh[c].astype(str).where(Xh[c].notna(), '<NA>')
                bilinmeyen += int((~hs.isin(list(harita.keys()))).sum())
                Xh[c] = hs.map(harita)
        parca.append(Xh)
    X = pd.concat(parca).loc[raw_idx] if len(parca) > 1 else parca[0]
    return X, ~df_den, bilinmeyen


# ------------------------------------------------------------------------------
# MODEL.PKL İLE SKORLAMA: pipeline'daki renk_goc_skorla ile aynı adımlar.
# Pipeline hücresi bu kernelde çalışmamış olsa da kullanılabilsin diye burada.
# ------------------------------------------------------------------------------
def _gt_kat_metin(s):
    """Kategori değerlerini metne çevirir; 1 ve 1.0 aynı metin ('1') olur."""
    if pd.api.types.is_numeric_dtype(s.dtype) and not pd.api.types.is_bool_dtype(s.dtype):
        v = pd.to_numeric(s, errors='coerce').astype('float64')
        out = v.astype('string')
        tam = v.notna() & np.isfinite(v) & (v == np.round(v)) & (v.abs() < 2 ** 53)
        out[tam] = v[tam].astype('int64').astype('string')
        return out
    return s.astype('string')


def _gt_desen_num(frame, c):
    if c not in frame.columns:
        return np.full(len(frame), np.nan)
    return pd.to_numeric(frame[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)


def _gt_desen_bin(v, sinirlar, etiketler):
    out = np.full(len(v), 'X', dtype=object)
    ok = np.isfinite(v)
    out[ok] = np.asarray(etiketler, dtype=object)[np.digitize(v[ok], sinirlar)]
    return out


def _gt_desen_birlestir(parcalar):
    res = parcalar[0].astype(str)
    for p in parcalar[1:]:
        res = np.char.add(np.char.add(res, '|'), p.astype(str))
    return res


def _gt_desen_anahtarlari(frame):
    """Müşterinin bugünkü desen anahtarları (LM'den başlayarak); pipeline ile aynı."""
    aylar = (['LM'] + [f'L{i}M' for i in range(2, 13)])[:6]
    aktif = [k for k, v in COLOR_MAP.items() if str(v).upper() != 'INAKTIF']
    R = np.column_stack([_gt_desen_num(frame, f'RENK_{m}') for m in aylar])
    Rk = np.where(np.isin(R, aktif) | (R == 0), R, np.nan)
    renk_str = np.where(np.isfinite(Rk), np.nan_to_num(Rk).astype(int).astype(str), 'X')
    anahtar = {'RENK3': _gt_desen_birlestir([renk_str[:, j] for j in range(3)])}
    Ra = np.where(np.isin(R, aktif), R, np.nan)
    hareket = []
    for j in range(5):
        a, b = Ra[:, j], Ra[:, j + 1]
        ok = np.isfinite(a) & np.isfinite(b)
        h = np.where(a < b, '-', np.where(a > b, '+', '0'))
        hareket.append(np.where(ok, h, 'X'))
    anahtar['RENK_HAREKET5'] = _gt_desen_birlestir(hareket)
    U = []
    for m in aylar[:3]:
        lim, rsk = _gt_desen_num(frame, f'KK_LIMIT_{m}'), _gt_desen_num(frame, f'KK_RISK_{m}')
        ok = np.isfinite(lim) & np.isfinite(rsk) & (lim > 0)
        U.append(np.where(ok, rsk / np.where(ok, lim, 1.0), np.nan))
    kku = [_gt_desen_bin(u, [0.3, 0.8, 0.9], ['a', 'b', 'c', 'd']) for u in U]
    odm = [_gt_desen_bin(_gt_desen_num(frame, f'KK_ODEME_ORANI_{m}'), [20, 100], ['a', 'b', 'c'])
           for m in aylar[:3]]
    anahtar['KKU3'] = _gt_desen_birlestir(kku)
    anahtar['ODM3'] = _gt_desen_birlestir(odm)
    anahtar['RENK_KKU_ODM_LM'] = _gt_desen_birlestir([renk_str[:, 0], kku[0], odm[0]])
    return {k: pd.Series(v, index=frame.index) for k, v in anahtar.items()}


def _gt_paket_tahmin(X, eng, paket):
    """FE çıktısından paketin feature matrisini kurar ve olasılık döner."""
    raw = list(paket['required_raw_features'])
    yeni = [c for c in paket['engineered_features'] if c in eng.columns and c not in raw]
    frame = pd.concat([X, eng.loc[:, yeni]], axis=1)
    for c in raw:
        if c in eng.columns and not eng[c].equals(X[c]):
            frame[c] = eng[c]
    schema = paket['preprocess_schema']
    if schema.get('mode') != 'train_fitted_native':
        raise NotImplementedError('Yalnizca train_fitted_native preprocess skorlanabilir.')
    feats = list(paket['features'])
    desen = paket.get('desen_kodlama') or {}
    ds_kolon = desen.get('kolonlar', {})
    kolonlar = {}
    for c in feats:
        if c in ds_kolon:
            continue
        if c in schema['categorical']:
            kolonlar[c] = _gt_kat_metin(frame[c]).astype(
                pd.CategoricalDtype(categories=schema['categorical'][c]))
        else:
            kolonlar[c] = pd.to_numeric(frame[c], errors='coerce')
    ds_cols = [c for c in feats if c in ds_kolon]
    if ds_cols:
        anahtar = _gt_desen_anahtarlari(frame)
        for c in ds_cols:
            ad, tur = ds_kolon[c]
            dolgu = desen['haritalar'][ad]['nadir_oran'] if tur == 'oran' else 0.0
            kolonlar[c] = pd.Series(
                anahtar[ad].map(desen['haritalar'][ad][tur]).fillna(dolgu).to_numpy(dtype='float64'),
                index=frame.index)
    sonuc = pd.DataFrame(kolonlar, index=frame.index)
    return paket['model'].predict_proba(sonuc[feats])[:, 1]


def _gt_paketle_skorla(kaynak, idx, paketler):
    """idx satırlarını paketlerle skorlar: {model: Series}. Ham kolon listesi aynı olan
    paketler FE'yi paylaşır; satırlar SKOR_PARCA'lık parçalarla işlenir (FE satır bazlı)."""
    idx = pd.Index(idx)
    sonuc = {m: np.full(len(idx), np.nan) for m in paketler}
    gruplar = {}
    for m, p in paketler.items():
        gruplar.setdefault(frozenset(p['required_raw_features']), []).append(m)
    for bas in range(0, len(idx), SKOR_PARCA):
        ix = idx[bas:bas + SKOR_PARCA]
        for ms in gruplar.values():
            X = kaynak.loc[ix, list(paketler[ms[0]]['required_raw_features'])]
            eng, _ = feature_engineering(X)
            for m in ms:
                sonuc[m][bas:bas + len(ix)] = _gt_paket_tahmin(X, eng, paketler[m])
            del X, eng
        gc.collect()
    return {m: pd.Series(v, index=idx) for m, v in sonuc.items()}


def _gt_bucketle(prob, nb=N_BUCKET):
    """Sıra bazlı eşit bucket; 1 = en riskli (en yüksek skor)."""
    p = np.asarray(prob); n = len(p)
    order = np.argsort(p, kind="stable")
    r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
    return nb - np.searchsorted(edges[1:-1], r, side="left")


def _gt_capture(y, prob, pct):
    """En yüksek skorlu pct dilimin yakaladığı pozitif payı."""
    y = np.asarray(y); n = len(y); tot = y.sum()
    if tot <= 0 or n == 0:
        return np.nan
    k = max(1, int(pct * n))
    top = np.argpartition(-np.asarray(prob), min(k, n - 1))[:k] if n > 1 else np.array([0])
    return float(y[top].sum() / tot)


def _gt_ay_ekle(yyyymm, k):
    y, m = divmod(int(yyyymm), 100)
    m += k; y += (m - 1) // 12; m = (m - 1) % 12 + 1
    return y * 100 + m


def _gt_kirmizi_mi(v):
    """Etiket bazlı güvenli kontrol: '1-Kırmızı', 'KIRMIZI' vb."""
    if pd.isna(v):
        return False
    sv = str(v).strip().lower()
    return ('kırmızı' in sv) or ('kirmizi' in sv)


def _gt_durum(v, esik, buyuk_gecer):
    """Test sonucu: GEÇTİ / KALDI / SINIRDA (eşiğe ±SINIR_BANT) / VERİ YOK."""
    if v is None:
        return 'VERİ YOK', False
    sinirda = abs(v - esik) <= SINIR_BANT * esik
    gecti = (v >= esik) if buyuk_gecer else (v <= esik)
    if sinirda:
        return 'SINIRDA', gecti
    return ('GEÇTİ' if gecti else 'KALDI'), gecti


