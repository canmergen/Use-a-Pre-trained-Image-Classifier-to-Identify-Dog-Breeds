def _stil_kopyala(hedef, kaynak, wrap=False, yatay=None, dikey=None):
    hedef.font = copy(kaynak.font)
    hedef.fill = copy(kaynak.fill)
    hedef.border = copy(kaynak.border) if kaynak.border and kaynak.border.left.style else _kenar_yedek
    hedef.number_format = kaynak.number_format
    al = copy(kaynak.alignment)
    hedef.alignment = Alignment(horizontal=yatay or al.horizontal, vertical=dikey or "top",
                                wrap_text=wrap or al.wrap_text)


def _sheet_yaz(ad, tablo, genislikler, sira):
    if ad in wb.sheetnames:
        sira = wb.sheetnames.index(ad)
        wb.remove(wb[ad])
    ws = wb.create_sheet(ad, sira)
    for j, k in enumerate(tablo.columns, start=1):
        h = ws.cell(row=1, column=j, value=k)
        _stil_kopyala(h, _bas_h, yatay="center", dikey="center")
    for i, row in enumerate(tablo.itertuples(index=False), start=2):
        for j, v in enumerate(row, start=1):
            if isinstance(v, float) and np.isnan(v):
                v = None
            h = ws.cell(row=i, column=j, value=v)
            _stil_kopyala(h, _gov_h, wrap=str(tablo.columns[j - 1]) in ("Açıklamalar", "Anlamı", "Açıklama", "Neden",
                                                                         "Kullanan Klasörler"))
    for j, w in enumerate(genislikler, start=1):
        ws.column_dimensions[ws.cell(row=1, column=j).column_letter].width = w
    ws.freeze_panes = "B2"
    ws.auto_filter.ref = ws.dimensions
    return ws


