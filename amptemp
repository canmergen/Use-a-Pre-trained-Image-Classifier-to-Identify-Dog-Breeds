def _cocuklar(yol):
    det = mf.get_path_details(yol) or {}
    return det.get("children") or []


def _alt_klasorler():
    kl = sorted(c["name"] for c in _cocuklar("/") if c.get("directory"))
    if not kl:
        kl = sorted({p.strip("/").split("/")[0] for p in mf.list_paths_in_partition() if "/" in p.strip("/")})
    return kl


def _dosyalar(klasor):
    ad = [c["name"] for c in _cocuklar("/" + klasor) if not c.get("directory")]
    if not ad:
        on = "/" + klasor + "/"
        ad = [p[len(on):] for p in mf.list_paths_in_partition() if p.startswith(on) and "/" not in p[len(on):]]
    return sorted(ad)


_haric = {h.upper() for h in HARIC_KLASORLER}
_klasorler = [k for k in _alt_klasorler() if k.upper() not in _haric and KLASOR_RE.match(k)]
_kullanim = []
for _kl in _klasorler:
    for _ad in _dosyalar(_kl):
        _m = FEATURE_DOSYA_RE.match(_ad)
        if not _m:
            continue
        with mf.get_download_stream(f"/{_kl}/{_ad}") as s:
            _kf = pd.read_csv(s)
        if "feature" not in _kf.columns:
            continue
        for _f in _kf["feature"].dropna().astype(str):
            _kullanim.append((_f, _kl, f"{_m.group(1)}-{_m.group(2)}"))
_kullanim = pd.DataFrame(_kullanim, columns=["Alan", "KLASOR", "RENK_MODEL"]).drop_duplicates()
_toplam_model = int(_kullanim[["KLASOR", "RENK_MODEL"]].drop_duplicates().shape[0]) if len(_kullanim) else 0
_log(f"{len(_klasorler)} model klasörü | {_toplam_model} renk modeli | {_kullanim['Alan'].nunique():,} tekil feature")


