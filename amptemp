        'skorlama_tutarlilik_max_fark': _tutarlilik,
        'skorlama_dogrulandi': int(_skorlama_ok),
        'skorlama_hata': _tutarlilik_hata,
        'desen_aktif': int(DESEN_AKTIF),
        'sizinti_max_tek_gini': round(_siz_max, 4) if np.isfinite(_siz_max) else None,
        'sizinti_uyari_n': len(_siz_uyari),
        'cikti_etiketi': CIKTI_ETIKETI,
        # Optuna denemeleri aynı val'de seçildi; capture_val iyimser olabilir,
