def _st_tablo(ws, S, r, kolonlar, gruplar, satirlar, tablo_adi, dilim4):
    """Dilimleyici alanı + grup bandı + başlık + satırlar + Excel tablosu → (başlık satırı, son satır, kolon numaraları)."""
    C = {k[4]: 2 + i for i, k in enumerate(kolonlar)}
    r_dilim = r
    r_bant = r + 7 if DILIMLEYICI_EKLE else r
