import dataiku

mf = dataiku.Folder("GOC_MODEL_RESULTS")

FOLDER = "YENI_KLASOR_ADI"   # istediğin adı buraya yaz
PATH = "/" + FOLDER

# Klasör zaten var mı kontrol et
try:
    detay = mf.get_path_details(PATH)
    var_mi = bool(detay.get("exists")) and bool(detay.get("directory"))
except Exception:
    var_mi = False

if var_mi:
    print("Klasör zaten var:", PATH)
else:
    # Yer tutucu dosya yazılır, klasör bununla birlikte oluşur
    mf.upload_data(PATH + "/_klasor_olusturuldu.txt", "placeholder".encode("utf-8"))
    kontrol = mf.get_path_details(PATH)
    print("Oluşturuldu:", PATH, "| exists:", kontrol.get("exists"))
