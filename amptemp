    "DAV": ("davranış skoru", -1, ""), "MMS": ("MMS", +1, ""),
    "KKB": ("KKB skoru", -1, " KKB skoru 0 olan ay boş sayılır."),
    "ODM": ("kart ödeme oranı", -1, ""),
