def _bd_pc_notlari():
    """PredCs sheet'lerinin ortak notları: (PredCs kaynağı ve yönü, dönemlere göre dolu payı)."""
    b = _BD_PC_BILGI
    if _BD_PC_KAYNAK is None:
        pc_metni = (f"PredCs bulunamadı: df'te {PREDCS_KOLON} kolonu yok ve bellekte {PREDCS_KOLON} kolonlu df_baz yok. "
                    "df_baz'ı silmeden (ya da df'e eklerken PredCs'yi de alarak) bu hücreyi yeniden çalıştırın.")
    else:
        pc_metni = ("FPD modelinin müşteriye ürettiği skor (FPD olasılığı); gerçekleşen FPD hedefleri ("
                    + ", ".join(_BD_FPD_ADLAR) + f") aynı modelin gerçekleşen sonuçlarıdır. Kaynak: {_BD_PC_KAYNAK}. "
                    f"Büyük değer = {'riskli' if _BD_PC_YON == 1 else 'iyi (işaret çevrildi)'}.")
        if np.isfinite(b["g_pc"]):
            pc_metni += (f" Kontrol: FPD hedefi ({b['h']}) dolu {_adet(b['n'])} müşteride PredCs Gini "
                         f"{_bd_yzd(b['g_pc'])}")
            if np.isfinite(b["g_f"]):
                pc_metni += (f"; bunların FPD skoru dolu {_adet(b['n_f'])} olanında PredCs {_bd_yzd(b['g_pc_f'])}, "
                             f"FPD skoru {_bd_yzd(b['g_f'])}")
            pc_metni += "."
    don_metni = f"PredCs'nin üretildiği dönemler alındı: {', '.join(map(str, _BD_PC_DONEM)) or 'yok'}."
    if _BD_PC_ALINMAYAN:
        don_metni += (" Diğer dönemlerde PredCs yok sayıldı (ham veride yalnızca küçük bir grupta dolu: "
                      + ", ".join(f"{d} {_bd_yzd(v)}" for d, v in _BD_PC_ALINMAYAN.items()) + ").")
    return pc_metni, don_metni


