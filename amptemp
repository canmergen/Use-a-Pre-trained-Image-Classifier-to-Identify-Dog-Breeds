def _eksen_siniri(degerler, pay=1.15, adim=0.05, ust_sinir=1.0):
    """Değer ekseninin alt / üst sınırı; üstte etiketlerin sığacağı kadar pay bırakır."""
    v = [x for x in degerler if _sonlu(x)]
    if not v:
        return 0.0, 1.0
    alt = min(0.0, float(np.floor(min(v) / adim) * adim))
    ust = float(np.ceil(max(v) * pay / adim) * adim)
    if ust_sinir is not None and max(v) <= ust_sinir:        # Gini ve oranlar 1'i geçmez; eksen %100'de dursun
        ust = min(ust, ust_sinir)
    return alt, max(ust, adim)


def _cubuk_grafik(ws, baslik, seriler, kat_kol, r0, rs, eksen_fmt, etiket_fmt, en, boy, eksen, ust_uste=False):
    """Tablo satırlarına bağlı, değer etiketli yatay çubuk grafik. Seçilmeyen (gizlenen) satırlar çizilmez.
    seriler: [(kolon no, seri adı ya da None = başlık hücresi, renk)]; eksen: (alt, üst) ya da None (otomatik);
    ust_uste: seriler aynı çubuk yerinde (her satırda yalnızca biri dolu olan artı / eksi kolonlar için)."""
    ch = BarChart()
    ch.type = "bar"
    ch.grouping = "clustered"
    ch.gapWidth = 60
    if ust_uste:
        ch.overlap = 100
    ch.title = baslik
    ch.width, ch.height = en, boy
    ch.style = 10
    ch.legend.position = "b"
    ch.y_axis.numFmt = eksen_fmt
    ch.y_axis.majorGridlines = None
    if eksen is not None:                                     # None: Excel görünen verilere göre ölçekler
        ch.y_axis.scaling.min, ch.y_axis.scaling.max = eksen
    ch.x_axis.scaling.orientation = "maxMin"                  # tablodaki sırayla yukarıdan aşağı
    ch.x_axis.tickLblPos = "low"                              # model adları eksi çubukların üstüne binmesin
    ch.y_axis.crosses = "max"                                 # değer ekseni altta kalsın
    for kol, ad, rk in seriler:
        if ad is None:
            s = Series(Reference(ws, min_col=kol, min_row=r0, max_row=rs), title_from_data=True)
        else:
            s = Series(Reference(ws, min_col=kol, min_row=r0 + 1, max_row=rs), title=ad)
        s.graphicalProperties.solidFill = rk
        s.graphicalProperties.line.solidFill = rk
        ch.series.append(s)
    ch.set_categories(Reference(ws, min_col=kat_kol, min_row=r0 + 1, max_row=rs))
    ch.x_axis.tickLblSkip = 1                                 # her modelin adı yazsın
    ch.x_axis.txPr = _yazi(8)
    ch.y_axis.txPr = _yazi(8)
    ch.x_axis.delete = False
    ch.y_axis.delete = False
    ch.dataLabels = DataLabelList()                           # değer etiketleri
    ch.dataLabels.showVal = True
    ch.dataLabels.showSerName = ch.dataLabels.showCatName = False
    ch.dataLabels.showLegendKey = ch.dataLabels.showPercent = False
    ch.dataLabels.position = "outEnd"
    ch.dataLabels.numFmt = etiket_fmt
    ch.dataLabels.txPr = _yazi(7.5)
    ch.visible_cells_only = True
    return ch


def _cm_satir(cm):
    """cm yüksekliğindeki bir grafiğin kapladığı varsayılan satır sayısı (15 pt = 0,53 cm)."""
    return int(np.ceil(cm / 0.53)) + 2


