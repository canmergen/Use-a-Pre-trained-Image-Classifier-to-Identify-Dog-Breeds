# ==============================================================================
# FEATURE ENGINEERING (v6)
# feature_engineering(df) -> (df_eng, yeni_feature_isimleri)
# _window, _exist, _sdiv, _summ, _trend_delta 5. hücreden gelir, burada yeniden
# tanımlanmaz.
#
# NE YAPAR
# Her müşterinin son 12 aylık geçmişinden (renk, DAV, MMS, KKB skoru, kart limit /
# borç / ödeme oranı, INT pencereleri, TAUM, hazır skorlar) özet feature'lar üretir.
# Her değer yalnızca o satırın kendi geçmişinden, sabit kurallarla hesaplanır.
# Hedef (TARGET), başka müşteriler, örneklem ya da veriden öğrenilen bir tablo
# kullanılmaz: target encoding yok. Aynı satır her zaman aynı sonucu verir.
#
# İSİMLENDİRME
# - Aylar: LM = model ayından 1 ay önce (en yeni ay), L2M = 2 ay önce ... L12M.
# - Özetlerde L3M / L6M / L12M = LM dahil son 3 / 6 / 12 ay penceresi;
#   4_6 = L4M..L6M, 7_12 = L7M..L12M.
# - AY_* feature'ları olayın kaç ay geride olduğunu verir: 0 = LM, 1 = L2M,
#   2 = L3M ... 11 = L12M. Olay 12 ayda yoksa NaN. Geçişlerde değer geçişin yeni
#   ayıdır: AY_SON_KOTULESME = 2, rengin L4M'den L3M'e kötüleştiği demektir.
# - _ADET: sayım. _SERI / _SERI_SIMDI: LM'den geriye kesintisiz ay sayısı.
#   _FLG: 0/1 bayrak. _TREND: yakın pencere ortalaması - uzak pencere ortalaması.
# - Renk kodu: küçük = kötü (1 KIRMIZI, 2 TURUNCU, 3 SARI, 4 ACK_YESIL, 5 YESIL,
#   6 KOY_YESIL). 0 = INAKTIF, renk sayılmaz. Risk rengi = KIRMIZI veya TURUNCU.
# - Yön: renk, KKB, DAV ve ödeme oranında düşüş kötü; MMS ve kart kullanımında
#   (KKU = KK_RISK / KK_LIMIT) artış kötü.
#
# EKSİK DEĞER
# Ölçülemeyen değer NaN kalır: ilgili ay boşsa bayrak 0 değil NaN olur, oranlar
# 12'ye değil geçerli ay sayısına bölünür. Eski ailelerde geçersiz bölme -99
# (5. hücre _sdiv); yeni ailelerde NaN. Yeni aileler float32.
# Hücre 8'deki preprocess() bu yüzden kullanılmaz (boşları 0 / -1 yapar).
#
# ÖRNEK MÜŞTERİ: aşağıdaki tüm örnek değerler bu müşteri için kodla hesaplandı.
#                 LM   L2M   L3M   L4M   L5M   L6M   L7M  L8M  L9M L10M L11M L12M
#   RENK           2     1     1     3     4     4     5    5    5    5    5    5
#   KK_LIMIT    8000  8000  8000 10000 10000 10000 10000 (L12M'ye kadar 10000)
#   KK_RISK     7600  7800  7500  7000  6000  5000  4000 3500 3000 2500    0    0
#   KKU (oran)  0.95 0.975  0.94  0.70  0.60  0.50  0.40 0.35 0.30 0.25    0    0
#   ODEME (%)     25    10    10    15    30    50    60   80  100  100  100  100
#   KKB_SKOR    1150  1180  1250  1300  1350  1380  1400 1400 1410 1400 1420 1410
#   DAV_SKOR     400   420   450   500   520   530   540  540  545  540  550  545
#   MMS            8     7     7     5     4     4     3    3    3    3    3    3
# Hikaye: 6 ay YESIL, L6M'den itibaren düşüş, L3M ve L2M'de KIRMIZI, LM'de
# TURUNCU'ya bir basamak toparlanma. Banka L3M'de limiti 10000'den 8000'e indirmiş;
# kullanım %95'e çıkmış; ödeme oranı %100'den %10-25'e düşmüş; KKB ve DAV düşüyor,
# MMS artıyor.
#
# AİLELER (önek, adet, ne ölçer). Ayrıntı ve örnekler her fonksiyonun üstünde.
# Eski hücreden gelen 7 fonksiyon (213 feature, hatalar düzeltildi):
#   RENK_*                        renk ortalama / min / max / trend / sayımlar
#   DAV_*, MMS_*, KKB_SKOR_*, ODM_*  skorların ve ödeme oranının pencere özetleri
#   KK_LIMIT_*, KK_RISK_*, KK_LKO_*  kart limit / borç / kullanım özetleri
#   TAUM_*, AKB_TAUM_ORAN, ODEME_*, BSVR_*, SDM_/SHM_EKOD_DELTA  hazır kolon oranları
# Yeni 11 fonksiyon (274 feature; INT ve DS sayısı veride bulunan kolonlara göre):
#   RENK_Y_*        62  renk geçmişi bir yol olarak (düşüş, seri, giriş / çıkış)
#   <P>_D_*         85  DAV / MMS / KKB / ODM / KKU serilerinin eğim, ivme, seri
#   ESZ_*           15  aynı dönemde kaç gösterge birlikte bozuldu
#   GIZLI_*          6  renk bozulmamışken diğer göstergelerin bozulması
#   INT_*_INTD_*   ~23  INT pencerelerinde yakın / uzak oranı, aktivite durdu mu
#   BV_*             4  kart borcu ve varlık (TAUM) birlikte
#   KK_O_*          20  limit düşüş / artış, kullanım eşikleri, sıfır borç
#   OK_*             7  aynı ayda düşük ödeme + yüksek kullanım
#   YB_*            30  müşteri için yeni başlayan olaylar
#   OG_*            15  son renk düşüşünden önce göstergeler bozulmuş muydu
#   DS_*            ~7  hazır model skorlarının renk yolu ile çarpımları
# Pipeline ayrıca DSN_* (desen kodlaması) ekler; açıklaması pipeline başında.
#
# ESKİ HÜCREYE GÖRE FARKLAR
# - INAKTIF (0) renk ortalama / min / max / risk sayımlarına girmiyor (eskiden 0,
#   kırmızıdan kötü bir renk gibi ortalamayı aşağı çekiyordu).
# - Oranlar geçerli ay sayısına bölünüyor; karşılaştırma bayrakları eksik ayda NaN.
# - KK_LKO limit 0 / boşsa -99 değil NaN; -99'lar LKO özetlerine karışmıyor.
# - KKB_SKOR_CHG_L3M çıkarıldı (KKB_SKOR_DELTA_1_3 ile aynıydı).
# - Aynı isimli bazı kolonların değeri değişti: eski hücreyle eğitilmiş bir model
#   bu FE ile skorlanmamalı, yeniden eğitim gerekir.
# ==============================================================================
"""RENK_GOC_MODEL | Feature engineering (v6). feature_engineering(df) -> (df_eng, yeni_feature_isimleri)."""

import numpy as np
import pandas as pd


def _fe_ayarlar():
    """Feature engineering ayarlari. Tum fonksiyonlar buradan okur."""
    return {
        'AYLAR_12': ['LM'] + [f'L{i}M' for i in range(2, 13)],

        'RENK_RISK_ESIK': 2,

        'SERI_TANIM': {
            'DAV_SKOR':       ('DAV', False),
            'MMS':            ('MMS', False),
            'KKB_SKOR':       ('KKB', True),
            'KK_ODEME_ORANI': ('ODM', False),
        },

        'SERI_YON': {
            'RENK':           +1,
            'KKB_SKOR':       +1,
            'KK_ODEME_ORANI': +1,
            'KK_KULLANIM':    -1,
            'DAV_SKOR':       +1,
            'MMS':            -1,
        },

        'DIS_SKORLAR': ['PRED_BK_12_AY_TOP', 'PRED_BK_12_AY_TOP_PERC', 'PredCs',
                        'EXPECTED_LOSS', 'LTV', 'LTV_WITH_LOSS'],

        'INT_PENCERELER': ('LM', 'L3M', 'L6M', 'L9M', 'L12M'),
        'KKU_ESIKLER': (0.8, 0.9, 1.0),
        'KKU_YUKSEK': 0.8, 'KKU_DUSUK': 0.3,
        'ODM_DUSUK': 20, 'ODM_TAM': 100,
        'YENI_FEATURE_DTYPE': np.float32,
    }


def _sayi(df, c):
    """Kolonu float64 diziye cevirir; metin, bos ve NA -> NaN."""
    return pd.to_numeric(df[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)


def _sayi_mat(df, cols):
    return np.column_stack([_sayi(df, c) for c in cols]) if cols else np.empty((len(df), 0))


def _renk_kodlari():
    """COLOR_MAP'ten (inaktif kod, aktif renk kodlari, kirmizi kodu)."""
    inaktif = [k for k, v in COLOR_MAP.items() if str(v).upper() == 'INAKTIF']
    aktif = sorted(k for k in COLOR_MAP if k not in inaktif)
    if not aktif or str(COLOR_MAP[aktif[0]]).upper() != 'KIRMIZI':
        raise ValueError('COLOR_MAP: aktif renklerin en kucuk kodu KIRMIZI degil; '
                         'renk yonu varsayimi (kucuk kod = kotu) gecersiz.')
    return (inaktif[0] if inaktif else None), np.array(aktif, dtype='float64'), float(aktif[0])


def _renk_aktif_df(df, cols):
    """RENK lag kolonlarinda INAKTIF (0) ve gecersiz kodlar NaN."""
    _, aktif, _ = _renk_kodlari()
    A = _sayi_mat(df, cols)
    return pd.DataFrame(np.where(np.isin(A, aktif), A, np.nan), index=df.index, columns=cols)


# ------------------------------------------------------------------------------
# RENK_* (eski aile). INAKTIF (0) aylar ortalama / min / max / trend dışında.
#   RENK_{AVG,STD,MIN,MAX,MED}_L{3M,6M,12M}  pencere özeti
#       örnek: AVG_L3M = (2+1+1)/3 = 1.33, MIN_L12M = 1, MED_L12M = 4.5
#   RENK_TREND_3_46    son 3 ay ort. - L4M..L6M ort.; negatif = kötüleşme. örnek -2.33
#   RENK_TREND_6_712   son 6 ay ort. - L7M..L12M ort.                     örnek -2.5
#   RENK_DELTA_1_2     LM - L2M (pozitif = iyileşme)                      örnek +1
#   RENK_DELTA_1_3     LM - L3M                                           örnek +1
#   RENK_CNT_<RENK>    12 ayda o renkte geçen ay (her COLOR_MAP kodu için)
#       örnek: KIRMIZI 2, TURUNCU 1, SARI 1, ACK_YESIL 2, YESIL 6
#   RENK_CNT_RISK      KIRMIZI + TURUNCU ay sayısı                        örnek 3
#   RENK_CNT_GOOD      kodu >= 4 olan ay sayısı                           örnek 8
#   RENK_RISK_RATIO    risk ayı / aktif ay                                örnek 3/12 = 0.25
#   RENK_RISK_IN_L3M   son 3 ayda risk rengi var mı (0/1)                 örnek 1
#   RENK_DECLINING     LM < L2M < L3M: üst üste iki kötüleşme             örnek 0
#   RENK_IMPROVING     LM > L2M > L3M: üst üste iki iyileşme              örnek 0
#   RENK_MODE_L12M     12 ayın en sık rengi                               örnek 5
# ------------------------------------------------------------------------------
def _renk_features(df):
    out = {}
    all12 = _exist(df, _window('RENK')['all'])
    r3 = _exist(df, _window('RENK')['w3'])

    if not all12:
        return out

    aktif_df = _renk_aktif_df(df, all12)
    _summ(aktif_df, 'RENK', out, add_med=True)
    _trend_delta(aktif_df, 'RENK', out)
    if {'RENK_LM', 'RENK_L3M'}.issubset(aktif_df.columns):
        out['RENK_DELTA_1_3'] = aktif_df['RENK_LM'] - aktif_df['RENK_L3M']

    idx = df.index
    M = _sayi_mat(df, all12)
    A = aktif_df.to_numpy(dtype="float64", na_value=np.nan)
    gecerli = (~np.isnan(A)).sum(axis=1)

    def _cnt_eq(v):
        """(df[all12] == v).sum(axis=1) ile ayni; NaN == v zaten False."""
        return pd.Series((M == v).sum(axis=1), index=idx)

    def _mode_first():
        """df[all12].mode(axis=1)[0] ile ayni."""
        finite = M[~np.isnan(M)]
        if finite.size == 0:
            return pd.Series(np.full(len(df), np.nan), index=idx)
        uniq = np.unique(finite)
        if uniq.size > 64:
            return pd.DataFrame(M, index=idx).mode(axis=1)[0]
        counts = np.empty((len(df), uniq.size), dtype=np.int8)
        for j, u in enumerate(uniq):
            counts[:, j] = (M == u).sum(axis=1)
        best = counts.argmax(1)
        res = uniq[best]
        res[counts.max(axis=1) == 0] = np.nan
        return pd.Series(res, index=idx)

    for v, n in COLOR_MAP.items():
        out[f'RENK_CNT_{n}'] = _cnt_eq(v)
    out['RENK_CNT_RISK'] = out['RENK_CNT_KIRMIZI'] + out['RENK_CNT_TURUNCU']
    out['RENK_CNT_GOOD'] = pd.Series((M >= 4).sum(axis=1), index=idx)

    out['RENK_RISK_RATIO'] = pd.Series(
        np.where(gecerli > 0, out['RENK_CNT_RISK'].to_numpy() / np.maximum(gecerli, 1), np.nan),
        index=idx)

    if r3:
        R3 = _renk_aktif_df(df, r3).to_numpy(dtype="float64", na_value=np.nan)
        olculdu = (~np.isnan(R3)).any(axis=1)
        out['RENK_RISK_IN_L3M'] = pd.Series(
            np.where(olculdu, (R3 <= _fe_ayarlar()['RENK_RISK_ESIK']).any(axis=1), np.nan), index=idx)

    if {'RENK_LM', 'RENK_L2M', 'RENK_L3M'}.issubset(aktif_df.columns):
        a, b, c = (aktif_df[k].to_numpy(dtype="float64", na_value=np.nan)
                   for k in ('RENK_LM', 'RENK_L2M', 'RENK_L3M'))
        tam = ~(np.isnan(a) | np.isnan(b) | np.isnan(c))
        out['RENK_DECLINING'] = pd.Series(np.where(tam, (a < b) & (b < c), np.nan), index=idx)
        out['RENK_IMPROVING'] = pd.Series(np.where(tam, (a > b) & (b > c), np.nan), index=idx)

    out['RENK_MODE_L12M'] = _mode_first()
    return out


# ------------------------------------------------------------------------------
# DAV_* (eski aile). DAV_SKOR serisi; düşüş kötü.
#   DAV_{AVG,STD,MIN,MAX}_L{3M,6M,12M}  pencere özeti (medyan yok)   örnek AVG_L3M 423.3
#   DAV_TREND_3_46 / DAV_TREND_6_712   yakın - uzak pencere ort.     örnek -93.3 / -73.3
#   DAV_DELTA_1_2      LM - L2M                                       örnek -20
#   DAV_CV_12M         12 ay std / ortalama: oynaklık                 örnek 0.105
#   DAV_RANGE_12M      12 ay max - min                                örnek 150
# ------------------------------------------------------------------------------
def _dav_features(df):
    out = {}
    _summ(df, 'DAV_SKOR', out, prefix='DAV', add_med=False)
    _trend_delta(df, 'DAV_SKOR', out, prefix='DAV')
    if 'DAV_AVG_L12M' in out and 'DAV_STD_L12M' in out:
        out['DAV_CV_12M'] = pd.Series(
            _sdiv(out['DAV_STD_L12M'], out['DAV_AVG_L12M']),
            index=df.index, copy=False)
        out['DAV_RANGE_12M'] = out['DAV_MAX_L12M'] - out['DAV_MIN_L12M']
    return out


# ------------------------------------------------------------------------------
# MMS_* (eski aile). MMS serisi; artış kötü.
#   MMS_{AVG,STD,MIN,MAX}_L{3M,6M,12M}  pencere özeti               örnek AVG_L3M 7.33
#   MMS_TREND_3_46 / MMS_TREND_6_712   yakın - uzak pencere ort.     örnek +3.0 / +2.83
#   MMS_DELTA_1_2      LM - L2M                                       örnek +1
#   MMS_CV_12M         12 ay std / ortalama                           örnek 0.43
# ------------------------------------------------------------------------------
def _mms_features(df):
    out = {}
    _summ(df, 'MMS', out, add_med=False)
    _trend_delta(df, 'MMS', out)
    if 'MMS_AVG_L12M' in out and 'MMS_STD_L12M' in out:
        out['MMS_CV_12M'] = pd.Series(
            _sdiv(out['MMS_STD_L12M'], out['MMS_AVG_L12M']),
            index=df.index, copy=False)
    return out


# ------------------------------------------------------------------------------
# Hazır pencere kolonlarından oranlar (eski aile). Örnekte varsayılan ham değerler:
# TAUM_TUT_AVG_3M 20000, _4_6M 30000, _6M 25000, SM_AKB_TAUM_TUT_AVG_L3M 5000,
# BRY_KK_TOPLAM_ODEME_ORANI_L3M 15, _L6M 35, INT_SDM_BSVR_ADT_L3M 2, _L6M 5,
# INT_SDM_A_EKOD_LM 3, _L3M 1, INT_SHM_A_EKOD_LM 0, _L3M 2.
#   TAUM_TREND_3_46    TAUM 3M ort. - TAUM 4-6M ort.                  örnek -10000
#   TAUM_RATIO_3_6     TAUM 3M / TAUM 6M                              örnek 0.8
#   AKB_TAUM_ORAN      SM_AKB_TAUM 3M / TAUM 3M                       örnek 0.25
#   ODEME_TREND        toplam KK ödeme oranı L3M - L6M                örnek -20
#   ODEME_AVG          (L3M + L6M) / 2                                örnek 25
#   BSVR_RATIO_3_6     INT_SDM_BSVR_ADT L3M / L6M                     örnek 0.4
#   SDM_EKOD_DELTA     INT_SDM_A_EKOD LM - L3M                        örnek +2
#   SHM_EKOD_DELTA     INT_SHM_A_EKOD LM - L3M                        örnek -2
# ------------------------------------------------------------------------------
def _ratio_features(df):
    out = {}

    def _var(*cols):
        return set(cols).issubset(df.columns)

    def v(c):
        return _sayi(df, c)

    if _var('TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_4_6M'):
        out['TAUM_TREND_3_46'] = v('TAUM_TUT_AVG_3M') - v('TAUM_TUT_AVG_4_6M')
    if _var('TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_6M'):
        out['TAUM_RATIO_3_6'] = _sdiv(v('TAUM_TUT_AVG_3M'), v('TAUM_TUT_AVG_6M'))
    if _var('SM_AKB_TAUM_TUT_AVG_L3M', 'TAUM_TUT_AVG_3M'):
        out['AKB_TAUM_ORAN'] = _sdiv(v('SM_AKB_TAUM_TUT_AVG_L3M'), v('TAUM_TUT_AVG_3M'))
    if _var('BRY_KK_TOPLAM_ODEME_ORANI_L3M', 'BRY_KK_TOPLAM_ODEME_ORANI_L6M'):
        o3, o6 = v('BRY_KK_TOPLAM_ODEME_ORANI_L3M'), v('BRY_KK_TOPLAM_ODEME_ORANI_L6M')
        out['ODEME_TREND'] = o3 - o6
        out['ODEME_AVG'] = (o3 + o6) / 2
    if _var('INT_SDM_BSVR_ADT_L3M', 'INT_SDM_BSVR_ADT_L6M'):
        out['BSVR_RATIO_3_6'] = _sdiv(v('INT_SDM_BSVR_ADT_L3M'), v('INT_SDM_BSVR_ADT_L6M'))
    if _var('INT_SDM_A_EKOD_LM', 'INT_SDM_A_EKOD_L3M'):
        out['SDM_EKOD_DELTA'] = v('INT_SDM_A_EKOD_LM') - v('INT_SDM_A_EKOD_L3M')
    if _var('INT_SHM_A_EKOD_LM', 'INT_SHM_A_EKOD_L3M'):
        out['SHM_EKOD_DELTA'] = v('INT_SHM_A_EKOD_LM') - v('INT_SHM_A_EKOD_L3M')
    return out


# ------------------------------------------------------------------------------
# KKB_SKOR_* (eski aile). KKB skoru 0 ise "sorgu yok" sayılır (NaN); düşüş kötü.
#   KKB_SKOR_{AVG,STD,MIN,MAX,MED}_L{3M,6M,12M,4_6M,6_9M}  pencere özeti
#       (4_6M = L4M..L6M, 6_9M = L6M..L9M)   örnek AVG_L3M 1193.3, MAX_L12M 1420
#   KKB_SKOR_TREND_3_46   3M ort. - 4-6M ort.                         örnek -150
#   KKB_SKOR_TREND_6_79   6M ort. - L7M..L9M ort.                     örnek -135
#   KKB_SKOR_DELTA_1_2    LM - L2M                                    örnek -30
#   KKB_SKOR_DELTA_PCT_1_2  (LM - L2M) / L2M                          örnek -0.025
#   KKB_SKOR_DELTA_1_3    LM - L3M                                    örnek -100
#   KKB_SKOR_LM_BELOW_AVG12_FLG  LM, 12 ay ortalamasının altında mı   örnek 1
#   KKB_SKOR_VALID_CNT_L12M / ZERO_CNT / NULL_CNT  geçerli / 0 / boş ay örnek 12 / 0 / 0
#   KKB_SKOR_EVER_QUERIED_FLG  12 ayda en az bir geçerli skor var mı  örnek 1
# ------------------------------------------------------------------------------
def _kkb_features(df):
    """KKB skor lag serilerinden ozet / trend / degisim feature'lari."""
    base = 'KKB_SKOR'
    months = _fe_ayarlar()['AYLAR_12']
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return {}

    out = {}
    idx = df.index

    pos = {c: j for j, c in enumerate(cols)}
    R = _sayi_mat(df, cols)

    raw_nan = np.isnan(R)
    V = np.where(raw_nan | (R == 0), np.nan, R)
    ok = ~np.isnan(V)

    def _idx(keys):
        """Pencerede fiilen var olan kolonlarin matris indeksleri."""
        return [pos[f'{base}_{k}'] for k in keys if f'{base}_{k}' in pos]

    def _stats(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        empty = cnt == 0
        safe = np.maximum(cnt, 1)
        tot = np.where(ok[:, j], s, 0.0).sum(axis=1)
        avg = tot / safe
        avg[empty] = np.nan
        ss = np.sort(s, axis=1)
        c2 = cnt[:, None]
        lo = np.take_along_axis(ss, np.maximum(c2 - 1, 0) // 2, 1)[:, 0]
        hi = np.take_along_axis(ss, np.maximum(c2, 1) // 2, 1)[:, 0]
        med = (lo + hi) * 0.5
        mn = ss[:, 0].copy()
        mx = np.take_along_axis(ss, np.maximum(c2 - 1, 0), 1)[:, 0]
        med[empty] = np.nan
        mx[empty] = np.nan
        dev = np.where(ok[:, j], s - avg[:, None], 0.0)
        std = np.sqrt(np.einsum('ij,ij->i', dev, dev) / np.maximum(cnt - 1, 1))
        std[np.isnan(std)] = 0.0
        std[cnt <= 1] = 0.0
        return avg, std, mn, mx, med

    def _mean(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        m = np.where(ok[:, j], s, 0.0).sum(axis=1) / np.maximum(cnt, 1)
        m[cnt == 0] = np.nan
        return m

    windows = {
        '3M':   ['LM', 'L2M', 'L3M'],
        '6M':   ['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'],
        '12M':  months,
        '4_6M': ['L4M', 'L5M', 'L6M'],
        '6_9M': ['L6M', 'L7M', 'L8M', 'L9M'],
    }

    for tag, keys in windows.items():
        j = _idx(keys)
        if not j:
            continue
        avg, std, mn, mx, med = _stats(j)
        out[f'{base}_AVG_L{tag}'] = pd.Series(avg, index=idx, copy=False)
        out[f'{base}_STD_L{tag}'] = pd.Series(std, index=idx, copy=False)
        out[f'{base}_MIN_L{tag}'] = pd.Series(mn, index=idx, copy=False)
        out[f'{base}_MAX_L{tag}'] = pd.Series(mx, index=idx, copy=False)
        out[f'{base}_MED_L{tag}'] = pd.Series(med, index=idx, copy=False)

    j3, j46 = _idx(['LM', 'L2M', 'L3M']), _idx(['L4M', 'L5M', 'L6M'])
    j6 = _idx(['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'])
    j79 = _idx(['L7M', 'L8M', 'L9M'])
    if j3 and j46:
        out[f'{base}_TREND_3_46'] = pd.Series(_mean(j3) - _mean(j46),
                                              index=idx, copy=False)
    if j6 and j79:
        out[f'{base}_TREND_6_79'] = pd.Series(_mean(j6) - _mean(j79),
                                              index=idx, copy=False)

    lm, l2, l3 = f'{base}_LM', f'{base}_L2M', f'{base}_L3M'
    if lm in pos and l2 in pos:
        d = V[:, pos[lm]] - V[:, pos[l2]]
        out[f'{base}_DELTA_1_2'] = pd.Series(d, index=idx, copy=False)
        out[f'{base}_DELTA_PCT_1_2'] = _sdiv(d, V[:, pos[l2]])
    if lm in pos and l3 in pos:
        d13 = V[:, pos[lm]] - V[:, pos[l3]]
        out[f'{base}_DELTA_1_3'] = pd.Series(d13, index=idx, copy=False)

    if f'{base}_AVG_L12M' in out and lm in pos:
        lm_v = V[:, pos[lm]]
        avg12 = out[f'{base}_AVG_L12M'].to_numpy(dtype="float64")
        flg = np.where(np.isnan(lm_v) | np.isnan(avg12), np.nan,
                       (lm_v < avg12).astype("float64"))
        out[f'{base}_LM_BELOW_AVG12_FLG'] = pd.Series(flg, index=idx, copy=False)

    out[f'{base}_VALID_CNT_L12M'] = pd.Series(ok.sum(axis=1), index=idx, copy=False)
    out[f'{base}_ZERO_CNT_L12M'] = pd.Series((R == 0).sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_NULL_CNT_L12M'] = pd.Series(raw_nan.sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_EVER_QUERIED_FLG'] = (out[f'{base}_VALID_CNT_L12M'] > 0).astype(int)
    return out


def _oran_nan(a, b):
    """a / b; b <= 0 veya NaN ise NaN (sentinel YOK)."""
    a = np.asarray(a, dtype='float64')
    b = np.asarray(b, dtype='float64')
    gecerli = np.isfinite(a) & np.isfinite(b) & (b > 0)
    return np.where(gecerli, a / np.where(gecerli, b, 1.0), np.nan)


# ------------------------------------------------------------------------------
# KK_LIMIT_*, KK_RISK_*, KK_LKO_* (eski aile). LKO = kullanım = KK_RISK / KK_LIMIT;
# limit <= 0 veya boşsa NaN.
#   KK_LKO_<ay>        her ayın kullanımı (LM..L12M)               örnek KK_LKO_LM 0.95
#   <B>_{AVG,STD,MIN,MAX,MED}_L{3M,6M,12M}  B = KK_LIMIT / KK_RISK / KK_LKO
#       örnek: KK_LIMIT_AVG_L6M 9000, KK_LKO_AVG_L3M 0.954
#   <B>_TREND_3_46, <B>_TREND_6_712, <B>_DELTA_1_2
#       örnek: KK_LIMIT_TREND_3_46 -2000, KK_RISK_TREND_6_712 +4650
#   <B>_DELTA_PCT_LM_L2M   (LM - L2M) / L2M                   örnek KK_RISK -0.026
#   <B>_INC_LM_L2M_FLG / <B>_DEC_LM_L2M_FLG  LM > L2M / LM < L2M   örnek KK_RISK 0 / 1
#   <B>_LM_TO_AVG_L3M      LM / son 3 ay ort.                 örnek KK_RISK 0.996
# ------------------------------------------------------------------------------
def _kk_features(df):
    """KK limit / risk / limit-kullanim-orani (LKO) ozetleri."""
    out = {}
    months = _fe_ayarlar()['AYLAR_12']

    for m in months:
        lim, rsk = f'KK_LIMIT_{m}', f'KK_RISK_{m}'
        if lim in df.columns and rsk in df.columns:
            out[f'KK_LKO_{m}'] = pd.Series(_oran_nan(_sayi(df, rsk), _sayi(df, lim)), index=df.index)
    lko = pd.DataFrame(out, index=df.index)

    _summ(df, 'KK_LIMIT', out, add_med=True)
    _summ(df, 'KK_RISK', out, add_med=True)
    _summ(lko, 'KK_LKO', out, add_med=True)

    _trend_delta(df, 'KK_LIMIT', out)
    _trend_delta(df, 'KK_RISK', out)
    _trend_delta(lko, 'KK_LKO', out)

    for base, data in (('KK_LIMIT', df), ('KK_RISK', df), ('KK_LKO', lko)):
        lm, l2 = f'{base}_LM', f'{base}_L2M'
        if lm not in data.columns:
            continue
        a = _sayi(data, lm)
        if l2 in data.columns:
            b = _sayi(data, l2)
            out[f'{base}_DELTA_PCT_LM_L2M'] = _sdiv(a - b, b)
            tam = ~(np.isnan(a) | np.isnan(b))
            out[f'{base}_INC_LM_L2M_FLG'] = pd.Series(np.where(tam, a > b, np.nan), index=df.index)
            out[f'{base}_DEC_LM_L2M_FLG'] = pd.Series(np.where(tam, a < b, np.nan), index=df.index)
        w3 = _exist(data, _window(base)['w3'])
        if w3:
            out[f'{base}_LM_TO_AVG_L3M'] = _sdiv(a, _ort(_sayi_mat(data, w3), 0, len(w3)))
    return out


# ------------------------------------------------------------------------------
# ODM_* (eski aile). KK_ODEME_ORANI = ödenen / ekstre, yüzde. Düşük ödeme < %20,
# tam ödeme >= %100 (_fe_ayarlar). Oran 0-1 ölçeğinde görünürse uyarı basılır.
#   ODM_{AVG,STD,MIN,MAX,MED}_L{3M,6M,12M}  pencere özeti         örnek AVG_L3M 15
#   ODM_TREND_3_46 / ODM_TREND_6_712       yakın - uzak ort.       örnek -16.7 / -66.7
#   ODM_DELTA_1_2      LM - L2M                                     örnek +15
#   ODM_CV_12M         12 ay std / ortalama                         örnek 0.67
#   ODM_LOW_CNT_L12M   ödeme < %20 ay sayısı                        örnek 3
#   ODM_FULL_CNT_L12M  ödeme >= %100 ay sayısı                      örnek 4
#   ODM_LOW_RATIO_L12M düşük ödeme ayı / geçerli ay                 örnek 0.25
#   ODM_LOW_IN_L3M     son 3 ayda düşük ödeme var mı                örnek 1
#   ODM_LM_BELOW_AVG   LM, 12 ay ortalamasının altında mı           örnek 1
#   ODM_LM_TO_AVG_L12M LM / 12 ay ort.                              örnek 25 / 56.7 = 0.44
#   ODM_DECLINING_3M   LM < L2M < L3M                               örnek 0
# ------------------------------------------------------------------------------
def _odeme_features(df):
    """KK odeme orani (paid/statement) davranis ozetleri."""
    out = {}
    base = 'KK_ODEME_ORANI'
    months = _fe_ayarlar()['AYLAR_12']
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return out

    A = _fe_ayarlar()
    dusuk, tam_esik = A['ODM_DUSUK'], A['ODM_TAM']
    idx = df.index
    S = _sayi_mat(df, cols)
    ok = ~np.isnan(S)
    gecerli = ok.sum(axis=1)

    if not getattr(_odeme_features, '_olcek_uyarisi', False) and ok.any():
        _q99 = float(np.nanquantile(S[ok], 0.99))
        if _q99 <= 1.5:
            print(f'  ⚠ KK_ODEME_ORANI 99. yuzdelik={_q99:.3f}: 0-1 olcegi olabilir; '
                  f'ODM_LOW (<{dusuk}) ve ODM_FULL (>={tam_esik}) esikleri yuzde varsayar.')
        _odeme_features._olcek_uyarisi = True

    _summ(df, base, out, prefix='ODM', add_med=True)
    _trend_delta(df, base, out, prefix='ODM')

    if 'ODM_AVG_L12M' in out and 'ODM_STD_L12M' in out:
        out['ODM_CV_12M'] = pd.Series(
            _sdiv(out['ODM_STD_L12M'], out['ODM_AVG_L12M']),
            index=idx, copy=False)

    out['ODM_LOW_CNT_L12M'] = pd.Series((S < dusuk).sum(axis=1), index=idx, copy=False)
    out['ODM_FULL_CNT_L12M'] = pd.Series((S >= tam_esik).sum(axis=1), index=idx, copy=False)
    out['ODM_LOW_RATIO_L12M'] = pd.Series(
        np.where(gecerli > 0, (S < dusuk).sum(axis=1) / np.maximum(gecerli, 1), np.nan),
        index=idx)

    r3 = _exist(df, [f'{base}_LM', f'{base}_L2M', f'{base}_L3M'])
    if r3:
        j = [cols.index(c) for c in r3]
        olculdu = ok[:, j].any(axis=1)
        out['ODM_LOW_IN_L3M'] = pd.Series(
            np.where(olculdu, (S[:, j] < dusuk).any(axis=1), np.nan), index=idx)

    if 'ODM_AVG_L12M' in out and f'{base}_LM' in df.columns:
        lm_v = _sayi(df, f'{base}_LM')
        avg = np.asarray(out['ODM_AVG_L12M'], dtype='float64')
        out['ODM_LM_BELOW_AVG'] = pd.Series(
            np.where(np.isnan(lm_v) | np.isnan(avg), np.nan, lm_v < avg), index=idx)
        out['ODM_LM_TO_AVG_L12M'] = _sdiv(lm_v, avg)

    if {f'{base}_LM', f'{base}_L2M', f'{base}_L3M'}.issubset(df.columns):
        a, b, c = (_sayi(df, f'{base}_{k}') for k in ('LM', 'L2M', 'L3M'))
        tam = ~(np.isnan(a) | np.isnan(b) | np.isnan(c))
        out['ODM_DECLINING_3M'] = pd.Series(np.where(tam, (a < b) & (b < c), np.nan), index=idx)
    return out


def _seri_matrisi(df, base, sifir_gecersiz=False):
    """[LM, L2M, ..., L12M] matrisi; eksik ay kolonu NaN. Hic kolon yoksa None."""
    cols = [f'{base}_{m}' for m in _fe_ayarlar()['AYLAR_12']]
    if not any(c in df.columns for c in cols):
        return None
    M = np.full((len(df), len(cols)), np.nan)
    for j, c in enumerate(cols):
        if c in df.columns:
            M[:, j] = _sayi(df, c)
    if sifir_gecersiz:
        M[M == 0] = np.nan
    return M


def _ilk_true(mask):
    """Her satirda EN YENI True'nun sutun indeksi (= kac ay once); yoksa NaN."""
    var = mask.any(axis=1)
    i = mask.argmax(axis=1).astype('float64')
    i[~var] = np.nan
    return i


def _son_true(mask):
    """Her satirda EN ESKI True'nun sutun indeksi; yoksa NaN."""
    var = mask.any(axis=1)
    i = (mask.shape[1] - 1 - mask[:, ::-1].argmax(axis=1)).astype('float64')
    i[~var] = np.nan
    return i


def _seri_simdi(mask):
    """En yeni aydan geriye kesintisiz True sayisi."""
    return np.cumprod(mask, axis=1).sum(axis=1)


def _son_donem_sure(mask):
    """En yeni True aydan geriye (eskiye) kesintisiz True sayisi: son donemin uzunlugu; True yoksa 0."""
    T = mask.shape[1]
    i = np.nan_to_num(_ilk_true(mask), nan=T).astype(int)
    once = np.arange(T)[None, :] < i[:, None]
    return (np.cumprod(np.where(once, True, mask), axis=1).astype(bool) & ~once).sum(axis=1)


def _en_uzun_seri(mask):
    """Penceredeki en uzun kesintisiz True dizisi."""
    cur = np.zeros(mask.shape[0])
    best = np.zeros(mask.shape[0])
    for j in range(mask.shape[1]):
        cur = np.where(mask[:, j], cur + 1, 0.0)
        best = np.maximum(best, cur)
    return best


def _hareketler(M):
    """d[:, t] = M[:, t] - M[:, t+1]  (yeni - eski, t ay onceki gecis)."""
    yeni, eski = M[:, :-1], M[:, 1:]
    pair = np.isfinite(yeni) & np.isfinite(eski)
    d = np.where(pair, yeni - eski, 0.0)
    return d, pair


def _ort(M, a, b):
    Y = M[:, a:b]
    ok = np.isfinite(Y)
    n = ok.sum(axis=1)
    m = np.where(ok, Y, 0.0).sum(axis=1) / np.maximum(n, 1)
    m[n == 0] = np.nan
    return m


def _egim(M, W, min_n=3):
    """Ilk W ay icin OLS egimi (birim: aylik degisim). Pozitif = zamanla artis."""
    Y = M[:, :W]
    ok = np.isfinite(Y)
    x = -np.arange(Y.shape[1], dtype='float64')[None, :]
    n = ok.sum(axis=1)
    nn = np.maximum(n, 1)
    xm = np.where(ok, x, 0.0).sum(axis=1) / nn
    ym = np.where(ok, Y, 0.0).sum(axis=1) / nn
    dx = np.where(ok, x - xm[:, None], 0.0)
    dy = np.where(ok, Y - ym[:, None], 0.0)
    sxx = (dx * dx).sum(axis=1)
    sxy = (dx * dy).sum(axis=1)
    return np.where((n >= min_n) & (sxx > 0), sxy / np.where(sxx > 0, sxx, 1.0), np.nan)


def _yon_degisim(d, pair):
    """Sifir olmayan hareketler dizisinde yonun kac kez tersine dondugu."""
    s = np.where(pair, np.sign(d), 0.0)
    son = np.zeros(s.shape[0])
    cnt = np.zeros(s.shape[0])
    for j in range(s.shape[1] - 1, -1, -1):
        cur = s[:, j]
        cnt += (cur != 0) & (son != 0) & (cur != son)
        son = np.where(cur != 0, cur, son)
    return cnt


def _son_iki_hareket(d, pair):
    """En yeni ve bir onceki SIFIR OLMAYAN hareketin isareti / buyuklugu / zamani."""
    nz = pair & (d != 0)
    sira = np.cumsum(nz, axis=1)
    i1 = _ilk_true(nz)
    i2 = _ilk_true(nz & (sira == 2))
    ar = np.arange(d.shape[0])

    def _al(i, arr):
        ok = np.isfinite(i)
        ii = np.where(ok, i, 0).astype(int)
        return np.where(ok, arr[ar, ii], 0.0)

    return (_al(i1, np.sign(d)), _al(i2, np.sign(d)), i1, _al(i1, np.abs(d)))


def _float_ciktilar(out, idx, bos_satir=None):
    """dict -> float32 Series; hic gecerli gozlemi olmayan satirlar NaN."""
    res = {}
    for k, v in out.items():
        a = np.asarray(v, dtype='float64')
        if bos_satir is not None and not k.endswith('_GECERLI_AY'):
            a = np.where(bos_satir, np.nan, a)
        res[k] = pd.Series(a.astype(_fe_ayarlar()['YENI_FEATURE_DTYPE']), index=idx)
    return res


# ------------------------------------------------------------------------------
# RENK_Y_* (62): renk geçmişi bir yol olarak. INAKTIF ay renk sayılmaz. "Geçiş" =
# bir aydan sonraki aya renk değişimi (12 ayda 11 geçiş). Kötüleşme = kod küçülür.
# Örnek yol (LM'den geriye): 2, 1, 1, 3, 4, 4, 5, 5, 5, 5, 5, 5
#  Seviye
#   GECERLI_AY                aktif renkli ay sayısı                        12
#   EN_KOTU_12M / EN_IYI_12M  12 ayın en kötü / en iyi rengi             1 / 5
#   ZIRVEDEN_DUSUS            en iyi renk - LM: zirveden kaç basamak aşağıda   3
#   DIPTEN_UZAKLIK            LM - en kötü renk: dipten kaç basamak yukarıda   1
#   NET_KOTULESME_12M         en eski aktif ay - LM (pozitif = net kötüleşme)  3
#   NET_KOTULESME_3AY / _6AY  L3M - LM / L6M - LM                       -1 / 2
#  Son olay ne zaman (0 = LM, 1 = L2M ...; yoksa NaN)
#   AY_SON_KIRMIZI            en son kırmızı olduğu ay                       1
#   AY_SON_RISK               en son risk renginde olduğu ay                 0
#   AY_SON_KOTULESME          en son kötüleşme geçişi (L4M -> L3M)            2
#   AY_SON_IYILESME           en son iyileşme geçişi (L2M -> LM)              0
#   KIRMIZI_GORDU_12M         12 ayda kırmızı oldu mu                        1
#  Süreler ve seriler
#   MEVCUT_RENKTE_SURE        LM'deki renkte kaç aydır                       1
#   RISK_SERI_SIMDI           LM'den geriye kesintisiz risk ayı              3
#   RISK_EN_UZUN_SERI         12 aydaki en uzun risk serisi                  3
#   TEK_RISK_DONEMI_FLG       şu an riskte ve tüm risk ayları bu tek dönemde 1
#   KOTULESME_SERI_SIMDI      LM'den geriye kesintisiz kötüleşen geçiş       0
#   IYILESME_SERI_SIMDI       LM'den geriye kesintisiz iyileşen geçiş        1
#   SON_IYILESMEDEN_BERI_DUSUS     son iyileşmeden bu yana düşülen basamak   0
#   SON_KOTULESMEDEN_BERI_YUKSELIS son kötüleşmeden bu yana çıkılan basamak  1
#  Hareket sayıları (6M = son 5 geçiş, 12M = 11 geçiş)
#   KOTULESME_ADET_6M / _12M       kötüleşen geçiş sayısı               2 / 3
#   IYILESME_ADET_6M / _12M        iyileşen geçiş sayısı                1 / 1
#   KOTULESME_BASAMAK_6M / _12M    toplam düşülen basamak (3->1 = 2)    3 / 4
#   IYILESME_BASAMAK_6M / _12M     toplam çıkılan basamak               1 / 1
#   MAX_TEK_DUSUS_12M              bir ayda en büyük düşüş               2
#   DEGISIM_ADET_12M               rengin değiştiği geçiş sayısı         4
#   YON_DEGISIM_12M                kötüleşme <-> iyileşme dönüş sayısı   1
#  Kırmızı / risk giriş ve çıkışları (risk = KIRMIZI veya TURUNCU)
#   KIRMIZIYA_GIRIS_12M            kırmızı olmayandan kırmızıya geçiş    1
#   RISKE_GIRIS_12M / RISKTEN_CIKIS_12M   riske giriş / riskten çıkış    1 / 0
#   RISKE_YENIDEN_GIRIS_12M        riskten çıktıktan sonraki girişler    0
#   KIRMIZI_SERI_SIMDI             LM'den geriye kesintisiz kırmızı ay   0
#   AY_SON_KIRMIZIYA_GIRIS         son kırmızıya giriş (L4M -> L3M)       2
#   AY_ILK_KIRMIZIYA_GIRIS         12 aydaki ilk (en eski) giriş          2
#   AY_SON_KIRMIZIDAN_CIKIS        son kırmızıdan çıkış (L2M -> LM)       0
#   SON_KIRMIZI_DONEM_SURE         son kırmızı dönem kaç ay (L3M, L2M)    2
#   AY_SON_RISKE_GIRIS / AY_SON_RISKTEN_CIKIS   son giriş / çıkış       2 / NaN
#   SON_RISK_DONEM_SURE            son risk dönemi kaç ay                 3
#   KIRMIZI_SONRASI_EN_IYI         son kırmızı aydan sonraki en iyi renk  2
#   KIRMIZI_SONRASI_GERI_DUSUS     o en iyi renk - LM: toparlanıp geri düştü mü 0
#   RISK_SONRASI_EN_IYI / _GERI_DUSUS   aynısı risk için (LM hâlâ riskte) NaN
#  Son iki hareket (+1 kötüleşme, -1 iyileşme; en az 3 aktif ay yoksa bayraklar NaN)
#   SON_HAREKET / ONCEKI_HAREKET   son ve bir önceki renk değişiminin yönü  -1 / +1
#   AY_SON_HAREKET                 son değişimin ayı                      0
#   SON_HAREKET_BASAMAK            son değişimin büyüklüğü               1
#   NUKS_FLG                       önce iyileşti, sonra yine kötüleşti    0
#   TOPARLANMA_FLG                 önce kötüleşti, sonra iyileşti         1
#   ART_ARDA_KOTULESME_FLG / ART_ARDA_IYILESME_FLG                   0 / 0
#  Hız
#   KOTULESME_HIZLANMA   (4-6 ay ort. - son 3 ay ort.) - (7-12 ay ort. - 4-6 ay ort.)
#                        pozitif = düşüş son dönemde hızlanıyor  (2.33 - 1.33 =) 1.0
#   EGIM_6M / EGIM_12M   doğrusal eğim, basamak / ay (negatif = düşüş)  -0.60 / -0.39
#  İnaktiflik (0 kodu)
#   INAKTIF_AY_12M / AY_SON_INAKTIF       inaktif ay sayısı / en son ne zaman  0 / NaN
#   INAKTIFTEN_DONUS_FLG  LM aktif, önceki 11 ayda inaktif ay var        0
# ------------------------------------------------------------------------------
def _renk_yol_features(df):
    """Musterinin renk gecmisini bir yol olarak ozetler."""
    M = _seri_matrisi(df, 'RENK')
    if M is None:
        return {}

    inaktif_kod, aktif, kirmizi = _renk_kodlari()
    inaktif = (M == inaktif_kod) if inaktif_kod is not None else np.zeros(M.shape, bool)
    M[~np.isin(M, aktif)] = np.nan

    idx = df.index
    T = M.shape[1]
    ar = np.arange(len(df))
    ok = np.isfinite(M)
    gecerli = ok.sum(axis=1)
    R0 = M[:, 0]

    d, pair = _hareketler(M)
    kot = pair & (d < 0)
    iyi = pair & (d > 0)
    ayni = pair & (d == 0)
    dus = np.where(kot, -d, 0.0)
    yuk = np.where(iyi, d, 0.0)
    risk = ok & (M <= _fe_ayarlar()['RENK_RISK_ESIK'])
    kir = ok & (M == kirmizi)
    t_gecis = np.arange(T - 1)[None, :]
    t_durum = np.arange(T)[None, :]

    out = {}
    out['RENK_Y_GECERLI_AY'] = gecerli

    out['RENK_Y_INAKTIF_AY_12M'] = inaktif.sum(axis=1)
    out['RENK_Y_AY_SON_INAKTIF'] = _ilk_true(inaktif)
    out['RENK_Y_INAKTIFTEN_DONUS_FLG'] = np.isfinite(R0) & inaktif[:, 1:].any(axis=1)

    en_kotu = np.where(ok, M, np.inf).min(axis=1)
    en_iyi = np.where(ok, M, -np.inf).max(axis=1)
    en_kotu[gecerli == 0] = np.nan
    en_iyi[gecerli == 0] = np.nan
    out['RENK_Y_EN_KOTU_12M'] = en_kotu
    out['RENK_Y_EN_IYI_12M'] = en_iyi
    out['RENK_Y_ZIRVEDEN_DUSUS'] = en_iyi - R0
    out['RENK_Y_DIPTEN_UZAKLIK'] = R0 - en_kotu
    i_eski = _son_true(ok)
    eski_deger = np.where(np.isfinite(i_eski), M[ar, np.nan_to_num(i_eski).astype(int)], np.nan)
    out['RENK_Y_NET_KOTULESME_12M'] = eski_deger - R0
    out['RENK_Y_NET_KOTULESME_3AY'] = M[:, 2] - R0
    out['RENK_Y_NET_KOTULESME_6AY'] = M[:, 5] - R0

    out['RENK_Y_AY_SON_KIRMIZI'] = _ilk_true(kir)
    out['RENK_Y_AY_SON_RISK'] = _ilk_true(risk)
    out['RENK_Y_AY_SON_KOTULESME'] = _ilk_true(kot)
    out['RENK_Y_AY_SON_IYILESME'] = _ilk_true(iyi)
    out['RENK_Y_KIRMIZI_GORDU_12M'] = kir.any(axis=1)

    sure = 1 + _seri_simdi(ayni)
    out['RENK_Y_MEVCUT_RENKTE_SURE'] = np.where(np.isfinite(R0), sure, np.nan)
    risk_seri = _seri_simdi(risk)
    out['RENK_Y_RISK_SERI_SIMDI'] = risk_seri
    out['RENK_Y_RISK_EN_UZUN_SERI'] = _en_uzun_seri(risk)
    out['RENK_Y_TEK_RISK_DONEMI_FLG'] = risk[:, 0] & (risk.sum(axis=1) == risk_seri)
    out['RENK_Y_KOTULESME_SERI_SIMDI'] = _seri_simdi(kot)
    out['RENK_Y_IYILESME_SERI_SIMDI'] = _seri_simdi(iyi)
    L_kot = _seri_simdi(pair & (d <= 0))
    out['RENK_Y_SON_IYILESMEDEN_BERI_DUSUS'] = np.where(t_gecis < L_kot[:, None], dus, 0.0).sum(axis=1)
    L_iyi = _seri_simdi(pair & (d >= 0))
    out['RENK_Y_SON_KOTULESMEDEN_BERI_YUKSELIS'] = np.where(t_gecis < L_iyi[:, None], yuk, 0.0).sum(axis=1)

    for W, tag in ((6, '6M'), (T, '12M')):
        tw = W - 1
        out[f'RENK_Y_KOTULESME_ADET_{tag}'] = kot[:, :tw].sum(axis=1)
        out[f'RENK_Y_IYILESME_ADET_{tag}'] = iyi[:, :tw].sum(axis=1)
        out[f'RENK_Y_KOTULESME_BASAMAK_{tag}'] = dus[:, :tw].sum(axis=1)
        out[f'RENK_Y_IYILESME_BASAMAK_{tag}'] = yuk[:, :tw].sum(axis=1)
    out['RENK_Y_MAX_TEK_DUSUS_12M'] = dus.max(axis=1)
    out['RENK_Y_DEGISIM_ADET_12M'] = (pair & (d != 0)).sum(axis=1)
    out['RENK_Y_YON_DEGISIM_12M'] = _yon_degisim(d, pair)

    yeni_s, eski_s = M[:, :-1], M[:, 1:]
    riske_giris = pair & (yeni_s <= _fe_ayarlar()['RENK_RISK_ESIK']) & (eski_s > _fe_ayarlar()['RENK_RISK_ESIK'])
    riskten_cikis = pair & (yeni_s > _fe_ayarlar()['RENK_RISK_ESIK']) & (eski_s <= _fe_ayarlar()['RENK_RISK_ESIK'])
    out['RENK_Y_KIRMIZIYA_GIRIS_12M'] = (pair & (yeni_s == kirmizi) & (eski_s > kirmizi)).sum(axis=1)
    out['RENK_Y_RISKE_GIRIS_12M'] = riske_giris.sum(axis=1)
    out['RENK_Y_RISKTEN_CIKIS_12M'] = riskten_cikis.sum(axis=1)
    en_eski_cikis = np.nan_to_num(_son_true(riskten_cikis), nan=-1.0)
    out['RENK_Y_RISKE_YENIDEN_GIRIS_12M'] = (riske_giris & (t_gecis < en_eski_cikis[:, None])).sum(axis=1)

    # Gecis zamanlari ve donem sureleri (0 = LM ayi; gecis yoksa NaN).
    kir_giris = pair & (yeni_s == kirmizi) & (eski_s > kirmizi)
    kir_cikis = pair & (yeni_s > kirmizi) & (eski_s == kirmizi)
    out['RENK_Y_KIRMIZI_SERI_SIMDI'] = _seri_simdi(kir)
    out['RENK_Y_AY_SON_KIRMIZIYA_GIRIS'] = _ilk_true(kir_giris)
    out['RENK_Y_AY_ILK_KIRMIZIYA_GIRIS'] = _son_true(kir_giris)
    out['RENK_Y_AY_SON_KIRMIZIDAN_CIKIS'] = _ilk_true(kir_cikis)
    out['RENK_Y_SON_KIRMIZI_DONEM_SURE'] = _son_donem_sure(kir)
    out['RENK_Y_AY_SON_RISKE_GIRIS'] = _ilk_true(riske_giris)
    out['RENK_Y_AY_SON_RISKTEN_CIKIS'] = _ilk_true(riskten_cikis)
    out['RENK_Y_SON_RISK_DONEM_SURE'] = _son_donem_sure(risk)

    for ad, mask in (('KIRMIZI', kir), ('RISK', risk)):
        i_son = np.nan_to_num(_ilk_true(mask), nan=-1.0)
        sonra = (t_durum < i_son[:, None]) & ok
        en_iyi_sonra = np.where(sonra, M, -np.inf).max(axis=1)
        en_iyi_sonra[~sonra.any(axis=1)] = np.nan
        out[f'RENK_Y_{ad}_SONRASI_EN_IYI'] = en_iyi_sonra
        out[f'RENK_Y_{ad}_SONRASI_GERI_DUSUS'] = en_iyi_sonra - R0

    s1, s2, i1, m1 = _son_iki_hareket(-d, pair)
    out['RENK_Y_SON_HAREKET'] = s1
    out['RENK_Y_ONCEKI_HAREKET'] = s2
    out['RENK_Y_AY_SON_HAREKET'] = i1
    out['RENK_Y_SON_HAREKET_BASAMAK'] = np.where(np.isfinite(i1), m1, np.nan)
    yeterli = gecerli >= 3
    out['RENK_Y_NUKS_FLG'] = np.where(yeterli, (s1 == 1) & (s2 == -1), np.nan)
    out['RENK_Y_TOPARLANMA_FLG'] = np.where(yeterli, (s1 == -1) & (s2 == 1), np.nan)
    out['RENK_Y_ART_ARDA_KOTULESME_FLG'] = np.where(yeterli, (s1 == 1) & (s2 == 1), np.nan)
    out['RENK_Y_ART_ARDA_IYILESME_FLG'] = np.where(yeterli, (s1 == -1) & (s2 == -1), np.nan)

    o13, o46, o712 = _ort(M, 0, 3), _ort(M, 3, 6), _ort(M, 6, T)
    out['RENK_Y_KOTULESME_HIZLANMA'] = (o46 - o13) - (o712 - o46)
    out['RENK_Y_EGIM_6M'] = _egim(M, 6)
    out['RENK_Y_EGIM_12M'] = _egim(M, T)

    bos = gecerli == 0
    res = _float_ciktilar({k: v for k, v in out.items() if 'INAKTIF' not in k}, idx, bos_satir=bos)
    res.update(_float_ciktilar({k: v for k, v in out.items() if 'INAKTIF' in k}, idx))
    return res


def _seri_dinamik(M, P):
    """Yonden bagimsiz dinamik feature'lar (artis ve azalis ayri ayri)."""
    ok = np.isfinite(M)
    n_ok = ok.sum(axis=1)
    T = M.shape[1]
    d, pair = _hareketler(M)
    art = pair & (d > 0)
    az = pair & (d < 0)
    out = {}
    out[f'{P}_D_GECERLI_AY'] = n_ok
    out[f'{P}_D_EGIM_3M'] = _egim(M, 3)
    out[f'{P}_D_EGIM_6M'] = _egim(M, 6)
    out[f'{P}_D_EGIM_12M'] = _egim(M, T)
    o13, o46, o79 = _ort(M, 0, 3), _ort(M, 3, 6), _ort(M, 6, 9)
    out[f'{P}_D_IVME'] = (o13 - o46) - (o46 - o79)
    out[f'{P}_D_ARTIS_SERI'] = _seri_simdi(art)
    out[f'{P}_D_AZALIS_SERI'] = _seri_simdi(az)
    out[f'{P}_D_ARTIS_ADET_12M'] = art.sum(axis=1)
    out[f'{P}_D_AZALIS_ADET_12M'] = az.sum(axis=1)
    out[f'{P}_D_MAX_AYLIK_ARTIS'] = np.where(art, d, 0.0).max(axis=1)
    out[f'{P}_D_MAX_AYLIK_AZALIS'] = np.where(az, -d, 0.0).max(axis=1)
    out[f'{P}_D_YON_DEGISIM_12M'] = _yon_degisim(d, pair)

    G = M[:, 1:]
    okg = ok[:, 1:]
    ng = okg.sum(axis=1)
    mg = np.where(okg, G, 0.0).sum(axis=1) / np.maximum(ng, 1)
    dev = np.where(okg, G - mg[:, None], 0.0)
    sg = np.sqrt((dev * dev).sum(axis=1) / np.maximum(ng - 1, 1))
    z_ok = (ng >= 3) & (sg > 0) & np.isfinite(M[:, 0])
    out[f'{P}_D_ZSKOR_LM'] = np.where(z_ok, (M[:, 0] - mg) / np.where(sg > 0, sg, 1.0), np.nan)

    mx = np.where(ok, M, -np.inf).max(axis=1)
    mn = np.where(ok, M, np.inf).min(axis=1)
    mx[n_ok == 0] = np.nan
    mn[n_ok == 0] = np.nan
    out[f'{P}_D_ZIRVEDEN_FARK'] = mx - M[:, 0]
    out[f'{P}_D_DIPTEN_FARK'] = M[:, 0] - mn
    out[f'{P}_D_AY_SON_ZIRVE'] = _ilk_true(ok & (M == mx[:, None]))
    out[f'{P}_D_AY_SON_DIP'] = _ilk_true(ok & (M == mn[:, None]))
    return out, (n_ok == 0)


def _kk_kullanim_matrisi(df):
    """KK_RISK_{m} / KK_LIMIT_{m}; limit <= 0 ise NaN. Lag'ler yoksa None."""
    if not any(f'KK_LIMIT_{m}' in df.columns and f'KK_RISK_{m}' in df.columns
               for m in _fe_ayarlar()['AYLAR_12']):
        return None
    M = np.full((len(df), len(_fe_ayarlar()['AYLAR_12'])), np.nan)
    for j, m in enumerate(_fe_ayarlar()['AYLAR_12']):
        lim, rsk = f'KK_LIMIT_{m}', f'KK_RISK_{m}'
        if lim in df.columns and rsk in df.columns:
            M[:, j] = _oran_nan(_sayi(df, rsk), _sayi(df, lim))
    return M


# ------------------------------------------------------------------------------
# <P>_D_* (85 = 5 seri x 17). P: DAV (DAV_SKOR), MMS, KKB (KKB_SKOR, 0 = NaN),
# ODM (KK_ODEME_ORANI), KKU (KK_RISK / KK_LIMIT). Yön işaretlenmez: artış ve azalış
# ayrı feature; hangisinin kötü olduğu seriye göre okunur.
# Örnek KKB serisi (LM'den geriye): 1150, 1180, 1250, 1300, 1350, 1380, 1400, ...
#   GECERLI_AY            dolu ay sayısı                                    12
#   EGIM_3M / _6M / _12M  doğrusal eğim, birim / ay                 -50 / -48.9 / -23.7
#   IVME                  (son 3 ort. - 4-6 ort.) - (4-6 ort. - 7-9 ort.)
#                         (1193 - 1343) - (1343 - 1403) = -90: düşüş hızlanıyor
#   ARTIS_SERI / AZALIS_SERI   LM'den geriye kesintisiz artış / azalış ayı   0 / 6
#   ARTIS_ADET_12M / AZALIS_ADET_12M   artan / azalan geçiş sayısı      2 / 8
#   MAX_AYLIK_ARTIS / MAX_AYLIK_AZALIS  en büyük aylık artış / azalış  10 / 70
#   YON_DEGISIM_12M       artış <-> azalış dönüş sayısı                     3
#   ZSKOR_LM              (LM - L2M..L12M ort.) / std: LM kendi geçmişine göre  -2.60
#   ZIRVEDEN_FARK / DIPTEN_FARK   12 ay max - LM / LM - 12 ay min      270 / 0
#   AY_SON_ZIRVE / AY_SON_DIP     max / min en son hangi ay (10 = L11M)   10 / 0
# Örnek KKU: DIPTEN_FARK 0.95, AY_SON_ZIRVE 1 (L2M 0.975), ARTIS_ADET_12M 9.
# ------------------------------------------------------------------------------
def _seri_dinamik_features(df):
    res = {}
    for base, (P, sifir_gecersiz) in _fe_ayarlar()['SERI_TANIM'].items():
        M = _seri_matrisi(df, base, sifir_gecersiz=sifir_gecersiz)
        if M is None:
            continue
        out, bos = _seri_dinamik(M, P)
        res.update(_float_ciktilar(out, df.index, bos_satir=bos))
    M = _kk_kullanim_matrisi(df)
    if M is not None:
        out, bos = _seri_dinamik(M, 'KKU')
        res.update(_float_ciktilar(out, df.index, bos_satir=bos))
    return res


def _yonlu_seriler(df):
    """Yonu bilinen seriler: base -> (matris [LM..L12M], yon). INAKTIF renk NaN."""
    seriler = {}
    for base, yon in _fe_ayarlar()['SERI_YON'].items():
        if yon is None:
            continue
        if base == 'RENK':
            M = _seri_matrisi(df, 'RENK')
            if M is not None:
                M[~np.isin(M, _renk_kodlari()[1])] = np.nan
        elif base == 'KK_KULLANIM':
            M = _kk_kullanim_matrisi(df)
        else:
            sifir = _fe_ayarlar()['SERI_TANIM'].get(base, (None, False))[1]
            M = _seri_matrisi(df, base, sifir_gecersiz=sifir)
        if M is not None:
            seriler[base] = (M, yon)
    return seriler


# ------------------------------------------------------------------------------
# ESZ_* (15): aynı dönemde kaç gösterge birlikte bozuldu. Göstergeler (6): RENK,
# KKB_SKOR, KK_ODEME_ORANI, KK_KULLANIM, DAV_SKOR, MMS (yönleri _fe_ayarlar SERI_YON).
# 3M: LM ile L3M, 6M: LM ile L6M karşılaştırılır.
#   ESZ_KOTULESEN_SINYAL_3M / _6M  kötüleşen gösterge sayısı             4 / 6
#       (3M: KKB, KKU, DAV, MMS kötüleşti; renk 1 -> 2 ve ödeme 10 -> 25 iyileşti)
#   ESZ_OLCULEN_SINYAL_3M / _6M    karşılaştırılabilen gösterge sayısı   6 / 6
#   ESZ_KOTULESEN_ORAN_3M / _6M    kötüleşen / ölçülen               0.67 / 1.0
#   ESZ_DIPTE_SINYAL_12M           LM'de 12 ayın en kötü değerinde olan gösterge
#                                  sayısı (KKB, DAV, MMS)                   3
#   ESZ_DIPTE_ORAN_12M             dipte / ölçülen                        0.5
#   ESZ_<A>_<B>_KOTU_3M            iki gösterge son 3 ayda birlikte kötüleşti mi.
#       Çiftler: RENK_ODEME, RENK_KKB, ODEME_KKB, RENK_KKU, RENK_DAV, RENK_MMS, DAV_MMS
#       örnek: DAV_MMS 1, renkli çiftler 0 (renk son 3 ayda iyileşti)
# ------------------------------------------------------------------------------
def _eszamanli_features(df):
    """Ayni donemde kac gosterge birlikte bozuldu?"""
    seriler = _yonlu_seriler(df)
    if not seriler:
        return {}

    out = {}
    kotu = {}
    for tag, j in (('3M', 2), ('6M', 5)):
        sayi = np.zeros(len(df))
        olculen = np.zeros(len(df))
        for base, (M, yon) in seriler.items():
            olc = np.isfinite(M[:, 0]) & np.isfinite(M[:, j])
            k = olc & (yon * (M[:, 0] - M[:, j]) < 0)
            sayi += k
            olculen += olc
            kotu[(base, tag)] = np.where(olc, k, np.nan)
        out[f'ESZ_KOTULESEN_SINYAL_{tag}'] = np.where(olculen > 0, sayi, np.nan)
        out[f'ESZ_OLCULEN_SINYAL_{tag}'] = olculen
        out[f'ESZ_KOTULESEN_ORAN_{tag}'] = np.where(olculen > 0, sayi / np.maximum(olculen, 1), np.nan)

    dipte = np.zeros(len(df))
    dip_olc = np.zeros(len(df))
    for base, (M, yon) in seriler.items():
        ok = np.isfinite(M)
        n = ok.sum(axis=1)
        Y = yon * M
        en_kotu = np.where(ok, Y, np.inf).min(axis=1)
        en_iyi = np.where(ok, Y, -np.inf).max(axis=1)
        olc = (n >= 3) & np.isfinite(M[:, 0]) & (en_iyi > en_kotu)
        dipte += olc & (Y[:, 0] <= en_kotu)
        dip_olc += olc
    out['ESZ_DIPTE_SINYAL_12M'] = np.where(dip_olc > 0, dipte, np.nan)
    out['ESZ_DIPTE_ORAN_12M'] = np.where(dip_olc > 0, dipte / np.maximum(dip_olc, 1), np.nan)

    ciftler = [('RENK', 'KK_ODEME_ORANI', 'RENK_ODEME'),
               ('RENK', 'KKB_SKOR', 'RENK_KKB'),
               ('KK_ODEME_ORANI', 'KKB_SKOR', 'ODEME_KKB'),
               ('RENK', 'KK_KULLANIM', 'RENK_KKU'),
               ('RENK', 'DAV_SKOR', 'RENK_DAV'),
               ('RENK', 'MMS', 'RENK_MMS'),
               ('DAV_SKOR', 'MMS', 'DAV_MMS')]
    for a, b, ad in ciftler:
        if (a, '3M') in kotu and (b, '3M') in kotu:
            ka, kb = kotu[(a, '3M')], kotu[(b, '3M')]
            out[f'ESZ_{ad}_KOTU_3M'] = np.where(np.isnan(ka) | np.isnan(kb), np.nan, ka * kb)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# GIZLI_* (6): renk henüz kötüleşmemişken (LM >= L3M veya L6M) diğer 5 göstergenin
# bozulması. Renk kötüleşmişse sayılar 0; renk ölçülemiyorsa NaN.
#   GIZLI_KOTULESEN_SINYAL_3M / _6M  renk bozulmamışken kötüleşen gösterge  4 / 0
#       (3M: renk L3M 1 -> LM 2, bozulmadı; 6M: L6M 4 -> LM 2, bozuldu, o yüzden 0)
#   GIZLI_KOTULESME_FLG_3M / _6M     en az bir gizli bozulma var mı      1 / 0
#   GIZLI_KOTULESME_GORELI_3M / _6M  bozulmaların göreli büyüklük toplamı
#       |değişim| / pencere başı: KKB 100/1250 + KKU 0.0125/0.9375 + DAV 50/450
#       + MMS 1/7 = 0.347
# ------------------------------------------------------------------------------
def _gizli_kotulesme_features(df):
    """Renk HENUZ kotulesmemisken diger gostergeler bozuluyor mu?"""
    seriler = _yonlu_seriler(df)
    if 'RENK' not in seriler or len(seriler) < 2:
        return {}
    R, _ = seriler['RENK']
    out = {}
    for tag, j in (('3M', 2), ('6M', 5)):
        renk_olc = np.isfinite(R[:, 0]) & np.isfinite(R[:, j])
        renk_kotulesmedi = renk_olc & (R[:, 0] >= R[:, j])
        sayi = np.zeros(len(df))
        olculen = np.zeros(len(df))
        buyukluk = np.zeros(len(df))
        for base, (M, yon) in seriler.items():
            if base == 'RENK':
                continue
            olc = np.isfinite(M[:, 0]) & np.isfinite(M[:, j])
            fark = yon * (M[:, 0] - M[:, j])
            k = olc & (fark < 0)
            sayi += k
            olculen += olc
            olcek = np.abs(M[:, j])
            goreli = np.where(olc & (olcek > 0), -fark / np.where(olcek > 0, olcek, 1.0), 0.0)
            buyukluk += np.where(k, goreli, 0.0)
        gecerli = renk_olc & (olculen > 0)
        out[f'GIZLI_KOTULESEN_SINYAL_{tag}'] = np.where(gecerli, np.where(renk_kotulesmedi, sayi, 0.0), np.nan)
        out[f'GIZLI_KOTULESME_FLG_{tag}'] = np.where(gecerli, renk_kotulesmedi & (sayi >= 1), np.nan)
        out[f'GIZLI_KOTULESME_GORELI_{tag}'] = np.where(gecerli, np.where(renk_kotulesmedi, buyukluk, 0.0), np.nan)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# INT_*_INTD_* (veride kaç INT ailesi varsa): INT_ ile başlayıp _LM / _L3M / _L6M /
# _L9M / _L12M ile biten kolonlar bir aile sayılır. Pencere değerinin tanımı (toplam,
# adet vb.) ham veriden gelir. Örnek aile INT_SDM_BSVR_ADT: LM 0, L3M 2, L6M 5, L12M 9.
#   <aile>_INTD_LM_L3M     LM / L3M      (payda <= 0 ise NaN)             0
#   <aile>_INTD_L3M_L6M    L3M / L6M                                    0.40
#   <aile>_INTD_L3M_L12M   L3M / L12M                                   0.22
#   <aile>_INTD_L6M_L12M   L6M / L12M                                   0.56
#   <aile>_INTD_DURDU_FLG  en yakın pencere 0 iken daha uzak pencerelerden biri > 0:
#                          aktivite son dönemde durdu                    1
# ------------------------------------------------------------------------------
def _int_degisim_features(df):
    """INT_* aileleri aylik degil, pencere bazli (LM, L3M, L6M, L9M, L12M)."""
    aileler = {}
    for c in df.columns:
        if not c.startswith('INT_'):
            continue
        for w in _fe_ayarlar()['INT_PENCERELER']:
            if c.endswith('_' + w):
                aileler.setdefault(c[: -len(w) - 1], {})[w] = c
                break
    out = {}
    for aile, pc in aileler.items():
        if len(pc) < 2:
            continue
        V = {w: _sayi(df, c) for w, c in pc.items()}
        for yakin, uzak in (('LM', 'L3M'), ('L3M', 'L6M'), ('L3M', 'L12M'), ('L6M', 'L12M')):
            if yakin in V and uzak in V:
                out[f'{aile}_INTD_{yakin}_{uzak}'] = _oran_nan(V[yakin], V[uzak])
        sirali = [w for w in _fe_ayarlar()['INT_PENCERELER'] if w in V]
        yakin, uzaklar = sirali[0], sirali[1:]
        uzak_aktif = np.zeros(len(df), bool)
        uzak_olc = np.zeros(len(df), bool)
        for w in uzaklar:
            uzak_aktif |= np.nan_to_num(V[w]) > 0
            uzak_olc |= np.isfinite(V[w])
        olc = np.isfinite(V[yakin]) & uzak_olc
        out[f'{aile}_INTD_DURDU_FLG'] = np.where(olc, (V[yakin] == 0) & uzak_aktif, np.nan)
    return _float_ciktilar(out, df.index)


# ------------------------------------------------------------------------------
# BV_* (4): kart borcu ile varlık (TAUM_TUT_AVG) birlikte. Örnek: TAUM 3M 20000,
# TAUM 4-6M 30000, KK_RISK_LM 7600, KK_RISK_L3M 7500.
#   BV_TAUM_DEGISIM_ORAN_3_46   (TAUM 3M - TAUM 4-6M) / TAUM 4-6M           -0.33
#   BV_KK_RISK_TAUM_ORAN        KK_RISK_LM / TAUM 3M                         0.38
#   BV_BORC_ARTIYOR_VARLIK_AZALIYOR_FLG  KK_RISK_LM > L3M ve TAUM 3M < 4-6M     1
#   BV_KK_RISK_TAUM_ORAN_DEGISIM  bugünkü oran - (KK_RISK_L3M / TAUM 4-6M)    0.13
# ------------------------------------------------------------------------------
def _borc_varlik_features(df):
    """Kart borcu artarken varliklar (TAUM) eriyor mu?"""
    out = {}
    if {'TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_4_6M'}.issubset(df.columns):
        t3, t46 = _sayi(df, 'TAUM_TUT_AVG_3M'), _sayi(df, 'TAUM_TUT_AVG_4_6M')
        out['BV_TAUM_DEGISIM_ORAN_3_46'] = _oran_nan(t3 - t46, t46)
    if 'KK_RISK_LM' in df.columns and 'TAUM_TUT_AVG_3M' in df.columns:
        rsk, taum = _sayi(df, 'KK_RISK_LM'), _sayi(df, 'TAUM_TUT_AVG_3M')
        out['BV_KK_RISK_TAUM_ORAN'] = _oran_nan(rsk, taum)
        if {'KK_RISK_L3M', 'TAUM_TUT_AVG_4_6M'}.issubset(df.columns):
            rsk3, taum46 = _sayi(df, 'KK_RISK_L3M'), _sayi(df, 'TAUM_TUT_AVG_4_6M')
            olc = np.isfinite(rsk) & np.isfinite(rsk3) & np.isfinite(taum) & np.isfinite(taum46)
            out['BV_BORC_ARTIYOR_VARLIK_AZALIYOR_FLG'] = np.where(olc, (rsk > rsk3) & (taum < taum46), np.nan)
            out['BV_KK_RISK_TAUM_ORAN_DEGISIM'] = out['BV_KK_RISK_TAUM_ORAN'] - _oran_nan(rsk3, taum46)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# KK_O_* (20): bankanın limit aksiyonları ve kullanımın kritik eşikleri.
#   KK_O_LIMIT_DUSUS_ADET_12M / KK_O_LIMIT_ARTIS_ADET_12M  limit düşen / artan ay  1 / 0
#   KK_O_AY_SON_LIMIT_DUSUS / KK_O_AY_SON_LIMIT_ARTIS  en son ne zaman (L4M -> L3M)  2 / NaN
#   KK_O_LIMIT_DEGISIM_ORAN_12M   LM limiti / en eski limit (8000 / 10000)     0.8
#   Kullanım eşikleri e = 80, 90, 100 (KKU >= %80 / %90 / %100):
#   KK_O_KULLANIM_<e>_USTU_ADET_12M / _ADET_3M   eşik üstü ay sayısı  e=90: 3 / 3
#   KK_O_AY_SON_KULLANIM_<e>_USTU               en son ne zaman      e=90: 0
#   KK_O_KULLANIM_<e>_USTU_SERI                 LM'den geriye seri   e=90: 3
#       (e=100: 0 / 0 / NaN / 0, kullanım hiç %100'ü geçmedi)
#   KK_O_SIFIR_BORC_ADET_12M      borcu <= 0 olan ay (L11M, L12M)            2
#   KK_O_AY_SON_SIFIR_BORC        en son sıfır borç ayı (10 = L11M)          10
#   KK_O_BORC_SIFIRDAN_BASLADI_FLG  LM'de borç var, L2M veya L3M'de sıfırdı    0
# ------------------------------------------------------------------------------
def _kk_olay_features(df):
    """Bankanin limit aksiyonlari ve kullanimin kritik esikleri."""
    A = _fe_ayarlar()
    L = _seri_matrisi(df, 'KK_LIMIT')
    Rk = _seri_matrisi(df, 'KK_RISK')
    if L is None or Rk is None:
        return {}
    out = {}

    Lp = np.where(L > 0, L, np.nan)
    d, pair = _hareketler(Lp)
    dus = pair & (d < 0)
    art = pair & (d > 0)
    out['KK_O_LIMIT_DUSUS_ADET_12M'] = dus.sum(axis=1)
    out['KK_O_LIMIT_ARTIS_ADET_12M'] = art.sum(axis=1)
    out['KK_O_AY_SON_LIMIT_DUSUS'] = _ilk_true(dus)
    out['KK_O_AY_SON_LIMIT_ARTIS'] = _ilk_true(art)
    ok_l = np.isfinite(Lp)
    i_eski = _son_true(ok_l)
    ar = np.arange(len(df))
    eski_lim = np.where(np.isfinite(i_eski), Lp[ar, np.nan_to_num(i_eski).astype(int)], np.nan)
    out['KK_O_LIMIT_DEGISIM_ORAN_12M'] = _oran_nan(Lp[:, 0], eski_lim)

    U = _kk_kullanim_matrisi(df)
    if U is not None:
        okU = np.isfinite(U)
        for e in A['KKU_ESIKLER']:
            tag = f'{int(round(e * 100))}'
            ust = okU & (U >= e)
            out[f'KK_O_KULLANIM_{tag}_USTU_ADET_12M'] = ust.sum(axis=1)
            out[f'KK_O_KULLANIM_{tag}_USTU_ADET_3M'] = ust[:, :3].sum(axis=1)
            out[f'KK_O_AY_SON_KULLANIM_{tag}_USTU'] = _ilk_true(ust)
            out[f'KK_O_KULLANIM_{tag}_USTU_SERI'] = _seri_simdi(ust)

    okR = np.isfinite(Rk)
    sifir = okR & (Rk <= 0)
    out['KK_O_SIFIR_BORC_ADET_12M'] = sifir.sum(axis=1)
    out['KK_O_AY_SON_SIFIR_BORC'] = _ilk_true(sifir)
    olc = okR[:, 0] & (okR[:, 1] | okR[:, 2])
    out['KK_O_BORC_SIFIRDAN_BASLADI_FLG'] = np.where(
        olc, (Rk[:, 0] > 0) & (sifir[:, 1] | sifir[:, 2]), np.nan)

    bos = ~(ok_l.any(axis=1) | okR.any(axis=1))
    return _float_ciktilar(out, df.index, bos_satir=bos)


# ------------------------------------------------------------------------------
# OK_* (7): aynı ayda ödeme < %20 ve kullanım >= %80 = "borç sarmalı" ayı. Örnekte
# L2M (%10, 0.975) ve L3M (%10, 0.94) sarmal; LM (%25) ve L4M (kullanım 0.70) değil.
#   OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_3M / _6M / _12M   sarmal ay sayısı  2 / 2 / 2
#   OK_AY_SON_DUSUK_ODEME_YUKSEK_KULLANIM   en son sarmal ayı (L2M)         1
#   OK_DUSUK_ODEME_YUKSEK_KULLANIM_SERI     LM'den geriye sarmal serisi     0
#   OK_TAM_ODEME_DUSUK_KULLANIM_ADET_12M    ödeme >= %100 ve kullanım < %30 ayı  3
#   OK_OLCULEN_AY_12M                       ödeme ve kullanımın birlikte dolu olduğu ay 12
# ------------------------------------------------------------------------------
def _odeme_kullanim_features(df):
    """Ayni ayda dusuk odeme + yuksek kullanim: borc sarmalinin baslangici."""
    A = _fe_ayarlar()
    O = _seri_matrisi(df, 'KK_ODEME_ORANI')
    U = _kk_kullanim_matrisi(df)
    if O is None or U is None:
        return {}
    olc = np.isfinite(O) & np.isfinite(U)
    sarmal = olc & (O < A['ODM_DUSUK']) & (U >= A['KKU_YUKSEK'])
    saglikli = olc & (O >= A['ODM_TAM']) & (U < A['KKU_DUSUK'])
    out = {}
    for W, tag in ((3, '3M'), (6, '6M'), (O.shape[1], '12M')):
        out[f'OK_DUSUK_ODEME_YUKSEK_KULLANIM_ADET_{tag}'] = sarmal[:, :W].sum(axis=1)
    out['OK_AY_SON_DUSUK_ODEME_YUKSEK_KULLANIM'] = _ilk_true(sarmal)
    out['OK_DUSUK_ODEME_YUKSEK_KULLANIM_SERI'] = _seri_simdi(sarmal)
    out['OK_TAM_ODEME_DUSUK_KULLANIM_ADET_12M'] = saglikli.sum(axis=1)
    out['OK_OLCULEN_AY_12M'] = olc.sum(axis=1)
    return _float_ciktilar(out, df.index, bos_satir=~olc.any(axis=1))


# ------------------------------------------------------------------------------
# DS_* (veride bulunan skora göre): ham veride hazır gelen skorlar (PRED_BK_12_AY_TOP,
# PRED_BK_12_AY_TOP_PERC, PredCs, EXPECTED_LOSS, LTV, LTV_WITH_LOSS) burada yeniden
# hesaplanmaz; yalnızca renk yolu feature'larıyla çarpılır. Bu skorların model
# tarihinden önce hesaplanmış olması gerekir (sonra hesaplanıyorsa sızıntı olur).
#   DS_<skor>_X_<k>   skor x feature. k: RENK_LM (aktif renk kodu), NUKS
#       (RENK_Y_NUKS_FLG), ARTARDA_KOT (RENK_Y_ART_ARDA_KOTULESME_FLG), DUSUS
#       (RENK_Y_SON_IYILESMEDEN_BERI_DUSUS), RISK_SERI (RENK_Y_RISK_SERI_SIMDI),
#       GIZLI_3M (GIZLI_KOTULESEN_SINYAL_3M), ESZ_3M (ESZ_KOTULESEN_SINYAL_3M)
#       örnek PRED_BK_12_AY_TOP = 0.12: X_RISK_SERI = 0.12 x 3 = 0.36,
#       X_GIZLI_3M = 0.48, X_NUKS = 0
#   DS_EXPECTED_LOSS_<P>_ORAN  EXPECTED_LOSS / P; P: KK_RISK (LM), KK_LIMIT (LM),
#       TAUM (3M ort.). örnek EL = 900: 0.118 / 0.1125 / 0.045
# ------------------------------------------------------------------------------
def _dis_skor_features(df, uretilen):
    """Hazir model skorlarini musterinin renk yolu ve gizli kotulesmesiyle caprazlar."""
    def _num(c):
        if c in uretilen:
            return np.asarray(uretilen[c], dtype='float64')
        if c in df.columns:
            return _sayi(df, c)
        return None

    capraz = {
        'RENK_LM': 'RENK_LM',
        'RENK_Y_NUKS_FLG': 'NUKS',
        'RENK_Y_ART_ARDA_KOTULESME_FLG': 'ARTARDA_KOT',
        'RENK_Y_SON_IYILESMEDEN_BERI_DUSUS': 'DUSUS',
        'RENK_Y_RISK_SERI_SIMDI': 'RISK_SERI',
        'GIZLI_KOTULESEN_SINYAL_3M': 'GIZLI_3M',
        'ESZ_KOTULESEN_SINYAL_3M': 'ESZ_3M',
    }
    out = {}
    for skor in _fe_ayarlar()['DIS_SKORLAR']:
        S = _num(skor)
        if S is None:
            continue
        for kaynak, kisa in capraz.items():
            X = _num(kaynak)
            if X is None:
                continue
            if kaynak == 'RENK_LM':
                X = np.where(np.isin(X, _renk_kodlari()[1]), X, np.nan)
            out[f'DS_{skor}_X_{kisa}'] = S * X
    el = _num('EXPECTED_LOSS')
    if el is not None:
        for payda, kisa in (('KK_RISK_LM', 'KK_RISK'), ('KK_LIMIT_LM', 'KK_LIMIT'),
                            ('TAUM_TUT_AVG_3M', 'TAUM')):
            P = _num(payda)
            if P is not None:
                out[f'DS_EXPECTED_LOSS_{kisa}_ORAN'] = _oran_nan(el, P)
    return _float_ciktilar(out, df.index) if out else {}


def _olay_matrisleri(df):
    """Olay adi -> (olay matrisi [durum veya gecis], olculebilir matrisi)."""
    A = _fe_ayarlar()
    olaylar = {}
    R = _seri_matrisi(df, 'RENK')
    if R is not None:
        R[~np.isin(R, _renk_kodlari()[1])] = np.nan
        okR = np.isfinite(R)
        olaylar['RISK'] = (okR & (R <= A['RENK_RISK_ESIK']), okR)
        olaylar['KIRMIZI'] = (okR & (R == _renk_kodlari()[2]), okR)
        d, pair = _hareketler(R)
        olaylar['RENK_KOTULESME'] = (pair & (d < 0), pair)
    U = _kk_kullanim_matrisi(df)
    if U is not None:
        okU = np.isfinite(U)
        olaylar['KKU_90'] = (okU & (U >= 0.9), okU)
        olaylar['KKU_ASIM'] = (okU & (U >= 1.0), okU)
    O = _seri_matrisi(df, 'KK_ODEME_ORANI')
    if O is not None:
        okO = np.isfinite(O)
        olaylar['DUSUK_ODEME'] = (okO & (O < A['ODM_DUSUK']), okO)
    L = _seri_matrisi(df, 'KK_LIMIT')
    if L is not None:
        d, pair = _hareketler(np.where(L > 0, L, np.nan))
        olaylar['LIMIT_DUSUS'] = (pair & (d < 0), pair)
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        d, pair = _hareketler(M)
        olaylar[f'{base}_BOZULMA'] = (pair & (yon * d < 0), pair)
    return olaylar


# ------------------------------------------------------------------------------
# YB_* (30): müşteri için yeni başlayan olaylar. Yakın = son 3 ay (LM..L3M),
# geçmiş = L4M..L12M. Yakında en az 1, geçmişte en az 3 ölçülebilir ay yoksa NaN.
# Olaylar (12): RISK, KIRMIZI, RENK_KOTULESME, KKU_90 (kullanım >= %90), KKU_ASIM
# (>= %100), DUSUK_ODEME (< %20), LIMIT_DUSUS ve <seri>_BOZULMA (KKB_SKOR,
# KK_ODEME_ORANI, KK_KULLANIM, DAV_SKOR, MMS: bir ayda kötü yöne hareket).
#   YB_<olay>_YENI     son 3 ayda var, geçmişte hiç yok
#       örnek: KIRMIZI 1 (L3M-L2M kırmızı, öncesi hiç değil), RISK 1, KKU_90 1, LIMIT_DUSUS 1
#   YB_<olay>_TEKRAR   hem son 3 ayda hem geçmişte var
#       örnek: DUSUK_ODEME 1 (L4M %15), RENK_KOTULESME 1 (L5M -> L4M de düşüş)
#   YB_YENI_OLAY_SAYISI  YENI olan olay sayısı                              4
#   YB_<seri>_YENI_DIP   LM, önceki 11 ayın en kötüsünden de kötü
#       örnek: KKB_SKOR 1, DAV_SKOR 1, MMS 1, KK_ODEME_ORANI 0 (L2M %10 daha kötüydü)
# ------------------------------------------------------------------------------
def _yeni_baslangic_features(df):
    """Son 3 ayda olup onceki aylarda hic olmayan olaylar (musteri icin yeni)."""
    out = {}
    yeni_sayi = None
    olculen = None
    for ad, (E, ok) in _olay_matrisleri(df).items():
        yakin, gecmis = slice(0, 3), slice(3, None)
        yakin_olc = ok[:, yakin].any(axis=1)
        gecmis_olc = ok[:, gecmis].sum(axis=1) >= 3
        olc = yakin_olc & gecmis_olc
        simdi = E[:, yakin].any(axis=1)
        once = E[:, gecmis].any(axis=1)
        yeni = simdi & ~once
        out[f'YB_{ad}_YENI'] = np.where(olc, yeni, np.nan)
        out[f'YB_{ad}_TEKRAR'] = np.where(olc, simdi & once, np.nan)
        yeni_sayi = (0 if yeni_sayi is None else yeni_sayi) + (olc & yeni)
        olculen = (0 if olculen is None else olculen) + olc
    if yeni_sayi is not None:
        out['YB_YENI_OLAY_SAYISI'] = np.where(olculen > 0, yeni_sayi, np.nan)
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        Y = yon * M
        okg = np.isfinite(Y[:, 1:])
        gecmis_en_kotu = np.where(okg, Y[:, 1:], np.inf).min(axis=1)
        olc = np.isfinite(Y[:, 0]) & (okg.sum(axis=1) >= 3)
        out[f'YB_{base}_YENI_DIP'] = np.where(olc, Y[:, 0] < gecmis_en_kotu, np.nan)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# OG_* (15 = 5 seri x 3): son renk kötüleşmesinden 1-3 ay önce göstergeler bozulmuş
# muydu, ve aynı bozulma şimdi renk düşmeden tekrar ediyor mu. Seri adları:
# KKB, ODM, KKU (kart kullanımı), DAV, MMS; <P>_D_* ailesiyle aynı kısaltmalar.
# Renk 12 ayda hiç kötüleşmediyse NaN.
# Örnek: son renk düşüşü L4M -> L3M; öncesindeki 3 geçiş L5M -> L4M, L6M -> L5M,
# L7M -> L6M. KKB üçünde de düştü.
#   OG_<s>_ONCE_BOZULMA_ADET  o 3 geçişte göstergenin bozulduğu geçiş sayısı   KKB 3
#   OG_<s>_ONCU_AY            renk düşüşüne en yakın bozulma kaç geçiş önce     KKB 1
#   OG_<s>_DESEN_TEKRARI      önce bozulma vardı, son 2 geçişte gösterge yine
#                             bozuluyor ve renk son 2 geçişte düşmedi          KKB 1
#       (ODM 0: ödeme oranı son 2 geçişte bozulmadı, 10 -> 10 -> 25)
# ------------------------------------------------------------------------------
def _oncu_gecikme_features(df):
    """Musterinin son renk dususunden once skorlari kac ay once bozulmustu?"""
    R = _seri_matrisi(df, 'RENK')
    if R is None:
        return {}
    R[~np.isin(R, _renk_kodlari()[1])] = np.nan
    dR, pR = _hareketler(R)
    renk_kot = pR & (dR < 0)
    t = _ilk_true(renk_kot)
    var = np.isfinite(t)
    ti = np.where(var, t, 0).astype(int)
    ar = np.arange(len(df))
    son2_renk_kot = renk_kot[:, :2].any(axis=1)
    out = {}
    for base, (M, yon) in _yonlu_seriler(df).items():
        if base == 'RENK':
            continue
        d, pair = _hareketler(M)
        boz = pair & (yon * d < 0)
        T1 = boz.shape[1]
        adet = np.zeros(len(df))
        olc = np.zeros(len(df))
        oncu_ay = np.full(len(df), np.nan)
        for k in (3, 2, 1):
            j = ti + k
            gecerli = var & (j < T1)
            jj = np.where(gecerli, j, 0)
            b = gecerli & boz[ar, jj]
            o = gecerli & pair[ar, jj]
            adet += b
            olc += o
            oncu_ay = np.where(b, k, oncu_ay)
        P = 'KKU' if base == 'KK_KULLANIM' else _fe_ayarlar()['SERI_TANIM'].get(base, (base,))[0]
        out[f'OG_{P}_ONCE_BOZULMA_ADET'] = np.where(olc > 0, adet, np.nan)
        out[f'OG_{P}_ONCU_AY'] = np.where(olc > 0, oncu_ay, np.nan)
        simdi_boz = boz[:, :2].any(axis=1)
        out[f'OG_{P}_DESEN_TEKRARI'] = np.where(
            olc > 0, (adet > 0) & simdi_boz & ~son2_renk_kot, np.nan)
    return _float_ciktilar(out, df.index) if out else {}


# ------------------------------------------------------------------------------
# Ana fonksiyon: aileleri sırayla üretir. DS_* en sonda, çünkü RENK_Y_, GIZLI_ ve
# ESZ_ çıktılarını kullanır. Ham kolonla aynı isimli üretilen kolonlar atılır.
# Dönüş: (ham kolonlar + yeni feature'lar, yeni feature isimleri).
# ------------------------------------------------------------------------------
def feature_engineering(df):
    """Tum feature gruplarini uretir. (df_eng, yeni_feature_isimleri) doner."""
    out = {}
    for fn in (_renk_features, _renk_yol_features,
               _dav_features, _mms_features, _kkb_features,
               _odeme_features, _ratio_features, _kk_features,
               _seri_dinamik_features, _eszamanli_features,
               _gizli_kotulesme_features, _int_degisim_features,
               _borc_varlik_features, _kk_olay_features,
               _odeme_kullanim_features, _yeni_baslangic_features,
               _oncu_gecikme_features):
        out.update(fn(df))
    out.update(_dis_skor_features(df, out))
    eng = pd.DataFrame(out, index=df.index)
    eng = eng.loc[:, ~eng.columns.duplicated()]
    eng = eng.loc[:, ~eng.columns.isin(df.columns)]
    return pd.concat([df, eng], axis=1), list(eng.columns)
