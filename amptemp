def _desen_ornegi():
    """DESEN_ORNEK_MODEL'in model.pkl'inden desen tablosu: ((renk, vade, hedef), desen_kodlama) ya da (None, None).
    Model yoksa önce aynı renkteki, sonra herhangi bir modelin paketi denenir."""
    if not DESEN_ORNEK_MODEL:
        return None, None
    import pickle
    import warnings
    kod0, v0, a0 = DESEN_ORNEK_MODEL
    adaylar = [(kod0, v0, a0)] + [m for m in TUM_MODELLER if m[0] == kod0] + list(TUM_MODELLER)
    denenen = set()
    for kod, v, a in adaylar:
        if (kod, v, a) in denenen or (v, a) not in MODELLER or kod not in MODELLER[(v, a)]["renkler"]:
            continue
        denenen.add((kod, v, a))
        ad = next(x for c, x, _ in RENKLER if c == kod)
        yol = f"/{MODELLER[(v, a)]['klasor']}/renk_{kod}_{ad}_model.pkl"
        try:
            with mf.get_download_stream(yol) as s:
                ham = s.read()
            with warnings.catch_warnings():
                warnings.filterwarnings("ignore", message=r"Trying to unpickle estimator")
                paket = pickle.loads(ham)
            ds = paket.get("desen_kodlama") if isinstance(paket, dict) else None
            if ds and ds.get("haritalar"):
                _log(f"Desen örneği: {yol} ({_adet(ds.get('n_tablo', 0))} eğitim müşterisi)")
                return (kod, v, a), ds
        except Exception as e:
            _log(f"⚠ Desen örneği için {yol} okunamadı ({type(e).__name__}); sıradaki model deneniyor")
        if len(denenen) >= 5:
            break
    _log("⚠ Desen örneği: hiçbir model paketinde desen tablosu okunamadı; örnek yalnızca kodlarla yazılacak")
    return None, None


