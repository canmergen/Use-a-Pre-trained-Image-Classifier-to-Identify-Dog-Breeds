   verisiyle cizilir; asagidaki iskelet YALNIZCA henuz baglanmamis
   sekmeler icindir (dagilim, iliski). */
const ANALIZ_ICERIK = {
    dagilim: {
        kartlar: [
            {grafik: "Histogram"},
            {baslik: "Yüzdelik", satirlar: ["min / p1 / p25 / medyan", "p75 / p99 / maks"]},
