        ('train', train, _train_split_raw),
        ('val', val, _val_split_raw),
        ('oot', oot, _oot_raw),
    ):
        if not _actual.index.equals(_expected.index):
            raise RuntimeError(f'{etiket}: {_name} preprocess index/satir degistirdi.')
        if any(c not in _actual.columns for c in FEATURES + [TARGET]):
            raise RuntimeError(f'{etiket}: {_name} preprocess sutun kaybetti.')
        if not _actual[TARGET].equals(_expected[TARGET]):
            raise RuntimeError(f'{etiket}: {_name} preprocess hedefi degistirdi.')
    del _oot_raw, _train_split_raw, _val_split_raw, _frame, _actual, _expected
    gc.collect()
    print(f'  ✓ Train {len(train):,} / Val {len(val):,} / OOT {len(oot):,}; '
          f'preprocess={PREPROCESS_MODU}')
    if train[TARGET].nunique() < 2 or val[TARGET].nunique() < 2:
        print('  train veya val tek sinif, atlandi'); continue
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_val_index.csv',
               pd.DataFrame({'idx': val.index}))
    _VAL_IDX = set(val.index)
    print(f'  ✓ val index kaydedildi ({len(_VAL_IDX):,} satir)')

    # 3b) Desen kodlaması (DSN_*): tablo train'den, sonuç LM renk değişimi; hedef yok.
    _ds_paket = None
    if DESEN_AKTIF:
        _ds_yeni, _ds_paket = _desen_kodla(train, val, oot)
        FEATURES = FEATURES + [c for c in _ds_yeni if c not in FEATURES]
        if _ds_paket is None:
            print('  Desen kodlamasi: LM renk degisimi olculemedi, atlandi.')
        else:
            print(f'  ✓ Desen kodlamasi (hedefsiz): {len(_ds_yeni)} feature; tablo train\'den, '
                  f'{_ds_paket["n_tablo"]:,} satir, LM kotulesme orani {_ds_paket["genel_oran"]:.3f}')
            _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_desen_dagilim.csv',
                       _desen_dagilim(train, val, oot, _ds_yeni))


    # 4) FEATURE ELEME: yalnızca train. val ve OOT'ye yalnızca kalan liste uygulanır.
    _before = len(FEATURES)
    _aday_tum = list(FEATURES)
    y = train[TARGET]
    Xf = train[FEATURES]

    # Eleme öncesi havuz: elemeye giren tüm kolonlar (ham + FE + DSN). Eleme bitince aynı dosya
    # her kolonun sonucuyla (hangi adımda elendiği / seçildiği) yeniden yazılır.
    _ham_set, _fe_set = set(_raw_guvenli), set(_yeni)

    def _kaynak_tipi(c):
        return 'HAM' if c in _ham_set else ('FE' if c in _fe_set else 'DSN')

    _havuz_df = pd.DataFrame({'feature': _aday_tum, 'havuz_sira': range(1, len(_aday_tum) + 1),
                              'kaynak': [_kaynak_tipi(c) for c in _aday_tum]})
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_eleme_oncesi_featurelar.csv', _havuz_df)
    _kt = _havuz_df['kaynak'].value_counts()
    print(f"  Eleme oncesi havuz: {len(_aday_tum)} feature (ham {int(_kt.get('HAM', 0))}, "
          f"FE {int(_kt.get('FE', 0))}, DSN {int(_kt.get('DSN', 0))}) -> "
          f"renk_{RENK_KOD}_{renk_adi}_eleme_oncesi_featurelar.csv")

    # 4a) Sabit / neredeyse sabit: en sık değerin payı %99'dan fazla (boş dahil).
    #     Aynı geçişte her kolonun train dolu oranı, en sık değer payı ve tekil değer sayısı tutulur.
    _adim('eleme_4abc')
    print("  ▶ 4a) Sabit / neredeyse sabit değişken elemesi başladı...")
    drop_const, _ist = [], {}
    for c in FEATURES:
        _vc = Xf[c].value_counts(normalize=True, dropna=False)
        _en_sik = float(_vc.iloc[0]) if len(_vc) else 1.0
        _ist[c] = (float(Xf[c].notna().mean()), _en_sik, int((_vc > 0).sum()))
        if _en_sik > 0.99:
            drop_const.append(c)
    FEATURES = [c for c in FEATURES if c not in drop_const]
    del Xf
    print(f"  ✓ Sabit eleme bitti (elenen {len(drop_const)})")

    # 4b) Hedef ilişkisi (|Spearman| / Cramer V) ve korelasyon matrisi; yalnızca train.
    print('  ▶ 4b) Train-only Spearman / Cramer V hesaplanıyor...')
    _t4b = time.time()
    _num_cols = train.iloc[:0][FEATURES].select_dtypes(include=np.number).columns.tolist()
    _samp = train
    if CORR_MAX_ROWS is not None and len(train) > CORR_MAX_ROWS:
        # Korelasyon matrisi için stratified örneklem (CORR_MAX_ROWS).
        _samp = train.loc[train_test_split(
            train.index, train_size=CORR_MAX_ROWS,
            stratify=train[TARGET], random_state=RANDOM_STATE,
        )[0].sort_values()]
    _num_corr, _n_desen = (_spearman_matris(_samp, _num_cols)
                           if _num_cols else (pd.DataFrame(), 0))
    _hedef_kaynak = train if HEDEF_ILISKI_TUM_VERI else _samp
    tgt_assoc, _tanimsiz = _hedef_spearman(_hedef_kaynak, _num_cols, TARGET)
    if _tanimsiz:
        # Dolu degerleri tek degerli: Spearman tanimsiz, bilgi yalnizca dolu/bos ayriminda.
        print(f'  Bilgi: {len(_tanimsiz)} kolonda dolu degerler tek degerli; '
              f'hedef iliskisi 0 alindi, kolon elenmez: '
              f'{[c for c in _num_cols if c in _tanimsiz]}')
    for c in FEATURES:
        if c not in tgt_assoc:
            tgt_assoc[c] = float(_cramers_v(_hedef_kaynak[c], _hedef_kaynak[TARGET]))
    print(f'  ✓ Korelasyon matrisi: {len(_samp):,} satir ({_n_desen} bos deseni) | '
          f'hedef iliskisi: {len(_hedef_kaynak):,} satir | {(time.time() - _t4b) / 60:.1f} dk')

    # 4c) Spearman |r| > CORR_ESIK olan çiftlerde hedef ilişkisi yüksek olan kalır.
    print(f'  ▶ 4c) Korelasyon elemesi (Spearman |r|>{CORR_ESIK})...')
    _C = _num_corr.reindex(index=_num_cols, columns=_num_cols).fillna(0.0)
    _kept, _drop_corr, _kor_es = [], set(), {}
    for c in sorted(_num_cols, key=lambda k: -tgt_assoc.get(k, 0.0)):
        if _kept:
            _rk = _C.loc[c, _kept]
            if (_rk > CORR_ESIK).any():
                _drop_corr.add(c)
                _kor_es[c] = (str(_rk.idxmax()), float(_rk.max()))   # en yüksek korelasyonlu kalan kolon
                continue
        _kept.append(c)
    drop_corr = [c for c in FEATURES if c in _drop_corr]
    FEATURES = [c for c in FEATURES if c not in _drop_corr]
    print(f'  ✓ const-{len(drop_const)} corr-{len(drop_corr)}; '
          f'feature {_before}->{len(FEATURES)}')
    if not FEATURES:
        print('  tum feature elendi, atlandi'); continue

    # 4d) SHAPRFECV: yalnızca train.
    _adim('SHAP')
    print('  ▶ 4d) SHAPRFECV feature selection...')
    _thread_ayarla('SHAP oncesi')
    _shap_baslangic = len(FEATURES)
    _shap_oncesi = list(FEATURES)
    # SHAP hatası sessizce geçilmez; ne yapılacağı SHAP_HATA_MODU'na göre.
    try:
        FEATURES, shap_report, shap_bilgi = _select_shap_features(
            train, y, FEATURES, etiket, f'renk_{RENK_KOD}_{renk_adi}', df_eng_r
        )
    except Exception as exc:
        _hata = {'renk': etiket, 'hata_tipi': type(exc).__name__,
                 'mesaj': str(exc), 'n_feature_shap_oncesi': len(FEATURES),
                 'hata_modu': SHAP_HATA_MODU}
        shap_hatalari.append(_hata)
        _model_yaz('renk_bazli_shap_hatalari.csv', pd.DataFrame(shap_hatalari))
        _msg = str(exc).rstrip('.')  # f-string icinde tirnak tekrari <3.12'de SyntaxError
        if SHAP_HATA_MODU == 'durdur':
            print(f'  ✗ SHAPRFECV HATASI ({type(exc).__name__}): {_msg}. Pipeline durduruluyor.')
            raise
        if SHAP_HATA_MODU == 'rengi_atla':
            print(f'  ✗ SHAPRFECV HATASI ({type(exc).__name__}): {_msg}. '
                  f'{etiket} MODELLENMEDI (SHAP_HATA_MODU=rengi_atla).')
            continue
        if SHAP_HATA_MODU == 'importance_yedek':
            print(f'  ⚠⚠ SHAPRFECV HATASI ({type(exc).__name__}): {_msg}. '
                  f'Yedek: train-only LightGBM gain importance ile ilk '
                  f'{SHAP_MAX_FEATURES} feature secilecek.')
            _n_once = len(FEATURES)
            FEATURES, _n_yedek = _importance_yedek_secim(train, y, FEATURES)
            print(f'  ✓ Yedek secim: {_n_once} -> {len(FEATURES)} '
                  f'({_n_yedek:,} train satiri)')
            shap_report = None
            # CV skoru yok -> performans kisiti DOGRULANAMADI (None, 1 degil).
            shap_bilgi = {'shap_durum': 'hata_importance_yedek',
                          'shap_performans_ok': None,
                          'shap_n_satir': _n_yedek}
            _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_shaprfecv_secilen.csv',
                       pd.DataFrame({'feature': FEATURES, 'sira': range(len(FEATURES)),
                                     'kaynak': 'importance_yedek'}))
        elif SHAP_HATA_MODU == 'shapsiz_devam':
            print(f'  ⚠⚠ SHAPRFECV HATASI ({type(exc).__name__}): {_msg}. '
                  f'SHAP_HATA_MODU=shapsiz_devam -> {len(FEATURES)} feature ile '
                  f'SECIMSIZ devam. Ozet ve pakette isaretlenir.')
            shap_report = None
            shap_bilgi = {'shap_durum': 'hata_shapsiz_devam'}
        else:
            raise ValueError(f'Bilinmeyen SHAP_HATA_MODU: {SHAP_HATA_MODU}') from exc
    _shap_elenen = _shap_baslangic - len(FEATURES)
    # SHAP_MAX_FEATURES tavani SERT kontrol (shapsiz_devam ve SHAP kapali haric).
    if (SHAP_MAX_FEATURES is not None and len(FEATURES) > SHAP_MAX_FEATURES
            and shap_bilgi.get('shap_durum') not in ('hata_shapsiz_devam', 'kapali')):
        raise RuntimeError(f'{etiket}: secilen {len(FEATURES)} feature > '
                           f'SHAP_MAX_FEATURES={SHAP_MAX_FEATURES}.')
    print(f'  ✓ SHAPRFECV elenen={_shap_elenen}, kalan={len(FEATURES)} '
          f'(durum={shap_bilgi.get("shap_durum")})')

    # Eleme sonucu: havuzdaki her kolonun hangi adımda elendiği ya da seçildiği.
    _shap_tur = {}
    if shap_report is not None and 'eliminated_features' in shap_report.columns:
        for _tur, (_elenen, _n_tur) in enumerate(zip(shap_report['eliminated_features'],
                                                     shap_report['num_features']), start=1):
            for _c in (_elenen if isinstance(_elenen, (list, tuple)) else []):
                _shap_tur.setdefault(_c, (_tur, int(_n_tur)))
    _secilen_sira = {c: i for i, c in enumerate(FEATURES, start=1)}
    _const_set, _shap_oncesi_set = set(drop_const), set(_shap_oncesi)
    _adim_l, _detay_l = [], []
    for c in _aday_tum:
        if c in _secilen_sira:
            _adim_l.append('SECILDI')
            _detay_l.append(f'secildi ({_secilen_sira[c]}. sira)')
        elif c in _const_set:
            _adim_l.append('4a_SABIT')
            _detay_l.append(f'en sik deger payi {_ist[c][1]:.4f} > 0.99 (bos dahil)')
        elif c in _drop_corr:
            _p, _r = _kor_es.get(c, ('?', np.nan))
            _adim_l.append('4c_KORELASYON')
            _detay_l.append(f'{_p} ile |Spearman| {_r:.3f} > {CORR_ESIK}; hedef iliskisi daha dusuk oldugu icin elendi')
        elif c in _shap_tur:
            _t, _n = _shap_tur[c]
            _adim_l.append('4d_SHAP')
            _detay_l.append(f'SHAPRFECV {_t}. tur: {_n} feature icinde SHAP onemi en dusukler arasinda')
        elif c in _shap_oncesi_set:
            _adim_l.append('4d_SHAP')
            _detay_l.append(f'secilen sete girmedi (shap_durum={shap_bilgi.get("shap_durum")})')
        else:
            _adim_l.append('BILINMIYOR')
            _detay_l.append('')
    _havuz_df['train_dolu_orani'] = [round(_ist[c][0], 4) if c in _ist else np.nan for c in _aday_tum]
    _havuz_df['en_sik_deger_payi'] = [round(_ist[c][1], 4) if c in _ist else np.nan for c in _aday_tum]
    _havuz_df['tekil_deger_bos_dahil'] = [_ist[c][2] if c in _ist else np.nan for c in _aday_tum]
    _havuz_df['hedef_iliskisi'] = [round(float(tgt_assoc[c]), 4) if c in tgt_assoc else np.nan for c in _aday_tum]
    _havuz_df['eleme_adimi'] = _adim_l
    _havuz_df['eleme_detay'] = _detay_l
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_eleme_oncesi_featurelar.csv', _havuz_df)
    print(f'  Eleme hunisi: havuz {len(_aday_tum)} -> 4a sonrasi {len(_aday_tum) - len(drop_const)} -> '
          f'4c sonrasi {len(_shap_oncesi)} -> secilen {len(FEATURES)} (SHAP_MAX_FEATURES={SHAP_MAX_FEATURES})')

    _tgt_sirali = sorted(((c, tgt_assoc.get(c, 0.0)) for c in FEATURES),
                        key=lambda kv: kv[1], reverse=True)
    print(f'  --- Hedef ilişkisi, secilen {len(_tgt_sirali)} feature (SHAP secimi sonrasi) ---')
    for c, v in _tgt_sirali:
        print(f'    {v:7.4f}  {c}')

    # OOT PSI nihai model kurulduktan sonra yalnızca raporlanır (7b).
    psi_scores = {}
    _kaymis, _dikkat = [], []

    # Seçimden sonra ön işleme tekrar çalıştırılmaz; aynı train / val / OOT kullanılır.
    print('  ▶ 4e) Train/val/OOT secilen kolonlarla hazir...')
    print(f'  ✓ Bölme: train {len(train)} / val {len(val)} / oot {len(oot)}')

    print('  ▶ Kalan feature listesi hazırlanıyor...')
    iv_scores = {c: _quick_iv(train[c], train[TARGET]) for c in FEATURES}
    feat_df = pd.DataFrame([
        {'feature': c,
         'sira': i,
         'tgt_assoc': round(tgt_assoc.get(c, np.nan), 4),
         'iv': round(iv_scores.get(c, np.nan), 4)}
        for i, c in enumerate(FEATURES)
    ])

    # 5) Matrisler: val ve OOT, train'de kalan feature listesiyle kesilir.
    X_tr, y_tr = train[FEATURES], train[TARGET]
    X_val, y_val = val[FEATURES], val[TARGET]
    X_oot, y_oot = oot[FEATURES], oot[TARGET]
    print(f"  ✓ Matrisler hazır - train {X_tr.shape} / val {X_val.shape} / oot {X_oot.shape}")

    # 6) Optuna: N_ITER deneme; her denemede train'de tek fit, val'de ölçüm.
    _adim('Optuna')
    _thread_ayarla('Optuna oncesi')
    print(f"  ▶ 6) Model denemeye başlandı (Optuna, {N_ITER} trial, "
          f"train/val tek fit, LGB n_jobs={LGB_JOBS})...")
    spw = (len(y_tr) - y_tr.sum()) / max(y_tr.sum(), 1)

    # Arama uzayı pozitif sayısına göre 3 katman: BUYUK (> 100k pozitif) derinlik <= 8,
    # yaprak <= 127; ORTA (> 10k) 5 / 31; KUCUK 4 / 15. min_child_samples üst sınırı
    # pozitif / 10 (100-1500 arası). Az pozitifli renkte geniş uzay ezberler.
    _npos = int(y_tr.sum())
    _orta = _npos > 10_000
    _buyuk = _npos > 100_000

    _maxd = 8 if _buyuk else (5 if _orta else 4)
    _maxl = 127 if _buyuk else (31 if _orta else 15)
    _mcs_min = 50
    _mcs_max = min(1500, max(100, _npos // 10))

    # Aşırı öğrenme eşiği: ORTA ve BUYUK'ta GAP_TR_VAL_ESIK, KUCUK'ta _KUCUK.
    _gap_esik = GAP_TR_VAL_ESIK if _orta else GAP_TR_VAL_ESIK_KUCUK

    _katman = 'BUYUK' if _buyuk else ('ORTA' if _orta else 'KUCUK')
    print(f"  pozitif={_npos:,} [{_katman}] -> max_depth<={_maxd}, "
          f"num_leaves<={_maxl}, min_child_samples {_mcs_min}-{_mcs_max}, "
          f"gap eşiği={_gap_esik}")

    # scale_pos_weight, 1.0 ile dengeleyen değer (negatif / pozitif) arasında log
    # ölçekte aranır; renkler arasında 0.3 ile 1300 arası değişir.
    _spw_lo, _spw_hi = min(1.0, spw), max(1.0, spw)
    if not (_spw_hi > _spw_lo * 1.001):  # oran ~1.0 ise aralık dejenere
        _spw_lo, _spw_hi = 0.8, 1.25
    print(f"  scale_pos_weight aralığı: {_spw_lo:.3f} - {_spw_hi:.3f} "
          f"(dengeleyen değer {spw:.3f})")

    base = lgb.LGBMClassifier(objective='binary', metric='auc', max_bin=63,
                             random_state=RANDOM_STATE, n_jobs=LGB_JOBS, verbose=-1)

    # subsample_freq Optuna'da aranmaz; parametrelere elle eklenir, yoksa bagging kapanır
    # ve doğrulanandan farklı bir model eğitilir.
    SABIT_PARAMS = {'subsample_freq': 1}
    _t0 = time.time()

    # Her denemenin tam kaydı (parametreler dahil) renk_*_denenen_modeller.csv'ye.
    trial_kayitlari = []

    def objective(trial):
        params = {
            'max_depth':         trial.suggest_int('max_depth', 2, _maxd),
            'num_leaves':        trial.suggest_int('num_leaves', 4, _maxl),
            # Ağaç sayısı ve öğrenme hızı aralığı büyük renklerde daha geniş.
            'n_estimators':      trial.suggest_int('n_estimators',
                                                  300 if _buyuk else 200,
                                                  800 if _buyuk else 400),
            'learning_rate':     trial.suggest_float('learning_rate',
                                                    0.02 if _buyuk else 0.01,
                                                    0.10 if _buyuk else 0.05, log=True),
            'min_child_samples': trial.suggest_int('min_child_samples', _mcs_min, _mcs_max),
            # L2 alt sınırı: büyük renkte 0.1, küçük renkte 5.
            'reg_lambda':        trial.suggest_float('reg_lambda',
                                                    0.1 if _buyuk else 5.0, 50, log=True),
            'scale_pos_weight':  trial.suggest_float('scale_pos_weight',
                                                    _spw_lo, _spw_hi, log=True),
            'reg_alpha':         trial.suggest_float('reg_alpha', 0.0, 10.0),
            'colsample_bytree':  trial.suggest_float('colsample_bytree', 0.4, 0.7),
            'subsample':         trial.suggest_float('subsample', 0.6, 0.8),
            **SABIT_PARAMS,
        }

        model = clone(base).set_params(**params)
        model.fit(X_tr, y_tr)

        _ptr = model.predict_proba(X_tr)[:, 1]
        _pval = model.predict_proba(X_val)[:, 1]
        train_gini = 2 * roc_auc_score(y_tr, _ptr) - 1
        val_gini = 2 * roc_auc_score(y_val, _pval) - 1

        # Amaç: val Capture@10.
        cap_tr = _capture_at(y_tr, _ptr, CAPTURE_PCT)
        cap_val = _capture_at(y_val, _pval, CAPTURE_PCT)

        # Bucket izleme (yalnızca log).
        lift1, tavan_pct, mono = _bucket_metrik(y_val, _pval, N_BUCKET_IZLEME)

        # OOT yalnızca TRIAL_OOT=True ise ve yalnızca log için skorlanır; seçime girmez.
        oot_g, cap_oot = np.nan, np.nan
        if TRIAL_OOT and y_oot.nunique() >= 2:
            _poot = model.predict_proba(X_oot)[:, 1]
            oot_g = 2 * roc_auc_score(y_oot, _poot) - 1
            cap_oot = _capture_at(y_oot, _poot, CAPTURE_PCT)

        gap_tr_val = train_gini - val_gini
        gap_tr_oot = (train_gini - oot_g) if np.isfinite(oot_g) else np.nan
        gap_val_oot = (val_gini - oot_g) if np.isfinite(oot_g) else np.nan

        # Kural: train Gini - val Gini <= eşik; aşan deneme cezalı skor alır.
        kural_ok = bool(gap_tr_val <= _gap_esik)

        # Skor ve ceza AYNI ölçekte (capture, 0-1).
        skor = cap_val - GAP_CEZA * max(0.0, gap_tr_val - _gap_esik)

        trial.set_user_attr('capture_val', float(cap_val))
        trial.set_user_attr('capture_tr', float(cap_tr))
        trial.set_user_attr('capture_oot', float(cap_oot) if np.isfinite(cap_oot) else None)
        trial.set_user_attr('train_gini', float(train_gini))
        trial.set_user_attr('val_gini', float(val_gini))
        trial.set_user_attr('oot_gini', float(oot_g) if np.isfinite(oot_g) else None)
        trial.set_user_attr('gap_tr_val', float(gap_tr_val))
        trial.set_user_attr('gap_tr_oot', float(gap_tr_oot) if np.isfinite(gap_tr_oot) else None)
        trial.set_user_attr('kural_ok', kural_ok)

        # Kayıt: denemenin metrikleri ve tüm parametreleri ayrı sütunlarda.
        kayit = {
            'renk':               etiket,
            'trial':              trial.number,
            'objective':          round(float(skor), 6),
            'capture_val':        round(float(cap_val), 6),
            'capture_tr':         round(float(cap_tr), 6),
            'capture_oot':        round(float(cap_oot), 6) if np.isfinite(cap_oot) else None,
            'capture_pct':        CAPTURE_PCT,
            'val_lift1':          round(float(lift1), 4) if np.isfinite(lift1) else None,
            'val_lift1_tavan_pct': round(float(tavan_pct), 4) if np.isfinite(tavan_pct) else None,
            'val_monoton':        round(float(mono), 4) if np.isfinite(mono) else None,
            'train_gini':         round(float(train_gini), 6),
            'val_gini':           round(float(val_gini), 6),
            'oot_gini':           round(float(oot_g), 6) if np.isfinite(oot_g) else None,
            'gap_tr_val':         round(float(gap_tr_val), 6),
            'gap_val_oot':        round(float(gap_val_oot), 6) if np.isfinite(gap_val_oot) else None,
            'gap_tr_oot':         round(float(gap_tr_oot), 6) if np.isfinite(gap_tr_oot) else None,
            'gap_esik':           _gap_esik,
            'kural_ok':           int(kural_ok),
            'n_feature':          len(FEATURES),
            'sure_dk':            round((time.time() - _t0) / 60, 3),
        }
        kayit.update({f'p_{k}': v for k, v in params.items()})  # tüm hiperparametreler
        kayit['params_json'] = json.dumps(params)                # tek sütunda tam kopya
        trial_kayitlari.append(kayit)

        if TRIAL_LOG:
            _dk = (time.time() - _t0) / 60
            _o = f' oot={cap_oot:.4f}' if np.isfinite(cap_oot) else ''
            _og = f'oot={oot_g:.4f}' if np.isfinite(oot_g) else ''
            print(f'  [{trial.number+1:>3}/{N_ITER}] {_dk:5.1f}dk | '
                  f'CAP10 val={cap_val:.4f}{_o} | '
                  f'lift1={lift1:.2f}({tavan_pct:.0%} tavan) mono={mono:.0%} | '
                  f'gini tr={train_gini:.4f} val={val_gini:.4f} {_og} | '
                  f'gap tv={gap_tr_val:.4f} {"OK" if kural_ok else "RED"} '
                  f'skor={skor:.4f} | '
                  f'd={params["max_depth"]} lv={params["num_leaves"]:>2} '
                  f'n={params["n_estimators"]:>3} lr={params["learning_rate"]:.3f} '
                  f'mcs={params["min_child_samples"]:>4} '
                  f'spw={params["scale_pos_weight"]:.2f} '
                  f'l2={params["reg_lambda"]:5.1f} l1={params["reg_alpha"]:4.1f} '
                  f'col={params["colsample_bytree"]:.2f} sub={params["subsample"]:.2f}',
                  flush=True)

        return skor

    study = optuna.create_study(direction='maximize',
                                sampler=optuna.samplers.TPESampler(seed=RANDOM_STATE))
    study.optimize(objective, n_trials=N_ITER)
    print(f'  ✓ Model denemesi bitti (Optuna, {(time.time() - _t0)/60:.1f} dk).')

    # En iyi deneme: kuralı sağlayanlar arasından.
    _uygun = [t for t in study.trials
              if t.value is not None and t.user_attrs.get('kural_ok')]
    _esit_trial_no = set()
    if _uygun:
        print(f'  ✓ Kural (train-val gini <= {_gap_esik}) sağlayan trial: '
              f'{len(_uygun)}/{len([t for t in study.trials if t.value is not None])}')
        # Capture eşitlik bandı (1-SE, en fazla SHAP_MAX_KAYIP x tavan) içindekilerden
        # Gini'si en iyiye SHAP_GINI_TOL kadar yakın olanlar kalır; aralarından Capture'ı
        # en yüksek olan seçilir.
        _cap_best = max(t.user_attrs.get('capture_val', -1) for t in _uygun)
        _npos_val = max(int(np.asarray(y_val).sum()), 1)
        _cap_se = float(np.sqrt(max(_cap_best * (1 - _cap_best), 0.0) / _npos_val))
        _base_val = _npos_val / max(len(y_val), 1)
        _tavan_val = min(1.0, CAPTURE_PCT / _base_val) if _base_val > 0 else 1.0
        _cap_tol = min(OPTUNA_CAPTURE_SE_KATSAYI * _cap_se,
                       SHAP_MAX_KAYIP * (_tavan_val if SHAP_KAYIP_TAVANA_GORE else 1.0))
        _esit = [t for t in _uygun if t.user_attrs.get('capture_val', -1) >= _cap_best - _cap_tol]
        _esit_trial_no = {t.number for t in _esit}
        _g_best = max(t.user_attrs.get('val_gini', -1) for t in _esit)
        _gini_esit = [t for t in _esit if t.user_attrs.get('val_gini', -1) >= _g_best - SHAP_GINI_TOL]
        best_trial = max(_gini_esit, key=lambda t: (t.user_attrs.get('capture_val', -1),
                                                    t.user_attrs.get('val_gini', -1)))
        print(f'  Secim: Capture en iyi={_cap_best:.4f}, tol={_cap_tol:.4f} -> {len(_esit)} deneme esit; '
              f'Gini en iyi={_g_best:.4f}, tol={SHAP_GINI_TOL:.4f} -> {len(_gini_esit)} kaldi; '
              f'aralarindan Capture en yuksek secildi.')
    else:
        best_trial = study.best_trial
        print(f'  ⚠ UYARI: hiçbir trial train-val gini farkı <= {_gap_esik} '
              f'kuralını sağlamadı. Cezalı skorun en iyisi seçildi.')

    print(f'  en iyi trial: #{best_trial.number} '
          f'capture@{CAPTURE_PCT:.0%} val={best_trial.user_attrs.get("capture_val", np.nan):.4f} - '
          f'| gini val={best_trial.user_attrs.get("val_gini", np.nan):.4f} '
          f'train={best_trial.user_attrs.get("train_gini", np.nan):.4f} '
          + (f'oot={best_trial.user_attrs["oot_gini"]:.4f} '
             if best_trial.user_attrs.get("oot_gini") is not None else '')
          + f'| gap tr_val={best_trial.user_attrs.get("gap_tr_val", np.nan):.4f}'
          + ('' if TRIAL_OOT else ' (OOT secime girmez; nihai modelde hesaplanir)'))

    BEST_PARAMS = {**best_trial.params, **SABIT_PARAMS}

    # Nihai model yalnızca train ile eğitilir: kaydedilen model doğrulanan modelin aynısı.
    best = clone(base).set_params(n_jobs=LGB_JOBS, **BEST_PARAMS).fit(X_tr, y_tr)

    # Bu rengin tüm denemeleri dosyaya.
    print('  ▶ Denenen modeller dosyaya yazılıyor...')
    trial_df = pd.DataFrame(trial_kayitlari)
    if not trial_df.empty:
        trial_df['is_best'] = (trial_df['trial'] == best_trial.number).astype(int)
        trial_df['capture_esit'] = trial_df['trial'].isin(_esit_trial_no).astype(int)
        trial_df = trial_df.sort_values('trial')
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv', trial_df)

    # 7) Eşik val tahminlerinden (Youden J). Aynı val'de seçildiği için val metrikleri
    #    biraz iyimser; bağımsız ölçüm OOT.
    _adim('rapor_yazma')
    print('  ▶ 7) Threshold seçimi (val) + metrik hesabı...')
    val_prob = best.predict_proba(X_val)[:, 1]
    thr = _find_thresholds(y_val, val_prob)['youden_j']
    if not np.isfinite(thr):
        # val olasılıkları sabitse Youden inf döner; eşik 0.5'e sabitlenir.
        print(f'  ⚠ eşik dejenere (thr={thr}), 0.5’e sabitlendi')
        thr = 0.5
    val_gini = 2 * roc_auc_score(y_val, val_prob) - 1

    tr_prob = best.predict_proba(X_tr)[:, 1]
    tr_gini = 2 * roc_auc_score(y_tr, tr_prob) - 1
    oot_prob = best.predict_proba(X_oot)[:, 1] if len(X_oot) else np.array([])
    oot_metrics = evaluate(y_oot, oot_prob, thr) if y_oot.nunique() >= 2 else None
    val_metrics = evaluate(y_val, val_prob, thr)

    # Müşteri bazlı skor dosyaları (train / val / OOT).
    def _skor_df(idx, y_true, prob, set_adi):
        _meta = df_eng_r[[c for c in (_id_col, 'DONEM') if c and c in df_eng_r.columns]].reindex(idx)
        _mbb = _meta[_id_col].astype(str) if _id_col else pd.Series(idx, index=idx).astype(str)
        _donem = _meta['DONEM'] if 'DONEM' in _meta.columns else pd.Series([np.nan] * len(_meta), index=idx)
        _p = np.asarray(prob, dtype='float64')
        return pd.DataFrame({
            'model_renk_kod': RENK_KOD,
            'model_renk':     renk_adi,
            'set_adi':        set_adi,
            'mbb_no':         _mbb.to_numpy(),
            'donem':          _donem.to_numpy(),
            'target_actual':  np.asarray(y_true, dtype='int64'),
            'target_pred':    (_p >= thr).astype('int64'),
            'target_score':   _p,
            'threshold':      float(thr),
        })

    skor_train = _skor_df(X_tr.index, y_tr, tr_prob, 'train')
    skor_val   = _skor_df(X_val.index, y_val, val_prob, 'val')
    skor_oot   = _skor_df(X_oot.index, y_oot, oot_prob, 'oot')
    skor_all   = pd.concat([skor_train, skor_val, skor_oot], ignore_index=True)
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_musteri_skorlari.csv', skor_all)
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_musteri_skorlari_oot.csv', skor_oot)

    # TRAIN_DONEM ve OOT_DONEM'de ortak müşteriler için karşılaştırmalı skor dataseti
    if _id_col is not None:
        # train + val skorlari yeniden tahmin edilmeden birlestirilir (ayni model, ayni satirlar).
        _tv_prob = pd.concat([pd.Series(tr_prob, index=X_tr.index),
                              pd.Series(val_prob, index=X_val.index)]).sort_index()
        _tv_y = pd.concat([y_tr, y_val]).sort_index()
        tr_full_prob = _tv_prob.to_numpy()
        oot_full_prob = np.asarray(oot_prob, dtype='float64')

        tr_full_mbb = df_eng_r[_id_col].reindex(_tv_prob.index).astype(str)
        oot_full_mbb = df_eng_r[_id_col].reindex(oot.index).astype(str)

        tr_full_df = pd.DataFrame({
            'mbb_no':             tr_full_mbb.to_numpy(),
            'donem_train':        TRAIN_DONEM,
            'target_actual_train': np.asarray(_tv_y, dtype='int64'),
            'target_pred_train': (tr_full_prob >= thr).astype('int64'),
            'target_score_train': tr_full_prob,
        })

        oot_full_df = pd.DataFrame({
            'mbb_no':             oot_full_mbb.to_numpy(),
            'donem_oot':          oot['DONEM'].to_numpy() if 'DONEM' in oot.columns else OOT_DONEM,
            'target_actual_oot': np.asarray(oot[TARGET], dtype='int64'),
            'target_pred_oot':   (oot_full_prob >= thr).astype('int64'),
            'target_score_oot':  oot_full_prob,
        })

        ortak_df = tr_full_df.merge(oot_full_df, on='mbb_no', how='inner')
        ortak_df['model_renk_kod'] = RENK_KOD
        ortak_df['model_renk'] = renk_adi
        ortak_df['threshold'] = float(thr)
        _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_musteri_skorlari_train_oot_ortak.csv', ortak_df)
        print(f'  ortak müşteri (train vs oot): {len(ortak_df):,}')
    else:
        print('  ⚠ ortak müşteri train/oot dataseti atlandı (MBB_NO bulunamadı).')

    _gap_tr_oot = (tr_gini - oot_metrics['Gini']) if oot_metrics else np.nan
    _gap_tr_val = tr_gini - val_gini
    if _gap_tr_val > _gap_esik:
        print(f'  ⚠ KURAL İHLALİ (final): train-val gini = {_gap_tr_val:+.4f} '
              f'> {_gap_esik} (aşırı öğrenme)')

    # --- CAPTURE + BUCKET (nihai model) ---
    _cap_val = _capture_at(y_val, val_prob, CAPTURE_PCT)
    _cap_oot = _capture_at(y_oot, oot_prob, CAPTURE_PCT) if oot_metrics else np.nan
    _l1v, _tpv, _mv = _bucket_metrik(y_val, val_prob, N_BUCKET_IZLEME)
    _l1o, _tpo, _mo = (_bucket_metrik(y_oot, oot_prob, N_BUCKET_IZLEME)
                      if oot_metrics else (np.nan, np.nan, np.nan))
    _base_oot = float(np.mean(y_oot)) if len(y_oot) else np.nan
    _cap_tavan = (min(1.0, CAPTURE_PCT / _base_oot)
                  if np.isfinite(_base_oot) and _base_oot > 0 else np.nan)

    print(f'  capture@{CAPTURE_PCT:.0%}: val={_cap_val:.4f} oot={_cap_oot:.4f} '
          f'(tavan {_cap_tavan:.4f}) + tavanın '
          f'{(_cap_oot / _cap_tavan):.0%}\'i' if np.isfinite(_cap_tavan) and _cap_tavan > 0
          else f'  capture@{CAPTURE_PCT:.0%}: val={_cap_val:.4f} oot={_cap_oot:.4f}')
    print(f'  bucket-1 lift: val={_l1v:.2f} ({_tpv:.0%} tavan) '
          f'oot={_l1o:.2f} ({_tpo:.0%} tavan) | oot monotonluk={_mo:.0%}')
    _oot_g = oot_metrics['Gini'] if oot_metrics else np.nan
    print(f'  gini: train={tr_gini:.4f} val={val_gini:.4f} oot={_oot_g:.4f} | '
          f'train-val={_gap_tr_val:+.4f} val-oot={val_gini - _oot_g:+.4f}')

    # 7b) PSI (referans train, karşılaştırma OOT): yalnızca rapor, eleme yapmaz.
    print('  ▶ 7b) OOT PSI raporu (feature elemesi yapmaz)...')
    psi_scores = ({c: _psi(train[c], oot[c]) for c in FEATURES}
                  if len(oot) else {c: np.nan for c in FEATURES})
    _psi_sirali = sorted(psi_scores.items(), key=lambda kv: kv[1], reverse=True)
    _kaymis = [c for c, v in psi_scores.items() if np.isfinite(v) and v > 0.25]
    _dikkat = [c for c, v in psi_scores.items()
               if np.isfinite(v) and 0.10 < v <= 0.25]
    if _psi_sirali:
        print(f'  PSI >0.25: {len(_kaymis)}; 0.10-0.25: {len(_dikkat)} (referans train)')
        for c, v in _psi_sirali:
            print(f'    {v:7.4f}  {c}')
    feat_df['psi'] = feat_df['feature'].map(psi_scores).round(4)

    # 7c) Sızıntı kontrolü: seçilen her feature'ın train'de tek başına Gini'si. Eşik
    #     üstü işaretlenir; pipeline durmaz, karar kullanıcıda.
    print('  ▶ 7c) Sızıntı kontrolü (tek başına Gini, train)...')
    _tek = dict(zip(FEATURES, _paralel(lambda c: _tek_gini(X_tr[c], y_tr), list(FEATURES))))
    _ham_set = set(_raw_guvenli)
    _sizinti = pd.DataFrame({
        'feature': FEATURES,
        'kaynak': ['ham' if c in _ham_set else ('DSN' if c.startswith('DSN_') else 'FE')
                   for c in FEATURES],
        'tek_basina_gini_train': [round(_tek[c], 4) if np.isfinite(_tek[c]) else np.nan
                                  for c in FEATURES],
        'hedef_iliskisi_train': [round(tgt_assoc.get(c, np.nan), 4) for c in FEATURES],
    })
    _sizinti['uyari'] = (_sizinti['tek_basina_gini_train'] >= SIZINTI_GINI_ESIK).astype(int)
    _sizinti = _sizinti.sort_values('tek_basina_gini_train', ascending=False)
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_sizinti_kontrol.csv', _sizinti)
    feat_df['tek_basina_gini_train'] = feat_df['feature'].map(_tek).round(4)
    _siz_max = float(np.nanmax(list(_tek.values()))) if any(np.isfinite(v) for v in _tek.values()) else np.nan
    _siz_uyari = _sizinti.loc[_sizinti['uyari'] == 1, 'feature'].tolist()
    print(f'  En yüksek tek başına Gini: {_siz_max:.4f} (model val Gini {val_gini:.4f}); '
          f'eşik {SIZINTI_GINI_ESIK} üstü: {len(_siz_uyari)}'
          + (f' → KONTROL EDİN: {_siz_uyari}' if _siz_uyari else ''))

    # 8a) Önem: gain = feature'ın split'lerindeki toplam kazanç, split = kaç split'te
    #     kullanıldığı (ikisi ağaç yapısından, veri görmez), SHAP = modelin görmediği
    #     val'de ortalama |katkı|.
    print('  ▶ 8a) Feature importance hesaplanıyor...')
    _bst = best.booster_
    _bst_feats = list(_bst.feature_name())

    # Kolon sırası sessizce kaymasın - booster'ın gördüğü sıra FEATURES olmalı.
    if _bst_feats != list(FEATURES):
        print(f'    ⚠ KOLON SIRASI UYUŞMUYOR: booster {len(_bst_feats)} / '
              f'FEATURES {len(FEATURES)} - eşleştirme merge ile yapılıyor')

    _imp = pd.DataFrame({
        'feature':        _bst_feats,
        'feat_imp_gain':  _bst.feature_importance(importance_type='gain'),
        'feat_imp_split': _bst.feature_importance(importance_type='split'),
    })

    _g_tot = _imp['feat_imp_gain'].sum()
    _s_tot = _imp['feat_imp_split'].sum()
    _imp['feat_imp_gain_pct'] = np.where(_g_tot > 0, _imp['feat_imp_gain'] / _g_tot, 0.0).round(6)
    _imp['feat_imp_split_pct'] = np.where(_s_tot > 0, _imp['feat_imp_split'] / _s_tot, 0.0).round(6)
    _imp['gain_per_split'] = np.where(_imp['feat_imp_split'] > 0,
                                       _imp['feat_imp_gain'] / _imp['feat_imp_split'],
                                       0.0).round(4)
    _imp['feat_imp_gain'] = _imp['feat_imp_gain'].round(4)
    _imp['rank_gain'] = _imp['feat_imp_gain'].rank(ascending=False, method='min').astype(int)
    _imp['rank_split'] = _imp['feat_imp_split'].rank(ascending=False, method='min').astype(int)

    # SHAP: nihai modelin validation kumesindeki ortalama |SHAP| (TreeSHAP,
    # LightGBM pred_contrib). Gain/split agac yapisindan gelir; SHAP ise
    # modelin gormedigi musterilerde tahmine gercek katkiyi olcer.
    _t_shap = time.time()
    _X_shap, _y_shap = X_val, y_val
    if SHAP_ONEM_MAX_ROWS is not None and len(X_val) > SHAP_ONEM_MAX_ROWS:
        _X_shap = X_val.loc[train_test_split(X_val.index, train_size=SHAP_ONEM_MAX_ROWS,
                                             stratify=y_val, random_state=RANDOM_STATE)[0]]
    _katki = np.asarray(best.predict(_X_shap, pred_contrib=True), dtype='float64')
    if _katki.ndim != 2 or _katki.shape[1] != len(_bst_feats) + 1:
        raise RuntimeError(f'{etiket}: pred_contrib boyutu beklenmedik: {_katki.shape}')
    _shap_ort = dict(zip(_bst_feats, np.abs(_katki[:, :-1]).mean(axis=0)))
    del _katki
    _imp['shap_mean_abs'] = _imp['feature'].map(_shap_ort).round(6)
    _sh_tot = float(_imp['shap_mean_abs'].sum())
    _imp['shap_pct'] = (_imp['shap_mean_abs'] / _sh_tot).round(6) if _sh_tot > 0 else 0.0
    _imp['rank_shap'] = _imp['shap_mean_abs'].rank(ascending=False, method='min').astype(int)
    print(f'  SHAP onemi: validation {len(_X_shap):,} satir, {time.time() - _t_shap:.0f} sn')
    _imp['kullanilmadi_flg'] = (_imp['feat_imp_split'] == 0).astype(int)

    feat_df = feat_df.merge(_imp, on='feature', how='left')

    _eksik = int(feat_df['feat_imp_gain'].isna().sum())
    if _eksik:
        print(f'    ⚠ {_eksik} feature importance ile eşleşmedi '
              f'(feat_df\'te var, modelde yok) - sıra ile FEATURES arasında kayma olabilir')

    _kullanilmayan = int(feat_df['kullanilmadi_flg'].fillna(0).sum())
    print(f'  importance: {len(feat_df)} feature, model hiç kullanmamış: {_kullanilmayan}')
    print(f'  --- Tum {len(feat_df)} feature: SHAP / gain / split (SHAP payina gore) ---')
    print(f'    {"shap%":>7} {"gain%":>7} {"split%":>7} {"split":>6} '
          f'{"r_shap":>6} {"r_gain":>6} {"r_split":>7}  feature')
    for _, _r in feat_df.sort_values(['shap_pct', 'feat_imp_gain_pct'], ascending=False).iterrows():
        print(f'    {_r["shap_pct"]:7.2%} {_r["feat_imp_gain_pct"]:7.2%} '
              f'{_r["feat_imp_split_pct"]:7.2%} {int(_r["feat_imp_split"]):>6} '
              f'{int(_r["rank_shap"]):>6} {int(_r["rank_gain"]):>6} {int(_r["rank_split"]):>7}  '
              f'{_r["feature"]}')

    _aile_df = _aile_ozeti(etiket, set(_raw_guvenli), _aday_tum, drop_const, drop_corr,
                           _shap_oncesi, FEATURES, _imp,
                           (shap_bilgi or {}).get('shap_durum'))
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_aile_ozet.csv', _aile_df)
    aile_ozet_satirlari.append(_aile_df)
    print('  --- Aile ozeti (uretilen -> secilen, gain / SHAP payi) ---')
    for _, _r in _aile_df.iterrows():
        _shp = f"  shap {_r['shap_payi']:6.1%}" if pd.notna(_r.get('shap_payi')) else ''
        print(f"    {_r['aile']:22s} {int(_r['uretilen']):4d} -> {int(_r['secilen']):2d}  "
              f"gain {_r['gain_payi']:6.1%}{_shp}")

    # Kalan feature listesi (hedef ilişkisi, IV, PSI, önem) dosyaya.
    print('  ▶ Kalan feature\'lar dosyaya yazılıyor (importance dahil)...')
    _model_yaz(f'renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv',
         feat_df.sort_values('tgt_assoc', ascending=False))

    # Model paketi: skorlama için gereken her şey. Feature sırası fit sırasıdır;
    # kategori listeleri ve DSN tabloları pakettedir (farklı kategori sırası sessizce
    # yanlış skor üretir).
    _cat_kategoriler = {}
    for c in CAT_COLS:
        if c in train.columns and str(train[c].dtype) == 'category':
            _cat_kategoriler[c] = list(train[c].cat.categories)

    _paket = {
        'model':            best,
        'features':         list(FEATURES),        # fit sırası - sıra kritik
        'required_raw_features': list(_raw_guvenli),
        'engineered_features':   list(_yeni),
        'preprocess_schema':     _preprocess_schema,
        'preprocess_mode':       PREPROCESS_MODU,
        'feature_engineering_reference': 'feature_engineering notebook helper',
        'desen_kodlama':         _ds_paket,
        'threshold':        float(thr),
        'best_params':      BEST_PARAMS,
