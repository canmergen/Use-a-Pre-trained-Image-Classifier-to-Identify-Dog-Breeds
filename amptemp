def _feature_ailesi(c, ham):
    if c in ham:
        return 'ham_kolon'
    for onek, ad in _AILE_ONEKLERI:
        if c.startswith(onek):
            return ad
    if '_INTD_' in c:
        return 'int_degisim'
    for onek, ad in _ESKI_AILE_ONEKLERI:
        if c.startswith(onek):
            return ad
    return 'diger'


def _aile_ozeti(etiket, ham, aday, sabit, korelasyon, shap_oncesi, secilen, imp, secim_yontemi):
    """Her aile icin: uretilen / elenen (sabit, korelasyon, secim) / secilen / gain payi."""
    sabit, korelasyon, secilen = set(sabit), set(korelasyon), set(secilen)
    shap_elenen = set(shap_oncesi) - secilen
    gain = dict(zip(imp['feature'], imp['feat_imp_gain']))
    split = dict(zip(imp['feature'], imp['feat_imp_split']))
    shap = dict(zip(imp['feature'], imp['shap_mean_abs'])) if 'shap_mean_abs' in imp else {}
    g_tot = max(float(sum(gain.values())), 1e-12)
    s_tot = max(float(sum(split.values())), 1e-12)
    sh_tot = max(float(sum(shap.values())), 1e-12)
    aile = {c: _feature_ailesi(c, ham) for c in aday}
    satirlar = []
    for ad in sorted(set(aile.values())):
        cols = [c for c in aday if aile[c] == ad]
        sec = [c for c in cols if c in secilen]
        en_iyi = sorted(sec, key=lambda c: -gain.get(c, 0.0))[:3]
        satirlar.append({
            'renk': etiket, 'aile': ad, 'uretilen': len(cols),
            'sabit_elenen': sum(c in sabit for c in cols),
            'korelasyon_elenen': sum(c in korelasyon for c in cols),
            'secim_elenen': sum(c in shap_elenen for c in cols),
            'secim_yontemi': secim_yontemi,
            'secilen': len(sec),
            'gain_payi': round(sum(gain.get(c, 0.0) for c in sec) / g_tot, 4),
            'split_payi': round(sum(split.get(c, 0.0) for c in sec) / s_tot, 4),
            'shap_payi': round(sum(shap.get(c, 0.0) for c in sec) / sh_tot, 4) if shap else None,
            'en_onemli_3': ', '.join(en_iyi),
        })
    return pd.DataFrame(satirlar).sort_values('gain_payi', ascending=False)


def _capture_bootstrap(y, p, pct, n_boot, seed):
    """Capture@pct icin Poisson bootstrap %95 araligi (siralama bir kez yapilir)."""
    y = np.asarray(y, dtype='float64')
    p = np.asarray(p, dtype='float64')
    if n_boot <= 0 or len(y) == 0 or y.sum() == 0:
        return np.nan, np.nan
    ys = y[np.argsort(-p, kind='mergesort')]
    rng = np.random.default_rng(seed)
    res = np.empty(n_boot)
    for b in range(n_boot):
        w = rng.poisson(1.0, len(ys)).astype('float64')
        cw = np.cumsum(w)
        oran = np.clip((pct * cw[-1] - (cw - w)) / np.where(w > 0, w, 1.0), 0.0, 1.0)
        pay = (ys * w).sum()
        res[b] = (ys * w * oran).sum() / pay if pay > 0 else np.nan
    return float(np.nanpercentile(res, 2.5)), float(np.nanpercentile(res, 97.5))


# --- HIZLI SPEARMAN (4b / 4c) ------------------------------------------------
# pandas Spearman ile aynı tanım ve sonuç (çift bazında boş satırlar atılır, eşitlikte
# ortalama sıra); her kolon bir kez sıralanır, hesap paralel.
def _paralel(fn, ogeler):
    isci = max(1, min(16, LGB_JOBS))
    if isci == 1 or len(ogeler) < 2:
        return [fn(o) for o in ogeler]
    with ThreadPoolExecutor(max_workers=isci) as ex:
        return list(ex.map(fn, ogeler))


def _pearson(a, b):
    a = a - a.mean()
    b = b - b.mean()
    pay = np.sqrt((a * a).sum() * (b * b).sum())
    return float((a * b).sum() / pay) if pay > 0 else np.nan


def _hedef_spearman(frame, cols, target):
    """Kolon - hedef |Spearman|; pandas Series.corr(method='spearman') ile ayni (fark ~1e-15).

    Ikili hedefte hedefin sirasi hedefin dogrusal donusumu oldugundan yalnizca
    kolon siralanir. Donus: (dict, tanimsiz kolonlar)."""
    y = pd.to_numeric(frame[target], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
    y_dolu = ~np.isnan(y)
    ikili = np.unique(y[y_dolu]).size <= 2

    def _bir(c):
        x = pd.to_numeric(frame[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
        m = y_dolu & ~np.isnan(x)
        if m.sum() < 2:
            return c, np.nan
        yy = y[m]
        return c, _pearson(rankdata(x[m]), yy if ikili else rankdata(yy))

    sonuc, tanimsiz = {}, set()
    for c, v in _paralel(_bir, list(cols)):
        if np.isfinite(v):
            sonuc[c] = abs(v)
        else:
            sonuc[c] = 0.0
            tanimsiz.add(c)
    return sonuc, tanimsiz


def _spearman_matris(frame, cols):
    """|Spearman| matrisi; pandas DataFrame.corr(method='spearman') ile ayni tanim ve sonuc.

    Bos (NaN / inf) deseni ayni kolonlar gruplanir. Iki grubun ortak dolu
    satirlarinda kolonlar siralanir ve ciftler matris carpimiyla hesaplanir;
    her cift kendi ortak satirlarinda siralanmis olur (pandas'in tanimi).
    Alt kumedeki sira, kolonun tek seferlik siralamasindan O(n) ile cikarilir.
    Donus: (DataFrame, bos deseni grup sayisi).
    """
    A = np.column_stack([pd.to_numeric(frame[c], errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
                         for c in cols])
    M = np.isfinite(A)
    gruplar = {}
    for j in range(A.shape[1]):
        gruplar.setdefault(np.packbits(M[:, j]).tobytes(), []).append(j)
    gruplar = list(gruplar.values())
    G = [M[:, g[0]] for g in gruplar]
    n_g = [int(m.sum()) for m in G]

    # Her kolon bir kez siralanir; alt kumedeki sira O(n) ile bu siradan cikarilir
    # (esitlikte ortalama sira, rankdata ile ayni).
    def _hazirla(j):
        sat = np.flatnonzero(M[:, j])
        o = sat[np.argsort(A[sat, j], kind='mergesort')].astype(np.int32)
        v = A[o, j]
        yeni = np.r_[True, v[1:] != v[:-1]]
        bas = np.flatnonzero(yeni).astype(np.int32)
        gid = (np.cumsum(yeni) - 1).astype(np.int32)
        return o, gid, bas, np.r_[bas[1:], len(v)].astype(np.int32)

    sirali = _paralel(_hazirla, list(range(A.shape[1])))

    def _alt_sira(j, satir):
        o, gid, bas, son = sirali[j]
        s = satir[o]
        c = np.cumsum(s)
        once = c[bas] - s[bas]
        ort = once + (c[son - 1] - once + 1) / 2.0
        rr = np.empty(A.shape[0])
        rr[o[s]] = ort[gid][s]
        return rr[satir]

    def _sira(js, satir):
        R = np.column_stack([_alt_sira(j, satir) for j in js])
        return R - R.mean(axis=0)

    def _kendi(a):
        return _sira(gruplar[a], G[a]) if n_g[a] >= 2 else None

    kendi = _paralel(_kendi, list(range(len(gruplar))))

    def _blok(ab):
        a, b = ab
        if a == b:
            if kendi[a] is None:
                return a, b, None
            Ra = Rb = kendi[a]
        else:
            S = G[a] & G[b]
            ns = int(S.sum())
            if ns < 2:
                return a, b, None
            Ra = kendi[a] if ns == n_g[a] else _sira(gruplar[a], S)
            Rb = kendi[b] if ns == n_g[b] else _sira(gruplar[b], S)
        pay = Ra.T @ Rb
        payda = np.sqrt(np.outer((Ra * Ra).sum(axis=0), (Rb * Rb).sum(axis=0)))
        with np.errstate(divide='ignore', invalid='ignore'):
            return a, b, np.where(payda > 0, pay / payda, np.nan)

    C = np.full((A.shape[1], A.shape[1]), np.nan)
    gorevler = [(a, b) for a in range(len(gruplar)) for b in range(a, len(gruplar))]
    with (threadpool_limits(limits=1, user_api='blas') if threadpool_limits else nullcontext()):
        sonuclar = _paralel(_blok, gorevler)
    for a, b, blok in sonuclar:
        if blok is not None:
            ia, ib = gruplar[a], gruplar[b]
            C[np.ix_(ia, ib)] = blok
            C[np.ix_(ib, ia)] = blok.T
    return pd.DataFrame(np.abs(C), index=list(cols), columns=list(cols)), len(gruplar)


def _tek_gini(x, y):
    """Feature'ın tek başına Gini'si: |2 x AUC - 1| (yön fark etmez). Boş değerler tek grup
    olarak en küçük değer sayılır. Kategorik kolonda NaN döner."""
    if isinstance(x.dtype, pd.CategoricalDtype):
        return np.nan
    v = pd.to_numeric(x, errors='coerce').to_numpy(dtype='float64', na_value=np.nan)
    yy = np.asarray(y, dtype=int)
    ok = np.isfinite(v)
    if len(np.unique(yy)) < 2 or not ok.any():
        return np.nan
    v = np.where(ok, v, np.min(v[ok]) - 1.0)
    return float(abs(2 * roc_auc_score(yy, v) - 1))


