        _kaydet(anahtar, durum)
        return jsonify({"tamam": True,
                        "bolme": sonuc.get("bolme") or {},
                        "ozet": sonuc.get("ozet") or "",
                        "uyarilar": list(sonuc.get("uyarilar") or []),
                        "bolme_formu": akis.bolme_formu(durum)})
    except Exception as e:
