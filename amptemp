                       "özel");
    ozel.setAttribute("data-kullanim", "ozel");
    ozel.title = "Dört hazır seçenekle anlatılamayan bir val/CV birleşimi";
    serit.appendChild(ozel);
    kutu.appendChild(serit);
    return kutu;
}

function bfKilitCiz() {
