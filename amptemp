    for sh, tablo in sheetler.items():
        tablo.to_excel(xl, sheet_name=sh, index=False)
buf.seek(0)
mf.upload_stream(CIKTI_DOSYA, buf)
_log(f"✓ {MAIN_FOLDER}{CIKTI_DOSYA} yazıldı | {len(sheetler)} klasör sheet'i")
