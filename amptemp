# ==================================================================
# 1b) FEATURE -> ORACLE SQL ÜRETİCİ (feature engineering v7 + pipeline desen kodlaması)
# ------------------------------------------------------------------
# Her feature için: SQL ifadesi (tek satırda, aynı müşteri-dönem satırının kolonlarından),
# SQL katmanı, kullandığı ham kolon / ara kolon / feature'lar ve Python karşılığı.
# Katmanlar: 0 = kaynak tablonun ham kolonları; 1 = ham kolonlardan hesaplananlar (ara kolonlar
# ve çoğu feature); 2+ = başka bir feature'a ya da ara kolona dayananlar. Tam sorgu katmanları
# sırayla WITH K0 AS (...), K1 AS (...) ... şeklinde dizer.
# Kurallar Python'daki ile birebir: boş (NULL) = NaN; geçersiz bölme -99 (_sdiv) ya da boş
# (_fe_oran_nan); pencere ortalamaları geçerli ay sayısına bölünür; std n-1 ile, tek ayda 0.
# Kaynak tablo: müşteri-dönem başına bir satır, ham kolonlar (RENK_LM .. KK_RISK_L12M ...) sayı.
# ==================================================================

_FS_AYLAR = ['LM'] + [f'L{i}M' for i in range(2, 13)]
_FS_BUYUK = '1E30'
_FS_KIMLIK = re.compile(r'"(?:[^"]|"")+"|\b[A-Za-z_][A-Za-z0-9_$#]*\b')


def _fs_q(ad):
    """Oracle kimliği: büyük harf / rakam / _ dışındaysa çift tırnak."""
    return ad if re.fullmatch(r'[A-Z][A-Z0-9_$#]*', ad) else '"' + ad.replace('"', '""') + '"'


def _fs_lit(v):
    v = float(v)
    return str(int(v)) if v.is_integer() else repr(v)


def _fs_nn(x):
    return f'{x} IS NOT NULL'


def _fs_b(p):
    return f'CASE WHEN {p} THEN 1 ELSE 0 END'


def _fs_say(ps):
    ps = [p for p in ps if p]
    return '(' + ' + '.join(_fs_b(p) for p in ps) + ')' if ps else '0'


def _fs_dolu(xs):
    return [x for x in xs if x != 'NULL']


def _fs_topla0(xs):
    xs = _fs_dolu(xs)
    return '(' + ' + '.join(f'COALESCE({x}, 0)' for x in xs) + ')' if xs else '0'


def _fs_ort(xs):
    xs = _fs_dolu(xs)
    if not xs:
        return 'NULL'
    return f'({_fs_topla0(xs)} / NULLIF({_fs_say([_fs_nn(x) for x in xs])}, 0))'


def _fs_enk(xs):
    xs = _fs_dolu(xs)
    if not xs:
        return 'NULL'
    if len(xs) == 1:
        return xs[0]
    return f"NULLIF(LEAST({', '.join(f'COALESCE({x}, {_FS_BUYUK})' for x in xs)}), {_FS_BUYUK})"


def _fs_enb(xs):
    xs = _fs_dolu(xs)
    if not xs:
        return 'NULL'
    if len(xs) == 1:
        return xs[0]
    return f"NULLIF(GREATEST({', '.join(f'COALESCE({x}, -{_FS_BUYUK})' for x in xs)}), -{_FS_BUYUK})"


def _fs_hepsi_bos(xs):
    xs = _fs_dolu(xs)
    if not xs:
        return '1 = 1'
    return f'{xs[0]} IS NULL' if len(xs) == 1 else f"COALESCE({', '.join(xs)}) IS NULL"


def _fs_biri_dolu(xs):
    xs = _fs_dolu(xs)
    if not xs:
        return '1 = 0'
    return f'{xs[0]} IS NOT NULL' if len(xs) == 1 else f"COALESCE({', '.join(xs)}) IS NOT NULL"


def _fs_ilk(ps, bos='NULL'):
    """İlk doğru koşulun sırası (0 = LM / en yeni geçiş); hiçbiri yoksa bos."""
    return 'CASE ' + ' '.join(f'WHEN {p} THEN {i}' for i, p in enumerate(ps)) + f' ELSE {bos} END'


def _fs_son(ps):
    """Son (en eski) doğru koşulun sırası; hiçbiri yoksa NULL."""
    return 'CASE ' + ' '.join(f'WHEN {ps[i]} THEN {i}' for i in range(len(ps) - 1, -1, -1)) + ' ELSE NULL END'


def _fs_seri_goreli(ps):
    """Baştan kesintisiz doğru koşul sayısı (_fe_seri_simdi)."""
    s = str(len(ps))
    for i in range(len(ps) - 1, -1, -1):
        s = f'CASE WHEN {ps[i]} THEN {s} ELSE {i} END'
    return s


def _fs_kuyruk_toplam(ps, terimler, i=0):
    """Baştan kesintisiz doğru olan koşullardaki terimlerin toplamı."""
    if i == len(ps):
        return '0'
    return f'CASE WHEN {ps[i]} THEN {terimler[i]} + {_fs_kuyruk_toplam(ps, terimler, i + 1)} ELSE 0 END'


def _fs_en_uzun(ps):
    parcalar = [_fs_seri_goreli(ps[i:]) for i in range(len(ps))]
    return parcalar[0] if len(parcalar) == 1 else f"GREATEST({', '.join(parcalar)})"


def _fs_son_donem(ps):
    """En yeni doğru koşuldan geriye kesintisiz doğru sayısı; hiç yoksa 0 (_fe_son_donem_sure)."""
    return 'CASE ' + ' '.join(f'WHEN {ps[i]} THEN {_fs_seri_goreli(ps[i:])}' for i in range(len(ps))) + ' ELSE 0 END'


def _fs_egim(ys, min_n=3):
    """İlk len(ys) ay için en küçük kareler eğimi; x = 0, -1, -2 ... (LM = 0). En az min_n dolu ay."""
    n = _fs_say([_fs_nn(y) for y in _fs_dolu(ys)])
    sx = '(' + ' + '.join([f'CASE WHEN {y} IS NOT NULL THEN {-j} ELSE 0 END' for j, y in enumerate(ys)
                           if j > 0 and y != 'NULL'] or ['0']) + ')'
    sxx = '(' + ' + '.join([f'CASE WHEN {y} IS NOT NULL THEN {j * j} ELSE 0 END' for j, y in enumerate(ys)
                            if j > 0 and y != 'NULL'] or ['0']) + ')'
    sy = _fs_topla0(ys)
    sxy = '(' + ' + '.join([f'{-j} * COALESCE({y}, 0)' for j, y in enumerate(ys) if j > 0 and y != 'NULL']
                           or ['0']) + ')'
    pay = f'({n} * {sxy} - {sx} * {sy})'
    payda = f'({n} * {sxx} - {sx} * {sx})'
    return f'CASE WHEN {n} >= {min_n} AND {payda} > 0 THEN {pay} / {payda} END'


def _fs_medyan(xs):
    """Geçerli değerlerin medyanı (çift sayıda ortadaki ikisinin ortalaması), hiç yoksa NULL.
    Her değerin sırası: kendinden küçük + (öncekiler arasında) eşit olan değer sayısı."""
    xs = _fs_dolu(xs)
    if not xs:
        return 'NULL'
    n = _fs_say([_fs_nn(x) for x in xs])
    terimler = []
    for i, x in enumerate(xs):
        sira = ' + '.join([_fs_b(f'{y} <= {x}') for j, y in enumerate(xs) if j < i]
                          + [_fs_b(f'{y} < {x}') for j, y in enumerate(xs) if j > i]) or '0'
        terimler.append(f'CASE WHEN {x} IS NULL THEN 0 ELSE CASE 2 * ({sira}) - {n} WHEN -1 THEN {x} '
                        f'WHEN -2 THEN {x} / 2 WHEN 0 THEN {x} / 2 ELSE 0 END END')
    return f"CASE WHEN {n} = 0 THEN NULL ELSE {' + '.join(terimler)} END"


def _fs_std(xs, ort):
    """Örneklem standart sapması (n-1); geçerli ay 0 ya da 1 ise 0. ort: aynı pencerenin ortalaması."""
    xs = _fs_dolu(xs)
    if not xs:
        return '0'
    n = _fs_say([_fs_nn(x) for x in xs])
    kare = ' + '.join(f'CASE WHEN {x} IS NOT NULL THEN ({x} - {ort}) * ({x} - {ort}) ELSE 0 END' for x in xs)
    return f'CASE WHEN {n} <= 1 THEN 0 ELSE SQRT(({kare}) / ({n} - 1)) END'


def _fs_sdiv(a, b):
    return f'CASE WHEN {a} IS NULL OR {b} IS NULL OR {b} = 0 THEN -99 ELSE {a} / {b} END'


def _fs_oran(a, b):
    return f'CASE WHEN {a} IS NOT NULL AND {b} > 0 THEN {a} / {b} END'


def _fs_pl(base, i0, i1):
    return f'{base}_{_FS_AYLAR[i0]}' if i0 == i1 else f'{base}_{_FS_AYLAR[i0]}..{base}_{_FS_AYLAR[i1]}'


_FS_PENCERE = {'3M': (0, 2), '6M': (0, 5), '12M': (0, 11), '4_6M': (3, 5), '6_9M': (5, 8)}
# D_ / ESZ / GIZLI / YB / OG serileri: kısa ad -> (seri anahtarı, FE taban adı, yön)
_FS_SERI = {'RENK': ('RENK', 'RENK', +1), 'KKB': ('KKB', 'KKB_SKOR', +1),
            'ODM': ('KK_ODEME_ORANI', 'KK_ODEME_ORANI', +1), 'KKU': ('KKU', 'KK_KULLANIM', -1),
            'DAV': ('DAV_SKOR', 'DAV_SKOR', +1), 'MMS': ('MMS', 'MMS', -1)}
_FS_TABAN_P = {v[1]: k for k, v in _FS_SERI.items()}
_FS_SERI_ADI = {'RENK': 'aktif renk kodu', 'KKB': 'KKB skoru (0 = boş)', 'ODM': 'kart ödeme oranı',
                'KKU': 'kart kullanımı (KK_RISK / KK_LIMIT)', 'DAV': 'davranış skoru', 'MMS': 'MMS'}


class FeSql:
    """Feature adından SQL üretir. ham: feature engineering'e giren ham kolonlar; uretilen: FE'nin
    ürettiği feature adları (YB_YENI_OLAY_SAYISI gibi diğerlerini sayan feature'lar için)."""

    def __init__(self, ham, color_map, ayar, uretilen=(), dsn_tablo='RENK_MDL_DESEN_TABLOSU',
                 dsn_klasor=':KLASOR', dsn_renk='RENK'):
        self.ham = set(ham)
        self.cm = dict(color_map)
        self.A = dict(ayar)
        self.uretilen = list(uretilen)
        self.dsn_tablo, self.dsn_klasor, self.dsn_renk = dsn_tablo, dsn_klasor, dsn_renk
        self.oge = {}
        inaktif = [k for k, v in self.cm.items() if str(v).upper() == 'INAKTIF']
        self.inaktif = inaktif[0] if inaktif else None
        self.aktif = sorted(k for k in self.cm if k not in inaktif)
        self.kirmizi = self.aktif[0]
        self.esik = self.A['RENK_RISK_ESIK']
        self._yonlu = None

    # ------------------------------------------------------------------ kayıt
    def _kaydet(self, ad, sql, tur, aile, py, fonk):
        self.oge[ad] = {'sql': sql, 'tur': tur, 'aile': aile, 'py': py, 'fonk': fonk}

    def ara(self, ad, sql, py):
        if ad not in self.oge:
            self._kaydet(ad, sql, 'ara', 'ARA', py, '')
        return ad

    def f(self, ad):
        """Feature referansı; tanımı yoksa üretir."""
        if ad not in self.oge:
            self.uret(ad)
        return _fs_q(ad)

    def h(self, ad):
        return _fs_q(ad) if ad in self.ham else 'NULL'

    # ------------------------------------------------------------------ seriler
    def ay(self, S, m):
        if S == 'RENK':
            c = f'RENK_{m}'
            if c not in self.ham:
                return 'NULL'
            kodlar = ', '.join(_fs_lit(k) for k in self.aktif)
            return self.ara(f'ARA_RENK_{m}', f'CASE WHEN {_fs_q(c)} IN ({kodlar}) THEN {_fs_q(c)} END',
                            f'{c}; yalnızca aktif renk kodları ({kodlar}), INAKTIF ve geçersiz kod boş')
        if S == 'KKB':
            c = f'KKB_SKOR_{m}'
            if c not in self.ham:
                return 'NULL'
            return self.ara(f'ARA_KKB_{m}', f'CASE WHEN {_fs_q(c)} <> 0 THEN {_fs_q(c)} END',
                            f'{c}; 0 (sorgu yok) boş sayılır')
        if S == 'LIMIT':
            c = f'KK_LIMIT_{m}'
            if c not in self.ham:
                return 'NULL'
            return self.ara(f'ARA_LIMIT_{m}', f'CASE WHEN {_fs_q(c)} > 0 THEN {_fs_q(c)} END',
                            f'{c}; 0 ve altı boş sayılır')
        if S == 'KKU':
            if f'KK_LIMIT_{m}' in self.ham and f'KK_RISK_{m}' in self.ham:
                return self.f(f'KK_LKO_{m}')
            return 'NULL'
        if S == 'RENK_HAM':
            return self.h(f'RENK_{m}')
        return self.h(f'{S}_{m}')

    def seri(self, S, i0=0, i1=11):
        return [self.ay(S, _FS_AYLAR[j]) for j in range(i0, i1 + 1)]

    def seri_var(self, S):
        if S == 'KKU':
            return any(f'KK_LIMIT_{m}' in self.ham and f'KK_RISK_{m}' in self.ham for m in _FS_AYLAR)
        taban = {'RENK': 'RENK', 'KKB': 'KKB_SKOR', 'LIMIT': 'KK_LIMIT', 'RENK_HAM': 'RENK'}.get(S, S)
        return any(f'{taban}_{m}' in self.ham for m in _FS_AYLAR)

    def yonlu(self):
        """_fe_yonlu_seriler: (P, seri anahtarı, yön) listesi, FE ayar sırasıyla."""
        if self._yonlu is None:
            self._yonlu = []
            for taban, yon in self.A['SERI_YON'].items():
                if yon is None or taban not in _FS_TABAN_P:
                    continue
                P = _FS_TABAN_P[taban]
                S = _FS_SERI[P][0]
                if self.seri_var(S):
                    self._yonlu.append((P, S, yon))
        return self._yonlu

    def istat(self, P):
        """Seri istatistik ara kolonları: (N12, MIN12, MAX12)."""
        S = _FS_SERI[P][0]
        M = self.seri(S)
        ad = _FS_SERI_ADI[P]
        n = self.ara(f'ARA_{P}_N12', _fs_say([_fs_nn(x) for x in _fs_dolu(M)]), f'12 ayda dolu {ad} sayısı')
        mn = self.ara(f'ARA_{P}_MIN12', _fs_enk(M), f'12 aydaki en küçük {ad}')
        mx = self.ara(f'ARA_{P}_MAX12', _fs_enb(M), f'12 aydaki en büyük {ad}')
        return n, mn, mx

    def gecmis_n(self, P):
        G = self.seri(_FS_SERI[P][0], 1, 11)
        return self.ara(f'ARA_{P}_G_N', _fs_say([_fs_nn(x) for x in _fs_dolu(G)]),
                        f'L2M..L12M dolu {_FS_SERI_ADI[P]} sayısı')

    def gecmis(self, P):
        """L2M..L12M ara kolonları: (N, ORT, STD)."""
        S = _FS_SERI[P][0]
        G = self.seri(S, 1, 11)
        ad = _FS_SERI_ADI[P]
        n = self.gecmis_n(P)
        o = self.ara(f'ARA_{P}_G_ORT', _fs_ort(G), f'L2M..L12M {ad} ortalaması')
        kare = ' + '.join(f'CASE WHEN {x} IS NOT NULL THEN ({x} - {o}) * ({x} - {o}) ELSE 0 END'
                          for x in _fs_dolu(G)) or '0'
        s = self.ara(f'ARA_{P}_G_STD', f'SQRT(({kare}) / GREATEST({n} - 1, 1))',
                     f'L2M..L12M {ad} standart sapması (n-1)')
        return n, o, s

    # ------------------------------------------------------------------ üretim
    def uret(self, ad):
        if ad in self.ham:
            self._kaydet(ad, _fs_q(ad), 'ham', 'HAM', 'Ham kolon; olduğu gibi kullanılır.', '')
            return self.oge[ad]
        for desen, fn in self._KURALLAR:
            m = re.fullmatch(desen, ad)
            if m:
                sql, aile, py, fonk = fn(self, m, ad)
                self._kaydet(ad, sql, 'feature', aile, py, fonk)
                return self.oge[ad]
        raise KeyError(f'{ad}: SQL kuralı yok')

    # ---- pencere özetleri (_summ, _trend_delta, _kkb_features) --------------
    _TABAN = {'RENK': ('RENK', 'RENK'), 'DAV': ('DAV_SKOR', 'DAV_SKOR'), 'MMS': ('MMS', 'MMS'),
              'ODM': ('KK_ODEME_ORANI', 'KK_ODEME_ORANI'), 'KK_LIMIT': ('KK_LIMIT', 'KK_LIMIT'),
              'KK_RISK': ('KK_RISK', 'KK_RISK'), 'KK_LKO': ('KKU', 'KK_LKO'), 'KKB_SKOR': ('KKB', 'KKB_SKOR')}
    _FONK = {'RENK': '_renk_features', 'DAV': '_dav_features', 'MMS': '_mms_features', 'ODM': '_odeme_features',
             'KK_LIMIT': '_kk_features', 'KK_RISK': '_kk_features', 'KK_LKO': '_kk_features',
             'KKB_SKOR': '_kkb_features'}

    def _pencere_seri(self, P, i0, i1):
        S, ad_taban = self._TABAN[P]
        return self.seri(S, i0, i1), ad_taban

    def _r_ozet(self, m, ad):
        P, ist, tag = m.group(1), m.group(2), m.group(3)
        i0, i1 = _FS_PENCERE[tag]
        xs, taban = self._pencere_seri(P, i0, i1)
        pl = _fs_pl(taban, i0, i1)
        not_ = {'RENK': ' (aktif renk kodları)', 'KKB_SKOR': ' (0 boş sayılır)',
                'KK_LKO': ' (aylık KK_RISK / KK_LIMIT)'}.get(P, '')
        if ist == 'AVG':
            return _fs_ort(xs), P, f'np.nanmean([{pl}]){not_}', self._FONK[P]
        if ist == 'STD':
            return (_fs_std(xs, self.f(f'{P}_AVG_L{tag}')), P,
                    f'np.nanstd([{pl}], ddof=1); dolu ay 0 ya da 1 ise 0{not_}', self._FONK[P])
        if ist == 'MIN':
            return _fs_enk(xs), P, f'np.nanmin([{pl}]){not_}', self._FONK[P]
        if ist == 'MAX':
            return _fs_enb(xs), P, f'np.nanmax([{pl}]){not_}', self._FONK[P]
        return _fs_medyan(xs), P, f'np.nanmedian([{pl}]){not_}', self._FONK[P]

    def _r_trend(self, m, ad):
        P, tur = m.group(1), m.group(2)
        S, taban = self._TABAN[P]
        x = self.seri(S)
        if tur == 'TREND_3_46':
            return (f'{_fs_ort(x[0:3])} - {_fs_ort(x[3:6])}', P,
                    f'np.nanmean([{_fs_pl(taban, 0, 2)}]) - np.nanmean([{_fs_pl(taban, 3, 5)}])', self._FONK[P])
        if tur == 'TREND_6_712':
            return (f'{_fs_ort(x[0:6])} - {_fs_ort(x[6:12])}', P,
                    f'np.nanmean([{_fs_pl(taban, 0, 5)}]) - np.nanmean([{_fs_pl(taban, 6, 11)}])', self._FONK[P])
        if tur == 'TREND_6_79':
            return (f'{_fs_ort(x[0:6])} - {_fs_ort(x[6:9])}', P,
                    f'np.nanmean([{_fs_pl(taban, 0, 5)}]) - np.nanmean([{_fs_pl(taban, 6, 8)}])', self._FONK[P])
        if tur == 'DELTA_1_2':
            return f'{x[0]} - {x[1]}', P, f'{taban}_LM - {taban}_L2M', self._FONK[P]
        if tur == 'DELTA_1_3':
            return f'{x[0]} - {x[2]}', P, f'{taban}_LM - {taban}_L3M', self._FONK[P]
        if tur == 'DELTA_PCT_1_2':
            return _fs_sdiv(f'({x[0]} - {x[1]})', x[1]), P, f'_sdiv({taban}_LM - {taban}_L2M, {taban}_L2M)', self._FONK[P]
        raise KeyError(ad)

    def _r_cv(self, m, ad):
        P = m.group(1)
        return (_fs_sdiv(self.f(f'{P}_STD_L12M'), self.f(f'{P}_AVG_L12M')), P,
                f'_sdiv({P}_STD_L12M, {P}_AVG_L12M)', self._FONK[P])

    def _r_dav_range(self, m, ad):
        return (f"{self.f('DAV_MAX_L12M')} - {self.f('DAV_MIN_L12M')}", 'DAV',
                'DAV_MAX_L12M - DAV_MIN_L12M', '_dav_features')

    # ---- RENK (_renk_features) --------------------------------------------
    def _r_renk(self, m, ad):
        k = m.group(1)
        A = self.seri('RENK')
        H = [self.h(f'RENK_{a}') for a in _FS_AYLAR]
        Hv = [x for x in H if x != 'NULL']
        if k.startswith('CNT_'):
            kod = k[4:]
            if kod == 'RISK':
                return (f"{self.f('RENK_CNT_KIRMIZI')} + {self.f('RENK_CNT_TURUNCU')}", 'RENK',
                        'RENK_CNT_KIRMIZI + RENK_CNT_TURUNCU', '_renk_features')
            if kod == 'GOOD':
                return (_fs_say([f'{x} >= 4' for x in Hv]), 'RENK',
                        '(RENK_LM..RENK_L12M >= 4).sum()  # ham kod', '_renk_features')
            v = next(c for c, n in self.cm.items() if str(n) == kod)
            return (_fs_say([f'{x} = {_fs_lit(v)}' for x in Hv]), 'RENK',
                    f'(RENK_LM..RENK_L12M == {_fs_lit(v)}).sum()  # ham kod', '_renk_features')
        if k == 'RISK_RATIO':
            g = _fs_say([_fs_nn(x) for x in _fs_dolu(A)])
            return (f"CASE WHEN {g} > 0 THEN {self.f('RENK_CNT_RISK')} / {g} END", 'RENK',
                    'RENK_CNT_RISK / aktif renkli ay sayısı; aktif ay yoksa NaN', '_renk_features')
        if k == 'RISK_IN_L3M':
            return (f"CASE WHEN {_fs_biri_dolu(A[:3])} THEN "
                    f"CASE WHEN {' OR '.join(f'{x} <= {self.esik}' for x in _fs_dolu(A[:3]))} THEN 1 ELSE 0 END END",
                    'RENK', f'(aktif RENK_LM..RENK_L3M <= {self.esik}).any(); üçü de boşsa NaN', '_renk_features')
        if k in ('DECLINING', 'IMPROVING'):
            op = '<' if k == 'DECLINING' else '>'
            return (f'CASE WHEN {A[0]} IS NOT NULL AND {A[1]} IS NOT NULL AND {A[2]} IS NOT NULL THEN '
                    f'CASE WHEN {A[0]} {op} {A[1]} AND {A[1]} {op} {A[2]} THEN 1 ELSE 0 END END', 'RENK',
                    f'(RENK_LM {op} RENK_L2M) & (RENK_L2M {op} RENK_L3M); biri boşsa NaN', '_renk_features')
        if k == 'MODE_L12M':
            kodlar = sorted(self.cm)
            c = [self.f(f'RENK_CNT_{self.cm[v]}') for v in kodlar]
            en = c[0] if len(c) == 1 else f"GREATEST({', '.join(c)})"
            dallar = ' '.join(f'WHEN {ci} = {en} THEN {_fs_lit(v)}' for ci, v in zip(c, kodlar))
            return (f'CASE WHEN {en} = 0 THEN NULL {dallar} END', 'RENK',
                    '12 ayın en sık ham renk kodu (eşitlikte küçük kod)', '_renk_features')
        raise KeyError(ad)

    # ---- KKB ek feature'lar ---------------------------------------------------
    def _r_kkb(self, m, ad):
        k = m.group(1)
        V = self.seri('KKB')
        R = [self.h(f'KKB_SKOR_{a}') for a in _FS_AYLAR]
        Rv = [x for x in R if x != 'NULL']
        if k == 'LM_BELOW_AVG12_FLG':
            a = self.f('KKB_SKOR_AVG_L12M')
            return (f'CASE WHEN {V[0]} IS NOT NULL AND {a} IS NOT NULL THEN CASE WHEN {V[0]} < {a} THEN 1 ELSE 0 END END',
                    'KKB_SKOR', 'KKB_SKOR_LM < KKB_SKOR_AVG_L12M (0 boş); biri boşsa NaN', '_kkb_features')
        if k == 'VALID_CNT_L12M':
            return _fs_say([_fs_nn(x) for x in _fs_dolu(V)]), 'KKB_SKOR', 'dolu ve 0 olmayan ay sayısı', '_kkb_features'
        if k == 'ZERO_CNT_L12M':
            return _fs_say([f'{x} = 0' for x in Rv]), 'KKB_SKOR', 'skoru tam 0 olan ay sayısı', '_kkb_features'
        if k == 'NULL_CNT_L12M':
            return _fs_say([f'{x} IS NULL' for x in Rv]), 'KKB_SKOR', 'skoru boş olan ay sayısı', '_kkb_features'
        if k == 'EVER_QUERIED_FLG':
            return (f"CASE WHEN {self.f('KKB_SKOR_VALID_CNT_L12M')} > 0 THEN 1 ELSE 0 END", 'KKB_SKOR',
                    'KKB_SKOR_VALID_CNT_L12M > 0', '_kkb_features')
        raise KeyError(ad)

    # ---- ODM ek feature'lar ---------------------------------------------------
    def _r_odm(self, m, ad):
        k = m.group(1)
        S = self.seri('KK_ODEME_ORANI')
        Sv = _fs_dolu(S)
        dus, tam = self.A['ODM_DUSUK'], self.A['ODM_TAM']
        if k == 'LOW_CNT_L12M':
            return _fs_say([f'{x} < {dus}' for x in Sv]), 'ODM', f'(ödeme oranı < {dus}).sum()', '_odeme_features'
        if k == 'FULL_CNT_L12M':
            return _fs_say([f'{x} >= {tam}' for x in Sv]), 'ODM', f'(ödeme oranı >= {tam}).sum()', '_odeme_features'
        if k == 'LOW_RATIO_L12M':
            g = _fs_say([_fs_nn(x) for x in Sv])
            return (f"CASE WHEN {g} > 0 THEN {_fs_say([f'{x} < {dus}' for x in Sv])} / {g} END", 'ODM',
                    f'(ödeme oranı < {dus}).sum() / dolu ay sayısı; dolu ay yoksa NaN', '_odeme_features')
        if k == 'LOW_IN_L3M':
            return (f"CASE WHEN {_fs_biri_dolu(S[:3])} THEN CASE WHEN "
                    f"{' OR '.join(f'{x} < {dus}' for x in _fs_dolu(S[:3]))} THEN 1 ELSE 0 END END", 'ODM',
                    f'(LM..L3M ödeme oranı < {dus}).any(); üçü de boşsa NaN', '_odeme_features')
        if k == 'LM_BELOW_AVG':
            a = self.f('ODM_AVG_L12M')
            return (f'CASE WHEN {S[0]} IS NOT NULL AND {a} IS NOT NULL THEN CASE WHEN {S[0]} < {a} THEN 1 ELSE 0 END END',
                    'ODM', 'KK_ODEME_ORANI_LM < ODM_AVG_L12M; biri boşsa NaN', '_odeme_features')
        if k == 'LM_TO_AVG_L12M':
            return (_fs_sdiv(S[0], self.f('ODM_AVG_L12M')), 'ODM', '_sdiv(KK_ODEME_ORANI_LM, ODM_AVG_L12M)',
                    '_odeme_features')
        if k == 'DECLINING_3M':
            return (f'CASE WHEN {S[0]} IS NOT NULL AND {S[1]} IS NOT NULL AND {S[2]} IS NOT NULL THEN '
                    f'CASE WHEN {S[0]} < {S[1]} AND {S[1]} < {S[2]} THEN 1 ELSE 0 END END', 'ODM',
                    '(LM < L2M) & (L2M < L3M) ödeme oranı; biri boşsa NaN', '_odeme_features')
        raise KeyError(ad)

    # ---- KK (_kk_features) ----------------------------------------------------
    def _r_kk_lko_ay(self, m, ad):
        a = m.group(1)
        return (_fs_oran(self.h(f'KK_RISK_{a}'), self.h(f'KK_LIMIT_{a}')), 'KK_LKO',
                f'_fe_oran_nan(KK_RISK_{a}, KK_LIMIT_{a}); limit <= 0 / boşsa NaN', '_kk_features')

    def _r_kk_ek(self, m, ad):
        P, k = m.group(1), m.group(2)
        S = self._TABAN[P][0]
        a, b = self.ay(S, 'LM'), self.ay(S, 'L2M')
        if k == 'DELTA_PCT_LM_L2M':
            return _fs_sdiv(f'({a} - {b})', b), P, f'_sdiv({P}_LM - {P}_L2M, {P}_L2M)', '_kk_features'
        if k in ('INC_LM_L2M_FLG', 'DEC_LM_L2M_FLG'):
            op = '>' if k.startswith('INC') else '<'
            return (f'CASE WHEN {a} IS NOT NULL AND {b} IS NOT NULL THEN CASE WHEN {a} {op} {b} THEN 1 ELSE 0 END END',
                    P, f'{P}_LM {op} {P}_L2M; biri boşsa NaN', '_kk_features')
        if k == 'LM_TO_AVG_L3M':
            return _fs_sdiv(a, self.f(f'{P}_AVG_L3M')), P, f'_sdiv({P}_LM, {P}_AVG_L3M)', '_kk_features'
        raise KeyError(ad)

    # ---- hazır pencere oranları (_ratio_features) --------------------------------
    def _r_oran(self, m, ad):
        h = self.h
        tanim = {
            'TAUM_TREND_3_46': (f"{h('TAUM_TUT_AVG_3M')} - {h('TAUM_TUT_AVG_4_6M')}", 'TAUM_TUT_AVG_3M - TAUM_TUT_AVG_4_6M'),
            'TAUM_RATIO_3_6': (_fs_sdiv(h('TAUM_TUT_AVG_3M'), h('TAUM_TUT_AVG_6M')), '_sdiv(TAUM_TUT_AVG_3M, TAUM_TUT_AVG_6M)'),
            'AKB_TAUM_ORAN': (_fs_sdiv(h('SM_AKB_TAUM_TUT_AVG_L3M'), h('TAUM_TUT_AVG_3M')),
                              '_sdiv(SM_AKB_TAUM_TUT_AVG_L3M, TAUM_TUT_AVG_3M)'),
            'ODEME_TREND': (f"{h('BRY_KK_TOPLAM_ODEME_ORANI_L3M')} - {h('BRY_KK_TOPLAM_ODEME_ORANI_L6M')}",
                            'BRY_KK_TOPLAM_ODEME_ORANI_L3M - BRY_KK_TOPLAM_ODEME_ORANI_L6M'),
            'ODEME_AVG': (f"({h('BRY_KK_TOPLAM_ODEME_ORANI_L3M')} + {h('BRY_KK_TOPLAM_ODEME_ORANI_L6M')}) / 2",
                          '(BRY_KK_TOPLAM_ODEME_ORANI_L3M + BRY_KK_TOPLAM_ODEME_ORANI_L6M) / 2'),
            'BSVR_RATIO_3_6': (_fs_sdiv(h('INT_SDM_BSVR_ADT_L3M'), h('INT_SDM_BSVR_ADT_L6M')),
                               '_sdiv(INT_SDM_BSVR_ADT_L3M, INT_SDM_BSVR_ADT_L6M)'),
            'SDM_EKOD_DELTA': (f"{h('INT_SDM_A_EKOD_LM')} - {h('INT_SDM_A_EKOD_L3M')}", 'INT_SDM_A_EKOD_LM - INT_SDM_A_EKOD_L3M'),
            'SHM_EKOD_DELTA': (f"{h('INT_SHM_A_EKOD_LM')} - {h('INT_SHM_A_EKOD_L3M')}", 'INT_SHM_A_EKOD_LM - INT_SHM_A_EKOD_L3M'),
        }
        sql, py = tanim[ad]
        return sql, 'ORAN', py, '_ratio_features'

    # ---- RENK_Y (_renk_yol_features) ---------------------------------------------
    def _r_renk_y(self, m, ad):
        k = m.group(1)
        A = self.seri('RENK')
        H = [self.h(f'RENK_{a}') for a in _FS_AYLAR]
        e = self.esik
        kir = _fs_lit(self.kirmizi)
        T = len(A)
        G = range(T - 1)
        fonk = '_renk_yol_features'

        def bos(sql):
            return f'CASE WHEN {_fs_hepsi_bos(A)} THEN NULL ELSE {sql} END'

        kot = [f'{A[t]} < {A[t + 1]}' for t in G]
        iyi = [f'{A[t]} > {A[t + 1]}' for t in G]
        ayni = [f'{A[t]} = {A[t + 1]}' for t in G]
        degis = [f'{A[t]} <> {A[t + 1]}' for t in G]
        risk = [f'{x} <= {e}' for x in A]
        kirm = [f'{x} = {kir}' for x in A]
        dus = [f'CASE WHEN {A[t]} < {A[t + 1]} THEN {A[t + 1]} - {A[t]} ELSE 0 END' for t in G]
        yuk = [f'CASE WHEN {A[t]} > {A[t + 1]} THEN {A[t]} - {A[t + 1]} ELSE 0 END' for t in G]
        rg = [f'{A[t]} <= {e} AND {A[t + 1]} > {e}' for t in G]
        rc = [f'{A[t]} > {e} AND {A[t + 1]} <= {e}' for t in G]
        kg = [f'{A[t]} = {kir} AND {A[t + 1]} > {kir}' for t in G]
        kc = [f'{A[t]} > {kir} AND {A[t + 1]} = {kir}' for t in G]
        sgn = [f'SIGN({A[t + 1]} - {A[t]})' for t in G]

        if k == 'GECERLI_AY':
            return _fs_say([_fs_nn(x) for x in _fs_dolu(A)]), 'RENK_Y', 'aktif renkli ay sayısı', fonk
        if k in ('INAKTIF_AY_12M', 'AY_SON_INAKTIF', 'INAKTIFTEN_DONUS_FLG') and self.inaktif is None:
            return ('0' if k != 'AY_SON_INAKTIF' else 'NULL'), 'RENK_Y', 'COLOR_MAP içinde INAKTIF kodu yok', fonk
        if k == 'INAKTIF_AY_12M':
            if self.inaktif is None:
                return '0', 'RENK_Y', 'INAKTIF kodu yok', fonk
            return (_fs_say([f'{x} = {_fs_lit(self.inaktif)}' for x in H if x != 'NULL']), 'RENK_Y',
                    f'(RENK_LM..RENK_L12M == {_fs_lit(self.inaktif)}).sum()', fonk)
        if k == 'AY_SON_INAKTIF':
            return (_fs_ilk([f'{x} = {_fs_lit(self.inaktif)}' for x in H]), 'RENK_Y',
                    '_fe_ilk_true(inaktif)  # 0 = LM', fonk)
        if k == 'INAKTIFTEN_DONUS_FLG':
            return (f"CASE WHEN {A[0]} IS NOT NULL AND ({' OR '.join(f'{x} = {_fs_lit(self.inaktif)}' for x in _fs_dolu(H[1:]))}) "
                    f'THEN 1 ELSE 0 END', 'RENK_Y', 'RENK_LM aktif & L2M..L12M içinde INAKTIF ay var', fonk)
        if k == 'EN_KOTU_12M':
            return bos(_fs_enk(A)), 'RENK_Y', 'np.nanmin(aktif renk 12 ay)', fonk
        if k == 'EN_IYI_12M':
            return bos(_fs_enb(A)), 'RENK_Y', 'np.nanmax(aktif renk 12 ay)', fonk
        if k == 'ZIRVEDEN_DUSUS':
            return bos(f"{self.f('RENK_Y_EN_IYI_12M')} - {A[0]}"), 'RENK_Y', 'RENK_Y_EN_IYI_12M - RENK_LM', fonk
        if k == 'DIPTEN_UZAKLIK':
            return bos(f"{A[0]} - {self.f('RENK_Y_EN_KOTU_12M')}"), 'RENK_Y', 'RENK_LM - RENK_Y_EN_KOTU_12M', fonk
        if k == 'NET_KOTULESME_12M':
            eski = A[-1::-1]
            eski = _fs_dolu(eski)
            ifade = eski[0] if len(eski) == 1 else f"COALESCE({', '.join(eski)})"
            return bos(f'{ifade} - {A[0]}'), 'RENK_Y', 'en eski aktif ayın rengi - RENK_LM', fonk
        if k == 'NET_KOTULESME_3AY':
            return bos(f'{A[2]} - {A[0]}'), 'RENK_Y', 'RENK_L3M - RENK_LM', fonk
        if k == 'NET_KOTULESME_6AY':
            return bos(f'{A[5]} - {A[0]}'), 'RENK_Y', 'RENK_L6M - RENK_LM', fonk
        tekil = {
            'AY_SON_KIRMIZI': (_fs_ilk(kirm), '_fe_ilk_true(kir)'),
            'AY_SON_RISK': (_fs_ilk(risk), '_fe_ilk_true(risk)'),
            'AY_SON_KOTULESME': (_fs_ilk(kot), '_fe_ilk_true(kot)  # geçiş'),
            'AY_SON_IYILESME': (_fs_ilk(iyi), '_fe_ilk_true(iyi)  # geçiş'),
            'KIRMIZI_GORDU_12M': (f"CASE WHEN {' OR '.join(kirm)} THEN 1 ELSE 0 END", 'kir.any()'),
            'RISK_SERI_SIMDI': (_fs_seri_goreli(risk), '_fe_seri_simdi(risk)'),
            'RISK_EN_UZUN_SERI': (_fs_en_uzun(risk), '_fe_en_uzun_seri(risk)'),
            'KOTULESME_SERI_SIMDI': (_fs_seri_goreli(kot), '_fe_seri_simdi(kot)'),
            'IYILESME_SERI_SIMDI': (_fs_seri_goreli(iyi), '_fe_seri_simdi(iyi)'),
            'SON_IYILESMEDEN_BERI_DUSUS': (_fs_kuyruk_toplam([f'{A[t]} <= {A[t + 1]}' for t in G],
                                                             [f'({A[t + 1]} - {A[t]})' for t in G]),
                                           'dus[geçiş < _fe_seri_simdi(pair & (d <= 0))].sum()'),
            'SON_KOTULESMEDEN_BERI_YUKSELIS': (_fs_kuyruk_toplam([f'{A[t]} >= {A[t + 1]}' for t in G],
                                                                 [f'({A[t]} - {A[t + 1]})' for t in G]),
                                               'yuk[geçiş < _fe_seri_simdi(pair & (d >= 0))].sum()'),
            'KOTULESME_ADET_6M': (_fs_say(kot[:5]), 'kot[:, :5].sum()'),
            'KOTULESME_ADET_12M': (_fs_say(kot), 'kot.sum()'),
            'IYILESME_ADET_6M': (_fs_say(iyi[:5]), 'iyi[:, :5].sum()'),
            'IYILESME_ADET_12M': (_fs_say(iyi), 'iyi.sum()'),
            'KOTULESME_BASAMAK_6M': ('(' + ' + '.join(dus[:5]) + ')', 'dus[:, :5].sum()'),
            'KOTULESME_BASAMAK_12M': ('(' + ' + '.join(dus) + ')', 'dus.sum()'),
            'IYILESME_BASAMAK_6M': ('(' + ' + '.join(yuk[:5]) + ')', 'yuk[:, :5].sum()'),
            'IYILESME_BASAMAK_12M': ('(' + ' + '.join(yuk) + ')', 'yuk.sum()'),
            'MAX_TEK_DUSUS_12M': (f"GREATEST({', '.join(dus)})", 'dus.max()'),
            'DEGISIM_ADET_12M': (_fs_say(degis), '(pair & (d != 0)).sum()'),
            'YON_DEGISIM_12M': (self._yon_degisim([f'COALESCE(SIGN({A[t]} - {A[t + 1]}), 0)' for t in G]),
                                '_fe_yon_degisim(d, pair)'),
            'KIRMIZIYA_GIRIS_12M': (_fs_say(kg), f'(pair & (yeni == {kir}) & (eski > {kir})).sum()'),
            'RISKE_GIRIS_12M': (_fs_say(rg), f'(pair & (yeni <= {e}) & (eski > {e})).sum()'),
            'RISKTEN_CIKIS_12M': (_fs_say(rc), f'(pair & (yeni > {e}) & (eski <= {e})).sum()'),
            'RISKE_YENIDEN_GIRIS_12M': ('(' + ' + '.join(
                _fs_b(f"{rg[t]} AND ({' OR '.join(f'({c})' for c in rc[t + 1:])})") for t in G if t + 1 < len(rc)) + ')'
                if len(rc) > 1 else '0',
                'riske_giris & (geçiş < en eski riskten çıkış).sum()'),
            'KIRMIZI_SERI_SIMDI': (_fs_seri_goreli(kirm), '_fe_seri_simdi(kir)'),
            'AY_SON_KIRMIZIYA_GIRIS': (_fs_ilk(kg), '_fe_ilk_true(kir_giris)'),
            'AY_ILK_KIRMIZIYA_GIRIS': (_fs_son(kg), '_fe_son_true(kir_giris)'),
            'AY_SON_KIRMIZIDAN_CIKIS': (_fs_ilk(kc), '_fe_ilk_true(kir_cikis)'),
            'SON_KIRMIZI_DONEM_SURE': (_fs_son_donem(kirm), '_fe_son_donem_sure(kir)'),
            'AY_SON_RISKE_GIRIS': (_fs_ilk(rg), '_fe_ilk_true(riske_giris)'),
            'AY_SON_RISKTEN_CIKIS': (_fs_ilk(rc), '_fe_ilk_true(riskten_cikis)'),
            'SON_RISK_DONEM_SURE': (_fs_son_donem(risk), '_fe_son_donem_sure(risk)'),
            'SON_HAREKET': ('CASE ' + ' '.join(f'WHEN {degis[t]} THEN {sgn[t]}' for t in G) + ' ELSE 0 END',
                            '_fe_son_iki_hareket(-d, pair)[0]  # +1 kötüleşme, -1 iyileşme, yoksa 0'),
            'ONCEKI_HAREKET': ('CASE ' + ' '.join(
                f"WHEN {degis[t]} THEN CASE {' '.join(f'WHEN {degis[u]} THEN {sgn[u]}' for u in range(t + 1, T - 1))} "
                f"ELSE 0 END" if t + 1 < T - 1 else f'WHEN {degis[t]} THEN 0' for t in G) + ' ELSE 0 END',
                               '_fe_son_iki_hareket(-d, pair)[1]'),
            'AY_SON_HAREKET': (_fs_ilk(degis), '_fe_son_iki_hareket(-d, pair)[2]'),
            'SON_HAREKET_BASAMAK': ('CASE ' + ' '.join(f'WHEN {degis[t]} THEN ABS({A[t]} - {A[t + 1]})' for t in G)
                                    + ' END', '|d| (en yeni değişim); değişim yoksa NaN'),
            'KOTULESME_HIZLANMA': (f'({_fs_ort(A[3:6])} - {_fs_ort(A[0:3])}) - ({_fs_ort(A[6:12])} - {_fs_ort(A[3:6])})',
                                   '(ort(L4M..L6M) - ort(LM..L3M)) - (ort(L7M..L12M) - ort(L4M..L6M))'),
            'EGIM_6M': (_fs_egim(A[:6]), '_fe_egim(M, 6)'),
            'EGIM_12M': (_fs_egim(A), '_fe_egim(M, 12)'),
        }
        if k in tekil:
            sql, py = tekil[k]
            return bos(sql), 'RENK_Y', py, fonk
        if k == 'MEVCUT_RENKTE_SURE':
            return (bos(f'CASE WHEN {A[0]} IS NOT NULL THEN 1 + {_fs_seri_goreli(ayni)} END'), 'RENK_Y',
                    '1 + _fe_seri_simdi(ayni); RENK_LM boşsa NaN', fonk)
        if k == 'TEK_RISK_DONEMI_FLG':
            return (bos(f"CASE WHEN {risk[0]} AND {_fs_say(risk)} = {self.f('RENK_Y_RISK_SERI_SIMDI')} THEN 1 ELSE 0 END"),
                    'RENK_Y', 'risk[:, 0] & (risk.sum() == RENK_Y_RISK_SERI_SIMDI)', fonk)
        mm = re.fullmatch(r'(KIRMIZI|RISK)_SONRASI_(EN_IYI|GERI_DUSUS)', k)
        if mm:
            maske = kirm if mm.group(1) == 'KIRMIZI' else risk
            if mm.group(2) == 'EN_IYI':
                dallar = ' '.join(f'WHEN {maske[i]} THEN {_fs_enb(A[:i]) if i else "NULL"}' for i in range(T))
                return (bos(f'CASE {dallar} ELSE NULL END'), 'RENK_Y',
                        f'en yeni {mm.group(1).lower()} aydan sonraki (daha yeni) aylarda en büyük aktif renk', fonk)
            return (bos(f"{self.f(f'RENK_Y_{mm.group(1)}_SONRASI_EN_IYI')} - {A[0]}"), 'RENK_Y',
                    f'RENK_Y_{mm.group(1)}_SONRASI_EN_IYI - RENK_LM', fonk)
        mm = re.fullmatch(r'(NUKS|TOPARLANMA|ART_ARDA_KOTULESME|ART_ARDA_IYILESME)_FLG', k)
        if mm:
            s1, s2 = {'NUKS': (1, -1), 'TOPARLANMA': (-1, 1), 'ART_ARDA_KOTULESME': (1, 1),
                      'ART_ARDA_IYILESME': (-1, -1)}[mm.group(1)]
            return (bos(f"CASE WHEN {self.f('RENK_Y_GECERLI_AY')} >= 3 THEN CASE WHEN {self.f('RENK_Y_SON_HAREKET')} = {s1} "
                        f"AND {self.f('RENK_Y_ONCEKI_HAREKET')} = {s2} THEN 1 ELSE 0 END END"), 'RENK_Y',
                    f'SON_HAREKET == {s1} & ONCEKI_HAREKET == {s2}; aktif ay < 3 ise NaN', fonk)
        raise KeyError(ad)

    @staticmethod
    def _yon_degisim(s):
        """_fe_yon_degisim: sıfır olmayan hareketlerde yönün tersine dönme sayısı. s[t]: -1/0/+1."""
        terimler = []
        for t in range(len(s) - 1):
            once = ' '.join(f'WHEN {s[u]} <> 0 THEN CASE WHEN {s[u]} <> {s[t]} THEN 1 ELSE 0 END'
                            for u in range(t + 1, len(s)))
            terimler.append(f'CASE WHEN {s[t]} = 0 THEN 0 ELSE CASE {once} ELSE 0 END END')
        return '(' + ' + '.join(terimler) + ')' if terimler else '0'

    # ---- <seri>_D_* (_seri_dinamik_features) --------------------------------------
    def _r_d(self, m, ad):
        P, k = m.group(1), m.group(2)
        M = self.seri(_FS_SERI[P][0])
        T = len(M)
        G = range(T - 1)
        fonk = '_seri_dinamik_features'
        if k == 'GECERLI_AY':
            return _fs_say([_fs_nn(x) for x in _fs_dolu(M)]), f'{P}_D', 'dolu ay sayısı', fonk

        def bos(sql):
            return f'CASE WHEN {_fs_hepsi_bos(M)} THEN NULL ELSE {sql} END'

        art = [f'{M[t]} > {M[t + 1]}' for t in G]
        az = [f'{M[t]} < {M[t + 1]}' for t in G]
        tanim = {
            'EGIM_3M': (_fs_egim(M[:3]), '_fe_egim(M, 3)'),
            'EGIM_6M': (_fs_egim(M[:6]), '_fe_egim(M, 6)'),
            'EGIM_12M': (_fs_egim(M), '_fe_egim(M, 12)'),
            'IVME': (f'({_fs_ort(M[0:3])} - {_fs_ort(M[3:6])}) - ({_fs_ort(M[3:6])} - {_fs_ort(M[6:9])})',
                     '(ort(LM..L3M) - ort(L4M..L6M)) - (ort(L4M..L6M) - ort(L7M..L9M))'),
            'ARTIS_SERI': (_fs_seri_goreli(art), '_fe_seri_simdi(pair & (d > 0))'),
            'AZALIS_SERI': (_fs_seri_goreli(az), '_fe_seri_simdi(pair & (d < 0))'),
            'ARTIS_ADET_12M': (_fs_say(art), '(pair & (d > 0)).sum()'),
            'AZALIS_ADET_12M': (_fs_say(az), '(pair & (d < 0)).sum()'),
            'MAX_AYLIK_ARTIS': (f"GREATEST({', '.join(f'CASE WHEN {M[t]} > {M[t + 1]} THEN {M[t]} - {M[t + 1]} ELSE 0 END' for t in G)})",
                                'np.where(art, d, 0).max()'),
            'MAX_AYLIK_AZALIS': (f"GREATEST({', '.join(f'CASE WHEN {M[t]} < {M[t + 1]} THEN {M[t + 1]} - {M[t]} ELSE 0 END' for t in G)})",
                                 'np.where(az, -d, 0).max()'),
            'YON_DEGISIM_12M': (self._yon_degisim([f'COALESCE(SIGN({M[t]} - {M[t + 1]}), 0)' for t in G]),
                                '_fe_yon_degisim(d, pair)'),
        }
        if k in tanim:
            sql, py = tanim[k]
            return bos(sql), f'{P}_D', py, fonk
        if k == 'ZSKOR_LM':
            n, o, s = self.gecmis(P)
            return (bos(f'CASE WHEN {n} >= 3 AND {s} > 0 AND {M[0]} IS NOT NULL THEN ({M[0]} - {o}) / {s} END'),
                    f'{P}_D', '(LM - ort(L2M..L12M)) / std(L2M..L12M, n-1); en az 3 geçmiş ay ve std > 0', fonk)
        n, mn, mx = self.istat(P)
        if k == 'ZIRVEDEN_FARK':
            return bos(f'{mx} - {M[0]}'), f'{P}_D', 'np.nanmax(M) - LM', fonk
        if k == 'DIPTEN_FARK':
            return bos(f'{M[0]} - {mn}'), f'{P}_D', 'LM - np.nanmin(M)', fonk
        if k == 'AY_SON_ZIRVE':
            return bos(_fs_ilk([f'{x} = {mx}' for x in M])), f'{P}_D', '_fe_ilk_true(M == max)', fonk
        if k == 'AY_SON_DIP':
            return bos(_fs_ilk([f'{x} = {mn}' for x in M])), f'{P}_D', '_fe_ilk_true(M == min)', fonk
        raise KeyError(ad)

    # ---- ESZ_* (_eszamanli_features) -----------------------------------------------
    def _esz_parca(self, j):
        """3M (j=2) / 6M (j=5): her seri için (ölçüldü, kötüleşti) koşulları."""
        out = []
        for P, S, yon in self.yonlu():
            x0, xj = self.ay(S, 'LM'), self.ay(S, _FS_AYLAR[j])
            olc = f'{x0} IS NOT NULL AND {xj} IS NOT NULL'
            kotu = f'{x0} < {xj}' if yon > 0 else f'{x0} > {xj}'
            out.append((P, olc, kotu, x0, xj, yon))
        return out

    def _r_esz(self, m, ad):
        k = m.group(1)
        fonk = '_eszamanli_features'
        mm = re.fullmatch(r'(KOTULESEN_SINYAL|OLCULEN_SINYAL|KOTULESEN_ORAN)_(3M|6M)', k)
        if mm:
            j = 2 if mm.group(2) == '3M' else 5
            p = self._esz_parca(j)
            sayi = _fs_say([f'{kotu}' for _, _, kotu, *_ in p])
            olculen = _fs_say([olc for _, olc, *_ in p])
            if mm.group(1) == 'KOTULESEN_SINYAL':
                return (f'CASE WHEN {olculen} > 0 THEN {sayi} END', 'ESZ',
                        'kötü yöne giden gösterge sayısı (LM ile pencere başı); ölçülen yoksa NaN', fonk)
            if mm.group(1) == 'OLCULEN_SINYAL':
                return olculen, 'ESZ', 'iki ayı da dolu gösterge sayısı', fonk
            s, o = self.f(f'ESZ_KOTULESEN_SINYAL_{mm.group(2)}'), self.f(f'ESZ_OLCULEN_SINYAL_{mm.group(2)}')
            return (f'CASE WHEN {o} > 0 THEN {s} / {o} END', 'ESZ', 'KOTULESEN_SINYAL / OLCULEN_SINYAL', fonk)
        if k in ('DIPTE_SINYAL_12M', 'DIPTE_ORAN_12M'):
            olc, dip = [], []
            for P, S, yon in self.yonlu():
                n, mn, mx = self.istat(P)
                x0 = self.ay(S, 'LM')
                o = f'{n} >= 3 AND {x0} IS NOT NULL AND {mx} > {mn}'
                olc.append(o)
                dip.append(f'{o} AND {x0} {"<=" if yon > 0 else ">="} {mn if yon > 0 else mx}')
            if k == 'DIPTE_SINYAL_12M':
                return (f'CASE WHEN {_fs_say(olc)} > 0 THEN {_fs_say(dip)} END', 'ESZ',
                        'LM değeri 12 ayın en kötüsünde olan gösterge sayısı (en az 3 dolu ay, seri sabit değil)', fonk)
            return (f"CASE WHEN {_fs_say(olc)} > 0 THEN {self.f('ESZ_DIPTE_SINYAL_12M')} / {_fs_say(olc)} END", 'ESZ',
                    'ESZ_DIPTE_SINYAL_12M / ölçülebilen gösterge sayısı', fonk)
        mm = re.fullmatch(r'(.+)_KOTU_3M', k)
        if mm:
            ciftler = {'RENK_ODEME': ('RENK', 'ODM'), 'RENK_KKB': ('RENK', 'KKB'), 'ODEME_KKB': ('ODM', 'KKB'),
                       'RENK_KKU': ('RENK', 'KKU'), 'RENK_DAV': ('RENK', 'DAV'), 'RENK_MMS': ('RENK', 'MMS'),
                       'DAV_MMS': ('DAV', 'MMS')}
            a, b = ciftler[mm.group(1)]
            p = {P: (olc, kotu) for P, olc, kotu, *_ in self._esz_parca(2)}
            return (f'CASE WHEN {p[a][0]} AND {p[b][0]} THEN CASE WHEN {p[a][1]} AND {p[b][1]} THEN 1 ELSE 0 END END',
                    'ESZ', f'{a} ve {b} ikisi de LM ile L3M arasında kötüleştiyse 1; biri ölçülemezse NaN', fonk)
        raise KeyError(ad)

    # ---- GIZLI_* (_gizli_kotulesme_features) -----------------------------------------
    def _r_gizli(self, m, ad):
        tur, tag = m.group(1), m.group(2)
        j = 2 if tag == '3M' else 5
        A = self.seri('RENK')
        r0, rj = A[0], A[j]
        renk_olc = f'{r0} IS NOT NULL AND {rj} IS NOT NULL'
        diger = [x for x in self._esz_parca(j) if x[0] != 'RENK']
        sayi = _fs_say([kotu for _, _, kotu, *_ in diger])
        olculen = _fs_say([olc for _, olc, *_ in diger])
        gecerli = f'{renk_olc} AND {olculen} > 0'
        fonk = '_gizli_kotulesme_features'
        if tur == 'KOTULESEN_SINYAL':
            return (f'CASE WHEN {gecerli} THEN CASE WHEN {r0} >= {rj} THEN {sayi} ELSE 0 END END', 'GIZLI',
                    'renk kötüleşmediyse diğer göstergelerden kötüleşen sayısı, kötüleştiyse 0', fonk)
        if tur == 'KOTULESME_FLG':
            return (f'CASE WHEN {gecerli} THEN CASE WHEN {r0} >= {rj} AND {sayi} >= 1 THEN 1 ELSE 0 END END', 'GIZLI',
                    'renk kötüleşmedi ve en az 1 gösterge kötüleşti', fonk)
        terimler = []
        for P, olc, kotu, x0, xj, yon in diger:
            fark = f'({xj} - {x0})' if yon > 0 else f'({x0} - {xj})'
            terimler.append(f'CASE WHEN {kotu} AND ABS({xj}) > 0 THEN {fark} / ABS({xj}) ELSE 0 END')
        buyukluk = '(' + ' + '.join(terimler) + ')' if terimler else '0'
        return (f'CASE WHEN {gecerli} THEN CASE WHEN {r0} >= {rj} THEN {buyukluk} ELSE 0 END END', 'GIZLI',
                'kötüleşen göstergelerin |LM - pencere başı| / |pencere başı| toplamı; renk kötüleştiyse 0', fonk)

    # ---- INT_*_INTD_* (_int_degisim_features) ----------------------------------------
    def _int_pencereler(self, aile):
        return [w for w in self.A['INT_PENCERELER'] if f'{aile}_{w}' in self.ham]

    def _r_intd(self, m, ad):
        aile, k = m.group(1), m.group(2)
        fonk = '_int_degisim_features'
        if k == 'DURDU_FLG':
            ws = self._int_pencereler(aile)
            yakin, uzaklar = ws[0], ws[1:]
            y = _fs_q(f'{aile}_{yakin}')
            u = [_fs_q(f'{aile}_{w}') for w in uzaklar]
            return (f"CASE WHEN {y} IS NOT NULL AND {_fs_biri_dolu(u)} THEN CASE WHEN {y} = 0 AND "
                    f"({' OR '.join(f'{x} > 0' for x in u)}) THEN 1 ELSE 0 END END", 'INT',
                    f'{aile}_{yakin} == 0 & uzak pencerelerden biri > 0; ölçülemezse NaN', fonk)
        yakin, uzak = k.split('_')
        return (_fs_oran(self.h(f'{aile}_{yakin}'), self.h(f'{aile}_{uzak}')), 'INT',
                f'_fe_oran_nan({aile}_{yakin}, {aile}_{uzak})', fonk)

    # ---- BV_* (_borc_varlik_features) -------------------------------------------------
    def _r_bv(self, m, ad):
        h = self.h
        t3, t46, r0, r3 = h('TAUM_TUT_AVG_3M'), h('TAUM_TUT_AVG_4_6M'), h('KK_RISK_LM'), h('KK_RISK_L3M')
        fonk = '_borc_varlik_features'
        tanim = {
            'BV_TAUM_DEGISIM_ORAN_3_46': (_fs_oran(f'({t3} - {t46})', t46),
                                          '_fe_oran_nan(TAUM_TUT_AVG_3M - TAUM_TUT_AVG_4_6M, TAUM_TUT_AVG_4_6M)'),
            'BV_KK_RISK_TAUM_ORAN': (_fs_oran(r0, t3), '_fe_oran_nan(KK_RISK_LM, TAUM_TUT_AVG_3M)'),
            'BV_BORC_ARTIYOR_VARLIK_AZALIYOR_FLG': (
                f'CASE WHEN {r0} IS NOT NULL AND {r3} IS NOT NULL AND {t3} IS NOT NULL AND {t46} IS NOT NULL THEN '
                f'CASE WHEN {r0} > {r3} AND {t3} < {t46} THEN 1 ELSE 0 END END',
                '(KK_RISK_LM > KK_RISK_L3M) & (TAUM_TUT_AVG_3M < TAUM_TUT_AVG_4_6M); biri boşsa NaN'),
        }
        if ad == 'BV_KK_RISK_TAUM_ORAN_DEGISIM':
            return (f"{self.f('BV_KK_RISK_TAUM_ORAN')} - {_fs_oran(r3, t46)}", 'BV',
                    'BV_KK_RISK_TAUM_ORAN - _fe_oran_nan(KK_RISK_L3M, TAUM_TUT_AVG_4_6M)', fonk)
        sql, py = tanim[ad]
        return sql, 'BV', py, fonk

    # ---- KK_O_* (_kk_olay_features) ----------------------------------------------------
    def _r_kk_o(self, m, ad):
        k = m.group(1)
        L = self.seri('LIMIT')
        R = [self.h(f'KK_RISK_{a}') for a in _FS_AYLAR]
        U = self.seri('KKU')
        T = len(L)
        G = range(T - 1)
        fonk = '_kk_olay_features'
        bos_kosul = _fs_hepsi_bos(_fs_dolu(L) + _fs_dolu(R))

        def bos(sql):
            return f'CASE WHEN {bos_kosul} THEN NULL ELSE {sql} END'

        dus = [f'{L[t]} < {L[t + 1]}' for t in G]
        art = [f'{L[t]} > {L[t + 1]}' for t in G]
        sifir = [f'{x} <= 0' for x in R]
        tanim = {
            'LIMIT_DUSUS_ADET_12M': (_fs_say(dus), 'limit (> 0) düşüş geçişi sayısı'),
            'LIMIT_ARTIS_ADET_12M': (_fs_say(art), 'limit (> 0) artış geçişi sayısı'),
            'AY_SON_LIMIT_DUSUS': (_fs_ilk(dus), '_fe_ilk_true(limit düşüş)'),
            'AY_SON_LIMIT_ARTIS': (_fs_ilk(art), '_fe_ilk_true(limit artış)'),
            'LIMIT_DEGISIM_ORAN_12M': (_fs_oran(L[0], (lambda e: e[0] if len(e) == 1 else f"COALESCE({', '.join(e)})")(
                _fs_dolu(L[::-1]))), '_fe_oran_nan(limit LM, en eski dolu limit)'),
            'SIFIR_BORC_ADET_12M': (_fs_say(sifir), '(KK_RISK <= 0).sum()'),
            'AY_SON_SIFIR_BORC': (_fs_ilk(sifir), '_fe_ilk_true(KK_RISK <= 0)'),
            'BORC_SIFIRDAN_BASLADI_FLG': (
                f'CASE WHEN {R[0]} IS NOT NULL AND ({R[1]} IS NOT NULL OR {R[2]} IS NOT NULL) THEN '
                f'CASE WHEN {R[0]} > 0 AND ({R[1]} <= 0 OR {R[2]} <= 0) THEN 1 ELSE 0 END END',
                'KK_RISK_LM > 0 & (L2M ya da L3M borç <= 0); ölçülemezse NaN'),
        }
        if k in tanim:
            sql, py = tanim[k]
            return bos(sql), 'KK_O', py, fonk
        mm = re.fullmatch(r'KULLANIM_(\d+)_USTU_(ADET_12M|ADET_3M|SERI)|AY_SON_KULLANIM_(\d+)_USTU', k)
        if mm:
            e = int(mm.group(1) or mm.group(3)) / 100.0
            ust = [f'{x} >= {_fs_lit(e)}' for x in U]
            tur = mm.group(2) or 'AY_SON'
            sql, py = {'ADET_12M': (_fs_say(ust), f'(kullanım >= {_fs_lit(e)}).sum()'),
                       'ADET_3M': (_fs_say(ust[:3]), f'(kullanım >= {_fs_lit(e)})[:, :3].sum()'),
                       'SERI': (_fs_seri_goreli(ust), f'_fe_seri_simdi(kullanım >= {_fs_lit(e)})'),
                       'AY_SON': (_fs_ilk(ust), f'_fe_ilk_true(kullanım >= {_fs_lit(e)})')}[tur]
            return bos(sql), 'KK_O', py, fonk
        raise KeyError(ad)

    # ---- OK_* (_odeme_kullanim_features) -------------------------------------------------
    def _r_ok(self, m, ad):
        k = m.group(1)
        O = self.seri('KK_ODEME_ORANI')
        U = self.seri('KKU')
        A = self.A
        olc = [f'{o} IS NOT NULL AND {u} IS NOT NULL' for o, u in zip(O, U)]
        sar = [f'{o} < {A["ODM_DUSUK"]} AND {u} >= {_fs_lit(A["KKU_YUKSEK"])}' for o, u in zip(O, U)]
        sag = [f'{o} >= {A["ODM_TAM"]} AND {u} < {_fs_lit(A["KKU_DUSUK"])}' for o, u in zip(O, U)]
        fonk = '_odeme_kullanim_features'
        tanim = {
            'DUSUK_ODEME_YUKSEK_KULLANIM_ADET_3M': (_fs_say(sar[:3]), 'sarmal[:, :3].sum()'),
            'DUSUK_ODEME_YUKSEK_KULLANIM_ADET_6M': (_fs_say(sar[:6]), 'sarmal[:, :6].sum()'),
            'DUSUK_ODEME_YUKSEK_KULLANIM_ADET_12M': (_fs_say(sar), 'sarmal.sum()'),
            'AY_SON_DUSUK_ODEME_YUKSEK_KULLANIM': (_fs_ilk(sar), '_fe_ilk_true(sarmal)'),
            'DUSUK_ODEME_YUKSEK_KULLANIM_SERI': (_fs_seri_goreli(sar), '_fe_seri_simdi(sarmal)'),
            'TAM_ODEME_DUSUK_KULLANIM_ADET_12M': (_fs_say(sag), 'saglikli.sum()'),
            'OLCULEN_AY_12M': (_fs_say(olc), 'ödeme oranı ve kullanımın ikisi de dolu ay sayısı'),
        }
        sql, py = tanim[k]
        py += f'; sarmal = ödeme < {A["ODM_DUSUK"]} & kullanım >= {_fs_lit(A["KKU_YUKSEK"])}' if 'DUSUK_ODEME' in k else ''
        return f'CASE WHEN {_fs_say(olc)} = 0 THEN NULL ELSE {sql} END', 'OK', py, fonk

    # ---- DS_* (_dis_skor_features) ---------------------------------------------------------
    _DS_CAPRAZ = {'RENK_LM': 'RENK_LM', 'NUKS': 'RENK_Y_NUKS_FLG', 'ARTARDA_KOT': 'RENK_Y_ART_ARDA_KOTULESME_FLG',
                  'DUSUS': 'RENK_Y_SON_IYILESMEDEN_BERI_DUSUS', 'RISK_SERI': 'RENK_Y_RISK_SERI_SIMDI',
                  'GIZLI_3M': 'GIZLI_KOTULESEN_SINYAL_3M', 'ESZ_3M': 'ESZ_KOTULESEN_SINYAL_3M'}

    def _r_ds(self, m, ad):
        fonk = '_dis_skor_features'
        mm = re.fullmatch(r'DS_EXPECTED_LOSS_(KK_RISK|KK_LIMIT|TAUM)_ORAN', ad)
        if mm:
            payda = {'KK_RISK': 'KK_RISK_LM', 'KK_LIMIT': 'KK_LIMIT_LM', 'TAUM': 'TAUM_TUT_AVG_3M'}[mm.group(1)]
            return (_fs_oran(self.h('EXPECTED_LOSS'), self.h(payda)), 'DS', f'_fe_oran_nan(EXPECTED_LOSS, {payda})', fonk)
        for skor in self.A['DIS_SKORLAR']:
            for kisa, kaynak in self._DS_CAPRAZ.items():
                if ad == f'DS_{skor}_X_{kisa}':
                    x = self.ay('RENK', 'LM') if kaynak == 'RENK_LM' else self.f(kaynak)
                    return f'{self.h(skor)} * {x}', 'DS', f'{skor} * {kaynak}', fonk
        raise KeyError(ad)

    # ---- YB_* (_yeni_baslangic_features) -------------------------------------------------
    def _yb_olaylar(self):
        """(olay adı, olay koşulları, ölçüldü koşulları, geçiş mi) listesi; FE sırasıyla."""
        A = self.A
        ol = []
        if self.seri_var('RENK'):
            R = self.seri('RENK')
            ok = [_fs_nn(x) for x in R]
            ol.append(('RISK', [f'{x} <= {self.esik}' for x in R], ok, False))
            ol.append(('KIRMIZI', [f'{x} = {_fs_lit(self.kirmizi)}' for x in R], ok, False))
            ol.append(('RENK_KOTULESME', [f'{R[t]} < {R[t + 1]}' for t in range(11)],
                       [f'{R[t]} IS NOT NULL AND {R[t + 1]} IS NOT NULL' for t in range(11)], True))
        if self.seri_var('KKU'):
            U = self.seri('KKU')
            ok = [_fs_nn(x) for x in U]
            ol.append(('KKU_90', [f'{x} >= 0.9' for x in U], ok, False))
            ol.append(('KKU_ASIM', [f'{x} >= 1' for x in U], ok, False))
        if self.seri_var('KK_ODEME_ORANI'):
            O = self.seri('KK_ODEME_ORANI')
            ol.append(('DUSUK_ODEME', [f'{x} < {A["ODM_DUSUK"]}' for x in O], [_fs_nn(x) for x in O], False))
        if self.seri_var('LIMIT'):
            L = self.seri('LIMIT')
            ol.append(('LIMIT_DUSUS', [f'{L[t]} < {L[t + 1]}' for t in range(11)],
                       [f'{L[t]} IS NOT NULL AND {L[t + 1]} IS NOT NULL' for t in range(11)], True))
        for P, S, yon in self.yonlu():
            if P == 'RENK':
                continue
            M = self.seri(S)
            op = '<' if yon > 0 else '>'
            ol.append((f'{_FS_SERI[P][1]}_BOZULMA', [f'{M[t]} {op} {M[t + 1]}' for t in range(11)],
                       [f'{M[t]} IS NOT NULL AND {M[t + 1]} IS NOT NULL' for t in range(11)], True))
        return ol

    def _r_yb(self, m, ad):
        fonk = '_yeni_baslangic_features'
        if ad == 'YB_YENI_OLAY_SAYISI':
            yeniler = [f'YB_{o[0]}_YENI' for o in self._yb_olaylar()]
            yeniler = [self.f(y) for y in yeniler]
            return (f"CASE WHEN {_fs_say([_fs_nn(y) for y in yeniler])} > 0 THEN "
                    f"({' + '.join(f'COALESCE({y}, 0)' for y in yeniler)}) END", 'YB',
                    'YENI = 1 olan olay sayısı; hiç olay ölçülemezse NaN', fonk)
        mm = re.fullmatch(r'YB_(.+)_YENI_DIP', ad)
        if mm:
            P = _FS_TABAN_P[mm.group(1)]
            S, yon = _FS_SERI[P][0], _FS_SERI[P][2]
            M = self.seri(S)
            n = self.gecmis_n(P)
            esik = _fs_enk(M[1:]) if yon > 0 else _fs_enb(M[1:])
            op = '<' if yon > 0 else '>'
            return (f'CASE WHEN {M[0]} IS NOT NULL AND {n} >= 3 THEN CASE WHEN {M[0]} {op} {esik} THEN 1 ELSE 0 END END',
                    'YB', f'LM önceki 11 ayın en kötüsünden de kötü ({"en düşük" if yon > 0 else "en yüksek"}); '
                          f'en az 3 dolu geçmiş ay', fonk)
        for olay, E, ok, gecis in self._yb_olaylar():
            for tur in ('YENI', 'TEKRAR'):
                if ad != f'YB_{olay}_{tur}':
                    continue
                yakin_ok = '(' + ' OR '.join(f'({o})' for o in ok[:3]) + ')'
                gecmis_say = _fs_say(ok[3:])
                olc = f'{yakin_ok} AND {gecmis_say} >= 3'
                simdi = '(' + ' OR '.join(f'({e})' for e in E[:3]) + ')'
                once = '(' + ' OR '.join(f'({e})' for e in E[3:]) + ')'
                deger = (f'CASE WHEN {once} THEN 0 WHEN {simdi} THEN 1 ELSE 0 END' if tur == 'YENI'
                         else f'CASE WHEN {simdi} AND {once} THEN 1 ELSE 0 END')
                py = ('olay son 3 ' + ('geçişte' if gecis else 'ayda') + (' var, öncesinde yok' if tur == 'YENI'
                                                                           else ' ve öncesinde de var')
                      + '; ölçülemezse NaN')
                return f'CASE WHEN {olc} THEN {deger} END', 'YB', py, fonk
        raise KeyError(ad)

    # ---- OG_* (_oncu_gecikme_features) ---------------------------------------------------
    def _r_og(self, m, ad):
        P, tur = m.group(1), m.group(2)
        fonk = '_oncu_gecikme_features'
        A = self.seri('RENK')
        S, yon = _FS_SERI[P][0], _FS_SERI[P][2]
        M = self.seri(S)
        T1 = 11
        rk = [f'{A[t]} < {A[t + 1]}' for t in range(T1)]
        op = '<' if yon > 0 else '>'
        boz = [f'{M[t]} {op} {M[t + 1]}' for t in range(T1)]
        pair = [f'{M[t]} IS NOT NULL AND {M[t + 1]} IS NOT NULL' for t in range(T1)]
        dallar = []
        for t in range(T1):
            ks = [k for k in (1, 2, 3) if t + k < T1]
            if not ks:
                dallar.append(f'WHEN {rk[t]} THEN NULL')
                continue
            olc = _fs_say([pair[t + k] for k in ks])
            adet = _fs_say([boz[t + k] for k in ks])
            if tur == 'ONCE_BOZULMA_ADET':
                ic = adet
            elif tur == 'ONCU_AY':
                ic = 'CASE ' + ' '.join(f'WHEN {boz[t + k]} THEN {k}' for k in ks) + ' END'
            else:
                ic = '0' if t <= 1 else f'CASE WHEN {adet} > 0 AND ({boz[0]} OR {boz[1]}) THEN 1 ELSE 0 END'
            dallar.append(f'WHEN {rk[t]} THEN CASE WHEN {olc} > 0 THEN {ic} END')
        py = {'ONCE_BOZULMA_ADET': 'son renk düşüşünden önceki 3 geçişte göstergenin kötüleştiği geçiş sayısı',
              'ONCU_AY': 'renk düşüşüne en yakın bozulma kaç geçiş önce (1-3)',
              'DESEN_TEKRARI': 'ONCE_BOZULMA_ADET > 0 & son 2 geçişte gösterge kötüleşti & renk son 2 geçişte '
                               'kötüleşmedi'}[tur]
        return 'CASE ' + ' '.join(dallar) + ' ELSE NULL END', 'OG', py + '; renk hiç kötüleşmediyse NaN', fonk

    # ---- DSN_* (pipeline desen kodlaması) ---------------------------------------------------
    def dsn_anahtar(self, desen):
        """Desen anahtarı (bugünkü desen, LM'den başlayarak) için ara kolon."""
        aylar = _FS_AYLAR[:6]
        aktif = [k for k, v in self.cm.items() if str(v).upper() != 'INAKTIF']
        kodlar = sorted(set(aktif) | {0})

        def renk_str(m):
            c = self.h(f'RENK_{m}')
            return f"CASE {c} " + ' '.join(f"WHEN {_fs_lit(k)} THEN '{int(k)}'" for k in kodlar) + " ELSE 'X' END"

        def kku_str(m):
            lim, rsk = self.h(f'KK_LIMIT_{m}'), self.h(f'KK_RISK_{m}')
            u = f'{rsk} / {lim}'
            return (f"CASE WHEN {lim} > 0 AND {rsk} IS NOT NULL THEN CASE WHEN {u} < 0.3 THEN 'a' WHEN {u} < 0.8 "
                    f"THEN 'b' WHEN {u} < 0.9 THEN 'c' ELSE 'd' END ELSE 'X' END")

        def odm_str(m):
            o = self.h(f'KK_ODEME_ORANI_{m}')
            return f"CASE WHEN {o} IS NULL THEN 'X' WHEN {o} < 20 THEN 'a' WHEN {o} < 100 THEN 'b' ELSE 'c' END"

        def hareket(j):
            a, b = self.h(f'RENK_{aylar[j]}'), self.h(f'RENK_{aylar[j + 1]}')
            kod = ', '.join(_fs_lit(k) for k in sorted(aktif))
            return (f"CASE WHEN {a} IN ({kod}) AND {b} IN ({kod}) THEN CASE WHEN {a} < {b} THEN '-' "
                    f"WHEN {a} > {b} THEN '+' ELSE '0' END ELSE 'X' END")

        parca = {'RENK3': [renk_str(m) for m in aylar[:3]],
                 'RENK_HAREKET5': [hareket(j) for j in range(5)],
                 'KKU3': [kku_str(m) for m in aylar[:3]],
                 'ODM3': [odm_str(m) for m in aylar[:3]],
                 'RENK_KKU_ODM_LM': [renk_str('LM'), kku_str('LM'), odm_str('LM')]}[desen]
        sql = " || '|' || ".join(f'({p})' for p in parca)
        return self.ara(f'ARA_DSN_{desen}', sql, f'_desen_anahtarlari(frame)["{desen}"]')

    def _r_dsn(self, m, ad):
        desen, tur = m.group(1), m.group(2)
        k = self.dsn_anahtar(desen)
        tablo, kl, rk = self.dsn_tablo, self.dsn_klasor, _fs_q(self.dsn_renk)
        kosul = f"d.KLASOR = {kl} AND d.RENK_KOD = {rk} AND d.DESEN_ADI = '{desen}'"
        if tur == 'KOT_ORAN':
            sql = (f'COALESCE((SELECT d.ORAN FROM {tablo} d WHERE {kosul} AND d.DESEN = {k}), '
                   f"(SELECT d.ORAN FROM {tablo} d WHERE {kosul} AND d.DESEN = '#NADIR#'))")
            py = f'desen_kodlama["haritalar"]["{desen}"]["oran"].get(anahtar, nadir_oran)'
        else:
            sql = f'COALESCE((SELECT d.PAY FROM {tablo} d WHERE {kosul} AND d.DESEN = {k}), 0)'
            py = f'desen_kodlama["haritalar"]["{desen}"]["pay"].get(anahtar, 0)'
        return sql, 'DSN', py, '_desen_kodla (pipeline)'

    _KURALLAR = [
        (r'(RENK|DAV|MMS|ODM|KK_LIMIT|KK_RISK|KK_LKO|KKB_SKOR)_(AVG|STD|MIN|MAX|MED)_L(3M|6M|12M|4_6M|6_9M)', _r_ozet),
        (r'(RENK|DAV|MMS|ODM|KK_LIMIT|KK_RISK|KK_LKO|KKB_SKOR)_(TREND_3_46|TREND_6_712|TREND_6_79|DELTA_1_2|DELTA_1_3|'
         r'DELTA_PCT_1_2)', _r_trend),
        (r'(DAV|MMS|ODM)_CV_12M', _r_cv),
        (r'DAV_RANGE_12M', _r_dav_range),
        (r'RENK_Y_(.+)', _r_renk_y),
        (r'RENK_(CNT_.+|RISK_RATIO|RISK_IN_L3M|DECLINING|IMPROVING|MODE_L12M)', _r_renk),
        (r'KKB_SKOR_(LM_BELOW_AVG12_FLG|VALID_CNT_L12M|ZERO_CNT_L12M|NULL_CNT_L12M|EVER_QUERIED_FLG)', _r_kkb),
        (r'ODM_(LOW_CNT_L12M|FULL_CNT_L12M|LOW_RATIO_L12M|LOW_IN_L3M|LM_BELOW_AVG|LM_TO_AVG_L12M|DECLINING_3M)', _r_odm),
        (r'KK_LKO_(LM|L\d+M)', _r_kk_lko_ay),
        (r'(KK_LIMIT|KK_RISK|KK_LKO)_(DELTA_PCT_LM_L2M|INC_LM_L2M_FLG|DEC_LM_L2M_FLG|LM_TO_AVG_L3M)', _r_kk_ek),
        (r'TAUM_TREND_3_46|TAUM_RATIO_3_6|AKB_TAUM_ORAN|ODEME_TREND|ODEME_AVG|BSVR_RATIO_3_6|SDM_EKOD_DELTA|'
         r'SHM_EKOD_DELTA', _r_oran),
        (r'(DAV|MMS|KKB|ODM|KKU)_D_(.+)', _r_d),
        (r'ESZ_(.+)', _r_esz),
        (r'GIZLI_(KOTULESEN_SINYAL|KOTULESME_FLG|KOTULESME_GORELI)_(3M|6M)', _r_gizli),
        (r'(INT_.+)_INTD_(LM_L3M|L3M_L6M|L3M_L12M|L6M_L12M|DURDU_FLG)', _r_intd),
        (r'BV_.+', _r_bv),
        (r'KK_O_(.+)', _r_kk_o),
        (r'OK_(.+)', _r_ok),
        (r'DS_.+', _r_ds),
        (r'YB_.+', _r_yb),
        (r'OG_(KKB|ODM|KKU|DAV|MMS)_(ONCE_BOZULMA_ADET|ONCU_AY|DESEN_TEKRARI)', _r_og),
        (r'DSN_(RENK3|RENK_HAREKET5|KKU3|ODM3|RENK_KKU_ODM_LM)_(KOT_ORAN|PAY)', _r_dsn),
    ]

    # ------------------------------------------------------------------ bağımlılık / katman
    def bagimliliklar(self, ad):
        sql = self.oge[ad]['sql']
        bilinen = set(self.oge) | self.ham
        out = []
        for t in _FS_KIMLIK.findall(sql):
            t2 = t[1:-1].replace('""', '"') if t.startswith('"') else t
            if t2 != ad and t2 in bilinen and t2 not in out:
                out.append(t2)
        return out

    def katman(self, ad, _yol=()):
        o = self.oge.get(ad)
        if o is None:
            return 0
        if 'katman' in o:
            return o['katman']
        if o['tur'] == 'ham':
            o['katman'] = 0
            return 0
        if ad in _yol:
            raise RuntimeError(f'Döngüsel bağımlılık: {" -> ".join(_yol + (ad,))}')
        kt = 1 + max([self.katman(b, _yol + (ad,)) for b in self.bagimliliklar(ad)
                      if b in self.oge and self.oge[b]['tur'] != 'ham'] or [0])
        o['katman'] = kt
        return kt

    def tam_sorgu(self, ciktilar, kaynak='KAYNAK_TABLO', anahtarlar=('MBB_NO', 'DONEM')):
        """Tüm katmanları sırayla hesaplayan tek SELECT; ciktilar sırasıyla döner."""
        for c in ciktilar:
            if c not in self.oge:
                self.uret(c)
        gerek, yigin = set(), [c for c in ciktilar if self.oge[c]['tur'] != 'ham']
        while yigin:                                  # yalnızca istenenlerin bağımlılık kapanışı
            a = yigin.pop()
            if a in gerek:
                continue
            gerek.add(a)
            yigin += [b for b in self.bagimliliklar(a) if b in self.oge and self.oge[b]['tur'] != 'ham']
        hesap = [a for a in self.oge if a in gerek]
        for a in hesap:
            self.katman(a)
        ham_kul = sorted({b for a in hesap for b in self.bagimliliklar(a) if b in self.ham}
                         | {c for c in ciktilar if self.oge.get(c, {}).get('tur') == 'ham'}
                         | ({self.dsn_renk} if any(self.oge[a]['aile'] == 'DSN' for a in hesap) else set()))
        anahtarlar = [a for a in anahtarlar if a not in ham_kul]
        en_ust = max([self.oge[a]['katman'] for a in hesap] or [0])
        satir = [f"  K0 AS (SELECT {', '.join(_fs_q(a) for a in list(anahtarlar) + ham_kul)} FROM {kaynak})"]
        for k in range(1, en_ust + 1):
            yeni = [a for a in hesap if self.oge[a]['katman'] == k]
            sec = ',\n    '.join(f"{self.oge[a]['sql']} AS {_fs_q(a)}" for a in yeni)
            satir.append(f'  K{k} AS (SELECT K{k - 1}.*,\n    {sec}\n  FROM K{k - 1})')
        son = f'K{en_ust}'
        secim = ', '.join(_fs_q(a) for a in list(anahtarlar) + list(ciktilar))
        return 'WITH\n' + ',\n'.join(satir) + f'\nSELECT {secim}\nFROM {son}'


