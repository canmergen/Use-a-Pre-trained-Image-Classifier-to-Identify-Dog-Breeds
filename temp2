:root {
  --kirmizi:      #E4002B;
  --kirmizi-koyu: #B00020;
  --kirmizi-acik: #FEF0F2;
  --zemin:        #F7F8FA;
  --kenar:        #E4E7EC;
  --kenar-acik:   #F0F1F4;
  --metin:        #101828;
  --gri:          #667085;
  --gri-acik:     #98A2B3;
  --yesil:        #12B76A;

  --panel-en:  clamp(228px, 17vw, 278px);
  --sohbet-en: clamp(640px, 62vw, 880px);
  --govde-en:  1560px;
  --yazi:      clamp(13px, .92vw, 14.5px);
  --avatar:    34px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(16px, 2vw, 32px); height: 60px;
  background: #fff; border-bottom: 1px solid var(--kenar); flex-shrink: 0;
}
#ustbar-sol { display: flex; align-items: center; gap: 14px; }
#banner { height: 26px; width: auto; display: block; }
#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 14px; line-height: 1.3; }
#urun-adi { font-weight: 600; }
#urun-alt { font-size: .78em; color: var(--gri-acik); }

#ustbar-sag { display: flex; align-items: center; gap: 12px; }
#durum-rozet { display: inline-flex; align-items: center; gap: 6px; font-size: .82em; color: var(--gri); }
.nokta-yesil { width: 7px; height: 7px; border-radius: 50%; background: var(--yesil); display: inline-block; }

#sifirla-btn {
  font-size: .82em; font-weight: 500; padding: 6px 14px;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 6px; cursor: pointer; color: var(--gri);
}
#sifirla-btn:hover { border-color: var(--kirmizi); color: var(--kirmizi); }

/* ==================== GÖVDE ==================== */
#govde {
  flex: 1; display: flex; min-height: 0;
  width: 100%; max-width: var(--govde-en); margin: 0 auto;
  background: #fff;
  border-left: 1px solid var(--kenar); border-right: 1px solid var(--kenar);
}

/* -------- Sol panel: stepper -------- */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: #FCFCFD; border-right: 1px solid var(--kenar);
  padding: 18px 15px 32px; overflow-y: auto;
}
.panel-ust {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 11px;
}
.panel-baslik {
  font-size: .72em; font-weight: 700; letter-spacing: .09em; color: var(--gri-acik);
}
.komut-baslik { display: block; margin: 26px 0 10px; }

#bilgi-btn {
  width: 18px; height: 18px; padding: 0; line-height: 1;
  border: 1px solid var(--kenar); background: #fff; color: var(--gri-acik);
  border-radius: 50%; font-size: .74em; font-weight: 700; cursor: pointer;
}
#bilgi-btn:hover, #bilgi-btn.acik { border-color: var(--kirmizi); color: var(--kirmizi); }

#bilgi-kutu {
  background: #fff; border: 1px solid var(--kenar); border-radius: 8px;
  padding: 12px 13px; margin-bottom: 14px;
}
#bilgi-kutu.gizli { display: none; }
#bilgi-kutu p { margin: 0 0 8px; font-size: .8em; line-height: 1.6; color: var(--gri); }
#bilgi-kutu p:last-child { margin-bottom: 0; }
#bilgi-kutu b { color: var(--metin); font-weight: 600; }

#adim-listesi { list-style: none; margin: 0; padding: 0; }
#adim-listesi li {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 9px; border-radius: 6px; margin-bottom: 1px;
  color: var(--gri-acik); cursor: pointer;
}
#adim-listesi li:hover { background: var(--kenar-acik); }
#adim-listesi li.aktif:hover { background: var(--kirmizi-acik); }

.adim-isaret {
  flex-shrink: 0; width: 17px; height: 17px; margin-top: 1px;
  border: 1.5px solid currentColor; border-radius: 50%;
  font-size: .62em; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-variant-numeric: tabular-nums;
}
#adim-listesi li.tamam { color: var(--gri); }
#adim-listesi li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff; font-size: .7em;
}
#adim-listesi li.aktif { background: var(--kirmizi-acik); color: var(--kirmizi); }
#adim-listesi li.aktif .adim-isaret {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.adim-govde { min-width: 0; flex: 1; }
.adim-ad { font-size: .87em; font-weight: 500; line-height: 1.35; }
#adim-listesi li.aktif .adim-ad { font-weight: 600; }

/* Aciklama sadece aktif ya da tiklanmis adimda gorunur -> panel kalabalik olmuyor */
.adim-aciklama {
  font-size: .77em; line-height: 1.5; margin-top: 4px; opacity: .88; display: none;
}
#adim-listesi li.aktif .adim-aciklama,
#adim-listesi li.acik  .adim-aciklama { display: block; }

.panel-not {
  display: grid; grid-template-columns: auto 1fr;
  gap: 7px 10px; align-items: center; font-size: .81em; color: var(--gri);
}
.panel-not b {
  font-family: ui-monospace, Consolas, monospace;
  font-size: .88em; color: var(--metin);
  background: var(--zemin); border: 1px solid var(--kenar);
  padding: 2px 7px; border-radius: 4px; text-align: center;
}

/* -------- Sohbet alanı -------- */
#sohbet-alani { flex: 1; display: flex; flex-direction: column; min-width: 0; }

#ozet-serit {
  display: flex; border-bottom: 1px solid var(--kenar);
  background: #FCFCFD; flex-shrink: 0;
}
.ozet-kart {
  flex: 1; padding: 11px clamp(12px, 1.5vw, 24px);
  border-right: 1px solid var(--kenar-acik); min-width: 0;
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: .69em; letter-spacing: .07em;
  color: var(--gri-acik); text-transform: uppercase; margin-bottom: 4px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: .85em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--gri-acik); font-weight: 400; }
.ozet-alt {
  display: block; font-size: .73em; color: var(--gri); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#sohbet { flex: 1; overflow-y: auto; padding: 22px clamp(16px, 2.2vw, 34px) 10px; }

.satir {
  display: flex; align-items: flex-start; gap: 11px;
  margin: 0 auto 18px; max-width: var(--sohbet-en);
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid var(--kenar);
}

.balon {
  padding: 12px 15px; border-radius: 10px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 80%;
}
/* Bot ciktilari bosluklarla hizali -> monospace sart */
.satir.bot .balon {
  background: #fff; border: 1px solid var(--kenar);
  border-top-left-radius: 2px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .88em;
}
.satir.kullanici .balon {
  background: var(--kirmizi); color: #fff;
  border-top-right-radius: 2px; font-size: .95em;
}
.satir.bot .balon.hata {
  background: #FFFBFA; border-color: #FDA29B; color: #B42318;
}

/* -------- Veri seçim kartı -------- */
#secici-kart {
  max-width: var(--sohbet-en); margin: 0 auto 20px;
  background: #fff; border: 1px solid var(--kenar);
  border-radius: 10px; padding: 18px 20px 20px;
  box-shadow: 0 1px 3px rgba(16,24,40,.05);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 600; font-size: .98em; margin-bottom: 4px; }
.kart-alt { font-size: .82em; color: var(--gri); line-height: 1.55; margin-bottom: 16px; }

.kart-govde { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 185px; }
.combo label {
  display: block; font-size: .76em; color: var(--gri);
  margin-bottom: 5px; font-weight: 500;
}
.combo-giris {
  width: 100%; padding: 9px 11px;
  border: 1px solid var(--kenar); border-radius: 7px;
  font-family: ui-monospace, Consolas, monospace;
  font-size: .85em; outline: none; background: #fff;
}
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
.combo-giris.secili { border-color: var(--yesil); }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 4px; list-style: none;
  background: #fff; border: 1px solid var(--kenar); border-radius: 7px;
  box-shadow: 0 8px 20px rgba(16,24,40,.12);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 10px; border-radius: 5px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .82em;
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { color: var(--gri-acik); cursor: default; font-family: inherit; }
.combo-liste li.bos:hover { background: none; color: var(--gri-acik); }

#secici-btn {
  padding: 9px 22px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 7px; font-size: .88em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--gri-acik); cursor: not-allowed; }

/* -------- Yazıyor animasyonu -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: var(--gri-acik); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* -------- Giriş -------- */
#giris-bolge {
  border-top: 1px solid var(--kenar); background: #fff;
  padding: 12px clamp(16px, 2.2vw, 34px) 16px; flex-shrink: 0;
}
#hizli-aksiyon { max-width: var(--sohbet-en); margin: 0 auto 9px; display: flex; gap: 7px; }
.chip {
  font-family: ui-monospace, Consolas, monospace; font-size: .8em;
  padding: 5px 13px; border: 1px solid var(--kenar);
  background: var(--zemin); border-radius: 14px; cursor: pointer; color: var(--gri);
}
.chip:hover:not(:disabled) { border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik); }
.chip:disabled { opacity: .45; cursor: not-allowed; }

#giris { max-width: var(--sohbet-en); margin: 0 auto; display: flex; gap: 9px; align-items: flex-end; }
#kutu {
  flex: 1; padding: 10px 13px; border: 1px solid var(--kenar);
  border-radius: 8px; font-family: inherit; font-size: 1em;
  line-height: 1.5; resize: none; outline: none; max-height: 130px; overflow-y: auto;
}
#kutu:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
#gonder {
  padding: 10px 24px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 8px; font-size: 1em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#gonder:disabled { opacity: .45; cursor: not-allowed; }

/* -------- Dar ekran -------- */
@media (max-width: 980px) {
  #panel { display: none; }
  #baslik-blok { display: none; }
  #ozet-serit { overflow-x: auto; }
  .ozet-kart { min-width: 150px; }
}












const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl  = document.getElementById("sohbet");
const kutuEl    = document.getElementById("kutu");
const gonderEl  = document.getElementById("gonder");
const listeEl   = document.getElementById("adim-listesi");
const seritEl   = document.getElementById("ozet-serit");
const bannerEl  = document.getElementById("banner");
const kartEl    = document.getElementById("secici-kart");
const seciciBtn = document.getElementById("secici-btn");
const bilgiBtn  = document.getElementById("bilgi-btn");
const bilgiKutu = document.getElementById("bilgi-kutu");
const chipler   = Array.from(document.querySelectorAll(".chip"));

let ADIMLAR = [];
let DATASETLER = [];
let aktifAdim = 0;
let acikAdim = -1;          // tiklanarak acilan adim
let mesgul = false;
const secim = { veri_seti: "", sozluk: "" };

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };


/* ==================== Sol panel: stepper ==================== */
function listeyiCiz() {
    listeEl.innerHTML = "";
    ADIMLAR.forEach((a, i) => {
        const li = document.createElement("li");
        if (i < aktifAdim)   li.classList.add("tamam");
        if (i === aktifAdim) li.classList.add("aktif");
        if (i === acikAdim)  li.classList.add("acik");

        const isaret = document.createElement("span");
        isaret.className = "adim-isaret";
        isaret.textContent = (i < aktifAdim) ? "✓" : String(i + 1).padStart(2, "0");
        li.appendChild(isaret);

        const govde = document.createElement("div");
        govde.className = "adim-govde";

        const ad = document.createElement("div");
        ad.className = "adim-ad";
        ad.textContent = a.baslik;
        govde.appendChild(ad);

        if (a.aciklama) {
            const ack = document.createElement("div");
            ack.className = "adim-aciklama";
            ack.textContent = a.aciklama;
            govde.appendChild(ack);
        }

        li.appendChild(govde);
        // Tiklayinca aciklamasi acilir/kapanir; akisa mudahale etmez.
        li.onclick = () => { acikAdim = (acikAdim === i) ? -1 : i; listeyiCiz(); };
        listeEl.appendChild(li);
    });
}

fetch(getWebAppBackendUrl("adimlar"))
    .then(r => r.json())
    .then(d => { ADIMLAR = d.adimlar || []; listeyiCiz(); })
    .catch(() => { listeEl.innerHTML = "<li>adımlar yüklenemedi</li>"; });

bilgiBtn.onclick = () => {
    bilgiKutu.classList.toggle("gizli");
    bilgiBtn.classList.toggle("acik", !bilgiKutu.classList.contains("gizli"));
};


/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;          // uzun adlar kirpiliyor, tooltip kalsin
        kart.appendChild(deger);

        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}


/* ==================== Balon kurucu ==================== */
function balonYap(rol, metin, hataMi) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Kullanıcı";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon" + (hataMi ? " hata" : "");
    balon.textContent = metin;      // textContent: metin HTML olarak yorumlanmaz
    satir.appendChild(balon);
    return satir;
}

function balonEkle(rol, metin, hataMi) {
    const satir = balonYap(rol, metin, hataMi);
    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    chipler.forEach(c => { c.disabled = durum; });
    seciciBtn.disabled = durum || !(secim.veri_seti && secim.sozluk);
}


/* ==================== Veri seçici ==================== */
function comboKur(kok) {
    const alan  = kok.dataset.alan;
    const giris = kok.querySelector(".combo-giris");
    const liste = kok.querySelector(".combo-liste");

    function ciz(filtre) {
        const f = (filtre || "").toLowerCase();
        const sonuc = DATASETLER.filter(d => d.toLowerCase().includes(f)).slice(0, 60);
        liste.innerHTML = "";
        if (!sonuc.length) {
            const li = document.createElement("li");
            li.className = "bos";
            li.textContent = DATASETLER.length
                ? "Eşleşen veri seti yok — yazdığınız ad yine de kullanılacak"
                : "Veri setleri okunamadı — adı elle yazabilirsiniz";
            liste.appendChild(li);
            return;
        }
        sonuc.forEach(ad => {
            const li = document.createElement("li");
            li.textContent = ad;
            // mousedown: input'un blur olayindan ONCE calissin diye
            li.onmousedown = e => {
                e.preventDefault();
                giris.value = ad;
                sec(ad);
                liste.classList.remove("acik");
            };
            liste.appendChild(li);
        });
    }

    function sec(deger) {
        secim[alan] = (deger || "").trim();
        giris.classList.toggle("secili", !!secim[alan]);
        seciciBtn.disabled = mesgul || !(secim.veri_seti && secim.sozluk);
    }

    giris.addEventListener("focus", () => { ciz(giris.value); liste.classList.add("acik"); });
    giris.addEventListener("input", () => { ciz(giris.value); liste.classList.add("acik"); sec(giris.value); });
    giris.addEventListener("blur",  () => { setTimeout(() => liste.classList.remove("acik"), 120); });
    giris.addEventListener("keydown", e => {
        if (e.key === "Escape") liste.classList.remove("acik");
        if (e.key === "Enter")  { e.preventDefault(); liste.classList.remove("acik"); }
    });
}

document.querySelectorAll(".combo").forEach(comboKur);

fetch(getWebAppBackendUrl("datasetler"))
    .then(r => r.json())
    .then(d => { DATASETLER = d.datasetler || []; })
    .catch(() => { DATASETLER = []; });

seciciBtn.onclick = () => {
    if (!secim.veri_seti || !secim.sozluk) return;
    gonder("veri seti " + secim.veri_seti + " ve sözlük " + secim.sozluk);
};


/* ==================== Gönderme ==================== */
function gonder(metinDisaridan) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    kartEl.classList.add("gizli");     // ilk mesajdan sonra kart kapanir
    balonEkle("kullanici", metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        const hataMi = typeof d.cevap === "string" && d.cevap.startsWith("HATA:");
        balonEkle("bot", d.cevap, hataMi);
        if (d.adim_no !== undefined) { aktifAdim = d.adim_no; acikAdim = -1; listeyiCiz(); }
        ozetGuncelle(d.ozet);
    })
    .catch(e => { yaziyor.remove(); balonEkle("bot", "Bağlantı hatası: " + e, true); })
    .finally(() => { kilitle(false); kutuEl.focus(); });
}

gonderEl.onclick = () => gonder();
chipler.forEach(c => { c.onclick = () => gonder(c.dataset.mesaj); });

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 130) + "px";
});


/* ==================== Karşılama ==================== */
// Karsilama balonu, secim kartinin USTUNDE durmali.
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => {
        sohbetEl.insertBefore(balonYap("bot", d.metin), kartEl);
        ozetGuncelle(d.ozet);
    })
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e, true));


/* ==================== Yeni oturum ==================== */
document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        acikAdim = -1;
        secim.veri_seti = "";
        secim.sozluk = "";
        document.querySelectorAll(".combo-giris").forEach(g => {
            g.value = "";
            g.classList.remove("secili");
        });
        seciciBtn.disabled = true;
        kartEl.classList.remove("gizli");
        sohbetEl.appendChild(balonYap("bot", d.metin));
        sohbetEl.appendChild(kartEl);
        listeyiCiz();
        ozetGuncelle(d.ozet);
    });
};
