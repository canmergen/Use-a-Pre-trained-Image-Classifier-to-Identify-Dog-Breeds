// Karşılama metni: sayfa açılır açılmaz görünür, kullanıcı hiçbir şey yazmadan.
const KARSILAMA = `Merhaba. Ben Akıllı Değişken Üretimi akışını yürüten ajanım.

Amacım: verdiğin veri seti ve değişken sözlüğünü kullanarak, hedef değişkeni daha iyi açıklayan yeni değişkenler üretmek. Her adımda ne yapacağımı önce listelerim, senden onay alırım — onaysız hiçbir şey üretmem.

Yapabileceklerim (sırayla):
1. Sözlük sıkıştırma — Açıklamaları kolon ailelerine indirger, kompakt bir sözlük çıkarır.
2. Meta tanımı — Target, kimlik, dönem ve train/validation bölmesini öneririm; sen teyit edersin.
3. Geleneksel (mekanik) değişkenler — Delta, momentum, oran, lag gibi kural bazlı değişkenlerin üretilecek/üretilmeyecek listesini sunarım, onaydan sonra üretirim. (Atlanabilir.)
4. LLM değişken üretimi — Hipotez kurar, test eder, kabul/red gerekçesiyle kaydederim.
5. Veri kalitesi — Eksik, sabit, tekrar eden ve sızıntı riski taşıyan değişkenleri kontrol ederim.
6. Model ve karşılaştırma — Aynı bölme, aynı model ile mevcut ve zenginleştirilmiş halin performansını karşılaştırırım.

Kural: Sadece değişken EKLEME öneririm. Reddettiğin öneriler kaydedilir, tekrar önerilmez.

────────────────────────

Başlamak için iki şeye ihtiyacım var:

1) Veri seti — Bu projedeki dataset'in adı. Örnek: HAVALE_EFT_NTT_PREPARED

2) Sözlük — Değişken açıklamalarının bulunduğu dataset ve kolonları.
   Örnek: DEGISKENLER — değişken adı: SM_ID, açıklama: aciklama

Şu formatta tek mesajda yazman yeterli:

veri_seti: <DATASET_ADI>
sozluk: <SOZLUK_DATASET_ADI>
sozluk_kolonlari: <degisken_adi_kolonu>, <aciklama_kolonu>

Sözlüğün yoksa "sözlük yok" yaz.`;

let history = [];

function render() {
    const box = document.getElementById('messages');
    box.innerHTML = '';
    history.forEach(m => {
        const div = document.createElement('div');
        div.className = 'msg ' + m.role;
        const who = document.createElement('span');
        who.className = 'who';
        who.textContent = (m.role === 'user') ? 'Sen' : 'Ajan';
        div.appendChild(who);
        div.appendChild(document.createTextNode(m.content));
        box.appendChild(div);
    });
    box.scrollTop = box.scrollHeight;
}

function reset() {
    history = [{ role: 'assistant', content: KARSILAMA }];
    render();
}

function send() {
    const input = document.getElementById('userInput');
    const text = input.value.trim();
    if (!text) return;

    history.push({ role: 'user', content: text });
    input.value = '';
    history.push({ role: 'assistant', content: '...' });  // geçici "yazıyor" balonu
    render();

    fetch(getWebAppBackendUrl('chat'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        // Geçici balonu göndermiyoruz
        body: JSON.stringify({ messages: history.slice(0, -1) })
    })
    .then(r => r.json())
    .then(data => {
        history[history.length - 1] = { role: 'assistant', content: data.text };
        render();
    })
    .catch(err => {
        history[history.length - 1] = { role: 'assistant', content: 'İstek başarısız: ' + err };
        render();
    });
}

document.getElementById('sendBtn').addEventListener('click', send);
document.getElementById('resetBtn').addEventListener('click', reset);
document.getElementById('userInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
});

reset();  // sayfa yüklenince karşılamayı bas







import traceback
import dataiku
from dataiku.customwebapp import *
from flask import request, jsonify

# Kendi agent ID'nle değiştir. Notebook'ta bulmak için:
#   for llm in dataiku.api_client().get_default_project().list_llms():
#       if "agent:" in llm.id: print(llm.description, llm.id)
AGENT_ID = "agent:cMnblvTu"


@app.route('/chat', methods=['POST'])
def chat():
    try:
        payload = request.get_json(force=True)
        messages = payload.get('messages', [])

        agent = dataiku.api_client().get_default_project().get_llm(AGENT_ID)
        completion = agent.new_completion()

        # Agent'ın çağrılar arası hafızası yok; tüm geçmişi her seferinde gönderiyoruz
        for m in messages:
            completion.with_message(m['content'], role=m['role'])

        resp = completion.execute()

        if getattr(resp, 'success', False):
            return jsonify({"ok": True, "text": resp.text})
        return jsonify({"ok": False, "text": "Agent yanıt vermedi: " + str(resp)})

    except Exception as e:
        return jsonify({"ok": False,
                        "text": "Hata: %s\n\n%s" % (e, traceback.format_exc())})
