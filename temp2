<div id="kabuk">

  <header id="ustbar">
    <div id="ustbar-sol">
      <img id="banner" alt="Akbank">
      <div id="baslik-blok">
        <div id="urun-adi">Değişken Keşif Asistanı</div>
        <div id="urun-alt">Bireysel Krediler Analitik ve Tahsis Bİ</div>
      </div>
    </div>
    <div id="ustbar-sag">
      <span id="durum-rozet"><i class="nokta-yesil"></i> Oturum aktif</span>
      <button id="sifirla-btn" type="button">Yeni oturum</button>
    </div>
  </header>

  <div id="govde">

    <aside id="panel">

      <section class="panel-blok">
        <div class="panel-baslik">BU ARAÇ NE YAPAR</div>
        <p class="panel-metin">
          Ham tablolardaki yüzlerce kolon tek başına yeterli değil; modele asıl
          katkı bunlardan türetilen oran, fark ve eğilim değişkenlerinden gelir.
          Bu türetme bugün elle yapılıyor — yavaş ve tekrarlanamayan bir süreç.
        </p>
        <p class="panel-metin">
          Bu araç süreci standartlaştırır. Yapay zekâ <b>kolon açıklamalarını
          yorumlar ve hangi dönüşümün anlamlı olduğunu önerir</b>; üretimi,
          kalite kontrolünü ve ölçümü Python yapar. Model kod yazmaz, veriye
          dokunmaz.
        </p>
      </section>

      <section class="panel-blok">
        <div class="panel-baslik">
          İŞ AKIŞI
          <span class="panel-ipucu">adıma tıklayın</span>
        </div>
        <ol id="adim-listesi"></ol>
      </section>

      <section class="panel-blok">
        <div class="panel-baslik">KOMUTLAR</div>
        <div class="panel-not">
          <b>onay</b><span>adımı uygula</span>
          <b>red</b><span>uygulama, değiştir</span>
          <b>geri</b><span>önceki adıma dön</span>
        </div>
      </section>

    </aside>

    <main id="sohbet-alani">

      <div id="ozet-serit"></div>

      <div id="sohbet">
        <div id="secici-kart">
          <div class="kart-baslik">Çalışma kurulumu</div>
          <div class="kart-alt">
            Analiz edilecek veri setini ve değişken sözlüğünü seçin. Listede
            projedeki tüm veri setleri yer alır; adını yazarak da arayabilirsiniz.
          </div>

          <div class="kart-govde">
            <div class="combo" data-alan="veri_seti">
              <label>Veri seti</label>
              <input class="combo-giris" placeholder="Ara veya yaz…" autocomplete="off">
              <ul class="combo-liste"></ul>
            </div>

            <div class="combo" data-alan="sozluk">
              <label>Değişken sözlüğü</label>
              <input class="combo-giris" placeholder="Ara veya yaz…" autocomplete="off">
              <ul class="combo-liste"></ul>
            </div>

            <button id="secici-btn" type="button" disabled>Analizi başlat</button>
          </div>
        </div>
      </div>

      <div id="giris-bolge">
        <div id="hizli-aksiyon">
          <button class="chip" data-mesaj="onay">onay</button>
          <button class="chip" data-mesaj="red">red</button>
          <button class="chip" data-mesaj="geri">geri</button>
        </div>
        <div id="giris">
          <textarea id="kutu" rows="1" placeholder="Mesajınızı yazın…"></textarea>
          <button id="gonder" type="button">Gönder</button>
        </div>
      </div>

    </main>
  </div>
</div>











:root {
  --kirmizi:      #E4002B;
  --kirmizi-koyu: #B00020;
  --kirmizi-acik: #FEF0F2;
  --zemin:        #F7F8FA;
  --kenar:        #E4E7EC;
  --kenar-acik:   #F0F1F4;
  --metin:        #101828;
  --gri:          #667085;
  --gri-acik:     #98A2B3;
  --yesil:        #12B76A;

  --panel-en:  clamp(228px, 17vw, 278px);
  --sohbet-en: clamp(640px, 62vw, 880px);
  --govde-en:  1560px;
  --yazi:      clamp(13px, .92vw, 14.5px);
  --avatar:    34px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(16px, 2vw, 32px); height: 60px;
  background: #fff; border-bottom: 1px solid var(--kenar); flex-shrink: 0;
}
#ustbar-sol { display: flex; align-items: center; gap: 14px; }
#banner { height: 26px; width: auto; display: block; }
#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 14px; line-height: 1.3; }
#urun-adi { font-weight: 600; }
#urun-alt { font-size: .78em; color: var(--gri-acik); }

#ustbar-sag { display: flex; align-items: center; gap: 12px; }
#durum-rozet { display: inline-flex; align-items: center; gap: 6px; font-size: .82em; color: var(--gri); }
.nokta-yesil { width: 7px; height: 7px; border-radius: 50%; background: var(--yesil); display: inline-block; }

#sifirla-btn {
  font-size: .82em; font-weight: 500; padding: 6px 14px;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 6px; cursor: pointer; color: var(--gri);
}
#sifirla-btn:hover { border-color: var(--kirmizi); color: var(--kirmizi); }

/* ==================== GÖVDE ==================== */
#govde {
  flex: 1; display: flex; min-height: 0;
  width: 100%; max-width: var(--govde-en); margin: 0 auto;
  background: #fff;
  border-left: 1px solid var(--kenar); border-right: 1px solid var(--kenar);
}

/* -------- Sol panel -------- */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: #FCFCFD; border-right: 1px solid var(--kenar);
  padding: 20px 15px 32px; overflow-y: auto;
}
.panel-blok { margin-bottom: 26px; }
.panel-blok:last-child { margin-bottom: 0; }

.panel-baslik {
  display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
  font-size: .72em; font-weight: 700; letter-spacing: .09em;
  color: var(--gri-acik); margin-bottom: 10px;
}
.panel-ipucu {
  font-size: .88em; font-weight: 400; letter-spacing: 0;
  text-transform: none; color: var(--gri-acik); opacity: .75;
}

.panel-metin {
  margin: 0 0 9px; font-size: .81em; line-height: 1.62; color: var(--gri);
}
.panel-metin:last-child { margin-bottom: 0; }
.panel-metin b { color: var(--metin); font-weight: 600; }

/* -------- Stepper -------- */
#adim-listesi { list-style: none; margin: 0; padding: 0; }
#adim-listesi li {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 9px; border-radius: 6px; margin-bottom: 1px;
  color: var(--gri-acik); cursor: pointer;
}
#adim-listesi li:hover { background: var(--kenar-acik); }
#adim-listesi li.aktif:hover { background: var(--kirmizi-acik); }

.adim-isaret {
  flex-shrink: 0; width: 17px; height: 17px; margin-top: 1px;
  border: 1.5px solid currentColor; border-radius: 50%;
  font-size: .62em; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-variant-numeric: tabular-nums;
}
#adim-listesi li.tamam { color: var(--gri); }
#adim-listesi li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff; font-size: .7em;
}
#adim-listesi li.aktif { background: var(--kirmizi-acik); color: var(--kirmizi); }
#adim-listesi li.aktif .adim-isaret {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.adim-govde { min-width: 0; flex: 1; }
.adim-ad { font-size: .87em; font-weight: 500; line-height: 1.35; }
#adim-listesi li.aktif .adim-ad { font-weight: 600; }

/* Aciklama SADECE tiklanan adimda gorunur. Aktif adim dahil otomatik acilmaz. */
.adim-aciklama {
  display: none;
  font-size: .77em; line-height: 1.5; margin-top: 5px; opacity: .88;
}
#adim-listesi li.acik .adim-aciklama { display: block; }

/* -------- Komutlar -------- */
.panel-not {
  display: grid; grid-template-columns: auto 1fr;
  gap: 7px 10px; align-items: center; font-size: .81em; color: var(--gri);
}
.panel-not b {
  font-family: ui-monospace, Consolas, monospace;
  font-size: .88em; color: var(--metin);
  background: var(--zemin); border: 1px solid var(--kenar);
  padding: 2px 7px; border-radius: 4px; text-align: center;
}

/* -------- Sohbet alanı -------- */
#sohbet-alani { flex: 1; display: flex; flex-direction: column; min-width: 0; }

#ozet-serit {
  display: flex; border-bottom: 1px solid var(--kenar);
  background: #FCFCFD; flex-shrink: 0;
}
.ozet-kart {
  flex: 1; padding: 11px clamp(12px, 1.5vw, 24px);
  border-right: 1px solid var(--kenar-acik); min-width: 0;
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: .69em; letter-spacing: .07em;
  color: var(--gri-acik); text-transform: uppercase; margin-bottom: 4px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: .85em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--gri-acik); font-weight: 400; }
.ozet-alt {
  display: block; font-size: .73em; color: var(--gri); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#sohbet { flex: 1; overflow-y: auto; padding: 22px clamp(16px, 2.2vw, 34px) 10px; }

.satir {
  display: flex; align-items: flex-start; gap: 11px;
  margin: 0 auto 18px; max-width: var(--sohbet-en);
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid var(--kenar);
}

.balon {
  padding: 12px 15px; border-radius: 10px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 80%;
}
/* Bot ciktilari bosluklarla hizali -> monospace sart */
.satir.bot .balon {
  background: #fff; border: 1px solid var(--kenar);
  border-top-left-radius: 2px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .88em;
}
.satir.kullanici .balon {
  background: var(--kirmizi); color: #fff;
  border-top-right-radius: 2px; font-size: .95em;
}
.satir.bot .balon.hata {
  background: #FFFBFA; border-color: #FDA29B; color: #B42318;
}

/* -------- Veri seçim kartı -------- */
#secici-kart {
  max-width: var(--sohbet-en); margin: 0 auto 20px;
  background: #fff; border: 1px solid var(--kenar);
  border-radius: 10px; padding: 18px 20px 20px;
  box-shadow: 0 1px 3px rgba(16,24,40,.05);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 600; font-size: .98em; margin-bottom: 4px; }
.kart-alt { font-size: .82em; color: var(--gri); line-height: 1.55; margin-bottom: 16px; }

.kart-govde { display: flex; gap: 12px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 185px; }
.combo label {
  display: block; font-size: .76em; color: var(--gri);
  margin-bottom: 5px; font-weight: 500;
}
.combo-giris {
  width: 100%; padding: 9px 11px;
  border: 1px solid var(--kenar); border-radius: 7px;
  font-family: ui-monospace, Consolas, monospace;
  font-size: .85em; outline: none; background: #fff;
}
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
.combo-giris.secili { border-color: var(--yesil); }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 4px; list-style: none;
  background: #fff; border: 1px solid var(--kenar); border-radius: 7px;
  box-shadow: 0 8px 20px rgba(16,24,40,.12);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 10px; border-radius: 5px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .82em;
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { color: var(--gri-acik); cursor: default; font-family: inherit; }
.combo-liste li.bos:hover { background: none; color: var(--gri-acik); }

#secici-btn {
  padding: 9px 22px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 7px; font-size: .88em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--gri-acik); cursor: not-allowed; }

/* -------- Yazıyor animasyonu -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: var(--gri-acik); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* -------- Giriş -------- */
#giris-bolge {
  border-top: 1px solid var(--kenar); background: #fff;
  padding: 12px clamp(16px, 2.2vw, 34px) 16px; flex-shrink: 0;
}
#hizli-aksiyon { max-width: var(--sohbet-en); margin: 0 auto 9px; display: flex; gap: 7px; }
.chip {
  font-family: ui-monospace, Consolas, monospace; font-size: .8em;
  padding: 5px 13px; border: 1px solid var(--kenar);
  background: var(--zemin); border-radius: 14px; cursor: pointer; color: var(--gri);
}
.chip:hover:not(:disabled) { border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik); }
.chip:disabled { opacity: .45; cursor: not-allowed; }

#giris { max-width: var(--sohbet-en); margin: 0 auto; display: flex; gap: 9px; align-items: flex-end; }
#kutu {
  flex: 1; padding: 10px 13px; border: 1px solid var(--kenar);
  border-radius: 8px; font-family: inherit; font-size: 1em;
  line-height: 1.5; resize: none; outline: none; max-height: 130px; overflow-y: auto;
}
#kutu:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
#gonder {
  padding: 10px 24px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 8px; font-size: 1em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#gonder:disabled { opacity: .45; cursor: not-allowed; }

/* -------- Dar ekran -------- */
@media (max-width: 980px) {
  #panel { display: none; }
  #baslik-blok { display: none; }
  #ozet-serit { overflow-x: auto; }
  .ozet-kart { min-width: 150px; }
}
