<div id="kabuk">

  <header id="ustbar">
    <div id="ustbar-sol">
      <img id="banner" alt="Akbank">
      <div id="baslik-blok">
        <div id="urun-adi">Analitik Modelleme Platformu</div>
        <div id="urun-alt">Bireysel Krediler Analitik ve Tahsis Bİ</div>
      </div>
    </div>

    <div id="ozet-serit"></div>

    <div id="ustbar-sag">
      <div class="ustbar-sag-satir">
        <button id="sifirla-btn" type="button" title="Oturumu yenile"
                aria-label="Oturumu yenile">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none"
               stroke="currentColor" stroke-width="2.3"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.5 9A8.5 8.5 0 0 0 6.2 6.2L2.5 9.5"></path>
            <polyline points="2.5 4.5 2.5 9.5 7.5 9.5"></polyline>
            <path d="M3.5 15A8.5 8.5 0 0 0 17.8 17.8l3.7-3.3"></path>
            <polyline points="21.5 19.5 21.5 14.5 16.5 14.5"></polyline>
          </svg>
        </button>
        <span id="durum-rozet"><i class="nokta-yesil"></i> Oturum aktif</span>
      </div>

      <div id="sekmeler">
        <button class="sekme aktif" data-sayfa="calisma" type="button">Çalışma</button>
        <button class="sekme" data-sayfa="ozet" type="button">Özet</button>
      </div>
    </div>
  </header>

  <!-- ===================== SAYFA 1: ÇALIŞMA ===================== -->
  <div id="sayfa-calisma" class="sayfa">

    <aside id="panel">
      <section class="panel-blok">
        <div class="panel-baslik">ANALİTİK SÜREÇ</div>
        <p class="panel-metin">
          Modelleme veri setinden final modele kadar olan hazırlık hattı burada
          yürütülür. Amaç, elle günler süren değişken üretim ve doğrulama işini
          tek oturumda, tekrarlanabilir ve denetlenebilir biçimde tamamlamak.
        </p>
        <p class="panel-metin">
          Her adımda yapay zekâ bir öneri sunar, hesaplamayı Python yapar,
          kararı siz verirsiniz. Üretilen her değişkenin kaynağı, formülü ve
          elenme gerekçesi kayıt altındadır.
        </p>
      </section>

      <section class="panel-blok">
        <div class="panel-baslik">İŞ AKIŞI</div>
        <div id="faz-listesi"></div>
      </section>
    </aside>

    <main id="sohbet-alani">
      <div id="sohbet">

        <div id="giris-kart">
          <div class="giris-baslik">Analitik Modelleme Platformu</div>
          <div class="giris-alt">
            Veri setinizi ve değişken sözlüğünüzü modellemeye hazır,
            doğrulanmış bir değişken setine dönüştürür.
          </div>
          <div class="giris-adimlar">
            <div class="giris-adim">
              <span class="giris-no">1</span>
              <div>
                <div class="giris-ad">Veriyi analiz et</div>
                <div class="giris-ack">Kalite, eksik değer ve hedef ilişkisi</div>
              </div>
            </div>
            <div class="giris-adim">
              <span class="giris-no">2</span>
              <div>
                <div class="giris-ad">Değişkenleri üret ve değerlendir</div>
                <div class="giris-ack">Kural tabanlı ve yapay zekâ destekli</div>
              </div>
            </div>
            <div class="giris-adim">
              <span class="giris-no">3</span>
              <div>
                <div class="giris-ad">Katkıyı ölç ve finalize et</div>
                <div class="giris-ack">Model karşılaştırması ve katalog</div>
              </div>
            </div>
          </div>
        </div>

        <div id="secici-kart">
          <div class="kart-baslik">1.1 Veri ve Sözlük</div>
          <div class="kart-alt">
            Analiz edilecek veri setini ve değişken sözlüğünü seçin. Listede
            projedeki tüm veri setleri yer alır; adını yazarak da arayabilirsiniz.
          </div>

          <div class="kart-govde">
            <div class="combo" data-alan="veri_seti">
              <label>Veri seti</label>
              <input class="combo-giris" placeholder="Ara veya yaz…" autocomplete="off">
              <ul class="combo-liste"></ul>
            </div>

            <div class="combo" data-alan="sozluk">
              <label>Değişken sözlüğü</label>
              <input class="combo-giris" placeholder="Ara veya yaz…" autocomplete="off">
              <ul class="combo-liste"></ul>
            </div>

            <button id="secici-btn" type="button" disabled>Analizi başlat</button>
          </div>
        </div>

      </div>

      <div id="giris-bolge">
        <div id="aksiyonlar">
          <button class="aksiyon birincil" data-mesaj="onay" type="button">
            Onayla ve Uygula
          </button>
          <button class="aksiyon" data-mesaj="red" type="button">Değiştir</button>
          <button class="aksiyon" data-mesaj="geri" type="button">Geri Dön</button>
        </div>
        <div id="giris">
          <textarea id="kutu" rows="1"
                    placeholder="Yapay zekâya sorun ya da komut yazın…"></textarea>
          <button id="gonder" type="button">Gönder</button>
        </div>
      </div>
    </main>

    <!-- Analiz paneli — TASLAK, backend henuz bagli degil -->
    <aside id="analiz-panel">
      <div id="analiz-ust">
        <div>
          <div id="analiz-baslik">Analiz Merkezi</div>
          <div id="analiz-alt">taslak · veri bağlanmadı</div>
        </div>
        <button id="analiz-kapat" type="button" title="Paneli gizle">›</button>
      </div>

      <div id="analiz-sekmeler">
        <button class="analiz-sekme aktif" data-tab="ozet" type="button">Özet</button>
        <button class="analiz-sekme" data-tab="eksik" type="button">Eksik Değer</button>
        <button class="analiz-sekme" data-tab="dagilim" type="button">Dağılım</button>
        <button class="analiz-sekme" data-tab="iliski" type="button">İlişkiler</button>
        <button class="analiz-sekme" data-tab="sfa" type="button">SFA</button>
      </div>

      <div id="analiz-govde"></div>
    </aside>

  </div>

  <!-- ===================== SAYFA 2: ÖZET ===================== -->
  <div id="sayfa-ozet" class="sayfa gizli">
    <div id="ozet-govde">
      <div id="ozet-baslik-blok">
        <h1 id="ozet-h1">Çalışma özeti</h1>
        <div id="ozet-adim"></div>
      </div>
      <div id="ozet-kartlar"></div>
    </div>
  </div>

</div>
