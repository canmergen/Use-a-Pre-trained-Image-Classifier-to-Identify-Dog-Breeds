@app.route("/karsilama")
def karsilama_endpoint():
    """Karsilama + ilk adimin sorusu birlikte doner; kullanici ne
    yapacagini bilmeden ekranda beklemesin."""
    durum = akis.yeni_durum()
    ilk_soru = akis.ilk_soru(durum)
    return jsonify({
        "metin": akis.KARSILAMA + "\n\n" + ilk_soru,
        "mod": None,
        "fazlar": akis.faz_agaci(None),
        "ozet": akis.ozet(durum),
        "detay": akis.detay(durum),
    })







@app.route("/sifirla", methods=["POST"])
def sifirla_endpoint():
    govde = request.get_json(force=True) or {}
    oturum_id = govde.get("oturum_id") or "varsayilan"
    durum = akis.yeni_durum()
    akis.durum_kaydet(oturum_id, durum)
    return jsonify({
        "metin": akis.KARSILAMA + "\n\n" + akis.ilk_soru(durum),
        "mod": None,
        "fazlar": akis.faz_agaci(None),
        "ozet": akis.ozet(durum),
        "detay": akis.detay(durum),
    })

















