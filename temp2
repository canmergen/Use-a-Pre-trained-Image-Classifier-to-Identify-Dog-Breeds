def _kurulum_formu(durum, veri=None, sozluk=None):
    """A secenegi formu. Onceki secim varsa alanlar dolu gelir."""
    durum["_secim_alani"] = {
        "tip": "form",
        "baslik": "Veri seti ve değişken sözlüğü",
        "aciklama": "Analiz edilecek veri setini ve değişken sözlüğünü seçin.",
        "buton": "Analizi başlat",
        "alanlar": [
            {"ad": "veri_seti", "etiket": "Veri seti",
             "deger": veri or durum.get("veri_seti") or ""},
            {"ad": "sozluk", "etiket": "Değişken sözlüğü",
             "deger": sozluk or durum.get("sozluk") or ""},
        ],
        "sablon": "veri seti {veri_seti} ve sözlük {sozluk}",
    }


def kurulum_girdi(durum, mesaj):
    a = niyet_kural.alanlari_cikar(mesaj) if mesaj else {}
    # Kayitli deger YALNIZCA mesaj en az bir alan iceriyorsa eksigi tamamlar.
    # Bos mesaj ya da "hayır" gibi alan icermeyen mesaj her zaman formu acar.
    veri = a.get("veri_seti") or (durum.get("veri_seti") if a else None)
    sozluk = a.get("sozluk") or (durum.get("sozluk") if a else None)

    if not veri or not sozluk:
        _kurulum_formu(durum, veri, sozluk)
        return False, "Hangi veri seti ve değişken sözlüğüyle çalışalım?"

    for ad in (veri, sozluk):
        if not _dataset_var_mi(ad):
            _kurulum_formu(durum, veri, sozluk)
            return False, ("'%s' adında bir tabloya erişemiyorum. "
                           "Adı kontrol edip yeniden seçin." % ad)

    durum["veri_seti"], durum["sozluk"] = veri, sozluk
    durum["_secim_alani"] = None
    return True, None



def _veri_sec_formu(durum, veri=None):
    """B secenegi formu. Onceki secim varsa alan dolu gelir."""
    durum["_secim_alani"] = {
        "tip": "form",
        "baslik": "Veri seti",
        "aciklama": "Değişken sözlüğü oluşturulacak veri setini seçin.",
        "buton": "Devam et",
        "alanlar": [{"ad": "veri_seti", "etiket": "Veri seti",
                     "deger": veri or durum.get("veri_seti") or ""}],
        "sablon": "veri seti {veri_seti}",
    }


def veri_sec_girdi(durum, mesaj):
    a = niyet_kural.alanlari_cikar(mesaj) if mesaj else {}
    veri = a.get("veri_seti")

    if not veri:
        _veri_sec_formu(durum)
        return False, "Hangi veri setiyle çalışalım?"

    if not _dataset_var_mi(veri):
        _veri_sec_formu(durum, veri)
        return False, ("'%s' adında bir tabloya erişemiyorum. "
                       "Adı kontrol edip yeniden seçin." % veri)

    durum["veri_seti"] = veri
    durum["_secim_alani"] = None
    return True, None



def _adima_gir(durum):
    """Yeni adima girilirken: girdi gerekiyorsa formu/secenekleri ac,
    gerekmiyorsa ya da bilgi zaten tamamsa plani goster."""
    sira = adim_sirasi(durum.get("mod"))
    adim = ADIMLAR[sira[durum["i"]]]

    if adim.get("girdi") is not None:
        tamam, soru = adim["girdi"](durum, "")
        if not tamam:
            durum["bekleyen"] = "girdi"
            return soru or "Devam etmek için seçim yapmanız gerekiyor."
        # Girdi fonksiyonu gerekli bilgiyi durumda buldu: dogrudan plana gec

    durum["bekleyen"] = "onay"
    return adim["plan"](durum)



def mesaj_isle(durum, mesaj):
    """Webapp'in cagirdigi TEK fonksiyon. Cevap metnini doner."""
    mesaj = (mesaj or "").strip()
    norm = niyet_kural.normalize(mesaj)
    durum["_secenekler"] = []          # her tur basinda temizle
    durum["_secim_alani"] = None
    sira = adim_sirasi(durum.get("mod"))
    anahtar = sira[durum["i"]]
    adim = ADIMLAR[anahtar]

    # 1) Acik soru: geri/onay/girdi kontrollerinden ONCE LLM'e.
    if _soru_mu(mesaj, norm):
        return _soru_isle(durum, mesaj, anahtar, adim)

    # 2) Geri donus: her an gecerli
    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adımdayız.\n\n" + _adima_gir(durum)
        durum["i"] -= 1
        sira = adim_sirasi(durum.get("mod"))
        return ("\"%s\" adımına dönüyorum.\n\n"
                % ADIMLAR[sira[durum["i"]]]["baslik"]) + _adima_gir(durum)

    sonuc = niyet_kural.coz(mesaj)

    # 3) Girdi bekleniyor
    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            # Adimin bos-mesaj istemi (kopya uzerinde: durumu degistirmesin)
            _, bos_istem = adim["girdi"](copy.deepcopy(durum), "")

            if uyari == bos_istem:
                # Mesaj bu adima ait bilgi icermiyor. Ekrandaki form/kartlar
                # hala aktif; kopyasini basma.
                durum["_secenekler"] = []
                durum["_secim_alani"] = None
                if sonuc["aksiyon"] in ("onay", "ret"):
                    return ("Bu adımda henüz seçim yapılmadı. Seçiminizi "
                            "yukarıdaki alandan yapabilirsiniz.")
                if mesaj:
                    return _soru_isle(durum, mesaj, anahtar, adim)
            # Gercek hata (erisilemeyen tablo vb.): uyari + yeniden form
            return uyari

        # Otomatik adimlar (baslangic secimi): secim zaten karardir
        if adim.get("otomatik"):
            cikti = adim["uygula"](durum)
            sira = adim_sirasi(durum.get("mod"))   # secim degisti, sirayi tazele
            if durum["i"] >= len(sira) - 1:
                return cikti
            durum["i"] += 1
            return cikti + "\n\n" + _adima_gir(durum)

        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    # 4) Onay bekleniyor
    if sonuc["aksiyon"] == "onay":
        if anahtar in SECIMLI:
            cikti = adim["uygula"](durum, _secim_ayikla(mesaj, _adet(durum, anahtar)))
        else:
            cikti = adim["uygula"](durum)
        sira = adim_sirasi(durum.get("mod"))
        if durum["i"] >= len(sira) - 1:
            return cikti + "\n\nÇalışma tamamlandı."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        # Girdili adimda "Değiştir": ayni adimin formunu dolu haliyle yeniden ac
        if adim.get("girdi") is not None:
            tamam, istem = adim["girdi"](durum, "")
            if not tamam:
                durum["bekleyen"] = "girdi"
                return "Seçimi güncelleyebilirsiniz.\n\n" + (istem or "")
        return ("Uygulamadım. Neyi değiştirmek istediğinizi yazabilir ya da "
                "önceki adıma dönebilirsiniz.")

    # 5) Tanimadigimiz her mesaj serbest sorudur
    return _soru_isle(durum, mesaj, anahtar, adim)
