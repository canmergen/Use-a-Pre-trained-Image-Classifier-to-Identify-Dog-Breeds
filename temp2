def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _yol(oturum_id):
    return "/oturum_%s.json" % re.sub(r"[^A-Za-z0-9_-]", "", str(oturum_id))


def yeni_durum():
    return {
        "i": 0, "bekleyen": "girdi",
        "veri_seti": None, "sozluk": None,
        "meta": {},              # target, id, donem
        "bolme": {},             # tur, oot_deger, test_oran, seed
        "haric_kolonlar": [],
        "profil": {}, "sfa": {}, "stabilite": {},
        "baz": {},
        "plan": [], "hipotez": [],
        "uretilen": [], "kod_bloklari": [],
        "kalite": {}, "secim": {}, "secim_tablo": [],
        "model": {}, "katalog": {},
    }


def durum_yukle(oturum_id):
    try:
        with _folder().get_download_stream(_yol(oturum_id)) as s:
            return json.loads(s.read().decode("utf-8"))
    except Exception:
        return yeni_durum()


def durum_kaydet(oturum_id, durum):
    veri = json.dumps(durum, ensure_ascii=False, indent=2,
                      default=str).encode("utf-8")
    _folder().upload_stream(_yol(oturum_id), veri)


