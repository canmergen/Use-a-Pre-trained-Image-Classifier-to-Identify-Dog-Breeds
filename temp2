def test(model=None):
    """Notebook'ta calistir: model baglantisi ve JSON ayristirma calisiyor mu."""
    ham = _cagir(
        "Sadece JSON dondur, aciklama yazma.",
        'Su formatta ornek dondur: [{"ad":"test","donusum":"delta"}]',
        model=model,
    )
    print("--- HAM CIKTI ---")
    print(repr(ham))
    print("--- AYRISTIRILMIS ---")
    print(_json_ayristir(ham, "AYRISTIRILAMADI"))
