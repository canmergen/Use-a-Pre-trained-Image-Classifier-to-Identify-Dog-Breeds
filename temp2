TANIM_KALIP = {
    "target": r"target\s*[:=]?\s*([a-z0-9_]+)",
    "id": r"\bid\s*[:=]?\s*([a-z0-9_]+)",
    "donem": r"donem\s*[:=]?\s*([a-z0-9_]+)",
}


def tanimlar_girdi(durum, mesaj):
    norm = niyet_kural.normalize(mesaj)
    meta = dict(durum.get("meta") or {})
    for anahtar, kalip in TANIM_KALIP.items():
        m = re.search(kalip, norm)
        if m:
            meta[anahtar] = mesaj[m.start(1):m.end(1)]

    if durum.get("veri_seti") and meta:
        try:
            kolonlar = set(_df_oku(durum["veri_seti"], limit=5).columns)
            hatali = [(k, v) for k, v in meta.items() if v not in kolonlar]
            if hatali:
                for k, _ in hatali:
                    meta.pop(k, None)
                durum["meta"] = meta
                return False, ("Şu kolonları tabloda bulamadım: %s"
                               % ", ".join("%s → %s" % x for x in hatali))
        except Exception:
            pass

    durum["meta"] = meta
    eksik = [k for k in ("target", "id") if k not in meta]
    if eksik:
        etiket = {"target": "hedef değişken", "id": "kimlik kolonu"}
        return False, ("Şunlara ihtiyacım var: %s\n\nÖrnek:\n"
                       "    target TGT_CS_ALL_TKP_ST_5M90 id SM_ID donem PERIOD\n\n"
                       "Dönem kolonu zorunlu değil, ama verirseniz zamansal bölme "
                       "ve stabilite analizi yapabilirim."
                       % ", ".join(etiket[k] for k in eksik))
    return True, None


def tanimlar_plan(durum):
    m = durum["meta"]
    df = _df_oku(durum["veri_seti"])
    p = durum.get("profil") or {}

    y = pd.to_numeric(df[m["target"]], errors="coerce")
    tekil = int(y.nunique(dropna=True))
    if tekil <= 2:
        p["hedef_tip"] = "binary"
        p["hedef_ozet"] = "Binary · %%%s pozitif" % _ond(100.0 * float((y > 0).mean()), 2)
    else:
        p["hedef_tip"] = "surekli"
        p["hedef_ozet"] = "Sürekli · %s farklı değer" % _sayi(tekil)
    durum["profil"] = p

    donem = m.get("donem")
    donem_not = "belirtilmedi"
    if donem and donem in df.columns:
        donemler = sorted(pd.Series(df[donem].dropna().unique()).astype(str))
        durum["_donemler"] = donemler
        donem_not = "%s  (%s farklı dönem)" % (donem, _sayi(len(donemler)))
    else:
        durum["_donemler"] = []

    return ("Modelleme tanımları:\n\n"
            "  Hedef değişken : %s  (%s)\n"
            "  Kimlik kolonu  : %s\n"
            "  Dönem kolonu   : %s\n\n"
            "Bu üçü sonraki tüm adımların referansı olacak. Doğru mu?"
            % (m["target"], p["hedef_ozet"], m["id"], donem_not))


def tanimlar_uygula(durum):
    return "Modelleme tanımları kaydedildi."


