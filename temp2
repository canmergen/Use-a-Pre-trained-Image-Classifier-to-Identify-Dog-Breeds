def hazirlik_plan(durum):
    a = durum.get("analiz") or {}
    dusurulecek = (a.get("cok_bos", []) + a.get("sabit", []) +
                   a.get("kimlik_gibi", []) + a.get("sizinti", []))
    return ("Analiz sonuçlarına göre şu hazırlığı öneriyorum:\n\n"
            "  DÜŞÜR (%s kolon)\n"
            "    • eksik oranı yüksek : %s\n"
            "    • sabit / tek değerli: %s\n"
            "    • kimlik benzeri     : %s\n"
            "    • sızıntı şüpheli    : %s\n\n"
            "  DOLDUR\n"
            "    • kalan sayısal kolonlardaki boşluklar medyan ile doldurulur\n"
            "    • doldurma yalnızca üretim sırasında, çalışma kopyasında "
            "uygulanır; kaynak tablonuz değişmez\n\n"
            "Medyan tercih ediyorum çünkü ortalamanın aksine uç değerlerden "
            "etkilenmiyor. Uygulayayım mı?"
            % (_sayi(len(dusurulecek)),
               _sayi(len(a.get("cok_bos", []))),
               _sayi(len(a.get("sabit", []))),
               _sayi(len(a.get("kimlik_gibi", []))),
               _sayi(len(a.get("sizinti", [])))))


def hazirlik_uygula(durum):
    a = durum.get("analiz") or {}
    dusurulecek = sorted(set(a.get("cok_bos", []) + a.get("sabit", []) +
                             a.get("kimlik_gibi", []) + a.get("sizinti", [])))
    durum["hazirlik"] = {"dusurulen": dusurulecek, "doldurma": "medyan"}

    # Duserilen kolonlar bundan sonraki tum adimlarda kapsam disi
    haric = set(durum.get("haric_kolonlar") or [])
    haric.update(dusurulecek)
    durum["haric_kolonlar"] = sorted(haric)

    return ("%s kolon süreç dışı bırakıldı, kalan sayısal kolonlar için "
            "medyan doldurma kuralı kaydedildi.\n"
            "Toplam kapsam dışı kolon: %s"
            % (_sayi(len(dusurulecek)), _sayi(len(durum["haric_kolonlar"]))))


