# -*- coding: utf-8 -*-
"""fe_agent/akis.py — deterministik adim makinesi.

Icinde LLM cagrisi YOK. LLM gereken iki adim fe_agent.llm'e delege edilir.

Her adimin 3 parcasi var:
  girdi()  -> kullanicidan bilgi ister (her adimda yok)
  plan()   -> "sunu yapacagim" der, HICBIR SEY DEGISTIRMEZ
  uygula() -> kullanici "onay" deyince gercek isi yapar
"""

import json
import re
import datetime

import dataiku
import numpy as np
import pandas as pd

from fe_agent import niyet_kural
from fe_agent import llm as llm_mod

HAFIZA_FOLDER = "PROJE_HAFIZASI"
MODEL_SENARYO = "MODEL_COMPARISON"      # projendeki gercek senaryo adiyla degistir

ADIM_SIRASI = [
    "kurulum", "sozluk", "meta", "gelenekse",
    "uretim", "kalite", "model", "kesif",
]

GERI_KALIP = re.compile(r"\b(geri|onceki adim|bir onceki|geri don\w*)\b")

KARSILAMA = """Merhaba. Bu asistan bir veri setinden yeni degisken uretmek icin
8 adimi sirayla isler. Her adimda ne yapacagimi once yazarim; sen onaylamadan
hicbir sey uretilmez.

  0. Kurulum        1. Sozluk kontrolu   2. Meta tanimi   3. Geleneksel plan
  4. Uretim         5. Veri kalitesi     6. Model         7. Yeni fikirler

Komutlar: "onay" / "hayir" / "geri"

Baslamak icin: veri seti HAVALE_EFT_NTT ve sozluk DEGISKENLER"""


# ===========================================================================
# DURUM — folder'da JSON. Backend restart olunca sohbet kaybolmasin diye.
# ===========================================================================
def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _yol(oturum_id):
    return "/oturum_%s.json" % re.sub(r"[^A-Za-z0-9_-]", "", str(oturum_id))


def yeni_durum():
    return {
        "i": 0,                  # ADIM_SIRASI icindeki konum
        "bekleyen": "girdi",     # "girdi" | "onay"
        "veri_seti": None,
        "sozluk": None,
        "haric_kolonlar": [],
        "meta": {},
        "plan": [],
        "uretilen": [],
        "kalite": {},
        "model": {},
    }


def durum_yukle(oturum_id):
    try:
        with _folder().get_download_stream(_yol(oturum_id)) as s:
            return json.loads(s.read().decode("utf-8"))
    except Exception:
        return yeni_durum()


def durum_kaydet(oturum_id, durum):
    veri = json.dumps(durum, ensure_ascii=False, indent=2).encode("utf-8")
    _folder().upload_stream(_yol(oturum_id), veri)


# ===========================================================================
# YARDIMCILAR
# ===========================================================================
def _df_oku(dataset_adi, limit=10000):
    return dataiku.Dataset(dataset_adi).get_dataframe(limit=limit)


def _dataset_var_mi(ad):
    try:
        dataiku.Dataset(ad).get_config()
        return True
    except Exception:
        return False


def _liste(baslik, satirlar, en_fazla=20):
    if not satirlar:
        return baslik + "\n  (yok)"
    govde = "\n".join("  - %s" % s for s in satirlar[:en_fazla])
    if len(satirlar) > en_fazla:
        govde += "\n  ... (+%d tane daha)" % (len(satirlar) - en_fazla)
    return baslik + "\n" + govde


# ===========================================================================
# ADIM 0: KURULUM  (girdi + plan + uygula)
# ===========================================================================
def kurulum_girdi(durum, mesaj):
    """Doner: (tamam_mi, sorulacak_soru)"""
    alanlar = niyet_kural.alanlari_cikar(mesaj)
    veri = alanlar.get("veri_seti") or durum.get("veri_seti")
    sozluk = alanlar.get("sozluk") or durum.get("sozluk")

    eksik = []
    if not veri:
        eksik.append("veri seti adi")
    if not sozluk:
        eksik.append("sozluk adi")
    if eksik:
        return False, ("Su bilgiler eksik: %s\n\n"
                       "Ornek: veri seti HAVALE_EFT_NTT ve sozluk DEGISKENLER"
                       % ", ".join(eksik))

    for ad in (veri, sozluk):
        if not _dataset_var_mi(ad):
            return False, ("'%s' adinda bir dataset projede bulunamadi.\n"
                           "Adi kontrol eder misin?" % ad)

    durum["veri_seti"] = veri
    durum["sozluk"] = sozluk
    return True, None


def kurulum_plan(durum):
    df = _df_oku(durum["veri_seti"], limit=1000)
    sz = _df_oku(durum["sozluk"])
    return ("Veri seti : %s  (%d kolon)\n"
            "Sozluk    : %s  (%d satir)\n\n"
            "Bu ikisiyle devam ediyorum. Onayliyor musun?"
            % (durum["veri_seti"], df.shape[1], durum["sozluk"], sz.shape[0]))


def kurulum_uygula(durum):
    return "Kurulum tamam."


# ===========================================================================
# ADIM 1: SOZLUK KONTROLU
# ===========================================================================
def sozluk_plan(durum):
    df = _df_oku(durum["veri_seti"], limit=1000)
    sz = _df_oku(durum["sozluk"])
    ad_kol, ack_kol = sz.columns[0], sz.columns[1]
    sozluk_map = dict(zip(sz[ad_kol].astype(str), sz[ack_kol].astype(str)))

    aciklamasiz = [c for c in df.columns if c not in sozluk_map]
    bos_ack = [k for k, v in sozluk_map.items()
               if not v or str(v).strip().lower() in ("nan", "none", "")]

    durum["_sozluk_eksik"] = aciklamasiz

    return ("Tabloda %d kolon var, sozlukte %d aciklama.\n\n%s\n\n%s\n\n"
            "Aciklamasi olmayan kolonlari surec disi birakip devam edeyim mi?"
            % (df.shape[1], len(sozluk_map),
               _liste("Sozlukte karsiligi olmayanlar:", aciklamasiz),
               _liste("Aciklamasi bos olanlar:", bos_ack)))


def sozluk_uygula(durum):
    durum["haric_kolonlar"] = durum.get("_sozluk_eksik", [])
    return "Haric tutulan kolon sayisi: %d" % len(durum["haric_kolonlar"])


# ===========================================================================
# ADIM 2: META TANIMI
# ===========================================================================
META_KALIP = {
    "target": r"target\s*[:=]?\s*([a-z0-9_]+)",
    "id": r"\bid\s*[:=]?\s*([a-z0-9_]+)",
    "donem": r"donem\s*[:=]?\s*([a-z0-9_]+)",
}


def meta_girdi(durum, mesaj):
    norm = niyet_kural.normalize(mesaj)
    meta = dict(durum.get("meta") or {})
    for anahtar, kalip in META_KALIP.items():
        m = re.search(kalip, norm)
        if m:
            # normalize uzunlugu bozmuyor -> konumu ORIJINAL metne uyguluyoruz
            meta[anahtar] = mesaj[m.start(1):m.end(1)]
    durum["meta"] = meta

    eksik = [k for k in ("target", "id") if k not in meta]
    if eksik:
        return False, ("Meta icin eksik: %s\n\n"
                       "Ornek: target TGT_CS_ALL_TKP_ST_5M90 id SM_ID donem PERIOD"
                       % ", ".join(eksik))
    return True, None


def meta_plan(durum):
    m = durum["meta"]
    return ("  target : %s\n"
            "  id     : %s\n"
            "  donem  : %s\n\n"
            "Onayliyor musun?"
            % (m.get("target"), m.get("id"), m.get("donem", "-")))


def meta_uygula(durum):
    return "Meta kaydedildi."


# ===========================================================================
# ADIM 3: GELENEKSEL PLAN   <-- LLM #1 BURADA
# ===========================================================================
def gelenekse_plan(durum):
    sz = _df_oku(durum["sozluk"])
    plan = llm_mod.gelenekse_plan_oner(
        sozluk_df=sz,
        haric=durum.get("haric_kolonlar", []),
        meta=durum.get("meta", {}),
    )
    durum["plan"] = plan

    if not plan:
        return ("LLM kullanilabilir bir plan uretemedi (bozuk JSON ya da "
                "gecersiz kolon adlari).\n"
                "'geri' diyip sozluk adimina donebilir veya 'onay' deyip "
                "bu adimi bos gecebilirsin.")

    satirlar = ["%s -> %s  (%d kolon)" % (p["ad"], p["donusum"], len(p["kolonlar"]))
                for p in plan]
    toplam = sum(len(p["kolonlar"]) for p in plan)
    return (_liste("Geleneksel degisken plani (LLM onerisi):", satirlar) +
            "\n\nYaklasik %d yeni kolon uretilecek. Onayliyor musun?" % toplam)


def gelenekse_uygula(durum):
    return "Plan onaylandi."


# ===========================================================================
# ADIM 4: URETIM  (tamamen deterministik, LLM yok)
# ===========================================================================
def _tekli_donustur(df, kolonlar, donusum):
    yeni = {}
    for kol in kolonlar:
        if kol not in df.columns:
            continue
        s = pd.to_numeric(df[kol], errors="coerce")
        if donusum == "log":
            yeni["%s__LOG" % kol] = np.log1p(s.clip(lower=0))
        elif donusum == "rank":
            yeni["%s__RANK" % kol] = s.rank(pct=True)
        elif donusum == "winsor":
            yeni["%s__WNS" % kol] = s.clip(s.quantile(0.01), s.quantile(0.99))
    return yeni


def _ikili_donustur(df, kolonlar, donusum):
    """delta / oran: ayni aileden ardisik iki kolon gerektirir."""
    yeni = {}
    for i in range(len(kolonlar) - 1):
        a, b = kolonlar[i], kolonlar[i + 1]
        if a not in df.columns or b not in df.columns:
            continue
        sa = pd.to_numeric(df[a], errors="coerce")
        sb = pd.to_numeric(df[b], errors="coerce")
        if donusum == "delta":
            yeni["%s__MINUS__%s" % (a, b)] = sa - sb
        elif donusum == "oran":
            yeni["%s__DIV__%s" % (a, b)] = sa / sb.replace(0, np.nan)
    return yeni


def uretim_plan(durum):
    return ("%d sablon icin kolon uretecegim ve sonucu %s_ENRICHED "
            "dataset'ine yazacagim.\nBaslayayim mi?"
            % (len(durum.get("plan", [])), durum["veri_seti"]))


def uretim_uygula(durum):
    df = _df_oku(durum["veri_seti"])
    uretilen = {}
    for p in durum.get("plan", []):
        d = p["donusum"]
        if d in ("delta", "oran"):
            uretilen.update(_ikili_donustur(df, p["kolonlar"], d))
        else:
            uretilen.update(_tekli_donustur(df, p["kolonlar"], d))

    for ad, seri in uretilen.items():
        df[ad] = seri

    hedef = "%s_ENRICHED" % durum["veri_seti"]
    dataiku.Dataset(hedef).write_with_schema(df)
    durum["uretilen"] = list(uretilen.keys())
    return "%d yeni kolon uretildi, %s dataset'ine yazildi." % (len(uretilen), hedef)


# ===========================================================================
# ADIM 5: VERI KALITESI
# ===========================================================================
def kalite_plan(durum):
    return ("Uretilen %d kolona su kontrolleri uygulayacagim:\n"
            "  - eksik oran > %%50\n"
            "  - sabit kolon (tek deger)\n"
            "  - target ile |korelasyon| > 0.95 (sizinti supheli)\n\n"
            "Calistirayim mi?" % len(durum.get("uretilen", [])))


def kalite_uygula(durum):
    df = _df_oku("%s_ENRICHED" % durum["veri_seti"])
    target = durum["meta"]["target"]
    yeni = [c for c in durum.get("uretilen", []) if c in df.columns]
    y = pd.to_numeric(df[target], errors="coerce")

    eksik, sabit, sizinti = [], [], []
    for c in yeni:
        s = pd.to_numeric(df[c], errors="coerce")
        if s.isna().mean() > 0.5:
            eksik.append(c)
            continue
        if s.nunique(dropna=True) <= 1:
            sabit.append(c)
            continue
        kor = s.corr(y)
        if kor is not None and not pd.isna(kor) and abs(kor) > 0.95:
            sizinti.append(c)

    elendi = set(eksik) | set(sabit) | set(sizinti)
    durum["kalite"] = {"eksik": eksik, "sabit": sabit, "sizinti": sizinti,
                       "gecti": [c for c in yeni if c not in elendi]}

    return (_liste("Elenen (eksik):", eksik) + "\n\n" +
            _liste("Elenen (sabit):", sabit) + "\n\n" +
            _liste("Elenen (sizinti supheli):", sizinti) +
            "\n\nGecen kolon sayisi: %d" % len(durum["kalite"]["gecti"]))


# ===========================================================================
# ADIM 6: MODEL
# ===========================================================================
def model_plan(durum):
    return ("Ayni bolme, ayni model; tek fark yeni kolonlarin eklenmis olmasi.\n"
            "Bu islem uzun surdugu icin '%s' senaryosu tetiklenecek.\n\n"
            "Calistirayim mi? (senaryo hazir degilse 'hayir' deyip gec)"
            % MODEL_SENARYO)


def model_uygula(durum):
    # UZUN ISLEM: Flask endpoint icinde model egitilmez, senaryo tetiklenir.
    try:
        proje = dataiku.api_client().get_default_project()
        proje.get_scenario(MODEL_SENARYO).run_and_wait()
    except Exception as e:
        return ("Senaryo calistirilamadi: %s\n"
                "Bu adimi simdilik atliyorum." % e)
    durum["model"] = {"tetiklendi": True,
                      "tarih": datetime.datetime.now().isoformat()}
    return "Senaryo calisti. Sonuclari Flow'dan gorebilirsin."


# ===========================================================================
# ADIM 7: KESIF   <-- LLM #2 BURADA
# ===========================================================================
def kesif_plan(durum):
    oneriler = llm_mod.kesif_oner(
        meta=durum.get("meta", {}),
        uretilen=durum.get("kalite", {}).get("gecti", []),
        model_ozeti=durum.get("model", {}),
    )
    durum["kesif_onerileri"] = oneriler
    if not oneriler:
        return "LLM fikir uretemedi. 'onay' deyip akisi kapatabilirsin."
    return (_liste("Yeni degisken fikirleri (LLM):", oneriler, en_fazla=10) +
            "\n\nBunlari kaydedeyim mi?")


def kesif_uygula(durum):
    icerik = json.dumps(durum.get("kesif_onerileri", []),
                        ensure_ascii=False, indent=2)
    _folder().upload_stream("/kesif_onerileri.json", icerik.encode("utf-8"))
    return "Oneriler PROJE_HAFIZASI/kesif_onerileri.json dosyasina yazildi."


# ===========================================================================
# ADIM KAYIT DEFTERI
# ===========================================================================
ADIMLAR = {
    "kurulum":   {"baslik": "0. Kurulum",         "girdi": kurulum_girdi,
                  "plan": kurulum_plan,   "uygula": kurulum_uygula},
    "sozluk":    {"baslik": "1. Sozluk Kontrolu", "girdi": None,
                  "plan": sozluk_plan,    "uygula": sozluk_uygula},
    "meta":      {"baslik": "2. Meta Tanimi",     "girdi": meta_girdi,
                  "plan": meta_plan,      "uygula": meta_uygula},
    "gelenekse": {"baslik": "3. Geleneksel Plan", "girdi": None,
                  "plan": gelenekse_plan, "uygula": gelenekse_uygula},
    "uretim":    {"baslik": "4. Uretim",          "girdi": None,
                  "plan": uretim_plan,    "uygula": uretim_uygula},
    "kalite":    {"baslik": "5. Veri Kalitesi",   "girdi": None,
                  "plan": kalite_plan,    "uygula": kalite_uygula},
    "model":     {"baslik": "6. Model",           "girdi": None,
                  "plan": model_plan,     "uygula": model_uygula},
    "kesif":     {"baslik": "7. Yeni Fikirler",   "girdi": None,
                  "plan": kesif_plan,     "uygula": kesif_uygula},
}


# ===========================================================================
# ANA DONGU — tum kontrol burada
# ===========================================================================
def _baslik(durum):
    return "[%s]\n\n" % ADIMLAR[ADIM_SIRASI[durum["i"]]]["baslik"]


def _adima_gir(durum):
    """Yeni adima girilirken: girdi gerekiyorsa sor, gerekmiyorsa plani goster."""
    adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]
    if adim["girdi"] is not None:
        durum["bekleyen"] = "girdi"
        _, soru = adim["girdi"](durum, "")      # bos mesaj -> eksik listesi doner
        return _baslik(durum) + (soru or "Devam etmek icin bilgi ver.")
    durum["bekleyen"] = "onay"
    return _baslik(durum) + adim["plan"](durum)


def mesaj_isle(durum, mesaj):
    """Webapp'in cagirdigi TEK fonksiyon. Cevap metnini doner."""
    mesaj = (mesaj or "").strip()
    norm = niyet_kural.normalize(mesaj)
    adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]

    # --- geri donus: her an gecerli ---
    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adimdayiz."
        durum["i"] -= 1
        return "Bir onceki adima donuldu.\n\n" + _adima_gir(durum)

    # --- girdi bekleniyor ---
    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            return uyari
        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    # --- onay bekleniyor ---
    sonuc = niyet_kural.coz(mesaj)

    if sonuc["aksiyon"] == "onay":
        cikti = adim["uygula"](durum)
        if durum["i"] >= len(ADIM_SIRASI) - 1:
            return cikti + "\n\nTum adimlar tamamlandi."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        return ("Tamam, uygulamadim.\n"
                "Neyi degistirmemi istersin? Degisikligi yazabilir ya da "
                "'geri' diyebilirsin.")

    return ("Su an [%s] adimindayim, onay bekliyorum.\n"
            "'onay', 'hayir' veya 'geri' yazabilirsin." % adim["baslik"])






























