import json
from dataiku.llm.python.blocks_graph import NextBlock


def _json_ayristir(ham):
    """girdi_al'ın çıktısı state'e string ya da dict olarak gelebilir; ikisini de ele al."""
    if ham is None:
        return {}
    if isinstance(ham, dict):
        return ham
    metin = str(ham).strip()
    # Model markdown kod bloğu ile sarmışsa temizle
    if metin.startswith("```"):
        metin = metin.strip("`").strip()
        if metin.lower().startswith("json"):
            metin = metin[4:].strip()
    try:
        return json.loads(metin)
    except Exception:
        return {}


def process(trace):
    g = _json_ayristir(state.get("girdi"))

    # Ayrıştırılan alanları düz anahtarlar olarak state'e yaz
    for anahtar in ["veri_seti", "sozluk", "target", "id_kolonu", "donem_kolonu"]:
        state[anahtar] = g.get(anahtar)
    state["dataset_var"] = bool(g.get("dataset_var"))
    state["sozluk_var"] = bool(g.get("sozluk_var"))
    state["config_var"] = bool(g.get("config_var"))
    state["niyet"] = g.get("niyet") or "bilgi"

    asama = state.get("asama") or "baslangic"

    # Başlangıçta: dataset verildi ve kullanıcı onayladı → 1. adıma geç
    if asama == "baslangic" and state["dataset_var"] and state["niyet"] == "onay":
        state["asama"] = "sozluk"
        yield NextBlock("sozluk_calis")
        return

    # Diğer her durumda sohbete dön
    yield NextBlock("sohbet")
