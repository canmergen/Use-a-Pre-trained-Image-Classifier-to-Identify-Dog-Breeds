    const kuruldu = d.ozet && d.ozet.kartlar
        && d.ozet.kartlar[0].deger !== "—" && d.ozet.kartlar[1].deger !== "—";
    const gizle = (d.mod !== "C") || kuruldu;
    kartEl.classList.toggle("gizli", gizle);
