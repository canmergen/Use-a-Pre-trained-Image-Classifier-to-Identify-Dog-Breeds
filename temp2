# =============================================================================
# FEATURE_DISCOVERY_AGENT / sozluk_tamamla
# -----------------------------------------------------------------------------
# Aciklamasi olmayan kolonlari ornek degerleriyle gosterir, LLM'in oneri
# uretebilmesi icin baglami state'e yazar.
#
# Iki yerden zincirlenir (Default next block ayari ile):
#   sozluk_calis -> sozluk_tamamla   (veri okunduktan sonra ilk rapor)
#   kolon_sorgu  -> sozluk_tamamla   (her islemden sonra kalan rapor)
#
# ORNEK DEGER OKUMA: yalnizca eksik kolonlar okunur. Satir sayisi esigin
# altindaysa TAMAMI okunur (farkli deger sayisi gercek olur). Ustundeyse
# rastgele ornekleme yapilir. Bas kisimdan okuma kullanilmaz; veri sirali
# oldugunda yaniltici sonuc verir.
#
# Surec disi birakilan kolonlar (sema.json > haric_kolonlar) eksik sayilmaz.
# =============================================================================

import json

import dataiku
from dataiku.llm.python.blocks_graph import NextBlock


HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

BLOK_ONERI_URET = "oneri_uret"

ASAMA_SOZLUK = "sozluk"

AZAMI_LISTELENEN = 15
AZAMI_ORNEK_DEGER = 10
TAM_OKUMA_SATIR_ESIGI = 2000000
ORNEKLEM_SATIR = 100000
AZAMI_DEGER_UZUNLUGU = 30
USLUP_ORNEK_SAYISI = 6


class Sema:
    VERI_SETI = "veri_seti"
    N_SATIR = "n_satir"
    KOLONLAR = "kolonlar"
    TIPLER = "tipler"
    SOZLUK = "sozluk"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"
    HARIC_KOLONLAR = "haric_kolonlar"


class S:
    ASAMA = "asama"
    BEKLENEN = "beklenen"
    VERI_SETI = "veri_seti"
    EKSIK_KOLONLAR = "eksik_kolonlar"
    EKSIK_BAGLAMI = "eksik_baglami"
    ONERILER = "oneriler"


class Beklenen:
    KOLON_ACIKLAMASI = "kolon_aciklamasi"


def _logla(mesaj):
    print("[sozluk_tamamla] {}".format(mesaj))


def _json_oku(dosya_yolu, varsayilan):
    try:
        folder = dataiku.Folder(HAFIZA_FOLDER)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _sayi(deger):
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _eksikleri_bul(sema, ek_sozluk):
    """Aciklamasi olmayan ve surec disi BIRAKILMAMIS kolonlari dondurur."""
    sozluk = sema.get(Sema.SOZLUK)
    sozluk = sozluk if isinstance(sozluk, dict) else {}

    tablo_kolonlari = sema.get(Sema.KOLONLAR)
    tablo_kolonlari = tablo_kolonlari if isinstance(tablo_kolonlari, list) else []

    bildirilen = sema.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    bildirilen = bildirilen if isinstance(bildirilen, list) else []

    haric = sema.get(Sema.HARIC_KOLONLAR)
    haric = set(haric) if isinstance(haric, list) else set()

    def _tanimli_mi(kolon):
        if kolon in ek_sozluk and str(ek_sozluk[kolon]).strip():
            return True
        aciklama = sozluk.get(kolon)
        return aciklama is not None and bool(str(aciklama).strip())

    eksikler = [k for k in tablo_kolonlari
                if k not in haric and not _tanimli_mi(k)]

    for kolon in bildirilen:
        if kolon in haric or kolon in eksikler:
            continue
        if not _tanimli_mi(kolon):
            eksikler.append(kolon)

    return eksikler, sorted(haric)


def _degeri_kisalt(deger):
    metin = str(deger).strip()
    if len(metin) > AZAMI_DEGER_UZUNLUGU:
        return metin[:AZAMI_DEGER_UZUNLUGU] + "..."
    return metin


def _veriyi_oku(veri_seti_adi, kolonlar, n_satir):
    """Doner: (dataframe veya None, ornekleme_yapildi_mi)"""
    dataset = dataiku.Dataset(veri_seti_adi)
    kolon_listesi = list(kolonlar)
    buyuk = bool(n_satir) and int(n_satir) > TAM_OKUMA_SATIR_ESIGI

    if not buyuk:
        try:
            df = dataset.get_dataframe(columns=kolon_listesi)
            _logla("tam okuma: {} kolon, {} satir".format(
                len(kolon_listesi), len(df)))
            return df, False
        except Exception as hata:
            _logla("tam okuma basarisiz: {}".format(hata))

    try:
        df = dataset.get_dataframe(
            columns=kolon_listesi, sampling="random", limit=ORNEKLEM_SATIR)
        _logla("rastgele orneklem: {} satir".format(len(df)))
        return df, True
    except Exception as hata:
        _logla("rastgele ornekleme basarisiz: {}".format(hata))

    try:
        df = dataset.get_dataframe(columns=kolon_listesi, limit=ORNEKLEM_SATIR)
        return df, True
    except Exception as hata:
        _logla("ornek degerler okunamadi: {}".format(hata))
        return None, False


def _ornek_degerleri_cikar(df, kolonlar):
    if df is None:
        return {}
    sonuc = {}
    for kolon in kolonlar:
        if kolon not in df.columns:
            continue
        try:
            seri = df[kolon].dropna()
            farkli = seri.unique()
            sonuc[kolon] = (len(farkli),
                            [_degeri_kisalt(d) for d in farkli[:AZAMI_ORNEK_DEGER]])
        except Exception as hata:
            _logla("{} ozetlenemedi: {}".format(kolon, hata))
    return sonuc


def _kolon_blogu(kolon, tipler, ornekler, orneklem_mi):
    tip = tipler.get(kolon)
    baslik = "**{}**".format(kolon)
    if tip:
        baslik += " ({})".format(tip)

    if kolon not in ornekler:
        return baslik

    farkli_sayi, degerler = ornekler[kolon]
    if not degerler:
        return baslik + " — tamamı boş"

    if orneklem_mi:
        baslik += " — örneklemde {} farklı değer".format(_sayi(farkli_sayi))
    else:
        baslik += " — {} farklı değer".format(_sayi(farkli_sayi))

    listelenen = ", ".join("`{}`".format(d) for d in degerler)
    if farkli_sayi > len(degerler):
        listelenen += ", ..."
    return "{}\n{}".format(baslik, listelenen)


def _eksik_mesaji(eksikler, tipler, ornekler, orneklem_mi, haric):
    if len(eksikler) == 1:
        giris = "Bir kolonun açıklaması yok:"
    else:
        giris = "{} kolonun açıklaması yok:".format(_sayi(len(eksikler)))

    parcalar = [giris, ""]
    for kolon in eksikler[:AZAMI_LISTELENEN]:
        parcalar.append(_kolon_blogu(kolon, tipler, ornekler, orneklem_mi))
        parcalar.append("")

    kalan = len(eksikler) - AZAMI_LISTELENEN
    if kalan > 0:
        parcalar.append("_ve {} kolon daha._".format(_sayi(kalan)))
        parcalar.append("")

    if orneklem_mi:
        parcalar.append("_Değerler {} satırlık rastgele örneklemden._".format(
            _sayi(ORNEKLEM_SATIR)))
        parcalar.append("")

    if haric:
        parcalar.append("_Süreç dışı bırakılan {} kolon var._".format(
            _sayi(len(haric))))
        parcalar.append("")

    return "\n".join(parcalar)


def _eksiksiz_mesaji(haric):
    parcalar = ["Açıklaması eksik kolon kalmadı.", ""]
    if haric:
        parcalar.append("Süreç dışı bırakılan {} kolon var.".format(
            _sayi(len(haric))))
        parcalar.append("")
    parcalar.append("Bir açıklamayı değiştirmek veya bir kolonu çıkarmak "
                    "isterseniz söyleyin. Değişiklik yoksa sözlük sıkıştırmaya "
                    "geçebiliriz.")
    return "\n".join(parcalar)


def _baglami_kur(eksikler, tipler, ornekler, sozluk, orneklem_mi):
    """LLM'in oneri uretebilmesi icin duz metin baglam hazirlar."""
    satirlar = []
    if orneklem_mi:
        satirlar.append("NOT: Ornek degerler rastgele orneklemden alindi.")
        satirlar.append("")

    satirlar.append("ACIKLAMASI EKSIK KOLONLAR:")
    for kolon in eksikler:
        parca = "- {}".format(kolon)
        tip = tipler.get(kolon)
        if tip:
            parca += " | tip: {}".format(tip)
        if kolon in ornekler:
            farkli_sayi, degerler = ornekler[kolon]
            parca += " | farkli deger: {}".format(farkli_sayi)
            parca += (" | ornekler: {}".format(", ".join(degerler))
                      if degerler else " | tamami bos")
        satirlar.append(parca)

    if isinstance(sozluk, dict) and sozluk:
        satirlar.append("")
        satirlar.append("MEVCUT SOZLUKTEN USLUP ORNEKLERI:")
        sayac = 0
        for kolon, aciklama in sozluk.items():
            if not str(aciklama or "").strip():
                continue
            satirlar.append("- {}: {}".format(kolon, aciklama))
            sayac += 1
            if sayac >= USLUP_ORNEK_SAYISI:
                break

    return "\n".join(satirlar)


def process(trace):
    try:
        if state.get(S.ASAMA) != ASAMA_SOZLUK:
            _logla("asama '{}', sessizce cikiliyor".format(state.get(S.ASAMA)))
            return

        sema = _json_oku(SEMA_DOSYASI, {})
        if not isinstance(sema, dict) or not sema:
            yield ("\n\nSözlük durumunu çıkaramadım; oturum kaydı okunamıyor. "
                   "Ayrıntı agent log'unda.")
            return

        ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
        ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}

        tipler = sema.get(Sema.TIPLER)
        tipler = tipler if isinstance(tipler, dict) else {}
        sozluk = sema.get(Sema.SOZLUK)
        sozluk = sozluk if isinstance(sozluk, dict) else {}

        eksikler, haric = _eksikleri_bul(sema, ek_sozluk)
        _logla("eksik={} haric={}".format(len(eksikler), len(haric)))

        state[S.ONERILER] = None

        if not eksikler:
            state[S.EKSIK_KOLONLAR] = []
            state[S.EKSIK_BAGLAMI] = ""
            state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI
            yield "\n\n" + _eksiksiz_mesaji(haric)
            return

        listelenecek = eksikler[:AZAMI_LISTELENEN]
        veri_seti_adi = state.get(S.VERI_SETI) or sema.get(Sema.VERI_SETI)

        ornekler = {}
        orneklem_mi = False
        if veri_seti_adi:
            df, orneklem_mi = _veriyi_oku(
                veri_seti_adi, listelenecek, sema.get(Sema.N_SATIR))
            ornekler = _ornek_degerleri_cikar(df, listelenecek)

        state[S.EKSIK_KOLONLAR] = listelenecek
        state[S.EKSIK_BAGLAMI] = _baglami_kur(
            listelenecek, tipler, ornekler, sozluk, orneklem_mi)

        # Bastaki bos satir onceki blogun mesajiyla yapismayi onler.
        yield "\n\n" + _eksik_mesaji(
            eksikler, tipler, ornekler, orneklem_mi, haric)
        yield NextBlock(BLOK_ONERI_URET)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("\n\nSözlük durumunu çıkarırken beklenmeyen bir hata oluştu. "
               "Ayrıntı agent log'una yazıldı.")
