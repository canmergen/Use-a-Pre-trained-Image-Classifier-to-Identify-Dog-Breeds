        _sayi(state.get(S.ONCEKI_N_SATIR)),
        _sayi(state.get(S.ONCEKI_N_KOLON)),
    ))

    # Sozluk blogu
    if state.get(S.ONCEKI_SOZLUK):
        satirlar.append("")
        satirlar.append("**Sözlük — {}**".format(state.get(S.ONCEKI_SOZLUK)))
        satirlar.append("{} kolon açıklaması".format(
            _sayi(state.get(S.ONCEKI_N_ACIKLAMA))))
    else:
        satirlar.append("")
        satirlar.append("**Sözlük** — verilmemiş; açıklamalar kolon adlarından "
                        "çıkarılacak.")

    # Eslesme blogu
    aciklamasiz = state.get(S.ONCEKI_ACIKLAMASIZ) or []
    fazla = state.get(S.ONCEKI_FAZLA) or []
    eslesen = state.get(S.ONCEKI_ESLESEN)

    if state.get(S.ONCEKI_SOZLUK):
        satirlar.append("")
