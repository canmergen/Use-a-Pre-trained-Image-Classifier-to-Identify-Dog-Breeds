"""Niyet katmanı: LLM'in JSON çıktısının şemaya göre doğrulanması.

Çıktı iki liste: geçerli aksiyonlar ve argümanı eksik aksiyonlar. Eksik olanlar
düşürülmez; asistanın eksik bilgiyi sorabilmesi için sonuca 'eksik_bilgi' olarak girer.
"""
import json
import re

GENEL = {
    "onay":   {"aciklama": "Mevcut aşamanın sonucunu onaylar, sonraki aşamaya geçer", "args": {}},
    "ret":    {"aciklama": "Mevcut aşamanın sonucunu reddeder", "args": {}},
    "geri":   {"aciklama": "Önceki aşamaya döner", "args": {}},
    "gec":    {"aciklama": "Mevcut aşamayı atlar", "args": {}},
    "durum":  {"aciklama": "Mevcut durumu gösterir", "args": {}},
    "yardim": {"aciklama": "Neler yapılabileceğini gösterir", "args": {}},
}

ASAMA = {
    "kurulum": {
        "veri_tanimla":   {"aciklama": "Ana veri setini tanımlar",
                           "args": {"dataset": "str"}},
        "sozluk_tanimla": {"aciklama": "Sözlük veri setini ve kolonlarını tanımlar",
                           "args": {"dataset": "str", "ad_kolonu": "str", "aciklama_kolonu": "str"}},
        "kapsam_disi":    {"aciklama": "Kolonları feature engineering kapsamı dışına alır",
                           "args": {"kolonlar": "list[str]"}},
        "kapsam_dahil":   {"aciklama": "Kapsam dışı bırakılmış kolonları geri alır",
                           "args": {"kolonlar": "list[str]"}},
    },
}


def izinli(asama: str) -> dict:
    d = dict(GENEL)
    d.update(ASAMA.get(asama, {}))
    return d


def katalog_metni(asama: str) -> str:
    satirlar = []
    for ad, t in izinli(asama).items():
        args = ", ".join(f"{k}: {v}" for k, v in t["args"].items()) or "argüman yok"
        satirlar.append(f"- {ad} — {t['aciklama']} ({args})")
    return "\n".join(satirlar)


def _json_yukle(ham):
    if isinstance(ham, dict):
        return ham
    if not isinstance(ham, str):
        return {}
    m = re.sub(r"^```(?:json)?\s*|\s*```$", "", ham.strip(), flags=re.S)
    try:
        return json.loads(m)
    except json.JSONDecodeError:
        e = re.search(r"\{.*\}", m, flags=re.S)
        if not e:
            return {}
        try:
            return json.loads(e.group(0))
        except json.JSONDecodeError:
            return {}


def _temizle(deger, tip):
    """Geçerliyse temizlenmiş değer, değilse None."""
    if tip == "str":
        return deger.strip() if isinstance(deger, str) and deger.strip() else None
    if tip == "list[str]":
        if isinstance(deger, str) and deger.strip():
            deger = [deger]
        if isinstance(deger, list):
            temiz = [x.strip() for x in deger if isinstance(x, str) and x.strip()]
            return temiz or None
    return None


def dogrula(ham, asama: str) -> dict:
    """→ {"aksiyonlar": [...], "eksik": [{"aksiyon", "eksik_args", "args"}]}"""
    obj = _json_yukle(ham)
    adaylar = obj.get("aksiyonlar", []) if isinstance(obj, dict) else []
    katalog = izinli(asama)
    aksiyonlar, eksik = [], []
    for a in adaylar if isinstance(adaylar, list) else []:
        if not isinstance(a, dict) or a.get("aksiyon") not in katalog:
            continue
        ad, args = a["aksiyon"], a.get("args") or {}
        if not isinstance(args, dict):
            args = {}
        sema = katalog[ad]["args"]
        temiz = {k: _temizle(args.get(k), t) for k, t in sema.items()}
        bos = [k for k, v in temiz.items() if v is None]
        if bos:
            eksik.append({"aksiyon": ad, "eksik_args": bos,
                          "args": {k: v for k, v in temiz.items() if v is not None}})
        else:
            aksiyonlar.append({"aksiyon": ad, "args": temiz})
    return {"aksiyonlar": aksiyonlar, "eksik": eksik}













"""Doğrulanmış aksiyonları sırayla çalıştırır; aşama geçişleri yalnızca burada ve işleyicilerde olur."""
from . import asamalar, kurulum, metin

ASAMA_ISLEYICILERI = {"kurulum": kurulum.ISLEYICILER}

YARDIM = metin.bolum(
    metin.baslik("Neler yapabilirim"),
    "Doğal dille konuşman yeterli; örneğin:",
    metin.kod("veri seti HAVALE_EFT_NTT, sözlük DEGISKENLER (ad SM_ID, açıklama aciklama)\n"
              "rn ve LOAD_DATE kolonlarını kapsam dışı bırak\n"
              "TXN_GDN kolonları ne anlatıyor?\n"
              "tamam, sonraki aşamaya geçelim"),
    "Kısayollar: `durum`, `onay`, `ret`, `geri`, `gec`, `yardim`.",
)


def _genel(state, aksiyon):
    asama = state["asama"]
    if aksiyon == "durum":
        return {"dogrudan_metin": state["durum_ozeti"]}
    if aksiyon == "yardim":
        return {"dogrudan_metin": YARDIM}
    if aksiyon == "geri":
        o = asamalar.onceki(asama)
        if o is None:
            return {"aksiyon": "geri", "durum": "hata", "mesaj": "İlk aşamadayız; geri dönülecek aşama yok."}
        state["asama"] = o
        return {"aksiyon": "geri", "durum": "ok", "mesaj": "Önceki aşamaya dönüldü.",
                "veri": {"yeni_asama": asamalar.etiket(o)}}
    if aksiyon == "gec":
        if asama in asamalar.ATLANAMAZ:
            return {"aksiyon": "gec", "durum": "hata",
                    "mesaj": f"'{asamalar.ETIKETLER[asama]}' zorunlu bir aşama, atlanamaz."}
        s = asamalar.sonraki(asama)
        state["asama"] = s
        return {"aksiyon": "gec", "durum": "ok", "mesaj": "Aşama atlandı.",
                "veri": {"yeni_asama": asamalar.etiket(s)}}
    if aksiyon in ("onay", "ret"):
        return {"aksiyon": aksiyon, "durum": "hata",
                "mesaj": f"'{asamalar.ETIKETLER[asama]}' aşamasında onaylanacak/reddedilecek bir sonuç yok."}
    return None


def calistir(state, aksiyonlar, eksik=None) -> dict:
    """Sonuç: anlat bloğuna verilecek JSON; 'dogrudan_metin' varsa LLM'e gitmeden basılır."""
    asama = state["asama"]
    sonuclar, oneriler = [], []
    for a in aksiyonlar:
        ad, args = a["aksiyon"], a.get("args", {})
        islem = ASAMA_ISLEYICILERI.get(asama, {}).get(ad)
        r = islem(state, args) if islem else _genel(state, ad)
        if r is None:
            r = {"aksiyon": ad, "durum": "hata", "mesaj": "Bu aşamada geçerli değil."}
        if "dogrudan_metin" in r:
            return r
        oneriler.extend(r.pop("oneriler", []))
        sonuclar.append(r)

    for e in eksik or []:
        sonuclar.append({"aksiyon": e["aksiyon"], "durum": "eksik_bilgi",
                         "mesaj": "İstek anlaşıldı ama gerekli bilgi eksik; kullanıcıdan istenmeli.",
                         "veri": {"verilen": e["args"], "eksik_args": e["eksik_args"]}})

    sonraki = ""
    if state["asama"] == "kurulum" and state["kurulum_dogrulandi"]:
        sonraki = "Kullanıcı onaylarsa 'Sözlük kontrolü' aşamasına geçilecek."
    elif state["asama"] != asama:
        sonraki = f"Şimdi {asamalar.etiket(state['asama'])} aşamasındayız."
    return {"asama": asamalar.etiket(state["asama"]), "sonuclar": sonuclar,
            "oneriler": oneriler, "sonraki_adim": sonraki}




















