# ADIM 4: VERI ANALIZI (SFA + null profili)
# ===========================================================================
def _gini_binary(s, y):
    """Sirali AUC uzerinden Gini. |2*AUC-1|; yon onemli degil, guc onemli.
    Mann-Whitney U'nun rank formu — dongusuz, 10.000 satirda hizli."""
    m = s.notna() & y.notna()
    if int(m.sum()) < 100:
        return None
    x = s[m]
    t = y[m]
    n1 = float((t > 0).sum())
    n0 = float((t <= 0).sum())
    if n1 == 0 or n0 == 0:
        return None
    r = x.rank()
    auc = (float(r[t > 0].sum()) - n1 * (n1 + 1) / 2.0) / (n1 * n0)
    return abs(2.0 * auc - 1.0)


def veri_analizi_plan(durum):
    p = durum.get("profil") or {}
    return ("Şimdi mevcut değişkenleri tek tek inceleyeceğim:\n\n"
            "  • eksik (null) oranı\n"
            "  • sabit ya da tek değerli kolonlar\n"
            "  • tekil değer sayısı aşırı yüksek olanlar (kimlik benzeri)\n"
            "  • tek değişkenli ayırt etme gücü — SFA\n\n"
            "Hedef %s olduğu için ayırt etme gücünü %s ile ölçeceğim.\n"
            "%s kolon taranacak, bu birkaç dakika sürebilir. Başlayayım mı?"
            % ((durum.get("meta") or {}).get("target"),
               "Gini (sıralı AUC)" if p.get("hedef_tip") == "binary"
               else "Spearman korelasyonu",
               _sayi(p.get("kolon", 0))))


def veri_analizi_uygula(durum):
    df = _df_oku(durum["veri_seti"])
    meta = durum.get("meta") or {}
    target = meta["target"]
    haric = set(durum.get("haric_kolonlar") or [])
    korunan = {target, meta.get("id"), meta.get("donem")}

    y = pd.to_numeric(df[target], errors="coerce")
    binary = (durum.get("profil") or {}).get("hedef_tip") == "binary"
    satir = float(len(df))

    cok_bos, sabit, kimlik_gibi, zayif, sizinti = [], [], [], [], []
    skorlar = {}

    for c in df.columns:
        if c in korunan or c in haric:
            continue
        s = df[c]

        null_oran = float(s.isna().mean())
        if null_oran > NULL_ESIK:
            cok_bos.append((c, null_oran))
            continue

        tekil = int(s.nunique(dropna=True))
        if tekil <= 1:
            sabit.append(c)
            continue
        # Tekil sayisi satir sayisina cok yakinsa kimlik/serial kolonudur
        if tekil > 0.95 * satir and tekil > 100:
            kimlik_gibi.append(c)
            continue

        sn = pd.to_numeric(s, errors="coerce")
        if sn.notna().sum() == 0:
            continue    # tamamen kategorik; bu turda kapsam disi

        if binary:
            skor = _gini_binary(sn, y)
        else:
            kor = sn.corr(y, method="spearman")
            skor = None if (kor is None or pd.isna(kor)) else abs(float(kor))

        if skor is None:
            continue
        skorlar[c] = round(skor, 4)

        if skor > SIZINTI_GINI:
            sizinti.append((c, skor))
        elif skor < GINI_ZAYIF:
            zayif.append(c)

    sirali = sorted(skorlar.items(), key=lambda kv: kv[1], reverse=True)
    guclu = [c for c, v in sirali if GINI_ZAYIF <= v <= SIZINTI_GINI]

    durum["analiz"] = {
        "metrik": "gini" if binary else "spearman",
        "skorlar": dict(sirali[:300]),          # state sismesin diye ilk 300
        "en_iyi": sirali[:15],
        "cok_bos": [c for c, _ in cok_bos],
        "cok_bos_oran": {c: round(o, 3) for c, o in cok_bos[:50]},
        "sabit": sabit,
        "kimlik_gibi": kimlik_gibi,
        "zayif": zayif,
        "sizinti": [c for c, _ in sizinti],
        "guclu": len(guclu),
    }
    p = durum.get("profil") or {}
    p["analiz_edildi"] = len(skorlar)
    durum["profil"] = p

    metrik_ad = "Gini" if binary else "|Spearman|"
    en_iyi = ["%-34s %s" % (c[:34], _ondalik(v * 100, 1))
              for c, v in sirali[:10]]

    return ("Analiz tamam. %s kolon skorlandı.\n\n"
            "EN GÜÇLÜ 10 DEĞİŞKEN (%s × 100)\n%s\n\n"
            "%s\n\n%s\n\n%s\n\n"
            "Ayırt etme gücü %s altında kalan %s kolon da var; bunlar tek "
            "başına bilgi taşımıyor ama kombinasyon içinde işe yarayabilir, "
            "şimdilik elemiyorum."
            % (_sayi(len(skorlar)), metrik_ad,
               "\n".join("  " + s for s in en_iyi),
               _liste("Eksik oranı %%%d üstü:" % int(NULL_ESIK * 100),
                      ["%s (%%%s)" % (c, _ondalik(o * 100)) for c, o in cok_bos]),
               _liste("Sabit / tek değerli:", sabit),
               _liste("Sızıntı şüpheli (skor > %s):" % _ondalik(SIZINTI_GINI, 2),
                      ["%s (%s)" % (c, _ondalik(v, 3)) for c, v in sizinti]),
               _ondalik(GINI_ZAYIF, 2), _sayi(len(zayif))))


