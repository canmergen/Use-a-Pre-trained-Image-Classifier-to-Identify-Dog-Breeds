def bolme_plan(durum):
    donemler = durum.get("_donemler") or []
    m = durum.get("meta") or {}

    b = durum.get("bolme") or {}
    if len(donemler) >= 2:
        b.setdefault("tur", "zamansal")
        b.setdefault("oot_deger", donemler[-1])
        oneri = ("  Tür        : zamansal (out-of-time)\n"
                 "  Geliştirme : %s ilk %s dönem\n"
                 "  OOT        : %s = %s\n"
                 % (m.get("donem"), _sayi(len(donemler) - 1),
                    m.get("donem"), b["oot_deger"]))
        gerekce = ("Dönem kolonu birden fazla değer taşıdığı için zamansal bölme "
                   "öneriyorum — kredi modellerinde gerçek kullanım koşuluna en "
                   "yakın değerlendirme budur.")
    else:
        b.setdefault("tur", "rastgele")
        b.setdefault("test_oran", 0.20)
        b.setdefault("seed", 42)
        oneri = ("  Tür        : rastgele\n"
                 "  Geliştirme : %%80\n"
                 "  Test       : %%20\n"
                 "  Seed       : %s\n" % b.get("seed", 42))
        gerekce = ("Kullanılabilir bir dönem kolonu olmadığı için rastgele bölme "
                   "kullanacağım. Zamansal bölme için \"geri\" deyip dönem kolonu "
                   "tanımlayabilirsiniz.")
    durum["bolme"] = b

    return ("Bölme stratejisi — bundan sonraki her şeyin sınırı:\n\n%s\n"
            "%s\n\n"
            "Bu sınır neden önemli: eksik değer doldurma, kategorik encoding ve "
            "model eğitimi YALNIZCA geliştirme seti üzerinden hesaplanacak, "
            "sonra test setine uygulanacak. Aksi halde test bilgisi eğitime "
            "sızar ve performans olduğundan iyi görünür.\n\n"
            "Onaylıyor musunuz?" % (oneri, gerekce))


def bolme_uygula(durum):
    df = _df_oku(durum["veri_seti"], limit=100000)
    tr, te = maskeler(durum, df)
    b = durum["bolme"]
    b["train_satir"] = int(tr.sum())
    b["test_satir"] = int(te.sum())
    durum["bolme"] = b
    return ("Bölme kaydedildi: %s geliştirme / %s test satırı."
            % (_sayi(b["train_satir"]), _sayi(b["test_satir"])))


