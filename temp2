const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

// Gorsel URL'leri: dosya adlari backend'de, JS sadece mantiksal ad biliyor.
const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl = document.getElementById("sohbet");
const kutuEl   = document.getElementById("kutu");
const gonderEl = document.getElementById("gonder");
const etiketEl = document.getElementById("adim-etiket");
const bannerEl = document.getElementById("banner");

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };

/** Sohbete bir satir ekler ve satir DOM elemanini doner. rol: "bot" | "kullanici" */
function balonEkle(rol, metin) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Sen";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon";
    balon.textContent = metin;   // textContent: gelen metin HTML olarak yorumlanmaz
    satir.appendChild(balon);

    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

/** Avatarli "yaziyor..." satiri; silmek icin satiri doner. */
function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    balon.classList.add("yaziyor");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function etiketGuncelle(d) {
    if (d.adim_no === undefined) return;
    etiketEl.textContent = "Adım " + d.adim_no + " / " + d.toplam + " · " + d.adim;
}

/* ---------- Karsilama: sayfa acilir acilmaz ---------- */
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => balonEkle("bot", d.metin))
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e));

/* ---------- Mesaj gonderme ---------- */
function gonder() {
    const metin = kutuEl.value.trim();
    if (!metin) return;

    balonEkle("kullanici", metin);
    kutuEl.value = "";
    gonderEl.disabled = true;

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        balonEkle("bot", d.cevap);
        etiketGuncelle(d);
    })
    .catch(e => {
        yaziyor.remove();
        balonEkle("bot", "Bağlantı hatası: " + e);
    })
    .finally(() => {
        gonderEl.disabled = false;
        kutuEl.focus();
    });
}

gonderEl.onclick = gonder;

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});

document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        balonEkle("bot", d.metin || d.cevap);
        etiketEl.textContent = "Adım 0 / 8";
    });
};














:root {
  --akbank-kirmizi: #E4002B;
  --akbank-koyu:    #B00020;
  --zemin:          #F4F5F7;
  --kenar:          #E2E4E8;
  --metin:          #1C1E21;
  --gri-metin:      #6B7280;
  --avatar-boyut:   42px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; }

#kabuk {
  display: flex;
  flex-direction: column;
  height: 100vh;
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  color: var(--metin);
  background: var(--zemin);
}

/* ---------- ÜST BANNER ---------- */
#ustbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 20px;
  background: #fff;
  border-bottom: 3px solid var(--akbank-kirmizi);
  flex-shrink: 0;
}

#banner { height: 44px; width: auto; display: block; }

#ustbar-sag { display: flex; align-items: center; gap: 12px; }

#adim-etiket {
  font-size: 12px;
  color: var(--gri-metin);
  background: var(--zemin);
  border: 1px solid var(--kenar);
  border-radius: 20px;
  padding: 4px 12px;
  white-space: nowrap;
}

#sifirla-btn {
  font-size: 12px;
  padding: 5px 14px;
  border: 1px solid var(--kenar);
  background: #fff;
  border-radius: 6px;
  cursor: pointer;
  color: var(--gri-metin);
}
#sifirla-btn:hover { border-color: var(--akbank-kirmizi); color: var(--akbank-kirmizi); }

/* ---------- SOHBET ---------- */
#sohbet { flex: 1; overflow-y: auto; padding: 24px 20px; }

.satir {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 18px;
  max-width: 880px;
}

.satir.kullanici { flex-direction: row-reverse; margin-left: auto; }

.avatar {
  width: var(--avatar-boyut);
  height: var(--avatar-boyut);
  min-width: var(--avatar-boyut);
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff;
  object-fit: cover;
  box-shadow: 0 1px 3px rgba(0,0,0,.12);
}

.balon {
  padding: 12px 16px;
  border-radius: 12px;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 14px;
  line-height: 1.6;
  max-width: 74%;
}

.satir.bot .balon {
  background: #fff;
  border: 1px solid var(--kenar);
  border-top-left-radius: 3px;
}

.satir.kullanici .balon {
  background: var(--akbank-kirmizi);
  color: #fff;
  border-top-right-radius: 3px;
}

/* ---------- YAZIYOR ---------- */
.balon.yaziyor { padding: 14px 18px; }

.nokta {
  display: inline-block;
  width: 7px; height: 7px;
  margin-right: 4px;
  border-radius: 50%;
  background: var(--gri-metin);
  animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }

@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-4px); }
}

/* ---------- GİRİŞ ---------- */
#giris {
  display: flex;
  gap: 10px;
  padding: 14px 20px;
  background: #fff;
  border-top: 1px solid var(--kenar);
  flex-shrink: 0;
}

#kutu {
  flex: 1;
  padding: 10px 12px;
  border: 1px solid var(--kenar);
  border-radius: 8px;
  font-family: inherit;
  font-size: 14px;
  resize: none;
  outline: none;
}
#kutu:focus { border-color: var(--akbank-kirmizi); }

#gonder {
  padding: 0 26px;
  background: var(--akbank-kirmizi);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
}
#gonder:hover:not(:disabled) { background: var(--akbank-koyu); }
#gonder:disabled { opacity: .5; cursor: not-allowed; }
