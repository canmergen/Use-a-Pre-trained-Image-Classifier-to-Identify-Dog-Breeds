# ===========================================================================
def _df_oku(ad, limit=-1):
    """limit=-1 -> global OKUMA_LIMITI. None -> tam tablo."""
    if limit == -1:
        limit = OKUMA_LIMITI
    ds = dataiku.Dataset(ad)
    return ds.get_dataframe() if limit is None else ds.get_dataframe(limit=limit)


def _dataset_var_mi(ad):
    try:
        dataiku.Dataset(ad).get_config()
        return True
    except Exception:
        return False


def _sayi(n):
    try:
        return "{:,}".format(int(n)).replace(",", ".")
    except Exception:
        return str(n)


def _ond(x, b=1):
    if x is None:
        return "—"
    try:
        return ("%.*f" % (b, x)).replace(".", ",")
    except Exception:
        return str(x)


def _liste(baslik, satirlar, en_fazla=12):
    if not satirlar:
        return baslik + "\n  (yok)"
    g = "\n".join("  • %s" % s for s in satirlar[:en_fazla])
    if len(satirlar) > en_fazla:
        g += "\n  … (+%d)" % (len(satirlar) - en_fazla)
    return baslik + "\n" + g


def _secim_ayikla(mesaj, adet):
    """'1,3,5 onay' -> [0,2,4]. Numara yoksa None (= hepsi)."""
    numaralar = [int(n) for n in SECIM_KALIP.findall(mesaj or "")]
    gecerli = sorted({n - 1 for n in numaralar if 1 <= n <= adet})
    return gecerli or None


def _yaz(dataset_adi, tablo, yedek_dosya):
    """Dataset'e yazmayi dener; olmazsa folder'a CSV birakir."""
    try:
        dataiku.Dataset(dataset_adi).write_with_schema(tablo)
        return dataset_adi, None
    except Exception:
        _folder().upload_stream(yedek_dosya, tablo.to_csv(index=False).encode("utf-8"))
        return None, yedek_dosya


def maskeler(durum, df):
    """(train_maske, test_maske) — LEAKAGE SINIRI burada ciziliyor.
    Imputation, encoding ve model egitimi train tarafini kullanir."""
    b = durum.get("bolme") or {}
    m = durum.get("meta") or {}

    if b.get("tur") == "zamansal" and b.get("oot_deger") and m.get("donem") in df.columns:
        test = df[m["donem"]].astype(str) == str(b["oot_deger"])
        return ~test, test

    oran = float(b.get("test_oran") or 0.20)
    seed = int(b.get("seed") or 42)
    rng = np.random.RandomState(seed)
    sira = np.arange(len(df))
    rng.shuffle(sira)
    n_test = int(len(df) * oran)
    test_konum = set(sira[:n_test].tolist())
    test = pd.Series([k in test_konum for k in range(len(df))], index=df.index)
    return ~test, test


