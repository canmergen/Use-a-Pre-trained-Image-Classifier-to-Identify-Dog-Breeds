def kurulum_girdi(durum, mesaj):
    """Doner: (tamam_mi, sorulacak_soru)"""
    alanlar = niyet_kural.alanlari_cikar(mesaj)
    veri = alanlar.get("veri_seti") or durum.get("veri_seti")
    sozluk = alanlar.get("sozluk") or durum.get("sozluk")

    eksik = []
    if not veri:
        eksik.append("veri setinin adı")
    if not sozluk:
        eksik.append("sözlüğün adı")
    if eksik:
        return False, ("Devam edebilmem için %s gerekiyor.\n\n"
                       "Yukarıdaki listeden seçebilir ya da şöyle yazabilirsiniz:\n"
                       "    veri seti HAVALE_EFT_NTT ve sözlük DEGISKENLER"
                       % " ve ".join(eksik))

    for ad in (veri, sozluk):
        if not _dataset_var_mi(ad):
            return False, ("Projede '%s' adında bir veri seti bulamadım. "
                           "Adını kontrol eder misiniz?" % ad)

    durum["veri_seti"] = veri
    durum["sozluk"] = sozluk
    return True, None


def kurulum_plan(durum):
    df = _df_oku(durum["veri_seti"])
    sz = _df_oku(durum["sozluk"])

    # Profil bir kez burada hesaplanip durum'a yaziliyor; ozet() bunu okuyor.
    p = durum.get("profil") or {}
    p["satir"] = int(df.shape[0])
    p["satir_ustsinir"] = bool(df.shape[0] >= OKUMA_LIMITI)   # limite dayandiysa "10.000+"
    p["kolon"] = int(df.shape[1])
    p["sozluk_satir"] = int(sz.shape[0])
    p["sayisal"] = int(df.select_dtypes(include=[np.number]).shape[1])
    durum["profil"] = p

    return ("İkisini de buldum:\n\n"
            "  Veri seti : %s\n"
            "              %s satır × %s kolon  (%s sayısal, %s kategorik)\n"
            "  Sözlük    : %s  —  %s tanım\n\n"
            "Bunlarla devam edelim mi?"
            % (durum["veri_seti"],
               _sayi(p["satir"]) + ("+" if p["satir_ustsinir"] else ""),
               _sayi(p["kolon"]), _sayi(p["sayisal"]), _sayi(p["kolon"] - p["sayisal"]),
               durum["sozluk"], _sayi(p["sozluk_satir"])))


def kurulum_uygula(durum):
    return "Kurulum tamam. Bu ikisiyle çalışıyoruz."


# ===========================================================================
# ADIM 2: SOZLUK ANALIZI
# ===========================================================================
def sozluk_plan(durum):
    df = _df_oku(durum["veri_seti"], limit=1000)
    sz = _df_oku(durum["sozluk"])
    ad_kol, ack_kol = sz.columns[0], sz.columns[1]
    sozluk_map = dict(zip(sz[ad_kol].astype(str), sz[ack_kol].astype(str)))

    aciklamasiz = [c for c in df.columns if c not in sozluk_map]
    bos_ack = [k for k, v in sozluk_map.items()
               if not v or str(v).strip().lower() in ("nan", "none", "")]

    durum["_sozluk_eksik"] = aciklamasiz

    toplam = int(df.shape[1])
    eslesen = toplam - len(aciklamasiz)
    p = durum.get("profil") or {}
    p["eslesen"] = eslesen
    p["kapsam"] = round(100.0 * eslesen / max(toplam, 1), 1)
    durum["profil"] = p

    return ("Tabloda %s kolon var; %s tanesinin sözlükte açıklaması mevcut "
            "(%%%s kapsam).\n\n%s\n\n%s\n\n"
            "Açıklaması olmayan kolonları süreç dışı bırakmayı öneriyorum — "
            "ne işe yaradığını bilmediğim kolondan sağlıklı değişken çıkmaz. "
            "Uygun mu?"
            % (_sayi(toplam), _sayi(eslesen), _ondalik(p["kapsam"]),
               _liste("Sözlükte karşılığı olmayanlar:", aciklamasiz),
               _liste("Açıklaması boş bırakılmış olanlar:", bos_ack)))


def sozluk_uygula(durum):
    durum["haric_kolonlar"] = durum.get("_sozluk_eksik", [])
    return "%s kolonu süreç dışı bıraktım." % _sayi(len(durum["haric_kolonlar"]))


