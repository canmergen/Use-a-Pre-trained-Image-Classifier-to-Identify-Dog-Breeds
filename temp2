@app.route("/fazlar")
def fazlar():
    """Sol paneldeki hiyerarsi. Mod secilmemisse yalnizca faz 01 doner."""
    oturum_id = request.args.get("oturum_id") or "varsayilan"
    durum = akis.durum_yukle(oturum_id)
    mod = durum.get("mod")
    return jsonify({"fazlar": akis.faz_agaci(mod),
                    "toplam": len(akis.adim_sirasi(mod)),
                    "mod": mod})


@app.route("/mesaj", methods=["POST"])
def mesaj():
    try:
        govde = request.get_json(force=True) or {}
        oturum_id = govde.get("oturum_id") or "varsayilan"

        durum = akis.durum_yukle(oturum_id)
        cevap = akis.mesaj_isle(durum, govde.get("mesaj", ""))
        akis.durum_kaydet(oturum_id, durum)

        mod = durum.get("mod")
        return jsonify({
            "cevap": cevap,
            "mod": mod,
            "adim_no": durum["i"],
            "toplam": len(akis.adim_sirasi(mod)),
            "fazlar": akis.faz_agaci(mod),   # mod degisince sol panel yenilensin
            "ozet": akis.ozet(durum),
            "detay": akis.detay(durum),
        })
    except Exception as e:
        return jsonify({
            "cevap": "HATA: %s\n\n%s" % (e, traceback.format_exc()[-1000:])
        }), 200















