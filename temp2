# 05 — GELENEKSEL URETIM   <-- LLM #1
# ===========================================================================
def gelenekse_plan(durum):
    sz = _df_oku(durum["sozluk"])
    plan = llm_mod.gelenekse_plan_oner(
        sozluk_df=sz, haric=durum.get("haric_kolonlar", []),
        meta=durum.get("meta", {}))
    durum["plan"] = plan

    if not plan:
        return ("Kullanılabilir bir plan çıkaramadım. \"onay\" deyip bu adımı "
                "geçebilir ya da \"geri\" deyip baz sete dönebiliriz.")

    kirilim = {}
    for p in plan:
        kirilim[p["donusum"]] = kirilim.get(p["donusum"], 0) + 1

    satirlar = []
    for i, p in enumerate(plan, 1):
        satirlar.append("  %2d. %-24s → %-7s (%s kolon)"
                        % (i, p["ad"][:24], p["donusum"], _sayi(len(p["kolonlar"]))))
        if p.get("gerekce"):
            satirlar.append("      %s" % p["gerekce"][:88])

    return ("Sözlüğü inceledim. %s dönüşüm fırsatı belirledim (%s):\n\n%s\n\n"
            "Yaklaşık %s yeni kolon üretir.\n\n"
            "Hepsi için \"onay\", seçmek için numara yazın: örn. \"1,3,5 onay\""
            % (_sayi(len(plan)),
               " · ".join("%s %s" % (v, k) for k, v in sorted(kirilim.items())),
               "\n".join(satirlar),
               _sayi(sum(len(p["kolonlar"]) for p in plan))))


def _tekli(df, kolonlar, d):
    y = {}
    for k in kolonlar:
        if k not in df.columns:
            continue
        s = pd.to_numeric(df[k], errors="coerce")
        if d == "log":      y["%s__LOG" % k] = np.log1p(s.clip(lower=0))
        elif d == "rank":   y["%s__RANK" % k] = s.rank(pct=True)
        elif d == "winsor": y["%s__WNS" % k] = s.clip(s.quantile(.01), s.quantile(.99))
    return y


def _ikili(df, kolonlar, d):
    y = {}
    for i in range(len(kolonlar) - 1):
        a, b = kolonlar[i], kolonlar[i + 1]
        if a not in df.columns or b not in df.columns:
            continue
        sa = pd.to_numeric(df[a], errors="coerce")
        sb = pd.to_numeric(df[b], errors="coerce")
        if d == "delta":  y["%s__MINUS__%s" % (a, b)] = sa - sb
        elif d == "oran": y["%s__DIV__%s" % (a, b)] = sa / sb.replace(0, np.nan)
    return y


def gelenekse_uygula(durum, secim=None):
    plan = durum.get("plan") or []
    if secim is not None:
        plan = [p for i, p in enumerate(plan) if i in set(secim)]
    if not plan:
        return "Bu adımda üretim yapılmadı."

    df = _df_oku((durum.get("baz") or {}).get("dataset") or durum["veri_seti"])

    uretilen, kod_satirlari = {}, []
    for p in plan:
        d, kolonlar = p["donusum"], p["kolonlar"]
        aciklama = "%s — %s" % (p["ad"], p.get("gerekce", ""))
        if d in ("delta", "oran"):
            yeni = _ikili(df, kolonlar, d)
            for i in range(len(kolonlar) - 1):
                a, b = kolonlar[i], kolonlar[i + 1]
                ad = ("%s__MINUS__%s" if d == "delta" else "%s__DIV__%s") % (a, b)
                if ad in yeni:
                    ifd = ("fark(%s, %s)" if d == "delta" else "%s / %s") % (a, b)
                    kod_satirlari.append((ad, ifade_mod.python_kodu(ad, ifd), aciklama))
        else:
            yeni = _tekli(df, kolonlar, d)
            for k in kolonlar:
                for sonek, ifd in (("__LOG", "log1p(%s)" % k), ("__RANK", "rank(%s)" % k)):
                    if k + sonek in yeni:
                        kod_satirlari.append((k + sonek,
                                              ifade_mod.python_kodu(k + sonek, ifd),
                                              aciklama))
                if k + "__WNS" in yeni:
                    kod_satirlari.append((
                        k + "__WNS",
                        'df["%s__WNS"] = _s(df, "%s").clip(_s(df, "%s").quantile(0.01), '
                        '_s(df, "%s").quantile(0.99))' % (k, k, k, k), aciklama))
        uretilen.update(yeni)

    for ad, seri in uretilen.items():
        df[ad] = seri

    hedef = "%s_ENRICHED" % durum["veri_seti"]
    dataiku.Dataset(hedef).write_with_schema(df)

    durum["uretilen"] = sorted(set(durum.get("uretilen") or []) | set(uretilen))
    durum["kod_bloklari"] = (durum.get("kod_bloklari") or []) + \
                            [["Geleneksel dönüşümler", kod_satirlari]]

    return ("%s dönüşümden %s yeni kolon ürettim, %s veri setine yazdım."
            % (_sayi(len(plan)), _sayi(len(uretilen)), hedef))


