def analiz_plan(durum):
    p = durum.get("profil") or {}
    psi_not = ("hesaplanacak (OOT: %s)" % durum.get("_oot_deger")
               if durum.get("_oot_deger") else "atlanacak")
    return ("Her değişkeni tek tek inceleyeceğim:\n\n"
            "  • null sayısı ve oranı, imputation kararı\n"
            "  • numeric / categorical ayrımı, encoding\n"
            "  • IV   — bilgi değeri        (eşik > %s)\n"
            "  • C-value — tek değişken AUC (eşik > %s)\n"
            "  • PSI  — zaman içinde kayma  (eşik < %s)  →  %s\n\n"
            "SFA bir ELEME kuralı değil: FAIL alan bir değişken çok değişkenli "
            "modelde anlamlı olabilir, otomatik atılmayacak. Gerçek eleme "
            "yalnızca teknik kusurlar için yapılacak.\n\n"
            "%s kolon taranacak, birkaç dakika sürebilir. Başlayayım mı?"
            % (_ond(sfa_mod.IV_ESIK, 2), _ond(sfa_mod.C_ESIK, 2),
               _ond(sfa_mod.PSI_ESIK, 2), psi_not, _sayi(p.get("kolon", 0))))


def analiz_uygula(durum):
    df = _df_oku(durum["veri_seti"])
    m = durum["meta"]

    oot_maske = None
    oot = durum.get("_oot_deger")
    if oot and m.get("donem") in df.columns:
        oot_maske = df[m["donem"]].astype(str) == str(oot)

    haric = {h for h in (set(durum.get("haric_kolonlar") or []) |
                         {m.get("id"), m.get("donem")}) if h}
    tablo, teshis = sfa_mod.calistir(df, m["target"], haric=haric,
                                     oot_maske=oot_maske)

    yazildi, yedek = _yaz("%s_SFA" % durum["veri_seti"], tablo, "/sfa_tablosu.csv")

    gecen = tablo[tablo["SFA_RESULT"] == "PASS"] if len(tablo) else tablo
    durum["sfa"] = {
        "analiz_edilen": int(len(tablo)),
        "pass_adet": int(len(gecen)),
        "en_iyi": [(r["FEATURE"], r["IV"]) for _, r in tablo.head(15).iterrows()]
                  if len(tablo) else [],
        "iv_skorlari": {r["FEATURE"]: r["IV"] for _, r in tablo.iterrows()
                        if r["IV"] is not None} if len(tablo) else {},
        "teshis": teshis,
        "tablo_dataset": yazildi,
    }

    satirlar = ["  %-30s %-12s IV %-7s C %-7s PSI %-7s %s"
                % (str(r["FEATURE"])[:30], r["TYPE"], _ond(r["IV"], 3),
                   _ond(r["C_VALUE"], 3), _ond(r["PSI"], 3), r["SFA_RESULT"])
                for _, r in tablo.head(12).iterrows()]

    return ("SFA tamamlandı. %s değişken analiz edildi, %s tanesi PASS.\n\n"
            "IV'YE GÖRE İLK 12\n%s\n\n"
            "TEKNİK KUSURLAR (elenecek)\n%s\n%s\n%s\n%s\n\n"
            "Tam tablo %s."
            % (_sayi(len(tablo)), _sayi(len(gecen)),
               "\n".join(satirlar) or "  (tablo boş)",
               _liste("  Aşırı null:", teshis["cok_bos"], 8),
               _liste("  Sabit:", teshis["sabit"], 8),
               _liste("  Kimlik benzeri:", teshis["kimlik_gibi"], 8),
               _liste("  Sızıntı şüpheli:", teshis["sizinti"], 8),
               ("%s veri setine yazıldı" % yazildi) if yazildi
               else "PROJE_HAFIZASI%s dosyasına yazıldı" % yedek))


