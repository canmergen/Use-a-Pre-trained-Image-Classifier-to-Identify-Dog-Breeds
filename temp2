#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
}




  --ustbar-h:   104px;        /* :root icinde, 86'dan buyuttuk */



#banner { height: 60px; width: auto; display: block; }

#urun-adi {
  font-weight: 700; font-size: 1.55em; letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt { font-size: 1em; color: var(--gri-acik); margin-top: 3px; white-space: nowrap; }




.ozet-etiket {
  display: block; font-size: .88em; font-weight: 700; letter-spacing: .08em;
  color: var(--kirmizi); text-transform: uppercase; margin-bottom: 4px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.15em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-ust, .ozet-alt { font-size: .9em; }
