/* Bot balonu metni her iki temada da Akbank kırmızısı */
.satir.bot .balon {
  background: var(--balon-zemin); color: var(--kirmizi);
  border: 1px solid var(--balon-kenar);
  border-top-left-radius: 4px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .95em;
  box-shadow: 0 3px 12px rgba(0,0,0,.28);
}
