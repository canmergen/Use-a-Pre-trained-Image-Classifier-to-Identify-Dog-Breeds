        df, durum["meta"]["target"],
        baz_kolonlar=(durum.get("baz") or {}).get("kolonlar") or [],
        yeni_kolonlar=(durum.get("secim") or {}).get("secilen_liste") or [],
        oot_maske=te)

    durum["model"] = sonuc
    if sonuc.get("hata"):
        return "Karşılaştırmayı tamamlayamadım: %s" % sonuc["hata"]

    b, e, d = sonuc["baseline"], sonuc["enhanced"], sonuc["delta"]
    yorum = ("Yeni değişkenler ayrıştırma gücünü artırdı."
             if d["auc"] > 0.001
             else "Yeni değişkenler ölçülebilir bir katkı sağlamadı.")
    return ("KARŞILAŞTIRMA SONUCU\n"
            "  Bölme  : %s\n  Eğitim : %s satır      Test : %s satır\n\n"
            "                    BAZ         ZENGİN      FARK\n"
