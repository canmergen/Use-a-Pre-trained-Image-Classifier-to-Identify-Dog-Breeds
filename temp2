temaUygula();


/* ==================== Sayfa geçişi ==================== */
function sayfaAc(ad) {
    Object.keys(sayfalar).forEach(k => sayfalar[k].classList.toggle("gizli", k !== ad));
    sekmeler.forEach(s => s.classList.toggle("aktif", s.dataset.sayfa === ad));
}
sekmeler.forEach(s => { s.onclick = () => sayfaAc(s.dataset.sayfa); });


/* ==================== Sol panel: faz ağacı ==================== */
/* Faz basligina tiklayinca alt adimlar acilir/kapanir. Aktif faz varsayilan acik. */
function fazlariCiz() {
    fazEl.innerHTML = "";
    FAZLAR.forEach((f, fi) => {
        const siralar = f.adimlar.map(a => a.sira);
        const bitis = Math.max.apply(null, siralar);
        const aktifMi = siralar.indexOf(aktifAdim) !== -1;
        const tamamMi = aktifAdim > bitis;
        const acik = acikFazlar.has(fi);

        const kok = document.createElement("div");
        kok.className = "faz"
            + (aktifMi ? " aktif" : "")
            + (tamamMi ? " tamam" : "")
            + (acik ? " acik" : "");

        const bas = document.createElement("div");
        bas.className = "faz-bas";
        bas.title = acik ? "Adımları gizle" : "Adımları göster";

        const ok = document.createElement("span");
        ok.className = "faz-ok";
        ok.textContent = "›";
        bas.appendChild(ok);

        const no = document.createElement("span");
        no.className = "faz-no";
        no.textContent = f.no;
        bas.appendChild(no);

        const govde = document.createElement("div");
        govde.className = "faz-govde";
        const ad = document.createElement("div");
        ad.className = "faz-ad";
        ad.textContent = f.baslik;
        govde.appendChild(ad);
        const ozt = document.createElement("div");
        ozt.className = "faz-ozet";
        ozt.textContent = f.ozet;
        govde.appendChild(ozt);
        bas.appendChild(govde);

        const tamamSayi = siralar.filter(s => s < aktifAdim).length;
        const durum = document.createElement("span");
        durum.className = "faz-durum";
        durum.textContent = tamamMi ? "✓" : (tamamSayi + "/" + siralar.length);
        durum.title = tamamMi
            ? "Faz tamamlandı"
            : tamamSayi + " / " + siralar.length + " adım tamamlandı";
        bas.appendChild(durum);

        bas.onclick = () => {
            if (acikFazlar.has(fi)) acikFazlar.delete(fi);
            else acikFazlar.add(fi);
            fazlariCiz();
        };
        kok.appendChild(bas);

        const liste = document.createElement("ol");
        liste.className = "faz-adimlar";
        f.adimlar.forEach(a => {
            const li = document.createElement("li");
            if (a.sira < aktifAdim)   li.className = "tamam";
            if (a.sira === aktifAdim) li.className = "aktif";
            li.title = a.aciklama || "";

            const isaret = document.createElement("span");
            isaret.className = "adim-isaret";
            isaret.textContent = (a.sira < aktifAdim) ? "✓" : "";
            li.appendChild(isaret);

            const t = document.createElement("span");
            t.textContent = a.baslik;
            li.appendChild(t);
            liste.appendChild(li);
        });
        kok.appendChild(liste);
        fazEl.appendChild(kok);
    });
}

/* Adim ilerleyince yeni aktif fazi otomatik ac */
function aktifFaziAc() {
    FAZLAR.forEach((f, fi) => {
        if (f.adimlar.some(a => a.sira === aktifAdim)) acikFazlar.add(fi);
    });
}

fetch(getWebAppBackendUrl("fazlar"))
    .then(r => r.json())
    .then(d => {
        FAZLAR = d.fazlar || [];
        DUZ_ADIMLAR = [];
        FAZLAR.forEach(f => f.adimlar.forEach(a => { DUZ_ADIMLAR[a.sira] = a; }));
        aktifFaziAc();
        fazlariCiz();
    })
    .catch(() => { fazEl.textContent = "iş akışı yüklenemedi"; });


/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;
        kart.appendChild(deger);

        const ust = document.createElement("span");
        ust.className = "ozet-ust";
        ust.textContent = k.ust || "";
        ust.title = k.ust || "";
        kart.appendChild(ust);

        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        alt.title = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}

/* Veri seti ve sozluk secilene kadar secim karti acik kalir. */
function kartiGuncelle(o) {
    if (!o || !o.kartlar) return;
    const veri   = o.kartlar[0] && o.kartlar[0].deger;
    const sozluk = o.kartlar[1] && o.kartlar[1].deger;
    const kuruldu = veri && veri !== "—" && sozluk && sozluk !== "—";

    kartEl.classList.toggle("gizli", !!kuruldu);
    if (!kuruldu) {
        sohbetEl.appendChild(kartEl);
        sohbetEl.scrollTop = sohbetEl.scrollHeight;
    }
}


/* ==================== Özet sayfası ==================== */
function detayGuncelle(d) {
    if (!d) return;
    ozetAdimEl.textContent = "Adım " + d.adim_no + " / " + d.toplam + " · " + d.adim;
    ozetKartlar.innerHTML = "";

    const bolumler = d.bolumler || [];
    if (!bolumler.length) {
        const bos = document.createElement("div");
        bos.id = "ozet-bos";
        bos.textContent = "Henüz bir adım tamamlanmadı.";
        ozetKartlar.appendChild(bos);
        return;
    }

    bolumler.forEach(b => {
        const blok = document.createElement("div");
        blok.className = "ozet-blok";

        const bas = document.createElement("div");
        bas.className = "ozet-blok-baslik";
        bas.textContent = b.baslik;
        blok.appendChild(bas);

        (b.satirlar || []).forEach(ikili => {
            const satir = document.createElement("div");
            satir.className = "ozet-satir";

            const e = document.createElement("span");
            e.className = "ozet-satir-etiket";
            e.textContent = ikili[0];
            satir.appendChild(e);

            const v = document.createElement("span");
            v.className = "ozet-satir-deger";
            v.textContent = (ikili[1] === null || ikili[1] === undefined)
                ? "—" : String(ikili[1]);
            satir.appendChild(v);

            blok.appendChild(satir);
        });
        ozetKartlar.appendChild(blok);
    });
}


