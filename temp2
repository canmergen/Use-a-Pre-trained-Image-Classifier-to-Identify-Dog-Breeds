SORU_SISTEM = """Sen Akbank Bireysel Krediler Analitik ve Tahsis ekibinin \
kullandığı Analitik Modelleme Platformu'nun asistanısın.

Kurallar:
- Türkçe, net ve kısa yanıt ver (en fazla 6-8 cümle).
- Yalnızca kullanıcının sorusunu yanıtla. Hiçbir işlem yapamazsın: veri \
okuyamaz, değişken üretemez, adım değiştiremezsin. Kullanıcı bir işlem \
isterse ekrandaki "Onayla ve Uygula", "Reddet ve Değiştir" veya "Geri Dön" \
butonlarını kullanmasını söyle.
- Bağlamda olmayan tablo, kolon adı veya sayı uydurma. Bilmiyorsan \
bilmediğini söyle.
- Kod, JSON veya markdown başlığı yazma; düz metin yaz."""


def soru_cevapla(soru, baglam, gecmis=None):
    """Doner: (cevap_metni, hata). Basarida hata None, hatada cevap None."""
    parcalar = ["BAĞLAM\n" + baglam]
    if gecmis:
        parcalar.append("ÖNCEKİ SORU-CEVAPLAR\n" + "\n".join(
            "S: %s\nC: %s" % (s, c) for s, c in gecmis[-3:]))
    parcalar.append("SORU\n" + soru)

    try:
        ham = _cagir(SORU_SISTEM, "\n\n".join(parcalar))
    except Exception as e:
        return None, str(e)

    # Thinking modelleri (Qwen) muhakemeyi <think> icinde donduruyor; at.
    metin = re.sub(r"<think>.*?</think>", "", ham or "", flags=re.S)
    if "</think>" in metin:
        metin = metin.split("</think>")[-1]
    metin = metin.strip()

    if not metin:
        return None, "Dil modeli boş yanıt döndü."
    return metin, None











# Yalnizca tek basina "A", "mod b", "3" gibi girdiler mod secimi sayilir.
# Eski hali (\b...\b) "A ile B farki ne" cumlesinde A'yi secim sanıyordu.
MOD_KALIP = re.compile(r"^\s*(mod\s*)?([abc123])\s*$", re.I)

# norm (kucuk harf, Turkce karaktersiz) uzerinde calisir
SORU_KALIP = re.compile(
    r"\b(neden|niye|nicin|nasil|nedir|ne|ne demek|hangisi|kac|"
    r"fark\w*|acikla\w*|anlat\w*|mi|mu|misin|musun|miyim|muyum)\b")







# ===========================================================================
# SERBEST SORU
# ===========================================================================
def _soru_mu(mesaj, norm):
    if len(norm) < 3 or MOD_KALIP.match(mesaj):
        return False
    return mesaj.endswith("?") or bool(SORU_KALIP.search(norm))


def _soru_baglami(durum, anahtar, adim):
    mod = durum.get("mod")
    satirlar = [
        "Platform beş fazda çalışır: (1) veriyi hazırlama: birleştirme, "
        "sözlük, temizlik; (2) veriyi tanıma: kalite, hedefle ilişki, "
        "stabilite; (3) yeni değişken üretimi: kural tabanlı ve yapay zekâ "
        "destekli; (4) değişken eleme: kalite, redundancy, tahmin gücü; "
        "(5) modelleme: algoritma seçimi, katkı ölçümü, final model.",
        "Çalışma modları: A = ham tablolardan başla (tablolar birleştirilir, "
        "zaman pencereli toplamalar üretilir, modelleme tablosu ve sözlük "
        "oluşturulur); B = veri seti hazır, sözlük yok (sözlük üretilir); "
        "C = ikisi de hazır (doğrudan analize geçilir). Mod, faz 1'de hangi "
        "adımların çalışacağını belirler; sonraki fazlar her modda aynıdır. "
        "Bu yüzden başlamadan önce seçim yapılması gerekir.",
        "Seçili mod: %s" % (mod or "henüz seçilmedi"),
        "Şu anki adım: %s" % adim.get("baslik", anahtar),
    ]
    if adim.get("aciklama"):
        satirlar.append("Adımın amacı: " + adim["aciklama"])
    if durum.get("bekleyen") == "girdi":
        satirlar.append("Kullanıcıdan beklenen: bir seçim ya da bilgi girmesi.")
    else:
        satirlar.append("Kullanıcıdan beklenen: öneriyi onaylaması, "
                        "reddetmesi veya geri dönmesi.")
    try:
        satirlar.append("Oturum özeti: " + json.dumps(
            ozet(durum), ensure_ascii=False, default=str)[:1500])
    except Exception:
        pass
    return "\n".join(satirlar)


def _soru_isle(durum, mesaj, anahtar, adim):
    """Soruyu LLM'e yanitlatir. Akisi ILERLETMEZ; ayni adimda kalinir."""
    gecmis = durum.get("_soru_gecmis") or []
    cevap, hata = llm_mod.soru_cevapla(
        mesaj, _soru_baglami(durum, anahtar, adim), gecmis)

    if cevap is None:
        cevap = ("Sorunuzu şu an yanıtlayamadım (dil modeline ulaşılamadı: "
                 "%s). Akışa kaldığımız yerden devam edebiliriz." % hata)
    else:
        gecmis.append([mesaj, cevap])       # JSON'a yazilacagi icin liste
        durum["_soru_gecmis"] = gecmis[-5:]

    if durum.get("bekleyen") == "girdi":
        # Bos mesajla cagirinca adim sorusunu ve secenek kartlarini yeniden kurar
        _, istem = adim["girdi"](durum, "")
        return cevap + ("\n\n" + istem if istem else "")

    return (cevap + "\n\nHazır olduğunuzda öneriyi onaylayabilir, "
            "değiştirebilir ya da geri dönebilirsiniz.")








