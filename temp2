def _soru_mu(mesaj, norm):
    """Acikca soru olan mesajlar: adim girdisi denenmeden LLM'e gider.
    ("A mi B mi?" gibi bir soru mod secimi sanilmasin diye.)"""
    if len(norm) < 3 or MOD_KALIP.match(mesaj):
        return False
    return mesaj.endswith("?") or bool(SORU_KALIP.search(norm))


def _soru_baglami(durum, anahtar, adim):
    mod = durum.get("mod")
    satirlar = [
        "Platform beş fazda çalışır: (1) veriyi hazırlama: birleştirme, "
        "sözlük, temizlik; (2) veriyi tanıma: kalite, hedefle ilişki, "
        "stabilite; (3) yeni değişken üretimi: kural tabanlı ve yapay zekâ "
        "destekli; (4) değişken eleme: kalite, redundancy, tahmin gücü; "
        "(5) modelleme: algoritma seçimi, katkı ölçümü, final model.",
        "Çalışma modları: A = ham tablolardan başla (tablolar birleştirilir, "
        "zaman pencereli toplamalar üretilir, modelleme tablosu ve sözlük "
        "oluşturulur); B = veri seti hazır, sözlük yok (sözlük üretilir); "
        "C = ikisi de hazır (doğrudan analize geçilir). Mod, faz 1'de hangi "
        "adımların çalışacağını belirler; sonraki fazlar her modda aynıdır. "
        "Bu yüzden başlamadan önce seçim yapılması gerekir.",
        "Seçili mod: %s" % (mod or "henüz seçilmedi"),
        "Şu anki adım: %s" % adim.get("baslik", anahtar),
    ]
    if adim.get("aciklama"):
        satirlar.append("Adımın amacı: " + adim["aciklama"])
    if durum.get("bekleyen") == "girdi":
        satirlar.append("Kullanıcıdan beklenen: bir seçim ya da bilgi girmesi.")
    else:
        satirlar.append("Kullanıcıdan beklenen: öneriyi onaylaması, "
                        "reddetmesi veya geri dönmesi.")
    try:
        satirlar.append("Oturum özeti: " + json.dumps(
            ozet(durum), ensure_ascii=False, default=str)[:1500])
    except Exception:
        pass
    return "\n".join(satirlar)


def _soru_isle(durum, mesaj, anahtar, adim):
    """Mesaji LLM'e yanitlatir. Akisi ILERLETMEZ; ayni adimda kalinir."""
    gecmis = durum.get("_soru_gecmis") or []
    cevap, hata = llm_mod.soru_cevapla(
        mesaj, _soru_baglami(durum, anahtar, adim), gecmis)

    if cevap is None:
        cevap = ("Mesajınızı şu an yanıtlayamadım (dil modeline ulaşılamadı: "
                 "%s). Akışa kaldığımız yerden devam edebiliriz." % hata)
    else:
        gecmis.append([mesaj, cevap])       # JSON'a yazilacagi icin liste
        durum["_soru_gecmis"] = gecmis[-5:]

    if durum.get("bekleyen") == "girdi":
        # Bos mesajla cagirinca adim sorusu ve secenek/secim kartlari yeniden kurulur
        _, istem = adim["girdi"](durum, "")
        return cevap + ("\n\n" + istem if istem else "")

    return (cevap + "\n\nHazır olduğunuzda öneriyi onaylayabilir, "
            "değiştirebilir ya da geri dönebilirsiniz.")







def mesaj_isle(durum, mesaj):
    """Webapp'in cagirdigi TEK fonksiyon. Cevap metnini doner."""
    mesaj = (mesaj or "").strip()
    norm = niyet_kural.normalize(mesaj)
    durum["_secenekler"] = []          # her tur basinda temizle
    durum["_secim_alani"] = None
    sira = adim_sirasi(durum.get("mod"))
    anahtar = sira[durum["i"]]
    adim = ADIMLAR[anahtar]

    # 1) Acik soru: geri/onay/girdi kontrollerinden ONCE LLM'e.
    #    "Onaylarsam ne olur?" onay, "Geri dönersem ne olur?" geri sanilmasin.
    if _soru_mu(mesaj, norm):
        return _soru_isle(durum, mesaj, anahtar, adim)

    # 2) Geri donus: her an gecerli
    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adımdayız.\n\n" + _adima_gir(durum)
        durum["i"] -= 1
        sira = adim_sirasi(durum.get("mod"))
        return ("\"%s\" adımına dönüyorum.\n\n"
                % ADIMLAR[sira[durum["i"]]]["baslik"]) + _adima_gir(durum)

    # 3) Girdi bekleniyor
    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            # Adimin bos-mesaj istemiyle ayni uyari dondu -> mesaj bu adima
            # ait hicbir sey icermiyor, serbest sohbettir: LLM yanitlasin.
            # Farkli uyari (or. "'X' tablosuna erisemiyorum") -> kullaniciya goster.
            _, bos_istem = adim["girdi"](durum, "")
            if mesaj and uyari == bos_istem:
                return _soru_isle(durum, mesaj, anahtar, adim)
            return uyari

        # Otomatik adimlar (mod secimi gibi): secim zaten karardir,
        # ayrica onay beklemeden uygula ve bir sonraki adima gec.
        if adim.get("otomatik"):
            cikti = adim["uygula"](durum)
            sira = adim_sirasi(durum.get("mod"))   # mod degisti, sirayi tazele
            if durum["i"] >= len(sira) - 1:
                return cikti
            durum["i"] += 1
            return cikti + "\n\n" + _adima_gir(durum)

        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    # 4) Onay bekleniyor
    sonuc = niyet_kural.coz(mesaj)

    if sonuc["aksiyon"] == "onay":
        if anahtar in SECIMLI:
            cikti = adim["uygula"](durum, _secim_ayikla(mesaj, _adet(durum, anahtar)))
        else:
            cikti = adim["uygula"](durum)
        sira = adim_sirasi(durum.get("mod"))
        if durum["i"] >= len(sira) - 1:
            return cikti + "\n\nÇalışma tamamlandı."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        return ("Anladım, uygulamadım. Neyi değiştirmemi istersiniz? "
                "İstediğinizi yazabilir ya da önceki adıma dönebilirsiniz.")

    # 5) Tanimadigimiz her mesaj serbest sohbettir
    return _soru_isle(durum, mesaj, anahtar, adim)