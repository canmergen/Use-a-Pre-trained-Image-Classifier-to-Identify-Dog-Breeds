@app.route("/adimlar")
def adimlar():
    """Sol paneldeki is akisi. Baslik ve aciklama akis.py'den geliyor;
    tek kaynak orasi kalsin diye burada sabit liste tutmuyoruz."""
    return jsonify({
        "adimlar": [{"anahtar": a,
                     "baslik": akis.ADIMLAR[a]["baslik"],
                     "aciklama": akis.ADIMLAR[a].get("aciklama", "")}
                    for a in akis.ADIM_SIRASI]
    })










