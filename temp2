:root {
  /* Akbank kirmizisi — logo yazisindan alindi */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-canli:#F51513;
  --kirmizi-acik: #FDF2F2;

  --zemin:        #F6F7F9;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #FBFBFC;
  --sohbet-zemin: #6B0A0D;      /* koyu kirmizi sohbet alani */
  --kenar:        #E2E5EA;
  --kenar-acik:   #EFF1F4;
  --metin:        #11161F;
  --gri:          #5F6B7C;
  --gri-acik:     #909BAC;
  --yesil:        #12B76A;
  --sari:         #EAB308;
  --sari-koyu:    #A16207;
  --sari-acik:    #FEFCE8;
  --golge:        rgba(17,22,31,.07);

  --panel-en:   clamp(340px, 27vw, 480px);
  --analiz-en:  clamp(320px, 24vw, 420px);
  --yazi:       11.2px;
  --avatar:     28px;
  --ustbar-h:   104px;
}

/* -------- KOYU TEMA: siyah taban -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #C21B1E;
  --kirmizi-canli:#FF6B5B;
  --kirmizi-acik: #2A1418;

  --zemin:        #000000;
  --yuzey:        #141414;
  --yuzey-alt:    #0A0A0A;
  --sohbet-zemin: #3D0508;
  --kenar:        #2C2C2C;
  --kenar-acik:   #1C1C1C;
  --metin:        #EDEDED;
  --gri:          #A0A0A0;
  --gri-acik:     #6E6E6E;
  --yesil:        #32D583;
  --sari:         #FACC15;
  --sari-koyu:    #FDE047;
  --sari-acik:    #2A2410;
  --golge:        rgba(0,0,0,.6);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
  transition: background .2s, color .2s;
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}
#ustbar-sol { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
#banner { height: 84px; width: auto; display: block; }
/* Logo beyaz zeminli PNG ise koyu temada halo olusmasin */
#kabuk.koyu #banner { background: #fff; border-radius: 8px; padding: 4px 8px; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 16px; line-height: 1.35; }
#urun-adi {
  font-weight: 700; font-size: 1.85em; letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt { font-size: 1.12em; color: var(--gri-acik); margin-top: 3px; white-space: nowrap; }

/* -------- Özet şerit -------- */
#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: 1em; font-weight: 700; letter-spacing: .07em;
  color: var(--gri); text-transform: uppercase; margin-bottom: 4px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.35em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--gri-acik); font-weight: 400; }
.ozet-ust {
  display: block; font-size: 1.05em; color: var(--gri); margin-top: 4px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-alt {
  display: block; font-size: 1.05em; color: var(--gri-acik); margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* -------- Sağ blok -------- */
#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 8px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: 9px; }

#tema-btn, #sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: 6px; cursor: pointer; color: var(--gri); flex-shrink: 0;
}
#tema-btn:hover, #sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 1em; color: var(--gri); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 8px;
}
.sekme {
  flex: 1; font-size: 1em; font-weight: 500; padding: 7px 20px;
  border: none; background: none; border-radius: 6px;
  cursor: pointer; color: var(--gri); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); color: var(--metin); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff; font-weight: 600;
  box-shadow: 0 1px 3px rgba(213,17,21,.28);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--kenar);
  padding: 20px 18px 30px; overflow-y: auto;
}
#panel::-webkit-scrollbar { width: 5px; }
#panel::-webkit-scrollbar-thumb { background: var(--kenar); border-radius: 3px; }

.panel-blok { margin-bottom: 24px; }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik {
  font-size: 1em; font-weight: 700; letter-spacing: .09em;
  color: var(--kirmizi); margin-bottom: 10px;
}
.panel-metin { margin: 0 0 10px; font-size: 1.02em; line-height: 1.6; color: var(--gri); }
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı: yeşil tamam · sarı devam · gri bekliyor -------- */
.faz { margin-bottom: 2px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 7px;
  padding: 8px; border-radius: 6px; cursor: pointer;
  color: var(--gri);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: var(--sari-acik); color: var(--sari-koyu); }
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 10px; margin-top: 2px;
  font-size: 1em; opacity: .55; transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; font-family: ui-monospace, Consolas, monospace;
  font-size: .88em; font-weight: 700; margin-top: 2px; opacity: .8;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: 1.1em; font-weight: 600; line-height: 1.3; color: inherit; }
.faz-ozet {
  font-size: .92em; color: var(--gri-acik);
  margin-top: 2px; line-height: 1.35; font-weight: 400;
}
.faz.aktif .faz-ozet { color: var(--sari-koyu); opacity: .8; }
.faz-durum {
  flex-shrink: 0; font-size: .88em; font-family: ui-monospace, Consolas, monospace;
  margin-top: 3px; opacity: .85; cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 1px 0 6px 13px; padding: 0 0 0 26px; display: none;
  border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 5px;
  font-size: .98em; color: var(--gri-acik); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 13px; height: 13px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .6em; font-weight: 700;
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: 600; }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #1A1200;
  box-shadow: 0 0 0 3px var(--sari-acik);
}

/* ==================== ORTA: SOHBET ==================== */
/* Koyu kirmizi zemin — yazi kutusu da bu zeminin icinde. */
#sohbet-alani {
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background: var(--sohbet-zemin);
}

#sohbet {
  flex: 1; overflow-y: auto;
  padding: 20px 22px 14px;
  background: transparent;
}
#sohbet::-webkit-scrollbar { width: 7px; }
#sohbet::-webkit-scrollbar-thumb { background: rgba(255,255,255,.22); border-radius: 4px; }

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 0 16px; max-width: 100%;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid rgba(255,255,255,.35);
}

.balon {
  padding: 13px 16px; border-radius: 14px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 88%;
  max-height: 360px; overflow-y: auto;
}
/* Bot: acik kart, koyu kirmizi uzerinde okunakli */
.satir.bot .balon {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
  border-top-left-radius: 4px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .95em;
  box-shadow: 0 2px 6px rgba(0,0,0,.25);
}
/* Kullanici: zeminden koyu ton */
.satir.kullanici .balon {
  background: rgba(0,0,0,.35); color: #fff;
  border: 1px solid rgba(255,255,255,.2);
  border-top-right-radius: 4px; font-size: 1em;
}
.satir.bot .balon.hata {
  background: #FFF4F4; color: #A00D10; border-color: #F5B5B5;
}

/* -------- Veri seçim kartı -------- */
#secici-kart {
  max-width: 100%; margin: 0 0 18px;
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 14px;
  padding: 18px 20px 20px; box-shadow: 0 2px 8px rgba(0,0,0,.25);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 600; font-size: 1.15em; margin-bottom: 5px; color: var(--metin); }
.kart-alt { font-size: 1em; color: var(--gri); line-height: 1.55; margin-bottom: 14px; }
.kart-govde { display: flex; gap: 11px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 165px; }
.combo label {
  display: block; font-size: .95em; color: var(--gri);
  margin-bottom: 5px; font-weight: 500;
}
.combo-giris {
  width: 100%; padding: 9px 12px; border: 1px solid var(--kenar); border-radius: 10px;
  font-family: ui-monospace, Consolas, monospace; font-size: 1em;
  outline: none; background: var(--yuzey); color: var(--metin);
}
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(213,17,21,.12); }
.combo-giris.secili { border-color: var(--yesil); }
.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 4px; list-style: none;
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 10px;
  box-shadow: 0 8px 20px rgba(0,0,0,.3);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 10px; border-radius: 6px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .98em;
  color: var(--metin);
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { color: var(--gri-acik); cursor: default; font-family: inherit; }
.combo-liste li.bos:hover { background: none; color: var(--gri-acik); }

#secici-btn {
  padding: 9px 22px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 18px; font-size: 1.05em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--gri-acik); cursor: not-allowed; }

/* Acik temada kart ve bot balonu beyaz kalir */
#kabuk:not(.koyu) #secici-kart,
#kabuk:not(.koyu) .satir.bot .balon { background: #fff; color: #11161F; }

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: var(--gri-acik); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* -------- Aksiyon butonları ve giriş: kirmizi zeminin icinde -------- */
#giris-bolge {
  border-top: 1px solid rgba(255,255,255,.15);
  background: transparent;
  padding: 14px 22px 20px; flex-shrink: 0;
}
#aksiyonlar { max-width: 100%; margin: 0 0 11px; display: flex; gap: 8px; }

.aksiyon {
  font-size: 1.05em; font-weight: 500; padding: 9px 20px;
  border: 1px solid rgba(255,255,255,.3); background: rgba(255,255,255,.08);
  border-radius: 18px; cursor: pointer; color: #fff; white-space: nowrap;
}
.aksiyon:hover:not(:disabled) { background: rgba(255,255,255,.18); }
.aksiyon.birincil {
  background: #fff; border-color: #fff;
  color: var(--sohbet-zemin); font-weight: 600;
}
.aksiyon.birincil:hover:not(:disabled) { background: #FFE8E9; }
.aksiyon:disabled { opacity: .4; cursor: not-allowed; }

/* Yazi blogu: tek yuvarlak kapsul — kutu + gonder ayni cerceve icinde */
#giris {
  max-width: 100%; margin: 0;
  display: flex; gap: 8px; align-items: flex-end;
  background: rgba(0,0,0,.3);
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 24px;
  padding: 6px 6px 6px 10px;
}
#kutu {
  flex: 1; padding: 8px 8px; border: none;
  border-radius: 16px; background: transparent; color: #fff;
  font-family: inherit; font-size: 1.05em; line-height: 1.5;
  resize: none; outline: none; max-height: 120px; overflow-y: auto;
}
#kutu::placeholder { color: rgba(255,255,255,.55); }
#kutu::-webkit-scrollbar { width: 5px; }
#kutu::-webkit-scrollbar-thumb { background: rgba(255,255,255,.3); border-radius: 3px; }

#gonder {
  padding: 9px 22px; background: rgba(255,255,255,.15); color: #fff;
  border: 1px solid rgba(255,255,255,.3); border-radius: 18px;
  font-size: 1.05em; font-weight: 500; cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { background: rgba(255,255,255,.28); }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column; overflow: hidden;
}

#analiz-ust {
  padding: 15px 17px 13px; border-bottom: 1px solid var(--kenar);
  background: var(--yuzey); flex-shrink: 0;
}
#analiz-baslik { font-weight: 700; font-size: 1.2em; color: var(--kirmizi); }

#analiz-sekmeler {
  display: flex; gap: 2px; padding: 9px 11px;
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  overflow-x: auto; flex-shrink: 0;
}
#analiz-sekmeler::-webkit-scrollbar { height: 0; }
.analiz-sekme {
  font-size: .98em; font-weight: 500; padding: 6px 12px;
  border: none; background: none; border-radius: 5px;
  cursor: pointer; color: var(--gri-acik); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); color: var(--metin); }
.analiz-sekme.aktif { background: var(--kirmizi-acik); color: var(--kirmizi); font-weight: 600; }

#analiz-govde { flex: 1; overflow-y: auto; padding: 15px 17px 24px; }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 10px;
  padding: 13px 15px; margin-bottom: 11px;
}
.iskele-baslik { font-size: 1.02em; font-weight: 600; margin-bottom: 9px; color: var(--metin); }
.iskele-satir {
  display: flex; justify-content: space-between; gap: 10px;
  font-size: .98em; padding: 5px 0; color: var(--gri);
}
.iskele-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--gri-acik); background: var(--kenar-acik);
  padding: 0 8px; border-radius: 3px;
}
.iskele-grafik {
  height: 80px; border-radius: 8px; margin-top: 4px;
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 6px,
    var(--yuzey) 6px, var(--yuzey) 12px);
  display: flex; align-items: center; justify-content: center;
  color: var(--gri-acik); font-size: .92em;
}

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1280px; margin: 0 auto; padding: 26px clamp(18px, 2.4vw, 44px) 56px; }
#ozet-baslik-blok { margin-bottom: 20px; }
#ozet-h1 { margin: 0; font-size: 1.9em; font-weight: 700; letter-spacing: -.01em; color: var(--kirmizi); }
#ozet-adim { font-size: 1.05em; color: var(--gri); margin-top: 6px; }

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 14px; align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 16px 18px 14px; box-shadow: 0 1px 2px var(--golge);
}
.ozet-blok-baslik {
  font-size: .95em; font-weight: 700; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 11px;
  padding-bottom: 9px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 6px 0; font-size: 1.05em; align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--gri); flex-shrink: 0; }
.ozet-satir-deger {
  font-family: ui-monospace, Consolas, monospace; color: var(--metin);
  text-align: right; font-weight: 500; word-break: break-word; min-width: 0;
}
#ozet-bos {
  background: var(--yuzey); border: 1px dashed var(--kenar); border-radius: 12px;
  padding: 40px; text-align: center; color: var(--gri-acik);
  font-size: 1.1em; grid-column: 1 / -1;
}

/* -------- Dar ekran -------- */
@media (max-width: 1180px) { #analiz-panel { display: none; } }
@media (max-width: 1280px) { #baslik-blok { display: none; } }
@media (max-width: 1080px) { #panel { display: none; } #ozet-serit { display: none; } }
















const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl   = document.getElementById("sohbet");
const kutuEl     = document.getElementById("kutu");
const gonderEl   = document.getElementById("gonder");
const fazEl      = document.getElementById("faz-listesi");
const seritEl    = document.getElementById("ozet-serit");
const bannerEl   = document.getElementById("banner");
const kartEl     = document.getElementById("secici-kart");
const seciciBtn  = document.getElementById("secici-btn");
const aksiyonlar = Array.from(document.querySelectorAll(".aksiyon"));

const sayfalar    = { calisma: document.getElementById("sayfa-calisma"),
                      ozet:    document.getElementById("sayfa-ozet") };
