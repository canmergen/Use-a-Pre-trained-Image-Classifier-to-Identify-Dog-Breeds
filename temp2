import json
import dataiku
from dataiku.llm.python.blocks_graph import NextBlock

HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYA = "/sema.json"


def _sema_oku():
    """PROJE_HAFIZASI/sema.json'u okur. Yoksa/bozuksa None doner."""
    try:
        folder = dataiku.Folder(HAFIZA_FOLDER)
        with folder.get_download_stream(SEMA_DOSYA) as f:
            return json.loads(f.read().decode("utf-8"))
    except Exception:
        return None


def process(trace):
    sema = _sema_oku()

    if sema is None:
        state["hafiza_var"] = False
        state["veri_seti"] = ""
        state["sozluk_adi"] = ""
        state["n_satir"] = 0
        state["n_kolon"] = 0
        state["hafiza_ozet"] = "Kayitli oturum yok. Veri seti adi henuz belirlenmedi."
    else:
        state["hafiza_var"] = True
        state["veri_seti"] = sema.get("veri_seti", "")
        state["sozluk_adi"] = sema.get("sozluk_adi", "")
        state["n_satir"] = int(sema.get("n_satir", 0))
        state["n_kolon"] = int(sema.get("n_kolon", 0))
        state["hafiza_ozet"] = (
            "Kayitli oturum VAR. "
            "Veri seti: {vs}. Sozluk: {sz}. "
            "Boyut: {ns} satir, {nk} kolon."
        ).format(
            vs=state["veri_seti"],
            sz=state["sozluk_adi"],
            ns=state["n_satir"],
            nk=state["n_kolon"],
        )

    # asama sadece ilk turda kurulur, sonraki turlarda korunur
    if "asama" not in state:
        state["asama"] = "sozluk_onay" if state["hafiza_var"] else "girdi"

    # devam/sifirdan karari verilmediyse isaretle
    if "hafiza_karari" not in state:
        state["hafiza_karari"] = "beklemede" if state["hafiza_var"] else "yok"

    yield NextBlock("girdi_al")










