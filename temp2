def process(trace):
    g = _json_ayristir(state.get("girdi"))

    for anahtar in ["veri_seti", "sozluk", "target", "id_kolonu", "donem_kolonu", "bolme_kolonu"]:
        if g.get(anahtar) is not None:
            state[anahtar] = g.get(anahtar)
    state["dataset_var"] = bool(g.get("dataset_var")) or bool(state.get("veri_seti"))
    state["sozluk_var"] = bool(g.get("sozluk_var")) or bool(state.get("sozluk"))
    state["config_var"] = bool(g.get("config_var"))
    state["niyet"] = g.get("niyet") or "bilgi"

    asama = state.get("asama") or "baslangic"

    # --- sohbet blogunun promptuna gidecek hafiza ozeti (her turda yenilenir) ---
    if state.get("onceki_reddedildi") and not state.get("veri_seti"):
        state["hafiza_ozet"] = (
            "Kullanici onceki oturumu REDDETTI ve sifirdan baslamak istiyor. "
            "Onceki oturumdan, eski veri setinden veya eski sozlukten ASLA bahsetme. "
            "Veri seti henuz belirlenmedi."
        )
    elif state.get("veri_seti"):
        state["hafiza_ozet"] = "Veri seti: {vs}. Sozluk: {sz}. Asama: {a}.".format(
            vs=state.get("veri_seti"),
            sz=state.get("sozluk") or "belirlenmedi",
            a=asama,
        )
    else:
        state["hafiza_ozet"] = "Veri seti henuz belirlenmedi. Asama: {a}.".format(a=asama)

    # --- Ilk turda onceki oturum var mi bak; varsa bayrak koy ve sor ---
    if asama == "baslangic" and not state.get("onceki_soruldu") and not state.get("veri_seti"):
        state["onceki_soruldu"] = True
        onceki = _onceki_oturumu_oku()
        if onceki and onceki.get("veri_seti"):
            state["onceki_veri_seti"] = onceki.get("veri_seti")
            state["onceki_sozluk"] = onceki.get("sozluk_adi")
            state["onceki_n_satir"] = onceki.get("n_satir")
            state["onceki_n_kolon"] = onceki.get("n_kolon")
            state["onceki_bekliyor"] = True
            yield NextBlock("onceki_sor")
            return

    # --- Onceki oturum sorusuna cevap ---
    if state.get("onceki_bekliyor"):
        state["onceki_bekliyor"] = False

        ham = str(state.get("girdi_ham") or state.get("girdi") or "").lower()
        yeni_istegi = (
            state["niyet"] in ("red", "yeni")
            or any(k in ham for k in ["yeni", "sifirdan", "sıfırdan", "bastan", "baştan", "farkli", "farklı"])
        )

        if state["niyet"] == "onay" and not yeni_istegi:
            state["veri_seti"] = state["onceki_veri_seti"]
            state["sozluk"] = state.get("onceki_sozluk")
            state["dataset_var"] = True
            state["sozluk_var"] = bool(state.get("onceki_sozluk"))
            state["asama"] = "sozluk"
            yield NextBlock("sozluk_calis")
            return

        # "yeni baslayalim" -> onceki oturumu tamamen unut
        for k in ["onceki_veri_seti", "onceki_sozluk", "onceki_n_satir", "onceki_n_kolon"]:
            state[k] = None
        state["onceki_reddedildi"] = True
        state["hafiza_ozet"] = (
            "Kullanici onceki oturumu REDDETTI ve sifirdan baslamak istiyor. "
            "Onceki oturumdan ASLA bahsetme. Veri seti henuz belirlenmedi."
        )
        yield NextBlock("sohbet")
        return

    # --- Normal akis ---
    if asama == "baslangic" and state["dataset_var"] and state["niyet"] == "onay":
        state["asama"] = "sozluk"
        yield NextBlock("sozluk_calis")
        return

    yield NextBlock("sohbet")










