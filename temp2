# -*- coding: utf-8 -*-
"""
FEATURE_STATE folder'indaki feature_registry.json + feature_rejects.json
-> tek Excel (COMPACT_JSON folder'ina yazilir)

Calisma yeri: Dataiku notebook veya Python recipe.
Recipe'de FEATURE_STATE input, COMPACT_JSON output olarak eklenmeli.
"""

import io
import json
import re
import posixpath

import dataiku
import pandas as pd
from openpyxl.utils import get_column_letter

# ----------------------------- AYARLAR -----------------------------
KAYNAK_FOLDER = "FEATURE_STATE"      # JSON'larin bulundugu managed folder
REGISTRY_YOL = "/feature_registry.json"
REJECTS_YOL = "/feature_rejects.json"

HEDEF_FOLDER = "COMPACT_JSON"        # Excel buraya yazilacak
CIKTI_YOL = "/feature_birlesik.xlsx"

AD_PREFIX = "LLM_F"                  # reject isimleri bu prefix + numara ile uretilir
BOS_DOLGU = "-"                      # eksik/bos alanlara yazilacak deger
BOOL_TURKCE = True                   # True/False -> Evet/Hayir
KAYNAK_SAYFALARI_EKLE = True         # ayrica REGISTRY ve REJECTS sheet'leri
# -------------------------------------------------------------------


# --------------------------- FOLDER I/O ----------------------------
def folder_json_oku(folder, yol: str) -> list:
    """Managed folder icindeki JSON dosyasini okur, her zaman liste dondurur."""
    mevcut = folder.list_paths_in_partition()
    if yol not in mevcut:
        alternatif = "/" + yol.lstrip("/")
        if alternatif in mevcut:
            yol = alternatif
        else:
            raise FileNotFoundError(
                f"'{yol}' folder'da bulunamadi. Folder icerigi: {mevcut}"
            )

    with folder.get_download_stream(yol) as stream:
        ham = stream.read()

    if isinstance(ham, bytes):
        ham = ham.decode("utf-8-sig")   # dosya basinda BOM varsa da okur

    data = json.loads(ham)
    if isinstance(data, dict):
        data = [data]
    if not isinstance(data, list):
        raise ValueError(f"{yol} beklenen formatta degil (liste veya dict olmali).")
    return data


def folder_excel_yaz(folder, yol: str, sheetler: dict):
    """sheetler: {"SHEET_ADI": DataFrame, ...} — bellekte olusturulup yuklenir."""
    buffer = io.BytesIO()
    with pd.ExcelWriter(buffer, engine="openpyxl") as writer:
        for sheet_adi, df in sheetler.items():
            if df is None or df.empty:
                continue
            df.to_excel(writer, sheet_name=sheet_adi, index=False)
            sutun_genisliklerini_ayarla(writer, sheet_adi, df)

    buffer.seek(0)
    folder.upload_stream(yol, buffer.getvalue())


def sutun_genisliklerini_ayarla(writer, sheet_adi: str, df: pd.DataFrame):
    """Sutun genisliklerini icerige gore ayarlar, ust satiri dondurur."""
    ws = writer.sheets[sheet_adi]
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions
    for i, sutun in enumerate(df.columns, start=1):
        uzunluklar = [len(str(sutun))] + [len(str(v)) for v in df[sutun].head(200)]
        genislik = min(max(uzunluklar) + 2, 60)   # 60 karakterde kes
        ws.column_dimensions[get_column_letter(i)].width = genislik


# ----------------------- DONUSUM FONKSIYONLARI ----------------------
def temizle(deger):
    """Tek bir degeri Excel'e yazilabilir, bos olmayan bir degere cevirir."""
    if deger is None:
        return BOS_DOLGU
    if isinstance(deger, bool):
        return ("Evet" if deger else "Hayir") if BOOL_TURKCE else deger
    if isinstance(deger, (list, tuple)):
        if len(deger) == 0:
            return BOS_DOLGU
        return ", ".join(str(x) for x in deger)
    if isinstance(deger, dict):
        if len(deger) == 0:
            return BOS_DOLGU
        return json.dumps(deger, ensure_ascii=False)
    if isinstance(deger, (int, float)):
        return deger                      # sayisal kalsin ki Excel'de siralanabilsin
    s = str(deger).strip()
    return s if s else BOS_DOLGU


def yuzdeye_cevir(deger, ondalik=2):
    """Orani (0-1) yuzdeye cevirir. Sayisal degilse BOS_DOLGU dondurur."""
    if isinstance(deger, bool) or deger is None:
        return BOS_DOLGU
    if isinstance(deger, (int, float)):
        return round(deger * 100, ondalik)
    return BOS_DOLGU


def ilk_dolu(kayit: dict, *anahtarlar):
    """Verilen anahtarlardan ilk mevcut olanin degerini dondurur, yoksa None."""
    for a in anahtarlar:
        if a in kayit and kayit[a] not in (None, "", [], {}):
            return kayit[a]
    return None


def decile_ozet(decile):
    """decile_egrisi listesinden metin + adet + min + max uretir."""
    if not isinstance(decile, (list, tuple)) or len(decile) == 0:
        return BOS_DOLGU, BOS_DOLGU, BOS_DOLGU, BOS_DOLGU
    sayisal = [x for x in decile if isinstance(x, (int, float))]
    metin = ", ".join(str(x) for x in decile)
    if not sayisal:
        return metin, len(decile), BOS_DOLGU, BOS_DOLGU
    return metin, len(decile), min(sayisal), max(sayisal)


def registry_son_numara(registry: list) -> int:
    """
    Registry adlarindaki en buyuk LLM_F numarasini bulur (LLM_F013_... -> 13).
    Reject numaralari buradan devam eder.
    Hicbir ad parse edilemezse kayit sayisina duser.
    """
    bulunan = []
    desen = re.compile(rf"{re.escape(AD_PREFIX)}(\d+)")
    for kayit in registry:
        ad = kayit.get("ad")
        if not ad:
            continue
        bulunan.extend(int(x) for x in desen.findall(str(ad)))
    return max(bulunan) if bulunan else len(registry)


def satir_uret(kayit: dict, durum: str, sira: int, ad_no: int) -> dict:
    """
    Bir JSON kaydini ortak sutun semasina cevirir.
    sira  : Excel'deki satir sirasi
    ad_no : isim uretiminde kullanilacak feature numarasi
    """
    ist = kayit.get("istatistikler") or {}
    if not isinstance(ist, dict):
        ist = {}

    # registry'de 'ad' hazir; rejects'te 'ad_soneki' asil isim, basina numara geliyor
    if kayit.get("ad"):
        ad = kayit["ad"]
    else:
        soneki = kayit.get("ad_soneki")
        ad = f"{AD_PREFIX}{ad_no:03d}_{soneki}" if soneki else f"{AD_PREFIX}{ad_no:03d}"

    kolonlar = ilk_dolu(kayit, "kaynak_kolonlar", "kolonlar") or []
    d_metin, d_adet, d_min, d_max = decile_ozet(ist.get("decile_egrisi"))

    return {
        "sira": sira,
        "durum": durum,                                   # KABUL / RED
        "ad": temizle(ad),
        "tema": temizle(kayit.get("tema")),
        "red_nedeni": temizle(kayit.get("neden")),
        "formul": temizle(kayit.get("formul")),
        "kolonlar": temizle(kolonlar),
        "gerekce": temizle(kayit.get("gerekce")),
        "mekanizma": temizle(kayit.get("mekanizma")),
        "beklenen_yon": temizle(kayit.get("beklenen_yon")),
        "gozlenen_yon": temizle(ist.get("gozlenen_yon")),
        "yon_guvenilir": temizle(ist.get("yon_guvenilir")),
        "yon_notu": temizle(kayit.get("yon_notu")),
        "zayif_sinyal": temizle(kayit.get("zayif_sinyal")),
        "en_riskli_dilim_rate": temizle(ist.get("en_riskli_dilim_rate")),
        "pp_gap": temizle(ist.get("pp_gap")),
        "lift": temizle(ist.get("lift")),
        "egri_sekli": temizle(ist.get("egri_sekli")),
        "sifir_orani_yuzde": yuzdeye_cevir(ist.get("sifir_orani")),
        "mevcutlarla_max_korelasyon": temizle(ist.get("mevcutlarla_max_korelasyon")),
        "decile_egrisi": d_metin,
        "decile_adet": d_adet,
        "decile_min": d_min,
        "decile_max": d_max,
    }


SUTUN_SIRASI = [
    "sira", "durum", "ad", "tema", "red_nedeni",
    "formul", "kolonlar",
    "gerekce", "mekanizma",
    "beklenen_yon", "gozlenen_yon", "yon_guvenilir", "yon_notu", "zayif_sinyal",
    "en_riskli_dilim_rate", "pp_gap", "lift",
    "egri_sekli", "sifir_orani_yuzde", "mevcutlarla_max_korelasyon",
    "decile_egrisi", "decile_adet", "decile_min", "decile_max",
]


def bilinmeyen_alanlari_bildir(kayitlar: list, dosya_adi: str):
    """Semada olmayan JSON alani varsa uyarir (veri sessizce kaybolmasin)."""
    bilinen = {
        "ad", "ad_soneki", "tema", "iterasyon", "tur", "neden", "formul",
        "kaynak_kolonlar", "kolonlar", "gerekce", "mekanizma", "beklenen_yon",
        "yon_notu", "zayif_sinyal", "tarih", "istatistikler",
    }
    bilinen_ist = {
        "base_rate", "en_riskli_dilim_rate", "pp_gap", "lift", "gozlenen_yon",
        "egri_sekli", "yon_guvenilir", "sifir_orani", "decile_egrisi",
        "mevcutlarla_max_korelasyon",
    }
    eksikler = set()
    for k in kayitlar:
        eksikler |= (set(k.keys()) - bilinen)
        ist = k.get("istatistikler")
        if isinstance(ist, dict):
            eksikler |= {f"istatistikler.{x}" for x in (set(ist.keys()) - bilinen_ist)}
    if eksikler:
        print(f"[UYARI] {dosya_adi} icinde semada olmayan alanlar var, "
              f"Excel'e yazilmadi: {sorted(eksikler)}")


# ------------------------------- ANA AKIS ---------------------------
def main():
    kaynak = dataiku.Folder(KAYNAK_FOLDER)
    hedef = kaynak if HEDEF_FOLDER == KAYNAK_FOLDER else dataiku.Folder(HEDEF_FOLDER)

    print("Kaynak folder icerigi:", kaynak.list_paths_in_partition())

    registry = folder_json_oku(kaynak, REGISTRY_YOL)
    rejects = folder_json_oku(kaynak, REJECTS_YOL)

    bilinmeyen_alanlari_bildir(registry, posixpath.basename(REGISTRY_YOL))
    bilinmeyen_alanlari_bildir(rejects, posixpath.basename(REJECTS_YOL))

    satirlar = []
    for i, kayit in enumerate(registry, start=1):
        satirlar.append(satir_uret(kayit, "KABUL", i, i))

    # reject numaralari registry'nin bittigi yerden devam eder
    baslangic = registry_son_numara(registry)
    print(f"Registry'deki en yuksek {AD_PREFIX} numarasi: {baslangic} "
          f"-> rejectler {baslangic + 1}'den basliyor")

    for j, kayit in enumerate(rejects, start=1):
        satirlar.append(satir_uret(kayit, "RED", len(registry) + j, baslangic + j))

    df = pd.DataFrame(satirlar)
    df = df.reindex(columns=SUTUN_SIRASI)     # sutun sirasini sabitle
    df = df.fillna(BOS_DOLGU)                 # kalan bosluk varsa doldur
    df["sira"] = range(1, len(df) + 1)        # global sira numarasi

    cakisan = df.loc[df["ad"].duplicated(keep=False), "ad"].unique().tolist()
    if cakisan:
        print(f"[UYARI] Ayni isimden birden fazla kayit var: {cakisan}")

    sheetler = {"TUM_FEATURELAR": df}
    if KAYNAK_SAYFALARI_EKLE:
        sheetler["REGISTRY"] = df[df["durum"] == "KABUL"]
        sheetler["REJECTS"] = df[df["durum"] == "RED"]

    folder_excel_yaz(hedef, CIKTI_YOL, sheetler)

    print(f"Tamam -> {HEDEF_FOLDER}{CIKTI_YOL}")
    print(f"KABUL: {len(registry)} | RED: {len(rejects)} | "
          f"Toplam: {len(df)} satir, {len(df.columns)} sutun")
    print(f"Yazilan sutunlar: {list(df.columns)}")


main()
