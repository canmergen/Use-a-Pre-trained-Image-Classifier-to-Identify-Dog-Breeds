def _adim_hazir_degil_mesaji(asama):
    """Onay alindi ama o adimin islem blogu henuz kurulmadi."""
    return (
        "**{ad}** adımının işlem bloğu henüz kurulmadı; bu adım çalıştırılamıyor.\n\n"
        "Süreç burada durdu. Bu adıma ait hiçbir çıktı üretilmedi."
    ).format(ad=ASAMA_ADLARI.get(asama, asama))


def _onceki_kayit_mesaji(veri_seti, sozluk, n_satir, n_kolon):
    """Hafizada bulunan onceki oturumu kullaniciya ozetler."""
    satirlar = [
        "**Kayıtlı oturum bulundu**",
        "",
        "Veri seti: **{}**".format(veri_seti),
    ]
    if sozluk:
        satirlar.append("Sözlük: **{}**".format(sozluk))
    satirlar.append(
        "Boyut: {:,} satır, {:,} kolon".format(int(n_satir or 0), int(n_kolon or 0))
        .replace(",", ".")
    )
    satirlar.append("")
    satirlar.append(
        "Bu kayıtla devam edilsin mi, yoksa yeni bir veri setiyle mi başlansın?"
    )
    return "\n".join(satirlar)


def _gecersiz_ad_mesaji(ad):
    """Dataset olmayan bir ad verildiginde kullaniciya aciklama."""
    return (
        "**{ad}** projede bir dataset olarak bulunmuyor; dosya veya klasör adı "
        "gibi görünüyor. Süreç dataset adıyla çalışır.\n\n"
        "Flow'daki dataset adını yazın (örneğin `HAVALE_EFT_NTT`)."
    ).format(ad=ad)
