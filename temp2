def _sayi(deger):
    """Binlik ayracli sayi metni: 10000 -> 10.000"""
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _kolon_listesi(kolonlar):
    """Kolon adlarini kisaltilmis liste olarak yazar."""
    if not kolonlar:
        return ""
    gosterilen = kolonlar[:AZAMI_LISTELENEN_KOLON]
    metin = ", ".join("`{}`".format(k) for k in gosterilen)
    kalan = len(kolonlar) - len(gosterilen)
    if kalan > 0:
        metin += " ve {} tane daha".format(kalan)
    return metin


