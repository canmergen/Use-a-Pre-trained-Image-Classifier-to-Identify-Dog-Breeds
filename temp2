"""Agent state şeması. Büyük veriler state'te tutulmaz; yalnızca orkestrasyon bilgisi."""
from . import asamalar, metin

VARSAYILAN = {
    "asama": "kurulum",
    "asama_etiketi": "",
    "veri_seti": "",
    "sozluk": "",
    "sozluk_ad_kolonu": "",
    "sozluk_acik_kolonu": "",
    "haric_kolonlar": [],
    "karsilama_yapildi": False,
    "karsilama_ekle": False,
    "komut": "",
    "komut_args": [],
    "durum_ozeti": "",
}


def hazirla(state) -> None:
    """Eksik anahtarları tamamlar, türetilmiş alanları günceller. Her turda çağrılır."""
    for k, v in VARSAYILAN.items():
        if k not in state:
            state[k] = list(v) if isinstance(v, list) else v
    if state["asama"] not in asamalar.KIMLIKLER:
        state["asama"] = "kurulum"
    guncelle_ozet(state)


def guncelle_ozet(state) -> None:
    state["asama_etiketi"] = asamalar.etiket(state["asama"])
    sozluk = state["sozluk"]
    if sozluk:
        sozluk += f"  ({state['sozluk_ad_kolonu']} → {state['sozluk_acik_kolonu']})"
    state["durum_ozeti"] = metin.anahtar_deger([
        ("Aşama",       state["asama_etiketi"]),
        ("Veri seti",   state["veri_seti"] or "tanımsız"),
        ("Sözlük",      sozluk or "tanımsız"),
        ("Kapsam dışı", ", ".join(state["haric_kolonlar"]) or "yok"),
    ])










from dataiku.llm.python.blocks_graph import NextBlock
from fe_agent import durum, komut as komut_mod, dispatcher, metin


def process(trace):
    durum.hazirla(state)
    mesaj = komut_mod.kullanici_mesaji(globals())
    if not mesaj.strip():
        g = globals()
        yield metin.kod("Kullanıcı mesajı bulunamadı.\nglobals: "
                        + ", ".join(sorted(k for k in g if not k.startswith("_"))))
        return

    komut = komut_mod.ayristir(mesaj)

    # İlk tur: komut yoksa karşılama yeter, LLM'e gidilmez.
    # Komut varsa karşılamayı asama_isle kendi çıktısının başına ekler (tek blok yazar).
    if not state["karsilama_yapildi"]:
        state["karsilama_yapildi"] = True
        if komut is None:
            yield dispatcher.karsilama(state)
            return
        state["karsilama_ekle"] = True

    if komut is None:
        state["komut"], state["komut_args"] = "", []
        yield NextBlock("sohbet")
    else:
        state["komut"], state["komut_args"] = komut.ad, komut.args
        yield NextBlock("asama_isle")










from fe_agent import durum, komut as komut_mod, dispatcher, metin


def process(trace):
    komut = komut_mod.Komut(state["komut"], list(state["komut_args"]))
    sonuc = dispatcher.calistir(state, komut)
    if state["karsilama_ekle"]:
        state["karsilama_ekle"] = False
        sonuc = metin.bolum(dispatcher.karsilama(state), "---", sonuc)
    yield sonuc
    durum.guncelle_ozet(state)









