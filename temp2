# ===========================================================================
def _df_oku(ad, limit=OKUMA_LIMITI):
    return dataiku.Dataset(ad).get_dataframe(limit=limit)


def _dataset_var_mi(ad):
    try:
        dataiku.Dataset(ad).get_config()
        return True
    except Exception:
        return False


def _sayi(n):
    try:
        return "{:,}".format(int(n)).replace(",", ".")
    except Exception:
        return str(n)


def _ond(x, b=1):
    if x is None:
        return "—"
    try:
        return ("%+.*f" % (b, x)).replace(".", ",") if b == 4 else \
               ("%.*f" % (b, x)).replace(".", ",")
    except Exception:
        return str(x)


def _liste(baslik, satirlar, en_fazla=15):
    if not satirlar:
        return baslik + "\n  (yok)"
    g = "\n".join("  • %s" % s for s in satirlar[:en_fazla])
    if len(satirlar) > en_fazla:
        g += "\n  … (+%d)" % (len(satirlar) - en_fazla)
    return baslik + "\n" + g


def _secim_ayikla(mesaj, adet):
    """'1,3,5 onay' -> [0,2,4]. Numara yoksa None (= hepsi)."""
    numaralar = [int(n) for n in SECIM_KALIP.findall(mesaj or "")]
    gecerli = sorted({n - 1 for n in numaralar if 1 <= n <= adet})
    return gecerli or None


def _yaz(dataset_adi, tablo, yedek_dosya):
    """Dataset'e yazmayi dener; olmazsa folder'a CSV birakir."""
    try:
        dataiku.Dataset(dataset_adi).write_with_schema(tablo)
        return dataset_adi, None
    except Exception:
        _folder().upload_stream(yedek_dosya, tablo.to_csv(index=False).encode("utf-8"))
        return None, yedek_dosya


def ozet(durum):
    m, p = durum.get("meta") or {}, durum.get("profil") or {}
    s, k = durum.get("sfa") or {}, durum.get("kalite") or {}
    sc, md = durum.get("secim") or {}, durum.get("model") or {}
    bos = "—"

    veri_alt = ("%s satır × %s kolon" % (
        _sayi(p["satir"]) + ("+" if p.get("satir_ustsinir") else ""),
        _sayi(p["kolon"]))) if p.get("kolon") else "seçilmedi"

    if s.get("pass_adet") is not None:
        sozluk_alt = "%s / %s değişken PASS" % (
            _sayi(s["pass_adet"]), _sayi(s.get("analiz_edilen", 0)))
    elif p.get("sozluk_satir"):
        sozluk_alt = "%s tanım" % _sayi(p["sozluk_satir"])
    else:
        sozluk_alt = "seçilmedi"

    hedef_deger = m.get("target") or bos
    d = (md.get("delta") or {}).get("auc")
    hedef_alt = (("Δ AUC %s" % _ond(d, 4)) if d is not None
                 else (p.get("hedef_ozet") or "tanımlanmadı"))

    uretilen = len(durum.get("uretilen") or [])
    if sc.get("secilen") is not None:
        deger = "%s → %s" % (_sayi(p.get("kolon", 0)),
                             _sayi(p.get("kolon", 0) + sc["secilen"]))
        alt = "%s üretildi · %s seçildi" % (_sayi(uretilen), _sayi(sc["secilen"]))
    elif uretilen and p.get("kolon"):
        deger = "%s → %s" % (_sayi(p["kolon"]), _sayi(p["kolon"] + uretilen))
        alt = "+%s yeni" % _sayi(uretilen)
        if k:
            alt += " · %s elendi" % _sayi(uretilen - len(k.get("gecti") or []))
    else:
        deger, alt = bos, "henüz üretilmedi"

    return {"kartlar": [
        {"etiket": "Veri seti", "deger": durum.get("veri_seti") or bos, "alt": veri_alt},
        {"etiket": "Sözlük", "deger": durum.get("sozluk") or bos, "alt": sozluk_alt},
        {"etiket": "Hedef", "deger": hedef_deger, "alt": hedef_alt},
        {"etiket": "Değişken seti", "deger": deger, "alt": alt},
    ]}


