SORU_SISTEM = """Sen Akbank Bireysel Krediler Analitik ve Tahsis ekibinin \
kullandığı Analitik Modelleme Platformu'nun asistanısın. Kullanıcıyla \
doğal ve kibar biçimde sohbet edebilirsin.

Kurallar:
- Türkçe, net ve kısa yanıt ver (en fazla 6-8 cümle).
- Kullanıcı sohbet etmek isterse sohbet et; soru sorarsa yanıtla.
- Hiçbir işlem yapamazsın: veri okuyamaz, değişken üretemez, adım \
değiştiremezsin. İşlem istenirse ekrandaki seçenekleri veya "Onayla ve \
Uygula", "Reddet ve Değiştir", "Geri Dön" butonlarını kullanmasını söyle.
- Bağlamda olmayan tablo, kolon adı veya sayı uydurma. Bilmiyorsan \
bilmediğini söyle.
- Kod, JSON veya markdown başlığı yazma; düz metin yaz."""


def soru_cevapla(soru, baglam, gecmis=None):
    """Doner: (cevap_metni, hata). Basarida hata None, hatada cevap None."""
    parcalar = ["BAĞLAM\n" + baglam]
    if gecmis:
        parcalar.append("ÖNCEKİ MESAJLAŞMA\n" + "\n".join(
            "Kullanıcı: %s\nAsistan: %s" % (s, c) for s, c in gecmis[-3:]))
    parcalar.append("KULLANICININ MESAJI\n" + soru)

    try:
        ham = _cagir(SORU_SISTEM, "\n\n".join(parcalar))
    except Exception as e:
        return None, "%s: %s" % (type(e).__name__, e)

    # Thinking modelleri (Qwen) muhakemeyi <think> icinde donduruyor; at.
    metin = re.sub(r"<think>.*?</think>", "", ham or "", flags=re.S)
    if "</think>" in metin:
        metin = metin.split("</think>")[-1]
    metin = metin.strip()

    if not metin:
        return None, "Dil modeli boş yanıt döndü."
    return metin, None
