# ===========================================================================
def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _yol(oturum_id):
    return "/oturum_%s.json" % re.sub(r"[^A-Za-z0-9_-]", "", str(oturum_id))


def yeni_durum():
    return {
        "i": 0, "bekleyen": "girdi",
        "veri_seti": None, "sozluk": None,
        "meta": {}, "profil": {},
        "haric_kolonlar": [],
        "sfa": {},           # ozet + teshis (tablo ayri dataset'te)
        "baz": {},           # baz dataset adi + doldurma karari
        "plan": [],          # geleneksel donusum plani
        "hipotez": [],       # serbest kesif ifadeleri
        "uretilen": [],
        "kod_bloklari": [],  # (baslik, [(ad, kod, gerekce)])
        "kalite": {}, "model": {},
    }


def durum_yukle(oturum_id):
    try:
        with _folder().get_download_stream(_yol(oturum_id)) as s:
            return json.loads(s.read().decode("utf-8"))
    except Exception:
        return yeni_durum()


def durum_kaydet(oturum_id, durum):
    veri = json.dumps(durum, ensure_ascii=False, indent=2).encode("utf-8")
    _folder().upload_stream(_yol(oturum_id), veri)


