def mod_girdi(durum, mesaj):
    m = MOD_KALIP.search(mesaj or "")
    if not m:
        # Geri donuldugunde eski secim silinsin; faz agaci sifirlanir.
        durum["mod"] = None
        durum["_secenekler"] = MOD_SECENEKLERI
        return False, "Nereden başlayalım?"

    secim = m.group(2).upper()
    durum["mod"] = {"1": "A", "2": "B", "3": "C"}.get(secim, secim)
    durum["_secenekler"] = []
    return True, None


def mod_uygula(durum):
    mod = durum["mod"]
    if mod == "A":
        return ("Veri seti ve değişken sözlüğü hazır. Modelleme tanımlarına "
                "ve veri analizine geçiyoruz.")
    if mod == "B":
        return ("Hazır veri setiyle başlıyoruz.\n\n"
                "Her kolonun tipi, dağılımı ve örnek değerleri incelenerek "
                "değişken sözlüğü oluşturulacak ve %s veri setine "
                "kaydedilecek." % SOZLUK_ADI)
    return ("Kaynak tablolardan başlıyoruz.\n\n"
            "Sırasıyla kaynak tabloları seçeceğiz, birleştirme planını "
