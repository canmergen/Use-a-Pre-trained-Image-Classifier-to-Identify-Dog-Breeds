:root {
  --kirmizi:      #E4002B;
  --kirmizi-koyu: #B00020;
  --kirmizi-acik: #FEF0F2;
  --zemin:        #F7F8FA;
  --kenar:        #E4E7EC;
  --kenar-acik:   #F0F1F4;
  --metin:        #101828;
  --gri:          #667085;
  --gri-acik:     #98A2B3;
  --yesil:        #12B76A;

  --panel-en:  clamp(230px, 17vw, 290px);
  --sohbet-en: clamp(520px, 52vw, 760px);
  --yazi:      11.2px;          /* sabit: %80 zoom karsiligi */
  --avatar:    28px;
  --ustbar-h:  86px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
}

/* ==================== ÜST BAR (her sayfada sabit) ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: #fff; border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}

#ustbar-sol { display: flex; align-items: center; gap: 15px; flex-shrink: 0; }
#banner { height: 28px; width: auto; display: block; }
#baslik-blok {
  border-left: 1px solid var(--kenar); padding-left: 15px; line-height: 1.35;
}
#urun-adi {
  font-weight: 600; font-size: 1.28em; letter-spacing: -.01em; white-space: nowrap;
}
#urun-alt {
  font-size: .9em; color: var(--gri-acik); margin-top: 2px; white-space: nowrap;
}

/* -------- Özet şerit: logo ile sağ blok arasındaki tüm alan -------- */
#ozet-serit {
  flex: 1; min-width: 0;
  display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0;
  padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: .78em; font-weight: 600; letter-spacing: .08em;
  color: var(--gri-acik); text-transform: uppercase; margin-bottom: 3px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.05em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--gri-acik); font-weight: 400; }
/* Üst satır: başlangıç durumu — Alt satır: güncel durum */
.ozet-ust {
  display: block; font-size: .84em; color: var(--gri); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-alt {
  display: block; font-size: .84em; color: var(--gri-acik); margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* -------- Sağ blok: iki satır, ortalanmış -------- */
#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center;
  gap: 7px; flex-shrink: 0;
}

.ustbar-sag-satir {
  display: flex; align-items: center; justify-content: center; gap: 9px;
}

/* Restart ikonu — tooltip HTML'deki title attribute'undan gelir */
#sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; padding: 0;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 6px; cursor: pointer; color: var(--gri);
  flex-shrink: 0;
}
#sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi);
  background: var(--kirmizi-acik);
}

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: .9em; color: var(--gri); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

/* Sekmeler — iki düğme eşit genişlikte, aktif olan dolu kırmızı */
#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 8px;
}
.sekme {
  flex: 1;
  font-size: .92em; font-weight: 500; padding: 6px 18px;
  border: none; background: none; border-radius: 6px;
  cursor: pointer; color: var(--gri); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: #fff; color: var(--metin); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff; font-weight: 600;
  box-shadow: 0 1px 3px rgba(228,0,43,.30);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }

/* ==================== SAYFA 1: ÇALIŞMA ==================== */
#sayfa-calisma { display: flex; background: #fff; }

#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: #FCFCFD; border-right: 1px solid var(--kenar);
  padding: 20px 18px 34px; overflow-y: auto;
}
.panel-blok { margin-bottom: 26px; }
.panel-blok:last-child { margin-bottom: 0; }

.panel-baslik {
  display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
  font-size: .8em; font-weight: 700; letter-spacing: .09em;
  color: var(--gri-acik); margin-bottom: 11px;
}
.panel-ipucu {
  font-size: .9em; font-weight: 400; letter-spacing: 0;
  text-transform: none; color: var(--gri-acik); opacity: .75;
}

.panel-metin {
  margin: 0 0 10px; font-size: .92em; line-height: 1.62; color: var(--gri);
}
.panel-metin:last-child { margin-bottom: 0; }
.panel-metin b { color: var(--metin); font-weight: 600; }

/* -------- Stepper -------- */
#adim-listesi { list-style: none; margin: 0; padding: 0; }
#adim-listesi li {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 8px 9px; border-radius: 6px; margin-bottom: 1px;
  color: var(--gri-acik); cursor: pointer;
}
#adim-listesi li:hover { background: var(--kenar-acik); }
#adim-listesi li.aktif:hover { background: var(--kirmizi-acik); }

.adim-isaret {
  flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px;
  border: 1.5px solid currentColor; border-radius: 50%;
  font-size: .68em; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  font-variant-numeric: tabular-nums;
}
#adim-listesi li.tamam { color: var(--gri); }
#adim-listesi li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff; font-size: .76em;
}
#adim-listesi li.aktif { background: var(--kirmizi-acik); color: var(--kirmizi); }
#adim-listesi li.aktif .adim-isaret {
  background: var(--kirmizi); border-color: var(--kirmizi); color: #fff;
}

.adim-govde { min-width: 0; flex: 1; }
.adim-ad { font-size: .98em; font-weight: 500; line-height: 1.35; }
#adim-listesi li.aktif .adim-ad { font-weight: 600; }

/* Açıklama SADECE tıklanan adımda görünür */
.adim-aciklama {
  display: none;
  font-size: .88em; line-height: 1.52; margin-top: 5px; opacity: .88;
}
#adim-listesi li.acik .adim-aciklama { display: block; }

/* -------- Komutlar -------- */
.panel-not {
  display: grid; grid-template-columns: auto 1fr;
  gap: 8px 11px; align-items: center; font-size: .92em; color: var(--gri);
}
.panel-not b {
  font-family: ui-monospace, Consolas, monospace;
  font-size: .9em; color: var(--metin);
  background: var(--zemin); border: 1px solid var(--kenar);
  padding: 3px 8px; border-radius: 4px; text-align: center;
}

/* -------- Sohbet -------- */
#sohbet-alani { flex: 1; display: flex; flex-direction: column; min-width: 0; }
#sohbet { flex: 1; overflow-y: auto; padding: 22px clamp(16px, 2vw, 32px) 10px; }

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 auto 17px; max-width: var(--sohbet-en);
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid var(--kenar);
}

.balon {
  padding: 11px 14px; border-radius: 10px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 80%;
}
/* Bot çıktıları boşluklarla hizalı -> monospace şart */
.satir.bot .balon {
  background: #fff; border: 1px solid var(--kenar);
  border-top-left-radius: 2px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .92em;
}
.satir.kullanici .balon {
  background: var(--kirmizi); color: #fff;
  border-top-right-radius: 2px; font-size: 1em;
}
.satir.bot .balon.hata {
  background: #FFFBFA; border-color: #FDA29B; color: #B42318;
}

/* -------- Veri seçim kartı -------- */
#secici-kart {
  max-width: var(--sohbet-en); margin: 0 auto 18px;
  background: #fff; border: 1px solid var(--kenar);
  border-radius: 10px; padding: 17px 19px 19px;
  box-shadow: 0 1px 3px rgba(16,24,40,.05);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 600; font-size: 1.05em; margin-bottom: 4px; }
.kart-alt { font-size: .9em; color: var(--gri); line-height: 1.55; margin-bottom: 15px; }

.kart-govde { display: flex; gap: 11px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 170px; }
.combo label {
  display: block; font-size: .85em; color: var(--gri);
  margin-bottom: 5px; font-weight: 500;
}
.combo-giris {
  width: 100%; padding: 8px 10px;
  border: 1px solid var(--kenar); border-radius: 7px;
  font-family: ui-monospace, Consolas, monospace;
  font-size: .92em; outline: none; background: #fff;
}
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
.combo-giris.secili { border-color: var(--yesil); }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 4px; list-style: none;
  background: #fff; border: 1px solid var(--kenar); border-radius: 7px;
  box-shadow: 0 8px 20px rgba(16,24,40,.12);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 6px 9px; border-radius: 5px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .9em;
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { color: var(--gri-acik); cursor: default; font-family: inherit; }
.combo-liste li.bos:hover { background: none; color: var(--gri-acik); }

#secici-btn {
  padding: 8px 20px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 7px; font-size: .95em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--gri-acik); cursor: not-allowed; }

/* -------- Yazıyor animasyonu -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: var(--gri-acik); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* -------- Giriş -------- */
#giris-bolge {
  border-top: 1px solid var(--kenar); background: #fff;
  padding: 11px clamp(16px, 2vw, 32px) 15px; flex-shrink: 0;
}
#hizli-aksiyon { max-width: var(--sohbet-en); margin: 0 auto 8px; display: flex; gap: 7px; }
.chip {
  font-family: ui-monospace, Consolas, monospace; font-size: .9em;
  padding: 5px 13px; border: 1px solid var(--kenar);
  background: var(--zemin); border-radius: 14px; cursor: pointer; color: var(--gri);
}
.chip:hover:not(:disabled) {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
.chip:disabled { opacity: .45; cursor: not-allowed; }

#giris {
  max-width: var(--sohbet-en); margin: 0 auto;
  display: flex; gap: 8px; align-items: flex-end;
}
#kutu {
  flex: 1; padding: 9px 12px; border: 1px solid var(--kenar);
  border-radius: 8px; font-family: inherit; font-size: 1em;
  line-height: 1.5; resize: none; outline: none; max-height: 120px; overflow-y: auto;
}
#kutu:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
#gonder {
  padding: 9px 24px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 8px; font-size: 1em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#gonder:disabled { opacity: .45; cursor: not-allowed; }

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }

#ozet-govde {
  max-width: 1280px; margin: 0 auto;
  padding: 28px clamp(18px, 2.4vw, 44px) 56px;
}

#ozet-baslik-blok { margin-bottom: 22px; }
#ozet-h1 { margin: 0; font-size: 1.7em; font-weight: 600; letter-spacing: -.01em; }
#ozet-adim { font-size: .95em; color: var(--gri); margin-top: 5px; }

/* Bölümler kart ızgarasında — geniş ekranda yan yana */
#ozet-kartlar {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 16px;
  align-items: start;
}

.ozet-blok {
  background: #fff; border: 1px solid var(--kenar); border-radius: 10px;
  padding: 16px 18px 14px;
  box-shadow: 0 1px 2px rgba(16,24,40,.04);
}
.ozet-blok-baslik {
  font-size: .8em; font-weight: 700; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 11px;
  padding-bottom: 8px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 5px 0; font-size: .95em; align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--gri); flex-shrink: 0; }
.ozet-satir-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--metin); text-align: right; font-weight: 500;
  word-break: break-word; min-width: 0;
}

#ozet-bos {
  background: #fff; border: 1px dashed var(--kenar); border-radius: 10px;
  padding: 40px; text-align: center; color: var(--gri-acik); font-size: 1em;
  grid-column: 1 / -1;
}

/* -------- Dar ekran -------- */
@media (max-width: 1280px) {
  #baslik-blok { display: none; }
}
@media (max-width: 1080px) {
  #panel { display: none; }
  #ozet-serit { display: none; }
}
