def _json_dene(metin):
    try:
        cozulen = json.loads(metin)
    except (ValueError, TypeError):
        return None
    return cozulen if isinstance(cozulen, dict) else None


def _json_ayristir(ham):
    """LLM ciktisini dict'e cevirir; bilinen bozukluklari sirayla onarir."""
    if isinstance(ham, dict):
        return ham

    metin = str(ham or "").strip()
    if not metin:
        return {}

    if metin.startswith("```"):
        metin = metin.strip("`").strip()
        if metin.lower().startswith("json"):
            metin = metin[4:].strip()

    adaylar = [metin]
    if "{{" in metin or "}}" in metin:
        adaylar.append(metin.replace("{{", "{").replace("}}", "}"))

    bas = metin.find("{")
    son = metin.rfind("}")
    if bas != -1 and son > bas:
        gomulu = metin[bas:son + 1]
        adaylar.append(gomulu)
        if "{{" in gomulu or "}}" in gomulu:
            adaylar.append(gomulu.replace("{{", "{").replace("}}", "}"))

    for aday in list(adaylar):
        fark = aday.count("{") - aday.count("}")
        if fark > 0:
            adaylar.append(aday + ("}" * fark))
        elif fark < 0:
            adaylar.append(aday[:fark])

    for sira, aday in enumerate(adaylar):
        cozulen = _json_dene(aday)
        if cozulen is not None:
            if sira > 0:
                _logla("JSON {}. onarim denemesinde cozuldu".format(sira))
            return cozulen

    _logla("girdi JSON'a cevrilemedi: {!r}".format(metin[:300]))
    return {}


def _json_oku(dosya_yolu, varsayilan):
    """Managed folder icindeki bir JSON dosyasini okur."""
    try:
        folder = dataiku.Folder(Folder.HAFIZA)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _hafizayi_oku():
    veri = _json_oku(Folder.SEMA_DOSYASI, None)
    return veri if isinstance(veri, dict) else None


def _ek_sozlugu_oku():
    veri = _json_oku(Folder.EK_SOZLUK_DOSYASI, {})
    return veri if isinstance(veri, dict) else {}


def _proje_dataset_adlari():
    try:
        proje = dataiku.api_client().get_default_project()
        return {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        return None


def _dataset_gecerli_mi(ad):
    if not ad:
        return False
    temiz = str(ad).strip()
    if temiz.lower() in GECERSIZ_DATASET_ADLARI:
        return False
    mevcut = _proje_dataset_adlari()
    if mevcut is None:
        return True
    return temiz in mevcut


def _mesajdaki_dataset_adi(mesaj, mevcut_adlar):
    """Kullanicinin mesajinda gecen dataset adini bulur.

    Bu bir anlam cozumlemesi degil, birebir metin eslemesidir: projede
    var olan dataset adlari mesajin icinde araniyor. LLM'e dataset adi
    cikartmak birakildiginda dosya adlarini dataset saniyordu.
    """
    if not mesaj or not mevcut_adlar:
        return None
    buyuk_mesaj = str(mesaj).upper()
    adaylar = [ad for ad in mevcut_adlar if ad.upper() in buyuk_mesaj]
    if not adaylar:
        return None
    # En uzun eslesme en spesifik olanidir.
    return max(adaylar, key=len)


def _mesajdaki_kolonlar(mesaj, kolon_listesi):
    """Kullanicinin mesajinda gecen kolon adlarini bulur.

    Birebir metin eslemesi; LLM sinifi degil. Asistanin sorulan kolonun
    mevcut aciklamasini gorebilmesi icin kullanilir.
    """
    if not mesaj or not kolon_listesi:
        return []
    buyuk_mesaj = str(mesaj).upper()
    bulunanlar = [k for k in kolon_listesi if k.upper() in buyuk_mesaj]
    bulunanlar.sort(key=len, reverse=True)
    return bulunanlar[:AZAMI_MESAJ_KOLONU]


