GERI_KALIP = re.compile(r"\b(geri|onceki adim|bir onceki|geri don\w*)\b")
SECIM_KALIP = re.compile(r"\d+")

KARSILAMA = """Analitik Modelleme Platformu

Veri setinizi ve değişken sözlüğünüzü tek bir çalışma akışında analiz ederek \
