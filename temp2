"""Kullanıcı mesajının deterministik ayrıştırılması.

İlk kelime tanımlı bir komutsa Komut nesnesi döner; aksi halde None
(mesaj sohbet asistanına gider). LLM bu katmanda yer almaz.
"""
from dataclasses import dataclass, field
from typing import List, Optional

_TR = str.maketrans("çğıöşüÇĞİÖŞÜ", "cgiosuCGIOSU")

# ad → (kullanım, açıklama)
KOMUTLAR = {
    "veri":   ("veri <DATASET>",                                  "Ana veri setini tanımlar"),
    "sozluk": ("sozluk <DATASET> <ad_kolonu> <aciklama_kolonu>",  "Sözlük veri setini tanımlar"),
    "cikar":  ("cikar <KOLON> [KOLON ...]",                        "Kolonları kapsam dışı bırakır"),
    "dahil":  ("dahil <KOLON> [KOLON ...]",                        "Kapsam dışı kolonu geri alır"),
    "durum":  ("durum",                                            "Mevcut aşama ve tanımlı girdiler"),
    "onay":   ("onay",                                             "Aşamayı çalıştırır / sonucu onaylar"),
    "ret":    ("ret",                                              "Aşama sonucunu reddeder"),
    "geri":   ("geri",                                             "Önceki aşamaya döner"),
    "gec":    ("gec",                                              "Aşamayı atlar (zorunlu aşamalar hariç)"),
    "yardim": ("yardim",                                           "Komut listesini gösterir"),
}


@dataclass
class Komut:
    ad: str
    args: List[str] = field(default_factory=list)

    @property
    def kullanim(self) -> str:
        return KOMUTLAR[self.ad][0]


def normalize(kelime: str) -> str:
    return kelime.translate(_TR).lower()


def ayristir(mesaj: str) -> Optional[Komut]:
    parcalar = mesaj.strip().split()
    if not parcalar:
        return None
    ad = normalize(parcalar[0])
    return Komut(ad, parcalar[1:]) if ad in KOMUTLAR else None


# ---- mesaj çıkarma ----
def _alan(m, ad):
    """dict veya nesne fark etmeksizin alan okur."""
    if isinstance(m, dict):
        return m.get(ad)
    return getattr(m, ad, None)


def _icerik(c) -> str:
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(
            (_alan(p, "text") or "") for p in c if _alan(p, "text")
        )
    return ""


def _son_kullanici(mesajlar) -> str:
    if not isinstance(mesajlar, (list, tuple)):
        return ""
    for m in reversed(mesajlar):
        if _alan(m, "role") == "user":
            return _icerik(_alan(m, "content"))
    return ""


def kullanici_mesaji(ortam: dict) -> str:
    """Python bloğunun global alanından kullanıcının son mesajını çıkarır.

    Dataiku structured agent Python bloğu mesajları `initial_messages`
    (bu turun girdisi) ve `all_messages` (girdi + üretilenler) olarak verir.
    """
    for ad in ("initial_messages", "all_messages"):
        m = _son_kullanici(ortam.get(ad))
        if m:
            return m
    lo = ortam.get("last_output")
    return lo if isinstance(lo, str) else ""
