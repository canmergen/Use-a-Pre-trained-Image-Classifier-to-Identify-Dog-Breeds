HAFIZA_FOLDER = "PROJE_HAFIZASI"
MODEL_SENARYO = "MODEL_COMPARISON"
OKUMA_LIMITI = 10000

ADIM_SIRASI = ["kurulum", "meta", "analiz", "baz",
               "gelenekse", "kesif", "kalite", "model"]

GERI_KALIP = re.compile(r"\b(geri|onceki adim|bir onceki|geri don\w*)\b")
SECIM_KALIP = re.compile(r"\d+")

KARSILAMA = """Değişken Keşif Asistanı

Modelleme veri setinizden yeni ve anlamlı değişkenler keşfetmek için veri \
yapısını, değişken sözlüğünü ve hedef değişkeni birlikte analiz ederim.

Mevcut değişkenlerin tek başına ayırt etme gücünü ölçer (IV, C-value, PSI), \
sorunlu kolonları raporlar, geleneksel dönüşümleri ve yeni değişken \
hipotezlerini üretir, kalite kontrolünden geçirir ve model katkısını ölçerim.

Ürettiğim her değişkenin Python kodunu da yazarım; dilediğiniz zaman \
inceleyip kendiniz çalıştırabilirsiniz.

Başlamak için veri seti ve değişken sözlüğünü seçin."""


# ===========================================================================
