def _dataset_hazirla(ad):
    """Dataset projede yoksa managed dataset olarak olusturur.

    Kurulum adimini kullaniciya birakmamak icin; dataset yoksa write_with_schema
    "dataset does not exist" hatasi veriyor ve kayit sessizce kayboluyor.
    Doner: (hazir_mi, aciklama)
    """
    try:
        proje = dataiku.api_client().get_default_project()
        mevcut = {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        # Listeyi goremiyoruz; yazmayi yine de deneyelim.
        return True, ""

    if ad in mevcut:
        return True, ""

    _logla("{} bulunamadi, olusturuluyor".format(ad))
    try:
        olusturucu = proje.new_managed_dataset(ad)
        olusturucu.with_store_into("filesystem_managed")
        olusturucu.create()
        _logla("{} olusturuldu".format(ad))
        return True, ""
    except Exception as hata:
        _logla("{} olusturulamadi: {}".format(ad, hata))
        return False, str(hata)


def _guncel_sozlugu_yaz(ek_sozluk):
    """Kaynak sozluk + eklenenleri, haric kolonlari duserek yazar.

    Dataset yoksa once olusturulur.
    Doner: (basarili_mi, toplam_satir)
    """
    hazir, hata_metni = _dataset_hazirla(GUNCEL_SOZLUK_DATASET)
    if not hazir:
        _logla("{} hazirlanamadi: {}".format(GUNCEL_SOZLUK_DATASET, hata_metni))
        return False, 0

    sema = _json_oku(SEMA_DOSYASI, {})
    sozluk = sema.get(Sema.SOZLUK) if isinstance(sema, dict) else {}
    sozluk = sozluk if isinstance(sozluk, dict) else {}

    haric = sema.get(Sema.HARIC_KOLONLAR) if isinstance(sema, dict) else []
    haric = set(haric) if isinstance(haric, list) else set()

    birlesik = dict(sozluk)
    birlesik.update(ek_sozluk)
    adlar = sorted(k for k in birlesik if k not in haric)

    df = pd.DataFrame({
        AD_KOLONU: adlar,
        ACIKLAMA_KOLONU: [birlesik[ad] for ad in adlar],
        "kaynak": ["eklenen" if ad in ek_sozluk else "sozluk" for ad in adlar],
    })

    try:
        dataiku.Dataset(GUNCEL_SOZLUK_DATASET).write_with_schema(df)
        _logla("{} yazildi: {} satir".format(GUNCEL_SOZLUK_DATASET, len(df)))
        return True, len(df)
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(GUNCEL_SOZLUK_DATASET, hata))
        return False, len(df)
