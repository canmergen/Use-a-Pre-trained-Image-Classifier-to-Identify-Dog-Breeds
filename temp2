@app.route("/adimlar")
def adimlar():
    """Sol paneldeki is akisi listesi. Adim adlari akis.py'den geliyor,
    tek kaynak orasi kalsin diye burada sabit liste tutmuyoruz."""
    return jsonify({
        "adimlar": [{"anahtar": a, "baslik": akis.ADIMLAR[a]["baslik"]}
                    for a in akis.ADIM_SIRASI]
    })












