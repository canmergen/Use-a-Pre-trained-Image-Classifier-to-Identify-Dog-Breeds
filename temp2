    if not plan:
        return ("Sözlüğü inceledim ama kullanılabilir bir plan çıkaramadım — "
                "model ya bozuk bir yanıt döndü ya da tanımadığı kolon adları "
                "önerdi.\n\n"
                "\"geri\" deyip önceki adıma dönebilir, ya da \"onay\" deyip "
                "bu adımı boş geçebiliriz.")

    kirilim = {}
    for p in plan:
        kirilim[p["donusum"]] = kirilim.get(p["donusum"], 0) + 1
    ozet_satir = " · ".join("%s %s" % (v, k) for k, v in sorted(kirilim.items()))

    satirlar = []
    for p in plan:
