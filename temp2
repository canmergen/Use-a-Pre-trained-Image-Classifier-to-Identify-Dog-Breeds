def kurulum_girdi(durum, mesaj):
    a = niyet_kural.alanlari_cikar(mesaj)
    veri = a.get("veri_seti") or durum.get("veri_seti")
    sozluk = a.get("sozluk") or durum.get("sozluk")

    eksik = ([] if veri else ["veri setinin adı"]) + ([] if sozluk else ["sözlüğün adı"])
    if eksik:
        return False, ("Devam edebilmem için %s gerekiyor.\n\n"
                       "Yukarıdaki listeden seçebilir ya da şöyle yazabilirsiniz:\n"
                       "    veri seti HAVALE_EFT_NTT ve sözlük DEGISKENLER"
                       % " ve ".join(eksik))
    for ad in (veri, sozluk):
        if not _dataset_var_mi(ad):
            return False, "Projede '%s' adında bir veri seti bulamadım." % ad

    durum["veri_seti"], durum["sozluk"] = veri, sozluk
    return True, None


def kurulum_plan(durum):
    df = _df_oku(durum["veri_seti"])
    sz = _df_oku(durum["sozluk"])
    sozluk_ad = set(sz[sz.columns[0]].astype(str))

    aciklamasiz = [c for c in df.columns if c not in sozluk_ad]
    eslesen = df.shape[1] - len(aciklamasiz)

    p = durum.get("profil") or {}
    p.update({
        "satir": int(df.shape[0]),
        "kolon": int(df.shape[1]),
        "kolon_baslangic": int(df.shape[1]),
        "sayisal": int(df.select_dtypes(include=[np.number]).shape[1]),
        "sozluk_satir": int(sz.shape[0]),
        "eslesen": eslesen,
        "kapsam": round(100.0 * eslesen / max(df.shape[1], 1), 1),
    })
    durum["profil"] = p
    durum["_aciklamasiz"] = aciklamasiz

    return ("Veri seti : %s\n"
            "            %s satır × %s kolon  (%s sayısal, %s kategorik)\n"
            "Sözlük    : %s  —  %s tanım\n\n"
            "Kolonların %s tanesinin sözlükte açıklaması var (%%%s kapsam).\n\n%s\n\n"
            "Açıklaması olmayan kolonları kapsam dışında tutacağım.\n\nDevam edelim mi?"
            % (durum["veri_seti"], _sayi(p["satir"]), _sayi(p["kolon"]),
               _sayi(p["sayisal"]), _sayi(p["kolon"] - p["sayisal"]),
               durum["sozluk"], _sayi(p["sozluk_satir"]),
               _sayi(eslesen), _ond(p["kapsam"]),
               _liste("Sözlükte karşılığı olmayanlar:", aciklamasiz)))


def kurulum_uygula(durum):
    durum["haric_kolonlar"] = sorted(set(durum.get("_aciklamasiz") or []))
    return "Veri ve sözlük bağlandı. %s kolon kapsam dışı." % _sayi(len(durum["haric_kolonlar"]))


