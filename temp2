def ham_veri_girdi(durum, mesaj):
    ham = re.sub(r"^\s*tablolar\s*[:=]\s*", "", (mesaj or "").strip(), flags=re.I)
    adaylar = [a.strip() for a in re.split(r"[,\n;]+", ham) if a.strip()]
    adaylar = [a for a in adaylar if re.match(r"^[A-Za-z0-9_.]+$", a)]

    if len(adaylar) < 2:
        durum["_secim_alani"] = {
            "tip": "liste",
            "baslik": "Birleştirilecek tablolar",
            "aciklama": "En az iki tablo seçin. İlk seçtiğiniz tablo iskelet "
                        "olmak zorunda değil; hangisinin iskelet olacağını "
                        "şemalara bakıp ben öneririm.",
            "etiket": "Tablo ara",
            "buton": "Tabloları onayla",
            "min": 2,
            "sablon": "tablolar: {liste}",
        }
        return False, "Hangi tabloları birleştirelim?"

    eksik = [a for a in adaylar if not _dataset_var_mi(a)]
    if eksik:
        return False, ("Erişemediğim tablolar: %s\n\n"
                       "Adlarını kontrol eder misiniz?" % ", ".join(eksik))

    durum["ham_tablolar"] = adaylar
    durum["_secim_alani"] = None
    return True, None













def veri_sec_girdi(durum, mesaj):
    a = niyet_kural.alanlari_cikar(mesaj)
    veri = a.get("veri_seti") or durum.get("veri_seti")
    if not veri:
        durum["_secim_alani"] = {
            "tip": "form",
            "baslik": "Modelleme tablosu",
            "aciklama": "Sözlüğünü üreteceğim tabloyu seçin.",
            "buton": "Devam et",
            "alanlar": [{"ad": "veri_seti", "etiket": "Modelleme tablosu"}],
            "sablon": "veri seti {veri_seti}",
        }
        return False, "Hangi tabloyla çalışalım?"

    if not _dataset_var_mi(veri):
        return False, "'%s' adında bir tabloya erişemiyorum." % veri

    durum["veri_seti"] = veri
    durum["_secim_alani"] = None
    return True, None










