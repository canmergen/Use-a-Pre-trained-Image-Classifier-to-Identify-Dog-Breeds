def stabilite_plan(durum):
    b = durum.get("bolme") or {}
    if b.get("tur") != "zamansal":
        return ("Bölme rastgele olduğu için PSI anlamlı hesaplanamaz — "
                "popülasyon kayması zamansal bir ölçüdür.\n\n"
                "Bu adımı geçmek için \"onay\", zamansal bölmeye dönmek için "
                "\"geri\" diyebilirsiniz.")
    return ("Değişkenlerin zaman içinde kayıp kaymadığını ölçeceğim.\n\n"
            "  • PSI — popülasyon stabilite indeksi (eşik < %s)\n"
            "  • Geliştirme dağılımı referans alınır, OOT ile karşılaştırılır\n\n"
            "PSI, IV ve C-value'dan farklı bir şey ölçer: hedefle ilişki değil, "
            "değişkenin kendi dağılımının kararlılığı. Yüksek PSI'lı bir "
            "değişken bugün iyi ayırsa da yarın güvenilmez olabilir.\n\n"
            "Çalıştırayım mı?" % _ond(sfa_mod.PSI_ESIK, 2))


def stabilite_uygula(durum):
    b = durum.get("bolme") or {}
    if b.get("tur") != "zamansal":
        durum["stabilite"] = {"atlandi": True}
        return "Stabilite analizi atlandı (zamansal bölme yok)."

    df = _df_oku(durum["veri_seti"])
    tr, te = maskeler(durum, df)
    adaylar = (durum.get("profil", {}).get("profil_teshis") or {}).get("temiz") or []

    tablo, ozet = sfa_mod.stabilite_calistir(df, adaylar, tr, te)
    if tablo is None:
        durum["stabilite"] = {"atlandi": True}
        return "Stabilite analizi yapılamadı."

    yazildi, yedek = _yaz("%s_PSI" % durum["veri_seti"], tablo, "/stabilite.csv")
    ozet["tablo_dataset"] = yazildi
    durum["stabilite"] = ozet

    satirlar = ["  %-34s PSI %s" % (c[:34], _ond(v, 3)) for c, v in ozet["en_kotu"]]
    return ("Stabilite analizi tamamlandı. %s değişken ölçüldü, %s tanesi "
            "stabil.\n\nEN ÇOK KAYAN 10\n%s\n\n"
            "Kayma gösteren %s değişken analitik baz sette düşürülecek.\n"
            "Tam tablo %s."
            % (_sayi(ozet["olculen"]), _sayi(ozet["stabil"]),
               "\n".join(satirlar) or "  (yok)", _sayi(len(ozet["kayan"])),
               ("%s veri setine yazıldı" % yazildi) if yazildi
               else "PROJE_HAFIZASI%s dosyasına yazıldı" % yedek))


