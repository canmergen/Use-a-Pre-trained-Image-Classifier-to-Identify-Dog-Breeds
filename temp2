def ozet(durum):
    """Ust seritteki 4 kart. Her kart: baslangic durumu -> guncel durum.
    Veri OKUMAZ; durum['profil'] icindeki hesaplanmis degerleri bicimlendirir."""
    m, p = durum.get("meta") or {}, durum.get("profil") or {}
    s, k = durum.get("sfa") or {}, durum.get("kalite") or {}
    sc, md = durum.get("secim") or {}, durum.get("model") or {}
    bz = durum.get("baz") or {}
    bos = "—"

    # ---------- 1) VERI SETI: ham -> baz ----------
    if not p.get("kolon"):
        veri = {"deger": bos, "ust": "seçilmedi", "alt": ""}
    else:
        ham = "%s satır × %s kolon" % (_sayi(p["satir"]), _sayi(p["kolon_baslangic"]))
        if bz.get("kolon"):
            dusen = p["kolon_baslangic"] - bz["kolon"]
            alt = "baz: %s kolon  (−%s)" % (_sayi(bz["kolon"]), _sayi(dusen))
        else:
            alt = "baz seti henüz kurulmadı"
        veri = {"deger": durum["veri_seti"], "ust": ham, "alt": alt}

    # ---------- 2) SOZLUK: tanim sayisi -> SFA sonucu ----------
    if not durum.get("sozluk"):
        sozluk = {"deger": bos, "ust": "seçilmedi", "alt": ""}
    else:
        ust = "%s tanım · %%%s kapsam" % (_sayi(p.get("sozluk_satir", 0)),
                                         _ond(p.get("kapsam", 0)))
        if s.get("pass_adet") is not None:
            alt = "SFA: %s / %s PASS" % (_sayi(s["pass_adet"]),
                                         _sayi(s.get("analiz_edilen", 0)))
        else:
            alt = "SFA henüz çalışmadı"
        sozluk = {"deger": durum["sozluk"], "ust": ust, "alt": alt}

    # ---------- 3) HEDEF: sabit kalir, model sonucu eklenir ----------
    if not m.get("target"):
        hedef = {"deger": bos, "ust": "tanımlanmadı", "alt": ""}
    else:
        d = (md.get("delta") or {}).get("auc")
        hedef = {"deger": m["target"],
                 "ust": p.get("hedef_ozet") or "",
                 "alt": ("Δ AUC %s" % _ond(d, 4)) if d is not None
                        else "model karşılaştırması bekliyor"}

    # ---------- 4) DEGISKEN SETI: uretildi -> elendi -> secildi ----------
    uretilen = len(durum.get("uretilen") or [])
    if not uretilen:
        degisken = {"deger": bos, "ust": "henüz üretilmedi", "alt": ""}
    else:
        gecen = len(k.get("gecti") or []) if k else None
        secilen = sc.get("secilen")
        ust = "%s üretildi" % _sayi(uretilen)
        if gecen is not None:
            ust += "  →  %s kalite" % _sayi(gecen)
        if secilen is not None:
            ust += "  →  %s seçildi" % _sayi(secilen)
            son = (bz.get("kolon") or p.get("kolon_baslangic", 0)) + secilen
            alt = "%s kolon → %s kolon" % (_sayi(bz.get("kolon") or 0), _sayi(son))
        elif gecen is not None:
            alt = "%s elendi (kalite)" % _sayi(uretilen - gecen)
        else:
            alt = "kalite kontrolü bekliyor"
        degisken = {"deger": "%s → %s" % (
            _sayi(bz.get("kolon") or p.get("kolon_baslangic", 0)),
            _sayi((bz.get("kolon") or p.get("kolon_baslangic", 0)) +
                  (secilen if secilen is not None else uretilen))),
            "ust": ust, "alt": alt}

    return {"kartlar": [
        {"etiket": "Veri seti", **veri},
        {"etiket": "Sözlük", **sozluk},
        {"etiket": "Hedef", **hedef},
        {"etiket": "Değişken seti", **degisken},
    ]}
















# ===========================================================================
# OZET PANELI — yandan acilan detay gorunumu
# ===========================================================================
def _bolum(baslik, satirlar):
    return {"baslik": baslik, "satirlar": [s for s in satirlar if s]}


def detay(durum):
    """Sag panelde gosterilecek tam ozet. Her bolum: baslik + (etiket, deger)."""
    m, p = durum.get("meta") or {}, durum.get("profil") or {}
    s, k = durum.get("sfa") or {}, durum.get("kalite") or {}
    sc, md = durum.get("secim") or {}, durum.get("model") or {}
    bz, kt = durum.get("baz") or {}, durum.get("kutuk") or {}
    t = s.get("teshis") or {}

    bolumler = []

    # --- Kaynak ---
    if p.get("kolon"):
        bolumler.append(_bolum("KAYNAK VERİ", [
            ("Veri seti", durum.get("veri_seti")),
            ("Satır", _sayi(p["satir"])),
            ("Kolon", _sayi(p["kolon_baslangic"])),
            ("Sayısal / kategorik", "%s / %s" % (
                _sayi(p.get("sayisal", 0)),
                _sayi(p["kolon_baslangic"] - p.get("sayisal", 0)))),
            ("Sözlük", durum.get("sozluk")),
            ("Sözlük tanımı", _sayi(p.get("sozluk_satir", 0))),
            ("Sözlük kapsamı", "%%%s  (%s / %s kolon)" % (
                _ond(p.get("kapsam", 0)), _sayi(p.get("eslesen", 0)),
                _sayi(p["kolon_baslangic"]))),
        ]))

    # --- Meta ---
    if m.get("target"):
        bolumler.append(_bolum("MODELLEME TANIMI", [
            ("Hedef", m.get("target")),
            ("Hedef tipi", p.get("hedef_ozet")),
            ("Kimlik kolonu", m.get("id")),
            ("Dönem kolonu", m.get("donem") or "belirtilmedi"),
            ("OOT dönemi", durum.get("_oot_deger") or "yok — rastgele bölme"),
        ]))

    # --- SFA ---
    if s.get("analiz_edilen") is not None:
        bolumler.append(_bolum("TEK DEĞİŞKENLİ ANALİZ (SFA)", [
            ("Analiz edilen", _sayi(s["analiz_edilen"])),
            ("PASS", "%s  (IV>%s, C>%s, PSI<%s)" % (
                _sayi(s.get("pass_adet", 0)), _ond(sfa_mod.IV_ESIK, 2),
                _ond(sfa_mod.C_ESIK, 2), _ond(sfa_mod.PSI_ESIK, 2))),
            ("FAIL", _sayi(s["analiz_edilen"] - s.get("pass_adet", 0))),
            ("Aşırı null", _sayi(len(t.get("cok_bos") or []))),
            ("Sabit", _sayi(len(t.get("sabit") or []))),
            ("Kimlik benzeri", _sayi(len(t.get("kimlik_gibi") or []))),
            ("Sızıntı şüpheli", _sayi(len(t.get("sizinti") or []))),
            ("Tablo", s.get("tablo_dataset") or "PROJE_HAFIZASI/sfa_tablosu.csv"),
        ]))

    # --- Baz set ---
    if bz.get("dataset"):
        dusen = p.get("kolon_baslangic", 0) - bz.get("kolon", 0)
        bolumler.append(_bolum("BAZ VERİ SETİ", [
            ("Dataset", bz["dataset"]),
            ("Kolon", "%s  →  %s  (−%s)" % (
                _sayi(p.get("kolon_baslangic", 0)), _sayi(bz["kolon"]), _sayi(dusen))),
            ("Doldurma", bz.get("doldurma")),
        ]))

    # --- Uretim ---
    uretilen = len(durum.get("uretilen") or [])
    if uretilen:
        blok = {b[0]: len(b[1]) for b in (durum.get("kod_bloklari") or [])}
        bolumler.append(_bolum("ÜRETİM", [
            ("Toplam üretilen", _sayi(uretilen)),
        ] + [(ad, _sayi(n)) for ad, n in blok.items()] + [
            ("Kod dosyası", "PROJE_HAFIZASI/uretim_kodu.py"),
        ]))

    # --- Kalite ---
    if k:
        elenen = uretilen - len(k.get("gecti") or [])
        bolumler.append(_bolum("KALİTE KONTROLÜ", [
            ("Geçen", _sayi(len(k.get("gecti") or []))),
            ("Elenen", _sayi(elenen)),
            ("  çok boş", _sayi(len(k.get("eksik") or []))),
            ("  tek değerli", _sayi(len(k.get("sabit") or []))),
            ("  sızıntı şüpheli", _sayi(len(k.get("sizinti") or []))),
        ]))

    # --- Secim ---
    if sc.get("secilen") is not None:
        bolumler.append(_bolum("DEĞİŞKEN SEÇİMİ", [
            ("Aday", _sayi(sc.get("aday", 0))),
            ("Seçilen", _sayi(sc["secilen"])),
            ("Elenen — yarı-sabit", _sayi(sc.get("yari_sabit", 0))),
            ("Elenen — korelasyon", _sayi(sc.get("korelasyon", 0))),
            ("Elenen — düşük önem", _sayi(sc.get("dusuk_onem", 0))),
            ("Önem yöntemi", sc.get("onem_yontemi")),
        ]))

    # --- Model ---
    if md and not md.get("hata"):
        b, e, d = md.get("baseline", {}), md.get("enhanced", {}), md.get("delta", {})
        bolumler.append(_bolum("MODEL KARŞILAŞTIRMASI", [
            ("Bölme", md.get("bolme")),
            ("Eğitim / test satır", "%s / %s" % (
                _sayi(md.get("egitim_satir", 0)), _sayi(md.get("test_satir", 0)))),
            ("Kolon", "%s  →  %s" % (
                _sayi(md.get("baz_kolon", 0)),
                _sayi(md.get("baz_kolon", 0) + md.get("yeni_kolon", 0)))),
            ("AUC", "%s  →  %s   (%s)" % (
                _ond(b.get("auc"), 4), _ond(e.get("auc"), 4), _ond(d.get("auc"), 4))),
            ("Gini", "%s  →  %s   (%s)" % (
                _ond(b.get("gini"), 4), _ond(e.get("gini"), 4), _ond(d.get("gini"), 4))),
            ("KS", "%s  →  %s   (%s)" % (
                _ond(b.get("ks"), 4), _ond(e.get("ks"), 4), _ond(d.get("ks"), 4))),
        ]))
    elif md.get("hata"):
        bolumler.append(_bolum("MODEL KARŞILAŞTIRMASI", [("Hata", md["hata"])]))

    # --- Kutuk ---
    if kt.get("satir"):
        bolumler.append(_bolum("DEĞİŞKEN KÜTÜĞÜ", [
            ("Kayıt", _sayi(kt["satir"])),
            ("Seçili", _sayi(kt.get("secilen", 0))),
            ("Dataset", kt.get("dataset") or "PROJE_HAFIZASI/degisken_kutugu.csv"),
        ]))

    if not bolumler:
        bolumler = [_bolum("DURUM", [("Bilgi", "Henüz bir adım tamamlanmadı.")])]

    return {"bolumler": bolumler,
            "adim": ADIMLAR[ADIM_SIRASI[durum["i"]]]["baslik"],
            "adim_no": durum["i"] + 1,
            "toplam": len(ADIM_SIRASI)}
