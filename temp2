def _logla(mesaj):
    print("[durum_belirle] {}".format(mesaj))


def _json_ayristir(ham):
    """girdi_al ciktisini dict'e cevirir.

    LLM JSON'u bazen ``` blogu icinde donduruyor; o durumu da temizler.
    Ayristirilamayan girdi icin bos dict doner.
    """
    if isinstance(ham, dict):
        return ham

    metin = str(ham or "").strip()
    if not metin:
        return {}

    if metin.startswith("```"):
        metin = metin.strip("`").strip()
        if metin.lower().startswith("json"):
            metin = metin[4:].strip()

    try:
        cozulen = json.loads(metin)
    except (ValueError, TypeError):
        _logla("girdi JSON olarak ayristirilamadi: {!r}".format(metin[:200]))
        return {}

    return cozulen if isinstance(cozulen, dict) else {}


def _hafizayi_oku():
    """PROJE_HAFIZASI/sema.json icerigini dondurur. Yoksa None."""
    try:
        folder = dataiku.Folder(Folder.HAFIZA)
        if Folder.SEMA_DOSYASI not in folder.list_paths_in_partition():
            _logla("hafiza dosyasi yok: {}".format(Folder.SEMA_DOSYASI))
            return None
        with folder.get_download_stream(Folder.SEMA_DOSYASI) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("hafiza okunamadi: {}".format(hata))
        return None


def _proje_dataset_adlari():
    """Projedeki dataset adlarini set olarak dondurur. Erisilemezse None."""
    try:
        proje = dataiku.api_client().get_default_project()
        return {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        return None


def _dataset_gecerli_mi(ad):
    """Verilen adin projede gercek bir dataset olup olmadigini soyler."""
    if not ad:
        return False

    temiz = str(ad).strip()
    if temiz.lower() in GECERSIZ_DATASET_ADLARI:
        return False

    mevcut = _proje_dataset_adlari()
    if mevcut is None:
        return True
    return temiz in mevcut


def _liste_yap(deger):
    """Tek deger veya liste gelebilen alani listeye cevirir."""
    if deger is None:
        return []
    if isinstance(deger, list):
        return deger
    return [deger]


def _girdiyi_state_e_isle(g):
    """girdi_al ciktisini dogrulayarak state'e yazar."""
    state[S.GECERSIZ_AD] = ""

    aday = g.get(G.VERI_SETI)
    if aday:
        if _dataset_gecerli_mi(aday):
            state[S.VERI_SETI] = str(aday).strip()
        else:
            state[S.GECERSIZ_AD] = str(aday).strip()
            _logla("gecersiz dataset adi reddedildi: {}".format(aday))

    for girdi_alan, state_alan in (
        (G.SOZLUK, S.SOZLUK),
        (G.TARGET, S.TARGET),
        (G.ID_KOLONU, S.ID_KOLONU),
        (G.DONEM_KOLONU, S.DONEM_KOLONU),
        (G.BOLME_KOLONU, S.BOLME_KOLONU),
    ):
        if g.get(girdi_alan) is not None:
            state[state_alan] = g[girdi_alan]

    # Tura ozel alanlar: her turda tazelenir, onceki turdan sizmaz.
    state[S.KOLON_ISLEMI] = g.get(G.KOLON_ISLEMI)
    state[S.KOLONLAR] = _liste_yap(g.get(G.KOLONLAR))
    state[S.KOLON_ACIKLAMASI] = g.get(G.KOLON_ACIKLAMASI)
    state[S.GORUS_ISTIYOR] = bool(g.get(G.GORUS_ISTIYOR))

    state[S.DATASET_VAR] = bool(state.get(S.VERI_SETI))
    state[S.SOZLUK_VAR] = bool(state.get(S.SOZLUK))


def _kolon_baglami(kolonlar):
    """Sorulan kolonlarin mevcut aciklamalarini sema.json'dan okur.

    sohbet blogu gorus verirken uydurmasin diye promptuna eklenir.
    """
    if not kolonlar:
        return ""

    kayit = _hafizayi_oku() or {}
    sozluk = kayit.get(Sema.SOZLUK) or {}
    tipler = kayit.get(Sema.TIPLER) or {}
    tablo = set(kayit.get(Sema.KOLONLAR) or [])

    parcalar = []
    for kolon in kolonlar[:3]:
        ad = str(kolon).strip()
        gercek = ad if ad in tablo or ad in sozluk else None
        if gercek is None:
            kucuk = {k.lower(): k for k in (set(sozluk) | tablo)}
            gercek = kucuk.get(ad.lower())
        if gercek is None:
            parcalar.append("{}: ne tabloda ne sozlukte var".format(ad))
            continue
        parcalar.append("{} (tip: {}): mevcut aciklama: {}".format(
            gercek,
            tipler.get(gercek, "bilinmiyor"),
            sozluk.get(gercek) or "YOK",
        ))
    return " | ".join(parcalar)


def _durum_ozetini_kur(asama):
    """sohbet blogunun promptuna gidecek durum bildirimi."""
    if state.get(S.GECERSIZ_AD):
        ozet = (
            "UYARI: Kullanicinin verdigi '{ad}' bir dataset degil (dosya/klasor "
            "adi). Onu okumaya CALISMA; kullanicidan gecerli bir dataset adi iste."
        ).format(ad=state[S.GECERSIZ_AD])
    elif state.get(S.VERI_SETI):
        ozet = "Veri seti: {vs}. Sozluk: {sz}.".format(
            vs=state[S.VERI_SETI],
            sz=state.get(S.SOZLUK) or "belirlenmedi",
        )
    elif state.get(S.ONCEKI_REDDEDILDI):
        ozet = (
            "Kullanici kayitli oturumu simdilik kullanmiyor. Kayit proje "
            "hafizasinda duruyor ve istenirse geri alinabilir; kaybolmadi."
        )
    else:
        ozet = "Veri seti henuz belirlenmedi."

    ozet += " BULUNULAN ADIM: {ad} (tamamlanmadi, devam ediyor).".format(
        ad=ASAMA_ADLARI.get(asama, asama))

    if state.get(S.KARSILANDI):
        ozet += " Karsilama metni zaten gosterildi, tekrar etme."

    # Gorus istendiginde kolon gercekleri prompta girer; LLM uydurmasin.
    if state.get(S.GORUS_ISTIYOR) and state.get(S.KOLONLAR):
        baglam = _kolon_baglami(state[S.KOLONLAR])
        if baglam:
            ozet += (
                " KOLON BAGLAMI: {}. Kullanici ifade onerisi istiyor. Sadece "
                "kullanicinin verdigi anlami daha duzgun ifade et; kolona yeni "
                "bir anlam atfetme. Onerdigin ifadeyi onaya sun."
            ).format(baglam)

    state[S.DURUM_OZETI] = ozet


def _onceki_oturumu_state_e_yaz(kayit):
    """sema.json icerigini onceki_* anahtarlarina tasir."""
    state[S.ONCEKI_VERI_SETI] = kayit.get(Sema.VERI_SETI)
    state[S.ONCEKI_SOZLUK] = kayit.get(Sema.SOZLUK_ADI)
    state[S.ONCEKI_N_SATIR] = kayit.get(Sema.N_SATIR)
    state[S.ONCEKI_N_KOLON] = kayit.get(Sema.N_KOLON)

    sozluk = kayit.get(Sema.SOZLUK)
    state[S.ONCEKI_N_ACIKLAMA] = len(sozluk) if isinstance(sozluk, dict) else 0

    aciklamasiz = kayit.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    fazla = kayit.get(Sema.SOZLUKTE_VAR_TABLODA_YOK)
    state[S.ONCEKI_ACIKLAMASIZ] = aciklamasiz if isinstance(aciklamasiz, list) else []
    state[S.ONCEKI_FAZLA] = fazla if isinstance(fazla, list) else []

    state[S.ONCEKI_ESLESEN] = max(
        int(kayit.get(Sema.N_KOLON) or 0) - len(state[S.ONCEKI_ACIKLAMASIZ]), 0)

    state[S.ONCEKI_BEKLIYOR] = True


def _onceki_oturumu_beklemeden_cikar():
    """Kayit reddedildi: aktif oturumdan cikarilir ama SILINMEZ."""
    for anahtar in ONCEKI_KAYIT_ANAHTARLARI:
        state[anahtar] = None
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = True
    _logla("kayitli oturum reddedildi (dosya korunuyor)")


def _asamayi_ayarla(yeni_asama):
    eski = state.get(S.ASAMA) or Asama.BASLANGIC
    state[S.ASAMA] = yeni_asama
    _logla("asama gecisi: {} -> {}".format(eski, yeni_asama))


def _kayitla_devam_et(veri_seti, sozluk_adi):
    """Kaydi aktif oturuma tasir ve sozluk adimina hazirlar."""
    state[S.VERI_SETI] = veri_seti
    state[S.SOZLUK] = sozluk_adi
    state[S.DATASET_VAR] = True
    state[S.SOZLUK_VAR] = bool(sozluk_adi)
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = False
    _asamayi_ayarla(Asama.SOZLUK)


def _kolon_talebi_var_mi():
    """Bu turda kolonla ilgili bir islem isteniyor mu?"""
    return state.get(S.KOLON_ISLEMI) in (KolonIslemi.SOR, KolonIslemi.TANIMLA)


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        g = _json_ayristir(state.get(S.GIRDI))
        _girdiyi_state_e_isle(g)

        kayit_karari = g.get(G.KAYIT_KARARI)
        onay = g.get(G.ONAY)
        asama = state.get(S.ASAMA) or Asama.BASLANGIC
        _durum_ozetini_kur(asama)

        _logla("kayit_karari={} onay={} kolon_islemi={} gorus={}".format(
            kayit_karari, onay, state.get(S.KOLON_ISLEMI),
            state.get(S.GORUS_ISTIYOR)))

        # --- 1) Ilk tur: karsilama (+ varsa kayit sorusu) ---------------------
        if not state.get(S.KARSILANDI):
            state[S.KARSILANDI] = True
            kayit = _hafizayi_oku()

            if kayit and kayit.get(Sema.VERI_SETI) and not state.get(S.VERI_SETI):
                _onceki_oturumu_state_e_yaz(kayit)
                yield "{}\n\n---\n\n{}".format(KARSILAMA, _onceki_kayit_mesaji())
                return

            yield "{}\n\n{}".format(KARSILAMA, BILGI_ISTEGI)
            return

        # --- 2) Kayit karari bekleniyor ---------------------------------------
        # RET ACIK OLMALIDIR: yalnizca kayit_karari="yeni" reddedilir.
        # Karar verilmeden gelen soru/kolon istegi kaydi silmez.
        if state.get(S.ONCEKI_BEKLIYOR):
            if kayit_karari == KayitKarari.YENI:
                _onceki_oturumu_beklemeden_cikar()
                yield SIFIRDAN_BASLA
                return

            if kayit_karari == KayitKarari.DEVAM or onay is True:
                _kayitla_devam_et(
                    state.get(S.ONCEKI_VERI_SETI), state.get(S.ONCEKI_SOZLUK))
                # Ayni mesajda kolon talebi de varsa once ona cevap ver.
                if _kolon_talebi_var_mi():
                    yield NextBlock(Blok.KOLON_SORGU)
                    return
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            # Karar yok: kaydi koru. Kolon sorusu varsa yine de cevapla.
            if _kolon_talebi_var_mi():
                yield NextBlock(Blok.KOLON_SORGU)
                return
            yield _karar_bekleniyor_mesaji()
            return

        # --- 3) Kayitli oturuma geri donus ------------------------------------
        if not state.get(S.VERI_SETI) and kayit_karari == KayitKarari.DEVAM:
            kayit = _hafizayi_oku()
            if kayit and kayit.get(Sema.VERI_SETI):
                _kayitla_devam_et(
                    kayit.get(Sema.VERI_SETI), kayit.get(Sema.SOZLUK_ADI))
                _logla("kayitli oturuma geri donuldu: {}".format(
                    kayit.get(Sema.VERI_SETI)))
                yield _kayit_geri_alindi_mesaji(
                    state[S.VERI_SETI], state.get(S.SOZLUK))
                yield NextBlock(Blok.SOZLUK_CALIS)
                return
            yield KAYIT_BULUNAMADI
            return

        # --- 4) Kolon islemi ---------------------------------------------------
        # Onaydan ONCE: kullanici kolon sorarken surec ilerlemez.
        if _kolon_talebi_var_mi():
            if not state.get(S.VERI_SETI):
                yield KOLON_ICIN_VERI_GEREKLI
                return
            # Gorus istegi kolon_sorgu'nun isi degil; sohbet ifade onerisi verir.
            # Kolon gercekleri durum_ozeti'ne zaten eklendi.
            if state.get(S.GORUS_ISTIYOR) and not state.get(S.KOLON_ACIKLAMASI):
                yield NextBlock(Blok.SOHBET)
                return
            yield NextBlock(Blok.KOLON_SORGU)
            return

        # --- 5) Gecersiz dataset adi ------------------------------------------
        if state.get(S.GECERSIZ_AD):
            yield _gecersiz_ad_mesaji(state[S.GECERSIZ_AD])
            return

        # --- 6) Baslangic: veri seti hazir ve onaylandi ------------------------
        if asama == Asama.BASLANGIC and state[S.DATASET_VAR] and onay is True:
            _asamayi_ayarla(Asama.SOZLUK)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 7) Adim icinde onay: ilgili islem bloguna yonlendir ---------------
        if onay is True and asama in ASAMA_HARITASI:
            hedef_blok = ASAMA_HARITASI[asama]
            if hedef_blok:
                _logla("onay alindi, {} bloguna yonlendiriliyor".format(hedef_blok))
                yield NextBlock(hedef_blok)
                return
            _logla("onay alindi ama '{}' adiminin blogu kurulmamis".format(asama))
            yield _adim_hazir_degil_mesaji(asama)
            return

        # --- 8) Diger her sey: serbest sohbet ---------------------------------
        yield NextBlock(Blok.SOHBET)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield BEKLENMEYEN_HATA
