import json
from dataiku.llm.python.blocks_graph import NextBlock
from fe_agent import durum, dispatcher


def process(trace):
    sonuc = dispatcher.calistir(state, list(state["aksiyonlar"]), list(state["aksiyon_eksik"]))
    durum.guncelle_ozet(state)
    if "dogrudan_metin" in sonuc:
        yield sonuc["dogrudan_metin"]
        return
    state["sonuc_json"] = json.dumps(sonuc, ensure_ascii=False)
    yield NextBlock("anlat")

















