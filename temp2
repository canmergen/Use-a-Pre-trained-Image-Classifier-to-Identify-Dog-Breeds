# =============================================================================
# FEATURE_DISCOVERY_AGENT / kolon_sorgu
# -----------------------------------------------------------------------------
# Sorumluluk : Kolon adi bazinda soru-cevap ve sozluk duzeltmesi.
#              Aciklamalar sozluk dataset'inden ve kullanici eklerinden
#              DETERMINISTIK olarak okunur; LLM tahmini kullanilmaz.
# Girdi      : state["kolonlar"]           -> sorulan kolon adlari (liste)
#              state["kolon_aciklamasi"]   -> kullanicinin verdigi tanim
#              state["niyet"]              -> kolon_sorgu | kolon_tanim
#              state["sozluk"]             -> sozluk dataset adi
#              state["veri_seti"]          -> veri seti adi
# Cikti      : Kullaniciya metin (yield)
# Kalici     : PROJE_HAFIZASI/sozluk_ek.json  (kullanici tanimlari)
# =============================================================================

import difflib
import json

import dataiku


# -----------------------------------------------------------------------------
# Sabitler
# -----------------------------------------------------------------------------

HAFIZA_FOLDER = "PROJE_HAFIZASI"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

# Tek seferde cevaplanacak azami kolon sayisi. Fazlasi sohbeti bogar.
AZAMI_KOLON = 10

# Benzer kolon onerisi icin esik ve azami oneri sayisi.
BENZERLIK_ESIGI = 0.6
AZAMI_ONERI = 5


class S:
    """state anahtarlari."""
    NIYET = "niyet"
    SOZLUK = "sozluk"
    VERI_SETI = "veri_seti"
    KOLONLAR = "kolonlar"
    KOLON_ACIKLAMASI = "kolon_aciklamasi"
    BEKLEYEN_KOLON = "bekleyen_kolon"


# -----------------------------------------------------------------------------
# Yardimci fonksiyonlar
# -----------------------------------------------------------------------------

def _logla(mesaj):
    print("[kolon_sorgu] {}".format(mesaj))


def _sozlugu_oku(sozluk_adi):
    """Sozluk dataset'ini {kolon_adi: aciklama} sozlugune cevirir.

    Kolonlar POZISYONA gore alinir (birinci kolon ad, ikinci aciklama);
    sozluk dataset'inin kolon basliklari projeden projeye degisebiliyor.
    Okunamazsa bos dict doner.
    """
    if not sozluk_adi:
        return {}
    try:
        df = dataiku.Dataset(sozluk_adi).get_dataframe()
    except Exception as hata:
        _logla("sozluk okunamadi ({}): {}".format(sozluk_adi, hata))
        return {}

    if df.shape[1] < 2:
        _logla("sozlukte en az 2 kolon bekleniyordu, {} bulundu".format(df.shape[1]))
        return {}

    ad_kolonu = df.columns[0]
    aciklama_kolonu = df.columns[1]

    sonuc = {}
    for _, satir in df.iterrows():
        ad = str(satir[ad_kolonu]).strip()
        aciklama = str(satir[aciklama_kolonu]).strip()
        if ad and ad.lower() != "nan":
            sonuc[ad] = aciklama
    return sonuc


def _veri_seti_kolonlari(veri_seti_adi):
    """Veri setindeki kolon adlarini dondurur. Okunamazsa bos liste."""
    if not veri_seti_adi:
        return []
    try:
        sema = dataiku.Dataset(veri_seti_adi).read_schema()
        return [alan["name"] for alan in sema]
    except Exception as hata:
        _logla("veri seti semasi okunamadi ({}): {}".format(veri_seti_adi, hata))
        return []


def _ek_sozlugu_oku():
    """Kullanicinin daha once verdigi tanimlari dondurur."""
    try:
        folder = dataiku.Folder(HAFIZA_FOLDER)
        if EK_SOZLUK_DOSYASI not in folder.list_paths_in_partition():
            return {}
        with folder.get_download_stream(EK_SOZLUK_DOSYASI) as akis:
            veri = json.loads(akis.read().decode("utf-8"))
        return veri if isinstance(veri, dict) else {}
    except Exception as hata:
        _logla("ek sozluk okunamadi: {}".format(hata))
        return {}


def _ek_sozluge_yaz(kolon, aciklama):
    """Kullanici tanimini kalici dosyaya ekler. Basarisizsa False doner."""
    try:
        mevcut = _ek_sozlugu_oku()
        mevcut[kolon] = aciklama
        folder = dataiku.Folder(HAFIZA_FOLDER)
        icerik = json.dumps(mevcut, ensure_ascii=False, indent=2)
        folder.upload_data(EK_SOZLUK_DOSYASI, icerik.encode("utf-8"))
        _logla("ek sozluge yazildi: {} = {}".format(kolon, aciklama[:60]))
        return True
    except Exception as hata:
        _logla("ek sozluge yazilamadi: {}".format(hata))
        return False


def _kolonu_bul(aranan, mevcut_adlar):
    """Kolon adini esler.

    Once birebir, sonra buyuk/kucuk harf duyarsiz eslesme denenir.
    Bulunursa gercek kolon adi, bulunamazsa None doner.
    """
    if aranan in mevcut_adlar:
        return aranan
    kucuk_harita = {ad.lower(): ad for ad in mevcut_adlar}
    return kucuk_harita.get(aranan.strip().lower())


def _benzer_kolonlar(aranan, mevcut_adlar):
    """Yazim hatasi ihtimaline karsi benzer kolon adlari onerir."""
    return difflib.get_close_matches(
        aranan, list(mevcut_adlar), n=AZAMI_ONERI, cutoff=BENZERLIK_ESIGI
    )


def _kolon_satiri(kolon, aciklama, kaynak, tabloda_var):
    """Tek bir kolonun cevabini bicimlendirir."""
    konum = "tabloda var" if tabloda_var else "**tabloda yok**"
    return "**{kolon}** ({konum}, kaynak: {kaynak})\n{aciklama}".format(
        kolon=kolon, konum=konum, kaynak=kaynak, aciklama=aciklama
    )


# -----------------------------------------------------------------------------
# Niyet isleyicileri
# -----------------------------------------------------------------------------

def _sorguyu_cevapla(kolonlar, sozluk, ek_sozluk, tablo_kolonlari):
    """kolon_sorgu niyeti: sorulan kolonlarin aciklamalarini dondurur."""
    tablo_kumesi = set(tablo_kolonlari)
    bilinen_adlar = set(sozluk) | set(ek_sozluk) | tablo_kumesi

    parcalar = []
    bulunamayanlar = []

    for aranan in kolonlar[:AZAMI_KOLON]:
        gercek_ad = _kolonu_bul(str(aranan).strip(), bilinen_adlar)

        if gercek_ad is None:
            benzerler = _benzer_kolonlar(str(aranan).strip(), bilinen_adlar)
            bulunamayanlar.append((aranan, benzerler))
            continue

        tabloda_var = gercek_ad in tablo_kumesi

        if gercek_ad in ek_sozluk:
            parcalar.append(_kolon_satiri(
                gercek_ad, ek_sozluk[gercek_ad], "sizin tanımınız", tabloda_var))
        elif gercek_ad in sozluk and sozluk[gercek_ad]:
            parcalar.append(_kolon_satiri(
                gercek_ad, sozluk[gercek_ad], "sözlük", tabloda_var))
        else:
            parcalar.append(
                "**{kolon}** ({konum})\nSözlükte açıklaması yok. Ne anlama "
                "geldiğini yazarsanız kaydederim.".format(
                    kolon=gercek_ad,
                    konum="tabloda var" if tabloda_var else "tabloda yok",
                )
            )

    for aranan, benzerler in bulunamayanlar:
        if benzerler:
            parcalar.append(
                "**{aranan}** ne tabloda ne sözlükte var. Şunu mu "
                "kastettiniz: {oneri}".format(
                    aranan=aranan,
                    oneri=", ".join("`{}`".format(b) for b in benzerler))
            )
        else:
            parcalar.append(
                "**{aranan}** ne tabloda ne sözlükte bulundu.".format(aranan=aranan)
            )

    if len(kolonlar) > AZAMI_KOLON:
        parcalar.append(
            "_({} kolon sordunuz, ilk {} tanesini yanıtladım.)_".format(
                len(kolonlar), AZAMI_KOLON)
        )

    return "\n\n".join(parcalar)


def _tanimi_kaydet(kolonlar, aciklama, sozluk, ek_sozluk, tablo_kolonlari):
    """kolon_tanim niyeti: kullanicinin verdigi aciklamayi kaydeder."""
    bilinen_adlar = set(sozluk) | set(ek_sozluk) | set(tablo_kolonlari)

    if not kolonlar:
        return ("Açıklamayı hangi kolon için kaydedeceğimi anlayamadım. "
                "Kolon adını yazar mısınız?")

    if not aciklama:
        return ("**{kolon}** için açıklamayı alamadım. Ne anlama geldiğini "
                "yazar mısınız?".format(kolon=kolonlar[0]))

    hedef = str(kolonlar[0]).strip()
    gercek_ad = _kolonu_bul(hedef, bilinen_adlar) or hedef

    onceki = ek_sozluk.get(gercek_ad) or sozluk.get(gercek_ad)

    if not _ek_sozluge_yaz(gercek_ad, aciklama):
        return ("**{kolon}** açıklamasını kaydedemedim; proje hafızasına "
                "yazma başarısız oldu. Ayrıntı log'da.".format(kolon=gercek_ad))

    if onceki:
        return ("**{kolon}** açıklaması güncellendi.\n\n"
                "Önceki: {onceki}\nYeni: {yeni}\n\n"
                "Sözlük sıkıştırmasında yeni açıklama kullanılacak.").format(
            kolon=gercek_ad, onceki=onceki, yeni=aciklama)

    return ("**{kolon}** açıklaması kaydedildi: {yeni}\n\n"
            "Sözlük sıkıştırmasında bu açıklama kullanılacak.").format(
        kolon=gercek_ad, yeni=aciklama)


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        niyet = (state.get(S.NIYET) or "").strip().lower()
        kolonlar = state.get(S.KOLONLAR) or []
        if not isinstance(kolonlar, list):
            kolonlar = [kolonlar]

        sozluk = _sozlugu_oku(state.get(S.SOZLUK))
        ek_sozluk = _ek_sozlugu_oku()
        tablo_kolonlari = _veri_seti_kolonlari(state.get(S.VERI_SETI))

        if not sozluk and not tablo_kolonlari:
            yield ("Sözlüğü ve veri setini şu an okuyamıyorum, bu yüzden kolon "
                   "sorularını yanıtlayamıyorum. Ayrıntı agent log'unda.")
            return

        if niyet == "kolon_tanim":
            aciklama = (state.get(S.KOLON_ACIKLAMASI) or "").strip()
            # Onceki turda "hangi kolon" diye sorduysak, kolonu oradan al.
            if not kolonlar and state.get(S.BEKLEYEN_KOLON):
                kolonlar = [state[S.BEKLEYEN_KOLON]]
            state[S.BEKLEYEN_KOLON] = None
            yield _tanimi_kaydet(kolonlar, aciklama, sozluk, ek_sozluk,
                                 tablo_kolonlari)
            return

        if not kolonlar:
            yield ("Hangi kolonu sorduğunuzu anlayamadım. Kolon adını yazar "
                   "mısınız? Örnek: `rn nedir`")
            return

        # Tek kolon sorulduysa, kullanicinin sonraki mesajda verecegi tanim
        # dogrudan bu kolona yazilabilsin diye isaretlenir.
        if len(kolonlar) == 1:
            state[S.BEKLEYEN_KOLON] = str(kolonlar[0]).strip()

        yield _sorguyu_cevapla(kolonlar, sozluk, ek_sozluk, tablo_kolonlari)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("Kolon sorgusunu işlerken beklenmeyen bir hata oluştu. "
               "Ayrıntı agent log'una yazıldı.")
