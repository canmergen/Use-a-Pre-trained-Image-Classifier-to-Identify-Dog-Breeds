META_KALIP = {
    "target": r"target\s*[:=]?\s*([a-z0-9_]+)",
    "id": r"\bid\s*[:=]?\s*([a-z0-9_]+)",
    "donem": r"donem\s*[:=]?\s*([a-z0-9_]+)",
}


def meta_girdi(durum, mesaj):
    norm = niyet_kural.normalize(mesaj)
    meta = dict(durum.get("meta") or {})
    for anahtar, kalip in META_KALIP.items():
        m = re.search(kalip, norm)
        if m:
            # normalize uzunlugu bozmuyor -> konumu ORIJINAL metne uyguluyoruz
            meta[anahtar] = mesaj[m.start(1):m.end(1)]

    # Verilen kolonlar tabloda gercekten var mi? Yoksa hata 5. adima kadar
    # sessiz kalir, orada df[target] KeyError verir.
    if durum.get("veri_seti") and meta:
        try:
            kolonlar = set(_df_oku(durum["veri_seti"], limit=5).columns)
            hatali = [(k, v) for k, v in meta.items() if v not in kolonlar]
            if hatali:
                for k, _ in hatali:
                    meta.pop(k, None)
                durum["meta"] = meta
                return False, ("Şu kolonları tabloda bulamadım: %s\n\n"
                               "Adlarını kontrol eder misiniz?"
                               % ", ".join("%s → %s" % (k, v) for k, v in hatali))
        except Exception:
            pass   # kolon listesi okunamadiysa dogrulamayi atliyoruz

    durum["meta"] = meta

    eksik = [k for k in ("target", "id") if k not in meta]
    if eksik:
        etiket = {"target": "hedef değişken", "id": "kimlik kolonu"}
        return False, ("Şunlara ihtiyacım var: %s\n\n"
                       "Örnek:\n"
                       "    target TGT_CS_ALL_TKP_ST_5M90 id SM_ID donem PERIOD"
                       % ", ".join(etiket[k] for k in eksik))
    return True, None


def meta_plan(durum):
    m = durum["meta"]
    return ("Şöyle anladım:\n\n"
            "  Hedef değişken : %s\n"
            "  Kimlik kolonu  : %s\n"
            "  Dönem kolonu   : %s\n\n"
            "Bu üçü hem üretimde hem kalite kontrolünde referans alınacak. "
            "Doğru mu?"
            % (m.get("target"), m.get("id"), m.get("donem", "belirtilmedi")))


def meta_uygula(durum):
    """Onay geldiginde hedefin dagilimini da cikariyoruz; ust seritte
    'Binary · %0,42 pozitif' gibi gorunecek."""
    hedef = (durum.get("meta") or {}).get("target")
    p = durum.get("profil") or {}
    try:
        s = pd.to_numeric(_df_oku(durum["veri_seti"])[hedef], errors="coerce")
        tekil = int(s.nunique(dropna=True))
        if tekil <= 2:
            p["hedef_ozet"] = "Binary · %%%s pozitif" % _ondalik(100.0 * float((s > 0).mean()), 2)
        else:
            p["hedef_ozet"] = "Sürekli · %s farklı değer" % _sayi(tekil)
    except Exception:
        p["hedef_ozet"] = "dağılım okunamadı"
    durum["profil"] = p
    return "Meta bilgilerini kaydettim."


