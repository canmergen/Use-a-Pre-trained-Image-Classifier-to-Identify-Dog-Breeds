import json

import dataiku


FOLDER_ADI = "PROJE_HAFIZASI"
SEMA_DOSYASI = "sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

AZAMI_LISTELENEN = 10


class S:
    ASAMA = "asama"
    VERI_SETI = "veri_seti"
    SOZLUK = "sozluk"
    OKUNDU = "okundu"


def _logla(mesaj):
    print("[sozluk_oku] {}".format(mesaj))


def _json_oku(dosya_yolu, varsayilan):
    try:
        folder = dataiku.Folder(FOLDER_ADI)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _sayi(deger):
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _kisalt(metin, uzunluk=60):
    temiz = str(metin or "").strip()
    return temiz[:uzunluk] + "..." if len(temiz) > uzunluk else temiz


def _kolon_ozeti(baslik, kolonlar):
    gosterilen = ", ".join(kolonlar[:AZAMI_LISTELENEN])
    if len(kolonlar) > AZAMI_LISTELENEN:
        gosterilen += " ..."
    return "{} {} kolon: {}".format(baslik, _sayi(len(kolonlar)), gosterilen)


def process(trace):
    try:
        veri_seti = state.get(S.VERI_SETI)
        sozluk_adi = state.get(S.SOZLUK)

        if not veri_seti:
            yield "Veri seti seçili değil. `veri <dataset adı>` yazın."
            return

        ds = dataiku.Dataset(veri_seti)
        sema = ds.read_schema()
        kolonlar = [c["name"] for c in sema]
        tipler = {c["name"]: c["type"] for c in sema}

        # satir sayisi icin tek kolon yeter
        try:
            n_satir = int(ds.get_dataframe(columns=[kolonlar[0]]).shape[0])
        except Exception as hata:
            _logla("satir sayisi okunamadi: {}".format(hata))
            n_satir = None

        kaynak_sozluk = {}
        if sozluk_adi:
            try:
                sdf = dataiku.Dataset(sozluk_adi).get_dataframe()
                if sdf.shape[1] < 2:
                    yield ("**{}** iki kolonlu değil, sözlük olarak "
                           "kullanamam.".format(sozluk_adi))
                    return
                ad_kol, acik_kol = sdf.columns[0], sdf.columns[1]
                kaynak_sozluk = dict(zip(sdf[ad_kol].astype(str),
                                         sdf[acik_kol].astype(str)))
            except Exception as hata:
                _logla("sozluk okunamadi: {}".format(hata))
                yield "**{}** okunamadı: {}".format(sozluk_adi, hata)
                return

        kaynak_sayisi = len(kaynak_sozluk)
        sozluk_map = dict(kaynak_sozluk)

        ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
        ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}
        onceki_sema = _json_oku("/" + SEMA_DOSYASI, {})
        onceki_sema = onceki_sema if isinstance(onceki_sema, dict) else {}

        # kullanicinin girdikleri kaynak sozlugu ezer
        yeni_eklenen = {}
        uzerine_yazilan = {}
        for kolon, aciklama in ek_sozluk.items():
            if not str(aciklama or "").strip():
                continue
            eski = kaynak_sozluk.get(kolon)
            if eski and str(eski).strip() != str(aciklama).strip():
                uzerine_yazilan[kolon] = (eski, aciklama)
            elif not eski:
                yeni_eklenen[kolon] = aciklama
            sozluk_map[kolon] = aciklama

        # tabloda artik olmayan kolonlar haric listesinden duser
        onceki_haric = onceki_sema.get("haric")
        onceki_haric = onceki_haric if isinstance(onceki_haric, list) else []
        haric = [k for k in onceki_haric if k in kolonlar]

        fazla = sorted(set(sozluk_map) - set(kolonlar))
        eksik = sorted(set(kolonlar) - set(sozluk_map) - set(haric))

        kayit = {
            "veri_seti": veri_seti,
            "sozluk_adi": sozluk_adi or None,
            "n_satir": n_satir,
            "n_kolon": len(kolonlar),
            "kolonlar": kolonlar,
            "tipler": tipler,
            "sozluk": sozluk_map,
            "fazla": fazla,
            "eksik": eksik,
            "haric": haric,
        }
        dataiku.Folder(FOLDER_ADI).upload_data(
            SEMA_DOSYASI,
            json.dumps(kayit, ensure_ascii=False, indent=2).encode("utf-8"))
        _logla("sema.json: {} kolon, {} aciklama, {} eksik, {} haric".format(
            len(kolonlar), len(sozluk_map), len(eksik), len(haric)))

        state[S.OKUNDU] = True
        state[S.ASAMA] = "sozluk"

        satirlar = ["**{}** okundu: {} satır, {} kolon.".format(
            veri_seti,
            _sayi(n_satir) if n_satir is not None else "?",
            _sayi(len(kolonlar)))]

        if sozluk_adi:
            satirlar.append("**{}** sözlüğünde {} açıklama var.".format(
                sozluk_adi, _sayi(kaynak_sayisi)))
        else:
            satirlar.append("Sözlük kullanılmıyor.")

        if yeni_eklenen:
            satirlar.append("**Daha önce eklediğiniz açıklamalar**")
            for kolon in sorted(yeni_eklenen):
                satirlar.append("**{}** — {}".format(
                    kolon, _kisalt(yeni_eklenen[kolon])))

        if uzerine_yazilan:
            satirlar.append("**Sözlüktekini değiştirdiğiniz açıklamalar**")
            for kolon in sorted(uzerine_yazilan):
                eski, yeni = uzerine_yazilan[kolon]
                satirlar.append("**{}** — {}\n_Sözlükte şöyleydi: {}_".format(
                    kolon, _kisalt(yeni), _kisalt(eski)))

        if haric:
            satirlar.append(_kolon_ozeti("**Süreç dışı bıraktığınız**", haric))
        if fazla:
            satirlar.append(_kolon_ozeti("Sözlükte var ama tabloda yok:", fazla))

        if eksik:
            satirlar.append(_kolon_ozeti("Açıklaması olmayan", eksik))
            satirlar.append("`eksikler` yazarsanız numaralı liste gelir, "
                            "`oneri 1-8` ile öneri alabilirsiniz.")
        else:
            satirlar.append("Açıklaması eksik kolon kalmadı. `gec` yazınca "
                            "sıkıştırmaya geçeriz.")

        yield "\n\n".join(satirlar)

    except Exception as hata:
        _logla("HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("Okurken bir hata oluştu, hiçbir şey kaydedilmedi. Ayrıntısı "
               "agent log'unda.")
