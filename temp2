:root {
  /* Akbank kirmizisi — logo yazisindan alindi */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-canli:#F51513;
  --kirmizi-acik: #FDF2F2;

  /* Aksiyon renkleri */
  --onay:         #12B76A;
  --ret:          #D51115;
  --geri:         #2563EB;

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #FAFAFB;
  --sohbet-zemin: #6B0A0D;
  --kenar:        #C9CED6;
  --kenar-acik:   #DFE3E8;

  /* Metin: tek ton — siyah */
  --metin:        #000000;
  --gri:          #000000;
  --gri-acik:     #000000;

  /* Sohbet icindeki kart */
  --balon-zemin:  #FFFFFF;
  --balon-metin:  #000000;
  --balon-kenar:  #D8DCE3;

  /* Giris kapsulu */
  --giris-zemin:  #FFFFFF;
  --giris-metin:  #000000;
  --gonder-zemin: #000000;
  --gonder-metin: #FFFFFF;

  /* Sohbet arka plan gorseli — JS dolduruyor */
  --sohbet-gorsel: none;
  --sohbet-perde:  rgba(255,255,255,.35);

  --yesil:        #0E9F5C;
  --sari:         #EAB308;
  --sari-koyu:    #000000;
  --sari-acik:    #FDF6D3;
  --golge:        rgba(0,0,0,.10);

  --panel-en:   clamp(340px, 27vw, 480px);
  --analiz-en:  clamp(320px, 24vw, 420px);
  --yazi:       11.2px;
  --avatar:     28px;
  --girinti:    38px;
  --ustbar-h:   104px;
}

/* -------- KOYU TEMA: siyah taban, beyaz metin -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #C21B1E;
  --kirmizi-canli:#FF6B5B;
  --kirmizi-acik: #2A1418;

  --onay:         #15C075;
  --ret:          #E8393C;
  --geri:         #3B82F6;

  --zemin:        #000000;
  --yuzey:        #161616;
  --yuzey-alt:    #0B0B0B;
  --sohbet-zemin: #3D0508;
  --kenar:        #3A3A3A;
  --kenar-acik:   #262626;

  --metin:        #FFFFFF;
  --gri:          #FFFFFF;
  --gri-acik:     #FFFFFF;

  --balon-zemin:  #161616;
  --balon-metin:  #FFFFFF;
  --balon-kenar:  #3A3A3A;

  --giris-zemin:  #000000;
  --giris-metin:  #FFFFFF;
  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;

  --sohbet-perde: rgba(0,0,0,.45);

  --yesil:        #3DDC8A;
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
  --golge:        rgba(0,0,0,.6);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
  transition: background .2s, color .2s;
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}
#ustbar-sol { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
#banner { height: 84px; width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 16px; line-height: 1.35; }
#urun-adi {
  font-weight: 700; font-size: 1.85em; letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt {
  font-size: 1.12em; font-weight: 700; color: var(--metin);
  margin-top: 3px; white-space: nowrap;
}

/* -------- Özet şerit -------- */
/* text-transform YOK — Turkce I/İ sorunu icin metinler Python'da buyuk yazılı */
#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: 1em; font-weight: 700; letter-spacing: .07em;
  color: var(--kirmizi); margin-bottom: 4px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.35em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-ust, .ozet-alt {
  display: block; font-size: 1.05em; color: var(--metin); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* -------- Sağ blok -------- */
#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 8px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: 9px; }

#tema-btn, #sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 28px; height: 28px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: 6px; cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn:hover, #sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 1em; color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 8px;
}
.sekme {
  flex: 1; font-size: 1em; font-weight: 600; padding: 7px 20px;
  border: none; background: none; border-radius: 6px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff;
  box-shadow: 0 1px 3px rgba(213,17,21,.28);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--kenar);
  padding: 20px 18px 30px; overflow-y: auto;
}
#panel::-webkit-scrollbar { width: 5px; }
#panel::-webkit-scrollbar-thumb { background: var(--kenar); border-radius: 3px; }

.panel-blok { margin-bottom: 24px; }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik {
  font-size: 1.05em; font-weight: 800; letter-spacing: .09em;
  color: var(--kirmizi); margin-bottom: 10px;
}
.panel-metin { margin: 0 0 10px; font-size: 1.02em; line-height: 1.6; color: var(--metin); }
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı: yeşil tamam · sarı devam · siyah bekliyor -------- */
.faz { margin-bottom: 2px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 7px;
  padding: 8px; border-radius: 6px; cursor: pointer;
  color: var(--metin);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: var(--sari-acik); color: var(--sari-koyu); }
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 10px; margin-top: 2px;
  font-size: 1em; transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; font-family: ui-monospace, Consolas, monospace;
  font-size: .88em; font-weight: 700; margin-top: 2px;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: 1.1em; font-weight: 700; line-height: 1.3; color: inherit; }
.faz-ozet {
  font-size: .92em; color: inherit;
  margin-top: 2px; line-height: 1.35; font-weight: 400;
}
.faz-durum {
  flex-shrink: 0; font-size: .88em; font-family: ui-monospace, Consolas, monospace;
  font-weight: 700; margin-top: 3px; cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 1px 0 6px 13px; padding: 0 0 0 26px; display: none;
  border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 5px;
  font-size: .98em; color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 13px; height: 13px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .6em; font-weight: 700;
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: 700; }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 3px var(--sari-acik);
}

/* ==================== ORTA: SOHBET ==================== */
/* Arka plan gorseli tema ile degisir; uzerine perde ceriliyor ki
   balon metinleri her zaman okunakli kalsin. */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--sohbet-zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--sohbet-perde);
  pointer-events: none;
}
/* Icerik perdenin ustunde kalsin */
#sohbet, #giris-bolge { position: relative; z-index: 1; }

#sohbet {
  flex: 1; overflow-y: auto;
  padding: 20px 22px 14px;
  background: transparent;
}
#sohbet::-webkit-scrollbar { width: 7px; }
#sohbet::-webkit-scrollbar-thumb { background: rgba(255,255,255,.35); border-radius: 4px; }

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 0 16px; max-width: 100%;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid rgba(255,255,255,.5);
  box-shadow: 0 2px 6px rgba(0,0,0,.3);
}

.balon {
  padding: 13px 16px; border-radius: 14px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 88%;
  max-height: 360px; overflow-y: auto;
}
/* Bot: Akbank kirmizisi zemin, beyaz metin — her iki temada */
.satir.bot .balon {
  background: var(--kirmizi); color: #fff;
  border: none;
  border-top-left-radius: 4px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .95em;
  box-shadow: 0 3px 12px rgba(0,0,0,.3);
}
.satir.bot .balon::-webkit-scrollbar { width: 6px; }
.satir.bot .balon::-webkit-scrollbar-thumb { background: rgba(255,255,255,.4); border-radius: 3px; }

/* Kullanici: siyah zemin, beyaz metin */
.satir.kullanici .balon {
  background: rgba(0,0,0,.7); color: #fff;
  border: 1px solid rgba(255,255,255,.3);
  border-top-right-radius: 4px; font-size: 1em;
  box-shadow: 0 3px 12px rgba(0,0,0,.3);
}

/* Hata: kirmizi zemin uzerinde ayrisabilsin diye acik zemin */
.satir.bot .balon.hata {
  background: #FFF4F4; color: #A00D10; border: 1px solid #F5B5B5;
}

/* -------- Veri seçim kartı: bot balonuyla aynı hizada -------- */
#secici-kart {
  max-width: 88%; margin: 0 0 18px var(--girinti);
  background: var(--balon-zemin); border: 1px solid var(--balon-kenar);
  border-radius: 14px;
  padding: 18px 20px 20px; box-shadow: 0 3px 12px rgba(0,0,0,.28);
  color: var(--balon-metin);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 700; font-size: 1.15em; margin-bottom: 5px; color: var(--balon-metin); }
.kart-alt { font-size: 1em; color: var(--balon-metin); line-height: 1.55; margin-bottom: 14px; }
.kart-govde { display: flex; gap: 11px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 165px; }
.combo label {
  display: block; font-size: .95em; color: var(--balon-metin);
  margin-bottom: 5px; font-weight: 700;
}
.combo-giris {
  width: 100%; padding: 9px 14px; border: 1px solid var(--balon-kenar);
  border-radius: 999px;
  font-family: ui-monospace, Consolas, monospace; font-size: 1em;
  outline: none; background: var(--balon-zemin); color: var(--balon-metin);
}
.combo-giris::placeholder { color: var(--balon-metin); opacity: .5; }
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(213,17,21,.12); }
.combo-giris.secili { border-color: var(--yesil); }
.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 5px; list-style: none;
  background: var(--balon-zemin); border: 1px solid var(--balon-kenar);
  border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,.35);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 12px; border-radius: 999px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .98em;
  color: var(--balon-metin);
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; font-family: inherit; opacity: .7; }
.combo-liste li.bos:hover { background: none; color: var(--balon-metin); }

#secici-btn {
  padding: 9px 24px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 999px; font-size: 1.05em; font-weight: 700;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--balon-metin); opacity: .6; cursor: not-allowed; }

/* -------- Yazıyor: kirmizi balon uzerinde beyaz noktalar -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: #fff; animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-3px); }
}

/* -------- Aksiyon butonları ve giriş -------- */
#giris-bolge {
  border-top: none;
  background: transparent;
  padding: 10px 22px 20px; flex-shrink: 0;
}
#aksiyonlar {
  max-width: 100%; margin: 0 0 11px var(--girinti);
  display: flex; gap: 9px;
}

.aksiyon {
  font-size: 1.05em; font-weight: 700; padding: 10px 22px;
  border: none; border-radius: 999px;
  cursor: pointer; color: #fff; white-space: nowrap;
  box-shadow: 0 3px 10px rgba(0,0,0,.3);
  transition: filter .15s;
}
.aksiyon:hover:not(:disabled) { filter: brightness(1.15); }
.aksiyon:disabled { opacity: .4; cursor: not-allowed; }

.aksiyon.onayla   { background: var(--onay); }
.aksiyon.degistir { background: var(--ret); }
.aksiyon.geri     { background: var(--geri); }

/* Yazı bloğu: oval kapsül */
#giris {
  max-width: 100%; margin: 0 0 0 var(--girinti);
  display: flex; gap: 8px; align-items: center;
  background: var(--giris-zemin);
  border: 1px solid var(--balon-kenar);
  border-radius: 999px;
  padding: 7px 7px 7px 18px;
  box-shadow: 0 3px 12px rgba(0,0,0,.28);
}
#kutu {
  flex: 1; padding: 6px 0; border: none;
  background: transparent; color: var(--giris-metin);
  font-family: inherit; font-size: 1.05em; line-height: 1.5;
  resize: none; outline: none; max-height: 92px; overflow-y: auto;
}
#kutu::placeholder { color: var(--giris-metin); opacity: .55; }
#kutu::-webkit-scrollbar { width: 5px; }
#kutu::-webkit-scrollbar-thumb { background: var(--giris-metin); opacity: .4; border-radius: 3px; }

#gonder {
  padding: 9px 24px; background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: 999px;
  font-size: 1.05em; font-weight: 700; cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { filter: brightness(1.25); }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column; overflow: hidden;
}

#analiz-ust {
  padding: 15px 17px 13px; border-bottom: 1px solid var(--kenar);
  background: var(--yuzey); flex-shrink: 0;
}
#analiz-baslik { font-weight: 800; font-size: 1.2em; color: var(--kirmizi); }

#analiz-sekmeler {
  display: flex; gap: 2px; padding: 9px 11px;
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  overflow-x: auto; flex-shrink: 0;
}
#analiz-sekmeler::-webkit-scrollbar { height: 0; }
.analiz-sekme {
  font-size: .98em; font-weight: 600; padding: 6px 13px;
  border: none; background: none; border-radius: 999px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); }
.analiz-sekme.aktif { background: var(--kirmizi); color: #fff; font-weight: 700; }

#analiz-govde { flex: 1; overflow-y: auto; padding: 15px 17px 24px; }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 13px 15px; margin-bottom: 11px;
}
.iskele-baslik { font-size: 1.02em; font-weight: 700; margin-bottom: 9px; color: var(--metin); }
.iskele-satir {
  display: flex; justify-content: space-between; gap: 10px;
  font-size: .98em; padding: 5px 0; color: var(--metin);
}
.iskele-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--metin); background: var(--kenar-acik);
  padding: 0 9px; border-radius: 999px;
}
.iskele-grafik {
  height: 80px; border-radius: 10px; margin-top: 4px;
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 6px,
    var(--yuzey) 6px, var(--yuzey) 12px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin); font-size: .92em;
}

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1280px; margin: 0 auto; padding: 26px clamp(18px, 2.4vw, 44px) 56px; }
#ozet-baslik-blok { margin-bottom: 20px; }
#ozet-h1 { margin: 0; font-size: 1.9em; font-weight: 800; letter-spacing: -.01em; color: var(--kirmizi); }
#ozet-adim { font-size: 1.05em; color: var(--metin); margin-top: 6px; }

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 14px; align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 16px 18px 14px; box-shadow: 0 1px 2px var(--golge);
}
.ozet-blok-baslik {
  font-size: .95em; font-weight: 800; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 11px;
  padding-bottom: 9px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 6px 0; font-size: 1.05em; align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--metin); flex-shrink: 0; }
.ozet-satir-deger {
  font-family: ui-monospace, Consolas, monospace; color: var(--metin);
  text-align: right; font-weight: 600; word-break: break-word; min-width: 0;
}
#ozet-bos {
  background: var(--yuzey); border: 1px dashed var(--kenar); border-radius: 12px;
  padding: 40px; text-align: center; color: var(--metin);
  font-size: 1.1em; grid-column: 1 / -1;
}

/* -------- Dar ekran -------- */
@media (max-width: 1180px) { #analiz-panel { display: none; } }
@media (max-width: 1280px) { #baslik-blok { display: none; } }
@media (max-width: 1080px) { #panel { display: none; } #ozet-serit { display: none; } }
