const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl  = document.getElementById("sohbet");
const kutuEl    = document.getElementById("kutu");
const gonderEl  = document.getElementById("gonder");
const listeEl   = document.getElementById("adim-listesi");
const seritEl   = document.getElementById("ozet-serit");
const bannerEl  = document.getElementById("banner");
const kartEl    = document.getElementById("secici-kart");
const seciciBtn = document.getElementById("secici-btn");
const chipler   = Array.from(document.querySelectorAll(".chip"));

let ADIMLAR = [];
let DATASETLER = [];
let aktifAdim = 0;
let acikAdim = -1;          // SADECE tiklanarak acilir; aktif adim otomatik acilmaz
let mesgul = false;
const secim = { veri_seti: "", sozluk: "" };

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };


/* ==================== Sol panel: stepper ==================== */
function listeyiCiz() {
    listeEl.innerHTML = "";
    ADIMLAR.forEach((a, i) => {
        const li = document.createElement("li");
        if (i < aktifAdim)   li.classList.add("tamam");
        if (i === aktifAdim) li.classList.add("aktif");
        if (i === acikAdim)  li.classList.add("acik");

        const isaret = document.createElement("span");
        isaret.className = "adim-isaret";
        isaret.textContent = (i < aktifAdim) ? "✓" : String(i + 1).padStart(2, "0");
        li.appendChild(isaret);

        const govde = document.createElement("div");
        govde.className = "adim-govde";

        const ad = document.createElement("div");
        ad.className = "adim-ad";
        ad.textContent = a.baslik;
        govde.appendChild(ad);

        if (a.aciklama) {
            const ack = document.createElement("div");
            ack.className = "adim-aciklama";
            ack.textContent = a.aciklama;
            govde.appendChild(ack);
        }

        li.appendChild(govde);
        // Tiklayinca aciklama acilir/kapanir. Akisa mudahale etmez, adim atlamaz.
        li.onclick = () => { acikAdim = (acikAdim === i) ? -1 : i; listeyiCiz(); };
        listeEl.appendChild(li);
    });
}

fetch(getWebAppBackendUrl("adimlar"))
    .then(r => r.json())
    .then(d => { ADIMLAR = d.adimlar || []; listeyiCiz(); })
    .catch(() => { listeEl.innerHTML = "<li>adımlar yüklenemedi</li>"; });


/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;          // uzun adlar kirpiliyor, tooltip kalsin
        kart.appendChild(deger);

        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}


/* ==================== Balon kurucu ==================== */
function balonYap(rol, metin, hataMi) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Kullanıcı";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon" + (hataMi ? " hata" : "");
    balon.textContent = metin;      // textContent: metin HTML olarak yorumlanmaz
    satir.appendChild(balon);
    return satir;
}

function balonEkle(rol, metin, hataMi) {
    const satir = balonYap(rol, metin, hataMi);
    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    chipler.forEach(c => { c.disabled = durum; });
    seciciBtn.disabled = durum || !(secim.veri_seti && secim.sozluk);
}


/* ==================== Veri seçici ==================== */
function comboKur(kok) {
    const alan  = kok.dataset.alan;
    const giris = kok.querySelector(".combo-giris");
    const liste = kok.querySelector(".combo-liste");

    function ciz(filtre) {
        const f = (filtre || "").toLowerCase();
        const sonuc = DATASETLER.filter(d => d.toLowerCase().includes(f)).slice(0, 60);
        liste.innerHTML = "";
        if (!sonuc.length) {
            const li = document.createElement("li");
            li.className = "bos";
            li.textContent = DATASETLER.length
                ? "Eşleşen veri seti yok — yazdığınız ad yine de kullanılacak"
                : "Veri setleri okunamadı — adı elle yazabilirsiniz";
            liste.appendChild(li);
            return;
        }
        sonuc.forEach(ad => {
            const li = document.createElement("li");
            li.textContent = ad;
            // mousedown: input'un blur olayindan ONCE calissin diye
            li.onmousedown = e => {
                e.preventDefault();
                giris.value = ad;
                sec(ad);
                liste.classList.remove("acik");
            };
            liste.appendChild(li);
        });
    }

    function sec(deger) {
        secim[alan] = (deger || "").trim();
        giris.classList.toggle("secili", !!secim[alan]);
        seciciBtn.disabled = mesgul || !(secim.veri_seti && secim.sozluk);
    }

    giris.addEventListener("focus", () => { ciz(giris.value); liste.classList.add("acik"); });
    giris.addEventListener("input", () => { ciz(giris.value); liste.classList.add("acik"); sec(giris.value); });
    giris.addEventListener("blur",  () => { setTimeout(() => liste.classList.remove("acik"), 120); });
    giris.addEventListener("keydown", e => {
        if (e.key === "Escape") liste.classList.remove("acik");
        if (e.key === "Enter")  { e.preventDefault(); liste.classList.remove("acik"); }
    });
}

document.querySelectorAll(".combo").forEach(comboKur);

fetch(getWebAppBackendUrl("datasetler"))
    .then(r => r.json())
    .then(d => { DATASETLER = d.datasetler || []; })
    .catch(() => { DATASETLER = []; });

seciciBtn.onclick = () => {
    if (!secim.veri_seti || !secim.sozluk) return;
    gonder("veri seti " + secim.veri_seti + " ve sözlük " + secim.sozluk);
};


/* ==================== Gönderme ==================== */
function gonder(metinDisaridan) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    kartEl.classList.add("gizli");     // ilk mesajdan sonra kart kapanir
    balonEkle("kullanici", metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        const hataMi = typeof d.cevap === "string" && d.cevap.startsWith("HATA:");
        balonEkle("bot", d.cevap, hataMi);
        // Adim ilerledi: vurgu tasinir ama acilmis aciklama kapatilmaz.
        if (d.adim_no !== undefined) { aktifAdim = d.adim_no; listeyiCiz(); }
        ozetGuncelle(d.ozet);
    })
    .catch(e => { yaziyor.remove(); balonEkle("bot", "Bağlantı hatası: " + e, true); })
    .finally(() => { kilitle(false); kutuEl.focus(); });
}

gonderEl.onclick = () => gonder();
chipler.forEach(c => { c.onclick = () => gonder(c.dataset.mesaj); });

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 130) + "px";
});


/* ==================== Karşılama ==================== */
// Karsilama balonu, secim kartinin USTUNDE durmali.
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => {
        sohbetEl.insertBefore(balonYap("bot", d.metin), kartEl);
        ozetGuncelle(d.ozet);
    })
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e, true));


/* ==================== Yeni oturum ==================== */
document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        acikAdim = -1;
        secim.veri_seti = "";
        secim.sozluk = "";
        document.querySelectorAll(".combo-giris").forEach(g => {
            g.value = "";
            g.classList.remove("secili");
        });
        seciciBtn.disabled = true;
        kartEl.classList.remove("gizli");
        sohbetEl.appendChild(balonYap("bot", d.metin));
        sohbetEl.appendChild(kartEl);
        listeyiCiz();
        ozetGuncelle(d.ozet);
    });
};
