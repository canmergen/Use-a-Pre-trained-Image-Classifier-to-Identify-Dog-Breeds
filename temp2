:root {
  --kirmizi:      #E4002B;
  --kirmizi-koyu: #B00020;
  --kirmizi-acik: #FEF0F2;
  --zemin:        #F7F8FA;
  --kenar:        #E4E7EC;
  --kenar-acik:   #F0F1F4;
  --metin:        #101828;
  --gri:          #667085;
  --gri-acik:     #98A2B3;
  --yesil:        #12B76A;
  --sari:         #F79009;

  --panel-en:   clamp(230px, 17vw, 285px);
  --analiz-en:  clamp(280px, 22vw, 380px);
  --sohbet-en:  clamp(440px, 46vw, 700px);
  --yazi:       11.2px;
  --avatar:     28px;
  --ustbar-h:   86px;
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: #fff; border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}
#ustbar-sol { display: flex; align-items: center; gap: 15px; flex-shrink: 0; }
#banner { height: 28px; width: auto; display: block; }
#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 15px; line-height: 1.35; }
#urun-adi { font-weight: 600; font-size: 1.28em; letter-spacing: -.01em; white-space: nowrap; }
#urun-alt { font-size: .9em; color: var(--gri-acik); margin-top: 2px; white-space: nowrap; }

#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: .78em; font-weight: 600; letter-spacing: .08em;
  color: var(--gri-acik); text-transform: uppercase; margin-bottom: 3px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.05em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-deger.bos { color: var(--gri-acik); font-weight: 400; }
.ozet-ust {
  display: block; font-size: .84em; color: var(--gri); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-alt {
  display: block; font-size: .84em; color: var(--gri-acik); margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 7px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: 9px; }

#sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; padding: 0;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 6px; cursor: pointer; color: var(--gri); flex-shrink: 0;
}
#sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}
#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: .9em; color: var(--gri); white-space: nowrap;
}
.nokta-yesil { width: 8px; height: 8px; border-radius: 50%; background: var(--yesil); display: inline-block; }

#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 8px;
}
.sekme {
  flex: 1; font-size: .92em; font-weight: 500; padding: 6px 18px;
  border: none; background: none; border-radius: 6px;
  cursor: pointer; color: var(--gri); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: #fff; color: var(--metin); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff; font-weight: 600;
  box-shadow: 0 1px 3px rgba(228,0,43,.30);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }
#sayfa-calisma { display: flex; background: #fff; }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: #FCFCFD; border-right: 1px solid var(--kenar);
  padding: 20px 16px 30px; overflow-y: auto;
}
#panel::-webkit-scrollbar { width: 5px; }
#panel::-webkit-scrollbar-thumb { background: var(--kenar); border-radius: 3px; }

.panel-blok { margin-bottom: 24px; }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik {
  font-size: .8em; font-weight: 700; letter-spacing: .09em;
  color: var(--gri-acik); margin-bottom: 8px;
}
.panel-altbaslik {
  font-size: .92em; font-weight: 600; color: var(--metin);
  line-height: 1.45; margin: -2px 0 10px;
}
.panel-metin { margin: 0 0 9px; font-size: .9em; line-height: 1.6; color: var(--gri); }
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz agaci -------- */
.faz { margin-bottom: 3px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 9px;
  padding: 7px 8px; border-radius: 6px; cursor: pointer;
  color: var(--gri-acik);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: var(--kirmizi-acik); color: var(--kirmizi); }
.faz.tamam > .faz-bas { color: var(--gri); }

.faz-no {
  flex-shrink: 0; font-family: ui-monospace, Consolas, monospace;
  font-size: .8em; font-weight: 700; margin-top: 1px; opacity: .7;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: .96em; font-weight: 600; line-height: 1.3; }
.faz-ozet { font-size: .82em; opacity: .75; margin-top: 2px; line-height: 1.35; }
.faz-durum {
  flex-shrink: 0; font-size: .78em; font-family: ui-monospace, Consolas, monospace;
  margin-top: 2px; opacity: .8;
}

/* Alt adimlar sadece aktif fazda acik */
.faz-adimlar { list-style: none; margin: 2px 0 0; padding: 0 0 0 22px; display: none; }
.faz.aktif .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 5px; font-size: .9em;
  color: var(--gri-acik); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 13px; height: 13px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .6em; font-weight: 700;
}
.faz-adimlar li.tamam { color: var(--gri); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--kirmizi); font-weight: 600; }
.faz-adimlar li.aktif .adim-isaret { background: var(--kirmizi); border-color: var(--kirmizi); }

/* ==================== ORTA: AKTİF ADIM + SOHBET ==================== */
#sohbet-alani { flex: 1; display: flex; flex-direction: column; min-width: 0; }

#aktif-baslik {
  padding: 14px clamp(16px, 2vw, 30px) 12px;
  border-bottom: 1px solid var(--kenar); background: #FCFCFD; flex-shrink: 0;
}
#aktif-ad { font-size: 1.12em; font-weight: 600; }
#aktif-aciklama {
  font-size: .9em; color: var(--gri); line-height: 1.55; margin-top: 4px;
  max-width: 760px;
}

#sohbet { flex: 1; overflow-y: auto; padding: 18px clamp(16px, 2vw, 30px) 10px; }

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 auto 16px; max-width: var(--sohbet-en);
}
.satir.kullanici { flex-direction: row-reverse; }
.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: #fff; object-fit: cover;
  border: 1px solid var(--kenar);
}
.balon {
  padding: 11px 14px; border-radius: 10px;
  white-space: pre-wrap; word-break: break-word;
  line-height: 1.62; max-width: 82%;
  max-height: 360px; overflow-y: auto;
}
.satir.bot .balon {
  background: #fff; border: 1px solid var(--kenar);
  border-top-left-radius: 2px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .92em;
}
/* Kullanici balonu: yumusak kirmizi — ust bardaki tonla ayni aile */
.satir.kullanici .balon {
  background: var(--kirmizi-acik); color: var(--kirmizi-koyu);
  border: 1px solid #FCCFD6; border-top-right-radius: 2px; font-size: 1em;
}
.satir.bot .balon.hata { background: #FFFBFA; border-color: #FDA29B; color: #B42318; }

/* -------- Veri seçim kartı -------- */
#secici-kart {
  max-width: var(--sohbet-en); margin: 0 auto 18px;
  background: #fff; border: 1px solid var(--kenar); border-radius: 10px;
  padding: 16px 18px 18px; box-shadow: 0 1px 3px rgba(16,24,40,.05);
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 600; font-size: 1.05em; margin-bottom: 4px; }
.kart-alt { font-size: .9em; color: var(--gri); line-height: 1.55; margin-bottom: 14px; }
.kart-govde { display: flex; gap: 11px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 165px; }
.combo label { display: block; font-size: .85em; color: var(--gri); margin-bottom: 5px; font-weight: 500; }
.combo-giris {
  width: 100%; padding: 8px 10px; border: 1px solid var(--kenar); border-radius: 7px;
  font-family: ui-monospace, Consolas, monospace; font-size: .92em;
  outline: none; background: #fff;
}
.combo-giris:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
.combo-giris.secili { border-color: var(--yesil); }
.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 4px; list-style: none;
  background: #fff; border: 1px solid var(--kenar); border-radius: 7px;
  box-shadow: 0 8px 20px rgba(16,24,40,.12);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 6px 9px; border-radius: 5px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .9em;
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { color: var(--gri-acik); cursor: default; font-family: inherit; }
.combo-liste li.bos:hover { background: none; color: var(--gri-acik); }

#secici-btn {
  padding: 8px 20px; background: var(--kirmizi); color: #fff;
  border: none; border-radius: 7px; font-size: .95em; font-weight: 600;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#secici-btn:disabled { background: var(--kenar); color: var(--gri-acik); cursor: not-allowed; }

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: var(--gri-acik); animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* -------- Aksiyon butonları -------- */
#giris-bolge {
  border-top: 1px solid var(--kenar); background: #fff;
  padding: 12px clamp(16px, 2vw, 30px) 15px; flex-shrink: 0;
}
#aksiyonlar { max-width: var(--sohbet-en); margin: 0 auto 10px; display: flex; gap: 8px; }
.aksiyon {
  font-size: .95em; font-weight: 500; padding: 8px 18px;
  border: 1px solid var(--kenar); background: #fff; border-radius: 7px;
  cursor: pointer; color: var(--gri); white-space: nowrap;
}
.aksiyon:hover:not(:disabled) { border-color: var(--gri-acik); color: var(--metin); }
.aksiyon.birincil {
  background: var(--kirmizi); border-color: var(--kirmizi);
  color: #fff; font-weight: 600;
}
.aksiyon.birincil:hover:not(:disabled) {
  background: var(--kirmizi-koyu); border-color: var(--kirmizi-koyu);
}
.aksiyon:disabled { opacity: .45; cursor: not-allowed; }

#giris { max-width: var(--sohbet-en); margin: 0 auto; display: flex; gap: 8px; align-items: flex-end; }
#kutu {
  flex: 1; padding: 9px 12px; border: 1px solid var(--kenar); border-radius: 8px;
  font-family: inherit; font-size: 1em; line-height: 1.5;
  resize: none; outline: none; max-height: 120px; overflow-y: auto;
}
#kutu:focus { border-color: var(--kirmizi); box-shadow: 0 0 0 3px rgba(228,0,43,.08); }
#gonder {
  padding: 9px 22px; background: #fff; color: var(--gri);
  border: 1px solid var(--kenar); border-radius: 8px;
  font-size: 1em; font-weight: 500; cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { border-color: var(--kirmizi); color: var(--kirmizi); }
#gonder:disabled { opacity: .45; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ (TASLAK) ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: #FCFCFD; border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column; overflow: hidden;
}
#analiz-panel.kapali { display: none; }

#analiz-ust {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 14px 16px 12px; border-bottom: 1px solid var(--kenar);
  background: #fff; flex-shrink: 0;
}
#analiz-baslik { font-weight: 600; font-size: 1.02em; }
#analiz-alt { font-size: .84em; color: var(--sari); margin-top: 3px; font-weight: 500; }
#analiz-kapat {
  width: 22px; height: 22px; padding: 0; line-height: 1;
  border: none; background: none; color: var(--gri-acik);
  font-size: 1.3em; cursor: pointer; border-radius: 5px;
}
#analiz-kapat:hover { background: var(--kenar-acik); color: var(--metin); }

#analiz-sekmeler {
  display: flex; gap: 2px; padding: 8px 10px;
  border-bottom: 1px solid var(--kenar); background: #fff;
  overflow-x: auto; flex-shrink: 0;
}
#analiz-sekmeler::-webkit-scrollbar { height: 0; }
.analiz-sekme {
  font-size: .86em; font-weight: 500; padding: 5px 10px;
  border: none; background: none; border-radius: 5px;
  cursor: pointer; color: var(--gri-acik); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); color: var(--metin); }
.analiz-sekme.aktif { background: var(--kirmizi-acik); color: var(--kirmizi); font-weight: 600; }

#analiz-govde { flex: 1; overflow-y: auto; padding: 14px 16px 24px; }

.iskele-kart {
  background: #fff; border: 1px solid var(--kenar); border-radius: 8px;
  padding: 12px 14px; margin-bottom: 10px;
}
.iskele-baslik { font-size: .86em; font-weight: 600; margin-bottom: 8px; }
.iskele-satir {
  display: flex; justify-content: space-between; gap: 10px;
  font-size: .88em; padding: 4px 0; color: var(--gri);
}
.iskele-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--gri-acik); background: var(--kenar-acik);
  padding: 0 8px; border-radius: 3px;
}
.iskele-grafik {
  height: 76px; border-radius: 6px; margin-top: 4px;
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 6px,
    #fff 6px, #fff 12px);
  display: flex; align-items: center; justify-content: center;
  color: var(--gri-acik); font-size: .82em;
}
.iskele-not {
  font-size: .85em; color: var(--sari); line-height: 1.5;
  background: #FFFAEB; border: 1px solid #FEDF89; border-radius: 7px;
  padding: 9px 11px; margin-bottom: 12px;
}

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1280px; margin: 0 auto; padding: 26px clamp(18px, 2.4vw, 44px) 56px; }
#ozet-baslik-blok { margin-bottom: 20px; }
#ozet-h1 { margin: 0; font-size: 1.7em; font-weight: 600; letter-spacing: -.01em; }
#ozet-adim { font-size: .95em; color: var(--gri); margin-top: 5px; }

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 14px; align-items: start;
}
.ozet-blok {
  background: #fff; border: 1px solid var(--kenar); border-radius: 10px;
  padding: 15px 17px 13px; box-shadow: 0 1px 2px rgba(16,24,40,.04);
}
.ozet-blok-baslik {
  font-size: .8em; font-weight: 700; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 10px;
  padding-bottom: 8px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 5px 0; font-size: .95em; align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--gri); flex-shrink: 0; }
.ozet-satir-deger {
  font-family: ui-monospace, Consolas, monospace; color: var(--metin);
  text-align: right; font-weight: 500; word-break: break-word; min-width: 0;
}
#ozet-bos {
  background: #fff; border: 1px dashed var(--kenar); border-radius: 10px;
  padding: 40px; text-align: center; color: var(--gri-acik);
  font-size: 1em; grid-column: 1 / -1;
}

/* -------- Dar ekran -------- */
@media (max-width: 1500px) { #analiz-panel { display: none; } }
@media (max-width: 1280px) { #baslik-blok { display: none; } }
@media (max-width: 1080px) { #panel { display: none; } #ozet-serit { display: none; } }















const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl   = document.getElementById("sohbet");
const kutuEl     = document.getElementById("kutu");
const gonderEl   = document.getElementById("gonder");
const fazEl      = document.getElementById("faz-listesi");
const seritEl    = document.getElementById("ozet-serit");
const bannerEl   = document.getElementById("banner");
const kartEl     = document.getElementById("secici-kart");
const seciciBtn  = document.getElementById("secici-btn");
const aksiyonlar = Array.from(document.querySelectorAll(".aksiyon"));
const aktifAdEl  = document.getElementById("aktif-ad");
const aktifAckEl = document.getElementById("aktif-aciklama");

const sayfalar    = { calisma: document.getElementById("sayfa-calisma"),
                      ozet:    document.getElementById("sayfa-ozet") };
const sekmeler    = Array.from(document.querySelectorAll(".sekme"));
const ozetKartlar = document.getElementById("ozet-kartlar");
const ozetAdimEl  = document.getElementById("ozet-adim");

const analizPanel = document.getElementById("analiz-panel");
const analizGovde = document.getElementById("analiz-govde");
const analizSekme = Array.from(document.querySelectorAll(".analiz-sekme"));

let FAZLAR = [];
let DUZ_ADIMLAR = [];       // sira -> {anahtar, baslik, aciklama}
let DATASETLER = [];
let aktifAdim = 0;
let mesgul = false;

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };


/* ==================== Sayfa geçişi ==================== */
function sayfaAc(ad) {
    Object.keys(sayfalar).forEach(k => sayfalar[k].classList.toggle("gizli", k !== ad));
    sekmeler.forEach(s => s.classList.toggle("aktif", s.dataset.sayfa === ad));
}
sekmeler.forEach(s => { s.onclick = () => sayfaAc(s.dataset.sayfa); });


/* ==================== Sol panel: faz ağacı ==================== */
/* Sadece aktif fazin alt adimlari acik — 13 adim tek ekrana sigiyor. */
function fazlariCiz() {
    fazEl.innerHTML = "";
    FAZLAR.forEach(f => {
        const siralar = f.adimlar.map(a => a.sira);
        const bitis = Math.max.apply(null, siralar);
        const aktifMi = siralar.indexOf(aktifAdim) !== -1;
        const tamamMi = aktifAdim > bitis;

        const kok = document.createElement("div");
        kok.className = "faz" + (aktifMi ? " aktif" : "") + (tamamMi ? " tamam" : "");

        const bas = document.createElement("div");
        bas.className = "faz-bas";

        const no = document.createElement("span");
        no.className = "faz-no";
        no.textContent = f.no;
        bas.appendChild(no);

        const govde = document.createElement("div");
        govde.className = "faz-govde";
        const ad = document.createElement("div");
        ad.className = "faz-ad";
        ad.textContent = f.baslik;
        govde.appendChild(ad);
        const ozt = document.createElement("div");
        ozt.className = "faz-ozet";
        ozt.textContent = f.ozet;
        govde.appendChild(ozt);
        bas.appendChild(govde);

        const durum = document.createElement("span");
        durum.className = "faz-durum";
        const tamamSayi = siralar.filter(s => s < aktifAdim).length;
        durum.textContent = tamamMi ? "✓" : (tamamSayi + "/" + siralar.length);
        bas.appendChild(durum);

        kok.appendChild(bas);

        const liste = document.createElement("ol");
        liste.className = "faz-adimlar";
        f.adimlar.forEach(a => {
            const li = document.createElement("li");
            if (a.sira < aktifAdim)  li.className = "tamam";
            if (a.sira === aktifAdim) li.className = "aktif";

            const isaret = document.createElement("span");
            isaret.className = "adim-isaret";
            isaret.textContent = (a.sira < aktifAdim) ? "✓" : "";
            li.appendChild(isaret);

            const t = document.createElement("span");
            t.textContent = a.baslik;
            li.appendChild(t);
            liste.appendChild(li);
        });
        kok.appendChild(liste);
        fazEl.appendChild(kok);
    });

    const a = DUZ_ADIMLAR[aktifAdim];
    if (a) {
        aktifAdEl.textContent = a.no + "  " + a.baslik;
        aktifAckEl.textContent = a.aciklama || "";
    }
}

fetch(getWebAppBackendUrl("fazlar"))
    .then(r => r.json())
    .then(d => {
        FAZLAR = d.fazlar || [];
        DUZ_ADIMLAR = [];
        FAZLAR.forEach(f => f.adimlar.forEach(a => { DUZ_ADIMLAR[a.sira] = a; }));
        fazlariCiz();
    })
    .catch(() => { fazEl.textContent = "iş akışı yüklenemedi"; });


/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;
        kart.appendChild(deger);

        const ust = document.createElement("span");
        ust.className = "ozet-ust";
        ust.textContent = k.ust || "";
        ust.title = k.ust || "";
        kart.appendChild(ust);

        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        alt.title = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}

/* Veri seti ve sozluk secilene kadar secim karti acik kalir. */
function kartiGuncelle(o) {
    if (!o || !o.kartlar) return;
    const veri   = o.kartlar[0] && o.kartlar[0].deger;
    const sozluk = o.kartlar[1] && o.kartlar[1].deger;
    const kuruldu = veri && veri !== "—" && sozluk && sozluk !== "—";
    kartEl.classList.toggle("gizli", !!kuruldu);
    if (!kuruldu) {
        sohbetEl.appendChild(kartEl);
        sohbetEl.scrollTop = sohbetEl.scrollHeight;
    }
}


/* ==================== Özet sayfası ==================== */
function detayGuncelle(d) {
    if (!d) return;
    ozetAdimEl.textContent = "Adım " + d.adim_no + " / " + d.toplam + " · " + d.adim;
    ozetKartlar.innerHTML = "";

    const bolumler = d.bolumler || [];
    if (!bolumler.length) {
        const bos = document.createElement("div");
        bos.id = "ozet-bos";
        bos.textContent = "Henüz bir adım tamamlanmadı.";
        ozetKartlar.appendChild(bos);
        return;
    }

    bolumler.forEach(b => {
        const blok = document.createElement("div");
        blok.className = "ozet-blok";

        const bas = document.createElement("div");
        bas.className = "ozet-blok-baslik";
        bas.textContent = b.baslik;
        blok.appendChild(bas);

        (b.satirlar || []).forEach(ikili => {
            const satir = document.createElement("div");
            satir.className = "ozet-satir";

            const e = document.createElement("span");
            e.className = "ozet-satir-etiket";
            e.textContent = ikili[0];
            satir.appendChild(e);

            const v = document.createElement("span");
            v.className = "ozet-satir-deger";
            v.textContent = (ikili[1] === null || ikili[1] === undefined)
                ? "—" : String(ikili[1]);
            satir.appendChild(v);

            blok.appendChild(satir);
        });
        ozetKartlar.appendChild(blok);
    });
}


