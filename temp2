def kesif_plan(durum):
    baz = (durum.get("baz") or {}).get("dataset") or durum["veri_seti"]
    kolonlar = list(_df_oku(baz, limit=100).columns)
    sz = _df_oku(durum["sozluk"])

    ham = llm_mod.kesif_ifade_oner(
        sozluk_df=sz, kolonlar=kolonlar, meta=durum.get("meta", {}),
        sfa_ozet=(durum.get("sfa") or {}).get("en_iyi"))

    gecerli, reddedilen = [], []
    for o in ham:
        ok, hata, kullanilan = ifade_mod.dogrula(o["ifade"], kolonlar)
        if ok:
            o["kolonlar"] = kullanilan
            o["kod"] = ifade_mod.python_kodu(o["ad"], o["ifade"])
            gecerli.append(o)
        else:
            reddedilen.append((o.get("ad", "?"), hata))

    durum["hipotez"] = gecerli
    if not gecerli:
        return ("Model bu turda geçerli bir hipotez üretemedi.\n%s\n\n"
                "\"onay\" deyip bu adımı geçebiliriz."
                % _liste("Reddedilenler:", ["%s — %s" % r for r in reddedilen], 6))

    satirlar = []
    for i, o in enumerate(gecerli, 1):
        satirlar.append("  %2d. %s" % (i, o["ad"]))
        satirlar.append("      %s" % o["ifade"])
        if o.get("gerekce"):
            satirlar.append("      %s" % o["gerekce"][:88])

    red_not = ("\n\n%s" % _liste("Grameri geçemeyen öneriler (atıldı):",
                                 ["%s — %s" % r for r in reddedilen], 5)) if reddedilen else ""

    return ("Serbest keşif: model %s hipotez üretti. Her ifade denetimden "
            "geçti — kullanılan tüm kolonlar tabloda mevcut, yalnızca izinli "
            "operatörler var.\n\n%s%s\n\n"
            "Üretirken her birinin Python kodunu da yazacağım.\n\n"
            "Hepsi için \"onay\", seçmek için numara yazın: örn. \"2,4 onay\""
            % (_sayi(len(gecerli)), "\n".join(satirlar), red_not))


def kesif_uygula(durum, secim=None):
    hipotez = durum.get("hipotez") or []
    if secim is not None:
        hipotez = [h for i, h in enumerate(hipotez) if i in set(secim)]
    if not hipotez:
        return "Bu adımda üretim yapılmadı."

    hedef = "%s_ENRICHED" % durum["veri_seti"]
    kaynak = hedef if _dataset_var_mi(hedef) else \
        ((durum.get("baz") or {}).get("dataset") or durum["veri_seti"])
    df = _df_oku(kaynak)

    uretilen, kod_satirlari, hatali = [], [], []
    for h in hipotez:
        try:
            df[h["ad"]] = ifade_mod.degerlendir(df, h["ifade"])
            uretilen.append(h["ad"])
            kod_satirlari.append((h["ad"], h["kod"],
                                  "%s  |  %s" % (h["ifade"], h.get("gerekce", ""))))
        except Exception as e:
            hatali.append((h["ad"], str(e)[:60]))

    dataiku.Dataset(hedef).write_with_schema(df)
    durum["uretilen"] = sorted(set(durum.get("uretilen") or []) | set(uretilen))
    durum["kod_bloklari"] = (durum.get("kod_bloklari") or []) + \
                            [["Serbest keşif (yapay zekâ hipotezleri)", kod_satirlari]]

    script = ifade_mod.script_olustur(
        kaynak_dataset=(durum.get("baz") or {}).get("dataset") or durum["veri_seti"],
