    ).format(ad=ASAMA_ADLARI.get(asama, asama))


def _onceki_kayit_mesaji():
    """Kayitli oturumu varlik bazinda ozetler.

    Her varlik kendi blogunda anlatilir; satir/kolon sayisi hangi dataset'e
    ait oldugu acik olur. Sozluk ve eslesme durumu ayrica raporlanir.
    """
    satirlar = ["**Kayıtlı oturum**", ""]

    satirlar.append("**Veri seti — {}**".format(state.get(S.ONCEKI_VERI_SETI)))
    satirlar.append("{} satır, {} kolon".format(
        _sayi(state.get(S.ONCEKI_N_SATIR)),
        _sayi(state.get(S.ONCEKI_N_KOLON)),
    ))

    if state.get(S.ONCEKI_SOZLUK):
        satirlar.append("")
        satirlar.append("**Sözlük — {}**".format(state.get(S.ONCEKI_SOZLUK)))
        satirlar.append("{} kolon açıklaması".format(
            _sayi(state.get(S.ONCEKI_N_ACIKLAMA))))

        satirlar.append("")
        satirlar.append("**Eşleşme**")
        satirlar.append("{} kolonun açıklaması var.".format(
            _sayi(state.get(S.ONCEKI_ESLESEN))))

        aciklamasiz = state.get(S.ONCEKI_ACIKLAMASIZ) or []
        fazla = state.get(S.ONCEKI_FAZLA) or []
        if aciklamasiz:
            satirlar.append("Açıklaması olmayan {} kolon: {}".format(
                len(aciklamasiz), _kolon_listesi(aciklamasiz)))
        if fazla:
            satirlar.append("Sözlükte olup tabloda bulunmayan {} kolon: {}".format(
                len(fazla), _kolon_listesi(fazla)))
    else:
        satirlar.append("")
        satirlar.append("**Sözlük** — verilmemiş; açıklamalar kolon adlarından "
                        "çıkarılacak.")

    satirlar.append("")
    satirlar.append("Bu kayıtla devam edebilir ya da yeni bir veri setiyle "
                    "baştan başlayabiliriz. Hangisi olsun?")
    return "\n".join(satirlar)


