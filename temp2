"""Doğrulanmış aksiyonları sırayla çalıştırır; aşama geçişleri yalnızca burada ve işleyicilerde olur."""
from . import asamalar, kurulum, metin

ASAMA_ISLEYICILERI = {"kurulum": kurulum.ISLEYICILER}

YARDIM = metin.bolum(
    metin.baslik("Neler yapabilirim"),
    "Doğal dille konuşman yeterli; örneğin:",
    metin.kod("veri seti HAVALE_EFT_NTT, sözlük DEGISKENLER (ad SM_ID, açıklama aciklama)\n"
              "rn ve LOAD_DATE kolonlarını kapsam dışı bırak\n"
              "TXN_GDN kolonları ne anlatıyor?\n"
              "tamam, sonraki aşamaya geçelim"),
    "Kısayollar: `durum`, `onay`, `ret`, `geri`, `gec`, `yardim`.",
)


def _genel(state, aksiyon):
    asama = state["asama"]
    if aksiyon == "durum":
        return {"dogrudan_metin": state["durum_ozeti"]}
    if aksiyon == "yardim":
        return {"dogrudan_metin": YARDIM}
    if aksiyon == "geri":
        o = asamalar.onceki(asama)
        if o is None:
            return {"aksiyon": "geri", "durum": "hata", "mesaj": "İlk aşamadayız; geri dönülecek aşama yok."}
        state["asama"] = o
        return {"aksiyon": "geri", "durum": "ok", "mesaj": "Önceki aşamaya dönüldü.",
                "veri": {"yeni_asama": asamalar.etiket(o)}}
    if aksiyon == "gec":
        if asama in asamalar.ATLANAMAZ:
            return {"aksiyon": "gec", "durum": "hata",
                    "mesaj": f"'{asamalar.ETIKETLER[asama]}' zorunlu bir aşama, atlanamaz."}
        s = asamalar.sonraki(asama)
        state["asama"] = s
        return {"aksiyon": "gec", "durum": "ok", "mesaj": "Aşama atlandı.",
                "veri": {"yeni_asama": asamalar.etiket(s)}}
    if aksiyon in ("onay", "ret"):
        return {"aksiyon": aksiyon, "durum": "hata",
                "mesaj": f"'{asamalar.ETIKETLER[asama]}' aşamasında onaylanacak/reddedilecek bir sonuç yok."}
    return None


def calistir(state, aksiyonlar) -> dict:
    """Sonuç: anlat bloğuna verilecek JSON; 'dogrudan_metin' varsa LLM'e gitmeden basılır."""
    asama = state["asama"]
    sonuclar, oneriler = [], []
    for a in aksiyonlar:
        ad, args = a["aksiyon"], a.get("args", {})
        islem = ASAMA_ISLEYICILERI.get(asama, {}).get(ad)
        r = islem(state, args) if islem else _genel(state, ad)
        if r is None:
            r = {"aksiyon": ad, "durum": "hata", "mesaj": "Bu aşamada geçerli değil."}
        if "dogrudan_metin" in r:
            return r
        oneriler.extend(r.pop("oneriler", []))
        sonuclar.append(r)

    sonraki = ""
    if state["asama"] == "kurulum" and state["kurulum_dogrulandi"]:
        sonraki = "Kullanıcı onaylarsa 'Sözlük kontrolü' aşamasına geçilecek."
    elif state["asama"] != asama:
        sonraki = f"Şimdi {asamalar.etiket(state['asama'])} aşamasındayız."
    return {"asama": asamalar.etiket(state["asama"]), "sonuclar": sonuclar,
            "oneriler": oneriler, "sonraki_adim": sonraki}





