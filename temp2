# =============================================================================
# FEATURE_DISCOVERY_AGENT / sozluk_tamamla
# -----------------------------------------------------------------------------
# Sorumluluk : Sozluk hazirligi asamasinda eksik kolon aciklamalarini listeler,
#              kullanicidan tanim toplar ve sikistirmaya gecis onayini alir.
#
# NASIL CALISIR:
#   Bu blok iki yerden zincirlenir (Default next block ayari ile):
#     sozluk_calis -> sozluk_tamamla   (veri okunduktan sonra ilk rapor)
#     kolon_sorgu  -> sozluk_tamamla   (her tanim kaydindan sonra kalan rapor)
#   Boylece kullanici tanim yazdikca kalan eksik sayisi guncellenir.
#
#   Asama "sozluk" degilse sessizce cikar; kolon_sorgu baska asamalarda da
#   calisabildigi icin bu kontrol gerekli.
#
# Girdi      : sema.json, sozluk_ek.json
# Cikti      : Kullaniciya metin (yield)
# =============================================================================

import json

import dataiku


# -----------------------------------------------------------------------------
# Sabitler
# -----------------------------------------------------------------------------

HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

# Bu blok yalnizca bu asamada konusur.
ASAMA_SOZLUK = "sozluk"

# Mesajda tek seferde listelenecek azami eksik kolon sayisi.
AZAMI_LISTELENEN = 15


class Sema:
    """sema.json icindeki anahtarlar."""
    VERI_SETI = "veri_seti"
    SOZLUK_ADI = "sozluk_adi"
    KOLONLAR = "kolonlar"
    TIPLER = "tipler"
    SOZLUK = "sozluk"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"


class S:
    """state anahtarlari."""
    ASAMA = "asama"
    BEKLENEN = "beklenen"
    VERI_SETI = "veri_seti"
    SOZLUK = "sozluk"


class Beklenen:
    """durum_belirle ile ayni degerler."""
    KOLON_ACIKLAMASI = "kolon_aciklamasi"


# -----------------------------------------------------------------------------
# Yardimci fonksiyonlar
# -----------------------------------------------------------------------------

def _logla(mesaj):
    print("[sozluk_tamamla] {}".format(mesaj))


def _json_oku(dosya_yolu, varsayilan):
    """Managed folder icindeki bir JSON dosyasini okur."""
    try:
        folder = dataiku.Folder(HAFIZA_FOLDER)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _sayi(deger):
    """Binlik ayracli sayi metni: 1040 -> 1.040"""
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _eksikleri_bul(sema, ek_sozluk):
    """Aciklamasi olmayan kolon adlarini dondurur.

    Iki kaynak birlestirilir:
      - sema.json'daki tabloda_var_sozlukte_yok listesi
      - sozlukte yer alip degeri bos olan kolonlar
    Kullanicinin sozluk_ek.json'a girdigi tanimlar eksik SAYILMAZ.
    """
    sozluk = sema.get(Sema.SOZLUK)
    sozluk = sozluk if isinstance(sozluk, dict) else {}

    tablo_kolonlari = sema.get(Sema.KOLONLAR)
    tablo_kolonlari = tablo_kolonlari if isinstance(tablo_kolonlari, list) else []

    bildirilen = sema.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    bildirilen = bildirilen if isinstance(bildirilen, list) else []

    eksikler = []
    for kolon in tablo_kolonlari:
        if kolon in ek_sozluk and str(ek_sozluk[kolon]).strip():
            continue
        aciklama = sozluk.get(kolon)
        if aciklama is None or not str(aciklama).strip():
            eksikler.append(kolon)

    # sema.json'un bildirdigi ama tablo listesinde gozukmeyenleri de ekle.
    for kolon in bildirilen:
        if kolon not in eksikler and kolon not in ek_sozluk:
            eksikler.append(kolon)

    return eksikler


def _kolon_satiri(kolon, tipler):
    """Eksik kolonu tipiyle birlikte yazar."""
    tip = tipler.get(kolon)
    if tip:
        return "- `{kolon}` ({tip})".format(kolon=kolon, tip=tip)
    return "- `{kolon}`".format(kolon=kolon)


def _eksik_mesaji(eksikler, tipler, toplam_kolon, tanimli_sayi):
    """Eksik kolonlari listeler ve kullanicidan tanim ister."""
    satirlar = ["**Sözlük durumu**", ""]
    satirlar.append("{} kolondan {} tanesinin açıklaması var, {} tanesi "
                    "eksik.".format(
                        _sayi(toplam_kolon),
                        _sayi(tanimli_sayi),
                        _sayi(len(eksikler))))
    satirlar.append("")
    satirlar.append("**Açıklaması olmayan kolonlar**")

    for kolon in eksikler[:AZAMI_LISTELENEN]:
        satirlar.append(_kolon_satiri(kolon, tipler))

    kalan = len(eksikler) - AZAMI_LISTELENEN
    if kalan > 0:
        satirlar.append("- _ve {} kolon daha_".format(_sayi(kalan)))

    satirlar.append("")
    satirlar.append("Bu kolonların anlamını yazarsanız sözlüğe eklerim. "
                    "Örnek: `rn satır numarası`")
    satirlar.append("")
    satirlar.append("Mevcut bir açıklamayı değiştirmek isterseniz kolon adını "
                    "ve yeni açıklamasını yazmanız yeterli.")
    satirlar.append("")
    satirlar.append("Eksikleri boş bırakıp devam etmek isterseniz sözlük "
                    "sıkıştırmaya geçebiliriz.")
    return "\n".join(satirlar)


def _eksiksiz_mesaji(toplam_kolon):
    """Tum kolonlarin aciklamasi var."""
    return (
        "**Sözlük durumu**\n\n"
        "{} kolonun tamamının açıklaması var; eksik kalan yok.\n\n"
        "Bir açıklamayı değiştirmek isterseniz kolon adını ve yeni açıklamasını "
        "yazın. Değişiklik yoksa sözlük sıkıştırmaya geçebiliriz."
    ).format(_sayi(toplam_kolon))


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        asama = state.get(S.ASAMA)
        if asama != ASAMA_SOZLUK:
            # Baska bir asamadayiz; bu blok konusmaz.
            _logla("asama '{}', sessizce cikiliyor".format(asama))
            return

        sema = _json_oku(SEMA_DOSYASI, {})
        if not isinstance(sema, dict) or not sema:
            _logla("sema.json okunamadi veya bos")
            yield ("Sözlük durumunu çıkaramadım; oturum kaydı okunamıyor. "
                   "Ayrıntı agent log'unda.")
            return

        ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
        ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}

        tipler = sema.get(Sema.TIPLER)
        tipler = tipler if isinstance(tipler, dict) else {}

        tablo_kolonlari = sema.get(Sema.KOLONLAR)
        toplam_kolon = len(tablo_kolonlari) if isinstance(tablo_kolonlari, list) else 0

        eksikler = _eksikleri_bul(sema, ek_sozluk)
        tanimli_sayi = max(toplam_kolon - len(eksikler), 0)

        _logla("toplam={} tanimli={} eksik={}".format(
            toplam_kolon, tanimli_sayi, len(eksikler)))

        # Kullanicidan bir kolon aciklamasi bekliyoruz; girdi_al bunu bilmeli.
        state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI

        if eksikler:
            yield _eksik_mesaji(eksikler, tipler, toplam_kolon, tanimli_sayi)
        else:
            yield _eksiksiz_mesaji(toplam_kolon)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("Sözlük durumunu çıkarırken beklenmeyen bir hata oluştu. "
               "Ayrıntı agent log'una yazıldı.")
