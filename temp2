:root {
  --kirmizi:      #E4002B;
  --kirmizi-koyu: #B00020;
  --zemin:        #F7F8FA;
  --panel-zemin:  #FFFFFF;
  --kenar:        #E4E7EC;
  --metin:        #101828;
  --gri:          #667085;
  --gri-acik:     #98A2B3;
  --yesil:        #12B76A;
  --avatar:       36px;
  --panel-en:     240px;
  --sohbet-en:    820px;   /* sohbetin maksimum genisligi */
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; }

#kabuk {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--zemin);
  color: var(--metin);
  font-family: "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: 14px;
}

/* ================= ÜST BAR ================= */
#ustbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24px;
  height: 64px;
  background: #fff;
  border-bottom: 1px solid var(--kenar);
  box-shadow: 0 1px 2px rgba(16,24,40,.04);
  flex-shrink: 0;
}

#ustbar-sol { display: flex; align-items: center; gap: 16px; }

#banner { height: 30px; width: auto; display: block; }

#baslik-blok {
  border-left: 1px solid var(--kenar);
  padding-left: 16px;
  line-height: 1.3;
}
#urun-adi  { font-weight: 600; font-size: 14px; }
#urun-alt  { font-size: 11px; color: var(--gri-acik); }

#ustbar-sag { display: flex; align-items: center; gap: 14px; }

#durum-rozet {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--gri);
}
.nokta-yesil {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--yesil);
  display: inline-block;
}

#sifirla-btn {
  font-size: 12px;
  font-weight: 500;
  padding: 7px 14px;
  border: 1px solid var(--kenar);
  background: #fff;
  border-radius: 6px;
  cursor: pointer;
  color: var(--gri);
}
#sifirla-btn:hover { border-color: var(--kirmizi); color: var(--kirmizi); }

/* ================= GÖVDE ================= */
#govde { flex: 1; display: flex; min-height: 0; }

/* ---------- Sol panel ---------- */
#panel {
  width: var(--panel-en);
  flex-shrink: 0;
  background: var(--panel-zemin);
  border-right: 1px solid var(--kenar);
  padding: 22px 18px;
  overflow-y: auto;
}

.panel-baslik {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .09em;
  color: var(--gri-acik);
  margin-bottom: 12px;
}

#adim-listesi {
  list-style: none;
  margin: 0;
  padding: 0;
}

#adim-listesi li {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 10px;
  border-radius: 6px;
  font-size: 13px;
  color: var(--gri-acik);
  transition: background .15s;
}

/* Durum isareti: ○ bekleyen, ● aktif, ✓ tamamlanan */
#adim-listesi li::before {
  content: "○";
  font-size: 13px;
  width: 14px;
  text-align: center;
  flex-shrink: 0;
}
#adim-listesi li.tamam         { color: var(--gri); }
#adim-listesi li.tamam::before { content: "✓"; color: var(--yesil); font-weight: 700; }
#adim-listesi li.aktif {
  background: #FEF0F2;
  color: var(--kirmizi);
  font-weight: 600;
}
#adim-listesi li.aktif::before { content: "●"; color: var(--kirmizi); }

.panel-not {
  font-size: 12px;
  color: var(--gri);
  line-height: 2;
  padding: 0 10px;
}
.panel-not b {
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  color: var(--metin);
  background: var(--zemin);
  padding: 1px 5px;
  border-radius: 3px;
  font-size: 11px;
}

/* ---------- Sohbet ---------- */
#sohbet-alani {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

#sohbet {
  flex: 1;
  overflow-y: auto;
  padding: 28px 32px;
}

/* Icerik sabit genislikte ve ortalanmis; genis ekranda dagilmiyor. */
.satir {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin: 0 auto 20px;
  max-width: var(--sohbet-en);
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar);
  height: var(--avatar);
  min-width: var(--avatar);
  border-radius: 50%;
  background: #fff;
  object-fit: cover;
  border: 1px solid var(--kenar);
}

.balon {
  padding: 13px 16px;
  border-radius: 10px;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.65;
  max-width: 78%;
}

/* Bot ciktilari bosluklarla hizalaniyor -> monospace sart. */
.satir.bot .balon {
  background: #fff;
  border: 1px solid var(--kenar);
  border-top-left-radius: 2px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, "Courier New", monospace;
  font-size: 12.5px;
  box-shadow: 0 1px 2px rgba(16,24,40,.04);
}

.satir.kullanici .balon {
  background: var(--kirmizi);
  color: #fff;
  border-top-right-radius: 2px;
  font-size: 13.5px;
}

/* Hata balonu ayirt edilsin */
.satir.bot .balon.hata {
  background: #FFFBFA;
  border-color: #FDA29B;
  color: #B42318;
}

/* ---------- Yazıyor ---------- */
.nokta {
  display: inline-block;
  width: 6px; height: 6px;
  margin-right: 4px;
  border-radius: 50%;
  background: var(--gri-acik);
  animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .25; transform: translateY(0); }
  30%           { opacity: 1;   transform: translateY(-3px); }
}

/* ---------- Giriş ---------- */
#giris-bolge {
  border-top: 1px solid var(--kenar);
  background: #fff;
  padding: 14px 32px 18px;
  flex-shrink: 0;
}

#hizli-aksiyon {
  max-width: var(--sohbet-en);
  margin: 0 auto 10px;
  display: flex;
  gap: 8px;
}

.chip {
  font-family: ui-monospace, Consolas, monospace;
  font-size: 12px;
  padding: 5px 14px;
  border: 1px solid var(--kenar);
  background: var(--zemin);
  border-radius: 14px;
  cursor: pointer;
  color: var(--gri);
}
.chip:hover:not(:disabled) {
  border-color: var(--kirmizi);
  color: var(--kirmizi);
  background: #FEF0F2;
}
.chip:disabled { opacity: .45; cursor: not-allowed; }

#giris {
  max-width: var(--sohbet-en);
  margin: 0 auto;
  display: flex;
  gap: 10px;
  align-items: flex-end;
}

#kutu {
  flex: 1;
  padding: 11px 14px;
  border: 1px solid var(--kenar);
  border-radius: 8px;
  font-family: inherit;
  font-size: 14px;
  line-height: 1.5;
  resize: none;
  outline: none;
  max-height: 140px;
  overflow-y: auto;
}
#kutu:focus {
  border-color: var(--kirmizi);
  box-shadow: 0 0 0 3px rgba(228,0,43,.08);
}

#gonder {
  padding: 11px 26px;
  background: var(--kirmizi);
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
}
#gonder:hover:not(:disabled) { background: var(--kirmizi-koyu); }
#gonder:disabled { opacity: .45; cursor: not-allowed; }

/* ---------- Dar ekran ---------- */
@media (max-width: 900px) {
  #panel { display: none; }
  #sohbet, #giris-bolge { padding-left: 16px; padding-right: 16px; }
  #baslik-blok { display: none; }
}


















const OTURUM_ID = "oturum_" + Math.random().toString(36).slice(2, 10);

const GORSEL = {
    banner: getWebAppBackendUrl("gorsel/banner"),
    bot:    getWebAppBackendUrl("gorsel/bot"),
    user:   getWebAppBackendUrl("gorsel/user"),
};

const sohbetEl   = document.getElementById("sohbet");
const kutuEl     = document.getElementById("kutu");
const gonderEl   = document.getElementById("gonder");
const listeEl    = document.getElementById("adim-listesi");
const bannerEl   = document.getElementById("banner");
const chipler    = Array.from(document.querySelectorAll(".chip"));

let ADIMLAR = [];          // [{anahtar, baslik}]
let aktifAdim = 0;
let mesgul = false;

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };


/* ===================== Sol panel ===================== */
function listeyiCiz() {
    listeEl.innerHTML = "";
    ADIMLAR.forEach((a, i) => {
        const li = document.createElement("li");
        // "0. Kurulum" -> numarayi atip sadece adi gosteriyoruz
        li.textContent = a.baslik.replace(/^\d+\.\s*/, "");
        if (i < aktifAdim)  li.className = "tamam";
        if (i === aktifAdim) li.className = "aktif";
        listeEl.appendChild(li);
    });
}

fetch(getWebAppBackendUrl("adimlar"))
    .then(r => r.json())
    .then(d => { ADIMLAR = d.adimlar || []; listeyiCiz(); })
    .catch(() => { listeEl.innerHTML = "<li>yüklenemedi</li>"; });


/* ===================== Sohbet ===================== */
function balonEkle(rol, metin, hataMi) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Kullanıcı";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon" + (hataMi ? " hata" : "");
    balon.textContent = metin;      // textContent: metin HTML olarak yorumlanmaz
    satir.appendChild(balon);

    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    chipler.forEach(c => { c.disabled = durum; });
}


/* ===================== Gönderme ===================== */
function gonder(metinDisaridan) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    balonEkle("kullanici", metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        const hataMi = typeof d.cevap === "string" && d.cevap.startsWith("HATA:");
        balonEkle("bot", d.cevap, hataMi);
        if (d.adim_no !== undefined) {
            aktifAdim = d.adim_no;
            listeyiCiz();
        }
    })
    .catch(e => {
        yaziyor.remove();
        balonEkle("bot", "Bağlantı hatası: " + e, true);
    })
    .finally(() => {
        kilitle(false);
        kutuEl.focus();
    });
}

gonderEl.onclick = () => gonder();

chipler.forEach(c => {
    c.onclick = () => gonder(c.dataset.mesaj);
});

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});

// Kutu icerige gore buyusun (tek satirdan basliyor)
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 140) + "px";
});


/* ===================== Karşılama / sıfırlama ===================== */
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => balonEkle("bot", d.metin))
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e, true));

document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        listeyiCiz();
        balonEkle("bot", d.metin || d.cevap);
    });
};












