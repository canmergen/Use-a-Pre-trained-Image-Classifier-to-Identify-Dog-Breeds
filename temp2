            % _sayi(len(durum.get("uretilen", []))))


def kalite_uygula(durum):
    df = _df_oku("%s_ENRICHED" % durum["veri_seti"])
    target = durum["meta"]["target"]
    yeni = [c for c in durum.get("uretilen", []) if c in df.columns]
    y = pd.to_numeric(df[target], errors="coerce")

    eksik, sabit, sizinti = [], [], []
    for c in yeni:
        s = pd.to_numeric(df[c], errors="coerce")
        if s.isna().mean() > 0.5:
            eksik.append(c)
            continue
        if s.nunique(dropna=True) <= 1:
            sabit.append(c)
            continue
        kor = s.corr(y)
        if kor is not None and not pd.isna(kor) and abs(kor) > 0.95:
            sizinti.append(c)

    elendi = set(eksik) | set(sabit) | set(sizinti)
    durum["kalite"] = {"eksik": eksik, "sabit": sabit, "sizinti": sizinti,
                       "gecti": [c for c in yeni if c not in elendi]}

    return (_liste("Çok fazla boş değer:", eksik) + "\n\n" +
            _liste("Tek değer taşıyor:", sabit) + "\n\n" +
            _liste("Sızıntı şüpheli:", sizinti) +
            "\n\n%s kolon elemeden geçti, %s kolon elendi."
            % (_sayi(len(durum["kalite"]["gecti"])), _sayi(len(elendi))))


