def gelenekse_plan(durum):
    sz = _df_oku(durum["sozluk"])
    plan = llm_mod.gelenekse_plan_oner(
        sozluk_df=sz,
        haric=durum.get("haric_kolonlar", []),
        meta=durum.get("meta", {}),
    )
    durum["plan"] = plan

    if not plan:
        return ("Sözlüğü inceledim ama kullanılabilir bir plan çıkaramadım — "
                "model ya bozuk bir yanıt döndü ya da tanımadığı kolon adları "
                "önerdi.\n\n"
                "\"geri\" deyip sözlük adımına dönebilir, ya da \"onay\" deyip "
                "bu adımı boş geçebiliriz.")

    # Donusum turune gore kirilim — "32 firsat: 8 oran, 6 delta..." gorunumu
    kirilim = {}
    for p in plan:
        kirilim[p["donusum"]] = kirilim.get(p["donusum"], 0) + 1
    ozet_satir = " · ".join("%s %s" % (v, k) for k, v in sorted(kirilim.items()))

    satirlar = []
    for p in plan:
        satirlar.append("  %-26s → %-7s (%s kolon)"
                        % (p["ad"][:26], p["donusum"], _sayi(len(p["kolonlar"]))))
        if p.get("gerekce"):
            satirlar.append("      %s" % p["gerekce"][:90])

    toplam = sum(len(p["kolonlar"]) for p in plan)
    return ("Sözlüğü inceledim. %s dönüşüm fırsatı belirledim (%s):\n\n%s\n\n"
            "Bunlar yaklaşık %s yeni kolon üretir. Başlayalım mı?"
            % (_sayi(len(plan)), ozet_satir, "\n".join(satirlar), _sayi(toplam)))


def gelenekse_uygula(durum):
    return "Planı not aldım."


