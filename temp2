def baz_plan(durum):
    t = (durum.get("sfa") or {}).get("teshis") or {}
    dusur = sorted(set(t.get("cok_bos", []) + t.get("sabit", []) +
                       t.get("kimlik_gibi", []) + t.get("sizinti", [])))
    durum["_dusurulecek"] = dusur
    return ("Baz veri setini oluşturacağım — bundan sonraki tüm üretim bu "
            "donmuş set üzerinde yapılacak.\n\n"
            "  DÜŞÜR (%s kolon)\n"
            "    aşırı null %s · sabit %s · kimlik benzeri %s · sızıntı %s\n\n"
            "  DOLDUR\n"
            "    kalan sayısal kolonlardaki boşluklar medyan ile\n"
            "    (medyan, ortalamanın aksine uç değerlerden etkilenmez)\n\n"
            "  YAZ\n"
            "    %s_BAZ\n\n"
            "SFA'da FAIL alan ama teknik kusuru olmayan değişkenler "
            "kalıyor — bunlar kombinasyon içinde işe yarayabilir.\n\n"
            "Oluşturayım mı?"
            % (_sayi(len(dusur)), _sayi(len(t.get("cok_bos", []))),
               _sayi(len(t.get("sabit", []))), _sayi(len(t.get("kimlik_gibi", []))),
               _sayi(len(t.get("sizinti", []))), durum["veri_seti"]))


def baz_uygula(durum):
    df = _df_oku(durum["veri_seti"])
    dusur = [c for c in (durum.get("_dusurulecek") or []) if c in df.columns]
    df = df.drop(columns=dusur)

    for k in df.select_dtypes(include=[np.number]).columns:
        med = df[k].median()
        if not pd.isna(med):
            df[k] = df[k].fillna(med)

    baz_ds = "%s_BAZ" % durum["veri_seti"]
    dataiku.Dataset(baz_ds).write_with_schema(df)

    haric = set(durum.get("haric_kolonlar") or []) | set(dusur)
    durum["haric_kolonlar"] = sorted(haric)
    durum["baz"] = {"dataset": baz_ds, "doldurma": "medyan",
                    "kolon": int(df.shape[1])}

    return ("Baz veri seti hazır: %s — %s kolon.\n"
            "%s kolon düşürüldü, kalan sayısal kolonlar medyan ile dolduruldu."
            % (baz_ds, _sayi(df.shape[1]), _sayi(len(dusur))))


