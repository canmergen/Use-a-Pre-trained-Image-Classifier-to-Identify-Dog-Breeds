Başlamak için veri seti ve değişken sözlüğünü seçin."""


# ===========================================================================
# DURUM — folder'da JSON. Backend restart olunca sohbet kaybolmasin diye.
# ===========================================================================
def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _yol(oturum_id):
    return "/oturum_%s.json" % re.sub(r"[^A-Za-z0-9_-]", "", str(oturum_id))


def yeni_durum():
    return {
        "i": 0,                  # ADIM_SIRASI icindeki konum
        "bekleyen": "girdi",     # "girdi" | "onay"
        "veri_seti": None,
        "sozluk": None,
        "haric_kolonlar": [],
        "meta": {},
        "profil": {},            # ust seritteki kartlarin kaynagi
        "plan": [],
        "uretilen": [],
        "kalite": {},
        "model": {},
    }


def durum_yukle(oturum_id):
    try:
        with _folder().get_download_stream(_yol(oturum_id)) as s:
            return json.loads(s.read().decode("utf-8"))
    except Exception:
        return yeni_durum()


def durum_kaydet(oturum_id, durum):
    veri = json.dumps(durum, ensure_ascii=False, indent=2).encode("utf-8")
    _folder().upload_stream(_yol(oturum_id), veri)


# ===========================================================================
# YARDIMCILAR
# ===========================================================================
def _df_oku(dataset_adi, limit=OKUMA_LIMITI):
    return dataiku.Dataset(dataset_adi).get_dataframe(limit=limit)


def _dataset_var_mi(ad):
    try:
        dataiku.Dataset(ad).get_config()
        return True
    except Exception:
        return False


def _sayi(n):
    """1042 -> '1.042' (Turkce binlik ayraci)."""
    try:
        return "{:,}".format(int(n)).replace(",", ".")
    except Exception:
        return str(n)


def _ondalik(x, basamak=1):
    return ("%.*f" % (basamak, x)).replace(".", ",")


def _liste(baslik, satirlar, en_fazla=20):
    if not satirlar:
        return baslik + "\n  (yok)"
    govde = "\n".join("  • %s" % s for s in satirlar[:en_fazla])
    if len(satirlar) > en_fazla:
        govde += "\n  … (+%d tane daha)" % (len(satirlar) - en_fazla)
    return baslik + "\n" + govde


def ozet(durum):
    """Ust seritteki 4 kart. Veri OKUMAZ — adimlar ilerledikce durum['profil']
    icine yazilan degerleri okur; her mesajda 1042 kolonluk tablo acilmasin diye."""
    m = durum.get("meta") or {}
    p = durum.get("profil") or {}
    k = durum.get("kalite") or {}
    bos = "—"

    # --- Veri seti ---
    if p.get("kolon"):
        satir = _sayi(p["satir"]) + ("+" if p.get("satir_ustsinir") else "")
        veri_alt = "%s satır × %s kolon" % (satir, _sayi(p["kolon"]))
    else:
        veri_alt = "seçilmedi"

    # --- Sozluk ---
    if p.get("eslesen") is not None:
        sozluk_alt = "%s / %s eşleşti · %%%s kapsam" % (
            _sayi(p["eslesen"]), _sayi(p["kolon"]), _ondalik(p.get("kapsam", 0)))
    elif p.get("sozluk_satir"):
        sozluk_alt = "%s tanım" % _sayi(p["sozluk_satir"])
    else:
        sozluk_alt = "seçilmedi"

    # --- Hedef ---
    hedef_alt = p.get("hedef_ozet") or ("tanımlanmadı" if not m.get("target") else "")

    # --- Degisken seti ---
    uretilen = len(durum.get("uretilen") or [])
    if uretilen and p.get("kolon"):
        deger = "%s → %s" % (_sayi(p["kolon"]), _sayi(p["kolon"] + uretilen))
        alt = "+%s yeni" % _sayi(uretilen)
        if k:
            elenen = uretilen - len(k.get("gecti") or [])
            alt += " · %s elendi" % _sayi(elenen)
    elif durum.get("plan"):
        deger = bos
        alt = "%s dönüşüm planlandı" % _sayi(len(durum["plan"]))
    else:
        deger = bos
        alt = "henüz üretilmedi"

    return {"kartlar": [
        {"etiket": "Veri seti",     "deger": durum.get("veri_seti") or bos, "alt": veri_alt},
        {"etiket": "Sözlük",        "deger": durum.get("sozluk") or bos,    "alt": sozluk_alt},
        {"etiket": "Hedef",         "deger": m.get("target") or bos,        "alt": hedef_alt},
        {"etiket": "Değişken seti", "deger": deger,                          "alt": alt},
    ]}


