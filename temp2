def mod_girdi(durum, mesaj):
    m = MOD_KALIP.search(mesaj or "")
    if not m:
        return False, (
            "Nereden başlayacağımızı seçin:\n\n"
            "  A — Ham tablolardan başla\n"
            "      Birden fazla ham tabloyu birleştirir, işlem tablolarından\n"
            "      zaman pencereli toplamalar üretir, ardından sözlüğü yazar.\n"
            "      Sonuçta %s ve %s oluşur.\n\n"
            "  B — Veri seti hazır, sözlük yok\n"
            "      Mevcut veri setinin kolonlarını inceleyip açıklamalarını\n"
            "      üretir; %s oluşur.\n\n"
            "  C — İkisi de hazır\n"
            "      Doğrudan analiz ve değişken üretimine geçer.\n\n"
            "A, B ya da C yazın." % (BAZ_ADI, SOZLUK_ADI, SOZLUK_ADI))

    secim = m.group(2).upper()
    durum["mod"] = {"1": "A", "2": "B", "3": "C"}.get(secim, secim)
    return True, None


