@app.route("/karsilama")
def karsilama():
    durum = akis.yeni_durum()
    return jsonify({"metin": akis.KARSILAMA,
                    "ozet": akis.ozet(durum),
                    "detay": akis.detay(durum)})


@app.route("/mesaj", methods=["POST"])
def mesaj():
    try:
        govde = request.get_json(force=True) or {}
        oturum_id = govde.get("oturum_id") or "varsayilan"

        durum = akis.durum_yukle(oturum_id)
        cevap = akis.mesaj_isle(durum, govde.get("mesaj", ""))
        akis.durum_kaydet(oturum_id, durum)

        return jsonify({
            "cevap": cevap,
            "adim": akis.ADIM_SIRASI[durum["i"]],
            "adim_no": durum["i"],
            "toplam": len(akis.ADIM_SIRASI),
            "ozet": akis.ozet(durum),
            "detay": akis.detay(durum),
        })
    except Exception as e:
        return jsonify({
            "cevap": "HATA: %s\n\n%s" % (e, traceback.format_exc()[-1000:])
        }), 200


