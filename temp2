# DURUM — folder'da JSON. Backend restart olunca sohbet kaybolmasin diye.
# ===========================================================================
def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _yol(oturum_id):
    return "/oturum_%s.json" % re.sub(r"[^A-Za-z0-9_-]", "", str(oturum_id))


def yeni_durum():
    return {
        "i": 0,                  # ADIM_SIRASI icindeki konum
        "bekleyen": "girdi",     # "girdi" | "onay"
        "veri_seti": None,
        "sozluk": None,
        "haric_kolonlar": [],
        "meta": {},
        "plan": [],
        "uretilen": [],
        "kalite": {},
        "model": {},
    }


def durum_yukle(oturum_id):
    try:
        with _folder().get_download_stream(_yol(oturum_id)) as s:
            return json.loads(s.read().decode("utf-8"))
    except Exception:
        return yeni_durum()


def durum_kaydet(oturum_id, durum):
    veri = json.dumps(durum, ensure_ascii=False, indent=2).encode("utf-8")
    _folder().upload_stream(_yol(oturum_id), veri)


def ozet(durum):
    """Ust seritte gosterilecek oturum ozeti."""
    m = durum.get("meta") or {}
    return {
        "veri_seti": durum.get("veri_seti"),
        "sozluk": durum.get("sozluk"),
        "target": m.get("target"),
        "haric": len(durum.get("haric_kolonlar") or []),
        "uretilen": len(durum.get("uretilen") or []),
        "gecti": len((durum.get("kalite") or {}).get("gecti") or []),
