# =============================================================================
# FEATURE_DISCOVERY_AGENT / oneri_isle
# -----------------------------------------------------------------------------
# Sorumluluk : LLM'in urettigi kolon aciklamasi onerilerini kullaniciya sunar
#              ve onay gelirse uc yere birden kaydeder.
#
# IKI MODDA CALISIR (state["beklenen"] degerine gore):
#   SUNUM : oneri_uret'ten gelinir. Onerileri listeler, onay ister ve
#           beklenen'i "oneri_onayi" yapar.
#   KAYIT : durum_belirle'den gelinir (kullanici onay verdi). Varsa
#           kullanicinin duzeltmelerini onerilerin uzerine uygular, sonra
#           sozluk_ek.json, sema.json ve DEGISKENLER_GUNCEL'e yazar.
#
# Kullanici "hepsini kabul, sadece rn su olsun" diyebilir: aksiyon onay
# gelir, duzeltmeler listesi o kolonu tasir. Duzeltilen kolonlarda
# kullanicinin metni kazanir, digerlerinde LLM onerisi kalir.
#
# Kaynak sozluk (DEGISKENLER) DEGISTIRILMEZ.
# =============================================================================

import json

import pandas as pd

import dataiku


# -----------------------------------------------------------------------------
# Sabitler
# -----------------------------------------------------------------------------

HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"
GUNCEL_SOZLUK_DATASET = "DEGISKENLER_GUNCEL"

VARSAYILAN_AD_KOLONU = "kolon"
VARSAYILAN_ACIKLAMA_KOLONU = "aciklama"

GUVEN_ETIKETLERI = {
    "yuksek": "yüksek güven",
    "orta": "orta güven",
    "dusuk": "düşük güven",
}


class Sema:
    """sema.json icindeki anahtarlar."""
    SOZLUK = "sozluk"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"


class S:
    """state anahtarlari."""
    BEKLENEN = "beklenen"
    ONERILER = "oneriler"
    ONERI_LISTESI = "oneri_listesi"
    DUZELTMELER = "duzeltmeler"
    KOLONLAR = "kolonlar"
    KOLON_ACIKLAMASI = "kolon_aciklamasi"


class Beklenen:
    """durum_belirle ile ayni degerler."""
    ONERI_ONAYI = "oneri_onayi"
    KOLON_ACIKLAMASI = "kolon_aciklamasi"


# -----------------------------------------------------------------------------
# Dosya islemleri
# -----------------------------------------------------------------------------

def _logla(mesaj):
    print("[oneri_isle] {}".format(mesaj))


def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _json_oku(dosya_yolu, varsayilan):
    """Managed folder icindeki bir JSON dosyasini okur."""
    try:
        folder = _folder()
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _json_yaz(dosya_yolu, veri):
    """Managed folder icine JSON yazar. Basarisizsa False doner."""
    try:
        icerik = json.dumps(veri, ensure_ascii=False, indent=2)
        _folder().upload_data(dosya_yolu, icerik.encode("utf-8"))
        return True
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(dosya_yolu, hata))
        return False


def _onerileri_coz(ham):
    """oneri_uret ciktisini [{kolon, aciklama, guven, gerekce}] listesine cevirir."""
    veri = ham
    if isinstance(ham, str):
        metin = ham.strip()
        if metin.startswith("```"):
            metin = metin.strip("`").strip()
            if metin.lower().startswith("json"):
                metin = metin[4:].strip()
        bas = metin.find("{")
        son = metin.rfind("}")
        if bas != -1 and son > bas:
            metin = metin[bas:son + 1]
        try:
            veri = json.loads(metin)
        except (ValueError, TypeError):
            _logla("oneri JSON'u cozulemedi: {!r}".format(str(ham)[:300]))
            return []

    if isinstance(veri, dict):
        liste = veri.get("oneriler")
    elif isinstance(veri, list):
        liste = veri
    else:
        liste = None

    if not isinstance(liste, list):
        return []

    temiz = []
    for kayit in liste:
        if not isinstance(kayit, dict):
            continue
        kolon = str(kayit.get("kolon") or "").strip()
        aciklama = str(kayit.get("aciklama") or "").strip()
        if not kolon:
            continue
        temiz.append({
            "kolon": kolon,
            "aciklama": aciklama,
            "guven": str(kayit.get("guven") or "orta").strip().lower(),
            "gerekce": str(kayit.get("gerekce") or "").strip(),
            "kaynak": "oneri",
        })
    return temiz


def _duzeltmeleri_topla():
    """Kullanicinin bu turda verdigi kolon duzeltmelerini dondurur.

    Iki kaynaktan okunur:
      - state["duzeltmeler"] : coklu duzeltme listesi
      - state["kolonlar"] + state["kolon_aciklamasi"] : tekil duzeltme
    Doner: {kolon: aciklama}
    """
    sonuc = {}

    ham = state.get(S.DUZELTMELER)
    if isinstance(ham, list):
        for kayit in ham:
            if not isinstance(kayit, dict):
                continue
            kolon = str(kayit.get("kolon") or "").strip()
            aciklama = str(kayit.get("aciklama") or "").strip()
            if kolon and aciklama:
                sonuc[kolon] = aciklama

    kolonlar = state.get(S.KOLONLAR) or []
    aciklama = str(state.get(S.KOLON_ACIKLAMASI) or "").strip()
    if isinstance(kolonlar, list) and kolonlar and aciklama:
        kolon = str(kolonlar[0]).strip()
        if kolon:
            sonuc[kolon] = aciklama

    return sonuc


def _duzeltmeleri_uygula(oneriler, duzeltmeler):
    """Kullanici metnini onerinin uzerine yazar.

    Duzeltilen kolon onerilerde yoksa yeni kayit olarak eklenir.
    Doner: (guncel_oneriler, degistirilen_kolonlar)
    """
    if not duzeltmeler:
        return oneriler, []

    kalanlar = dict(duzeltmeler)
    degisenler = []

    for oneri in oneriler:
        yeni = kalanlar.pop(oneri["kolon"], None)
        if yeni is None:
            # Buyuk/kucuk harf duyarsiz ikinci deneme
            for anahtar in list(kalanlar):
                if anahtar.lower() == oneri["kolon"].lower():
                    yeni = kalanlar.pop(anahtar)
                    break
        if yeni is not None:
            oneri["aciklama"] = yeni
            oneri["kaynak"] = "kullanici"
            oneri["guven"] = "yuksek"
            degisenler.append(oneri["kolon"])

    # Onerilerde bulunmayan ama kullanicinin tanimladigi kolonlar
    for kolon, aciklama in kalanlar.items():
        oneriler.append({
            "kolon": kolon,
            "aciklama": aciklama,
            "guven": "yuksek",
            "gerekce": "",
            "kaynak": "kullanici",
        })
        degisenler.append(kolon)

    return oneriler, degisenler


# -----------------------------------------------------------------------------
# Sunum modu
# -----------------------------------------------------------------------------

def _sunum_mesaji(oneriler):
    """Onerileri kullaniciya listeler ve onay ister."""
    dolu = [o for o in oneriler if o["aciklama"]]
    bos = [o for o in oneriler if not o["aciklama"]]

    parcalar = ["\n\n**Önerilen açıklamalar**", ""]

    for oneri in dolu:
        etiket = GUVEN_ETIKETLERI.get(oneri["guven"], oneri["guven"])
        satir = "**{kolon}** — {aciklama}  _({guven})_".format(
            kolon=oneri["kolon"], aciklama=oneri["aciklama"], guven=etiket)
        if oneri["gerekce"]:
            satir += "\n{}".format(oneri["gerekce"])
        parcalar.append(satir)
        parcalar.append("")

    if bos:
        adlar = ", ".join("`{}`".format(o["kolon"]) for o in bos)
        parcalar.append("Şu kolonlar için öneri üretemedim: {}".format(adlar))
        parcalar.append("")

    parcalar.append("Onaylarsanız hepsini kaydederim. Bir kısmını değiştirmek "
                    "isterseniz sadece onları yazın; örneğin "
                    "`tamam ama rn satır sırası olsun` derseniz diğerleri "
                    "önerildiği gibi kalır.")
    return "\n".join(parcalar)


# -----------------------------------------------------------------------------
# Kayit modu
# -----------------------------------------------------------------------------

def _semayi_guncelle(yeni_tanimlar):
    """Tanimlari sema.json'a isler ve eksik listesinden cikarir."""
    sema = _json_oku(SEMA_DOSYASI, {})
    if not isinstance(sema, dict) or not sema:
        _logla("sema.json bos veya okunamadi")
        return False

    sozluk = sema.get(Sema.SOZLUK)
    if not isinstance(sozluk, dict):
        sozluk = {}
    sozluk.update(yeni_tanimlar)
    sema[Sema.SOZLUK] = sozluk

    eksikler = sema.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    if isinstance(eksikler, list):
        sema[Sema.TABLODA_VAR_SOZLUKTE_YOK] = [
            k for k in eksikler if k not in yeni_tanimlar]

    return _json_yaz(SEMA_DOSYASI, sema)


def _guncel_sozlugu_yaz(ek_sozluk):
    """Kaynak sozluk + eklenen tanimlari DEGISKENLER_GUNCEL'e yazar.

    Doner: (basarili_mi, toplam_satir)
    """
    sema = _json_oku(SEMA_DOSYASI, {})
    sozluk = sema.get(Sema.SOZLUK) if isinstance(sema, dict) else {}
    sozluk = sozluk if isinstance(sozluk, dict) else {}

    birlesik = dict(sozluk)
    birlesik.update(ek_sozluk)

    adlar = sorted(birlesik.keys())
    df = pd.DataFrame({
        VARSAYILAN_AD_KOLONU: adlar,
        VARSAYILAN_ACIKLAMA_KOLONU: [birlesik[ad] for ad in adlar],
        "kaynak": ["eklenen" if ad in ek_sozluk else "sozluk" for ad in adlar],
    })

    try:
        dataiku.Dataset(GUNCEL_SOZLUK_DATASET).write_with_schema(df)
        _logla("{} yazildi: {} satir".format(GUNCEL_SOZLUK_DATASET, len(df)))
        return True, len(df)
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(GUNCEL_SOZLUK_DATASET, hata))
        return False, len(df)


def _sayi(deger):
    """Binlik ayracli sayi metni."""
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _kayit_mesaji(oneriler, degisenler, toplam, basarisizlar):
    """Kayit sonucunu ozetler."""
    kullanici_yazdi = [o["kolon"] for o in oneriler
                       if o["aciklama"] and o.get("kaynak") == "kullanici"]
    oneri_kaldi = [o["kolon"] for o in oneriler
                   if o["aciklama"] and o.get("kaynak") != "kullanici"]

    parcalar = ["\n\n**Sözlük güncellendi**", ""]

    if oneri_kaldi:
        parcalar.append("Öneri olarak kaydedilen: {}".format(
            ", ".join("**{}**".format(k) for k in sorted(oneri_kaldi))))
    if kullanici_yazdi:
        parcalar.append("Sizin yazdığınız: {}".format(
            ", ".join("**{}**".format(k) for k in sorted(kullanici_yazdi))))

    parcalar.append("")

    if basarisizlar:
        parcalar.append("Şuralara yazılamadı: {}. Ayrıntı agent log'unda.".format(
            ", ".join(basarisizlar)))
        return "\n".join(parcalar)

    parcalar.append("**{ds}** artık {toplam} satır. Kaynak sözlük "
                    "değiştirilmedi; bundan sonraki adımlar güncel sözlüğü "
                    "kullanacak.".format(
                        ds=GUNCEL_SOZLUK_DATASET, toplam=_sayi(toplam)))
    parcalar.append("")
    parcalar.append("Sözlük sıkıştırmaya geçebiliriz.")
    return "\n".join(parcalar)


def _onerileri_kaydet(oneriler, degisenler):
    """Dolu onerileri uc yere birden yazar ve sonuc mesajini dondurur."""
    yeni_tanimlar = {o["kolon"]: o["aciklama"] for o in oneriler if o["aciklama"]}

    if not yeni_tanimlar:
        return "\n\nKaydedilecek bir açıklama yok."

    ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
    ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}
    ek_sozluk.update(yeni_tanimlar)

    ek_yazildi = _json_yaz(EK_SOZLUK_DOSYASI, ek_sozluk)
    sema_yazildi = _semayi_guncelle(yeni_tanimlar)
    ds_yazildi, toplam = _guncel_sozlugu_yaz(ek_sozluk)

    basarisizlar = []
    if not ek_yazildi:
        basarisizlar.append("kullanıcı tanımları dosyası")
    if not sema_yazildi:
        basarisizlar.append("oturum kaydı (sema.json)")
    if not ds_yazildi:
        basarisizlar.append(GUNCEL_SOZLUK_DATASET)

    return _kayit_mesaji(oneriler, degisenler, toplam, basarisizlar)


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        # KAYIT MODU: kullanici onerileri onayladi (belki duzelterek).
        if state.get(S.BEKLENEN) == Beklenen.ONERI_ONAYI:
            saklanan = state.get(S.ONERI_LISTESI) or []
            if not saklanan:
                state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI
                yield ("\n\nOnaylanacak bir öneri bulamadım; liste boşalmış "
                       "görünüyor. Kolon adı ve açıklamasını yazarsanız "
                       "doğrudan kaydederim.")
                return

            duzeltmeler = _duzeltmeleri_topla()
            if duzeltmeler:
                _logla("kullanici duzeltmeleri: {}".format(list(duzeltmeler)))
            saklanan, degisenler = _duzeltmeleri_uygula(saklanan, duzeltmeler)

            state[S.ONERI_LISTESI] = None
            state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI
            yield _onerileri_kaydet(saklanan, degisenler)
            return

        # SUNUM MODU: oneri_uret'ten yeni geldik.
        oneriler = _onerileri_coz(state.get(S.ONERILER))
        if not oneriler:
            _logla("oneri uretilemedi veya cozulemedi")
            state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI
            yield ("\n\nBu kolonlar için otomatik öneri üretemedim. Anlamlarını "
                   "kendiniz yazarsanız sözlüğe eklerim.")
            return

        state[S.ONERI_LISTESI] = oneriler
        state[S.BEKLENEN] = Beklenen.ONERI_ONAYI
        _logla("{} oneri sunuldu".format(len(oneriler)))
        yield _sunum_mesaji(oneriler)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        state[S.BEKLENEN] = Beklenen.KOLON_ACIKLAMASI
        yield ("\n\nÖnerileri işlerken beklenmeyen bir hata oluştu. Ayrıntı "
               "agent log'una yazıldı.")






