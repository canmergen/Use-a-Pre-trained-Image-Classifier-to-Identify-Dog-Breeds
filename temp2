import json
import dataiku
from dataiku.llm.python.blocks_graph import NextBlock

FOLDER_ADI = "PROJE_HAFIZASI"


def process(trace):
    veri_seti = state.get("veri_seti")
    sozluk_adi = state.get("sozluk")
    sozluk_var = bool(state.get("sozluk_var"))

    if not veri_seti:
        yield "Veri seti adı bulunamadı, sözlük hazırlığına başlayamıyorum."
        yield NextBlock("sohbet")
        return

    # 1) Dataset şeması — veriyi belleğe almadan
    ds = dataiku.Dataset(veri_seti)
    sema = ds.read_schema()
    kolonlar = [c["name"] for c in sema]
    tipler = {c["name"]: c["type"] for c in sema}

    # Satır sayısı — sadece ilk kolonu okuyarak (büyük tabloda tam okuma yapılmaz)
    try:
        n_satir = int(ds.get_dataframe(columns=[kolonlar[0]]).shape[0])
    except Exception:
        n_satir = None

    # 2) Sözlük
    sozluk_map = {}
    if sozluk_var and sozluk_adi:
        sdf = dataiku.Dataset(sozluk_adi).get_dataframe()
        ad_kol, acik_kol = sdf.columns[0], sdf.columns[1]
        sozluk_map = dict(zip(sdf[ad_kol].astype(str), sdf[acik_kol].astype(str)))

    # 3) Karşılaştırma
    sozlukte_var_tabloda_yok = sorted(set(sozluk_map) - set(kolonlar))
    tabloda_var_sozlukte_yok = sorted(set(kolonlar) - set(sozluk_map))

    # 4) Folder'a yaz
    kayit = {
        "veri_seti": veri_seti,
        "sozluk": sozluk_adi if sozluk_var else None,
        "n_satir": n_satir,
        "n_kolon": len(kolonlar),
        "kolonlar": kolonlar,
        "tipler": tipler,
        "sozluk": sozluk_map,
        "sozlukte_var_tabloda_yok": sozlukte_var_tabloda_yok,
        "tabloda_var_sozlukte_yok": tabloda_var_sozlukte_yok,
    }
    folder = dataiku.Folder(FOLDER_ADI)
    folder.upload_data(
        "sema.json",
        json.dumps(kayit, ensure_ascii=False, indent=2).encode("utf-8"),
    )

    # 5) Özet — state'e ve kullanıcıya
    satirlar = [
        f"**{veri_seti}** okundu: {n_satir if n_satir is not None else '?'} satır, {len(kolonlar)} kolon.",
    ]
    if sozluk_var:
        satirlar.append(f"**{sozluk_adi}** sözlüğünde {len(sozluk_map)} kolon açıklaması var.")
        if sozlukte_var_tabloda_yok:
            satirlar.append(
                f"Sözlükte olup tabloda olmayan {len(sozlukte_var_tabloda_yok)} kolon: "
                + ", ".join(sozlukte_var_tabloda_yok[:10])
                + (" …" if len(sozlukte_var_tabloda_yok) > 10 else "")
            )
        if tabloda_var_sozlukte_yok:
            satirlar.append(
                f"Tabloda olup sözlükte olmayan {len(tabloda_var_sozlukte_yok)} kolon: "
                + ", ".join(tabloda_var_sozlukte_yok[:10])
                + (" …" if len(tabloda_var_sozlukte_yok) > 10 else "")
            )
    else:
        satirlar.append("Sözlük verilmedi; kolon adlarından çıkarım yapılacak.")

    satirlar.append("Bu bilgilerle **sözlük sıkıştırmaya** geçeyim mi?")
    ozet = "\n\n".join(satirlar)

    state["sozluk_ozet"] = ozet
    yield ozet
