:root {
  /* ===== YAZI OLCEGI — tum arayuz yalnizca bu 4 degeri kullanir =====
     Tek font: Calibri. Boyutu genel olarak degistirmek icin sadece bunlar. */
  --fs-kucuk:  12.5px;   /* etiket, alt yazi */
  --fs-govde:  14px;     /* normal metin, LLM ve kullanici balonu, buton */
  --fs-baslik: 15.5px;   /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  20px;     /* urun adi, sayfa basligi */

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;

  /* Akbank kirmizisi — logo yazisindan alindi */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-canli:#F51513;
  --kirmizi-acik: #FDF2F2;

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #FAFAFB;
  --sohbet-zemin: #6B0A0D;
  --kenar:        #C9CED6;
  --kenar-acik:   #EAEDF1;

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.62);   /* ikincil metin: boyut yerine renkle ayrisir */

  /* Bot balonu, secenek ve secim kartlari — koyu marka tonu */
  --bot-zemin:    #9E1418;

  --user-zemin:   #FFFFFF;
  --user-metin:   #000000;
  --user-kenar:   #D8DCE3;

  --balon-zemin:  #FFFFFF;
  --balon-metin:  #000000;
  --balon-kenar:  #D8DCE3;

  --giris-zemin:  #FFFFFF;
  --giris-metin:  #000000;
  --gonder-zemin: #000000;
  --gonder-metin: #FFFFFF;
  --aksiyon-cerceve: #000000;

  --sohbet-gorsel: none;
  --sohbet-perde:  rgba(255,255,255,.72);

  --yesil:        #0E9F5C;
  --sari:         #EAB308;
  --sari-koyu:    #000000;
  --sari-acik:    #FDF6D3;
  --golge:        rgba(0,0,0,.10);

  --panel-en:   clamp(340px, 27vw, 480px);
  --analiz-en:  clamp(320px, 24vw, 420px);
  --avatar:     30px;
  --girinti:    40px;              /* avatar (30px) + bosluk (10px) */
  --ustbar-h:   108px;

  --sohbet-yan:  24px;

  /* LLM balonu icin UST SINIR. Icerik kisaysa daha dar kalir. */
  --balon-en:    min(calc(100% - var(--girinti)), 52rem);
  /* Secenek karti tasiyan balonun ALT SINIRI — kartlar ezilmesin */
  --secenekli-en: min(calc(100% - var(--girinti)), 30rem);

  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami */
  --govde-en:    calc(100% - var(--girinti));
}

/* -------- KOYU TEMA -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #C21B1E;
  --kirmizi-canli:#FF6B5B;
  --kirmizi-acik: #2A1418;

  --zemin:        #000000;
  --yuzey:        #161616;
  --yuzey-alt:    #0B0B0B;
  --sohbet-zemin: #3D0508;
  --kenar:        #3A3A3A;
  --kenar-acik:   #242424;

  --metin:        #FFFFFF;
  --metin-soluk:  rgba(255,255,255,.66);
  --bot-zemin:    #5A1114;

  --user-zemin:   #000000;
  --user-metin:   #FFFFFF;
  --user-kenar:   #3A3A3A;

  --balon-zemin:  #161616;
  --balon-metin:  #FFFFFF;
  --balon-kenar:  #3A3A3A;

  --giris-zemin:  #000000;
  --giris-metin:  #FFFFFF;
  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;
  --aksiyon-cerceve: #FFFFFF;

  --sohbet-perde: rgba(0,0,0,.78);

  --yesil:        #3DDC8A;
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
  --golge:        rgba(0,0,0,.6);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: var(--font);
  font-size: var(--fs-govde);
  line-height: 1.5;
  /* Rakamlar esit genislikte: sayaclar ve degerler hizali durur */
  font-variant-numeric: tabular-nums;
  transition: background .2s, color .2s;
}
/* Tum ogeler — buton, giris kutusu, liste — ayni fontu kullanir */
#kabuk *, #kabuk button, #kabuk input, #kabuk textarea {
  font-family: var(--font);
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}
#ustbar-sol { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
#banner { height: 84px; width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 16px; line-height: 1.35; }
#urun-adi {
  font-weight: 700; font-size: var(--fs-buyuk); letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt {
  font-size: var(--fs-kucuk); font-weight: 700; color: var(--metin);
  margin-top: 4px; white-space: nowrap;
}

/* text-transform YOK — Turkce I/İ sorunu icin metinler Python'da buyuk yazılı */
#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: var(--fs-kucuk); font-weight: 700; letter-spacing: .07em;
  color: var(--kirmizi); margin-bottom: 4px;
}
.ozet-deger {
  display: block;
  font-size: var(--fs-baslik); font-weight: 700; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-ust, .ozet-alt {
  display: block; font-size: var(--fs-kucuk); color: var(--metin-soluk); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 9px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: 9px; }

#tema-btn, #sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: 7px; cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn:hover, #sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: var(--fs-kucuk); color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 9px;
}
.sekme {
  flex: 1; font-size: var(--fs-govde); font-weight: 600; padding: 7px 22px;
  border: none; background: none; border-radius: 7px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff;
  box-shadow: 0 1px 3px rgba(213,17,21,.28);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--kenar);
  padding: 22px 20px 32px; overflow-y: auto;
}

.panel-blok { margin-bottom: 26px; }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik {
  font-size: var(--fs-kucuk); font-weight: 800; letter-spacing: .09em;
  color: var(--kirmizi); margin-bottom: 10px;
}
.panel-metin {
  margin: 0 0 10px; font-size: var(--fs-govde); line-height: 1.6; color: var(--metin);
}
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı -------- */
.faz { margin-bottom: 3px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 9px 9px; border-radius: 7px; cursor: pointer;
  color: var(--metin);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: var(--sari-acik); color: var(--sari-koyu); }
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 10px; margin-top: 2px;
  font-size: var(--fs-govde); transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0;
  font-size: var(--fs-kucuk); font-weight: 700; margin-top: 3px;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: var(--fs-baslik); font-weight: 700; line-height: 1.35; color: inherit; }
.faz-ozet {
  font-size: var(--fs-kucuk); color: inherit; opacity: .75;
  margin-top: 2px; line-height: 1.45; font-weight: 400;
}
.faz-durum {
  flex-shrink: 0; font-size: var(--fs-kucuk);
  font-weight: 700; margin-top: 3px; cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 2px 0 8px 14px; padding: 0 0 0 26px; display: none;
  border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 9px;
  padding: 5px 8px; border-radius: 6px;
  font-size: var(--fs-govde); color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 14px; height: 14px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700;
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: 700; }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 3px var(--sari-acik);
}

/* ==================== ORTA: SOHBET ==================== */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--sohbet-zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--sohbet-perde);
  backdrop-filter: blur(3px);
  pointer-events: none;
}
#sohbet, #giris-bolge { position: relative; z-index: 1; }

/* Kaydirma YALNIZCA burada: tum sohbet birlikte kayar */
#sohbet {
  flex: 1; overflow-y: auto;
  padding: 22px var(--sohbet-yan) 16px;
  background: transparent;
  scrollbar-gutter: stable;
}

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 0 18px;
  width: 100%;
  min-width: 0;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: var(--yuzey); object-fit: cover;
  border: 1px solid var(--kenar);
  box-shadow: 0 2px 6px rgba(0,0,0,.15);
}

/* Balon metni kadar uzar; yukseklik siniri ve ic kaydirma YOK */
.balon {
  min-width: 0;
  width: fit-content;
  padding: 14px 18px; border-radius: 14px;
  white-space: pre-wrap; word-break: break-word; overflow-wrap: anywhere;
}

/* -------- Bot kutusu: balon + (varsa) seçenek kartları -------- */
.balon-sutun {
  display: flex; flex-direction: column; align-items: stretch;
  flex: 0 1 auto;
  width: fit-content;
  max-width: var(--balon-en);
  min-width: 0;
}
.balon-sutun.secenekli { min-width: var(--secenekli-en); }

.satir.bot .balon {
  width: auto;
  max-width: 100%;
  background: var(--bot-zemin); color: #fff;
  border: none;
  border-left: 4px solid var(--kirmizi);
  border-top-left-radius: 4px;
  font-size: var(--fs-govde); line-height: 1.6;
  box-shadow: 0 4px 16px rgba(0,0,0,.22);
}

.satir.kullanici .balon {
  max-width: min(75%, calc(100% - var(--girinti)));
  background: var(--user-zemin); color: var(--user-metin);
  border: 1px solid var(--user-kenar);
  border-top-right-radius: 4px;
  font-size: var(--fs-govde); line-height: 1.6;
  box-shadow: 0 3px 12px rgba(0,0,0,.18);
}

.satir.bot .balon.hata {
  background: #FFF4F4; color: #A00D10;
  border-left-color: #F51513;
}

/* -------- Seçenek kartları -------- */
.secenek-kok {
  display: flex; flex-direction: column; gap: 9px;
}
.balon-sutun .secenek-kok {
  width: 0;
  min-width: 100%;
  margin-top: 9px;
}
#sohbet > .secenek-kok {
  margin: 0 0 18px var(--girinti);
  width: fit-content;
  max-width: var(--balon-en);
}

.secenek {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 18px 14px 16px;
  background: var(--bot-zemin); color: #fff;
  border: 2px solid transparent;
  border-left: 4px solid var(--kirmizi);
  border-radius: 12px;
  cursor: pointer; text-align: left;
  font-size: var(--fs-govde);
  box-shadow: 0 4px 16px rgba(0,0,0,.22);
  transition: filter .15s, border-color .15s, transform .1s, opacity .15s;
}
.secenek:hover:not(:disabled) {
  filter: brightness(1.18);
  border-color: rgba(255,255,255,.55);
  border-left-color: var(--kirmizi);
}
.secenek:active:not(:disabled) { transform: scale(.99); }

.secenek:disabled { cursor: default; opacity: .4; }
.secenek.secili {
  background: var(--kirmizi); opacity: 1;
  border-color: #fff; border-left-color: #fff;
}

.secenek-rozet {
  flex-shrink: 0; width: 30px; height: 30px;
  background: #fff; color: var(--bot-zemin);
  border-radius: 50%; font-weight: 700; font-size: var(--fs-govde);
  display: flex; align-items: center; justify-content: center;
}
.secenek.secili .secenek-rozet { color: var(--kirmizi); }

.secenek-govde { min-width: 0; flex: 1; }
.secenek-baslik {
  font-weight: 700; font-size: var(--fs-baslik); line-height: 1.35; color: #fff;
}
.secenek-aciklama {
  font-size: var(--fs-govde); color: #fff; opacity: .88;
  line-height: 1.5; margin-top: 3px;
}

/* -------- Seçim formu: dataset seçici -------- */
.secim-kart {
  width: var(--balon-en); margin: 0 0 18px var(--girinti);
  background: var(--bot-zemin); border: none;
  border-left: 4px solid var(--kirmizi);
  border-radius: 14px; border-top-left-radius: 4px;
  padding: 18px 22px 20px; box-shadow: 0 4px 16px rgba(0,0,0,.22);
  color: #fff;
}
.secim-kart.kilitli { opacity: .65; }

.secim-baslik { font-weight: 700; font-size: var(--fs-baslik); margin-bottom: 5px; }
.secim-aciklama {
  font-size: var(--fs-govde); line-height: 1.6; margin-bottom: 14px; opacity: .9;
}

.secim-govde { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
.secim-govde .combo { flex: 1; min-width: 200px; }

.secim-satir { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 12px; }
.secim-satir .combo { flex: 1; }

.combo { position: relative; }
.combo label {
  display: block; font-size: var(--fs-govde); color: #fff;
  margin-bottom: 5px; font-weight: 600;
}
.combo-giris {
  width: 100%; padding: 9px 15px; border: 1px solid rgba(255,255,255,.35);
  border-radius: 999px;
  font-size: var(--fs-govde);
  outline: none; background: #fff; color: #000;
}
.combo-giris::placeholder { color: #000; opacity: .45; }
.combo-giris:focus { border-color: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.3); }
.combo-giris:disabled { background: rgba(255,255,255,.6); }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 5px 0 0; padding: 5px; list-style: none;
  background: var(--balon-zemin); border: 1px solid var(--balon-kenar);
  border-radius: 12px; box-shadow: 0 8px 22px rgba(0,0,0,.3);
  max-height: 260px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 13px; border-radius: 999px; cursor: pointer;
  font-size: var(--fs-govde);
  color: var(--balon-metin);
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; opacity: .7; }
.combo-liste li.bos:hover { background: none; color: var(--balon-metin); }

.secim-yuvarlak {
  flex-shrink: 0; width: 34px; height: 34px; padding: 0;
  border-radius: 50%; cursor: pointer;
  font-size: 20px; font-weight: 700; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, transform .1s;
}
.secim-yuvarlak:active:not(:disabled) { transform: scale(.92); }
.secim-yuvarlak:disabled { opacity: .4; cursor: not-allowed; }

.secim-yuvarlak.ekle { background: #fff; color: var(--bot-zemin); border: none; }
.secim-yuvarlak.ekle:hover:not(:disabled) { background: #FFE8E9; }

.secim-yuvarlak.sil {
  width: 22px; height: 22px; font-size: 16px;
  background: rgba(0,0,0,.3); color: #fff;
  border: 1px solid rgba(255,255,255,.35);
}
.secim-yuvarlak.sil:hover { background: rgba(0,0,0,.55); }

.secim-rozetler { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; }
.secim-rozet {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px; padding: 6px 8px 6px 16px;
  font-size: var(--fs-govde);
}

.secim-onay {
  padding: 10px 28px; background: #fff; color: var(--bot-zemin);
  border: none; border-radius: 999px; font-size: var(--fs-govde); font-weight: 700;
  cursor: pointer; white-space: nowrap;
}
.secim-onay:hover:not(:disabled) { background: #FFE8E9; }
.secim-onay:disabled {
  background: rgba(255,255,255,.28); color: rgba(255,255,255,.65);
  cursor: not-allowed;
}

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: #fff; animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-3px); }
}

/* -------- Aksiyon butonları ve yazı kutusu: tam genişlik -------- */
#giris-bolge {
  border-top: none;
  background: transparent;
  padding: 12px var(--sohbet-yan) 22px;
  padding-right: calc(var(--sohbet-yan) + 7px);
  flex-shrink: 0;
}
#aksiyonlar {
  width: var(--govde-en); margin: 0 0 12px var(--girinti);
  display: flex; gap: 10px;
}

.aksiyon {
  flex: 1;
  font-size: var(--fs-govde); font-weight: 600; padding: 10px 18px;
  border-radius: 999px; cursor: pointer; white-space: nowrap;
  text-align: center;
  transition: background .15s, border-color .15s, color .15s;
}
.aksiyon:disabled { opacity: .4; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff;
  border: 2px solid var(--aksiyon-cerceve);
  box-shadow: 0 2px 10px rgba(213,17,21,.28);
}
.aksiyon.onayla:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.aksiyon.degistir {
  background: var(--yuzey); color: var(--metin);
  border: 2px solid var(--aksiyon-cerceve);
}
.aksiyon.degistir:hover:not(:disabled) { background: var(--kenar-acik); }

.aksiyon.geri {
  background: var(--yuzey); color: var(--metin);
  border: 2px solid var(--aksiyon-cerceve);
}
.aksiyon.geri:hover:not(:disabled) { background: var(--kenar-acik); }

#giris {
  width: var(--govde-en); margin: 0 0 0 var(--girinti);
  display: flex; gap: 8px; align-items: center;
  background: var(--giris-zemin);
  border: 2px solid var(--aksiyon-cerceve);
  border-radius: 999px;
  padding: 7px 7px 7px 20px;
  box-shadow: 0 3px 12px rgba(0,0,0,.15);
}
#kutu {
  flex: 1; padding: 6px 0; border: none;
  background: transparent; color: var(--giris-metin);
  font-size: var(--fs-govde); line-height: 1.5;
  resize: none; outline: none; max-height: 96px; overflow-y: auto;
}
#kutu::placeholder { color: var(--giris-metin); opacity: .5; }

#gonder {
  padding: 9px 26px; background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: 999px;
  font-size: var(--fs-govde); font-weight: 600; cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { filter: brightness(1.25); }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column; overflow: hidden;
}

#analiz-ust {
  padding: 16px 19px 14px; border-bottom: 1px solid var(--kenar);
  background: var(--yuzey); flex-shrink: 0;
}
#analiz-baslik { font-weight: 800; font-size: var(--fs-baslik); color: var(--kirmizi); }

#analiz-sekmeler {
  display: flex; gap: 3px; padding: 10px 12px;
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  overflow-x: auto; flex-shrink: 0;
}
#analiz-sekmeler::-webkit-scrollbar { height: 0; }
.analiz-sekme {
  font-size: var(--fs-kucuk); font-weight: 600; padding: 6px 13px;
  border: none; background: none; border-radius: 999px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); }
.analiz-sekme.aktif { background: var(--kirmizi); color: #fff; font-weight: 700; }

#analiz-govde { flex: 1; overflow-y: auto; padding: 16px 19px 26px; }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 14px 17px; margin-bottom: 12px;
}
.iskele-baslik {
  font-size: var(--fs-govde); font-weight: 700; margin-bottom: 9px; color: var(--metin);
}
.iskele-satir {
  display: flex; justify-content: space-between; gap: 12px;
  font-size: var(--fs-kucuk); padding: 6px 0; color: var(--metin-soluk);
}
.iskele-deger {
  font-size: var(--fs-kucuk);
  color: var(--metin); background: var(--kenar-acik);
  padding: 1px 10px; border-radius: 999px;
}
.iskele-grafik {
  height: 86px; border-radius: 10px; margin-top: 4px;
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 6px,
    var(--yuzey) 6px, var(--yuzey) 12px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin-soluk); font-size: var(--fs-kucuk);
}

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1280px; margin: 0 auto; padding: 28px clamp(18px, 2.4vw, 44px) 56px; }
#ozet-baslik-blok { margin-bottom: 22px; }
#ozet-h1 {
  margin: 0; font-size: var(--fs-buyuk); font-weight: 800;
  letter-spacing: -.01em; color: var(--kirmizi);
}
#ozet-adim { font-size: var(--fs-govde); color: var(--metin-soluk); margin-top: 6px; }

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 15px; align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 16px 19px 14px; box-shadow: 0 1px 2px var(--golge);
}
.ozet-blok-baslik {
  font-size: var(--fs-kucuk); font-weight: 800; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 10px;
  padding-bottom: 9px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 6px 0; font-size: var(--fs-govde); align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--metin-soluk); flex-shrink: 0; }
.ozet-satir-deger {
  color: var(--metin);
  text-align: right; font-weight: 700; word-break: break-word; min-width: 0;
}
#ozet-bos {
  background: var(--yuzey); border: 1px dashed var(--kenar); border-radius: 12px;
  padding: 44px; text-align: center; color: var(--metin-soluk);
  font-size: var(--fs-govde); grid-column: 1 / -1;
}

/* ==================== KAYDIRMA ÇUBUKLARI ==================== */
#panel::-webkit-scrollbar,
#sohbet::-webkit-scrollbar,
#analiz-govde::-webkit-scrollbar,
#sayfa-ozet::-webkit-scrollbar,
#kutu::-webkit-scrollbar,
.combo-liste::-webkit-scrollbar {
  width: 7px;
}
#panel::-webkit-scrollbar-thumb,
#sohbet::-webkit-scrollbar-thumb,
#analiz-govde::-webkit-scrollbar-thumb,
#sayfa-ozet::-webkit-scrollbar-thumb,
#kutu::-webkit-scrollbar-thumb,
.combo-liste::-webkit-scrollbar-thumb {
  background: var(--kirmizi); border-radius: 4px;
}
#panel::-webkit-scrollbar-thumb:hover,
#sohbet::-webkit-scrollbar-thumb:hover,
#analiz-govde::-webkit-scrollbar-thumb:hover,
#sayfa-ozet::-webkit-scrollbar-thumb:hover,
#kutu::-webkit-scrollbar-thumb:hover,
.combo-liste::-webkit-scrollbar-thumb:hover {
  background: var(--kirmizi-koyu);
}
#panel::-webkit-scrollbar-track,
#sohbet::-webkit-scrollbar-track,
#analiz-govde::-webkit-scrollbar-track,
#sayfa-ozet::-webkit-scrollbar-track,
#kutu::-webkit-scrollbar-track,
.combo-liste::-webkit-scrollbar-track {
  background: transparent;
}

#panel, #sohbet, #analiz-govde, #sayfa-ozet, #kutu, .combo-liste {
  scrollbar-width: thin;
  scrollbar-color: var(--kirmizi) transparent;
}

/* -------- Dar ekran -------- */
@media (max-width: 1180px) { #analiz-panel { display: none; } }
@media (max-width: 1280px) { #baslik-blok { display: none; } }
@media (max-width: 1080px) { #panel { display: none; } #ozet-serit { display: none; } }
