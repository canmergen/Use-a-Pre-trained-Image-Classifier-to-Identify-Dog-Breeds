# YARDIMCILAR
# ===========================================================================
def _df_oku(dataset_adi, limit=10000):
    return dataiku.Dataset(dataset_adi).get_dataframe(limit=limit)


def _dataset_var_mi(ad):
    try:
        dataiku.Dataset(ad).get_config()
        return True
    except Exception:
        return False


def _liste(baslik, satirlar, en_fazla=20):
    if not satirlar:
        return baslik + "\n  (yok)"
    govde = "\n".join("  • %s" % s for s in satirlar[:en_fazla])
    if len(satirlar) > en_fazla:
        govde += "\n  … (+%d tane daha)" % (len(satirlar) - en_fazla)
    return baslik + "\n" + govde


