def _hazirla(df, kol, doldur):
    """Kolonu sayisala cevirir, karar verilen doldurma kuralini uygular."""
    s = pd.to_numeric(df[kol], errors="coerce")
    if doldur == "medyan":
        med = s.median()
        if not pd.isna(med):
            s = s.fillna(med)
    return s


def _tekli_donustur(df, kolonlar, donusum, doldur):
    yeni = {}
    for kol in kolonlar:
        if kol not in df.columns:
            continue
        s = _hazirla(df, kol, doldur)
        if donusum == "log":
            yeni["%s__LOG" % kol] = np.log1p(s.clip(lower=0))
        elif donusum == "rank":
            yeni["%s__RANK" % kol] = s.rank(pct=True)
        elif donusum == "winsor":
            yeni["%s__WNS" % kol] = s.clip(s.quantile(0.01), s.quantile(0.99))
    return yeni


def _ikili_donustur(df, kolonlar, donusum, doldur):
    """delta / oran: ayni aileden ardisik iki kolon gerektirir."""
    yeni = {}
    for i in range(len(kolonlar) - 1):
        a, b = kolonlar[i], kolonlar[i + 1]
        if a not in df.columns or b not in df.columns:
            continue
        sa = _hazirla(df, a, doldur)
        sb = _hazirla(df, b, doldur)
        if donusum == "delta":
            yeni["%s__MINUS__%s" % (a, b)] = sa - sb
        elif donusum == "oran":
            yeni["%s__DIV__%s" % (a, b)] = sa / sb.replace(0, np.nan)
    return yeni


def uretim_plan(durum):
    return ("Planı çalıştırıp yeni kolonları üreteceğim. Üretimi Python yapıyor; "
            "yapay zekâ yalnızca hangi dönüşümün uygulanacağını önerdi. "
            "Boşluklar hazırlık adımında kararlaştırıldığı gibi doldurulacak.\n\n"
            "Sonuç %s_ENRICHED veri setine yazılacak, kaynak tablonuza "
            "dokunulmayacak. Başlayayım mı?" % durum["veri_seti"])


def uretim_uygula(durum):
    df = _df_oku(durum["veri_seti"])
    doldur = (durum.get("hazirlik") or {}).get("doldurma")

    uretilen = {}
    for p in durum.get("plan", []):
        d = p["donusum"]
        if d in ("delta", "oran"):
            uretilen.update(_ikili_donustur(df, p["kolonlar"], d, doldur))
        else:
            uretilen.update(_tekli_donustur(df, p["kolonlar"], d, doldur))

    for ad, seri in uretilen.items():
        df[ad] = seri

    hedef = "%s_ENRICHED" % durum["veri_seti"]
    dataiku.Dataset(hedef).write_with_schema(df)
    durum["uretilen"] = list(uretilen.keys())
    return ("%s yeni kolon ürettim ve %s veri setine yazdım."
            % (_sayi(len(uretilen)), hedef))


