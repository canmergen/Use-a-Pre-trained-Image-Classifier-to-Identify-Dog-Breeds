/* -------- Üst bar sağ blok: iki satır -------- */
#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: flex-end; justify-content: center;
  gap: 7px; flex-shrink: 0;
}

.ustbar-sag-satir { display: flex; align-items: center; gap: 9px; }

/* Restart ikonu */
#sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; padding: 0;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 6px; cursor: pointer; color: var(--gri);
}
#sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi);
  background: var(--kirmizi-acik);
}
#sifirla-btn:active svg { transform: rotate(-90deg); }
#sifirla-btn svg { transition: transform .25s ease; }

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: .9em; color: var(--gri); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

/* Sekmeler — aktif olan dolu kirmizi */
#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 8px;
}
.sekme {
  font-size: .92em; font-weight: 500; padding: 6px 16px;
  border: none; background: none; border-radius: 6px;
  cursor: pointer; color: var(--gri); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: #fff; color: var(--metin); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff; font-weight: 600;
  box-shadow: 0 1px 3px rgba(228,0,43,.30);
}
