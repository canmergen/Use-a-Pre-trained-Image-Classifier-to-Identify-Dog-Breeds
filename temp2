:root {
  /* ===== YAZI OLCEGI — tum arayuz yalnizca bu 4 degeri kullanir =====
     Tek font: Calibri. Buyuk harf CSS ile DEGIL, HTML/Python'da yazilir
     (Turkce I/İ). Calibri'de 800 agirligi yok; kalin = 700.
     --fs-kucuk yalnizca faz no, sayac ve durum ciplerinde kullanilir. */
  --fs-kucuk:  11px;
  --fs-govde:  13px;     /* metin, bolum basliklari, etiketler, butonlar */
  --fs-baslik: 15px;     /* kart/faz basliklari, ozet degerleri */
  --fs-buyuk:  18px;     /* urun adi, sayfa basligi */

  --font: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  --etiket-aralik: .07em;

  /* ===== BILESEN SISTEMI — kose, bosluk, yukseklik, golge ===== */
  --r:         8px;      /* kart, balon, buton, giris kutusu */
  --r-kucuk:   6px;      /* sekme, cip, liste ogesi, ic alan */
  --b-1: 4px;  --b-2: 8px;  --b-3: 12px;  --b-4: 16px;  --b-5: 20px;  --b-6: 24px;
  --btn-h:     36px;     /* tum ana butonlar */
  --btn-h-kucuk: 30px;   /* ikon butonlari, Gonder */
  --serit:     3px;      /* kart solundaki marka vurgu cizgisi */
  --golge-1:   0 1px 2px rgba(16,24,40,.06);
  --golge-2:   0 6px 16px rgba(16,24,40,.10);

  /* ===== RENK — zemin notr, kirmizi yalnizca vurgu ===== */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-acik: #FDF1F1;
  --kirmizi-halka: rgba(213,17,21,.16);

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #F9FAFB;
  --kenar:        #DDE1E6;
  --kenar-guclu:  #BFC5CE;
  --kenar-acik:   #EDEFF2;

  --metin:        #000000;
  --metin-soluk:  rgba(0,0,0,.66);

  --user-zemin:   #EEF0F3;          /* kullanici balonu: bot'tan ayrissin */

  --gonder-zemin: #111111;
  --gonder-metin: #FFFFFF;

  /* Sohbet arka plan gorseli JS'ten gelir; perde onu neredeyse tamamen ortulur */
  --sohbet-gorsel: none;
  --sohbet-perde:  rgba(244,245,247,.94);

  --yesil:        #0E8A52;
  --yesil-acik:   #E6F4EC;
  --amber:        #B45309;
  --amber-acik:   #FEF3C7;
  --amber-halka:  rgba(217,119,6,.30);
  --sari:         #EAB308;
  --sari-koyu:    #000000;
  --sari-acik:    #FDF6D3;

  /* Sol panel: dar ekranda 260px, genis ekranda en fazla 330px */
  --panel-en:   clamp(260px, 19vw, 330px);
  /* Sag panel: dar ekranda 340px, genis ekranda en fazla 460px */
  --analiz-en:  clamp(340px, 26vw, 460px);
  --avatar:     30px;
  --girinti:    40px;              /* avatar (30px) + bosluk (10px) */
  --ustbar-h:   108px;
  --sohbet-yan: 24px;

  /* LLM balonu icin UST SINIR. Icerik kisaysa daha dar kalir. */
  --balon-en:     min(calc(100% - var(--girinti)), 52rem);
  /* Secenek karti tasiyan balonun ALT SINIRI — kartlar ezilmesin */
  --secenekli-en: min(calc(100% - var(--girinti)), 30rem);
  /* Alttaki butonlar ve yazi kutusu: sohbet alaninin tamami */
  --govde-en:     calc(100% - var(--girinti));
}

