/* -------- Faz ağacı: yeşil tamam · sarı devam · gri bekliyor -------- */
.faz { margin-bottom: 3px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 9px;
  padding: 7px 8px; border-radius: 6px; cursor: pointer;
  color: var(--gri-acik);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: #FFFAEB; color: #B54708; }
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-no {
  flex-shrink: 0; font-family: ui-monospace, Consolas, monospace;
  font-size: .8em; font-weight: 700; margin-top: 1px; opacity: .8;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: .96em; font-weight: 600; line-height: 1.3; }
.faz-ozet { font-size: .82em; opacity: .75; margin-top: 2px; line-height: 1.35; }
.faz-durum {
  flex-shrink: 0; font-size: .78em; font-family: ui-monospace, Consolas, monospace;
  margin-top: 2px; opacity: .85;
}

.faz-adimlar { list-style: none; margin: 2px 0 0; padding: 0 0 0 22px; display: none; }
.faz.aktif .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 8px;
  padding: 5px 8px; border-radius: 5px; font-size: .9em;
  color: var(--gri-acik); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 13px; height: 13px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .6em; font-weight: 700;
}
/* Tamamlandi — yesil dolu */
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
/* Devam ediyor — sari dolu, halkali */
.faz-adimlar li.aktif { color: #B54708; font-weight: 600; }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #fff;
  box-shadow: 0 0 0 3px #FEF0C7;
}
