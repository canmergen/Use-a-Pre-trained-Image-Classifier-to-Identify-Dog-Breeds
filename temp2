/* ==================== ÖZET KART — üç satır ==================== */
.ozet-ust {
  display: block; font-size: .84em; color: var(--gri); margin-top: 3px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-alt {
  display: block; font-size: .84em; color: var(--gri-acik); margin-top: 1px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
#ustbar { height: 82px; }          /* uc satir sigsin */

/* ==================== ÇALIŞMA ÖZETİ PANELİ ==================== */
#detay-btn {
  font-size: .9em; font-weight: 500; padding: 7px 15px;
  border: 1px solid var(--kenar); background: #fff;
  border-radius: 7px; cursor: pointer; color: var(--gri); white-space: nowrap;
}
#detay-btn:hover, #detay-btn.acik {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

#detay-panel {
  width: clamp(300px, 24vw, 400px);
  flex-shrink: 0;
  background: #FCFCFD;
  border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column;
  overflow: hidden;
}
#detay-panel.kapali { display: none; }

#detay-ust {
  display: flex; align-items: flex-start; justify-content: space-between;
  padding: 16px 18px 14px;
  border-bottom: 1px solid var(--kenar);
  background: #fff; flex-shrink: 0;
}
#detay-baslik { font-weight: 600; font-size: 1.05em; }
#detay-adim { font-size: .86em; color: var(--gri-acik); margin-top: 3px; }
#detay-kapat {
  width: 24px; height: 24px; padding: 0; line-height: 1;
  border: none; background: none; color: var(--gri-acik);
  font-size: 1.5em; cursor: pointer; border-radius: 5px;
}
#detay-kapat:hover { background: var(--kenar-acik); color: var(--metin); }

#detay-govde { flex: 1; overflow-y: auto; padding: 16px 18px 28px; }

.detay-bolum { margin-bottom: 22px; }
.detay-bolum:last-child { margin-bottom: 0; }
.detay-bolum-baslik {
  font-size: .78em; font-weight: 700; letter-spacing: .08em;
  color: var(--gri-acik); margin-bottom: 9px;
  padding-bottom: 6px; border-bottom: 1px solid var(--kenar);
}
.detay-satir {
  display: flex; justify-content: space-between; gap: 12px;
  padding: 4px 0; font-size: .88em; align-items: baseline;
}
.detay-etiket { color: var(--gri); flex-shrink: 0; }
.detay-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--metin); text-align: right;
  word-break: break-word; min-width: 0;
}

@media (max-width: 1400px) {
  #detay-panel { position: absolute; right: 0; top: 82px; bottom: 0; z-index: 30;
                 box-shadow: -8px 0 24px rgba(16,24,40,.10); }
  #kabuk { position: relative; }
}



















/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;
        kart.appendChild(deger);

        // Ust satir: baslangic durumu
        const ust = document.createElement("span");
        ust.className = "ozet-ust";
        ust.textContent = k.ust || "";
        ust.title = k.ust || "";
        kart.appendChild(ust);

        // Alt satir: guncel durum
        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        alt.title = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}














/* ==================== Çalışma özeti paneli ==================== */
const detayPanel = document.getElementById("detay-panel");
const detayBtn   = document.getElementById("detay-btn");
const detayGovde = document.getElementById("detay-govde");
const detayAdim  = document.getElementById("detay-adim");

function detayGuncelle(d) {
    if (!d) return;
    detayAdim.textContent = "Adım " + d.adim_no + " / " + d.toplam +
                            " · " + d.adim;
    detayGovde.innerHTML = "";
    (d.bolumler || []).forEach(b => {
        const blok = document.createElement("div");
        blok.className = "detay-bolum";

        const bas = document.createElement("div");
        bas.className = "detay-bolum-baslik";
        bas.textContent = b.baslik;
        blok.appendChild(bas);

        (b.satirlar || []).forEach(([etiket, deger]) => {
            const satir = document.createElement("div");
            satir.className = "detay-satir";

            const e = document.createElement("span");
            e.className = "detay-etiket";
            e.textContent = etiket;
            satir.appendChild(e);

            const v = document.createElement("span");
            v.className = "detay-deger";
            v.textContent = (deger === null || deger === undefined) ? "—" : String(deger);
            satir.appendChild(v);

            blok.appendChild(satir);
        });
        detayGovde.appendChild(blok);
    });
}

detayBtn.onclick = () => {
    detayPanel.classList.toggle("kapali");
    detayBtn.classList.toggle("acik", !detayPanel.classList.contains("kapali"));
};
document.getElementById("detay-kapat").onclick = () => {
    detayPanel.classList.add("kapali");
    detayBtn.classList.remove("acik");
};












