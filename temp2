    baglam = "\n".join(satirlar)

    # Baglam cok uzarsa model bosalabiliyor; kirp ve logla.
    if len(baglam) > AZAMI_BAGLAM_KARAKTER:
        _logla("UYARI: baglam {} karakter, {} karaktere kirpiliyor".format(
            len(baglam), AZAMI_BAGLAM_KARAKTER))
        baglam = baglam[:AZAMI_BAGLAM_KARAKTER] + "\n(baglam kirpildi)"

    _logla("asistan baglami: {} karakter".format(len(baglam)))
    state[S.ASISTAN_BAGLAMI] = baglam
