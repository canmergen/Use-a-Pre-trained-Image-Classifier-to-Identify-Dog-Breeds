import json
import dataiku
from dataiku.llm.python.blocks_graph import NextBlock

FOLDER_ADI = "PROJE_HAFIZASI"


def _json_ayristir(ham):
    if ham is None:
        return {}
    if isinstance(ham, dict):
        return ham
    metin = str(ham).strip()
    if metin.startswith("```"):
        metin = metin.strip("`").strip()
        if metin.lower().startswith("json"):
            metin = metin[4:].strip()
    try:
        return json.loads(metin)
    except Exception:
        return {}


def _onceki_oturumu_oku():
    """PROJE_HAFIZASI/sema.json varsa oku, yoksa None."""
    try:
        folder = dataiku.Folder(FOLDER_ADI)
        if "/sema.json" not in folder.list_paths_in_partition():
            return None
        with folder.get_download_stream("sema.json") as f:
            return json.loads(f.read().decode("utf-8"))
    except Exception:
        return None


def process(trace):
    g = _json_ayristir(state.get("girdi"))

    for anahtar in ["veri_seti", "sozluk", "target", "id_kolonu", "donem_kolonu", "bolme_kolonu"]:
        if g.get(anahtar) is not None:
            state[anahtar] = g.get(anahtar)
    state["dataset_var"] = bool(g.get("dataset_var")) or bool(state.get("veri_seti"))
    state["sozluk_var"] = bool(g.get("sozluk_var")) or bool(state.get("sozluk"))
    state["config_var"] = bool(g.get("config_var"))
    state["niyet"] = g.get("niyet") or "bilgi"

    asama = state.get("asama") or "baslangic"

    # --- Önceki oturum kontrolü: sadece ilk turda, state boşken ---
    if asama == "baslangic" and not state.get("onceki_soruldu"):
        state["onceki_soruldu"] = True
        onceki = _onceki_oturumu_oku()
        if onceki and onceki.get("veri_seti") and not state.get("veri_seti"):
            state["onceki_veri_seti"] = onceki.get("veri_seti")
            state["onceki_sozluk"] = onceki.get("sozluk_adi")
            yield (
                f"Önceki oturumdan kayıt buldum: **{onceki.get('veri_seti')}** veri seti"
                + (f" ve **{onceki.get('sozluk_adi')}** sözlüğü" if onceki.get("sozluk_adi") else "")
                + f" ({onceki.get('n_satir')} satır, {onceki.get('n_kolon')} kolon).\n\n"
                "Bununla devam edeyim mi, yoksa yeni bir veri setiyle mi başlayalım?"
            )
            return

    # --- Kullanıcı önceki oturuma "devam" dediyse bilgileri state'e al ---
    if state.get("onceki_veri_seti") and state["niyet"] == "onay" and not state.get("veri_seti"):
        state["veri_seti"] = state["onceki_veri_seti"]
        state["sozluk"] = state.get("onceki_sozluk")
        state["dataset_var"] = True
        state["sozluk_var"] = bool(state.get("onceki_sozluk"))
        state["asama"] = "sozluk"
        yield NextBlock("sozluk_calis")
        return

    # --- Normal akış ---
    if asama == "baslangic" and state["dataset_var"] and state["niyet"] == "onay":
        state["asama"] = "sozluk"
        yield NextBlock("sozluk_calis")
        return

    yield NextBlock("sohbet")
