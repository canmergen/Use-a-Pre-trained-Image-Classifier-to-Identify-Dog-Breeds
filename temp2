İlk turda state'e varsayılan değerleri yazar, sonra komut_isle'ye geçer. Sonraki turlarda da çalışır ama sadece eksik anahtarları doldurur.


Kullanıcının yazdığını komut olarak okur ve gereken işi yapar. Tanımadığı bir şey gelirse komut listesini gösterir. Şimdilik sadece kurulum komutları var.


import dataiku
from dataiku.llm.python.blocks_graph import NextBlock


BLOK_SOZLUK_OKU = "sozluk_oku"


class Asama:
    KURULUM = "kurulum"
    SOZLUK = "sozluk"


class S:
    ASAMA = "asama"
    VERI_SETI = "veri_seti"
    SOZLUK = "sozluk"
    SOZLUK_ISTENMEDI = "sozluk_istenmedi"
    OKUNDU = "okundu"


KARSILAMA = """**Akıllı Değişken Üretimi**

Elinizdeki veri setinden, hedef değişkeni daha iyi açıklayan yeni değişkenler \
üretir ve her birinin ne kadar işe yaradığını ölçer.

Altı adım var. Her adımda önce ne yapılacağı gösterilir, siz onaylarsınız, \
sonra çalışır.

1. **Sözlük hazırlığı** — kolon açıklamaları toplanır ve sıkıştırılır
2. **Meta tanımı** — hedef, kimlik, dönem ve bölme kolonları belirlenir
3. **Kural bazlı üretim** — delta, oran, lag, momentum gibi türetmeler
4. **Model destekli üretim** — hipotez kurulur, test edilir, tutanlar kaydedilir
5. **Veri kalitesi kontrolü** — eksik, sabit, tekrarlı, sızıntı riskli kolonlar
6. **Model karşılaştırması** — mevcut ve zenginleştirilmiş veriyle model kurulur

Burada komutlarla ilerliyoruz. Uzun cümle yerine kısa komutlar yazın, böylece \
yanlış anlaşılma olmaz."""

KURULUM_YARDIM = """**Komutlar**

`veri <dataset adı>` — çalışılacak veri seti
`sozluk <dataset adı>` — kolon açıklamalarının olduğu iki kolonlu dataset
`sozluk yok` — sözlük olmadan devam, açıklamalar kolon adından çıkarılır
`oku` — seçilenleri okur ve karşılaştırır
`durum` — neyin seçili olduğunu gösterir
`yardim` — bu liste

Örnek: `veri HAVALE_EFT_NTT`"""


def _logla(mesaj):
    print("[komut_isle] {}".format(mesaj))


def _mesaji_al():
    try:
        if last_output:
            return str(last_output).strip()
    except NameError:
        pass
    return ""


def _dataset_adlari():
    try:
        proje = dataiku.api_client().get_default_project()
        return {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        return None


def _dataset_bul(ad):
    # projedeki gercek adi bulur, buyuk kucuk harfe bakmaz
    temiz = str(ad or "").strip()
    if not temiz:
        return None, "Dataset adı yazmadınız."

    mevcut = _dataset_adlari()
    if mevcut is None:
        return temiz, None

    if temiz in mevcut:
        return temiz, None

    kucuk = {a.lower(): a for a in mevcut}
    if temiz.lower() in kucuk:
        return kucuk[temiz.lower()], None

    benzer = sorted(a for a in mevcut if temiz.lower() in a.lower())[:5]
    if benzer:
        return None, "**{}** diye bir dataset yok. Şunlardan biri mi: {}".format(
            temiz, ", ".join("`{}`".format(b) for b in benzer))
    return None, "**{}** diye bir dataset bulamadım.".format(temiz)


def _durum_metni():
    satirlar = ["**Durum**", ""]

    if state.get(S.VERI_SETI):
        satirlar.append("Veri seti: **{}**".format(state[S.VERI_SETI]))
    else:
        satirlar.append("Veri seti: henüz seçilmedi")

    if state.get(S.SOZLUK):
        satirlar.append("Sözlük: **{}**".format(state[S.SOZLUK]))
    elif state.get(S.SOZLUK_ISTENMEDI):
        satirlar.append("Sözlük: kullanılmayacak")
    else:
        satirlar.append("Sözlük: henüz seçilmedi")

    satirlar.append("Okundu: {}".format("evet" if state.get(S.OKUNDU) else "hayır"))
    satirlar.append("")

    if state.get(S.VERI_SETI) and (state.get(S.SOZLUK)
                                   or state.get(S.SOZLUK_ISTENMEDI)):
        satirlar.append("`oku` yazınca devam ederiz.")
    elif not state.get(S.VERI_SETI):
        satirlar.append("Önce `veri <dataset adı>` yazın.")
    else:
        satirlar.append("Şimdi `sozluk <dataset adı>` ya da `sozluk yok` yazın.")

    return "\n".join(satirlar)


def _kurulum_komutu(mesaj):
    # (cikti, sonraki_blok) doner, ikisi de None ise komutu anlamadik
    kucuk = mesaj.lower()

    if kucuk in ("yardim", "yardım", "help", "?"):
        return KURULUM_YARDIM, None

    if kucuk in ("durum", "status"):
        return _durum_metni(), None

    if kucuk in ("sozluk yok", "sözlük yok"):
        state[S.SOZLUK] = ""
        state[S.SOZLUK_ISTENMEDI] = True
        _logla("sozluk istenmedi")
        return ("Tamam, sözlüksüz devam ediyoruz. Açıklamalar kolon adından "
                "çıkarılacak, doğruluk biraz düşer.\n\n" + _durum_metni()), None

    for onek in ("veri ", "veriseti ", "veri seti "):
        if kucuk.startswith(onek):
            ad, hata = _dataset_bul(mesaj[len(onek):])
            if hata:
                return hata, None
            state[S.VERI_SETI] = ad
            state[S.OKUNDU] = False
            _logla("veri seti: {}".format(ad))
            return "Veri seti **{}** olarak seçildi.\n\n{}".format(
                ad, _durum_metni()), None

    for onek in ("sozluk ", "sözlük "):
        if kucuk.startswith(onek):
            ad, hata = _dataset_bul(mesaj[len(onek):])
            if hata:
                return hata, None
            state[S.SOZLUK] = ad
            state[S.SOZLUK_ISTENMEDI] = False
            state[S.OKUNDU] = False
            _logla("sozluk: {}".format(ad))
            return "Sözlük **{}** olarak seçildi.\n\n{}".format(
                ad, _durum_metni()), None

    if kucuk in ("oku", "basla", "başla"):
        if not state.get(S.VERI_SETI):
            return "Önce veri setini seçmeniz lazım: `veri <dataset adı>`", None
        if not state.get(S.SOZLUK) and not state.get(S.SOZLUK_ISTENMEDI):
            return ("Sözlüğü de belirtin: `sozluk <dataset adı>` ya da "
                    "`sozluk yok`"), None
        return None, BLOK_SOZLUK_OKU

    return None, None


def process(trace):
    try:
        mesaj = _mesaji_al()
        asama = state.get(S.ASAMA) or Asama.KURULUM
        _logla("asama={} mesaj={!r}".format(asama, mesaj[:80]))

        if not mesaj:
            yield "{}\n\n{}".format(KARSILAMA, KURULUM_YARDIM)
            return

        if asama == Asama.KURULUM:
            cikti, sonraki = _kurulum_komutu(mesaj)
            if sonraki:
                yield NextBlock(sonraki)
                return
            if cikti:
                yield cikti
                return
            yield "Bunu anlamadım.\n\n" + KURULUM_YARDIM
            return

        yield "**{}** aşamasının komutları henüz yazılmadı.".format(asama)

    except Exception as hata:
        _logla("HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("Bir hata oluştu, hiçbir şey değişmedi. Ayrıntısı agent "
               "log'unda.")



Veri setinin kolonlarını ve sözlüğü okur, karşılaştırır, sonucu sema.json'a yazar. Dosya her seferinde baştan yazıldığı için kullanıcının daha önce girdiği tanımlar ve çıkardığı kolonlar önce okunup korunur. Kaynak sözlük dataset'ine dokunulmaz.




