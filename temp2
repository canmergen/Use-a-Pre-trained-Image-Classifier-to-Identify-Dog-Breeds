# ADIM 1.2A — HAM TABLOLAR  (Mod A)
# ===========================================================================
def ham_veri_girdi(durum, mesaj):
    # "tablolar: A, B, C" ya da virgullu liste
    ham = re.sub(r"^\s*tablolar\s*[:=]\s*", "", (mesaj or "").strip(), flags=re.I)
    adaylar = [a.strip() for a in re.split(r"[,\n;]+", ham) if a.strip()]
    adaylar = [a for a in adaylar if re.match(r"^[A-Za-z0-9_]+$", a)]

    if len(adaylar) < 2:
        return False, ("Birleştirilecek tabloları virgülle ayırarak yazın "
                       "(en az iki tablo):\n\n"
                       "    MUSTERI_ANA, HAVALE_ISLEM, KREDI_BAKIYE\n\n"
                       "İlk yazdığınız tablo iskelet olmak zorunda değil; "
                       "hangisinin iskelet olacağını ben öneririm.")

    eksik = [a for a in adaylar if not _dataset_var_mi(a)]
    if eksik:
        return False, ("Projede bulamadığım tablolar: %s\n\n"
                       "Adlarını kontrol eder misiniz?" % ", ".join(eksik))

    durum["ham_tablolar"] = adaylar
    return True, None


def ham_veri_plan(durum):
    satirlar = []
    toplam_kolon = 0
    for ad in durum["ham_tablolar"]:
        try:
            df = _df_oku(ad, limit=200)
            satirlar.append("  %-28s %s kolon" % (ad[:28], _sayi(df.shape[1])))
            toplam_kolon += int(df.shape[1])
        except Exception as e:
            satirlar.append("  %-28s okunamadı (%s)" % (ad[:28], str(e)[:40]))

    return ("%s tablo seçildi, toplam %s kolon:\n\n%s\n\n"
            "Şimdi bu tabloların şemalarını yapay zekâya göstereceğim. "
            "Hangisinin iskelet olacağını, diğerlerinin hangi anahtarla "
            "bağlanacağını ve işlem tablolarından hangi toplamaların "
            "üretileceğini önerecek.\n\n"
            "Planı çıkarayım mı?"
            % (_sayi(len(durum["ham_tablolar"])), _sayi(toplam_kolon),
               "\n".join(satirlar)))


def ham_veri_uygula(durum):
    return "Tablolar kaydedildi."


