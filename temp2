            "üreteceğiz ve değişken sözlüğünü hazırlayacağız.\n\n"
            "Oluşturulacak çıktılar:\n"
            "%s — veri seti\n"
            "%s — değişken sözlüğü\n\n"
            "Mevcut veri setleriniz değiştirilmez; bu çıktılar yeni "
            "oluşturulur." % (BAZ_ADI, SOZLUK_ADI))


def mod_plan(durum):
    """Baslangic secimi otomatik adim oldugu icin ayri onay plani yok;
    ADIMLAR kaydi bir plan fonksiyonu bekledigi icin ozeti dondurur."""
    return mod_uygula(durum)











