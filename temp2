def _soru_baglami(durum, anahtar, adim):
    mod = durum.get("mod")
    satirlar = [
        "Platform beş fazda çalışır: "
        "(1) Çalışma Kurulumu: veri kaynakları, hedef değişken, modelleme "
        "kapsamı ve veri bölme stratejisi; "
        "(2) Veri Anlama ve Hazırlama: veri profili, kalite, SFA ve "
        "stabilite, sonunda analitik baz set; "
        "(3) Değişken Mühendisliği: kural tabanlı ve yapay zekâ destekli "
        "aday değişken üretimi; "
        "(4) Değişken Değerlendirme: aday değişkenlerin kalite, ilişkiler, "
        "stabilite ve tahmin gücü açısından değerlendirilmesi, sonunda "
        "aday değişken seti; "
        "(5) Modelleme ve Finalizasyon: model seçimi, katkı ölçümü, "
        "doğrulama ve değişken kataloğu.",
        "Çalışma başlangıçları: "
        "A = Veri Seti ve Sözlük Hazır (doğrudan modelleme tanımlarına "
        "geçilir); "
        "B = Veri Seti Hazır, Sözlük Hazır Değil (değişken sözlüğü "
        "oluşturulur); "
        "C = Veri Seti ve Sözlük Hazır Değil (kaynak tablolar birleştirilir, "
        "veri seti ve değişken sözlüğü oluşturulur). "
        "Seçim, Çalışma Kurulumu fazında hangi adımların çalışacağını "
        "belirler; sonraki fazlar her seçimde aynıdır.",
        "Terminoloji: 'feature' yerine 'değişken', 'target' yerine 'hedef "
        "değişken', 'feature set' yerine 'değişken seti' de.",
        "Seçili başlangıç: %s" % (
            "%s — %s" % (mod, MOD_ADLARI[mod]) if mod in MOD_ADLARI
            else "henüz seçilmedi"),
        "Şu anki adım: %s" % adim.get("baslik", anahtar),
    ]
    if adim.get("aciklama"):
        satirlar.append("Adımın amacı: " + adim["aciklama"])
    if durum.get("bekleyen") == "girdi":
        satirlar.append("Kullanıcıdan beklenen: bir seçim ya da bilgi girmesi.")
    else:
        satirlar.append("Kullanıcıdan beklenen: öneriyi onaylaması, "
                        "değiştirmesi veya geri dönmesi.")
    try:
        satirlar.append("Oturum özeti: " + json.dumps(
            ozet(durum), ensure_ascii=False, default=str)[:1500])
    except Exception:
        pass
    return "\n".join(satirlar)
















