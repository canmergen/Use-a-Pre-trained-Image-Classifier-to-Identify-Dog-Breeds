    # ================================================================
    # PRED kolonu -> aynı hedefin ACT kolonu eşleşmesi
    # ----------------------------------------------------------------
    # PRED_<klasör>_OOT###### biçimindeki kolon adından klasör adı
    # çıkarılır, tablodan karşılık gelen ACT kolonu bulunur.
    # Yeni bir klasör/hedef eklenirse SADECE burası güncellenir.
    # ================================================================
    ACT_ESLESME = {
        "3M_KIRMIZI_RENGE_GOC":  "ACT_RENK3MSONRASIKIRMIZI",
        "6M_KIRMIZI_RENGE_GOC":  "ACT_RENK6MSONRASIKIRMIZI",
        "12M_KIRMIZI_RENGE_GOC": "ACT_RENK12MSONRASIKIRMIZI",
        "6M_TAKIP":              "ACT_TAKIP6M",
        "12M_TAKIP":             "ACT_TAKIP12M",
    }

    def _act_esi(pred_col, act_cols):
        """PRED_<klasör>_OOT###### -> aynı hedefin ACT kolon adı.
        Eşleşme yoksa None döner (kolon boş bırakılır, hata vermez)."""
        _t = pred_col[len("PRED_"):]
        if "_OOT" in _t:
            _t = _t.rsplit("_OOT", 1)[0]
        _a = ACT_ESLESME.get(_t)
        return _a if (_a is not None and _a in act_cols) else None

    def _bucket_blogu(dsub, etiket, skor_col, isaret, act_cols, pred_cols,
                      grup_col="RENK_KOD"):
        """Bir kitle için 20 satırlık bucket tablosu + TOPLAM satırı döner.

        Sol taraf  : kıyas skoru (DAVRANIS/MUSTERI) sıralaması
                     -> ACT (%) + ACT (adet) + PRED (%)
        Sağ taraf  : MODELİN KENDİ sıralaması, her PRED kolonunun yanında
                     -> (kendi bucket PRED) (%) : modelin 1 basma oranı
                     -> (kendi bucket ACT)  (%) : o dilimdeki GERÇEKLEŞME

        Modelin kendi sıralaması, kitlede birden fazla renk varsa
        (GENEL bloğu) ham skorla değil RENK İÇİ YÜZDELİK RANK ile
        yapılır: 6 rengin 6 ayrı modeli farklı skor ölçeklerinde
        olduğu için ham skorlar tek sıralamada kıyaslanamaz.
        Tek renkli bloklarda rank ham skorla aynı sıralamayı verir."""
        d = dsub.copy()
        d["_B"] = _bucketla_riskli(isaret * d[skor_col].to_numpy(dtype="float64"))
        _bser  = d["_B"]
        _bidx  = _bser.value_counts().sort_index().index
        _yon   = "düşük" if isaret < 0 else "yüksek"
        _bucket_kolon = f"BUCKET (1=en riskli, {_yon} {skor_col})"

        blok = pd.DataFrame({
            "SEGMENT": etiket,
            _bucket_kolon: _bidx,
            "MÜŞTERİ": _bser.value_counts().sort_index().values,
            "SKOR_MIN": d.groupby("_B")[skor_col].min().reindex(_bidx).round(4).values,
            "SKOR_ORT": d.groupby("_B")[skor_col].mean().reindex(_bidx).round(4).values,
            "SKOR_MAX": d.groupby("_B")[skor_col].max().reindex(_bidx).round(4).values,
        })

        # ---- ACT: kıyas skorunun bucket'ında gerçekleşme -------------
        for c in act_cols:
            _num = pd.to_numeric(d[c], errors="coerce")
            _gc  = _num.groupby(_bser)
            blok[f"{c} (%)"]    = _gc.mean().reindex(_bidx).round(4).values
            blok[f"{c} (adet)"] = _gc.sum().reindex(_bidx).fillna(0).astype("int64").values

        # ---- PRED + modelin kendi sıralaması -------------------------
        for c in pred_cols:
            _pnum = pd.to_numeric(d[c], errors="coerce")
            blok[f"{c} (%)"] = _pnum.groupby(_bser).mean().reindex(_bidx).round(4).values

            _skor_c  = "SKOR_" + c[len("PRED_"):]
            _act_c   = _act_esi(c, act_cols)
            _kb_pred = [None] * len(_bidx)
            _kb_act  = [None] * len(_bidx)

            if _skor_c in d.columns:
                _dm = d[d[_skor_c].notna()]
                if len(_dm) >= ANALIZ_N_BUCKET:
                    # sıralama tabanı: çok renkliyse renk içi pct rank
                    if grup_col in _dm.columns and _dm[grup_col].nunique() > 1:
                        _taban = (_dm.groupby(grup_col)[_skor_c]
                                     .rank(pct=True, method="average")
                                     .to_numpy(dtype="float64"))
                    else:
                        _taban = _dm[_skor_c].to_numpy(dtype="float64")

                    _bm = _bucketla_riskli(_taban)

                    _gp = (pd.Series(pd.to_numeric(_dm[c], errors="coerce").to_numpy())
                             .groupby(_bm).mean().round(4))
                    _kb_pred = [float(_gp[b]) if b in _gp.index else None for b in _bidx]

                    if _act_c is not None:
                        _ga = (pd.Series(pd.to_numeric(_dm[_act_c], errors="coerce").to_numpy())
                                 .groupby(_bm).mean().round(4))
                        _kb_act = [float(_ga[b]) if b in _ga.index else None for b in _bidx]

            blok[f"{c} (kendi bucket PRED) (%)"] = _kb_pred
            blok[f"{c} (kendi bucket ACT) (%)"]  = _kb_act

        # ---- TOPLAM satırı: segmentin tamamı (bucket'suz) ------------
        _top = {
            "SEGMENT": etiket,
            _bucket_kolon: "TOPLAM",
            "MÜŞTERİ": int(len(d)),
            "SKOR_MIN": round(float(d[skor_col].min()), 4),
            "SKOR_ORT": round(float(d[skor_col].mean()), 4),
            "SKOR_MAX": round(float(d[skor_col].max()), 4),
        }
        for c in act_cols:
            _v = pd.to_numeric(d[c], errors="coerce")
            _top[f"{c} (%)"]    = round(float(_v.mean()), 4)
            _top[f"{c} (adet)"] = int(_v.fillna(0).sum())

        for c in pred_cols:
            _vp = pd.to_numeric(d[c], errors="coerce")
            _top[f"{c} (%)"] = round(float(_vp.mean()), 4) if _vp.notna().any() else None

            _skor_c = "SKOR_" + c[len("PRED_"):]
            _act_c  = _act_esi(c, act_cols)
            _kp = _ka = None
            if _skor_c in d.columns:
                # TOPLAM'da sağ taraf, model skoru DOLU alt kitlenin
                # bazını gösterir -> soldaki TOPLAM ile farkı kapsam farkı
                _dm = d[d[_skor_c].notna()]
                if len(_dm):
                    _v1 = pd.to_numeric(_dm[c], errors="coerce")
                    _kp = round(float(_v1.mean()), 4) if _v1.notna().any() else None
                    if _act_c is not None:
                        _v2 = pd.to_numeric(_dm[_act_c], errors="coerce")
                        _ka = round(float(_v2.mean()), 4) if _v2.notna().any() else None
            _top[f"{c} (kendi bucket PRED) (%)"] = _kp
            _top[f"{c} (kendi bucket ACT) (%)"]  = _ka

        blok = pd.concat([blok, pd.DataFrame([_top])], ignore_index=True)
        return blok







        ("ACT_ = o bucket'ta GERÇEKLEŞME oranı (bu skor gerçek riski ayrıştırıyor "
         "mu); '(adet)' = o bucket'ta gerçekleşen vaka SAYISI. Her segment "
         "bloğunun sonundaki TOPLAM satırı dönemin tamamını verir: kaç müşteri "
         "vardı, kaçı kırmızıya/takibe geçti (adet + oran). "
         "PRED_ = o bucket'ta MODELİN 1 bastığı oran (model bu skorun iyi "
         "dediği bucket'larda da risk buluyor mu). "
         "'(kendi bucket PRED)' ve '(kendi bucket ACT)' = AYNI kitle bu kez "
         f"{_col} yerine MODELİN KENDİ sıralamasına göre 20'ye bölündüğünde o "
         "bucket no'daki model işaretleme oranı ve GERÇEKLEŞME oranı. Çok renkli "
         "bloklarda (GENEL) model sıralaması renk içi yüzdelik rank ile yapılır; "
         "6 modelin ham skorları farklı ölçeklerde olduğu için doğrudan "
         "kıyaslanamaz. ASIL OKUMA: aynı satırda soldaki ACT (%) ile sağdaki "
         "(kendi bucket ACT) (%) karşılaştırılır — sağdaki belirgin yüksekse "
         "model, kıyas skorundan daha iyi sıralıyor demektir. Sağ taraf model "
         "skoru dolu alt kitlede hesaplanır, taban soldakiyle birebir aynı "
         "değil."),
