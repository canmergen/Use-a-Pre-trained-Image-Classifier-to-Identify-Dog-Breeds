        satirlar.append("      %s" % o["ifade"])
        if o.get("gerekce"):
            satirlar.append("      %s" % o["gerekce"][:88])

    red_not = ("\n\n%s" % _liste("Güvenlik kontrolünü geçemeyenler (atıldı):",
                                 ["%s — %s" % r for r in reddedilen], 5)) if reddedilen else ""

    return ("Yapay zekâ, kalıpların dışında %s yeni değişken hipotezi üretti. "
            "Her hipotez güvenlik ve geçerlilik kontrolünden geçti; kullanılan "
            "tüm kolonlar veri setinde mevcut.\n\n%s%s\n\n"
            "Üretirken her birinin Python kodunu da yazacağım.\n\n"
            "Hepsi için \"onay\", seçmek için numara yazın: örn. \"2,4 onay\""
            % (_sayi(len(gecerli)), "\n".join(satirlar), red_not))


