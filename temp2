# =============================================================================
# FEATURE_DISCOVERY_AGENT / kolon_sorgu
# -----------------------------------------------------------------------------
# Kolon bazinda soru-cevap, sozluk duzeltmesi ve kolon cikarma.
# Aciklamalar sema.json ve kullanici eklerinden DETERMINISTIK okunur;
# LLM tahmini kullanilmaz.
#
# Kaynak oncelik sirasi:
#   1. sozluk_ek.json      -> kullanicinin verdigi tanimlar
#   2. sema.json > sozluk  -> sozluk dataset'inden gelenler
#   3. (yedek) sozluk dataset
#
# Yazma: bir tanim kaydedilince UC yer guncellenir (sozluk_ek.json,
# sema.json, DEGISKENLER_GUNCEL). Kaynak sozluk DEGISTIRILMEZ.
# =============================================================================

import difflib
import json

import pandas as pd

import dataiku


HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"
GUNCEL_SOZLUK_DATASET = "DEGISKENLER_GUNCEL"

AD_KOLONU = "kolon"
ACIKLAMA_KOLONU = "aciklama"

AZAMI_KOLON = 10
BENZERLIK_ESIGI = 0.6
AZAMI_ONERI = 5

AKSIYON_TANIMLA = "kolon_tanimla"
AKSIYON_CIKAR = "kolon_cikar"


class Sema:
    KOLONLAR = "kolonlar"
    TIPLER = "tipler"
    SOZLUK = "sozluk"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"
    HARIC_KOLONLAR = "haric_kolonlar"


class S:
    AKSIYON = "aksiyon"
    SOZLUK = "sozluk"
    VERI_SETI = "veri_seti"
    KOLONLAR = "kolonlar"
    KOLON_ACIKLAMASI = "kolon_aciklamasi"
    CIKARILACAK = "cikarilacak_kolonlar"
    BEKLEYEN_KOLON = "bekleyen_kolon"


def _logla(mesaj):
    print("[kolon_sorgu] {}".format(mesaj))


def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _json_oku(dosya_yolu, varsayilan):
    try:
        folder = _folder()
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _json_yaz(dosya_yolu, veri):
    try:
        icerik = json.dumps(veri, ensure_ascii=False, indent=2)
        _folder().upload_data(dosya_yolu, icerik.encode("utf-8"))
        return True
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(dosya_yolu, hata))
        return False


def _sayi(deger):
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _kaynak_sozlugu_oku(sozluk_adi):
    """sema.json okunamazsa yedek yol: sozluk dataset'ini pozisyona gore okur."""
    if not sozluk_adi:
        return {}
    try:
        df = dataiku.Dataset(sozluk_adi).get_dataframe()
    except Exception as hata:
        _logla("kaynak sozluk okunamadi: {}".format(hata))
        return {}
    if df.shape[1] < 2:
        return {}
    ad_k, acik_k = df.columns[0], df.columns[1]
    sonuc = {}
    for _, satir in df.iterrows():
        ad = str(satir[ad_k]).strip()
        if ad and ad.lower() != "nan":
            sonuc[ad] = str(satir[acik_k]).strip()
    return sonuc


def _kolonu_bul(aranan, mevcut_adlar):
    if aranan in mevcut_adlar:
        return aranan
    kucuk = {ad.lower(): ad for ad in mevcut_adlar}
    return kucuk.get(aranan.strip().lower())


def _benzer_kolonlar(aranan, mevcut_adlar):
    return difflib.get_close_matches(
        aranan, list(mevcut_adlar), n=AZAMI_ONERI, cutoff=BENZERLIK_ESIGI)


def _kolon_basligi(kolon, tip, tabloda_var, haric_mi):
    parcalar = ["tabloda var" if tabloda_var else "**tabloda yok**"]
    if tip:
        parcalar.append("tip: {}".format(tip))
    if haric_mi:
        parcalar.append("**süreç dışı**")
    return "**{}** ({})".format(kolon, ", ".join(parcalar))


def _sorguyu_cevapla(kolonlar, sozluk, ek_sozluk, tablo_kolonlari, tipler, haric):
    tablo_kumesi = set(tablo_kolonlari)
    bilinen = set(sozluk) | set(ek_sozluk) | tablo_kumesi
    parcalar = []

    for aranan in kolonlar[:AZAMI_KOLON]:
        temiz = str(aranan).strip()
        gercek = _kolonu_bul(temiz, bilinen)

        if gercek is None:
            benzerler = _benzer_kolonlar(temiz, bilinen)
            if benzerler:
                parcalar.append(
                    "**{}** ne tabloda ne sözlükte var. Şunu mu kastettiniz: "
                    "{}".format(temiz,
                                ", ".join("`{}`".format(b) for b in benzerler)))
            else:
                parcalar.append("**{}** ne tabloda ne sözlükte bulundu.".format(
                    temiz))
            continue

        baslik = _kolon_basligi(gercek, tipler.get(gercek),
                                gercek in tablo_kumesi, gercek in haric)

        if gercek in ek_sozluk:
            parcalar.append("{}\n{}\n_Kaynak: sizin tanımınız._".format(
                baslik, ek_sozluk[gercek]))
        elif sozluk.get(gercek):
            parcalar.append("{}\n{}".format(baslik, sozluk[gercek]))
        else:
            parcalar.append("{}\nSözlükte açıklaması yok. Ne anlama geldiğini "
                            "yazarsanız kaydederim.".format(baslik))

    if len(kolonlar) > AZAMI_KOLON:
        parcalar.append("_({} kolon sordunuz, ilk {} tanesini yanıtladım.)_".format(
            len(kolonlar), AZAMI_KOLON))

    return "\n\n".join(parcalar)


def _semayi_guncelle(yeni_tanimlar, cikarilanlar):
    sema = _json_oku(SEMA_DOSYASI, {})
    if not isinstance(sema, dict) or not sema:
        return False

    sozluk = sema.get(Sema.SOZLUK)
    if not isinstance(sozluk, dict):
        sozluk = {}
    sozluk.update(yeni_tanimlar)
    sema[Sema.SOZLUK] = sozluk

    haric = sema.get(Sema.HARIC_KOLONLAR)
    haric = haric if isinstance(haric, list) else []
    for kolon in cikarilanlar:
        if kolon not in haric:
            haric.append(kolon)
    sema[Sema.HARIC_KOLONLAR] = haric

    eksikler = sema.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    if isinstance(eksikler, list):
        sema[Sema.TABLODA_VAR_SOZLUKTE_YOK] = [
            k for k in eksikler
            if k not in yeni_tanimlar and k not in cikarilanlar]

    return _json_yaz(SEMA_DOSYASI, sema)


def _guncel_sozlugu_yaz(ek_sozluk):
    sema = _json_oku(SEMA_DOSYASI, {})
    sozluk = sema.get(Sema.SOZLUK) if isinstance(sema, dict) else {}
    sozluk = sozluk if isinstance(sozluk, dict) else {}
    haric = sema.get(Sema.HARIC_KOLONLAR) if isinstance(sema, dict) else []
    haric = set(haric) if isinstance(haric, list) else set()

    birlesik = dict(sozluk)
    birlesik.update(ek_sozluk)
    adlar = sorted(k for k in birlesik if k not in haric)

    df = pd.DataFrame({
        AD_KOLONU: adlar,
        ACIKLAMA_KOLONU: [birlesik[ad] for ad in adlar],
        "kaynak": ["eklenen" if ad in ek_sozluk else "sozluk" for ad in adlar],
    })

    try:
        dataiku.Dataset(GUNCEL_SOZLUK_DATASET).write_with_schema(df)
        return True, len(df)
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(GUNCEL_SOZLUK_DATASET, hata))
        return False, len(df)


def _tanimi_kaydet(kolonlar, aciklama, sozluk, ek_sozluk, tablo_kolonlari):
    bilinen = set(sozluk) | set(ek_sozluk) | set(tablo_kolonlari)

    if not kolonlar:
        return ("Açıklamayı hangi kolon için kaydedeceğimi anlayamadım. "
                "Kolon adını yazar mısınız?")
    if not aciklama:
        return ("**{}** için açıklamayı alamadım. Ne anlama geldiğini yazar "
                "mısınız?".format(kolonlar[0]))

    hedef = str(kolonlar[0]).strip()
    gercek = _kolonu_bul(hedef, bilinen) or hedef
    onceki = ek_sozluk.get(gercek) or sozluk.get(gercek)

    ek_sozluk[gercek] = aciklama
    ek_yazildi = _json_yaz(EK_SOZLUK_DOSYASI, ek_sozluk)
    sema_yazildi = _semayi_guncelle({gercek: aciklama}, [])
    ds_yazildi, toplam = _guncel_sozlugu_yaz(ek_sozluk)

    if onceki:
        bas = ("**{}** açıklaması güncellendi.\n\nÖnceki: {}\nYeni: {}".format(
            gercek, onceki, aciklama))
    else:
        bas = "**{}** açıklaması kaydedildi: {}".format(gercek, aciklama)

    basarisizlar = []
    if not ek_yazildi:
        basarisizlar.append("kullanıcı tanımları dosyası")
    if not sema_yazildi:
        basarisizlar.append("oturum kaydı (sema.json)")
    if not ds_yazildi:
        basarisizlar.append(GUNCEL_SOZLUK_DATASET)

    if basarisizlar:
        return bas + "\n\nAncak şuralara yazılamadı: {}.".format(
            ", ".join(basarisizlar))

    return bas + "\n\n**{}** güncellendi: {} satır.".format(
        GUNCEL_SOZLUK_DATASET, _sayi(toplam))


def _kolonlari_cikar(cikarilacaklar, sozluk, ek_sozluk, tablo_kolonlari):
    """Kolonlari surec disi birakir."""
    bilinen = set(sozluk) | set(ek_sozluk) | set(tablo_kolonlari)

    gercekler = []
    bulunamayan = []
    for ad in cikarilacaklar:
        gercek = _kolonu_bul(str(ad).strip(), bilinen)
        if gercek:
            gercekler.append(gercek)
        else:
            bulunamayan.append(str(ad).strip())

    if not gercekler:
        return ("Çıkarılacak kolonu bulamadım: {}. Kolon adını tam yazar "
                "mısınız?".format(", ".join("`{}`".format(a) for a in bulunamayan)))

    for kolon in gercekler:
        ek_sozluk.pop(kolon, None)

    ek_yazildi = _json_yaz(EK_SOZLUK_DOSYASI, ek_sozluk)
    sema_yazildi = _semayi_guncelle({}, gercekler)
    ds_yazildi, toplam = _guncel_sozlugu_yaz(ek_sozluk)

    bas = "Süreç dışı bırakıldı: {}".format(
        ", ".join("**{}**".format(k) for k in gercekler))
    if bulunamayan:
        bas += "\n\nBulamadığım kolonlar: {}".format(
            ", ".join("`{}`".format(a) for a in bulunamayan))

    basarisizlar = []
    if not ek_yazildi:
        basarisizlar.append("kullanıcı tanımları dosyası")
    if not sema_yazildi:
        basarisizlar.append("oturum kaydı (sema.json)")
    if not ds_yazildi:
        basarisizlar.append(GUNCEL_SOZLUK_DATASET)

    if basarisizlar:
        return bas + "\n\nAncak şuralara yazılamadı: {}.".format(
            ", ".join(basarisizlar))

    return (bas + "\n\nBu kolonlar sonraki adımlarda kullanılmayacak. "
            "**{}** artık {} satır.".format(
                GUNCEL_SOZLUK_DATASET, _sayi(toplam)))


def process(trace):
    try:
        aksiyon = (state.get(S.AKSIYON) or "").strip().lower()
        kolonlar = state.get(S.KOLONLAR) or []
        if not isinstance(kolonlar, list):
            kolonlar = [kolonlar]
        cikarilacaklar = state.get(S.CIKARILACAK) or []
        if not isinstance(cikarilacaklar, list):
            cikarilacaklar = [cikarilacaklar]

        sema = _json_oku(SEMA_DOSYASI, {})
        sema = sema if isinstance(sema, dict) else {}
        ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
        ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}

        sozluk = sema.get(Sema.SOZLUK)
        tablo_kolonlari = sema.get(Sema.KOLONLAR)
        tipler = sema.get(Sema.TIPLER)
        haric = sema.get(Sema.HARIC_KOLONLAR)

        if not isinstance(sozluk, dict) or not sozluk:
            _logla("sema.json'da sozluk yok, kaynak dataset okunuyor")
            sozluk = _kaynak_sozlugu_oku(state.get(S.SOZLUK))
        if not isinstance(tablo_kolonlari, list):
            tablo_kolonlari = []
        if not isinstance(tipler, dict):
            tipler = {}
        haric = set(haric) if isinstance(haric, list) else set()

        if not sozluk and not tablo_kolonlari:
            yield ("Sözlüğü ve veri setini şu an okuyamıyorum. Ayrıntı agent "
                   "log'unda.")
            return

        if aksiyon == AKSIYON_CIKAR or (cikarilacaklar and not
                                        state.get(S.KOLON_ACIKLAMASI)):
            hedefler = cikarilacaklar or [str(k).strip() for k in kolonlar]
            state[S.BEKLEYEN_KOLON] = None
            cevap = _kolonlari_cikar(hedefler, sozluk, ek_sozluk,
                                     tablo_kolonlari)
        elif aksiyon == AKSIYON_TANIMLA:
            aciklama = str(state.get(S.KOLON_ACIKLAMASI) or "").strip()
            if not kolonlar and state.get(S.BEKLEYEN_KOLON):
                kolonlar = [state[S.BEKLEYEN_KOLON]]
            state[S.BEKLEYEN_KOLON] = None
            cevap = _tanimi_kaydet(kolonlar, aciklama, sozluk, ek_sozluk,
                                   tablo_kolonlari)
        elif not kolonlar:
            cevap = ("Hangi kolonu sorduğunuzu anlayamadım. Kolon adını yazar "
                     "mısınız? Örnek: `rn nedir`")
        else:
            if len(kolonlar) == 1:
                state[S.BEKLEYEN_KOLON] = str(kolonlar[0]).strip()
            cevap = _sorguyu_cevapla(kolonlar, sozluk, ek_sozluk,
                                     tablo_kolonlari, tipler, haric)

        # Bos cevap sohbette bos balon olarak gorunur; asla bos gonderme.
        if not (cevap or "").strip():
            _logla("UYARI: bos cevap, aksiyon={}".format(aksiyon))
            cevap = ("İsteğinizi işledim ama gösterilecek bir sonuç üretemedim. "
                     "Kolon adını tekrar yazar mısınız?")

        yield cevap

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield ("Kolon işlemini yaparken beklenmeyen bir hata oluştu. Ayrıntı "
               "agent log'una yazıldı.")



















Bir bankanın analitik ekibi için "Akıllı Değişken Üretimi" sürecini
yürütüyorsun. Kullanıcının verdiği veri setinden yola çıkarak, hedef
değişkeni daha iyi açıklayan yeni değişkenler üretilmesini sağlıyorsun.

Durum

DURUM: {{ state.durum_ozeti }}

Yukarıdaki DURUM satırı tek doğruluk kaynağıdır. Veri seti, sözlük ve
bulunulan adım hakkında yalnızca orada yazanı doğru kabul et; sohbet
geçmişindeki eski bilgiler geçersiz olabilir.

Kendini tanıtma, "ben ... yapıyorum" gibi cümleler kurma. Ne yapıldığını
söyle, kim olduğunu değil.

Kendi erişim yeteneğin hakkında konuşma. "Erişimim var", "erişimim yok",
"klasörü görebiliyorum", "henüz okumadım" gibi cümleler kurma.

Kullanıcının bahsettiği dosya ve klasör adlarını veri seti adı sanma.
sema.json, PROJE_HAFIZASI gibi adlar birer dataset değildir.

Adım durumu yalnızca sistem tarafından değiştirilir. Bir adımı "tamamlandı"
ilan etme, "şimdi şu adıma geçiyorum" deme. Kullanıcı onay verdiğinde sen
bir işlem başlatmazsın; onayı sistem alır.

Kolon anlamlarını kendin uydurma. DURUM satırında KOLON BAGLAMI varsa orada
yazan bilgiyi kullanabilir ve kullanıcının verdiği anlamı daha iyi nasıl
ifade edeceğine dair öneri sunabilirsin. Kolona kendi başına yeni bir anlam
atfetme; önerdiğin ifadeyi onaya sun.

Karşılama, altı adımın listesi ve başlangıç bilgi isteği sistem tarafından
zaten gösterildi. Bunları tekrarlama. Önceki mesajlarını da tekrar etme.

Kurallar

Her adımın başında ne yapacağını yaz ve onay bekle.

Veri hakkında hiçbir sayı, kolon adı, oran veya sonuç üretme. Bu bilgiler
sana sistem tarafından verilir. Verilmemişse bilmediğini söyle.

Sadece yeni değişken eklemeyi öner; mevcut bir değişkenin çıkarılmasını
kendiliğinden gündeme getirme. Kullanıcı isterse çıkarma işlemini sistem
yapar.

Kullanıcı önceki bir adımda verdiği bilgiyi değiştirmek isterse itiraz etme.

Süreç şu altı adımdan oluşur; kullanıcı sorarsa buna göre cevapla:
1. Sözlük hazırlığı — kolon açıklamalarını derler ve sıkıştırır
2. Meta tanımı — hedef, kimlik, dönem ve bölme yapısını belirler
3. Kural bazlı üretim — delta, oran, lag, momentum gibi türetmeler
4. Model destekli üretim — hipotez kurar, test eder, kanıtlananı kaydeder
5. Veri kalitesi kontrolü — eksik, sabit, tekrarlı, sızıntı riskli
6. Model karşılaştırması — mevcut ve zenginleştirilmiş halin performansı

Kavramlar

Veri seti: Projedeki bir Dataiku dataset'i. Her satırı tekil tanımlayan bir
kimlik kolonu ve tahmin edilecek hedef değişken içermeli. Dönem kolonu
olabilir de olmayabilir de. Train, test ve validation ayrı dataset olarak
verilmez; bölme sistem tarafından yapılır.

Sözlük: İki kolonlu bir Dataiku dataset'i. Birinci kolon kolon adlarını,
ikinci kolon açıklamalarını içerir. Verilmezse kolon adlarından anlam
çıkarılmaya çalışılır, doğruluk düşer.

Konfigürasyon: Hedef değişken, kimlik kolonu ve varsa dönem kolonunun
adlarını içeren bir JSON. Vermezse 2. adımda birlikte oluşturulur.

Üslup

Yalın ve doğal Türkçe. Kurumsal ol ama bürokratik olma: "yürütmekteyim",
"ele alınacaktır" gibi kalıpları kullanma.

Promptta olmayan hiçbir vaat, fayda veya süsleme cümlesi ekleme.

Kısa yaz. Bir şeyi bir kere söyle. Kapanış tek cümle olsun ve her mesajda
farklı kur.

Emoji kullanma. Markdown kullan: adım adları, kolon ve dataset adları kalın.

Kullanıcı sert bir üslup kullanırsa aynı sakin dili koru.



















