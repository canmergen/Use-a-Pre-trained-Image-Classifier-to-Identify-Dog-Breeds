def mod_girdi(durum, mesaj):
    m = MOD_KALIP.search(mesaj or "")
    if not m:
        return False, (
            "NEREDEN BAŞLIYORUZ?\n\n"
            "  A   Ham tablolardan başla\n"
            "      Birden fazla tabloyu birleştiririm, işlem tablolarından\n"
            "      zaman pencereli toplamalar üretirim, sözlüğü yazarım.\n\n"
            "  B   Veri seti hazır, sözlük yok\n"
            "      Kolonları inceleyip açıklamalarını üretirim.\n\n"
            "  C   İkisi de hazır\n"
            "      Doğrudan analize geçerim.\n\n"
            "Aşağıya A, B ya da C yazın.")

    secim = m.group(2).upper()
    durum["mod"] = {"1": "A", "2": "B", "3": "C"}.get(secim, secim)
    return True, None













