# =============================================================================
# FEATURE_DISCOVERY_AGENT / baslat
# -----------------------------------------------------------------------------
# Sorumluluk : Prompt sablonlarinin okudugu state anahtarlarinin her zaman
#              var olmasini garanti eder ve akisi girdi_al'a devreder.
#
# NEDEN GEREKLI:
#   girdi_al ve sohbet bloklari promptlarinda {{ state.durum_ozeti }} ve
#   {{ state.beklenen }} okuyor. Dataiku'nun Micro-CEL degerlendiricisi
#   eksik anahtarda hata firlatiyor ve ilk turda state bos oluyor.
#   Bu blok Starting block olarak calisip anahtarlari onceden doldurur.
#
# Her turda calisir ama yalnizca EKSIK anahtarlari doldurur; mevcut degerlere
# dokunmaz.
# =============================================================================

from dataiku.llm.python.blocks_graph import NextBlock


# Prompt sablonlarinin ve akisin bekledigi anahtarlar ile ilk degerleri.
VARSAYILANLAR = {
    "durum_ozeti": "Surec henuz baslamadi. Veri seti belirlenmedi.",
    "beklenen": "yok",
    "aksiyon": "bilgi",
    "kolonlar": [],
    "kolon_aciklamasi": "",
    "asama": "baslangic",
}

SONRAKI_BLOK = "girdi_al"


def process(trace):
    eklenenler = []
    for anahtar, ilk_deger in VARSAYILANLAR.items():
        if state.get(anahtar) is None:
            state[anahtar] = ilk_deger
            eklenenler.append(anahtar)

    if eklenenler:
        print("[baslat] varsayilan atanan anahtarlar: {}".format(
            ", ".join(eklenenler)))

    yield NextBlock(SONRAKI_BLOK)
