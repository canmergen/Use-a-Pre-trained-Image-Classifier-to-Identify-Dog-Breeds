/* ==================== Balon kurucu ==================== */
function balonYap(rol, metin, hataMi) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Kullanıcı";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon" + (hataMi ? " hata" : "");
    balon.textContent = metin;      // textContent: metin HTML olarak yorumlanmaz
    satir.appendChild(balon);
    return satir;
}

function balonEkle(rol, metin, hataMi) {
    const satir = balonYap(rol, metin, hataMi);
    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}


/* ==================== Seçenek kartları ==================== */
/* Backend "secenekler" dondurdugunde kullanici yazmak yerine tiklayarak
   secer. Secim yapilinca kartlar kilitlenir ve secilen vurgulanir. */
function secenekEkle(secenekler) {
    if (!secenekler || !secenekler.length) return;

    const kok = document.createElement("div");
    kok.className = "secenek-kok";

    secenekler.forEach(s => {
        const kart = document.createElement("button");
        kart.className = "secenek";
        kart.type = "button";

        const rozet = document.createElement("span");
        rozet.className = "secenek-rozet";
        rozet.textContent = s.deger;
        kart.appendChild(rozet);

        const govde = document.createElement("div");
        govde.className = "secenek-govde";

        const bas = document.createElement("div");
        bas.className = "secenek-baslik";
        bas.textContent = s.baslik;
        govde.appendChild(bas);

        if (s.aciklama) {
            const ack = document.createElement("div");
            ack.className = "secenek-aciklama";
            ack.textContent = s.aciklama;
            govde.appendChild(ack);
        }
        kart.appendChild(govde);

        kart.onclick = () => {
            if (mesgul) return;
            // Kart grubunu kilitle, secileni isaretle
            Array.from(kok.querySelectorAll(".secenek")).forEach(k => {
                k.disabled = true;
                k.classList.toggle("secili", k === kart);
            });
            gonder(s.deger, false);      // false: kullanici balonu basma
        };

        kok.appendChild(kart);
    });

    sohbetEl.appendChild(kok);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
}


/* ==================== Seçim formu ==================== */
/* Backend "secim_alani" dondurdugunde dataset secici basilir.
   tip "form"  : bir veya iki tekli alan
   tip "liste" : + ile ekle, − ile cikar coklu liste */

function comboYap(etiket, secilince) {
    const kok = document.createElement("div");
    kok.className = "combo";

    if (etiket) {
        const lbl = document.createElement("label");
        lbl.textContent = etiket;
        kok.appendChild(lbl);
    }

    const giris = document.createElement("input");
    giris.className = "combo-giris";
    giris.placeholder = "Ara veya yaz…";
    giris.autocomplete = "off";
    kok.appendChild(giris);

    const liste = document.createElement("ul");
    liste.className = "combo-liste";
    kok.appendChild(liste);

    function ciz(filtre) {
        const f = (filtre || "").toLowerCase();
        const sonuc = DATASETLER.filter(d => d.toLowerCase().includes(f)).slice(0, 80);
        liste.innerHTML = "";
        if (!sonuc.length) {
            const li = document.createElement("li");
            li.className = "bos";
            li.textContent = DATASETLER.length
                ? "Eşleşen tablo yok — yazdığınız ad yine de kullanılacak"
                : "Tablo listesi okunamadı — adı elle yazabilirsiniz";
            liste.appendChild(li);
            return;
        }
        sonuc.forEach(ad => {
            const li = document.createElement("li");
            li.textContent = ad;
            // mousedown: input'un blur olayindan ONCE calissin diye
            li.onmousedown = e => {
                e.preventDefault();
                giris.value = ad;
                liste.classList.remove("acik");
                if (secilince) secilince(ad, giris);
            };
            liste.appendChild(li);
        });
    }

    giris.addEventListener("focus", () => { ciz(giris.value); liste.classList.add("acik"); });
    giris.addEventListener("input", () => { ciz(giris.value); liste.classList.add("acik"); });
    giris.addEventListener("blur",  () => { setTimeout(() => liste.classList.remove("acik"), 130); });
    giris.addEventListener("keydown", e => {
        if (e.key === "Escape") liste.classList.remove("acik");
        if (e.key === "Enter") {
            e.preventDefault();
            liste.classList.remove("acik");
            if (secilince) secilince(giris.value.trim(), giris);
        }
    });

    return { kok: kok, giris: giris };
}

function secimAlaniEkle(alan) {
    if (!alan) return;

    const kart = document.createElement("div");
    kart.className = "secim-kart";

    const bas = document.createElement("div");
    bas.className = "secim-baslik";
    bas.textContent = alan.baslik || "";
    kart.appendChild(bas);

    if (alan.aciklama) {
        const ack = document.createElement("div");
        ack.className = "secim-aciklama";
        ack.textContent = alan.aciklama;
        kart.appendChild(ack);
    }

    const onayBtn = document.createElement("button");
    onayBtn.className = "secim-onay";
    onayBtn.type = "button";
    onayBtn.textContent = alan.buton || "Devam et";

    /* ---- tip: liste (coklu, + / −) ---- */
    if (alan.tip === "liste") {
        const secilenler = [];

        const rozetler = document.createElement("div");
        rozetler.className = "secim-rozetler";

        const satir = document.createElement("div");
        satir.className = "secim-satir";

        const combo = comboYap(alan.etiket || "Tablo ara", null);
        satir.appendChild(combo.kok);

        const ekleBtn = document.createElement("button");
        ekleBtn.className = "secim-yuvarlak ekle";
        ekleBtn.type = "button";
        ekleBtn.title = "Listeye ekle";
        ekleBtn.textContent = "+";
        satir.appendChild(ekleBtn);

        kart.appendChild(satir);
        kart.appendChild(rozetler);

        function durumTazele() {
            onayBtn.disabled = secilenler.length < (alan.min || 1);
            onayBtn.textContent = (alan.buton || "Devam et")
                + (secilenler.length ? "  (" + secilenler.length + ")" : "");
        }

        function rozetCiz() {
            rozetler.innerHTML = "";
            secilenler.forEach((ad, i) => {
                const r = document.createElement("div");
                r.className = "secim-rozet";

                const t = document.createElement("span");
                t.textContent = ad;
                r.appendChild(t);

                const sil = document.createElement("button");
                sil.className = "secim-yuvarlak sil";
                sil.type = "button";
                sil.title = "Listeden çıkar";
                sil.textContent = "−";
                sil.onclick = () => {
                    if (kart.classList.contains("kilitli")) return;
                    secilenler.splice(i, 1);
                    rozetCiz();
                    durumTazele();
                };
                r.appendChild(sil);
                rozetler.appendChild(r);
            });
        }

        function ekle() {
            const ad = combo.giris.value.trim();
            if (!ad || secilenler.indexOf(ad) !== -1) return;
            secilenler.push(ad);
            combo.giris.value = "";
            combo.giris.focus();
            rozetCiz();
            durumTazele();
        }

        ekleBtn.onclick = ekle;
        combo.giris.addEventListener("keydown", e => {
            if (e.key === "Enter") { e.preventDefault(); ekle(); }
        });

        onayBtn.onclick = () => {
            if (mesgul || secilenler.length < (alan.min || 1)) return;
            kart.classList.add("kilitli");
            onayBtn.disabled = true;
            ekleBtn.disabled = true;
            combo.giris.disabled = true;
            gonder((alan.sablon || "{liste}").replace("{liste}", secilenler.join(", ")),
                   secilenler.join(" · "));
        };

        durumTazele();
        kart.appendChild(onayBtn);

    /* ---- tip: form (bir veya iki tekli alan) ---- */
    } else {
        const govde = document.createElement("div");
        govde.className = "secim-govde";
        const girisler = {};

        function durumTazele() {
            onayBtn.disabled = !Object.keys(girisler)
                .every(k => girisler[k].value.trim().length > 1);
        }

        (alan.alanlar || []).forEach(a => {
            const combo = comboYap(a.etiket, () => durumTazele());
            combo.giris.addEventListener("input", durumTazele);
            girisler[a.ad] = combo.giris;
            govde.appendChild(combo.kok);
        });

        kart.appendChild(govde);

        onayBtn.onclick = () => {
            if (mesgul || onayBtn.disabled) return;
            let metin = alan.sablon || "";
            const parcalar = [];
            Object.keys(girisler).forEach(k => {
                const v = girisler[k].value.trim();
                metin = metin.replace("{" + k + "}", v);
                parcalar.push(v);
            });
            kart.classList.add("kilitli");
            onayBtn.disabled = true;
            Object.keys(girisler).forEach(k => { girisler[k].disabled = true; });
            gonder(metin, parcalar.join(" · "));
        };

        durumTazele();
        kart.appendChild(onayBtn);
    }

    sohbetEl.appendChild(kart);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
}


/* ==================== Dataset listesi ==================== */
fetch(getWebAppBackendUrl("datasetler"))
    .then(r => r.json())
    .then(d => { DATASETLER = d.datasetler || []; })
    .catch(() => { DATASETLER = []; });


/* ==================== Gönderme ==================== */
function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    aksiyonlar.forEach(c => { c.disabled = durum; });
}

function gonder(metinDisaridan, etiket) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    sayfaAc("calisma");
    // etiket === false -> hic balon basma (secenek kartlari kendi gosteriyor)
    // etiket verilirse balonda o gorunur, backend'e "metin" gider
    if (etiket !== false) balonEkle("kullanici", etiket || metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        const hataMi = typeof d.cevap === "string" && d.cevap.startsWith("HATA:");
        balonEkle("bot", d.cevap, hataMi);
        secenekEkle(d.secenekler);
        secimAlaniEkle(d.secim_alani);

        // Mod secilince faz agaci degisir; backend guncel halini gonderiyor
        if (d.fazlar) fazlariYukle(d.fazlar);
        if (d.mod !== undefined) aktifMod = d.mod;
        if (d.adim_no !== undefined) {
            aktifAdim = d.adim_no;
            aktifFaziAc();
        }
        fazlariCiz();

        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
    })
    .catch(e => { yaziyor.remove(); balonEkle("bot", "Bağlantı hatası: " + e, true); })
    .finally(() => { kilitle(false); kutuEl.focus(); });
}

gonderEl.onclick = () => gonder();
aksiyonlar.forEach(c => {
    c.onclick = () => gonder(c.dataset.mesaj, c.dataset.etiket);
});

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 96) + "px";
});


/* ==================== Karşılama ==================== */
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => {
        balonEkle("bot", d.metin);
        secenekEkle(d.secenekler);
        secimAlaniEkle(d.secim_alani);
        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
    })
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e, true));


/* ==================== Yeni oturum ==================== */
document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        aktifMod = null;
        acikFazlar = new Set();

        if (d.fazlar) fazlariYukle(d.fazlar);
        aktifFaziAc();
        fazlariCiz();

        kilitle(false);
        balonEkle("bot", d.metin);
        secenekEkle(d.secenekler);
        secimAlaniEkle(d.secim_alani);

        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
        sayfaAc("calisma");
    })
    .catch(e => balonEkle("bot", "Oturum sıfırlanamadı: " + e, true));
};




















:root {
  /* Akbank kirmizisi — logo yazisindan alindi */
  --kirmizi:      #D51115;
  --kirmizi-koyu: #A00D10;
  --kirmizi-canli:#F51513;
  --kirmizi-acik: #FDF2F2;

  --zemin:        #F4F5F7;
  --yuzey:        #FFFFFF;
  --yuzey-alt:    #FAFAFB;
  --sohbet-zemin: #6B0A0D;
  --kenar:        #C9CED6;
  --kenar-acik:   #EAEDF1;

  /* Metin: tek ton — siyah */
  --metin:        #000000;

  /* Bot balonu ve secim karti — koyu marka tonu */
  --bot-zemin:    #9E1418;

  /* Kullanici balonu */
  --user-zemin:   #FFFFFF;
  --user-metin:   #000000;
  --user-kenar:   #D8DCE3;

  /* Acilir listeler */
  --balon-zemin:  #FFFFFF;
  --balon-metin:  #000000;
  --balon-kenar:  #D8DCE3;

  /* Giris kapsulu ve aksiyon butonlari */
  --giris-zemin:  #FFFFFF;
  --giris-metin:  #000000;
  --gonder-zemin: #000000;
  --gonder-metin: #FFFFFF;
  --aksiyon-cerceve: #000000;

  /* Sohbet arka plan gorseli — JS dolduruyor */
  --sohbet-gorsel: none;
  --sohbet-perde:  rgba(255,255,255,.72);

  --yesil:        #0E9F5C;
  --sari:         #EAB308;
  --sari-koyu:    #000000;
  --sari-acik:    #FDF6D3;
  --golge:        rgba(0,0,0,.10);

  --panel-en:   clamp(340px, 27vw, 480px);
  --analiz-en:  clamp(320px, 24vw, 420px);
  --yazi:       11.4px;
  --avatar:     30px;
  --girinti:    40px;
  --ustbar-h:   108px;
}

/* -------- KOYU TEMA: siyah taban, beyaz metin -------- */
#kabuk.koyu {
  --kirmizi:      #FF4D4F;
  --kirmizi-koyu: #C21B1E;
  --kirmizi-canli:#FF6B5B;
  --kirmizi-acik: #2A1418;

  --zemin:        #000000;
  --yuzey:        #161616;
  --yuzey-alt:    #0B0B0B;
  --sohbet-zemin: #3D0508;
  --kenar:        #3A3A3A;
  --kenar-acik:   #242424;

  --metin:        #FFFFFF;
  --bot-zemin:    #5A1114;

  --user-zemin:   #000000;
  --user-metin:   #FFFFFF;
  --user-kenar:   #3A3A3A;

  --balon-zemin:  #161616;
  --balon-metin:  #FFFFFF;
  --balon-kenar:  #3A3A3A;

  --giris-zemin:  #000000;
  --giris-metin:  #FFFFFF;
  --gonder-zemin: #FFFFFF;
  --gonder-metin: #000000;
  --aksiyon-cerceve: #FFFFFF;

  --sohbet-perde: rgba(0,0,0,.78);

  --yesil:        #3DDC8A;
  --sari:         #FACC15;
  --sari-koyu:    #FFFFFF;
  --sari-acik:    #2A2410;
  --golge:        rgba(0,0,0,.6);
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

#kabuk {
  display: flex; flex-direction: column; height: 100vh;
  background: var(--zemin); color: var(--metin);
  font-family: Calibri, "Segoe UI", system-ui, -apple-system, sans-serif;
  font-size: var(--yazi);
  transition: background .2s, color .2s;
}

/* ==================== ÜST BAR ==================== */
#ustbar {
  display: flex; align-items: stretch;
  padding: 0 clamp(14px, 1.6vw, 26px);
  height: var(--ustbar-h);
  background: var(--yuzey); border-bottom: 1px solid var(--kenar); flex-shrink: 0;
  gap: clamp(14px, 1.6vw, 28px);
}
#ustbar-sol { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
#banner { height: 84px; width: auto; display: block; }

#baslik-blok { border-left: 1px solid var(--kenar); padding-left: 16px; line-height: 1.35; }
#urun-adi {
  font-weight: 700; font-size: 1.8em; letter-spacing: -.01em;
  white-space: nowrap; color: var(--kirmizi);
}
#urun-alt {
  font-size: 1.08em; font-weight: 700; color: var(--metin);
  margin-top: 4px; white-space: nowrap;
}

/* -------- Özet şerit -------- */
/* text-transform YOK — Turkce I/İ sorunu icin metinler Python'da buyuk yazılı */
#ozet-serit {
  flex: 1; min-width: 0; display: flex; align-items: center;
  border-left: 1px solid var(--kenar-acik); border-right: 1px solid var(--kenar-acik);
}
.ozet-kart {
  flex: 1; min-width: 0; padding: 0 clamp(10px, 1.2vw, 20px);
  border-right: 1px solid var(--kenar-acik);
}
.ozet-kart:last-child { border-right: none; }
.ozet-etiket {
  display: block; font-size: .95em; font-weight: 700; letter-spacing: .07em;
  color: var(--kirmizi); margin-bottom: 5px;
}
.ozet-deger {
  display: block; font-family: ui-monospace, Consolas, monospace;
  font-size: 1.3em; font-weight: 600; color: var(--metin);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.ozet-ust, .ozet-alt {
  display: block; font-size: 1em; color: var(--metin); margin-top: 4px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* -------- Sağ blok -------- */
#ustbar-sag {
  display: flex; flex-direction: column;
  align-items: stretch; justify-content: center; gap: 9px; flex-shrink: 0;
}
.ustbar-sag-satir { display: flex; align-items: center; justify-content: center; gap: 9px; }

#tema-btn, #sifirla-btn {
  display: flex; align-items: center; justify-content: center;
  width: 30px; height: 30px; padding: 0;
  border: 1px solid var(--kenar); background: var(--yuzey);
  border-radius: 7px; cursor: pointer; color: var(--metin); flex-shrink: 0;
}
#tema-btn:hover, #sifirla-btn:hover {
  border-color: var(--kirmizi); color: var(--kirmizi); background: var(--kirmizi-acik);
}

#durum-rozet {
  display: inline-flex; align-items: center; gap: 7px;
  font-size: 1em; color: var(--metin); white-space: nowrap;
}
.nokta-yesil {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--yesil); display: inline-block;
}

#sekmeler {
  display: flex; gap: 3px; padding: 3px;
  background: var(--zemin); border: 1px solid var(--kenar); border-radius: 9px;
}
.sekme {
  flex: 1; font-size: 1em; font-weight: 600; padding: 8px 22px;
  border: none; background: none; border-radius: 7px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
  transition: background .15s, color .15s;
}
.sekme:hover:not(.aktif) { background: var(--yuzey); }
.sekme.aktif {
  background: var(--kirmizi); color: #fff;
  box-shadow: 0 1px 3px rgba(213,17,21,.28);
}

/* ==================== SAYFA KABI ==================== */
.sayfa { flex: 1; min-height: 0; width: 100%; }
.sayfa.gizli { display: none; }
#sayfa-calisma { display: flex; background: var(--yuzey); }

/* ==================== SOL PANEL ==================== */
#panel {
  width: var(--panel-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-right: 1px solid var(--kenar);
  padding: 22px 20px 32px; overflow-y: auto;
}

.panel-blok { margin-bottom: 26px; }
.panel-blok:last-child { margin-bottom: 0; }
.panel-baslik {
  font-size: 1.02em; font-weight: 800; letter-spacing: .09em;
  color: var(--kirmizi); margin-bottom: 12px;
}
.panel-metin { margin: 0 0 12px; font-size: 1.02em; line-height: 1.75; color: var(--metin); }
.panel-metin:last-child { margin-bottom: 0; }

/* -------- Faz ağacı: yeşil tamam · sarı devam · nötr bekliyor -------- */
.faz { margin-bottom: 3px; }
.faz-bas {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 10px 9px; border-radius: 7px; cursor: pointer;
  color: var(--metin);
}
.faz-bas:hover { background: var(--kenar-acik); }
.faz.aktif > .faz-bas { background: var(--sari-acik); color: var(--sari-koyu); }
.faz.tamam > .faz-bas { color: var(--yesil); }

.faz-ok {
  flex-shrink: 0; width: 10px; margin-top: 2px;
  font-size: 1em; transition: transform .15s;
}
.faz.acik .faz-ok { transform: rotate(90deg); }

.faz-no {
  flex-shrink: 0; font-family: ui-monospace, Consolas, monospace;
  font-size: .88em; font-weight: 700; margin-top: 3px;
}
.faz-govde { min-width: 0; flex: 1; }
.faz-ad { font-size: 1.1em; font-weight: 700; line-height: 1.35; color: inherit; }
.faz-ozet {
  font-size: .95em; color: inherit;
  margin-top: 3px; line-height: 1.45; font-weight: 400;
}
.faz-durum {
  flex-shrink: 0; font-size: .9em; font-family: ui-monospace, Consolas, monospace;
  font-weight: 700; margin-top: 4px; cursor: help;
}

.faz-adimlar {
  list-style: none; margin: 2px 0 8px 14px; padding: 0 0 0 26px; display: none;
  border-left: 1px solid var(--kenar);
}
.faz.acik .faz-adimlar { display: block; }

.faz-adimlar li {
  display: flex; align-items: center; gap: 9px;
  padding: 6px 8px; border-radius: 6px;
  font-size: 1em; color: var(--metin); cursor: default;
}
.adim-isaret {
  flex-shrink: 0; width: 14px; height: 14px;
  border: 1.5px solid currentColor; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .6em; font-weight: 700;
}
.faz-adimlar li.tamam { color: var(--yesil); }
.faz-adimlar li.tamam .adim-isaret {
  background: var(--yesil); border-color: var(--yesil); color: #fff;
}
.faz-adimlar li.aktif { color: var(--sari-koyu); font-weight: 700; }
.faz-adimlar li.aktif .adim-isaret {
  background: var(--sari); border-color: var(--sari); color: #000;
  box-shadow: 0 0 0 3px var(--sari-acik);
}

/* ==================== ORTA: SOHBET ==================== */
/* Arka plan gorseli tema ile degisir. Perde + bulaniklik ile dokunun
   marka hissi korunur ama icerigin onune gecmez. */
#sohbet-alani {
  position: relative;
  flex: 1; display: flex; flex-direction: column; min-width: 0;
  background-color: var(--sohbet-zemin);
  background-image: var(--sohbet-gorsel);
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
#sohbet-alani::before {
  content: ""; position: absolute; inset: 0;
  background: var(--sohbet-perde);
  backdrop-filter: blur(3px);
  pointer-events: none;
}
/* Icerik perdenin ustunde kalsin */
#sohbet, #giris-bolge { position: relative; z-index: 1; }

#sohbet {
  flex: 1; overflow-y: auto;
  padding: 22px 24px 16px;
  background: transparent;
}

.satir {
  display: flex; align-items: flex-start; gap: 10px;
  margin: 0 0 18px; max-width: 100%;
}
.satir.kullanici { flex-direction: row-reverse; }

.avatar {
  width: var(--avatar); height: var(--avatar); min-width: var(--avatar);
  border-radius: 50%; background: var(--yuzey); object-fit: cover;
  border: 1px solid var(--kenar);
  box-shadow: 0 2px 6px rgba(0,0,0,.15);
}

.balon {
  padding: 15px 18px; border-radius: 14px;
  white-space: pre-wrap; word-break: break-word;
  max-width: 88%; max-height: 400px; overflow-y: auto;
}
/* Bot: koyu marka tonu, sol kenarda kirmizi serit */
.satir.bot .balon {
  background: var(--bot-zemin); color: #fff;
  border: none;
  border-left: 4px solid var(--kirmizi);
  border-top-left-radius: 4px;
  font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
  font-size: .95em; line-height: 1.7;
  box-shadow: 0 4px 16px rgba(0,0,0,.22);
}
.satir.bot .balon::-webkit-scrollbar { width: 6px; }
.satir.bot .balon::-webkit-scrollbar-thumb { background: rgba(255,255,255,.45); border-radius: 3px; }
.satir.bot .balon::-webkit-scrollbar-track { background: transparent; }

/* Kullanici: acik temada beyaz zemin/siyah yazi, koyu temada tersi */
.satir.kullanici .balon {
  background: var(--user-zemin); color: var(--user-metin);
  border: 1px solid var(--user-kenar);
  border-top-right-radius: 4px;
  font-size: 1em; line-height: 1.65;
  box-shadow: 0 3px 12px rgba(0,0,0,.18);
}

/* Hata: koyu marka tonundan ayrissin */
.satir.bot .balon.hata {
  background: #FFF4F4; color: #A00D10;
  border-left-color: #F51513;
}

/* -------- Seçenek kartları -------- */
/* Bot balonuyla ayni hizada; kullanici yazmak yerine tiklayarak secer. */
.secenek-kok {
  display: flex; flex-direction: column; gap: 9px;
  margin: 0 0 18px var(--girinti);
  max-width: 88%;
}

.secenek {
  display: flex; align-items: flex-start; gap: 13px;
  padding: 15px 17px;
  background: var(--yuzey); color: var(--metin);
  border: 2px solid var(--aksiyon-cerceve);
  border-radius: 12px;
  cursor: pointer; text-align: left;
  font-family: inherit; font-size: 1em;
  box-shadow: 0 3px 12px rgba(0,0,0,.15);
  transition: background .15s, border-color .15s, transform .1s;
}
.secenek:hover:not(:disabled) {
  background: var(--kirmizi-acik); border-color: var(--kirmizi);
}
.secenek:active:not(:disabled) { transform: scale(.99); }

.secenek:disabled { cursor: default; opacity: .4; }
.secenek.secili {
  background: var(--kirmizi); border-color: var(--kirmizi);
  color: #fff; opacity: 1;
}
.secenek.secili .secenek-rozet { background: #fff; color: var(--kirmizi); }
.secenek.secili .secenek-aciklama { color: #fff; opacity: .9; }

.secenek-rozet {
  flex-shrink: 0; width: 28px; height: 28px;
  background: var(--kirmizi); color: #fff;
  border-radius: 50%; font-weight: 700; font-size: 1em;
  display: flex; align-items: center; justify-content: center;
}

.secenek-govde { min-width: 0; flex: 1; }
.secenek-baslik { font-weight: 700; font-size: 1.05em; line-height: 1.35; }
.secenek-aciklama {
  font-size: .95em; color: var(--metin); opacity: .75;
  line-height: 1.55; margin-top: 5px;
}

/* -------- Seçim formu: dataset seçici -------- */
.secim-kart {
  max-width: 88%; margin: 0 0 18px var(--girinti);
  background: var(--bot-zemin); border: none;
  border-left: 4px solid var(--kirmizi);
  border-radius: 14px; border-top-left-radius: 4px;
  padding: 20px 22px 22px; box-shadow: 0 4px 16px rgba(0,0,0,.22);
  color: #fff;
}
.secim-kart.kilitli { opacity: .65; }

.secim-baslik { font-weight: 700; font-size: 1.15em; margin-bottom: 6px; }
.secim-aciklama { font-size: 1em; line-height: 1.65; margin-bottom: 16px; opacity: .9; }

.secim-govde { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }
.secim-govde .combo { flex: 1; min-width: 200px; }

.secim-satir { display: flex; gap: 10px; align-items: flex-end; margin-bottom: 12px; }
.secim-satir .combo { flex: 1; }

.combo { position: relative; }
.combo label {
  display: block; font-size: .95em; color: #fff;
  margin-bottom: 6px; font-weight: 600;
}
.combo-giris {
  width: 100%; padding: 10px 15px; border: 1px solid rgba(255,255,255,.35);
  border-radius: 999px;
  font-family: ui-monospace, Consolas, monospace; font-size: 1em;
  outline: none; background: #fff; color: #000;
}
.combo-giris::placeholder { color: #000; opacity: .45; }
.combo-giris:focus { border-color: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.3); }
.combo-giris:disabled { background: rgba(255,255,255,.6); }

.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 5px 0 0; padding: 5px; list-style: none;
  background: var(--balon-zemin); border: 1px solid var(--balon-kenar);
  border-radius: 12px; box-shadow: 0 8px 22px rgba(0,0,0,.3);
  max-height: 260px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 8px 13px; border-radius: 999px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .96em;
  color: var(--balon-metin);
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; font-family: inherit; opacity: .7; }
.combo-liste li.bos:hover { background: none; color: var(--balon-metin); }

/* + ve − yuvarlak dugmeler */
.secim-yuvarlak {
  flex-shrink: 0; width: 34px; height: 34px; padding: 0;
  border-radius: 50%; cursor: pointer;
  font-size: 1.4em; font-weight: 700; line-height: 1;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s, transform .1s;
}
.secim-yuvarlak:active:not(:disabled) { transform: scale(.92); }
.secim-yuvarlak:disabled { opacity: .4; cursor: not-allowed; }

.secim-yuvarlak.ekle { background: #fff; color: var(--bot-zemin); border: none; }
.secim-yuvarlak.ekle:hover:not(:disabled) { background: #FFE8E9; }

.secim-yuvarlak.sil {
  width: 22px; height: 22px; font-size: 1.2em;
  background: rgba(0,0,0,.3); color: #fff;
  border: 1px solid rgba(255,255,255,.35);
}
.secim-yuvarlak.sil:hover { background: rgba(0,0,0,.55); }

/* Secilenler listesi */
.secim-rozetler { display: flex; flex-direction: column; gap: 7px; margin-bottom: 14px; }
.secim-rozet {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  background: rgba(0,0,0,.28); border: 1px solid rgba(255,255,255,.22);
  border-radius: 999px; padding: 7px 8px 7px 16px;
  font-family: ui-monospace, Consolas, monospace; font-size: .96em;
}

.secim-onay {
  padding: 11px 28px; background: #fff; color: var(--bot-zemin);
  border: none; border-radius: 999px; font-size: 1.02em; font-weight: 700;
  cursor: pointer; white-space: nowrap;
}
.secim-onay:hover:not(:disabled) { background: #FFE8E9; }
.secim-onay:disabled {
  background: rgba(255,255,255,.28); color: rgba(255,255,255,.65);
  cursor: not-allowed;
}

/* -------- Yazıyor -------- */
.nokta {
  display: inline-block; width: 6px; height: 6px; margin-right: 4px;
  border-radius: 50%; background: #fff; animation: zipla 1.2s infinite;
}
.nokta:nth-child(2) { animation-delay: .2s; }
.nokta:nth-child(3) { animation-delay: .4s; }
@keyframes zipla {
  0%, 60%, 100% { opacity: .3; transform: translateY(0); }
  30%           { opacity: 1;  transform: translateY(-3px); }
}

/* -------- Aksiyon butonları -------- */
/* Tek renk vurgusu: birincil marka kirmizisi, digerleri notr.
   Ucu de esit genislikte, balon hizasinda baslar ve biter. */
#giris-bolge {
  border-top: none;
  background: transparent;
  padding: 12px 24px 22px; flex-shrink: 0;
}
#aksiyonlar {
  max-width: 88%; margin: 0 0 12px var(--girinti);
  display: flex; gap: 10px;
}

.aksiyon {
  flex: 1;
  font-size: 1.02em; font-weight: 600; padding: 11px 18px;
  border-radius: 999px; cursor: pointer; white-space: nowrap;
  text-align: center;
  transition: background .15s, border-color .15s, color .15s;
}
.aksiyon:disabled { opacity: .4; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff;
  border: 2px solid var(--aksiyon-cerceve);
  box-shadow: 0 2px 10px rgba(213,17,21,.28);
}
.aksiyon.onayla:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.aksiyon.degistir {
  background: var(--yuzey); color: var(--metin);
  border: 2px solid var(--aksiyon-cerceve);
}
.aksiyon.degistir:hover:not(:disabled) { background: var(--kenar-acik); }

.aksiyon.geri {
  background: var(--yuzey); color: var(--metin);
  border: 2px solid var(--aksiyon-cerceve);
  font-weight: 600;
}
.aksiyon.geri:hover:not(:disabled) { background: var(--kenar-acik); }

/* Yazı bloğu: butonlarla ayni hizada ve genislikte */
#giris {
  max-width: 88%; margin: 0 0 0 var(--girinti);
  display: flex; gap: 8px; align-items: center;
  background: var(--giris-zemin);
  border: 2px solid var(--aksiyon-cerceve);
  border-radius: 999px;
  padding: 8px 8px 8px 20px;
  box-shadow: 0 3px 12px rgba(0,0,0,.15);
}
#kutu {
  flex: 1; padding: 6px 0; border: none;
  background: transparent; color: var(--giris-metin);
  font-family: inherit; font-size: 1.02em; line-height: 1.55;
  resize: none; outline: none; max-height: 96px; overflow-y: auto;
}
#kutu::placeholder { color: var(--giris-metin); opacity: .5; }

#gonder {
  padding: 10px 26px; background: var(--gonder-zemin); color: var(--gonder-metin);
  border: none; border-radius: 999px;
  font-size: 1.02em; font-weight: 600; cursor: pointer; white-space: nowrap;
}
#gonder:hover:not(:disabled) { filter: brightness(1.25); }
#gonder:disabled { opacity: .4; cursor: not-allowed; }

/* ==================== SAĞ: ANALİZ PANELİ ==================== */
#analiz-panel {
  width: var(--analiz-en); flex-shrink: 0;
  background: var(--yuzey-alt); border-left: 1px solid var(--kenar);
  display: flex; flex-direction: column; overflow: hidden;
}

#analiz-ust {
  padding: 17px 19px 15px; border-bottom: 1px solid var(--kenar);
  background: var(--yuzey); flex-shrink: 0;
}
#analiz-baslik { font-weight: 800; font-size: 1.18em; color: var(--kirmizi); }

#analiz-sekmeler {
  display: flex; gap: 3px; padding: 10px 12px;
  border-bottom: 1px solid var(--kenar); background: var(--yuzey);
  overflow-x: auto; flex-shrink: 0;
}
#analiz-sekmeler::-webkit-scrollbar { height: 0; }
.analiz-sekme {
  font-size: .98em; font-weight: 600; padding: 7px 14px;
  border: none; background: none; border-radius: 999px;
  cursor: pointer; color: var(--metin); white-space: nowrap;
}
.analiz-sekme:hover { background: var(--kenar-acik); }
.analiz-sekme.aktif { background: var(--kirmizi); color: #fff; font-weight: 700; }

#analiz-govde { flex: 1; overflow-y: auto; padding: 16px 19px 26px; }

.iskele-kart {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 15px 17px; margin-bottom: 12px;
}
.iskele-baslik { font-size: 1.05em; font-weight: 700; margin-bottom: 11px; color: var(--metin); }
.iskele-satir {
  display: flex; justify-content: space-between; gap: 12px;
  font-size: 1em; padding: 7px 0; color: var(--metin);
}
.iskele-deger {
  font-family: ui-monospace, Consolas, monospace;
  color: var(--metin); background: var(--kenar-acik);
  padding: 1px 10px; border-radius: 999px;
}
.iskele-grafik {
  height: 86px; border-radius: 10px; margin-top: 4px;
  background: repeating-linear-gradient(
    -45deg, var(--kenar-acik), var(--kenar-acik) 6px,
    var(--yuzey) 6px, var(--yuzey) 12px);
  display: flex; align-items: center; justify-content: center;
  color: var(--metin); font-size: .95em;
}

/* ==================== SAYFA 2: ÖZET ==================== */
#sayfa-ozet { overflow-y: auto; background: var(--zemin); }
#ozet-govde { max-width: 1280px; margin: 0 auto; padding: 28px clamp(18px, 2.4vw, 44px) 56px; }
#ozet-baslik-blok { margin-bottom: 22px; }
#ozet-h1 { margin: 0; font-size: 1.9em; font-weight: 800; letter-spacing: -.01em; color: var(--kirmizi); }
#ozet-adim { font-size: 1.05em; color: var(--metin); margin-top: 7px; }

#ozet-kartlar {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 15px; align-items: start;
}
.ozet-blok {
  background: var(--yuzey); border: 1px solid var(--kenar); border-radius: 12px;
  padding: 17px 19px 15px; box-shadow: 0 1px 2px var(--golge);
}
.ozet-blok-baslik {
  font-size: .95em; font-weight: 800; letter-spacing: .08em;
  color: var(--kirmizi); margin-bottom: 12px;
  padding-bottom: 10px; border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir {
  display: flex; justify-content: space-between; gap: 14px;
  padding: 7px 0; font-size: 1.02em; align-items: baseline;
  border-bottom: 1px solid var(--kenar-acik);
}
.ozet-satir:last-child { border-bottom: none; }
.ozet-satir-etiket { color: var(--metin); flex-shrink: 0; }
.ozet-satir-deger {
  font-family: ui-monospace, Consolas, monospace; color: var(--metin);
  text-align: right; font-weight: 600; word-break: break-word; min-width: 0;
}
#ozet-bos {
  background: var(--yuzey); border: 1px dashed var(--kenar); border-radius: 12px;
  padding: 44px; text-align: center; color: var(--metin);
  font-size: 1.08em; grid-column: 1 / -1;
}

/* ==================== KAYDIRMA ÇUBUKLARI ==================== */
/* Tum kaydirilabilir alanlarda Akbank kirmizisi; koyu temada
   --kirmizi otomatik acilir tona doner. */
#panel::-webkit-scrollbar,
#sohbet::-webkit-scrollbar,
#analiz-govde::-webkit-scrollbar,
#sayfa-ozet::-webkit-scrollbar,
#kutu::-webkit-scrollbar,
.combo-liste::-webkit-scrollbar {
  width: 7px;
}
#panel::-webkit-scrollbar-thumb,
#sohbet::-webkit-scrollbar-thumb,
#analiz-govde::-webkit-scrollbar-thumb,
#sayfa-ozet::-webkit-scrollbar-thumb,
#kutu::-webkit-scrollbar-thumb,
.combo-liste::-webkit-scrollbar-thumb {
  background: var(--kirmizi); border-radius: 4px;
}
#panel::-webkit-scrollbar-thumb:hover,
#sohbet::-webkit-scrollbar-thumb:hover,
#analiz-govde::-webkit-scrollbar-thumb:hover,
#sayfa-ozet::-webkit-scrollbar-thumb:hover,
#kutu::-webkit-scrollbar-thumb:hover,
.combo-liste::-webkit-scrollbar-thumb:hover {
  background: var(--kirmizi-koyu);
}
#panel::-webkit-scrollbar-track,
#sohbet::-webkit-scrollbar-track,
#analiz-govde::-webkit-scrollbar-track,
#sayfa-ozet::-webkit-scrollbar-track,
#kutu::-webkit-scrollbar-track,
.combo-liste::-webkit-scrollbar-track {
  background: transparent;
}

/* Firefox */
#panel, #sohbet, #analiz-govde, #sayfa-ozet, #kutu, .combo-liste {
  scrollbar-width: thin;
  scrollbar-color: var(--kirmizi) transparent;
}

/* -------- Dar ekran -------- */
@media (max-width: 1180px) { #analiz-panel { display: none; } }
@media (max-width: 1280px) { #baslik-blok { display: none; } }
@media (max-width: 1080px) { #panel { display: none; } #ozet-serit { display: none; } }
