    adim = ADIMLAR[anahtar]

    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adımdayız."
        durum["i"] -= 1
        return ("Tamam, \"%s\" adımına dönüyorum.\n\n"
                % ADIMLAR[ADIM_SIRASI[durum["i"]]]["baslik"]) + _adima_gir(durum)

    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            return uyari
        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    sonuc = niyet_kural.coz(mesaj)

    if sonuc["aksiyon"] == "onay":
        if anahtar in SECIMLI:
            cikti = adim["uygula"](durum, _secim_ayikla(mesaj, _adet(durum, anahtar)))
        else:
            cikti = adim["uygula"](durum)
        if durum["i"] >= len(ADIM_SIRASI) - 1:
            return cikti + "\n\nÇalışma tamamlandı. Yeni bir tur için üstteki " \
                           "\"Yeni oturum\" düğmesini kullanabilirsiniz."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        return ("Anladım, uygulamadım. Neyi değiştirmemi istersiniz? "
                "İstediğinizi yazabilir ya da \"geri\" diyebilirsiniz.")

    return ("Şu an \"%s\" adımındayım. \"onay\", \"red\" ya da \"geri\" "
            "diyebilirsiniz." % adim["baslik"])
