# =============================================================================
# FEATURE_DISCOVERY_AGENT / asistan_uygula
# -----------------------------------------------------------------------------
# Asistanlarin urettigi islem listesini kullaniciya SUNAR ve onay gelince
# UYGULAR. Tum adim asistanlari icin ortaktir.
#
# IKI MOD (state["bekleyen_islemler"] durumuna gore):
#   SUNUM : asistan blogundan gelinir. Cevabi ve islem listesini gosterir,
#           listeyi state'e koyar, onay bekler. HICBIR SEY YAZMAZ.
#   UYGULA: durum_belirle'den gelinir (kullanici onay verdi). Islemleri
#           sirayla uygular ve sonucu raporlar.
#
# HER ISLEM TEYITLIDIR. LLM'in tek basina yazma yapmasi mumkun degildir;
# boylece "kaydettim" deyip hicbir sey yapmamasi da imkansizdir.
#
# Kaynak sozluk (DEGISKENLER) DEGISTIRILMEZ.
# =============================================================================

import json

import pandas as pd

import dataiku
from dataiku.llm.python.blocks_graph import NextBlock


HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"
GUNCEL_SOZLUK_DATASET = "DEGISKENLER_GUNCEL"

AD_KOLONU = "kolon"
ACIKLAMA_KOLONU = "aciklama"

BLOK_SOZLUK_CALIS = "sozluk_calis"

# Sunumda gosterilecek azami islem; fazlasi sohbeti bogar.
AZAMI_SUNULAN_ISLEM = 20


class Tip:
    TANIMLA = "tanimla"
    CIKAR = "cikar"
    GERI_AL = "geri_al"
    SOZLUK_DEGISTIR = "sozluk_degistir"


class Sema:
    SOZLUK = "sozluk"
    KOLONLAR = "kolonlar"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"
    HARIC_KOLONLAR = "haric_kolonlar"


class S:
    ASISTAN_CIKTI = "asistan_cikti"
    BEKLEYEN_ISLEMLER = "bekleyen_islemler"
    BEKLENEN = "beklenen"
    SOZLUK = "sozluk"
    SOZLUK_VAR = "sozluk_var"


class Beklenen:
    ISLEM_ONAYI = "islem_onayi"
    ADIM_ONAYI = "adim_onayi"


def _logla(mesaj):
    print("[asistan_uygula] {}".format(mesaj))


def _folder():
    return dataiku.Folder(HAFIZA_FOLDER)


def _json_oku(dosya_yolu, varsayilan):
    try:
        folder = _folder()
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _json_yaz(dosya_yolu, veri):
    try:
        icerik = json.dumps(veri, ensure_ascii=False, indent=2)
        _folder().upload_data(dosya_yolu, icerik.encode("utf-8"))
        return True
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(dosya_yolu, hata))
        return False


def _sayi(deger):
    return "{:,}".format(int(deger or 0)).replace(",", ".")


# -----------------------------------------------------------------------------
# Asistan ciktisini cozme
# -----------------------------------------------------------------------------

def _ham_ciktiyi_al():
    """Asistan ciktisini iki kaynaktan dener. Doner: (ham, kaynak)"""
    ham = state.get(S.ASISTAN_CIKTI)
    if ham:
        return ham, "state"
    try:
        if last_output:
            return last_output, "last_output"
    except NameError:
        pass
    return None, "yok"


def _ciktiyi_coz(ham):
    """Asistan JSON'unu (cevap, islemler) ikilisine cevirir."""
    veri = ham
    if isinstance(ham, str):
        metin = ham.strip()
        if metin.startswith("```"):
            metin = metin.strip("`").strip()
            if metin.lower().startswith("json"):
                metin = metin[4:].strip()
        bas = metin.find("{")
        son = metin.rfind("}")
        if bas != -1 and son > bas:
            metin = metin[bas:son + 1]
        try:
            veri = json.loads(metin)
        except (ValueError, TypeError):
            _logla("asistan JSON'u cozulemedi: {!r}".format(str(ham)[:300]))
            return "", []

    if not isinstance(veri, dict):
        return "", []

    cevap = str(veri.get("cevap") or "").strip()
    ham_islemler = veri.get("islemler")
    if not isinstance(ham_islemler, list):
        return cevap, []

    temiz = []
    for kayit in ham_islemler:
        if not isinstance(kayit, dict):
            continue
        tip = str(kayit.get("tip") or "").strip().lower()
        if tip not in (Tip.TANIMLA, Tip.CIKAR, Tip.GERI_AL,
                       Tip.SOZLUK_DEGISTIR):
            _logla("taninmayan islem tipi atlandi: {!r}".format(tip))
            continue
        temiz.append({
            "tip": tip,
            "kolon": str(kayit.get("kolon") or "").strip(),
            "aciklama": str(kayit.get("aciklama") or "").strip(),
            "dataset": str(kayit.get("dataset") or "").strip(),
        })
    return cevap, temiz


def _islemleri_dogrula(islemler):
    """Eksik alanli veya bilinmeyen kolonlu islemleri ayiklar.

    Doner: (gecerli_islemler, reddedilen_aciklamalari)
    """
    sema = _json_oku(SEMA_DOSYASI, {})
    kolonlar = sema.get(Sema.KOLONLAR) if isinstance(sema, dict) else []
    kolon_kumesi = set(kolonlar) if isinstance(kolonlar, list) else set()
    kucuk_harita = {k.lower(): k for k in kolon_kumesi}

    gecerli = []
    reddedilen = []

    for islem in islemler:
        tip = islem["tip"]

        if tip == Tip.SOZLUK_DEGISTIR:
            if not islem["dataset"]:
                reddedilen.append("sözlük değiştirme isteğinde dataset adı yok")
                continue
            gecerli.append(islem)
            continue

        kolon = islem["kolon"]
        if not kolon:
            reddedilen.append("{} işleminde kolon adı yok".format(tip))
            continue

        gercek = kolon if kolon in kolon_kumesi else kucuk_harita.get(
            kolon.lower())
        if gercek is None:
            reddedilen.append("`{}` tabloda bulunmuyor".format(kolon))
            continue
        islem["kolon"] = gercek

        if tip == Tip.TANIMLA and not islem["aciklama"]:
            reddedilen.append("`{}` için açıklama metni yok".format(gercek))
            continue

        gecerli.append(islem)

    return gecerli, reddedilen


# -----------------------------------------------------------------------------
# Sunum modu
# -----------------------------------------------------------------------------

def _islem_satiri(islem):
    tip = islem["tip"]
    if tip == Tip.TANIMLA:
        return "**{}** açıklaması: {}".format(islem["kolon"], islem["aciklama"])
    if tip == Tip.CIKAR:
        return "**{}** süreç dışı bırakılacak".format(islem["kolon"])
    if tip == Tip.GERI_AL:
        return "**{}** sürece geri alınacak".format(islem["kolon"])
    if tip == Tip.SOZLUK_DEGISTIR:
        return "Sözlük **{}** olarak değişecek".format(islem["dataset"])
    return str(islem)


def _sunum_mesaji(cevap, islemler, reddedilen):
    parcalar = []
    if cevap:
        parcalar.append(cevap)

    if reddedilen:
        parcalar.append("")
        parcalar.append("_Uygulanamayan istekler: {}._".format(
            "; ".join(reddedilen)))

    if not islemler:
        return "\n".join(parcalar) if parcalar else ""

    parcalar.append("")
    parcalar.append("**Yapılacak değişiklikler**")
    for islem in islemler[:AZAMI_SUNULAN_ISLEM]:
        parcalar.append("- {}".format(_islem_satiri(islem)))

    kalan = len(islemler) - AZAMI_SUNULAN_ISLEM
    if kalan > 0:
        parcalar.append("- _ve {} değişiklik daha_".format(kalan))

    parcalar.append("")
    parcalar.append("Onaylarsanız uygularım. Bir kısmını değiştirmek "
                    "isterseniz yazın; istemiyorsanız iptal edelim.")
    return "\n".join(parcalar)


# -----------------------------------------------------------------------------
# Uygulama modu
# -----------------------------------------------------------------------------

def _dataset_hazirla(ad):
    """Dataset projede yoksa managed dataset olarak olusturur."""
    try:
        proje = dataiku.api_client().get_default_project()
        mevcut = {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        return True

    if ad in mevcut:
        return True

    _logla("{} bulunamadi, olusturuluyor".format(ad))
    try:
        olusturucu = proje.new_managed_dataset(ad)
        olusturucu.with_store_into("filesystem_managed")
        olusturucu.create()
        return True
    except Exception as hata:
        _logla("{} olusturulamadi: {}".format(ad, hata))
        return False


def _semayi_guncelle(yeni_tanimlar, cikarilanlar, geri_alinanlar):
    """Tanimlari ve haric listesini sema.json'a isler."""
    sema = _json_oku(SEMA_DOSYASI, {})
    if not isinstance(sema, dict) or not sema:
        _logla("sema.json bos veya okunamadi")
        return False

    sozluk = sema.get(Sema.SOZLUK)
    if not isinstance(sozluk, dict):
        sozluk = {}
    sozluk.update(yeni_tanimlar)
    sema[Sema.SOZLUK] = sozluk

    haric = sema.get(Sema.HARIC_KOLONLAR)
    haric = haric if isinstance(haric, list) else []
    for kolon in cikarilanlar:
        if kolon not in haric:
            haric.append(kolon)
    haric = [k for k in haric if k not in geri_alinanlar]
    sema[Sema.HARIC_KOLONLAR] = haric

    # Eksik listesi: tanimlananlar ve cikarilanlar duser, geri alinan
    # ve hala aciklamasi olmayanlar geri girer.
    eksikler = sema.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    eksikler = eksikler if isinstance(eksikler, list) else []
    eksikler = [k for k in eksikler
                if k not in yeni_tanimlar and k not in cikarilanlar]
    for kolon in geri_alinanlar:
        if not str(sozluk.get(kolon) or "").strip() and kolon not in eksikler:
            eksikler.append(kolon)
    sema[Sema.TABLODA_VAR_SOZLUKTE_YOK] = sorted(eksikler)

    return _json_yaz(SEMA_DOSYASI, sema)


def _guncel_sozlugu_yaz(ek_sozluk):
    """Kaynak sozluk + eklenenleri, haric kolonlari duserek yazar."""
    if not _dataset_hazirla(GUNCEL_SOZLUK_DATASET):
        return False, 0

    sema = _json_oku(SEMA_DOSYASI, {})
    sozluk = sema.get(Sema.SOZLUK) if isinstance(sema, dict) else {}
    sozluk = sozluk if isinstance(sozluk, dict) else {}
    haric = sema.get(Sema.HARIC_KOLONLAR) if isinstance(sema, dict) else []
    haric = set(haric) if isinstance(haric, list) else set()

    birlesik = dict(sozluk)
    birlesik.update(ek_sozluk)
    adlar = sorted(k for k in birlesik if k not in haric)

    df = pd.DataFrame({
        AD_KOLONU: adlar,
        ACIKLAMA_KOLONU: [birlesik[ad] for ad in adlar],
        "kaynak": ["eklenen" if ad in ek_sozluk else "sozluk" for ad in adlar],
    })

    try:
        dataiku.Dataset(GUNCEL_SOZLUK_DATASET).write_with_schema(df)
        _logla("{} yazildi: {} satir".format(GUNCEL_SOZLUK_DATASET, len(df)))
        return True, len(df)
    except Exception as hata:
        _logla("{} yazilamadi: {}".format(GUNCEL_SOZLUK_DATASET, hata))
        return False, len(df)


def _uygula(islemler):
    """Islemleri sirayla uygular. Doner: (mesaj, sozluk_yeniden_okunsun_mu)"""
    yeni_tanimlar = {}
    cikarilanlar = []
    geri_alinanlar = []
    yeni_sozluk_adi = None

    for islem in islemler:
        tip = islem["tip"]
        if tip == Tip.TANIMLA:
            yeni_tanimlar[islem["kolon"]] = islem["aciklama"]
        elif tip == Tip.CIKAR:
            cikarilanlar.append(islem["kolon"])
        elif tip == Tip.GERI_AL:
            geri_alinanlar.append(islem["kolon"])
        elif tip == Tip.SOZLUK_DEGISTIR:
            yeni_sozluk_adi = islem["dataset"]

    # Sozluk degisimi tum sozlugu yeniden uretir; digerlerini beklemeye gerek yok.
    if yeni_sozluk_adi:
        state[S.SOZLUK] = yeni_sozluk_adi
        state[S.SOZLUK_VAR] = True
        _logla("sozluk degistirildi: {}".format(yeni_sozluk_adi))
        return ("Sözlük **{}** olarak değiştirildi; veri yeniden "
                "okunuyor.".format(yeni_sozluk_adi)), True

    ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
    ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}
    ek_sozluk.update(yeni_tanimlar)
    for kolon in cikarilanlar:
        ek_sozluk.pop(kolon, None)

    ek_yazildi = _json_yaz(EK_SOZLUK_DOSYASI, ek_sozluk)
    sema_yazildi = _semayi_guncelle(yeni_tanimlar, cikarilanlar, geri_alinanlar)
    ds_yazildi, toplam = _guncel_sozlugu_yaz(ek_sozluk)

    parcalar = ["**Değişiklikler uygulandı**", ""]
    if yeni_tanimlar:
        parcalar.append("Açıklaması kaydedilen: {}".format(
            ", ".join("**{}**".format(k) for k in sorted(yeni_tanimlar))))
    if cikarilanlar:
        parcalar.append("Süreç dışı bırakılan: {}".format(
            ", ".join("**{}**".format(k) for k in sorted(cikarilanlar))))
    if geri_alinanlar:
        parcalar.append("Sürece geri alınan: {}".format(
            ", ".join("**{}**".format(k) for k in sorted(geri_alinanlar))))
    parcalar.append("")

    basarisizlar = []
    if not ek_yazildi:
        basarisizlar.append("kullanıcı tanımları dosyası")
    if not sema_yazildi:
        basarisizlar.append("oturum kaydı (sema.json)")
    if not ds_yazildi:
        basarisizlar.append(GUNCEL_SOZLUK_DATASET)

    if basarisizlar:
        parcalar.append("Şuralara yazılamadı: {}. Ayrıntı agent log'unda.".format(
            ", ".join(basarisizlar)))
        return "\n".join(parcalar), False

    parcalar.append("**{}** artık {} satır. Kaynak sözlük değiştirilmedi.".format(
        GUNCEL_SOZLUK_DATASET, _sayi(toplam)))
    parcalar.append("")
    parcalar.append("Başka bir değişiklik yoksa sözlük sıkıştırmaya "
                    "geçebiliriz.")
    return "\n".join(parcalar), False


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        bekleyen = state.get(S.BEKLEYEN_ISLEMLER) or []

        # --- UYGULAMA MODU ---------------------------------------------------
        if bekleyen:
            _logla("{} islem uygulaniyor".format(len(bekleyen)))
            state[S.BEKLEYEN_ISLEMLER] = []
            mesaj, yeniden_oku = _uygula(bekleyen)
            state[S.BEKLENEN] = Beklenen.ADIM_ONAYI
            yield "\n\n" + mesaj
            if yeniden_oku:
                yield NextBlock(BLOK_SOZLUK_CALIS)
            return

        # --- SUNUM MODU ------------------------------------------------------
        ham, kaynak = _ham_ciktiyi_al()
        _logla("asistan ciktisi kaynagi: {}".format(kaynak))
        cevap, islemler = _ciktiyi_coz(ham)

        if not cevap and not islemler:
            _logla("asistan ciktisi bos: {!r}".format(str(ham)[:300]))
            state[S.BEKLENEN] = Beklenen.ADIM_ONAYI
            yield ("\n\nİsteğinizi işleyemedim. Ne yapmak istediğinizi biraz "
                   "daha açık yazar mısınız?")
            return

        islemler, reddedilen = _islemleri_dogrula(islemler)

        if islemler:
            state[S.BEKLEYEN_ISLEMLER] = islemler
            state[S.BEKLENEN] = Beklenen.ISLEM_ONAYI
            _logla("{} islem onaya sunuldu".format(len(islemler)))
        else:
            state[S.BEKLEYEN_ISLEMLER] = []
            state[S.BEKLENEN] = Beklenen.ADIM_ONAYI

        mesaj = _sunum_mesaji(cevap, islemler, reddedilen)
        if not mesaj.strip():
            mesaj = "İsteğinizi aldım ama uygulanacak bir değişiklik çıkmadı."

        yield "\n\n" + mesaj

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        state[S.BEKLEYEN_ISLEMLER] = []
        state[S.BEKLENEN] = Beklenen.ADIM_ONAYI
        yield ("\n\nİsteği işlerken beklenmeyen bir hata oluştu; hiçbir "
               "değişiklik uygulanmadı. Ayrıntı agent log'unda.")
