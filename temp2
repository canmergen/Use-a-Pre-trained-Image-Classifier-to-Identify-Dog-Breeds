def mod_girdi(durum, mesaj):
    m = MOD_KALIP.search(mesaj or "")
    if not m:
        # Secenekler ayri alanda doner; JS bunlari buton olarak basar.
        durum["_secenekler"] = MOD_SECENEKLERI
        return False, "Nereden başlayalım?"

    secim = m.group(2).upper()
    durum["mod"] = {"1": "A", "2": "B", "3": "C"}.get(secim, secim)
    durum["_secenekler"] = []
    return True, None








