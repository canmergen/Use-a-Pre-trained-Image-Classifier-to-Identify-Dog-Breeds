def script_olustur(kaynak_dataset, hedef_dataset, doldurma, bloklar):
    """bloklar: [(baslik, [(ad, kod_satiri, gerekce), ...]), ...]"""
    p = [BASLIK, "",
         'df = dataiku.Dataset("%s").get_dataframe()' % kaynak_dataset, ""]

    if doldurma == "medyan":
        p += ["# --- Eksik deger doldurma (baz veri setinde uygulandi) ---",
              "for _k in df.select_dtypes(include=[np.number]).columns:",
              "    df[_k] = df[_k].fillna(df[_k].median())", ""]

    for baslik, satirlar in bloklar:
        if not satirlar:
            continue
        p += ["# " + "=" * 68, "# %s" % baslik, "# " + "=" * 68]
        for i, (ad, kod, gerekce) in enumerate(satirlar, 1):
            if gerekce:
                p.append("# %02d. %s" % (i, gerekce))
            p.append(kod)
        p.append("")

    p += ['dataiku.Dataset("%s").write_with_schema(df)' % hedef_dataset,
          'print("Tamamlandi: %d kolon")'
          % sum(len(s) for _, s in bloklar), ""]
    return "\n".join(p)














# -*- coding: utf-8 -*-
"""fe_agent/sfa.py — Single Factor Analysis.

Her degisken icin tek basina hedefle iliskisini olcer:
    TYPE, NULL_COUNT, NULL_RATIO, IMPUTATION_METHOD, IMPUTATION_VALUE,
    ENCODING, IV, C_VALUE, PSI, SFA_RESULT

SFA bir ELEME kurali DEGILDIR: FAIL alan bir degisken multivariate modelde
(SHAP vb.) anlamli olabilir. Burada sadece tek degiskenli gucu ve
aciklanabilirligi raporlanir. Gercek eleme yalnizca teknik kusurlar icin
yapilir (asiri null, sabit, kimlik benzeri, sizinti).
"""

import numpy as np
import pandas as pd

IV_ESIK = 0.05
C_ESIK = 0.55
PSI_ESIK = 0.10

BIN_SAYISI = 10
KATEGORIK_MAX = 50        # bundan cok tekil degeri olan kategorik atlanir
MIN_SATIR = 100


# ===========================================================================
# TEMEL METRIKLER
# ===========================================================================
def _c_value(s, y):
    """Tek degisken AUC. Mann-Whitney rank formu — dongusuz.
    Yon onemli degil: 0.5 altinda kalirsa 1'e tamamlaniyor."""
    m = s.notna() & y.notna()
    if int(m.sum()) < MIN_SATIR:
        return None
    x, t = s[m], y[m]
    n1 = float((t > 0).sum())
    n0 = float((t <= 0).sum())
    if n1 == 0 or n0 == 0:
        return None
    r = x.rank()
    auc = (float(r[t > 0].sum()) - n1 * (n1 + 1) / 2.0) / (n1 * n0)
    return max(auc, 1.0 - auc)


def _iv_gruplu(gruplar, y):
    """gruplar: her satira karsilik gelen bin/kategori etiketi (Series)."""
    df = pd.DataFrame({"g": gruplar, "y": y}).dropna()
    if len(df) < MIN_SATIR:
        return None
    toplam_kotu = float((df["y"] > 0).sum())
    toplam_iyi = float((df["y"] <= 0).sum())
    if toplam_kotu == 0 or toplam_iyi == 0:
        return None

    iv = 0.0
    for _, alt in df.groupby("g", observed=False):
        kotu = float((alt["y"] > 0).sum())
        iyi = float((alt["y"] <= 0).sum())
        # Sifir bolme icin duzeltme (Laplace benzeri)
        p_kotu = (kotu if kotu else 0.5) / toplam_kotu
        p_iyi = (iyi if iyi else 0.5) / toplam_iyi
        iv += (p_kotu - p_iyi) * np.log(p_kotu / p_iyi)
    return float(iv)


def _binle(s, bin_sayisi=BIN_SAYISI):
    """Sayisal kolonu quantile bin'lere ayirir; tekrarli sinirlari toplar."""
    try:
        return pd.qcut(s, bin_sayisi, duplicates="drop", labels=False)
    except Exception:
        return None


def _psi(dev, oot, kategorik=False):
    """Population Stability Index. dev = gelistirme, oot = out-of-time."""
    if dev is None or oot is None or len(dev) < MIN_SATIR or len(oot) < MIN_SATIR:
        return None

    if kategorik:
        d = dev.astype(str).value_counts(normalize=True)
        o = oot.astype(str).value_counts(normalize=True)
        etiketler = set(d.index) | set(o.index)
        beklenen = {k: float(d.get(k, 0.0)) for k in etiketler}
        gerceklesen = {k: float(o.get(k, 0.0)) for k in etiketler}
    else:
        try:
            sinirlar = np.unique(np.nanpercentile(
                dev.dropna(), np.linspace(0, 100, BIN_SAYISI + 1)))
        except Exception:
            return None
        if len(sinirlar) < 3:
            return None
        sinirlar[0], sinirlar[-1] = -np.inf, np.inf
        d = pd.cut(dev, sinirlar).value_counts(normalize=True, sort=False)
        o = pd.cut(oot, sinirlar).value_counts(normalize=True, sort=False)
        etiketler = d.index
        beklenen = {k: float(d.get(k, 0.0)) for k in etiketler}
        gerceklesen = {k: float(o.get(k, 0.0)) for k in etiketler}

    psi = 0.0
    for k in etiketler:
        e = max(beklenen[k], 0.0001)
        g = max(gerceklesen[k], 0.0001)
        psi += (g - e) * np.log(g / e)
    return float(psi)


# ===========================================================================
# ANA FONKSIYON
# ===========================================================================
def calistir(df, target, haric=(), oot_maske=None, null_esik=0.50,
             sizinti_esik=0.95):
    """Doner: (sfa_dataframe, teshis_sozlugu)

    oot_maske: PSI icin out-of-time satirlarini isaretleyen boolean Series.
               None ise PSI hesaplanmaz.
    """
    y = pd.to_numeric(df[target], errors="coerce")
    haric = set(haric) | {target}
    satir = float(len(df))

    dev_maske = None if oot_maske is None else ~oot_maske

    kayitlar = []
    cok_bos, sabit, kimlik_gibi, sizinti = [], [], [], []

    for kol in df.columns:
        if kol in haric:
            continue
        s = df[kol]
        null_adet = int(s.isna().sum())
        null_oran = null_adet / max(satir, 1.0)

        # --- teknik kusur kontrolleri (bunlar GERCEK eleme sebebi) ---
        if null_oran > null_esik:
            cok_bos.append(kol)
            continue
        tekil = int(s.nunique(dropna=True))
        if tekil <= 1:
            sabit.append(kol)
            continue
        if tekil > 0.95 * satir and tekil > MIN_SATIR:
            kimlik_gibi.append(kol)
            continue

        sayisal = pd.api.types.is_numeric_dtype(s)

        if sayisal:
            sn = pd.to_numeric(s, errors="coerce")
            med = sn.median()
            imp_yontem = "medyan" if null_adet else "-"
            imp_deger = None if pd.isna(med) else round(float(med), 4)
            dolu = sn.fillna(med) if null_adet else sn

            gruplar = _binle(dolu)
            iv = _iv_gruplu(gruplar, y) if gruplar is not None else None
            c = _c_value(dolu, y)
            psi = (None if dev_maske is None
                   else _psi(dolu[dev_maske], dolu[oot_maske]))
            tip, enc = "numeric", "binning (%d)" % BIN_SAYISI
        else:
            if tekil > KATEGORIK_MAX:
                kimlik_gibi.append(kol)
                continue
            sk = s.astype(str).where(s.notna(), "MISSING")
            imp_yontem = "MISSING kategorisi" if null_adet else "-"
            imp_deger = "MISSING" if null_adet else None

            iv = _iv_gruplu(sk, y)
            # Kategorik icin C-value: kategori bazli kotu oranini skor kabul et
            oran = sk.map(pd.DataFrame({"k": sk, "y": y})
                          .groupby("k")["y"].mean())
            c = _c_value(pd.to_numeric(oran, errors="coerce"), y)
            psi = (None if dev_maske is None
                   else _psi(sk[dev_maske], sk[oot_maske], kategorik=True))
            tip, enc = "categorical", "WoE / hedef oranı"

        if c is not None and c > sizinti_esik:
            sizinti.append(kol)

        gecti = (iv is not None and iv > IV_ESIK and
                 c is not None and c > C_ESIK and
                 (psi is None or psi < PSI_ESIK))

        kayitlar.append({
            "FEATURE": kol,
            "TYPE": tip,
            "NULL_COUNT": null_adet,
            "NULL_RATIO": round(null_oran, 4),
            "IMPUTATION_METHOD": imp_yontem,
            "IMPUTATION_VALUE": imp_deger,
            "ENCODING": enc,
            "IV": None if iv is None else round(iv, 4),
            "C_VALUE": None if c is None else round(c, 4),
            "PSI": None if psi is None else round(psi, 4),
            "SFA_RESULT": "PASS" if gecti else "FAIL",
        })

    tablo = pd.DataFrame(kayitlar)
    if len(tablo):
        tablo = tablo.sort_values("IV", ascending=False, na_position="last")
        tablo = tablo.reset_index(drop=True)

    teshis = {
        "cok_bos": cok_bos, "sabit": sabit,
        "kimlik_gibi": kimlik_gibi, "sizinti": sizinti,
        "psi_var": oot_maske is not None,
    }
    return tablo, teshis





















