function analizCiz(tab) {
    const t = ANALIZ_TASLAK[tab];
    analizGovde.innerHTML = "";
    if (!t) return;

    const not = document.createElement("div");
    not.className = "iskele-not";
    not.textContent = t.not;
    analizGovde.appendChild(not);

    t.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "iskele-kart";

        if (k.grafik) {
            const g = document.createElement("div");
            g.className = "iskele-grafik";
            g.textContent = k.grafik;
            kart.appendChild(g);
        } else {
            const b = document.createElement("div");
            b.className = "iskele-baslik";
            b.textContent = k.baslik;
            kart.appendChild(b);

            (k.satirlar || []).forEach(s => {
                const satir = document.createElement("div");
                satir.className = "iskele-satir";
                const e = document.createElement("span");
                e.textContent = s;
                satir.appendChild(e);
                const v = document.createElement("span");
                v.className = "iskele-deger";
                v.textContent = "—";
                satir.appendChild(v);
                kart.appendChild(satir);
            });
        }
        analizGovde.appendChild(kart);
    });
}

analizSekme.forEach(s => {
    s.onclick = () => {
        analizSekme.forEach(x => x.classList.toggle("aktif", x === s));
        analizCiz(s.dataset.tab);
    };
});
analizCiz("ozet");

document.getElementById("analiz-kapat").onclick = () => {
    analizPanel.classList.add("kapali");
};


/* ==================== Balon kurucu ==================== */
function balonYap(rol, metin, hataMi) {
    const satir = document.createElement("div");
    satir.className = "satir " + rol;

    const av = document.createElement("img");
    av.className = "avatar";
    av.src = (rol === "bot") ? GORSEL.bot : GORSEL.user;
    av.alt = (rol === "bot") ? "Asistan" : "Kullanıcı";
    av.onerror = () => { av.style.visibility = "hidden"; };
    satir.appendChild(av);

    const balon = document.createElement("div");
    balon.className = "balon" + (hataMi ? " hata" : "");
    balon.textContent = metin;      // textContent: metin HTML olarak yorumlanmaz
    satir.appendChild(balon);
    return satir;
}

function balonEkle(rol, metin, hataMi) {
    const satir = balonYap(rol, metin, hataMi);
    sohbetEl.appendChild(satir);
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}

function yaziyorEkle() {
    const satir = balonEkle("bot", "");
    const balon = satir.querySelector(".balon");
    for (let i = 0; i < 3; i++) {
        const n = document.createElement("span");
        n.className = "nokta";
        balon.appendChild(n);
    }
    sohbetEl.scrollTop = sohbetEl.scrollHeight;
    return satir;
}


/* ==================== Veri seçici ==================== */
/* Buton durumu DAIMA kutularin canli degerinden hesaplanir. */
function butonDurumu() {
    const girisler = document.querySelectorAll(".combo-giris");
    const dolu = Array.from(girisler).every(g => g.value.trim().length > 1);
    girisler.forEach(g => g.classList.toggle("secili", g.value.trim().length > 1));
    seciciBtn.disabled = mesgul || !dolu;
}

function secimOku() {
    const sonuc = {};
    document.querySelectorAll(".combo").forEach(k => {
        sonuc[k.dataset.alan] = k.querySelector(".combo-giris").value.trim();
    });
    return sonuc;
}

function kilitle(durum) {
    mesgul = durum;
    gonderEl.disabled = durum;
    aksiyonlar.forEach(c => { c.disabled = durum; });
    butonDurumu();
}

function comboKur(kok) {
    const giris = kok.querySelector(".combo-giris");
    const liste = kok.querySelector(".combo-liste");

    function ciz(filtre) {
        const f = (filtre || "").toLowerCase();
        const sonuc = DATASETLER.filter(d => d.toLowerCase().includes(f)).slice(0, 60);
        liste.innerHTML = "";
        if (!sonuc.length) {
            const li = document.createElement("li");
            li.className = "bos";
            li.textContent = DATASETLER.length
                ? "Eşleşen veri seti yok — yazdığınız ad yine de kullanılacak"
                : "Veri setleri okunamadı — adı elle yazabilirsiniz";
            liste.appendChild(li);
            return;
        }
        sonuc.forEach(ad => {
            const li = document.createElement("li");
            li.textContent = ad;
            // mousedown: input'un blur olayindan ONCE calissin diye
            li.onmousedown = e => {
                e.preventDefault();
                giris.value = ad;
                butonDurumu();
                liste.classList.remove("acik");
            };
            liste.appendChild(li);
        });
    }

    giris.addEventListener("focus",  () => { ciz(giris.value); liste.classList.add("acik"); });
    giris.addEventListener("input",  () => { ciz(giris.value); liste.classList.add("acik"); butonDurumu(); });
    giris.addEventListener("change", butonDurumu);
    giris.addEventListener("blur",   () => { setTimeout(() => liste.classList.remove("acik"), 120); });
    giris.addEventListener("keydown", e => {
        if (e.key === "Escape") liste.classList.remove("acik");
        if (e.key === "Enter")  { e.preventDefault(); liste.classList.remove("acik"); }
    });
}

document.querySelectorAll(".combo").forEach(comboKur);
butonDurumu();

fetch(getWebAppBackendUrl("datasetler"))
    .then(r => r.json())
    .then(d => { DATASETLER = d.datasetler || []; })
    .catch(() => { DATASETLER = []; });

seciciBtn.onclick = () => {
    const s = secimOku();
    if (!s.veri_seti || !s.sozluk) return;
    gonder("veri seti " + s.veri_seti + " ve sözlük " + s.sozluk);
};


/* ==================== Gönderme ==================== */
function gonder(metinDisaridan) {
    if (mesgul) return;
    const metin = (metinDisaridan || kutuEl.value).trim();
    if (!metin) return;

    sayfaAc("calisma");
    balonEkle("kullanici", metin);
    kutuEl.value = "";
    kutuEl.style.height = "auto";
    kilitle(true);

    const yaziyor = yaziyorEkle();

    fetch(getWebAppBackendUrl("mesaj"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID, mesaj: metin })
    })
    .then(r => r.json())
    .then(d => {
        yaziyor.remove();
        const hataMi = typeof d.cevap === "string" && d.cevap.startsWith("HATA:");
        balonEkle("bot", d.cevap, hataMi);
        if (d.adim_no !== undefined) {
            aktifAdim = d.adim_no;
            aktifFaziAc();
            fazlariCiz();
        }
        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
        kartiGuncelle(d.ozet);
    })
    .catch(e => { yaziyor.remove(); balonEkle("bot", "Bağlantı hatası: " + e, true); })
    .finally(() => { kilitle(false); kutuEl.focus(); });
}

gonderEl.onclick = () => gonder();
aksiyonlar.forEach(c => { c.onclick = () => gonder(c.dataset.mesaj); });

kutuEl.addEventListener("keydown", e => {
    if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); gonder(); }
});
kutuEl.addEventListener("input", () => {
    kutuEl.style.height = "auto";
    kutuEl.style.height = Math.min(kutuEl.scrollHeight, 120) + "px";
});


/* ==================== Karşılama ==================== */
fetch(getWebAppBackendUrl("karsilama"))
    .then(r => r.json())
    .then(d => {
        sohbetEl.insertBefore(balonYap("bot", d.metin), kartEl);
        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
    })
    .catch(e => balonEkle("bot", "Bağlantı hatası: " + e, true));


/* ==================== Yeni oturum ==================== */
document.getElementById("sifirla-btn").onclick = () => {
    fetch(getWebAppBackendUrl("sifirla"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ oturum_id: OTURUM_ID })
    })
    .then(r => r.json())
    .then(d => {
        sohbetEl.innerHTML = "";
        aktifAdim = 0;
        acikFazlar = new Set();
        aktifFaziAc();
        document.querySelectorAll(".combo-giris").forEach(g => {
            g.value = "";
            g.classList.remove("secili");
        });
        kilitle(false);
        kartEl.classList.remove("gizli");
        sohbetEl.appendChild(balonYap("bot", d.metin));
        sohbetEl.appendChild(kartEl);
        fazlariCiz();
        ozetGuncelle(d.ozet);
        detayGuncelle(d.detay);
        sayfaAc("calisma");
    })
    .catch(e => balonEkle("bot", "Oturum sıfırlanamadı: " + e, true));
};
