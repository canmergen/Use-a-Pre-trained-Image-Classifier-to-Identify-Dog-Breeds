def _adima_gir(durum):
    """Yeni adima girilirken: girdi gerekiyorsa sor, gerekmiyorsa plani goster."""
    adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]
    if adim["girdi"] is not None:
        durum["bekleyen"] = "girdi"
        _, soru = adim["girdi"](durum, "")      # bos mesaj -> eksik listesi doner
        return soru or "Devam etmek için bilgi vermen gerekiyor."
    durum["bekleyen"] = "onay"
    return adim["plan"](durum)


def mesaj_isle(durum, mesaj):
    """Webapp'in cagirdigi TEK fonksiyon. Cevap metnini doner."""
    mesaj = (mesaj or "").strip()
    norm = niyet_kural.normalize(mesaj)
    adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]

    # --- geri donus: her an gecerli ---
    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adımdayız, daha geriye gidemiyorum."
        durum["i"] -= 1
        yeni_adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]
        return ("Tamam, \"%s\" adımına dönüyorum.\n\n" % yeni_adim["baslik"]
                + _adima_gir(durum))

    # --- girdi bekleniyor ---
    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            return uyari
        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    # --- onay bekleniyor ---
    sonuc = niyet_kural.coz(mesaj)

    if sonuc["aksiyon"] == "onay":
        cikti = adim["uygula"](durum)
        if durum["i"] >= len(ADIM_SIRASI) - 1:
            return cikti + "\n\nSüreç tamamlandı. Yeni bir tur için üstteki " \
                           "\"Yeni oturum\" düğmesini kullanabilirsin."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        return ("Anladım, uygulamadım. Neyi değiştirmemi istersin? "
                "İstediğini yazabilir ya da \"geri\" deyip önceki adıma "
                "dönebilirsin.")

