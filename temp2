               _ond(b["auc"], 4), _ond(e["auc"], 4), _ond(d["auc"], 4),
               _ond(b["gini"], 4), _ond(e["gini"], 4), _ond(d["gini"], 4),
               _ond(b["ks"], 4), _ond(e["ks"], 4), _ond(d["ks"], 4),
               _sayi(sonuc["baz_kolon"]),
