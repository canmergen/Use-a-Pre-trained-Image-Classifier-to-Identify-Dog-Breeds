def _logla(mesaj):
    """Agent log'una yazar. Dataiku bu ciktiyi Logs sekmesinde gosterir."""
    print("[durum_belirle] {}".format(mesaj))


def _json_ayristir(ham):
    """girdi_al ciktisini dict'e cevirir.

    LLM JSON'u bazen ``` blogu icinde donduruyor; o durumu da temizler.
    Ayristirilamayan girdi icin bos dict doner (akis sohbete duser).
    """
    if isinstance(ham, dict):
        return ham

    metin = str(ham or "").strip()
    if not metin:
        return {}

    if metin.startswith("```"):
        metin = metin.strip("`").strip()
        if metin.lower().startswith("json"):
            metin = metin[4:].strip()

    try:
        cozulen = json.loads(metin)
    except (ValueError, TypeError):
        _logla("girdi JSON olarak ayristirilamadi: {!r}".format(metin[:200]))
        return {}

    return cozulen if isinstance(cozulen, dict) else {}


def _hafizayi_oku():
    """PROJE_HAFIZASI/sema.json icerigini dondurur.

    Dosya yoksa, bozuksa veya folder'a erisilemiyorsa None doner; bu durum
    hata degildir (ilk calistirmada beklenen durumdur).
    """
    try:
        folder = dataiku.Folder(Folder.HAFIZA)
        if Folder.SEMA_DOSYASI not in folder.list_paths_in_partition():
            _logla("hafiza dosyasi yok: {}".format(Folder.SEMA_DOSYASI))
            return None
        with folder.get_download_stream(Folder.SEMA_DOSYASI) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("hafiza okunamadi: {}".format(hata))
        return None


def _proje_dataset_adlari():
    """Projedeki dataset adlarini set olarak dondurur.

    API'ye erisilemezse None doner. None, "dogrulama yapilamadi" anlamina
    gelir ve cagiran taraf bu durumda adi reddetmez.
    """
    try:
        proje = dataiku.api_client().get_default_project()
        return {d["name"] for d in proje.list_datasets()}
    except Exception as hata:
        _logla("dataset listesi alinamadi: {}".format(hata))
        return None


def _dataset_gecerli_mi(ad):
    """Verilen adin projede gercek bir dataset olup olmadigini soyler."""
    if not ad:
        return False

    temiz = str(ad).strip()
    if temiz.lower() in GECERSIZ_DATASET_ADLARI:
        return False

    mevcut = _proje_dataset_adlari()
    if mevcut is None:
        # Dogrulama yapilamadi: bariz gecersizler zaten elendi, adi kabul et.
        return True
    return temiz in mevcut


def _liste_yap(deger):
    """Tek deger veya liste gelebilen alani listeye cevirir."""
    if deger is None:
        return []
    if isinstance(deger, list):
        return deger
    return [deger]


def _beklenen_ayarla(deger):
    """Bir sonraki turda girdi_al'a enjekte edilecek beklenti.

    Kullaniciya soru soran her dal bunu ayarlamalidir; yoksa girdi_al
    cevabi baglamsiz yorumlar ve yanlis aksiyon dondurur.
    """
    state[S.BEKLENEN] = deger
    _logla("beklenen cevap: {}".format(deger))


def _aksiyonu_coz(g):
    """girdi_al'in aksiyon alanini dogrular.

    Liste disi veya eksik bir deger gelirse BILGI'ye duser ve teshis icin
    loglanir; boylece sema/prompt uyumsuzlugu sessizce gizlenmez.
    """
    ham = g.get(G.AKSIYON)
    if ham is None:
        _logla("UYARI: girdi_al 'aksiyon' alani gondermedi")
        return Aksiyon.BILGI

    temiz = str(ham).strip().lower()
    if temiz not in GECERLI_AKSIYONLAR:
        _logla("UYARI: taninmayan aksiyon {!r}, BILGI'ye dusuruldu".format(ham))
        return Aksiyon.BILGI
    return temiz


def _girdiyi_state_e_isle(g):
    """girdi_al ciktisini dogrulayarak state'e yazar."""
    state[S.GECERSIZ_AD] = ""

    aday = g.get(G.VERI_SETI)
    if aday:
        if _dataset_gecerli_mi(aday):
            state[S.VERI_SETI] = str(aday).strip()
        else:
            state[S.GECERSIZ_AD] = str(aday).strip()
            _logla("gecersiz dataset adi reddedildi: {}".format(aday))

    for girdi_alan, state_alan in (
        (G.SOZLUK, S.SOZLUK),
        (G.TARGET, S.TARGET),
        (G.ID_KOLONU, S.ID_KOLONU),
        (G.DONEM_KOLONU, S.DONEM_KOLONU),
        (G.BOLME_KOLONU, S.BOLME_KOLONU),
    ):
        if g.get(girdi_alan) is not None:
            state[state_alan] = g[girdi_alan]

    # Tura ozel alanlar: her turda tazelenir, onceki turdan sizmaz.
    state[S.AKSIYON] = _aksiyonu_coz(g)
    state[S.KOLONLAR] = _liste_yap(g.get(G.KOLONLAR))
    state[S.KOLON_ACIKLAMASI] = g.get(G.KOLON_ACIKLAMASI) or ""

    state[S.DATASET_VAR] = bool(state.get(S.VERI_SETI))
    state[S.SOZLUK_VAR] = bool(state.get(S.SOZLUK))


def _kolon_baglami(kolonlar):
    """Sorulan kolonlarin mevcut aciklamalarini sema.json'dan okur.

    sohbet blogu ifade onerisi verirken uydurmasin diye promptuna eklenir.
    """
    if not kolonlar:
        return ""

    kayit = _hafizayi_oku() or {}
    sozluk = kayit.get(Sema.SOZLUK) or {}
    tipler = kayit.get(Sema.TIPLER) or {}
    tablo = set(kayit.get(Sema.KOLONLAR) or [])

    parcalar = []
    for kolon in kolonlar[:3]:
        ad = str(kolon).strip()
        gercek = ad if (ad in tablo or ad in sozluk) else None
        if gercek is None:
            kucuk = {k.lower(): k for k in (set(sozluk) | tablo)}
            gercek = kucuk.get(ad.lower())
        if gercek is None:
            parcalar.append("{}: ne tabloda ne sozlukte var".format(ad))
            continue
        parcalar.append("{} (tip: {}): mevcut aciklama: {}".format(
            gercek,
            tipler.get(gercek, "bilinmiyor"),
            sozluk.get(gercek) or "YOK",
        ))
    return " | ".join(parcalar)


def _durum_ozetini_kur(asama):
    """sohbet ve girdi_al bloklarinin promptuna gidecek durum bildirimi."""
    if state.get(S.GECERSIZ_AD):
        ozet = (
            "UYARI: Kullanicinin verdigi '{ad}' bir dataset degil (dosya/klasor "
            "adi). Onu okumaya CALISMA; kullanicidan gecerli bir dataset adi iste."
        ).format(ad=state[S.GECERSIZ_AD])
    elif state.get(S.VERI_SETI):
        ozet = "Veri seti: {vs}. Sozluk: {sz}.".format(
            vs=state[S.VERI_SETI],
            sz=state.get(S.SOZLUK) or "belirlenmedi",
        )
    elif state.get(S.ONCEKI_BEKLIYOR):
        ozet = (
            "Kayitli bir oturum bulundu ({vs}) ve kullanicinin bununla devam "
            "edip etmeyecegi soruldu; cevap bekleniyor."
        ).format(vs=state.get(S.ONCEKI_VERI_SETI))
    elif state.get(S.ONCEKI_REDDEDILDI):
        ozet = (
            "Kullanici kayitli oturumu simdilik kullanmiyor. Kayit proje "
            "hafizasinda duruyor ve istenirse geri alinabilir; kaybolmadi."
        )
    else:
        ozet = "Veri seti henuz belirlenmedi."

    ozet += " BULUNULAN ADIM: {ad} (tamamlanmadi, devam ediyor).".format(
        ad=ASAMA_ADLARI.get(asama, asama))

    if state.get(S.KARSILANDI):
        ozet += " Karsilama metni zaten gosterildi, tekrar etme."

    # Gorus istendiginde kolon gercekleri prompta girer; LLM uydurmasin.
    if state.get(S.AKSIYON) == Aksiyon.GORUS_ISTE and state.get(S.KOLONLAR):
        baglam = _kolon_baglami(state[S.KOLONLAR])
        if baglam:
            ozet += (
                " KOLON BAGLAMI: {}. Kullanici ifade onerisi istiyor. Sadece "
                "kullanicinin verdigi anlami daha duzgun ifade et; kolona yeni "
                "bir anlam atfetme. Onerdigin ifadeyi onaya sun."
            ).format(baglam)

    state[S.DURUM_OZETI] = ozet


def _onceki_oturumu_state_e_yaz(kayit):
    """sema.json icerigini onceki_* anahtarlarina tasir.

    Eslesme istatistikleri de burada cikarilir; ozet mesaji bunlari kullanir.
    """
    state[S.ONCEKI_VERI_SETI] = kayit.get(Sema.VERI_SETI)
    state[S.ONCEKI_SOZLUK] = kayit.get(Sema.SOZLUK_ADI)
    state[S.ONCEKI_N_SATIR] = kayit.get(Sema.N_SATIR)
    state[S.ONCEKI_N_KOLON] = kayit.get(Sema.N_KOLON)

    sozluk = kayit.get(Sema.SOZLUK)
    state[S.ONCEKI_N_ACIKLAMA] = len(sozluk) if isinstance(sozluk, dict) else 0

    aciklamasiz = kayit.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    fazla = kayit.get(Sema.SOZLUKTE_VAR_TABLODA_YOK)
    state[S.ONCEKI_ACIKLAMASIZ] = aciklamasiz if isinstance(aciklamasiz, list) else []
    state[S.ONCEKI_FAZLA] = fazla if isinstance(fazla, list) else []

    # Tabloda olup aciklamasi olan kolon sayisi.
    state[S.ONCEKI_ESLESEN] = max(
        int(kayit.get(Sema.N_KOLON) or 0) - len(state[S.ONCEKI_ACIKLAMASIZ]), 0)

    state[S.ONCEKI_BEKLIYOR] = True


def _onceki_oturumu_beklemeden_cikar():
    """Kayit reddedildi: aktif oturumdan cikarilir ama SILINMEZ.

    sema.json diskte durur; kullanici fikrini degistirirse tekrar okunur.
    """
    for anahtar in ONCEKI_KAYIT_ANAHTARLARI:
        state[anahtar] = None
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = True
    _logla("kayitli oturum reddedildi (dosya korunuyor)")


def _asamayi_ayarla(yeni_asama):
    """Asama gecisini tek noktadan yapar ve loglar."""
    eski = state.get(S.ASAMA) or Asama.BASLANGIC
    state[S.ASAMA] = yeni_asama
    _logla("asama gecisi: {} -> {}".format(eski, yeni_asama))


def _kayitla_devam_et(veri_seti, sozluk_adi):
    """Kaydi aktif oturuma tasir ve sozluk adimina hazirlar."""
    state[S.VERI_SETI] = veri_seti
    state[S.SOZLUK] = sozluk_adi
    state[S.DATASET_VAR] = True
    state[S.SOZLUK_VAR] = bool(sozluk_adi)
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = False
    _asamayi_ayarla(Asama.SOZLUK)


def _kolon_talebi_var_mi():
    """Bu turda kolonla ilgili bir islem isteniyor mu?"""
    return state.get(S.AKSIYON) in KOLON_AKSIYONLARI


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        ham_girdi = state.get(S.GIRDI)
        g = _json_ayristir(ham_girdi)
        _girdiyi_state_e_isle(g)

        aksiyon = state.get(S.AKSIYON)
        asama = state.get(S.ASAMA) or Asama.BASLANGIC
        _durum_ozetini_kur(asama)

        _logla("aksiyon={} beklenen={} kolonlar={}".format(
            aksiyon, state.get(S.BEKLENEN), state.get(S.KOLONLAR)))

        # aksiyon BILGI'ye dustuyse girdi_al'in ham ciktisini gor.
        # Ya JSON bozuk, ya sema eski, ya prompt guncellenmemis demektir.
        if aksiyon == Aksiyon.BILGI:
            _logla("TESHIS - ham cikti: {!r}".format(str(ham_girdi)[:500]))
            _logla("TESHIS - ayristirilan anahtarlar: {}".format(
                sorted(g.keys()) if g else "BOS"))

        # --- 1) Ilk tur: karsilama (+ varsa kayit sorusu) ---------------------
        if not state.get(S.KARSILANDI):
            state[S.KARSILANDI] = True
            kayit = _hafizayi_oku()

            if kayit and kayit.get(Sema.VERI_SETI) and not state.get(S.VERI_SETI):
                _onceki_oturumu_state_e_yaz(kayit)
                _durum_ozetini_kur(asama)
                _beklenen_ayarla(Beklenen.KAYIT_KARARI)
                yield "{}\n\n---\n\n{}".format(KARSILAMA, _onceki_kayit_mesaji())
                return

            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield "{}\n\n{}".format(KARSILAMA, BILGI_ISTEGI)
            return

        # --- 2) Kayit karari bekleniyor ---------------------------------------
        # RET ACIK OLMALIDIR: yalnizca kayit_yeni reddedilir. Karar verilmeden
        # gelen soru veya kolon istegi kaydi silmez.
        if state.get(S.ONCEKI_BEKLIYOR):
            if aksiyon == Aksiyon.KAYIT_YENI:
                _onceki_oturumu_beklemeden_cikar()
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield SIFIRDAN_BASLA
                return

            if aksiyon in (Aksiyon.KAYIT_DEVAM, Aksiyon.ONAY):
                _kayitla_devam_et(
                    state.get(S.ONCEKI_VERI_SETI), state.get(S.ONCEKI_SOZLUK))
                # Ayni mesajda kolon talebi de varsa once ona cevap ver.
                if state.get(S.KOLONLAR):
                    _beklenen_ayarla(Beklenen.KOLON_ACIKLAMASI)
                    if state.get(S.KOLON_ACIKLAMASI):
                        yield NextBlock(Blok.KOLON_SORGU)
                        return
                    yield NextBlock(Blok.SOHBET)
                    return
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            # Karar yok: kaydi koru. Kolon sorusu varsa yine de cevapla.
            _beklenen_ayarla(Beklenen.KAYIT_KARARI)
            if _kolon_talebi_var_mi():
                yield NextBlock(Blok.KOLON_SORGU)
                return
            yield _karar_bekleniyor_mesaji()
            return

        # --- 3) Kayitli oturuma geri donus ------------------------------------
        if not state.get(S.VERI_SETI) and aksiyon == Aksiyon.KAYIT_DEVAM:
            kayit = _hafizayi_oku()
            if kayit and kayit.get(Sema.VERI_SETI):
                _kayitla_devam_et(
                    kayit.get(Sema.VERI_SETI), kayit.get(Sema.SOZLUK_ADI))
                _logla("kayitli oturuma geri donuldu: {}".format(
                    kayit.get(Sema.VERI_SETI)))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield _kayit_geri_alindi_mesaji(
                    state[S.VERI_SETI], state.get(S.SOZLUK))
                yield NextBlock(Blok.SOZLUK_CALIS)
                return
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield KAYIT_BULUNAMADI
            return

        # --- 4) Kolon islemi ---------------------------------------------------
        # Onaydan ONCE: kullanici kolon sorarken surec ilerlemez.
        if _kolon_talebi_var_mi() or (
                aksiyon == Aksiyon.GORUS_ISTE and state.get(S.KOLONLAR)):
            if not state.get(S.VERI_SETI):
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield KOLON_ICIN_VERI_GEREKLI
                return
            _beklenen_ayarla(Beklenen.KOLON_ACIKLAMASI)
            # Aciklama verilmemis, sadece fikir isteniyorsa sohbet ifade onerir.
            # Kolon gercekleri durum_ozeti'ne zaten eklendi.
            if not state.get(S.KOLON_ACIKLAMASI):
                yield NextBlock(Blok.SOHBET)
                return
            yield NextBlock(Blok.KOLON_SORGU)
            return

        # --- 5) Gecersiz dataset adi ------------------------------------------
        if state.get(S.GECERSIZ_AD):
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield _gecersiz_ad_mesaji(state[S.GECERSIZ_AD])
            return

        # --- 6) Baslangic: veri seti belirlendi --------------------------------
        if asama == Asama.BASLANGIC and state.get(S.DATASET_VAR):
            _asamayi_ayarla(Asama.SOZLUK)
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 7) Adim icinde onay: ilgili islem bloguna yonlendir ---------------
        # Bu dal olmadan onay sohbete duser ve LLM adimi tamamlanmis gibi anlatir.
        if aksiyon == Aksiyon.ONAY and asama in ASAMA_HARITASI:
            hedef_blok = ASAMA_HARITASI[asama]
            if hedef_blok:
                _logla("onay alindi, {} bloguna yonlendiriliyor".format(hedef_blok))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(hedef_blok)
                return
            _logla("onay alindi ama '{}' adiminin blogu kurulmamis".format(asama))
            _beklenen_ayarla(Beklenen.YOK)
            yield _adim_hazir_degil_mesaji(asama)
            return

        # --- 8) Diger her sey: serbest sohbet ---------------------------------
        _beklenen_ayarla(Beklenen.YOK)
        yield NextBlock(Blok.SOHBET)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        _beklenen_ayarla(Beklenen.VERI_SETI)
        yield BEKLENMEYEN_HATA











Kullanıcının son mesajını, sürecin şu anki durumunu bilerek yorumla ve
SADECE JSON döndür. Açıklama, önsöz, markdown kod bloğu yazma. Yanıtın {
ile başlayıp } ile bitsin.

MEVCUT DURUM: {{ state.durum_ozeti }}
BEKLENEN CEVAP: {{ state.beklenen }}

Döndüreceğin JSON'un yapısı:

{
  "aksiyon": "bilgi",
  "veri_seti": null,
  "sozluk": null,
  "target": null,
  "id_kolonu": null,
  "donem_kolonu": null,
  "bolme_kolonu": null,
  "kolonlar": [],
  "kolon_aciklamasi": null
}

aksiyon zorunludur ve kullanıcının bu mesajla ne yapmak istediğini söyler.
Şu sekiz değerden birini seç, başka bir değer yazma:

  "kayit_devam"    Kayıtlı oturumla ilerlemek istiyor
  "kayit_yeni"     Kaydı bırakıp başka bir veri setiyle sıfırdan başlamak
                   istiyor
  "onay"           Sunulan planı veya adımı onaylıyor, ilerlenmesini istiyor
  "ret"            Sunulan planı reddediyor veya durmak istiyor
  "kolon_sor"      Bir kolonun ne anlama geldiğini soruyor
  "kolon_tanimla"  Bir kolonun açıklamasını veriyor veya düzeltiyor
  "gorus_iste"     Senden fikir, öneri, "sence ne olmalı" tarzı bir
                   değerlendirme istiyor
  "bilgi"          Yukarıdakilerin hiçbiri; soru soruyor veya sohbet ediyor

BEKLENEN CEVAP alanı, sistemin kullanıcıdan ne beklediğini söyler.
Kullanıcının mesajını ÖNCE bu beklentiye göre yorumla. Kullanıcının kelime
seçimi tamamen serbesttir; kalıp arama, anlamı değerlendir.

  BEKLENEN "kayit_karari" ise:
    Kullanıcı kayıtlı oturumla devam etmeyi kabul ediyorsa "kayit_devam".
    Başka bir veri setiyle sıfırdan başlamak istiyorsa "kayit_yeni".
    Örnekler kayit_devam için: "bununla devam edelim", "bu veriyle devam",
    "evet", "olsun", "kalsın", "tamam ilerleyelim", "onaylıyorum",
    "öncekini kullan", "devam".
    Örnekler kayit_yeni için: "yeni bir veri setiyle başlayalım", "sıfırdan",
    "başka veri kullanacağım", "vazgeçtim yenisini açalım".
    Kullanıcı bunun yanında başka bir şey de istiyorsa (kolon sorusu gibi)
    yine kayıt kararını aksiyon olarak seç; diğer bilgileri ilgili alanlara
    yaz.

  BEKLENEN "veri_seti" ise:
    Kullanıcı bir dataset adı yazdıysa veri_seti alanını doldur ve aksiyon
    "bilgi" olsun.

  BEKLENEN "adim_onayi" ise:
    Kullanıcı ilerlenmesini kabul ediyorsa "onay", istemiyorsa "ret".

  BEKLENEN "kolon_aciklamasi" ise:
    Kullanıcı bir açıklama metni yazdıysa "kolon_tanimla" seç ve metni
    kolon_aciklamasi alanına yaz. Sadece soru soruyorsa "kolon_sor".

  BEKLENEN "yok" ise:
    Mesajı kendi başına değerlendir.

Bir mesaj birden çok şey içerebilir. aksiyon en baskın olanı taşır; diğer
bilgiler alanlara yazılır. Örnek: "bu kayıtla devam edelim, sm_id için ne
yazmak lazım sence" → aksiyon "kayit_devam", kolonlar ["sm_id"].

Alan kuralları:

veri_seti, sozluk: Dataset adları. Kullanıcı bir dosya veya klasör adı
söylerse (sema.json, PROJE_HAFIZASI gibi) bu alanlara YAZMA, null bırak.

target, id_kolonu, donem_kolonu, bolme_kolonu: Kullanıcı bu rolleri açıkça
bir kolona atadıysa o kolonun adı.

kolonlar: Bahsedilen kolon adları; kullanıcının yazdığı haliyle al,
düzeltme yapma, büyük/küçük harfini değiştirme. Kolon adı geçmiyorsa boş
liste.

kolon_aciklamasi: Kullanıcının bir kolon için verdiği açıklama metni.
Sadece kullanıcının söylediğini aktar; kendin anlam üretme. Kullanıcı
anlamı söylemeden sadece soru soruyorsa null.

