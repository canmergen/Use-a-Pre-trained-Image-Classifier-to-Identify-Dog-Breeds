/* -------- Veri seçim kartı: bot balonuyla aynı — kırmızı zemin -------- */
#secici-kart {
  max-width: 88%; margin: 0 0 18px var(--girinti);
  background: var(--kirmizi); border: none; border-radius: 14px;
  border-top-left-radius: 4px;
  padding: 18px 20px 20px; box-shadow: 0 3px 12px rgba(0,0,0,.3);
  color: #fff;
}
#secici-kart.gizli { display: none; }
.kart-baslik { font-weight: 700; font-size: 1.15em; margin-bottom: 5px; color: #fff; }
.kart-alt { font-size: 1em; color: #fff; line-height: 1.55; margin-bottom: 14px; opacity: .92; }
.kart-govde { display: flex; gap: 11px; align-items: flex-end; flex-wrap: wrap; }

.combo { position: relative; flex: 1; min-width: 165px; }
.combo label {
  display: block; font-size: .95em; color: #fff;
  margin-bottom: 5px; font-weight: 700;
}
/* Giris kutulari kirmizi zeminde beyaz kapsul */
.combo-giris {
  width: 100%; padding: 9px 14px; border: 1px solid rgba(255,255,255,.4);
  border-radius: 999px;
  font-family: ui-monospace, Consolas, monospace; font-size: 1em;
  outline: none; background: #fff; color: #000;
}
.combo-giris::placeholder { color: #000; opacity: .45; }
.combo-giris:focus { border-color: #fff; box-shadow: 0 0 0 3px rgba(255,255,255,.35); }
.combo-giris.secili { border-color: var(--yesil); border-width: 2px; }

/* Acilir liste beyaz kalir — okunabilirlik icin */
.combo-liste {
  position: absolute; z-index: 20; top: 100%; left: 0; right: 0;
  margin: 4px 0 0; padding: 5px; list-style: none;
  background: var(--balon-zemin); border: 1px solid var(--balon-kenar);
  border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,.35);
  max-height: 230px; overflow-y: auto; display: none;
}
.combo-liste.acik { display: block; }
.combo-liste li {
  padding: 7px 12px; border-radius: 999px; cursor: pointer;
  font-family: ui-monospace, Consolas, monospace; font-size: .98em;
  color: var(--balon-metin);
}
.combo-liste li:hover { background: var(--kirmizi-acik); color: var(--kirmizi); }
.combo-liste li.bos { cursor: default; font-family: inherit; opacity: .7; }
.combo-liste li.bos:hover { background: none; color: var(--balon-metin); }

/* Analizi baslat: kirmizi zeminde beyaz buton */
#secici-btn {
  padding: 9px 24px; background: #fff; color: var(--kirmizi-koyu);
  border: none; border-radius: 999px; font-size: 1.05em; font-weight: 700;
  cursor: pointer; white-space: nowrap;
}
#secici-btn:hover:not(:disabled) { background: #FFE8E9; }
#secici-btn:disabled { background: rgba(255,255,255,.35); color: rgba(255,255,255,.7); cursor: not-allowed; }
