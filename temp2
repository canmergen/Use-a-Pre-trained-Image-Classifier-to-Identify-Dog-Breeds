def _adima_gir(durum):
    adim = ADIMLAR[ADIM_SIRASI[durum["i"]]]
    if adim["girdi"] is not None:
        durum["bekleyen"] = "girdi"
        _, soru = adim["girdi"](durum, "")
        return soru or "Devam etmek için bilgi vermeniz gerekiyor."
    durum["bekleyen"] = "onay"
    return adim["plan"](durum)


def _adet(durum, anahtar):
    return len(durum.get("plan" if anahtar == "kural" else "hipotez") or [])


def mesaj_isle(durum, mesaj):
    mesaj = (mesaj or "").strip()
    norm = niyet_kural.normalize(mesaj)
    anahtar = ADIM_SIRASI[durum["i"]]
    adim = ADIMLAR[anahtar]

    if GERI_KALIP.search(norm):
        if durum["i"] == 0:
            return "Zaten ilk adımdayız."
        durum["i"] -= 1
        return ("Tamam, \"%s\" adımına dönüyorum.\n\n"
                % ADIMLAR[ADIM_SIRASI[durum["i"]]]["baslik"]) + _adima_gir(durum)

    if durum["bekleyen"] == "girdi":
        tamam, uyari = adim["girdi"](durum, mesaj)
        if not tamam:
            return uyari
        durum["bekleyen"] = "onay"
        return adim["plan"](durum)

    sonuc = niyet_kural.coz(mesaj)

    if sonuc["aksiyon"] == "onay":
        if anahtar in SECIMLI:
            cikti = adim["uygula"](durum, _secim_ayikla(mesaj, _adet(durum, anahtar)))
        else:
            cikti = adim["uygula"](durum)
        if durum["i"] >= len(ADIM_SIRASI) - 1:
            return cikti + "\n\nÇalışma tamamlandı."
        durum["i"] += 1
        return cikti + "\n\n" + _adima_gir(durum)

    if sonuc["aksiyon"] == "ret":
        return ("Anladım, uygulamadım. Neyi değiştirmemi istersiniz? "
                "İstediğinizi yazabilir ya da önceki adıma dönebilirsiniz.")

    return ("Şu an \"%s\" adımındayım. Onaylayabilir, değiştirebilir ya da "
            "geri dönebilirsiniz." % adim["baslik"])
