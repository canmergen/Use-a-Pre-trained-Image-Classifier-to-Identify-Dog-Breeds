const bannerEl   = document.getElementById("banner");
const kartEl     = document.getElementById("secici-kart");
const seciciBtn  = document.getElementById("secici-btn");
const aksiyonlar = Array.from(document.querySelectorAll(".aksiyon"));
const kabukEl    = document.getElementById("kabuk");

const sayfalar    = { calisma: document.getElementById("sayfa-calisma"),
                      ozet:    document.getElementById("sayfa-ozet") };
const sekmeler    = Array.from(document.querySelectorAll(".sekme"));
const ozetKartlar = document.getElementById("ozet-kartlar");
const ozetAdimEl  = document.getElementById("ozet-adim");

const analizGovde = document.getElementById("analiz-govde");
const analizSekme = Array.from(document.querySelectorAll(".analiz-sekme"));

let FAZLAR = [];
let DUZ_ADIMLAR = [];          // sira -> {anahtar, no, baslik, aciklama}
let DATASETLER = [];
let aktifAdim = 0;
let aktifMod = null;           // "A" | "B" | "C"
let acikFazlar = new Set();
let mesgul = false;

bannerEl.src = GORSEL.banner;
bannerEl.onerror = () => { bannerEl.style.display = "none"; };


/* ==================== Tema ==================== */
/* Dataiku artifact'inda localStorage calismadigi icin tercih degiskende
   tutuluyor; sayfa yenilenince acik temaya doner.
   Ikon o an gecilecek temayi gosterir: aydinlikta ay, karanlikta gunes. */
let koyuTema = false;
const temaBtn = document.getElementById("tema-btn");

const AY_IKON = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" '
    + 'stroke="currentColor" stroke-width="2.2" stroke-linecap="round" '
    + 'stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>';

const GUNES_IKON = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" '
    + 'stroke="currentColor" stroke-width="2.2" stroke-linecap="round" '
    + 'stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"></circle>'
    + '<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4'
    + 'M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>';

function temaUygula() {
    kabukEl.classList.toggle("koyu", koyuTema);
    temaBtn.innerHTML = koyuTema ? GUNES_IKON : AY_IKON;
    temaBtn.title = koyuTema ? "Açık tema" : "Koyu tema";
    sohbetAlan.style.setProperty(
        "--sohbet-gorsel",
        "url('" + (koyuTema ? GORSEL.zeminKoyu : GORSEL.zeminAcik) + "')");
}
temaBtn.onclick = () => { koyuTema = !koyuTema; temaUygula(); };

[GORSEL.zeminAcik, GORSEL.zeminKoyu].forEach(u => { const i = new Image(); i.src = u; });
temaUygula();


/* ==================== Sayfa geçişi ==================== */
function sayfaAc(ad) {
    Object.keys(sayfalar).forEach(k => sayfalar[k].classList.toggle("gizli", k !== ad));
    sekmeler.forEach(s => s.classList.toggle("aktif", s.dataset.sayfa === ad));
}
sekmeler.forEach(s => { s.onclick = () => sayfaAc(s.dataset.sayfa); });


/* ==================== Sol panel: faz ağacı ==================== */
/* Faz agaci moda gore degisir; backend her yanitta guncel halini gonderir. */
function fazlariYukle(liste) {
    FAZLAR = liste || [];
    DUZ_ADIMLAR = [];
    FAZLAR.forEach(f => f.adimlar.forEach(a => { DUZ_ADIMLAR[a.sira] = a; }));
}

function fazlariCiz() {
    fazEl.innerHTML = "";
    FAZLAR.forEach((f, fi) => {
        const siralar = f.adimlar.map(a => a.sira);
        const bitis = Math.max.apply(null, siralar);
        const aktifMi = siralar.indexOf(aktifAdim) !== -1;
        const tamamMi = aktifAdim > bitis;
        const acik = acikFazlar.has(fi);

        const kok = document.createElement("div");
        kok.className = "faz"
            + (aktifMi ? " aktif" : "")
            + (tamamMi ? " tamam" : "")
            + (acik ? " acik" : "");

        const bas = document.createElement("div");
        bas.className = "faz-bas";
        bas.title = acik ? "Adımları gizle" : "Adımları göster";

        const ok = document.createElement("span");
        ok.className = "faz-ok";
        ok.textContent = "›";
        bas.appendChild(ok);

        const no = document.createElement("span");
        no.className = "faz-no";
        no.textContent = f.no;
        bas.appendChild(no);

        const govde = document.createElement("div");
        govde.className = "faz-govde";
        const ad = document.createElement("div");
        ad.className = "faz-ad";
        ad.textContent = f.baslik;
        govde.appendChild(ad);
        const ozt = document.createElement("div");
        ozt.className = "faz-ozet";
        ozt.textContent = f.ozet;
        govde.appendChild(ozt);
        bas.appendChild(govde);

        const tamamSayi = siralar.filter(s => s < aktifAdim).length;
        const durum = document.createElement("span");
        durum.className = "faz-durum";
        durum.textContent = tamamMi ? "✓" : (tamamSayi + "/" + siralar.length);
        durum.title = tamamMi
            ? "Faz tamamlandı"
            : tamamSayi + " / " + siralar.length + " adım tamamlandı";
        bas.appendChild(durum);

        bas.onclick = () => {
            if (acikFazlar.has(fi)) acikFazlar.delete(fi);
            else acikFazlar.add(fi);
            fazlariCiz();
        };
        kok.appendChild(bas);

        const liste = document.createElement("ol");
        liste.className = "faz-adimlar";
        f.adimlar.forEach(a => {
            const li = document.createElement("li");
            if (a.sira < aktifAdim)   li.className = "tamam";
            if (a.sira === aktifAdim) li.className = "aktif";
            li.title = a.aciklama || "";

            const isaret = document.createElement("span");
            isaret.className = "adim-isaret";
            isaret.textContent = (a.sira < aktifAdim) ? "✓" : "";
            li.appendChild(isaret);

            const t = document.createElement("span");
            t.textContent = a.baslik;
            li.appendChild(t);
            liste.appendChild(li);
        });
        kok.appendChild(liste);
        fazEl.appendChild(kok);
    });
}

function aktifFaziAc() {
    FAZLAR.forEach((f, fi) => {
        if (f.adimlar.some(a => a.sira === aktifAdim)) acikFazlar.add(fi);
    });
}

fetch(getWebAppBackendUrl("fazlar") + "?oturum_id=" + OTURUM_ID)
    .then(r => r.json())
    .then(d => {
        fazlariYukle(d.fazlar);
        aktifMod = d.mod || null;
        aktifFaziAc();
        fazlariCiz();
    })
    .catch(() => { fazEl.textContent = "iş akışı yüklenemedi"; });


/* ==================== Üst özet kartları ==================== */
function ozetGuncelle(o) {
    if (!o || !o.kartlar) return;
    seritEl.innerHTML = "";
    o.kartlar.forEach(k => {
        const kart = document.createElement("div");
        kart.className = "ozet-kart";

        const etiket = document.createElement("span");
        etiket.className = "ozet-etiket";
        etiket.textContent = k.etiket;
        kart.appendChild(etiket);

        const deger = document.createElement("span");
        deger.className = "ozet-deger" + (k.deger === "—" ? " bos" : "");
        deger.textContent = k.deger;
        deger.title = k.deger;
        kart.appendChild(deger);

        const ust = document.createElement("span");
        ust.className = "ozet-ust";
        ust.textContent = k.ust || "";
        ust.title = k.ust || "";
        kart.appendChild(ust);

        const alt = document.createElement("span");
        alt.className = "ozet-alt";
        alt.textContent = k.alt || "";
        alt.title = k.alt || "";
        kart.appendChild(alt);

        seritEl.appendChild(kart);
    });
}

/* Secim karti YALNIZCA Mod C'de ve kurulum tamamlanmadan gorunur.
   Mod A ve B'de veri seti sohbet uzerinden seciliyor. */
function kartiGuncelle(d) {
    const o = d.ozet;
    const kuruldu = o && o.kartlar
        && o.kartlar[0].deger !== "—" && o.kartlar[1].deger !== "—";
    const gizle = (d.mod !== "C") || !!kuruldu;

    kartEl.classList.toggle("gizli", gizle);
    if (!gizle) {
        sohbetEl.appendChild(kartEl);
        sohbetEl.scrollTop = sohbetEl.scrollHeight;
    }
}


/* ==================== Özet sayfası ==================== */
function detayGuncelle(d) {
    if (!d) return;
    ozetAdimEl.textContent = "Adım " + d.adim_no + " / " + d.toplam + " · " + d.adim;
    ozetKartlar.innerHTML = "";

    const bolumler = d.bolumler || [];
    if (!bolumler.length) {
        const bos = document.createElement("div");
        bos.id = "ozet-bos";
        bos.textContent = "Henüz bir adım tamamlanmadı.";
        ozetKartlar.appendChild(bos);
        return;
    }

    bolumler.forEach(b => {
        const blok = document.createElement("div");
        blok.className = "ozet-blok";

        const bas = document.createElement("div");
        bas.className = "ozet-blok-baslik";
        bas.textContent = b.baslik;
        blok.appendChild(bas);

        (b.satirlar || []).forEach(ikili => {
            const satir = document.createElement("div");
            satir.className = "ozet-satir";

            const e = document.createElement("span");
            e.className = "ozet-satir-etiket";
            e.textContent = ikili[0];
            satir.appendChild(e);

            const v = document.createElement("span");
            v.className = "ozet-satir-deger";
            v.textContent = (ikili[1] === null || ikili[1] === undefined)
                ? "—" : String(ikili[1]);
            satir.appendChild(v);

            blok.appendChild(satir);
        });
        ozetKartlar.appendChild(blok);
    });
}


