# =============================================================================
# FEATURE_DISCOVERY_AGENT / sozluk_calis
# -----------------------------------------------------------------------------
# Veri setinin semasini ve sozlugu okur, karsilastirir, sema.json'a yazar.
#
# ONEMLI: sema.json HER CALISMADA yeniden uretilir. Bu yuzden kullanicinin
# elle girdigi tanimlar (sozluk_ek.json) ve surec disi biraktigi kolonlar
# (onceki sema.json > haric_kolonlar) MUTLAKA korunur.
#
# Ozet, korunan katkilarin HANGI KOLONLAR oldugunu ve kaynak sozlukteki bir
# aciklamanin uzerine mi yazildigini acikca soyler; "1 aciklama korundu"
# demek kullaniciya bir sey ifade etmiyor.
#
# Kaynak sozluk dataset'i DEGISTIRILMEZ.
# =============================================================================

import json

import dataiku


FOLDER_ADI = "PROJE_HAFIZASI"
SEMA_DOSYASI = "sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

# Ozette tek satirda listelenecek azami kolon adi.
AZAMI_LISTELENEN = 10

# Aciklama metninin ozette gosterilecek azami uzunlugu.
AZAMI_ACIKLAMA_UZUNLUGU = 60


def _logla(mesaj):
    print("[sozluk_calis] {}".format(mesaj))


def _json_oku(dosya_yolu, varsayilan):
    """Managed folder icindeki bir JSON dosyasini okur."""
    try:
        folder = dataiku.Folder(FOLDER_ADI)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _onceki_semayi_oku():
    """Bir onceki sema.json; korunacak alanlar oradan alinir."""
    veri = _json_oku("/" + SEMA_DOSYASI, {})
    return veri if isinstance(veri, dict) else {}


def _ek_sozlugu_oku():
    """Kullanicinin elle girdigi tanimlar."""
    veri = _json_oku(EK_SOZLUK_DOSYASI, {})
    return veri if isinstance(veri, dict) else {}


def _kisalt(metin):
    """Uzun aciklamalari ozette tasmayacak sekilde kirpar."""
    temiz = str(metin or "").strip()
    if len(temiz) > AZAMI_ACIKLAMA_UZUNLUGU:
        return temiz[:AZAMI_ACIKLAMA_UZUNLUGU] + "..."
    return temiz


def _kolon_ozeti(baslik, kolonlar):
    """Kolon listesini kisaltarak tek satirda yazar."""
    gosterilen = ", ".join(kolonlar[:AZAMI_LISTELENEN])
    if len(kolonlar) > AZAMI_LISTELENEN:
        gosterilen += " ..."
    return "{} {} kolon: {}".format(baslik, len(kolonlar), gosterilen)


def _katki_satirlari(yeni_eklenen, uzerine_yazilan):
    """Kullanicinin katkilarini kolon adi ve aciklamasiyla listeler."""
    satirlar = []

    if yeni_eklenen:
        satirlar.append("**Sizin eklediğiniz açıklamalar**")
        for kolon, aciklama in sorted(yeni_eklenen.items()):
            satirlar.append("**{}** — {}".format(kolon, _kisalt(aciklama)))

    if uzerine_yazilan:
        satirlar.append("**Sözlüğün üzerine yazdığınız açıklamalar**")
        for kolon, (eski, yeni) in sorted(uzerine_yazilan.items()):
            satirlar.append("**{}** — {}\n_Sözlükteki hali: {}_".format(
                kolon, _kisalt(yeni), _kisalt(eski)))

    return satirlar


def process(trace):
    veri_seti = state.get("veri_seti")
    sozluk_adi = state.get("sozluk")
    sozluk_var = bool(state.get("sozluk_var"))

    if not veri_seti:
        yield "Veri seti adı bulunamadı, sözlük hazırlığına başlayamıyorum."
        return

    # 1) Dataset semasi - veriyi bellege almadan
    ds = dataiku.Dataset(veri_seti)
    sema = ds.read_schema()
    kolonlar = [c["name"] for c in sema]
    tipler = {c["name"]: c["type"] for c in sema}

    # 2) Satir sayisi - sadece ilk kolonu okuyarak
    try:
        n_satir = int(ds.get_dataframe(columns=[kolonlar[0]]).shape[0])
    except Exception as hata:
        _logla("satir sayisi okunamadi: {}".format(hata))
        n_satir = None

    # 3) Kaynak sozluk
    kaynak_sozluk = {}
    if sozluk_var and sozluk_adi:
        try:
            sdf = dataiku.Dataset(sozluk_adi).get_dataframe()
            ad_kol, acik_kol = sdf.columns[0], sdf.columns[1]
            kaynak_sozluk = dict(zip(sdf[ad_kol].astype(str),
                                     sdf[acik_kol].astype(str)))
        except Exception as hata:
            _logla("kaynak sozluk okunamadi: {}".format(hata))

    kaynak_sayisi = len(kaynak_sozluk)
    sozluk_map = dict(kaynak_sozluk)

    # 4) KORUNAN BILGILER - kullanicinin el emegi ezilmemeli
    ek_sozluk = _ek_sozlugu_oku()
    onceki_sema = _onceki_semayi_oku()

    # Yeni eklenen ile mevcut aciklamanin uzerine yazilan ayri tutulur;
    # kullanici ne yaptigini gormeli.
    yeni_eklenen = {}
    uzerine_yazilan = {}
    for kolon, aciklama in ek_sozluk.items():
        if not str(aciklama or "").strip():
            continue
        eski = kaynak_sozluk.get(kolon)
        if eski and str(eski).strip() and str(eski).strip() != str(aciklama).strip():
            uzerine_yazilan[kolon] = (eski, aciklama)
        elif not eski or not str(eski).strip():
            yeni_eklenen[kolon] = aciklama
        sozluk_map[kolon] = aciklama

    # Surec disi birakilan kolonlar korunur; artik var olmayanlar duser.
    onceki_haric = onceki_sema.get("haric_kolonlar")
    onceki_haric = onceki_haric if isinstance(onceki_haric, list) else []
    haric_kolonlar = [k for k in onceki_haric if k in kolonlar]

    # 5) Karsilastirma - kullanici tanimlari dahil edildikten SONRA
    sozlukte_var_tabloda_yok = sorted(set(sozluk_map) - set(kolonlar))
    tabloda_var_sozlukte_yok = sorted(
        set(kolonlar) - set(sozluk_map) - set(haric_kolonlar))

    # 6) Folder'a yaz
    kayit = {
        "veri_seti": veri_seti,
        "sozluk_adi": sozluk_adi if sozluk_var else None,
        "n_satir": n_satir,
        "n_kolon": len(kolonlar),
        "kolonlar": kolonlar,
        "tipler": tipler,
        "sozluk": sozluk_map,
        "sozlukte_var_tabloda_yok": sozlukte_var_tabloda_yok,
        "tabloda_var_sozlukte_yok": tabloda_var_sozlukte_yok,
        "haric_kolonlar": haric_kolonlar,
    }
    folder = dataiku.Folder(FOLDER_ADI)
    folder.upload_data(
        SEMA_DOSYASI,
        json.dumps(kayit, ensure_ascii=False, indent=2).encode("utf-8"),
    )
    _logla("sema.json yazildi: {} kolon, {} aciklama (yeni {}, uzerine {}), "
           "{} haric".format(len(kolonlar), len(sozluk_map), len(yeni_eklenen),
                             len(uzerine_yazilan), len(haric_kolonlar)))

    # 7) Ozet
    satirlar = [
        "**{}** okundu: {} satır, {} kolon.".format(
            veri_seti,
            n_satir if n_satir is not None else "?",
            len(kolonlar)),
    ]

    if sozluk_var:
        satirlar.append("**{}** sözlüğünde {} kolon açıklaması var.".format(
            sozluk_adi, kaynak_sayisi))
        if sozlukte_var_tabloda_yok:
            satirlar.append(_kolon_ozeti(
                "Sözlükte olup tabloda olmayan", sozlukte_var_tabloda_yok))
        if tabloda_var_sozlukte_yok:
            satirlar.append(_kolon_ozeti(
                "Tabloda olup sözlükte olmayan", tabloda_var_sozlukte_yok))
    else:
        satirlar.append("Sözlük verilmedi; kolon adlarından çıkarım yapılacak.")

    katkilar = _katki_satirlari(yeni_eklenen, uzerine_yazilan)
    if katkilar:
        satirlar.extend(katkilar)

    if haric_kolonlar:
        satirlar.append(_kolon_ozeti(
            "**Süreç dışı bıraktığınız**", haric_kolonlar))

    ozet = "\n\n".join(satirlar)
    state["sozluk_ozet"] = ozet
    yield ozet
