/* Birincil marka rengi · ikincil outline · ucuncul hayalet */
.aksiyon {
  font-size: 1.02em; font-weight: 600; padding: 10px 22px;
  border-radius: 999px; cursor: pointer; white-space: nowrap;
  transition: filter .15s, background .15s;
}
.aksiyon:disabled { opacity: .4; cursor: not-allowed; }

.aksiyon.onayla {
  background: var(--kirmizi); color: #fff; border: none;
  box-shadow: 0 2px 8px rgba(213,17,21,.3);
}
.aksiyon.onayla:hover:not(:disabled) { background: var(--kirmizi-koyu); }

.aksiyon.degistir {
  background: var(--yuzey); color: var(--metin);
  border: 1px solid var(--kenar);
}
.aksiyon.degistir:hover:not(:disabled) { border-color: var(--metin); }

.aksiyon.geri {
  background: transparent; color: var(--metin);
  border: 1px solid transparent;
}
.aksiyon.geri:hover:not(:disabled) { background: var(--kenar-acik); }





.panel-metin { margin: 0 0 12px; font-size: 1.02em; line-height: 1.75; color: var(--metin); }
.faz-ozet { font-size: .95em; margin-top: 3px; line-height: 1.45; }
.faz-adimlar li { padding: 6px 8px; font-size: 1em; }
.iskele-satir { font-size: 1em; padding: 7px 0; }
.iskele-kart { padding: 15px 17px; margin-bottom: 12px; }
