    toplam = sum(len(p["kolonlar"]) for p in plan)
    return ("Sözlüğü inceledim. %s dönüşüm fırsatı belirledim (%s):\n\n%s\n\n"
            "Bunlar yaklaşık %s yeni kolon üretir. Başlayalım mı?"
