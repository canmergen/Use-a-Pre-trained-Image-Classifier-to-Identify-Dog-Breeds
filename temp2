"""fe_agent — Dataiku Structured Visual Agent için feature engineering akışı.

Katmanlar:
    asamalar  aşama kaydı ve sıralama
    metin     kullanıcıya dönen tüm çıktıların biçimlendirilmesi
    komut     kullanıcı mesajının deterministik ayrıştırılması
    durum     agent state şeması ve erişim
    hafiza    PROJE_HAFIZASI managed folder okuma/yazma
    kurulum   aşama 1 işleyicisi
    dispatcher komutu ilgili aşama işleyicisine yönlendirir
"""
__version__ = "0.1.0"







"""Aşama kaydı. Sıra ve etiketler tek yerden yönetilir."""

ASAMALAR = [
    ("kurulum",            "Kurulum"),
    ("veri_hazirligi",     "Veri hazırlığı"),
    ("sozluk_kontrol",     "Sözlük kontrolü"),
    ("sozluk_sikistirma",  "Sözlük sıkıştırma"),
    ("meta",               "Meta tanımı"),
    ("geleneksel_plan",    "Geleneksel feature planı"),
    ("geleneksel_uretim",  "Geleneksel feature üretimi"),
    ("llm_kesif",          "LLM feature keşfi"),
    ("hesaplama",          "Feature hesaplama"),
    ("kalite",             "Veri kalitesi ve eleme"),
    ("model",              "Model sınaması"),
]
KIMLIKLER = [k for k, _ in ASAMALAR]
ETIKETLER = dict(ASAMALAR)
ATLANAMAZ = {"kurulum", "meta", "kalite", "model"}


def etiket(kimlik: str) -> str:
    """'3/11 · Sözlük kontrolü' biçiminde etiket."""
    return f"{KIMLIKLER.index(kimlik) + 1}/{len(KIMLIKLER)} · {ETIKETLER[kimlik]}"


def sonraki(kimlik: str):
    i = KIMLIKLER.index(kimlik)
    return KIMLIKLER[i + 1] if i + 1 < len(KIMLIKLER) else None


def onceki(kimlik: str):
    i = KIMLIKLER.index(kimlik)
    return KIMLIKLER[i - 1] if i > 0 else None








"""Kullanıcıya dönen metinlerin biçimlendirilmesi.

Dataiku chat markdown tablo çizmediği için hizalı tablolar kod bloğu içinde verilir.
"""


def sayi(n) -> str:
    """10000 → '10.000'"""
    return f"{int(n):,}".replace(",", ".")


def baslik(metin: str) -> str:
    return f"**{metin}**"


def kod(metin: str) -> str:
    return "```\n" + metin.rstrip() + "\n```"


def anahtar_deger(satirlar) -> str:
    """[(anahtar, değer), ...] → hizalı iki sütunlu kod bloğu."""
    genislik = max(len(a) for a, _ in satirlar)
    return kod("\n".join(f"{a.ljust(genislik)}   {d}" for a, d in satirlar))


def tablo(basliklar, satirlar) -> str:
    """Başlık satırı + ayraç + satırlar; kod bloğu içinde."""
    sutun = [max(len(str(x)) for x in col) for col in zip(basliklar, *satirlar)]
    def satir(r):
        return "  ".join(str(x).ljust(w) for x, w in zip(r, sutun)).rstrip()
    ayrac = "  ".join("-" * w for w in sutun)
    return kod("\n".join([satir(basliklar), ayrac] + [satir(r) for r in satirlar]))


def hata(mesaj: str, kullanim: str = None) -> str:
    out = f"Hata: {mesaj}"
    if kullanim:
        out += f"\nKullanım: `{kullanim}`"
    return out


def bolum(*parcalar) -> str:
    """Boş olmayan parçaları boş satırla birleştirir."""
    return "\n\n".join(p for p in parcalar if p)
