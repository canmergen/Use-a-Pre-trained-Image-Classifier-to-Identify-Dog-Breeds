# --- SON GÖZLENEN RENK -> TAKIP_6M (müşteri bazında, dönem kırılımlı) + EXCEL ÇIKTI ---
import io
import numpy as np
import pandas as pd
import dataiku

SADECE_KK = True

# --- ÇIKTI AYARLARI ---
CIKTI_KLASOR = "MODEL_RESULTS"                      # managed folder adı
CIKTI_DOSYA  = "son_renk_takip6m_capraz.xlsx"
KLASORE_YAZ  = True                                 # False -> notebook'un local diskine yazar

_d = df[df['KK_URUN_FLG'] == 'KK'] if SADECE_KK else df

_takip = pd.Series(
    np.where((_d['AKB_GGS_6_90'] == 1) | (_d['AKB_TAKIP_6M'] == 1), 1, 0),
    index=_d.index, name='TAKIP_6M')

# RENK sayısala çevrildiyse metne geri döndür (SONRAKI kolonları hâlâ metin)
_renk0 = _d['RENK'].map(renk_map_ters) if _d['RENK'].dtype != object else _d['RENK']

# En yeniden en eskiye: 5AY, 4AY, 3AY, 2AY, AY, RENK
snk_sirali = [f'RENK_SONRAKI_{k}AY' for k in range(5, 1, -1)] + ['RENK_SONRAKI_AY']
snk_sirali = [c for c in snk_sirali if c in _d.columns]

_yol = pd.concat([_d[snk_sirali], _renk0.rename('RENK')], axis=1)
son_renk = _yol.bfill(axis=1).iloc[:, 0].fillna('(bos)')   # ilk dolu = en son gözlenen renk
son_renk.name = 'SON_GOZLENEN_RENK'                        # Excel'de index başlığı olsun

_sheets = {}          # {donem: (adet_tablosu, yuzde_tablosu)}
_ozet_satirlar = []   # tüm dönemler tek uzun tablo

for _don in sorted(_d['DONEM'].dropna().astype(int).unique()):
    _m = (_d['DONEM'] == _don).to_numpy()

    ct = pd.crosstab(son_renk[_m], _takip[_m], margins=True, margins_name='TOPLAM')
    for c in (0, 1):                       # o dönemde hiç 1 (veya 0) yoksa kolon düşmesin
        if c not in ct.columns:
            ct[c] = 0
    ct = ct[[0, 1, 'TOPLAM']]

    pct = (pd.crosstab(son_renk[_m], _takip[_m], normalize='index') * 100).round(2)
    for c in (0, 1):
        if c not in pct.columns:
            pct[c] = 0.0
    pct = pct[[0, 1]]

    # ekrana basma (eski davranış aynen korunuyor)
    print("=" * 90)
    print(f"DONEM {_don} — son gözlenen renk -> TAKIP_6M"
          + (", sadece KK" if SADECE_KK else ", tüm portföy"))
    print(ct.to_string())
    print("\n--- SATIR % ---")
    print(pct.to_string())

    _sheets[_don] = (ct, pct)

    # özet için uzun format
    for _renk in ct.index:
        if _renk == 'TOPLAM':
            continue
        _t = int(ct.loc[_renk, 'TOPLAM'])
        _ozet_satirlar.append({
            'DONEM': _don,
            'SON_GOZLENEN_RENK': _renk,
            'TAKIP_0': int(ct.loc[_renk, 0]),
            'TAKIP_1': int(ct.loc[_renk, 1]),
            'TOPLAM': _t,
            'TAKIP_ORAN_%': round(ct.loc[_renk, 1] / _t * 100, 2) if _t else np.nan,
        })

ozet = pd.DataFrame(_ozet_satirlar)

# --- EXCEL'E YAZ ---
_buf = io.BytesIO()
with pd.ExcelWriter(_buf, engine='openpyxl') as _w:
    ozet.to_excel(_w, sheet_name='OZET', index=False)

    for _don, (ct, pct) in _sheets.items():
        _sh = f"DONEM_{_don}"
        ct.to_excel(_w,  sheet_name=_sh, startrow=1)
        pct.to_excel(_w, sheet_name=_sh, startrow=len(ct) + 5)

        _ws = _w.sheets[_sh]
        _ws.cell(row=1, column=1,
                 value=f"DONEM {_don} — adet" + (" (sadece KK)" if SADECE_KK else " (tüm portföy)"))
        _ws.cell(row=len(ct) + 5, column=1, value=f"DONEM {_don} — satır %")

_buf.seek(0)

if KLASORE_YAZ:
    mf_out = dataiku.Folder(CIKTI_KLASOR)
    mf_out.upload_stream("/" + CIKTI_DOSYA, _buf)
    print(f"\nYazıldı -> folder '{CIKTI_KLASOR}' /{CIKTI_DOSYA}")
else:
    with open(CIKTI_DOSYA, "wb") as f:
        f.write(_buf.getvalue())
    print(f"\nYazıldı -> {CIKTI_DOSYA}")
