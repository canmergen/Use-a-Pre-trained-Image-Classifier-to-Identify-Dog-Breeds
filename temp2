def _aksiyonu_coz(g):
    ham = g.get(S.AKSIYON)
    if ham is None:
        _logla("UYARI: girdi_al aksiyon gondermedi")
        return Aksiyon.DIGER
    cozulen = AKSIYON_ESLEME.get(str(ham).strip().lower())
    if cozulen is None:
        _logla("UYARI: taninmayan aksiyon {!r}".format(ham))
        return Aksiyon.DIGER
    return cozulen


def _girdiyi_state_e_isle(g):
    """girdi_al ciktisini state'e yazar ve dataset/sozluk adlarini tespit eder.

    Dataset ve sozluk adlari LLM'den DEGIL, mesajin projedeki gercek dataset
    adlariyla eslestirilmesinden gelir. Boylece uydurma ad ihtimali kalmaz.
    """
    state[S.GECERSIZ_AD] = ""
    state[S.SOZLUK_DEGISTI] = False

    state[S.AKSIYON] = _aksiyonu_coz(g)
    mesaj = str(g.get(S.MESAJ) or "").strip()
    state[S.MESAJ] = mesaj

    mevcut_adlar = _proje_dataset_adlari() or set()
    bulunan = _mesajdaki_dataset_adi(mesaj, mevcut_adlar)

    if not bulunan:
        return

    # Bulunan ad veri seti mi sozluk mu? Mevcut degerlerle karsilastir.
    if bulunan == state.get(S.VERI_SETI) or bulunan == state.get(S.SOZLUK):
        return

    kayit = _hafizayi_oku() or {}
    kaynak_sozluk_adi = kayit.get(Sema.SOZLUK_ADI)

    # Sozluk olarak taninan ad: iki kolonlu dataset olma ihtimali yuksek.
    # Karar kullaniciya birakilir; asistan teyit isteyecek.
    if state.get(S.VERI_SETI) and bulunan != state.get(S.VERI_SETI):
        if bulunan == kaynak_sozluk_adi:
            state[S.SOZLUK] = bulunan
            state[S.SOZLUK_DEGISTI] = True
        else:
            # Veri seti zaten var; yeni ad muhtemelen yeni veri seti.
            state[S.VERI_SETI] = bulunan
    else:
        state[S.VERI_SETI] = bulunan

    state[S.DATASET_VAR] = bool(state.get(S.VERI_SETI))
    state[S.SOZLUK_VAR] = bool(state.get(S.SOZLUK))


def _asistan_baglamini_kur():
    """Asistanin gorecegi tum gercekleri duz metin olarak hazirlar.

    Asistan hicbir dosya okumaz; yalnizca bu metni ve sohbet gecmisini gorur.
    Boylece uydurma bilgi uretme ihtimali dusuk kalir.
    """
    kayit = _hafizayi_oku() or {}
    ek_sozluk = _ek_sozlugu_oku()

    sozluk = kayit.get(Sema.SOZLUK) or {}
    kolonlar = kayit.get(Sema.KOLONLAR) or []
    tipler = kayit.get(Sema.TIPLER) or {}
    haric = kayit.get(Sema.HARIC_KOLONLAR) or []
    eksikler = kayit.get(Sema.TABLODA_VAR_SOZLUKTE_YOK) or []

    satirlar = []
    satirlar.append("VERI SETI: {} ({} satir, {} kolon)".format(
        kayit.get(Sema.VERI_SETI) or state.get(S.VERI_SETI) or "belirlenmedi",
        kayit.get(Sema.N_SATIR) or "?",
        kayit.get(Sema.N_KOLON) or "?"))
    satirlar.append("SOZLUK: {} ({} aciklama)".format(
        kayit.get(Sema.SOZLUK_ADI) or "verilmedi", len(sozluk)))

    if eksikler:
        satirlar.append("ACIKLAMASI EKSIK KOLONLAR ({}): {}".format(
            len(eksikler), ", ".join(eksikler[:AZAMI_BAGLAM_KOLON])))
    else:
        satirlar.append("ACIKLAMASI EKSIK KOLON YOK.")

    if ek_sozluk:
        satirlar.append("KULLANICININ EKLEDIGI TANIMLAR:")
        for kolon in sorted(ek_sozluk)[:AZAMI_BAGLAM_KOLON]:
            satirlar.append("  {}: {}".format(kolon, ek_sozluk[kolon]))
    else:
        satirlar.append("KULLANICI HENUZ TANIM EKLEMEDI.")

    if haric:
        satirlar.append("SUREC DISI BIRAKILAN KOLONLAR: {}".format(
            ", ".join(haric)))
    else:
        satirlar.append("SUREC DISI BIRAKILAN KOLON YOK.")

    # Kullanicinin mesajinda gecen kolonlarin mevcut durumu.
    mesaj_kolonlari = _mesajdaki_kolonlar(state.get(S.MESAJ), kolonlar)
    if mesaj_kolonlari:
        satirlar.append("MESAJDA GECEN KOLONLAR:")
        for kolon in mesaj_kolonlari:
            durum = []
            durum.append("tip: {}".format(tipler.get(kolon, "bilinmiyor")))
            if kolon in haric:
                durum.append("SUREC DISI")
            aciklama = ek_sozluk.get(kolon) or sozluk.get(kolon)
            durum.append("aciklama: {}".format(aciklama or "YOK"))
            satirlar.append("  {} ({})".format(kolon, " | ".join(durum)))

    ornekler = str(state.get(S.ORNEK_DEGERLER) or "").strip()
    if ornekler:
        satirlar.append("EKSIK KOLONLARIN ORNEK DEGERLERI:")
        satirlar.append(ornekler)

    bekleyen = state.get(S.BEKLEYEN_ISLEMLER) or []
    if bekleyen:
        satirlar.append("ONAY BEKLEYEN ISLEMLER (henuz uygulanmadi):")
        satirlar.append(json.dumps(bekleyen, ensure_ascii=False))

    state[S.ASISTAN_BAGLAMI] = "\n".join(satirlar)


def _durum_ozetini_kur(asama):
    """girdi_al ve sohbet promptlarina gidecek kisa durum bildirimi."""
    if state.get(S.GECERSIZ_AD):
        ozet = "UYARI: '{}' bir dataset degil.".format(state[S.GECERSIZ_AD])
    elif state.get(S.VERI_SETI):
        ozet = "Veri seti: {vs}. Sozluk: {sz}.".format(
            vs=state[S.VERI_SETI], sz=state.get(S.SOZLUK) or "belirlenmedi")
    elif state.get(S.ONCEKI_BEKLIYOR):
        ozet = ("Kayitli bir oturum bulundu ({}) ve devam karari "
                "bekleniyor.").format(state.get(S.ONCEKI_VERI_SETI))
    elif state.get(S.ONCEKI_REDDEDILDI):
        ozet = "Kullanici kayitli oturumu simdilik kullanmiyor."
    else:
        ozet = "Veri seti henuz belirlenmedi."

    ozet += " BULUNULAN ADIM: {}.".format(ASAMA_ADLARI.get(asama, asama))

    bekleyen = state.get(S.BEKLEYEN_ISLEMLER) or []
    if bekleyen:
        ozet += " {} islem onay bekliyor.".format(len(bekleyen))

    state[S.DURUM_OZETI] = ozet


def _onceki_oturumu_state_e_yaz(kayit):
    """sema.json icerigini onceki_* anahtarlarina tasir."""
    state[S.ONCEKI_VERI_SETI] = kayit.get(Sema.VERI_SETI)
    state[S.ONCEKI_SOZLUK] = kayit.get(Sema.SOZLUK_ADI)
    state[S.ONCEKI_N_SATIR] = kayit.get(Sema.N_SATIR)
    state[S.ONCEKI_N_KOLON] = kayit.get(Sema.N_KOLON)

    sozluk = kayit.get(Sema.SOZLUK)
    sozluk = sozluk if isinstance(sozluk, dict) else {}
    aciklamasiz = kayit.get(Sema.TABLODA_VAR_SOZLUKTE_YOK)
    haric = kayit.get(Sema.HARIC_KOLONLAR)
    state[S.ONCEKI_ACIKLAMASIZ] = aciklamasiz if isinstance(aciklamasiz, list) else []
    state[S.ONCEKI_HARIC] = haric if isinstance(haric, list) else []

    haric_kumesi = set(state[S.ONCEKI_HARIC])
    state[S.ONCEKI_N_ACIKLAMA] = len([k for k in sozluk if k not in haric_kumesi])

    n_kolon = int(kayit.get(Sema.N_KOLON) or 0)
    state[S.ONCEKI_ESLESEN] = max(
        n_kolon - len(state[S.ONCEKI_ACIKLAMASIZ]) - len(haric_kumesi), 0)

    state[S.ONCEKI_BEKLIYOR] = True


def _onceki_oturumu_beklemeden_cikar():
    """Kayit reddedildi: aktif oturumdan cikarilir ama SILINMEZ."""
    for anahtar in ONCEKI_KAYIT_ANAHTARLARI:
        state[anahtar] = None
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = True
    _logla("kayitli oturum reddedildi (dosya korunuyor)")


def _asamayi_ayarla(yeni_asama):
    eski = state.get(S.ASAMA) or Asama.BASLANGIC
    state[S.ASAMA] = yeni_asama
    _logla("asama gecisi: {} -> {}".format(eski, yeni_asama))


def _kayitla_devam_et(veri_seti, sozluk_adi):
    state[S.VERI_SETI] = veri_seti
    state[S.SOZLUK] = sozluk_adi
    state[S.DATASET_VAR] = True
    state[S.SOZLUK_VAR] = bool(sozluk_adi)
    state[S.ONCEKI_BEKLIYOR] = False
    state[S.ONCEKI_REDDEDILDI] = False
    _asamayi_ayarla(Asama.SOZLUK)


# -----------------------------------------------------------------------------
# Ana akis
# -----------------------------------------------------------------------------

def process(trace):
    try:
        ham_girdi, kaynak = _ham_girdiyi_al()
        g = _json_ayristir(ham_girdi)
        _girdiyi_state_e_isle(g)

        aksiyon = state.get(S.AKSIYON)
        asama = state.get(S.ASAMA) or Asama.BASLANGIC
        _durum_ozetini_kur(asama)

        _logla("aksiyon={} beklenen={} asama={} veri={} sozluk={} "
               "bekleyen={} kaynak={}".format(
                   aksiyon, state.get(S.BEKLENEN), asama,
                   state.get(S.VERI_SETI), state.get(S.SOZLUK),
                   len(state.get(S.BEKLEYEN_ISLEMLER) or []), kaynak))

        # --- 1) Ilk tur: karsilama (+ varsa kayit sorusu) ---------------------
        if not state.get(S.KARSILANDI):
            state[S.KARSILANDI] = True
            kayit = _hafizayi_oku()

            if kayit and kayit.get(Sema.VERI_SETI) and not state.get(S.VERI_SETI):
                _onceki_oturumu_state_e_yaz(kayit)
                _durum_ozetini_kur(asama)
                _beklenen_ayarla(Beklenen.KAYIT_KARARI)
                yield "{}\n\n---\n\n{}".format(KARSILAMA, _onceki_kayit_mesaji())
                return

            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield "{}\n\n{}".format(KARSILAMA, BILGI_ISTEGI)
            return

        # --- 2) Onay bekleyen islemler ----------------------------------------
        # HER ISLEM TEYITLIDIR. Onay gelmeden asistan_uygula yazma yapmaz.
        bekleyen = state.get(S.BEKLEYEN_ISLEMLER) or []
        if bekleyen:
            if aksiyon == Aksiyon.ONAY:
                _logla("{} islem onaylandi".format(len(bekleyen)))
                yield NextBlock(Blok.ASISTAN_UYGULA)
                return
            if aksiyon == Aksiyon.RET:
                state[S.BEKLEYEN_ISLEMLER] = []
                _beklenen_ayarla(Beklenen.YOK)
                _logla("bekleyen islemler iptal edildi")
                yield ISLEM_IPTAL
                return
            # Baska bir sey soyledi: asistan listeyi gozden gecirsin.

        # --- 3) Kayit karari bekleniyor ---------------------------------------
        if state.get(S.ONCEKI_BEKLIYOR):
            kayitli_ad = state.get(S.ONCEKI_VERI_SETI)
            adi_tekrarladi = (
                kayitli_ad and state.get(S.VERI_SETI)
                and str(state[S.VERI_SETI]).strip() == str(kayitli_ad).strip())

            if aksiyon == Aksiyon.ONAY or adi_tekrarladi:
                _kayitla_devam_et(kayitli_ad, state.get(S.ONCEKI_SOZLUK))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            if aksiyon == Aksiyon.RET:
                _onceki_oturumu_beklemeden_cikar()
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield SIFIRDAN_BASLA
                return

            # Baska bir dataset adi yazdiysa ona geciyoruz.
            if state.get(S.VERI_SETI) and not adi_tekrarladi:
                _onceki_oturumu_beklemeden_cikar()
                _asamayi_ayarla(Asama.SOZLUK)
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            _beklenen_ayarla(Beklenen.KAYIT_KARARI)
            yield _karar_bekleniyor_mesaji()
            return

        # --- 4) Sozluk degisti: sema yeniden uretilmeli -------------------------
        if state.get(S.SOZLUK_DEGISTI) and state.get(S.VERI_SETI):
            _logla("sozluk degisti, sozluk_calis yeniden calistiriliyor")
            _asamayi_ayarla(Asama.SOZLUK)
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 5) Ret: adimi tekrarlama, ne degisecegini sor ----------------------
        if aksiyon == Aksiyon.RET:
            _beklenen_ayarla(Beklenen.YOK)
            yield _ret_mesaji(asama)
            return

        # --- 6) Adim tekrari (veriyi yeniden oku) ------------------------------
        if aksiyon == Aksiyon.ADIM_TEKRAR:
            if not state.get(S.VERI_SETI):
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield VERI_SETI_GEREKLI
                return
            hedef_blok = ASAMA_TEKRAR_HARITASI.get(asama)
            if hedef_blok:
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(hedef_blok)
                return
            _beklenen_ayarla(Beklenen.YOK)
            yield _tekrar_hazir_degil_mesaji(asama)
            return

        # --- 7) Gecersiz dataset adi ------------------------------------------
        if state.get(S.GECERSIZ_AD):
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield _gecersiz_ad_mesaji(state[S.GECERSIZ_AD])
            return

        # --- 8) Baslangic: veri seti belirlendi --------------------------------
        if asama == Asama.BASLANGIC and state.get(S.DATASET_VAR):
            _asamayi_ayarla(Asama.SOZLUK)
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 9) Adim icinde onay: SONRAKI adima gecis --------------------------
        if aksiyon == Aksiyon.ONAY and asama in ASAMA_HARITASI:
            hedef_blok = ASAMA_HARITASI[asama]
            if hedef_blok:
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(hedef_blok)
                return
            _beklenen_ayarla(Beklenen.YOK)
            yield _adim_hazir_degil_mesaji(asama)
            return

        # --- 10) Diger her sey: adimin asistani ---------------------------------
        # Kullanicinin ifade cesitliligi burada degil, asistanda cozulur.
        if not state.get(S.VERI_SETI):
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield VERI_SETI_GEREKLI
            return

        asistan = ASAMA_ASISTANLARI.get(asama)
        if not asistan:
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield _asistan_yok_mesaji(asama)
            return

        _asistan_baglamini_kur()
        _logla("{} bloguna yonlendiriliyor".format(asistan))
        yield NextBlock(asistan)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        _beklenen_ayarla(Beklenen.VERI_SETI)
        yield BEKLENMEYEN_HATA






























# =============================================================================
# FEATURE_DISCOVERY_AGENT / sozluk_tamamla
# -----------------------------------------------------------------------------
# Aciklamasi olmayan kolonlari ornek degerleriyle raporlar ve bu bilgiyi
# asistanin kullanmasi icin state'e yazar.
#
# Artik oneri uretmez; oneri isi sozluk_asistani'na tasindi. Bu blok yalnizca
# GERCEKLERI toplar ve sunar.
#
# ORNEK DEGER OKUMA: yalnizca eksik kolonlar okunur. Satir sayisi esigin
# altindaysa TAMAMI okunur; ustundeyse rastgele ornekleme yapilir. Bas
# kisimdan okuma kullanilmaz; veri sirali oldugunda yaniltici olur.
# =============================================================================

import json

import dataiku


HAFIZA_FOLDER = "PROJE_HAFIZASI"
SEMA_DOSYASI = "/sema.json"
EK_SOZLUK_DOSYASI = "/sozluk_ek.json"

ASAMA_SOZLUK = "sozluk"

AZAMI_LISTELENEN = 15
AZAMI_ORNEK_DEGER = 10
TAM_OKUMA_SATIR_ESIGI = 2000000
ORNEKLEM_SATIR = 100000
AZAMI_DEGER_UZUNLUGU = 30


class Sema:
    VERI_SETI = "veri_seti"
    N_SATIR = "n_satir"
    KOLONLAR = "kolonlar"
    TIPLER = "tipler"
    SOZLUK = "sozluk"
    TABLODA_VAR_SOZLUKTE_YOK = "tabloda_var_sozlukte_yok"
    HARIC_KOLONLAR = "haric_kolonlar"


class S:
    ASAMA = "asama"
    BEKLENEN = "beklenen"
    VERI_SETI = "veri_seti"
    ORNEK_DEGERLER = "ornek_degerler_metni"


class Beklenen:
    ADIM_ONAYI = "adim_onayi"


def _logla(mesaj):
    print("[sozluk_tamamla] {}".format(mesaj))


def _json_oku(dosya_yolu, varsayilan):
    try:
        folder = dataiku.Folder(HAFIZA_FOLDER)
        if dosya_yolu not in folder.list_paths_in_partition():
            return varsayilan
        with folder.get_download_stream(dosya_yolu) as akis:
            return json.loads(akis.read().decode("utf-8"))
    except Exception as hata:
        _logla("{} okunamadi: {}".format(dosya_yolu, hata))
        return varsayilan


def _sayi(deger):
    return "{:,}".format(int(deger or 0)).replace(",", ".")


def _eksikleri_bul(sema, ek_sozluk):
    """Aciklamasi olmayan ve surec disi BIRAKILMAMIS kolonlar."""
    sozluk = sema.get(Sema.SOZLUK)
    sozluk = sozluk if isinstance(sozluk, dict) else {}
    tablo = sema.get(Sema.KOLONLAR)
    tablo = tablo if isinstance(tablo, list) else []
    haric = sema.get(Sema.HARIC_KOLONLAR)
    haric = set(haric) if isinstance(haric, list) else set()

    def _tanimli_mi(kolon):
        if kolon in ek_sozluk and str(ek_sozluk[kolon]).strip():
            return True
        aciklama = sozluk.get(kolon)
        return aciklama is not None and bool(str(aciklama).strip())

    eksikler = [k for k in tablo if k not in haric and not _tanimli_mi(k)]
    return eksikler, sorted(haric)


def _degeri_kisalt(deger):
    metin = str(deger).strip()
    if len(metin) > AZAMI_DEGER_UZUNLUGU:
        return metin[:AZAMI_DEGER_UZUNLUGU] + "..."
    return metin


def _veriyi_oku(veri_seti_adi, kolonlar, n_satir):
    """Doner: (dataframe veya None, ornekleme_yapildi_mi)"""
    dataset = dataiku.Dataset(veri_seti_adi)
    kolon_listesi = list(kolonlar)
    buyuk = bool(n_satir) and int(n_satir) > TAM_OKUMA_SATIR_ESIGI

    if not buyuk:
        try:
            df = dataset.get_dataframe(columns=kolon_listesi)
            _logla("tam okuma: {} kolon, {} satir".format(
                len(kolon_listesi), len(df)))
            return df, False
        except Exception as hata:
            _logla("tam okuma basarisiz: {}".format(hata))

    try:
        df = dataset.get_dataframe(
            columns=kolon_listesi, sampling="random", limit=ORNEKLEM_SATIR)
        return df, True
    except Exception as hata:
        _logla("rastgele ornekleme basarisiz: {}".format(hata))

    try:
        return dataset.get_dataframe(
            columns=kolon_listesi, limit=ORNEKLEM_SATIR), True
    except Exception as hata:
        _logla("ornek degerler okunamadi: {}".format(hata))
        return None, False


def _ornek_degerleri_cikar(df, kolonlar):
    if df is None:
        return {}
    sonuc = {}
    for kolon in kolonlar:
        if kolon not in df.columns:
            continue
        try:
            seri = df[kolon].dropna()
            farkli = seri.unique()
            sonuc[kolon] = (len(farkli),
                            [_degeri_kisalt(d) for d in farkli[:AZAMI_ORNEK_DEGER]])
        except Exception as hata:
            _logla("{} ozetlenemedi: {}".format(kolon, hata))
    return sonuc


def _kolon_blogu(kolon, tipler, ornekler, orneklem_mi):
    tip = tipler.get(kolon)
    baslik = "**{}**".format(kolon)
    if tip:
        baslik += " ({})".format(tip)

    if kolon not in ornekler:
        return baslik

    farkli_sayi, degerler = ornekler[kolon]
    if not degerler:
        return baslik + " — tamamı boş"

    if orneklem_mi:
        baslik += " — örneklemde {} farklı değer".format(_sayi(farkli_sayi))
    else:
        baslik += " — {} farklı değer".format(_sayi(farkli_sayi))

    listelenen = ", ".join("`{}`".format(d) for d in degerler)
    if farkli_sayi > len(degerler):
        listelenen += ", ..."
    return "{}\n{}".format(baslik, listelenen)


def _baglam_metni(kolonlar, tipler, ornekler):
    """Asistanin gorecegi duz metin ornek deger ozeti."""
    satirlar = []
    for kolon in kolonlar:
        parca = "  {} | tip: {}".format(kolon, tipler.get(kolon, "bilinmiyor"))
        if kolon in ornekler:
            farkli_sayi, degerler = ornekler[kolon]
            parca += " | farkli deger: {}".format(farkli_sayi)
            parca += (" | ornekler: {}".format(", ".join(degerler))
                      if degerler else " | tamami bos")
        satirlar.append(parca)
    return "\n".join(satirlar)


def process(trace):
    try:
        if state.get(S.ASAMA) != ASAMA_SOZLUK:
            _logla("asama '{}', sessizce cikiliyor".format(state.get(S.ASAMA)))
            return

        sema = _json_oku(SEMA_DOSYASI, {})
        if not isinstance(sema, dict) or not sema:
            yield "\n\nSözlük durumunu çıkaramadım; oturum kaydı okunamıyor."
            return

        ek_sozluk = _json_oku(EK_SOZLUK_DOSYASI, {})
        ek_sozluk = ek_sozluk if isinstance(ek_sozluk, dict) else {}

        tipler = sema.get(Sema.TIPLER)
        tipler = tipler if isinstance(tipler, dict) else {}

        eksikler, haric = _eksikleri_bul(sema, ek_sozluk)
        _logla("eksik={} haric={}".format(len(eksikler), len(haric)))

        state[S.BEKLENEN] = Beklenen.ADIM_ONAYI

        if not eksikler:
            state[S.ORNEK_DEGERLER] = ""
            yield ("\n\nAçıklaması eksik kolon kalmadı.\n\n"
                   "Bir açıklamayı değiştirmek, bir kolonu çıkarmak veya geri "
                   "almak isterseniz söyleyin. Değişiklik yoksa sözlük "
                   "sıkıştırmaya geçebiliriz.")
            return

        listelenecek = eksikler[:AZAMI_LISTELENEN]
        veri_seti_adi = state.get(S.VERI_SETI) or sema.get(Sema.VERI_SETI)

        ornekler = {}
        orneklem_mi = False
        if veri_seti_adi:
            df, orneklem_mi = _veriyi_oku(
                veri_seti_adi, listelenecek, sema.get(Sema.N_SATIR))
            ornekler = _ornek_degerleri_cikar(df, listelenecek)

        # Asistanin kullanacagi baglam.
        state[S.ORNEK_DEGERLER] = _baglam_metni(listelenecek, tipler, ornekler)

        parcalar = []
        if len(eksikler) == 1:
            parcalar.append("Bir kolonun açıklaması yok:")
        else:
            parcalar.append("{} kolonun açıklaması yok:".format(
                _sayi(len(eksikler))))
        parcalar.append("")

        for kolon in listelenecek:
            parcalar.append(_kolon_blogu(kolon, tipler, ornekler, orneklem_mi))
            parcalar.append("")

        kalan = len(eksikler) - AZAMI_LISTELENEN
        if kalan > 0:
            parcalar.append("_ve {} kolon daha._".format(_sayi(kalan)))
            parcalar.append("")

        if orneklem_mi:
            parcalar.append("_Değerler {} satırlık rastgele örneklemden._".format(
                _sayi(ORNEKLEM_SATIR)))
            parcalar.append("")

        parcalar.append("Bu kolonlar için öneri isteyebilir, kendi "
                        "açıklamanızı yazabilir veya gereksiz gördüklerinizi "
                        "çıkarmamı isteyebilirsiniz.")

        # Bastaki bos satir onceki blogun mesajiyla yapismayi onler.
        yield "\n\n" + "\n".join(parcalar)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        yield "\n\nSözlük durumunu çıkarırken beklenmeyen bir hata oluştu."
