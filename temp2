        bloklar=[(b[0], b[1]) for b in durum["kod_bloklari"]])
    _folder().upload_stream("/uretim_kodu.py", script.encode("utf-8"))

    hata_not = ("\n%s" % _liste("Hesaplanamayanlar:",
                                ["%s — %s" % h for h in hatali], 5)) if hatali else ""

    return ("%s hipotez üretildi ve %s veri setine yazıldı.%s\n\n"
