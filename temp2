def _girdiyi_state_e_isle(g):
    """girdi_al ciktisini dogrulayarak state'e yazar.

    ONEMLI: Yalnizca DOLU degerler yazilir. girdi_al bazen alanlari bos
    string donduruyor; "is not None" kontrolu bunu gecirir ve state'teki
    gecerli deger (ornegin sozluk adi) silinir. Bos string, "bilgi yok"
    demektir, "bilgiyi sil" demek degildir.
    """
    state[S.GECERSIZ_AD] = ""
    state[S.SOZLUK_DEGISTI] = False

    aday = g.get(G.VERI_SETI)
    if aday and str(aday).strip():
        if _dataset_gecerli_mi(aday):
            state[S.VERI_SETI] = str(aday).strip()
        else:
            state[S.GECERSIZ_AD] = str(aday).strip()
            _logla("gecersiz dataset adi reddedildi: {}".format(aday))

    # Sozluk adi degisirse sema.json yeniden uretilmeli; bunu isaretle.
    sozluk_adayi = g.get(G.SOZLUK)
    if sozluk_adayi and str(sozluk_adayi).strip():
        yeni_sozluk = str(sozluk_adayi).strip()
        eski_sozluk = str(state.get(S.SOZLUK) or "").strip()
        if yeni_sozluk != eski_sozluk:
            state[S.SOZLUK_DEGISTI] = True
            _logla("sozluk degisti: {} -> {}".format(
                eski_sozluk or "yok", yeni_sozluk))
        state[S.SOZLUK] = yeni_sozluk

    for girdi_alan, state_alan in (
        (G.TARGET, S.TARGET),
        (G.ID_KOLONU, S.ID_KOLONU),
        (G.DONEM_KOLONU, S.DONEM_KOLONU),
        (G.BOLME_KOLONU, S.BOLME_KOLONU),
    ):
        deger = g.get(girdi_alan)
        if deger and str(deger).strip():
            state[state_alan] = str(deger).strip()

    # Tura ozel alanlar: her turda tazelenir, onceki turdan sizmaz.
    state[S.AKSIYON] = _aksiyonu_coz(g)
    state[S.KOLONLAR] = _liste_yap(g.get(G.KOLONLAR))
    state[S.KOLON_ACIKLAMASI] = g.get(G.KOLON_ACIKLAMASI) or ""
    state[S.DUZELTMELER] = _liste_yap(g.get(G.DUZELTMELER))
    state[S.CIKARILACAK] = _liste_yap(g.get(G.CIKARILACAK))

    state[S.DATASET_VAR] = bool(state.get(S.VERI_SETI))
    state[S.SOZLUK_VAR] = bool(state.get(S.SOZLUK))











def process(trace):
    try:
        ham_girdi, kaynak = _ham_girdiyi_al()
        g = _json_ayristir(ham_girdi)
        _girdiyi_state_e_isle(g)

        aksiyon = state.get(S.AKSIYON)
        asama = state.get(S.ASAMA) or Asama.BASLANGIC
        _durum_ozetini_kur(asama)

        _logla("aksiyon={} beklenen={} sozluk={} sozluk_degisti={} "
               "kolonlar={} cikar={} kaynak={}".format(
                   aksiyon, state.get(S.BEKLENEN), state.get(S.SOZLUK),
                   state.get(S.SOZLUK_DEGISTI), state.get(S.KOLONLAR),
                   state.get(S.CIKARILACAK), kaynak))

        if aksiyon == Aksiyon.BILGI:
            _logla("TESHIS - ham cikti: {!r}".format(str(ham_girdi)[:400]))
            _logla("TESHIS - anahtarlar: {}".format(
                sorted(g.keys()) if g else "BOS"))

        # --- 1) Ilk tur: karsilama (+ varsa kayit sorusu) ---------------------
        if not state.get(S.KARSILANDI):
            state[S.KARSILANDI] = True
            kayit = _hafizayi_oku()

            if kayit and kayit.get(Sema.VERI_SETI) and not state.get(S.VERI_SETI):
                _onceki_oturumu_state_e_yaz(kayit)
                _durum_ozetini_kur(asama)
                _beklenen_ayarla(Beklenen.KAYIT_KARARI)
                yield "{}\n\n---\n\n{}".format(KARSILAMA, _onceki_kayit_mesaji())
                return

            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield "{}\n\n{}".format(KARSILAMA, BILGI_ISTEGI)
            return

        # --- 2) Kayit karari bekleniyor ---------------------------------------
        # RET ACIK OLMALIDIR: yalnizca kayit_yeni reddedilir.
        if state.get(S.ONCEKI_BEKLIYOR):
            if aksiyon == Aksiyon.KAYIT_YENI:
                _onceki_oturumu_beklemeden_cikar()
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield SIFIRDAN_BASLA
                return

            kayitli_ad = state.get(S.ONCEKI_VERI_SETI)
            adi_tekrarladi = (
                kayitli_ad and state.get(S.VERI_SETI)
                and str(state[S.VERI_SETI]).strip() == str(kayitli_ad).strip())

            if aksiyon in (Aksiyon.KAYIT_DEVAM, Aksiyon.ONAY) or adi_tekrarladi:
                _kayitla_devam_et(kayitli_ad, state.get(S.ONCEKI_SOZLUK))
                if state.get(S.KOLONLAR):
                    _beklenen_ayarla(Beklenen.KOLON_ACIKLAMASI)
                    if state.get(S.KOLON_ACIKLAMASI) or state.get(S.CIKARILACAK):
                        yield NextBlock(Blok.KOLON_SORGU)
                        return
                    yield NextBlock(Blok.SOHBET)
                    return
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            # Kullanici BASKA bir dataset adi yazdiysa ona geciyoruz.
            if state.get(S.VERI_SETI):
                _onceki_oturumu_beklemeden_cikar()
                _asamayi_ayarla(Asama.SOZLUK)
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(Blok.SOZLUK_CALIS)
                return

            _beklenen_ayarla(Beklenen.KAYIT_KARARI)
            if _kolon_talebi_var_mi():
                yield NextBlock(Blok.KOLON_SORGU)
                return
            yield _karar_bekleniyor_mesaji()
            return

        # --- 3) Kayitli oturuma geri donus ------------------------------------
        if not state.get(S.VERI_SETI) and aksiyon == Aksiyon.KAYIT_DEVAM:
            kayit = _hafizayi_oku()
            if kayit and kayit.get(Sema.VERI_SETI):
                _kayitla_devam_et(kayit.get(Sema.VERI_SETI),
                                  kayit.get(Sema.SOZLUK_ADI))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield _kayit_geri_alindi_mesaji(
                    state[S.VERI_SETI], state.get(S.SOZLUK))
                yield NextBlock(Blok.SOZLUK_CALIS)
                return
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield KAYIT_BULUNAMADI
            return

        # --- 4) Sozluk degisti: sema yeniden uretilmeli -------------------------
        # DETERMINISTIK OLMALI: sohbete duserse LLM "sozluk yuklendi" deyip
        # gerceklesmeyen bir is vaat ediyor.
        if state.get(S.SOZLUK_DEGISTI) and state.get(S.VERI_SETI):
            _logla("sozluk degisti, sozluk_calis yeniden calistiriliyor")
            _asamayi_ayarla(Asama.SOZLUK)
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 5) Adim tekrari ---------------------------------------------------
        # Ayni sekilde deterministik; LLM adim sifirlama vaat edemez.
        if aksiyon == Aksiyon.ADIM_TEKRAR:
            if not state.get(S.VERI_SETI):
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield KOLON_ICIN_VERI_GEREKLI
                return
            hedef_blok = ASAMA_TEKRAR_HARITASI.get(asama)
            if hedef_blok:
                _logla("adim tekrari: {} -> {}".format(asama, hedef_blok))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(hedef_blok)
                return
            _beklenen_ayarla(Beklenen.YOK)
            yield _tekrar_hazir_degil_mesaji(asama)
            return

        # --- 6) Oneri onayi bekleniyor ----------------------------------------
        if state.get(S.BEKLENEN) == Beklenen.ONERI_ONAYI and aksiyon == Aksiyon.ONAY:
            _logla("oneriler onaylandi, oneri_isle bloguna gidiliyor")
            yield NextBlock(Blok.ONERI_ISLE)
            return

        # --- 7) Kolon islemi ---------------------------------------------------
        # Onaydan ONCE: kullanici kolon sorarken surec ilerlemez.
        if _kolon_talebi_var_mi() or (
                aksiyon == Aksiyon.GORUS_ISTE and state.get(S.KOLONLAR)):
            if not state.get(S.VERI_SETI):
                _beklenen_ayarla(Beklenen.VERI_SETI)
                yield KOLON_ICIN_VERI_GEREKLI
                return
            _beklenen_ayarla(Beklenen.KOLON_ACIKLAMASI)
            if (aksiyon == Aksiyon.GORUS_ISTE
                    and not state.get(S.KOLON_ACIKLAMASI)
                    and not state.get(S.CIKARILACAK)):
                yield NextBlock(Blok.SOHBET)
                return
            yield NextBlock(Blok.KOLON_SORGU)
            return

        # --- 8) Gecersiz dataset adi ------------------------------------------
        if state.get(S.GECERSIZ_AD):
            _beklenen_ayarla(Beklenen.VERI_SETI)
            yield _gecersiz_ad_mesaji(state[S.GECERSIZ_AD])
            return

        # --- 9) Baslangic: veri seti belirlendi --------------------------------
        if asama == Asama.BASLANGIC and state.get(S.DATASET_VAR):
            _asamayi_ayarla(Asama.SOZLUK)
            _beklenen_ayarla(Beklenen.ADIM_ONAYI)
            yield NextBlock(Blok.SOZLUK_CALIS)
            return

        # --- 10) Adim icinde onay: SONRAKI adima gecis -------------------------
        if aksiyon == Aksiyon.ONAY and asama in ASAMA_HARITASI:
            hedef_blok = ASAMA_HARITASI[asama]
            if hedef_blok:
                _logla("onay alindi, {} bloguna gidiliyor".format(hedef_blok))
                _beklenen_ayarla(Beklenen.ADIM_ONAYI)
                yield NextBlock(hedef_blok)
                return
            _logla("onay alindi ama '{}' adiminin blogu kurulmamis".format(asama))
            _beklenen_ayarla(Beklenen.YOK)
            yield _adim_hazir_degil_mesaji(asama)
            return

        # --- 11) Diger her sey: serbest sohbet ---------------------------------
        _beklenen_ayarla(Beklenen.YOK)
        yield NextBlock(Blok.SOHBET)

    except Exception as hata:
        _logla("BEKLENMEYEN HATA: {}: {}".format(type(hata).__name__, hata))
        _beklenen_ayarla(Beklenen.VERI_SETI)
        yield BEKLENMEYEN_HATA
