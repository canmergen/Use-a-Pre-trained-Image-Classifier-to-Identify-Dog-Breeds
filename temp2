import os
import unicodedata
import traceback

import dataiku
from flask import request, jsonify, Response

from fe_agent import akis

GORSEL_FOLDER = "LLM_WEBAPP_GORSEL"

# Mantiksal ad -> folder'daki gercek dosya adi.
# Gorsel degistirmek istersen SADECE burayi duzenle, JS'e dokunma.
GORSELLER = {
    "banner": "akbank_robot_llm_ust.png",
    "bot":    "akbank_robot_llm_chat.png",
    "user":   "akbank_robot_llm_person.png",
}

_MIME = {".png": "image/png", ".jpg": "image/jpeg",
         ".jpeg": "image/jpeg", ".webp": "image/webp"}

_dosya_haritasi = None


def _sadelestir(ad):
    """Unicode normalizasyon farkini (NFC/NFD) ve buyuk-kucuk harfi eler."""
    return unicodedata.normalize("NFC", (ad or "")).casefold()


def _haritayi_kur(zorla=False):
    global _dosya_haritasi
    if _dosya_haritasi is not None and not zorla:
        return _dosya_haritasi
    harita = {}
    try:
        for yol in dataiku.Folder(GORSEL_FOLDER).list_paths_in_partition():
            harita[_sadelestir(os.path.basename(yol))] = yol
    except Exception:
        harita = {}
    _dosya_haritasi = harita
    return harita


def _dosya_bul(ad):
    anahtar = _sadelestir(os.path.basename(ad))
    harita = _haritayi_kur()
    if anahtar in harita:
        return harita[anahtar]
    return _haritayi_kur(zorla=True).get(anahtar)


@app.route("/gorsel/<anahtar>")
def gorsel(anahtar):
    dosya_adi = GORSELLER.get(anahtar)
    if not dosya_adi:
        return Response("tanimsiz gorsel", status=404)
    uzanti = os.path.splitext(dosya_adi)[1].lower()
    if uzanti not in _MIME:
        return Response("gecersiz uzanti", status=404)
    yol = _dosya_bul(dosya_adi)
    if not yol:
        return Response("folder'da bulunamadi: %s" % dosya_adi, status=404)
    try:
        with dataiku.Folder(GORSEL_FOLDER).get_download_stream(yol) as s:
            veri = s.read()
    except Exception as e:
        return Response("okuma hatasi: %s" % e, status=500)
    return Response(veri, mimetype=_MIME[uzanti],
                    headers={"Cache-Control": "public, max-age=86400"})


@app.route("/datasetler")
def datasetler():
    """Projedeki tum dataset adlari — kullanici elle yazmak zorunda kalmasin."""
    try:
        proje = dataiku.api_client().get_default_project()
        adlar = sorted(d["name"] for d in proje.list_datasets())
        return jsonify({"datasetler": adlar})
    except Exception as e:
        return jsonify({"datasetler": [], "hata": str(e)})


@app.route("/adimlar")
def adimlar():
    """Sol paneldeki is akisi. Tek kaynak akis.py."""
    return jsonify({
        "adimlar": [{"anahtar": a,
                     "baslik": akis.ADIMLAR[a]["baslik"],
                     "aciklama": akis.ADIMLAR[a].get("aciklama", "")}
                    for a in akis.ADIM_SIRASI]
    })


@app.route("/karsilama")
def karsilama():
    return jsonify({"metin": akis.KARSILAMA})


@app.route("/mesaj", methods=["POST"])
def mesaj():
    try:
        govde = request.get_json(force=True) or {}
        oturum_id = govde.get("oturum_id") or "varsayilan"

        durum = akis.durum_yukle(oturum_id)
        cevap = akis.mesaj_isle(durum, govde.get("mesaj", ""))
        akis.durum_kaydet(oturum_id, durum)

        return jsonify({
            "cevap": cevap,
            "adim": akis.ADIM_SIRASI[durum["i"]],
            "adim_no": durum["i"],
            "toplam": len(akis.ADIM_SIRASI),
            "ozet": akis.ozet(durum),
        })
    except Exception as e:
        # Hatayi sohbet balonunda gosteriyoruz; aksi halde JS'te sessiz kalir.
        return jsonify({
            "cevap": "HATA: %s\n\n%s" % (e, traceback.format_exc()[-1000:])
        }), 200


@app.route("/sifirla", methods=["POST"])
def sifirla():
    govde = request.get_json(force=True) or {}
    oturum_id = govde.get("oturum_id") or "varsayilan"
    durum = akis.yeni_durum()
    akis.durum_kaydet(oturum_id, durum)
    return jsonify({"metin": akis.KARSILAMA, "ozet": akis.ozet(durum)})
