def _sema(dataset: str):
    """Dataset adını harf duyarsız çözer; (kolon_listesi, tip_sozlugu, gercek_ad) veya None."""
    try:
        proje = dataiku.api_client().get_default_project()
        adlar = {d["name"].lower(): d["name"] for d in proje.list_datasets()}
        gercek = adlar.get(dataset.lower())
        if gercek is None:
            return None
        sema = dataiku.Dataset(gercek).read_schema()
        return [c["name"] for c in sema], {c["name"]: c["type"] for c in sema}, gercek
    except Exception:
        return None
