def metric_tipi(m: str) -> str:
    if m.endswith("RATIO"):
        return "ORAN"
    if m.endswith("SHR"):
        return "PAY"
    if m in ("TMSNCFRST", "TMSNCLST"):
        return "SÜRE"
    return "değer"

lines = ["# Veri Sözlüğü (Compact) — DEGISKENLER", ""]

lines.append("## ÖZEL KOLONLAR (birebir)")
for sm_id, desc in specials:
    lines.append(f"- `{sm_id}`: {desc}")

lines += ["", "## KISALTMA LEJANTI"]
for k, v in ABBREVIATION_LEGEND.items():
    lines.append(f"- `{k}`: {v}")

lines += ["", "## KOLON AİLELERİ",
          "(Tam kolon adı = AİLE + '_' + metrik. Anlamlar lejanttadır; "
          "'ARASI/ORAN' ayrımı için ND_MD kuralına bak.)"]
for fam in sorted(families):
    gruplar = {}
    for m, _ in families[fam]:
        gruplar.setdefault(metric_tipi(m), set()).add(m)
    parcalar = [f"{tip}:[{'|'.join(sorted(ms))}]"
                for tip, ms in sorted(gruplar.items())]
    lines.append(f"- `{fam}` → {' | '.join(parcalar)}")

compact_text = "\n".join(lines)
print(f"Compact: {len(compact_text)} karakter (~{len(compact_text)//3} token), "
      f"{len(families)} aile + {len(specials)} özel kolon")

out = pd.DataFrame({"part": ["compact_dictionary"], "text": [compact_text]})
