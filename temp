                                  'best_params': best_params}

    # 6) train + val + OOT skorla → tek uzun tabloya ekle
    for donem_tipi, frame, donem_val in [('TRAIN', train, TRAIN_DONEM),
                                         ('VAL',   val,   TRAIN_DONEM),
                                         ('OOT',   oot,   OOT_DONEM)]:
        if frame.empty:
            continue
        prob = model.predict_proba(frame[FEATURES])[:, 1]
        ham  = df_eng_r.loc[frame.index]
        _n   = len(frame)
        # dtype'lar bilinçli: category + küçük tamsayı. Değerler ve CSV
        # çıktısı birebir aynı, bellek 4.8x düşüyor.
        out = pd.DataFrame({
            'renk_kod':   np.full(_n, RENK_KOD, dtype='int16'),
            'renk_adi':   pd.Categorical([renk_adi]   * _n),
            'donem_tipi': pd.Categorical([donem_tipi] * _n),
            'donem':      np.full(_n, donem_val, dtype='int32'),
            'SKOR':       prob,                                    # float64 kalıyor
            'TARGET':     frame[TARGET].to_numpy(dtype='int8'),
            'limit':      ham[LIMIT_COL].values if LIMIT_COL in ham else np.nan,
            'risk':       ham[RISK_COL].values  if RISK_COL  in ham else np.nan,
        }, index=frame.index)
        if ID_COL in ham:
            out['musteri_id'] = ham[ID_COL].values
        scored_parts.append(out)

    # Hızlı kontrol: TRAIN in-sample olduğu için gini'si VAL'den yüksek
    # çıkar; aradaki fark aşırı öğrenmenin doğrudan göstergesi.
    try:
        _g = lambda f: 2 * roc_auc_score(f[TARGET], model.predict_proba(f[FEATURES])[:, 1]) - 1
        print(f"    train_gini={_g(train):.4f}  val_gini={_g(val):.4f}  "
              f"oot_gini={_g(oot):.4f}")
    except Exception:
        pass

    del df_eng_r, df_r, train_full, train, val, oot, X_tr, y_tr
    print(f"  ✓ {etiket} skorlandı (train+val+oot)")

scored = pd.concat(scored_parts, ignore_index=True)
