llm = dataiku.api_client().get_default_project().get_llm(LLM_ID)

def llm_sor(prompt_text):
    comp = llm.new_completion()
    comp.with_message(prompt_text)
    return comp.execute().text

def json_parse(cevap):
    """LLM cevabından JSON çıkarır; fence'leri soyar. Bozuksa None."""
    t = cevap.strip()
    t = re.sub(r"^```(json)?", "", t).strip()
    t = re.sub(r"```$", "", t).strip()
    m = re.search(r"\{.*\}", t, re.S)
    if not m:
        return None
    try:
        return json.loads(m.group(0))
    except Exception:
        return None

def sonraki_feature_no():
    mevcut = [int(re.match(r"LLM_F(\d+)", k["ad"]).group(1)) for k in registry]
    return (max(mevcut) + 1) if mevcut else 1

def red_kaydi(tur, tema, neden, oneri=None, ist=None):
    """Red'i hem koşu listesine hem kalıcı red_registry'ye ekler (yasak listesi görsün)."""
    r = {"tur": tur, "tema": tema, "neden": neden, "tarih": time.strftime("%Y-%m-%d %H:%M")}
    if oneri:
        r.update({"ad_soneki": oneri.get("ad_soneki", "?"), "gerekce": oneri.get("gerekce", ""),
                  "kolonlar": oneri.get("kullanilan_kolonlar", []), "formul": oneri.get("formul", "")})
    if ist:
        r["istatistikler"] = ist
    kosu_red.append(r)
    red_registry.append(r)

kosu_kabul, kosu_red = [], []
