# ============================================================
# RENK BAZLI — BUCKET x (3M KIRMIZI) x (6M TAKİP) ÇAPRAZLAMA
# ============================================================
#
# ------------------------------------------------------------------
# NE YAPIYOR?
#
# Modeller TARGET = "ilk 3 ayda kırmızıya geçti mi" üzerine kuruldu.
# Bu blok, aynı skorun ASIL İŞ SONUCUNU (6 ay sonra takibe düşme,
# AKB_TAKIP_6M) ne kadar sıraladığını gösteriyor.
#
# Her renk için OOT bucket'larında (1 = en riskli) şunlar üretiliyor:
#
#   A) 2x2 MATRİS hücreleri — her bucket'ta dört grup:
#        k1t1 : kırmızıya geçti  VE takibe düştü      → modelin asıl hedefi
#        k1t0 : kırmızıya geçti  ama takibe düşmedi   → yanlış alarm (3M doğru, 6M boş)
#        k0t1 : kırmızıya geçmedi ama takibe düştü    → MODELİN KAÇIRDIĞI (kritik)
#        k0t0 : ikisi de yok                          → temiz
#
#   B) ORANLAR:
#        takip_rate      = takibe düşme oranı (bucket içinde)
#        takip_lift      = bucket takip oranı / OOT geneli takip oranı
#        takip_capture   = en riskliden kümülatif takip yakalama
#        p_takip_k1      = P(takip | kırmızıya geçmiş)   ← 3M sinyali 6M'a taşıyor mu
#        p_takip_k0      = P(takip | geçmemiş)           ← kaçırılanların yoğunluğu
#
#   C) ÖZET satırı: modelin 3M için capture'ı ile 6M için capture'ı
#      yan yana. İkisi yakınsa skor doğrudan takip riskini de sıralıyor
#      demektir; 6M capture belirgin düşükse 3M kırmızı, takip için
#      zayıf bir vekil (proxy) demektir ve bu iş tarafına söylenmeli.
#
# VERİ KAYNAĞI: skorlar secilen_modeller'den (yeniden hesap YOK),
# AKB_TAKIP_6M ham df'ten oot_index ile çekiliyor.
# ------------------------------------------------------------------

from io import BytesIO
import numpy as np
import pandas as pd

MODEL_RENKLER = [1, 2, 3, 4, 5, 6]
folder = dataiku.Folder(FOLDER)

TAKIP_COL   = 'AKB_TAKIP_6M'     # 1/0 — 6 ay sonra takibe düştü mü
N_BUCKET    = 20
CAPTURE_PCT = 0.10


def _excel_yaz_coklu(fname, tablolar, ozet_df):
    buf = BytesIO()
    with pd.ExcelWriter(buf, engine='openpyxl') as xl:
        ozet_df.to_excel(xl, sheet_name='OZET', index=False)
        for ad, g in tablolar.items():
            g.to_excel(xl, sheet_name=str(ad)[:31], index=False)
        if tablolar:
            pd.concat(tablolar.values(), ignore_index=True) \
              .to_excel(xl, sheet_name='TUM', index=False)
    buf.seek(0)
    folder.upload_stream(fname, buf)


def _capture(y, prob, pct):
    y = np.asarray(y); n = len(y); tot = y.sum()
    if tot <= 0 or n == 0:
        return np.nan
    k   = max(1, int(pct * n))
    top = np.argpartition(-np.asarray(prob), min(k, n - 1))[:k] if n > 1 else np.array([0])
    return float(y[top].sum() / tot)


if 'secilen_modeller' not in globals() or not secilen_modeller:
    raise RuntimeError("secilen_modeller yok — önce skorlama bloğunu çalıştırın.")
if TAKIP_COL not in df.columns:
    raise RuntimeError(f"{TAKIP_COL} ham veride yok.")

tablolar, ozet_satirlari = {}, []

for RENK_KOD in MODEL_RENKLER:
    renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
    etiket   = f"{RENK_KOD}-{renk_adi}"
    _s = secilen_modeller.get(RENK_KOD, {})
    if not all(k in _s for k in ('oot_prob', 'oot_index', 'y_oot')):
        print(f"=== {etiket}: OOT skoru yok, atlandı"); continue

    print(f"\n=== {etiket} ===")
    oot_index = _s['oot_index']
    prob      = np.asarray(_s['oot_prob'])
    k         = np.asarray(_s['y_oot']).astype(int)          # 3M kırmızı (model target)
    t         = df.loc[oot_index, TAKIP_COL].to_numpy()      # 6M takip

    _nan = pd.isna(t).sum()
    if _nan:
        print(f"  ⚠ {TAKIP_COL} içinde {_nan:,} NaN → 0 sayıldı "
              f"({_nan/len(t)*100:.2f}%)")
    t = np.nan_to_num(t, nan=0).astype(int)

    d = pd.DataFrame({'k': k, 't': t, 'score': prob})
    n = len(d)

    # Bucket: 1 = en riskli (en yüksek skor). Tek argsort, analitik kenarlar.
    order = np.argsort(d['score'].to_numpy(), kind="stable")
    r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(N_BUCKET + 1) * (n - 1) / N_BUCKET
    d['bucket'] = N_BUCKET - np.searchsorted(edges[1:-1], r, side="left")

    # 2x2 matris hücreleri
    d['k1t1'] = ((d.k == 1) & (d.t == 1)).astype(int)
    d['k1t0'] = ((d.k == 1) & (d.t == 0)).astype(int)
    d['k0t1'] = ((d.k == 0) & (d.t == 1)).astype(int)
    d['k0t0'] = ((d.k == 0) & (d.t == 0)).astype(int)

    g = (d.groupby('bucket')
           .agg(n=('k', 'size'), kirmizi=('k', 'sum'), takip=('t', 'sum'),
                k1t1=('k1t1', 'sum'), k1t0=('k1t0', 'sum'),
                k0t1=('k0t1', 'sum'), k0t0=('k0t0', 'sum'),
                min_score=('score', 'min'), avg_score=('score', 'mean'),
                max_score=('score', 'max'))
           .reset_index().sort_values('bucket'))

    _kb = float(d.k.mean())          # OOT geneli kırmızı oranı
    _tb = float(d.t.mean())          # OOT geneli takip oranı

    g['kirmizi_rate'] = g['kirmizi'] / g['n']
    g['takip_rate']   = g['takip']   / g['n']
    g['kirmizi_lift'] = g['kirmizi_rate'] / _kb if _kb > 0 else np.nan
    g['takip_lift']   = g['takip_rate']   / _tb if _tb > 0 else np.nan

    # Kümülatif yakalama (en riskliden aşağı)
    g['cum_n_pct']       = g['n'].cumsum() / n
    g['kirmizi_capture'] = g['kirmizi'].cumsum() / max(g['kirmizi'].sum(), 1)
    g['takip_capture']   = g['takip'].cumsum()   / max(g['takip'].sum(), 1)

    # Koşullu oranlar: 3M sinyali 6M'a taşıyor mu
    g['p_takip_k1'] = g['k1t1'] / (g['k1t1'] + g['k1t0']).replace(0, np.nan)
    g['p_takip_k0'] = g['k0t1'] / (g['k0t1'] + g['k0t0']).replace(0, np.nan)

    for c in ['kirmizi_rate', 'takip_rate', 'kirmizi_lift', 'takip_lift',
              'cum_n_pct', 'kirmizi_capture', 'takip_capture',
              'p_takip_k1', 'p_takip_k0', 'min_score', 'avg_score', 'max_score']:
        g[c] = g[c].round(4)

    g.insert(0, 'renk', etiket)
    g.insert(1, 'oot_kirmizi_rate', round(_kb, 4))
    g.insert(2, 'oot_takip_rate', round(_tb, 4))
    tablolar[f"{RENK_KOD}_{renk_adi}"] = g

    # --- ÖZET: 3M ve 6M yan yana ---
    _cap_k = _capture(k, prob, CAPTURE_PCT)
    _cap_t = _capture(t, prob, CAPTURE_PCT)
    # Genel 2x2 (bucket'sız)
    _K1T1, _K1T0 = int(((k == 1) & (t == 1)).sum()), int(((k == 1) & (t == 0)).sum())
    _K0T1, _K0T0 = int(((k == 0) & (t == 1)).sum()), int(((k == 0) & (t == 0)).sum())
    ozet = {
        'renk': etiket, 'n_oot': n,
        'kirmizi': int(k.sum()), 'kirmizi_rate': round(_kb, 4),
        'takip':   int(t.sum()), 'takip_rate':   round(_tb, 4),
        'k1t1': _K1T1, 'k1t0': _K1T0, 'k0t1': _K0T1, 'k0t0': _K0T0,
        # 3M kırmızı, 6M takip için ne kadar iyi bir vekil?
        'p_takip_k1': round(_K1T1 / max(_K1T1 + _K1T0, 1), 4),
        'p_takip_k0': round(_K0T1 / max(_K0T1 + _K0T0, 1), 4),
        'takip_kacirilan_pay': round(_K0T1 / max(_K0T1 + _K1T1, 1), 4),
        f'capture{int(CAPTURE_PCT*100)}_kirmizi': round(_cap_k, 4),
        f'capture{int(CAPTURE_PCT*100)}_takip':   round(_cap_t, 4),
        'bucket1_takip_lift': g['takip_lift'].iloc[0],
        'bucket1_kirmizi_lift': g['kirmizi_lift'].iloc[0],
        # takip sıralaması monoton mu (bucket 1→20 takip_rate düşüyor mu)
        'takip_monoton_pct': round(float((np.diff(g['takip_rate'].to_numpy()) < 0).mean()), 4),
    }
    ozet_satirlari.append(ozet)

    print(f"  OOT: n={n:,} | kırmızı={int(k.sum()):,} ({_kb:.2%}) | "
          f"takip={int(t.sum()):,} ({_tb:.2%})")
    print(f"  2x2: k1t1={_K1T1:,}  k1t0={_K1T0:,}  k0t1={_K0T1:,}  k0t0={_K0T0:,}")
    print(f"  P(takip|kırmızı)={ozet['p_takip_k1']:.2%}  "
          f"P(takip|değil)={ozet['p_takip_k0']:.2%}  "
          f"→ takibe düşenlerin %{ozet['takip_kacirilan_pay']*100:.1f}'i "
          f"kırmızıya HİÇ geçmemiş")
    print(f"  capture@{CAPTURE_PCT:.0%}: kırmızı={_cap_k:.4f}  takip={_cap_t:.4f} | "
          f"bucket1 takip_lift={ozet['bucket1_takip_lift']:.2f} | "
          f"takip monotonluk={ozet['takip_monoton_pct']:.0%}")

