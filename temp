# ----------------------------------------------------------------
# YARDIMCILAR
# ----------------------------------------------------------------
def _tk_oku(fname):
    with _tk_folder.get_download_stream(fname) as _s:
        return pd.read_csv(_s)


def _takip_model_ayarlari(RENK_KOD, renk_adi):
    """Takip modelinin KENDİ feature listesi + best_params'ı (v2 klasöründen).

    Feature SIRASI kritik: colsample_bytree kolon sırasına göre örneklüyor;
    sıra değişirse AYNI parametrelerle bile BAŞKA bir model çıkar. 'sira'
    kolonu tam bunun için yazılıyor.
    """
    f = _tk_oku(f"renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv")
    if 'sira' in f.columns:
        f = f.sort_values('sira')
    feats = f['feature'].tolist()

    t = _tk_oku(f"renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv")
    if 'is_best' in t.columns and (t['is_best'] == 1).any():
        row = t[t['is_best'] == 1].iloc[0]      # kural filtresinden geçen en iyi
    else:
        row = t.sort_values('objective', ascending=False).iloc[0]
    _k = 'params_json' if 'params_json' in t.columns else 'params'
    prm = json.loads(row[_k])
    prm.setdefault('subsample_freq', 1)          # eski CSV'lerde yoksa bagging kapanır
    return feats, prm


def _takip_val_idx(RENK_KOD, renk_adi):
    """Takip modelinin kendi val indeksi — bölmeyi TAŞIMAK için (yeniden üretmek değil)."""
    try:
        return set(_tk_oku(f"renk_{RENK_KOD}_{renk_adi}_val_index.csv")['idx'])
    except Exception:
        return None


def _bucketle(prob, n_bucket=N_BUCKET):
    """1 = en riskli (en yüksek skor). Tek argsort, analitik kenarlar."""
    p = np.asarray(prob); n = len(p)
    order = np.argsort(p, kind="stable")
    r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(n_bucket + 1) * (n - 1) / n_bucket
    return n_bucket - np.searchsorted(edges[1:-1], r, side="left")


def _capture(y, prob, pct):
    """En riskli %pct dilimde yakalanan pozitif oranı."""
    y = np.asarray(y); n = len(y); tot = y.sum()
    if tot <= 0 or n == 0:
        return np.nan
    k   = max(1, int(pct * n))
    top = np.argpartition(-np.asarray(prob), min(k, n - 1))[:k] if n > 1 else np.array([0])
    return float(y[top].sum() / tot)


# ----------------------------------------------------------------
# ÖN KONTROLLER
# ----------------------------------------------------------------
if 'secilen_modeller' not in globals() or not secilen_modeller:
    raise RuntimeError("secilen_modeller yok — önce SKORLAMA bloğunu çalıştırın "
                       "(kırmızı skorları oradan okunuyor).")
if TAKIP_COL not in df.columns:
    raise RuntimeError(f"{TAKIP_COL} ham veride yok.")

analiz1, mat_n, mat_k, mat_t = {}, {}, {}, {}
ozet_satirlari, musteri_parcalari = [], []

for RENK_KOD in MODEL_RENKLER:
    renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
    etiket   = f"{RENK_KOD}-{renk_adi}"
    _s = secilen_modeller.get(RENK_KOD, {})
    if not all(x in _s for x in ('oot_prob', 'oot_index', 'y_oot')):
        print(f"=== {etiket}: kırmızı OOT skoru yok, atlandı"); continue

    print(f"\n=== {etiket} ===")

    # ---- KIRMIZI MODELİ TARAFI (bellekten, yeniden hesap YOK) ----
    oot_index = _s['oot_index']
    kir_prob  = np.asarray(_s['oot_prob'])              # kırmızı skoru
    y_kir     = np.asarray(_s['y_oot']).astype(int)     # gerçek: 3M'de kırmızıya geçti mi

    # ---- GERÇEK TAKİP (ham df'ten, model DEĞİL) ----
    y_tak = df.loc[oot_index, TAKIP_COL].to_numpy()
    _nan  = pd.isna(y_tak).sum()
    if _nan:
        # NaN'lar 0 sayılıyor. Bu sayı YÜKSEKSE 6 aylık pencere veriye tam
        # yazılmamış olabilir → takip metrikleri iyimser çıkar, dikkat.
        print(f"  ⚠ {TAKIP_COL}: {_nan:,} NaN → 0 sayıldı ({_nan/len(y_tak)*100:.2f}%)")
    y_tak = np.nan_to_num(y_tak, nan=0).astype(int)

    # ---- TAKİP MODELİ: v2 klasöründeki ayarlarıyla yeniden kur ----
    # Neden yeniden kuruluyor: v2 klasöründe skor dosyası yok, sadece
    # ayarlar var. Kendi feature'ları + kendi params'ı + kendi bölmesiyle
    # kurulduğu için o modelin BİREBİR kopyası skorlanmış oluyor.
    try:
        _tf, _tp = _takip_model_ayarlari(RENK_KOD, renk_adi)
    except Exception as e:
        print(f"  ⚠ takip modeli ayarları okunamadı ({e}), atlandı"); continue

    mask = ((df['KK_URUN_FLG'] == 'KK') & (df['RENK'] == RENK_KOD) &
            (df['DONEM'].isin([TRAIN_DONEM, OOT_DONEM])))
    df_eng_t, _ = feature_engineering(df.loc[mask].copy())
    _tf = [c for c in _tf if c in df_eng_t.columns]

    def _hazirla(_donem):
        _x = df_eng_t.loc[df_eng_t['DONEM'] == _donem, _tf].copy()
        _x[TAKIP_COL] = df_eng_t.loc[_x.index, TAKIP_COL].fillna(0).astype(int)
        return preprocess(_x)

    _tr_full, _oot_t = _hazirla(TRAIN_DONEM), _hazirla(OOT_DONEM)
    for c in CAT_COLS:
        if c in _tr_full.columns and str(_tr_full[c].dtype) == 'category':
            _oot_t[c] = pd.Categorical(_oot_t[c], categories=_tr_full[c].cat.categories)

    _vi = _takip_val_idx(RENK_KOD, renk_adi)
    if _vi:
        _tr_t = _tr_full.loc[~_tr_full.index.isin(_vi)].sort_index()   # val eğitime GİRMEZ
    else:
        print("    ⚠ takip val_index'i yok → train_full ile eğitiliyor "
              "(v2 modelinden farklı olabilir)")
        _tr_t = _tr_full.sort_index()

    y_tr_t = _tr_t[TAKIP_COL].astype(int)
    if y_tr_t.nunique() < 2:
        print("  ⚠ takip train'de tek sınıf, atlandı"); continue
    _tp2 = dict(_tp)
    _tp2.setdefault('scale_pos_weight',
                    (len(y_tr_t) - y_tr_t.sum()) / max(y_tr_t.sum(), 1))
    m_tak = lgb.LGBMClassifier(objective='binary', metric='auc', max_bin=63,
                               random_state=RANDOM_STATE, n_jobs=LGB_JOBS,
                               verbose=-1).set_params(**_tp2)
    m_tak.fit(_tr_t[_tf], y_tr_t)
    tak_prob = pd.Series(m_tak.predict_proba(_oot_t[_tf])[:, 1],
                         index=_oot_t.index).reindex(oot_index).to_numpy()
    print(f"  ▶ Takip modeli kuruldu ({TAKIP_FOLDER}) — {len(_tf)} feature, "
          f"train {len(_tr_t):,}, pozitif {int(y_tr_t.sum()):,}")

    # ---- MÜŞTERİ BAZINDA BİRLEŞTİR ----
    d = pd.DataFrame({
        'renk': etiket,
        'musteri_id': df.loc[oot_index, ID_COL].to_numpy() if ID_COL in df.columns else oot_index,
        'kirmizi_skor': kir_prob, 'takip_skor': tak_prob,
        'kirmizi_gercek': y_kir, 'takip_gercek': y_tak,
    })
    # İki modelin OOT satır kümesi preprocess yüzünden birebir örtüşmeyebilir
    # (farklı feature listesi → farklı satır düşme). Eşleşmeyenler matris dışı.
    _dus = d['takip_skor'].isna().sum()
    if _dus:
        print(f"  ⚠ {_dus:,} müşteride takip skoru yok → matris dışı "
              f"({_dus/len(d)*100:.2f}%)")
    d = d[d['takip_skor'].notna()].copy()
    if d.empty:
        print("  eşleşen müşteri yok, atlandı"); continue

    d['kirmizi_bucket'] = _bucketle(d['kirmizi_skor'].to_numpy())
    d['takip_bucket']   = _bucketle(d['takip_skor'].to_numpy())
    musteri_parcalari.append(d)

    # ============================================================
    # ANALİZ 1: kırmızı bucket x GERÇEK takip (sizin sorunuz)
    # ============================================================
    a1 = (d.groupby('kirmizi_bucket')
            .agg(n=('musteri_id', 'count'),
                 kirmizi_gercek=('kirmizi_gercek', 'sum'),
                 takip_gercek=('takip_gercek', 'sum'))
            .reset_index())
    _tb = d.takip_gercek.mean()                 # renk geneli takip oranı (lift paydası)
    a1['kirmizi_rate']  = (a1.kirmizi_gercek / a1.n).round(4)
    a1['takip_rate']    = (a1.takip_gercek / a1.n).round(4)
    a1['takip_lift']    = (a1.takip_rate / _tb).round(2) if _tb > 0 else np.nan
    a1['takip_capture'] = (a1.takip_gercek.cumsum()
                           / max(a1.takip_gercek.sum(), 1)).round(4)
    a1.insert(0, 'renk', etiket)
    analiz1[f"{RENK_KOD}_{renk_adi}_A1"] = a1

    # ============================================================
    # ANALİZ 2: 20x20 çapraz matris (müdürünüzün sorusu)
    # ============================================================
    _pv = lambda v, f: d.pivot_table(index='kirmizi_bucket', columns='takip_bucket',
                                     values=v, aggfunc=f, fill_value=0)
    mat_n[f"{RENK_KOD}_{renk_adi}_N"] = _pv('musteri_id', 'count').reset_index()
    mat_k[f"{RENK_KOD}_{renk_adi}_K"] = _pv('kirmizi_gercek', 'sum').reset_index()
    mat_t[f"{RENK_KOD}_{renk_adi}_T"] = _pv('takip_gercek', 'sum').reset_index()

    # ---- ÖZET (karar metrikleri) ----
    n = len(d)
    _k_ust = d.kirmizi_bucket <= 2               # bucket 1-2 = en riskli %10
    _t_ust = d.takip_bucket   <= 2
    _kes   = int((_k_ust & _t_ust).sum())
    _K1T1  = int(((d.kirmizi_gercek == 1) & (d.takip_gercek == 1)).sum())
    _K0T1  = int(((d.kirmizi_gercek == 0) & (d.takip_gercek == 1)).sum())
    ozet = {
        'renk': etiket, 'n': n,
        'kirmizi_gercek': int(d.kirmizi_gercek.sum()),
        'takip_gercek':   int(d.takip_gercek.sum()),
        # --- ANALİZ 1 metrikleri ---
        'bucket1_takip_rate': a1['takip_rate'].iloc[0],
        'bucket1_takip_lift': a1['takip_lift'].iloc[0],
        'takip_capture10':    round(_capture(d.takip_gercek, d.kirmizi_skor, CAPTURE_PCT), 4),
        'takip_kacirilan_pay': round(_K0T1 / max(_K0T1 + _K1T1, 1), 4),
        # --- ANALİZ 2 metrikleri ---
        'bucket_korelasyon': round(float(d.kirmizi_bucket.corr(d.takip_bucket,
                                                               method='spearman')), 4),
        'ust10_kesisim': _kes,
        'ust10_ortusme_pct': round(_kes / max(int(_k_ust.sum()), 1), 4),
        'kirmizi_model_gini_takip': round(2*roc_auc_score(d.takip_gercek, d.kirmizi_skor)-1, 4)
            if d.takip_gercek.nunique() > 1 else None,
        'takip_model_gini_takip': round(2*roc_auc_score(d.takip_gercek, d.takip_skor)-1, 4)
            if d.takip_gercek.nunique() > 1 else None,
    }
    ozet_satirlari.append(ozet)
    print(f"  A1: bucket1 takip_lift={ozet['bucket1_takip_lift']} | "
          f"capture10(takip)={ozet['takip_capture10']} | "
          f"kaçırılan pay={ozet['takip_kacirilan_pay']:.1%}")
    print(f"  A2: bucket korelasyon={ozet['bucket_korelasyon']} | "
          f"üst%10 örtüşme={ozet['ust10_ortusme_pct']:.1%} | "
          f"gini takip hedefinde: kırmızı={ozet['kirmizi_model_gini_takip']} "
          f"vs özel model={ozet['takip_model_gini_takip']}")

# ----------------------------------------------------------------
# ÇIKTILAR
# ----------------------------------------------------------------
if musteri_parcalari:
    musteri = pd.concat(musteri_parcalari, ignore_index=True)
    ozet_df = pd.DataFrame(ozet_satirlari)
    print("\n===== ÖZET =====")
    print(ozet_df.to_string(index=False))

    aciklama = pd.DataFrame({'SHEET': [
        '{renk}_A1', '', '', '{renk}_N / _K / _T', '', '', 'OZET', '', ''],
        'ACIKLAMA': [
        'ANALİZ 1 — Kırmızı modelinin bucket\'ları (1=en riskli) x GERÇEK 6M takip.',
        'takip_lift: bucket takip oranı / renk geneli. takip_capture: en riskliden kümülatif yakalama.',
        'SORU: modelin riskli dediği kitle gerçekten takibe düşüyor mu? (erken uyarı değeri)',
        'ANALİZ 2 — Satır: kırmızı modelinin bucket\'ı. Sütun: TAKİP modelinin bucket\'ı.',
        '_N=müşteri sayısı, _K=hücrede gerçek kırmızı, _T=hücrede gerçek takip.',
        'SORU: iki model aynı müşterileri mi görüyor? Köşegen dolu=aynı kitle; dağınık=farklı riskler, ikisi de gerekli.',
        'bucket1_takip_lift & takip_capture10: A1 özeti. takip_kacirilan_pay: modelin yapısal kör noktası.',
        'bucket_korelasyon & ust10_ortusme_pct: A2 özeti (sıralama benzerliği).',
        'kirmizi_model_gini_takip vs takip_model_gini_takip: özel takip modeli ne kadar değer katıyor.']})

    buf = BytesIO()
    with pd.ExcelWriter(buf, engine='openpyxl') as xl:
        aciklama.to_excel(xl, sheet_name='ACIKLAMA', index=False)
        ozet_df.to_excel(xl, sheet_name='OZET', index=False)
        for grp in (analiz1, mat_n, mat_k, mat_t):
            for ad, m in grp.items():
                m.to_excel(xl, sheet_name=ad[:31], index=False)
    buf.seek(0)
    folder.upload_stream("3M_kirmizi_x_6M_takip_analiz.xlsx", buf)
    print("\n✓ 3M_kirmizi_x_6M_takip_analiz.xlsx yazıldı "
          "(ACIKLAMA + OZET + _A1 + _N/_K/_T)")

    _b = BytesIO()
    for i in range(0, len(musteri), 500_000):        # parçalı yazım (bellek)
        musteri.iloc[i:i+500_000].to_csv(_b, index=False, header=(i == 0))
    _b.seek(0)
    folder.upload_stream("iki_model_musteri_bazli.csv", _b)
    print(f"✓ iki_model_musteri_bazli.csv yazıldı ({len(musteri):,} satır)")
else:
    print("⚠ Hiç analiz üretilemedi")
