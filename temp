def _psi(base_s, new_s, bins=10):
    """Population Stability Index. base = train, new = OOT.

    Yorum: <0.10 stabil | 0.10-0.25 dikkat | >0.25 kaymış
    """
    b, n = pd.Series(base_s), pd.Series(new_s)
    if isinstance(b.dtype, pd.CategoricalDtype) or b.dtype == object:
        bb = b.astype(object).where(b.notna(), "__NaN__").astype(str)
        nn = n.astype(object).where(n.notna(), "__NaN__").astype(str)
    else:
        b, n = b.fillna(-999999), n.fillna(-999999)
        if b.nunique() > 20:
            q = np.unique(np.nanquantile(b, np.linspace(0, 1, bins + 1)))
            if len(q) < 3:
                return 0.0
            q[0], q[-1] = -np.inf, np.inf
            bb = pd.cut(b, q, labels=False, include_lowest=True).astype(str)
            nn = pd.cut(n, q, labels=False, include_lowest=True).astype(str)
        else:
            bb, nn = b.astype(str), n.astype(str)
    pb = bb.value_counts(normalize=True)
    pn = nn.value_counts(normalize=True)
    idx = pb.index.union(pn.index)
    pb = pb.reindex(idx, fill_value=0) + 1e-6
    pn = pn.reindex(idx, fill_value=0) + 1e-6
    return float(((pn - pb) * np.log(pn / pb)).sum())


def _cramers_v(x, y):
    """Bias düzeltmeli (Bergsma) Cramér's V — kategorik ↔ hedef ilişkisi.

    Neden IV değil: IV bin sayısı arttıkça KENDİLİĞİNDEN şişiyor. 1.4M
    satırda hedefle hiç ilişkisi olmayan rastgele değişkenlerde ölçtük:
    sürekli 0.00004, 5 seviyeli 0.00002, 81 seviyeli 0.00036, 500 seviyeli
    0.00231 — yani 500 seviyeli gürültü, sürekli değişkenin 50 katı IV
    alıyor. Cramér's V'de aynı testte 0.0018 / 0.0032 / 0.0000; yanlılık yok.
    """
    ct = pd.crosstab(pd.Series(x).astype(object).fillna("__NaN__"),
                     pd.Series(y)).to_numpy()
    if ct.shape[0] < 2 or ct.shape[1] < 2:
        return 0.0
    n = ct.sum()
    exp = ct.sum(1)[:, None] * ct.sum(0)[None, :] / n
    chi2 = ((ct - exp) ** 2 / np.maximum(exp, 1e-9)).sum()
    r, k = ct.shape
    phi2c = max(0.0, chi2 / n - (k - 1) * (r - 1) / (n - 1))
    rc = r - (r - 1) ** 2 / (n - 1)
    kc = k - (k - 1) ** 2 / (n - 1)
    return float(np.sqrt(phi2c / max(min(kc - 1, rc - 1), 1e-9)))


# ============================================================
# RENK BAZLI MODELLER — her renk: eleme → Optuna → DOSYA (renk renk)
# ============================================================
#
# ------------------------------------------------------------------
# NEDEN "val" GERİ GELDİ? (CV yerine train/val)
#   1) Her trial'da CV_FOLDS kadar fit yerine TEK fit var → süre CV_FOLDS
#      katı azalıyor; 40 trial x 6 renk bu ölçekte asıl maliyet kalemiydi.
#   2) SIZINTI RİSKİ KAPALI TUTULUYOR: bölme feature elemesinden ÖNCE
#      yapılıyor. Tüm elemeler (sabit, hedef ilişkisi, korelasyon, PSI)
#      SADECE train üzerinde hesaplanıyor; val'e yalnızca hayatta kalan
#      feature listesi uygulanıyor. Val hiçbir eleme kararına girmiyor.
#   3) TUTARLILIK: seçilen model = train'de eğitilip val'de değerlendirilen
#      modelin ta kendisi. Final fit yeniden yapılmıyor, val'i eğitime
#      katmıyoruz; aksi halde doğruladığımızdan FARKLI bir model kaydedilirdi.
#   4) Eşik (threshold) artık OOF yerine val'den seçiliyor — val, modelin
#      hiç görmediği bir küme olduğu için eşik iyimser çıkmıyor.
#
# NEDEN IV ELEMESİ KALDIRILDI?
#   1) IV tek değişkenli ve MONOTON ilişki ölçer; LightGBM ikisini de
#      aramaz. Etkileşimde güçlü ama tek başına zayıf feature'lar atılıyordu.
#   2) 0.02 sabit eşiği renkten renge çok farklı davranıyordu — elenen:
#      Turuncu 144, Açık yeşil 132, Sarı 114, Yeşil 85, Kırmızı 70,
#      Koyu yeşil 15.
#   3) Seyreltmeyi model zaten yapıyor (colsample_bytree 0.4-0.7).
#   IV hesabı DURUYOR ama sadece rapor amaçlı.
#
# NEDEN SPEARMAN?
#   Çift tespiti: feature'lar çarpık + sentinel yığınları var (0, -1);
#   Pearson gerçek bağımlılığı düşük gösteriyordu. Maliyet yok — rank+matmul
#   pandas'ın Pearson corr()'undan bile hızlı (400k x 200: 25.6s vs 33.3s).
#   Tie-breaker: |Spearman(feature,target)| — binleme yok, kardinalite
#   şişmesi yok.
# ------------------------------------------------------------------

