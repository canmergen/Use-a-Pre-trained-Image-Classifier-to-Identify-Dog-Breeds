    def _kirmizi_mi(v):
        if pd.isna(v):
            return False
        sv = str(v).strip().lower()
        # Etiket bazlı güvenli kontrol: '0-Kırmızı', '1-Kırmızı', 'KIRMIZI' vb.
        if ('kırmızı' in sv) or ('kirmizi' in sv):
            return True
        return False


    def _ilk_kirmizi_from_renk_sonraki(_anchor_donem):
        _snk_cols = ['RENK_SONRAKI_AY'] + [f'RENK_SONRAKI_{k}AY' for k in range(2, 7)]
        _L = _kontrol_df.loc[
            pd.to_numeric(_kontrol_df[KONTROL_RAW_DONEM], errors='coerce') == _anchor_donem,
            [KONTROL_RAW_ID] + _snk_cols
        ].copy()
        if _L.empty:
            raise RuntimeError(f"{_kontrol_kaynak_adi}'da DONEM={_anchor_donem} satırı yok")

        _ilk = pd.Series(np.nan, index=_L.index)
        for _k in range(6, 0, -1):
            _ilk[_L[_snk_cols[_k - 1]].map(_kirmizi_mi)] = _k
        _ids = pd.to_numeric(_L[KONTROL_RAW_ID], errors='coerce')
        _s = (pd.Series(_ilk.values, index=_ids.values)
              .dropna().groupby(level=0).min())
        _s.index = _s.index.astype('int64')
        return _s, _L


    def _ilk_kirmizi_from_df_aylik(_anchor_donem):
        _aylar = [_ay_ekle(_anchor_donem, i) for i in range(1, 7)]
        _mevcut = sorted(set(df['DONEM'].unique()) & set(_aylar))
        _eksik = [a for a in _aylar if a not in _mevcut]
        if _eksik:
            print(f"⚠ KONTROL (DONEM={_anchor_donem}): df'te olmayan izleme ayları {_eksik}")
        if not _mevcut:
            return None, _eksik

        _kk = (df.loc[df['DONEM'].isin(_mevcut) & (df['RENK'] == 1),
                      [ID_COL, 'DONEM']].drop_duplicates())
        _kk['AY'] = _kk['DONEM'].map({a: i + 1 for i, a in enumerate(_aylar)})
        _s = _kk.groupby(ID_COL)['AY'].min()
        return _s, _eksik


    def _ilk_kirmizi_get(_anchor_donem):
        if _anchor_donem in _ILK_KIRMIZI_BY_DONEM:
            return _ILK_KIRMIZI_BY_DONEM[_anchor_donem]
        if _KONTROL_MODU == 'renk_sonraki':
            try:
                _s, _ = _ilk_kirmizi_from_renk_sonraki(_anchor_donem)
                _ILK_KIRMIZI_BY_DONEM[_anchor_donem] = _s
                return _s
            except Exception:
                return None
        if _KONTROL_MODU == 'df_aylik':
            _s, _ = _ilk_kirmizi_from_df_aylik(_anchor_donem)
            _ILK_KIRMIZI_BY_DONEM[_anchor_donem] = _s
            return _s
        return None


    def _ay45_flags_get(_anchor_donem):
        """DONEM=X satiri icin AY4/AY5'te kirmizi bayraklarini ID bazinda dondurur.
        Cikti index=int64 ID, kolonlar: AY4_KIRMIZI(bool), AY5_KIRMIZI(bool)
        """
        if _anchor_donem in _AY45_FLAGS_BY_DONEM:
            return _AY45_FLAGS_BY_DONEM[_anchor_donem]

        _empty = pd.DataFrame(columns=['AY4_KIRMIZI', 'AY5_KIRMIZI'])
        if _KONTROL_MODU == 'renk_sonraki':
            try:
                _need = [KONTROL_RAW_ID, KONTROL_RAW_DONEM, 'RENK_SONRAKI_4AY', 'RENK_SONRAKI_5AY']
                _L = _kontrol_df.loc[
                    pd.to_numeric(_kontrol_df[KONTROL_RAW_DONEM], errors='coerce') == _anchor_donem,
                    _need
                ].copy()
                if _L.empty:
                    _AY45_FLAGS_BY_DONEM[_anchor_donem] = _empty
                    return _empty

                _L['ID64'] = pd.to_numeric(_L[KONTROL_RAW_ID], errors='coerce').astype('Int64')
                _L = _L.dropna(subset=['ID64'])
                if _L.empty:
                    _AY45_FLAGS_BY_DONEM[_anchor_donem] = _empty
                    return _empty

                _L['AY4_KIRMIZI'] = _L['RENK_SONRAKI_4AY'].map(_kirmizi_mi)
                _L['AY5_KIRMIZI'] = _L['RENK_SONRAKI_5AY'].map(_kirmizi_mi)
                _F = (_L.groupby('ID64')[['AY4_KIRMIZI', 'AY5_KIRMIZI']]
                      .max()
                      .astype(bool))
                _F.index = _F.index.astype('int64')
                _AY45_FLAGS_BY_DONEM[_anchor_donem] = _F
                return _F
            except Exception:
                _AY45_FLAGS_BY_DONEM[_anchor_donem] = _empty
                return _empty

        if _KONTROL_MODU == 'df_aylik':
            _a4, _a5 = _ay_ekle(_anchor_donem, 4), _ay_ekle(_anchor_donem, 5)
            _f4 = df.loc[(df['DONEM'] == _a4) & (df['RENK'] == 1), [ID_COL]].copy()
            _f5 = df.loc[(df['DONEM'] == _a5) & (df['RENK'] == 1), [ID_COL]].copy()
            _f4['ID64'] = pd.to_numeric(_f4[ID_COL], errors='coerce').astype('Int64')
            _f5['ID64'] = pd.to_numeric(_f5[ID_COL], errors='coerce').astype('Int64')
            _id4 = set(_f4['ID64'].dropna().astype('int64').tolist())
            _id5 = set(_f5['ID64'].dropna().astype('int64').tolist())
            _all = sorted(_id4 | _id5)
            if not _all:
                _AY45_FLAGS_BY_DONEM[_anchor_donem] = _empty
                return _empty
            _F = pd.DataFrame(index=pd.Index(_all, dtype='int64'))
            _F['AY4_KIRMIZI'] = _F.index.isin(_id4)
            _F['AY5_KIRMIZI'] = _F.index.isin(_id5)
            _AY45_FLAGS_BY_DONEM[_anchor_donem] = _F
            return _F

        _AY45_FLAGS_BY_DONEM[_anchor_donem] = _empty
        return _empty


    if 'df_raw' in globals():
        try:
            _kontrol_df = globals()['df_raw']
            _kontrol_kaynak_adi = 'df_raw'
            _snk_cols = ['RENK_SONRAKI_AY'] + [f'RENK_SONRAKI_{k}AY'
                                               for k in range(2, 7)]
            _eksik_kolon = [c for c in _snk_cols if c not in _kontrol_df.columns]
            if _eksik_kolon:
                raise RuntimeError(f"{_kontrol_kaynak_adi}'da eksik kolon: {_eksik_kolon}")
            _KONTROL_MODU = 'renk_sonraki'

            # OOT kapsama metriği için OOT çıpasını hesapla; TRAIN de aynı
            # yöntemle _ilk_kirmizi_get(TRAIN_DONEM) ile kullanılacak.
            _ILK_KIRMIZI, _L = _ilk_kirmizi_from_renk_sonraki(OOT_DONEM)
            _ILK_KIRMIZI_BY_DONEM[OOT_DONEM] = _ILK_KIRMIZI

            try:
                _ILK_KIRMIZI_BY_DONEM[TRAIN_DONEM], _ = _ilk_kirmizi_from_renk_sonraki(TRAIN_DONEM)
            except Exception:
                pass

            _ids = pd.to_numeric(_L[KONTROL_RAW_ID], errors='coerce')
            _df_ids = pd.to_numeric(df.loc[df['DONEM'] == OOT_DONEM, ID_COL],
                                    errors='coerce').dropna().astype('int64').unique()
            _kaps = pd.Index(_df_ids).isin(
                pd.Index(_ids.dropna().astype('int64').unique())).mean()
            print(f"KONTROL kaynağı: {_kontrol_kaynak_adi} RENK_SONRAKI_1..6AY "
                  f"(DONEM={OOT_DONEM}, {len(_L):,} satır, kırmızı göreni "
                  f"{len(_ILK_KIRMIZI):,}) | df OOT kapsanma: {_kaps:.1%}"
                  + ("  ⚠ DÜŞÜK — ID/DONEM eşleşmesini kontrol edin!"
                     if _kaps < 0.95 else ""))
        except Exception as e:
            print(f"⚠ RENK_SONRAKI kontrolü kullanılamadı ({e}) → df_aylik'e düşülüyor")
            _ILK_KIRMIZI = None
    else:
        print("⚠ df_raw bellekte yok → df_aylik'e düşülüyor")

    if _ILK_KIRMIZI is None:                          # df_aylik yolu / fallback
        _KONTROL_MODU = 'df_aylik'
        _ILK_KIRMIZI, KONTROL_EKSIK = _ilk_kirmizi_from_df_aylik(OOT_DONEM)
        _ILK_KIRMIZI_BY_DONEM[OOT_DONEM] = _ILK_KIRMIZI
        _ilk_train, _ = _ilk_kirmizi_from_df_aylik(TRAIN_DONEM)
        _ILK_KIRMIZI_BY_DONEM[TRAIN_DONEM] = _ilk_train
    GRUP_AD = ["B1-4 (EN RISKLI)", "B5-8", "B9-12", "B13-16", "B17-20"]

    for RENK_KOD in MODEL_RENKLER:
        renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
        etiket   = f"{RENK_KOD}-{renk_adi}"
        print(f"\n=== {etiket} ===")

        # İçerik gate'i: bu rengin dosyaları iki klasörde de tam değilse atla
        if not (_renk_dosyalari_tam(KIRMIZI_PATH, RENK_KOD, renk_adi)
                and _renk_dosyalari_tam(TAKIP_PATH, RENK_KOD, renk_adi)):
            print("   model dosyaları eksik (kırmızı/takip klasörü), atlandı"); continue

        mask = ((df['KK_URUN_FLG'] == 'KK') & (df['RENK'] == RENK_KOD) &
                (df['DONEM'].isin([TRAIN_DONEM, OOT_DONEM])))
        df_r = df.loc[mask].copy()
        if df_r.empty or (df_r['DONEM'] == TRAIN_DONEM).sum() == 0:
            print("   veri yok, atlandı"); continue
        df_eng, _ = feature_engineering(df_r)

        kir = _skorla(KIRMIZI_PATH, RENK_KOD, renk_adi, KIRMIZI_COL, df_eng,
                      "MODEL A (X+3 aninda kirmizi mi?)")
        tak = _skorla(TAKIP_PATH, RENK_KOD, renk_adi, TAKIP_COL, df_eng,
                      "MODEL B (X+6 aninda takipte mi?)")
        if kir is None or tak is None:
            print("   model kurulamadı, atlandı"); continue

        d = pd.DataFrame({'kir_skor': kir, 'tak_skor': tak.reindex(kir.index)}).dropna()
        d['kir_gercek'] = df.loc[d.index, KIRMIZI_COL].fillna(0).astype(int)
        d['tak_gercek'] = df.loc[d.index, TAKIP_COL].fillna(0).astype(int)
        d['kb'] = _bucketle(d['kir_skor'].to_numpy())
        d['tb'] = _bucketle(d['tak_skor'].to_numpy())
        n = len(d)

        # ---- ADIM 1: GERCEK x GERCEK (TRAIN + OOT) ----
        # Tek cipa X'tir ve endpoint tanimi kullanilir:
        # kirmizi olayi X+3 anindaki durum, takip olayi X+6 anindaki durumdur.
        # Bu adim model skoru kullanmaz; iki donemde de ayni tanimla hesaplanir.
        # Ozet: TRAIN/OOT benzerse sinyal stabil, fark buyukse karar kirilgandir.
        def _a1_satir(_don, _don_ad):
            _m = df_r['DONEM'] == _don
            _k = df_r.loc[_m, KIRMIZI_COL].fillna(0).astype(int) == 1
            _t = df_r.loc[_m, TAKIP_COL].fillna(0).astype(int) == 1
            _r0 = df_r.loc[_m, 'RENK'].fillna(-1).astype(int) == 1
            _m_n = int(_m.sum())
            _k_n = int(_k.sum())
            _k0_n = int((~_k).sum())
            _kt_n = int((_k & _t).sum())
            _k0t_n = int((~_k & _t).sum())
            _kt_not_n = int((_k & (~_t)).sum())
            _p1 = float(_t[_k].mean()) if _k.any() else np.nan
            _p0 = float(_t[~_k].mean()) if (~_k).any() else np.nan

            _k0_t = (~_k) & _t
            _k0_t_n = int(_k0_t.sum())
            _t_n = int(_t.sum())
            _t_r03_n = int((_t & (_r0 | _k)).sum())
            _tk_13_n, _tk_13_p = None, None
            _tk_not13_n, _tk_not13_p = None, None
            _tk_46_n, _tk_46_p = None, None
            _tk_none_n, _tk_none_p = None, None
            _ay46_n, _hic6_n = None, None
            _ay46_p, _hic6_p = None, None

            # Ek teshis: endpoint tanimini degistirmez; sadece profil okumasi icin
            # ara aylardaki (ay1-6) kirmizi zamanlamasini ayirir.
            _ilk_kirmizi_donem = _ilk_kirmizi_get(_don)
            if (_ilk_kirmizi_donem is not None) and (ID_COL in df_r.columns) and (_t_n > 0):
                _tk_ids_all = pd.to_numeric(df_r.loc[_m & _t, ID_COL], errors='coerce').dropna().astype('int64')
                _ilk_all = _ilk_kirmizi_donem.reindex(_tk_ids_all.values)
                _tk_13_n = int(_ilk_all.le(3).sum())
                _tk_not13_n = int(_t_n - _tk_13_n)
                _tk_46_n = int(_ilk_all.between(4, 6).sum())
                _tk_none_n = int(_ilk_all.isna().sum())
                _tk_13_p = round(_tk_13_n / _t_n, 4)
                _tk_not13_p = round(_tk_not13_n / _t_n, 4)
                _tk_46_p = round(_tk_46_n / _t_n, 4)
                _tk_none_p = round(_tk_none_n / _t_n, 4)

            if (_ilk_kirmizi_donem is not None) and (ID_COL in df_r.columns) and (_k0_t_n > 0):
                _ids = pd.to_numeric(df_r.loc[_m & _k0_t, ID_COL], errors='coerce').dropna().astype('int64')
                _ilk = _ilk_kirmizi_donem.reindex(_ids.values)
                _ay46_n = int(_ilk.between(4, 6).sum())
                _hic6_n = int(_ilk.isna().sum())
                _ay46_p = round(_ay46_n / _k0_t_n, 4)
                _hic6_p = round(_hic6_n / _k0_t_n, 4)

            # X+3'te kirmizi degil ama X+6'da takipte olan alt kume icin AY4/AY5
            # kirmizi kirilimi: hem KIRMIZI bakisinda (baz _k_n) hem TAKIP
            # bakisinda (baz _t_n) oran verilir.
            _ay4_n, _ay5_n, _ay45_any_n = None, None, None
            _ay4_p_k, _ay5_p_k, _ay45_any_p_k = None, None, None
            _ay4_p_t, _ay5_p_t, _ay45_any_p_t = None, None, None
            if (ID_COL in df_r.columns) and (_k0_t_n > 0):
                _flags = _ay45_flags_get(_don)
                if _flags is not None and len(_flags) > 0:
                    _ids45 = pd.to_numeric(df_r.loc[_m & _k0_t, ID_COL], errors='coerce').dropna().astype('int64')
                    _sub = _flags.reindex(_ids45.values).fillna(False)
                    _ay4_n = int(_sub['AY4_KIRMIZI'].sum())
                    _ay5_n = int(_sub['AY5_KIRMIZI'].sum())
                    _ay45_any_n = int((_sub['AY4_KIRMIZI'] | _sub['AY5_KIRMIZI']).sum())
                    _ay4_p_k = round(_ay4_n / max(_k_n, 1), 4) if _k_n > 0 else None
                    _ay5_p_k = round(_ay5_n / max(_k_n, 1), 4) if _k_n > 0 else None
                    _ay45_any_p_k = round(_ay45_any_n / max(_k_n, 1), 4) if _k_n > 0 else None
                    _ay4_p_t = round(_ay4_n / max(_t_n, 1), 4) if _t_n > 0 else None
                    _ay5_p_t = round(_ay5_n / max(_t_n, 1), 4) if _t_n > 0 else None
                    _ay45_any_p_t = round(_ay45_any_n / max(_t_n, 1), 4) if _t_n > 0 else None

            return {
                'RENK': etiket, 'DÖNEM': _don_ad, 'MÜŞTERİ': _m_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLAN KİTLE (adet)': _k_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLAN KİTLE (%)':
                    round(float(_k_n / max(_m_n, 1)), 4) if _m_n > 0 else None,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLANLARDA X+6 TAKİP (adet)': _kt_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLANLARDA X+6 TAKİP (%)':
                    round(float(_kt_n / max(_k_n, 1)), 4) if _k_n > 0 else None,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLANLARDA X+6 TAKİPTE OLMAYAN (adet)': _kt_not_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLANLARDA X+6 TAKİPTE OLMAYAN (%)':
                    round(float(_kt_not_n / max(_k_n, 1)), 4) if _k_n > 0 else None,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLMAYAN KİTLE (adet)': _k0_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLMAYANLARDA X+6 TAKİP (adet)': _k0t_n,
                'KIRMIZI BAKIŞI | X+3 KIRMIZI OLMAYANLARDA X+6 TAKİP (%)': round(_p0, 4) if np.isfinite(_p0) else None,
                'TAKİP RİSK KATI (GEÇEN/GEÇMEYEN)': round(_p1 / _p0, 1)
                    if np.isfinite(_p1) and np.isfinite(_p0) and _p0 > 0 else None,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLAN KİTLE (adet)': int(_t.sum()),
                'TAKİP BAKIŞI | X+6 TAKİPTE OLAN KİTLE (%)':
                    round(float(_t.sum() / max(_m_n, 1)), 4) if _m_n > 0 else None,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA AY0-3 KIRMIZI GÖREN (%, AY0 dahil)':
                    round(float(_t_r03_n / max(_t_n, 1)), 4) if _t.any() else None,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA AY0-3 KIRMIZI GÖREN (adet, AY0 dahil)': _t_r03_n,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA İLK 3 AY KIRMIZIYA DÜŞEN (adet)': _tk_13_n,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA İLK 3 AY KIRMIZIYA DÜŞEN (%)': _tk_13_p,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA İLK 3 AY KIRMIZIYA DÜŞMEYEN (adet)': _tk_not13_n,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA İLK 3 AY KIRMIZIYA DÜŞMEYEN (%)': _tk_not13_p,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA 4-6 AY KIRMIZIYA DÜŞEN (adet)': _tk_46_n,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA 4-6 AY KIRMIZIYA DÜŞEN (%)': _tk_46_p,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA 6 AY HİÇ KIRMIZIYA DÜŞMEYEN (adet)': _tk_none_n,
                'TAKİP BAKIŞI | X+6 TAKİPTE OLANLARDA 6 AY HİÇ KIRMIZIYA DÜŞMEYEN (%)': _tk_none_p,
                'ALT KÜME | X+3 KIRMIZI DEĞİL & X+6 TAKİPTE (adet)': _k0_t_n,
                'ALT KÜME | X+4 KIRMIZI OLAN (adet)': _ay4_n,
                'ALT KÜME | X+4 KIRMIZI OLAN (%) [KIRMIZI KİTLESİ baz]': _ay4_p_k,
                'ALT KÜME | X+4 KIRMIZI OLAN (%) [TAKİP KİTLESİ baz]': _ay4_p_t,
                'ALT KÜME | X+5 KIRMIZI OLAN (adet)': _ay5_n,
                'ALT KÜME | X+5 KIRMIZI OLAN (%) [KIRMIZI KİTLESİ baz]': _ay5_p_k,
                'ALT KÜME | X+5 KIRMIZI OLAN (%) [TAKİP KİTLESİ baz]': _ay5_p_t,
                'ALT KÜME | X+4 veya X+5 KIRMIZI OLAN (adet)': _ay45_any_n,
                'ALT KÜME | X+4 veya X+5 KIRMIZI OLAN (%) [KIRMIZI KİTLESİ baz]': _ay45_any_p_k,
                'ALT KÜME | X+4 veya X+5 KIRMIZI OLAN (%) [TAKİP KİTLESİ baz]': _ay45_any_p_t,
                'ALT KÜME | 4-6 AYDA KIRMIZI OLAN (adet)': _ay46_n,
                'ALT KÜME | 4-6 AYDA KIRMIZI OLAN (%)': _ay46_p,
                'ALT KÜME | 6 AY HİÇ KIRMIZI OLMAYAN (adet)': _hic6_n,
                'ALT KÜME | 6 AY HİÇ KIRMIZI OLMAYAN (%)': _hic6_p,
            }
        adim1.append(_a1_satir(TRAIN_DONEM, f'TRAIN {TRAIN_DONEM}'))
        adim1.append(_a1_satir(OOT_DONEM,   f'OOT {OOT_DONEM}'))

        def _a1_kume_tablo_satirlari(_don, _don_ad):
            _m = df_r['DONEM'] == _don
            _k = df_r.loc[_m, KIRMIZI_COL].fillna(0).astype(int) == 1
            _t = df_r.loc[_m, TAKIP_COL].fillna(0).astype(int) == 1
            _flags = _ay45_flags_get(_don)

            def _ozet(_grup_mask):
                # Grup maskesi parcali indexle gelebilir; once df_r indexine
                # guvenli sekilde hizala, sonra donem filtresiyle kes.
                if isinstance(_grup_mask, pd.Series):
                    _mask = _grup_mask.reindex(df_r.index, fill_value=False).astype(bool)
                else:
                    _mask = pd.Series(_grup_mask, index=df_r.index).astype(bool)
                _mask = _mask & _m
                _n = int(_mask.sum())
                if _n == 0:
                    return {'BAZ KİTLE (adet)': 0,
                            'X+4 KIRMIZI (adet)': 0, 'X+4 KIRMIZI (%)': None,
                            'X+5 KIRMIZI (adet)': 0, 'X+5 KIRMIZI (%)': None,
                            'X+4 veya X+5 KIRMIZI (adet)': 0, 'X+4 veya X+5 KIRMIZI (%)': None}

                if (ID_COL not in df_r.columns) or (_flags is None) or (len(_flags) == 0):
                    return {'BAZ KİTLE (adet)': _n,
                            'X+4 KIRMIZI (adet)': None, 'X+4 KIRMIZI (%)': None,
                            'X+5 KIRMIZI (adet)': None, 'X+5 KIRMIZI (%)': None,
                            'X+4 veya X+5 KIRMIZI (adet)': None, 'X+4 veya X+5 KIRMIZI (%)': None}

                _ids = pd.to_numeric(df_r.loc[_mask, ID_COL], errors='coerce').dropna().astype('int64')
                _sub = _flags.reindex(_ids.values).fillna(False)
                _x4 = int(_sub['AY4_KIRMIZI'].sum())
                _x5 = int(_sub['AY5_KIRMIZI'].sum())
                _x45 = int((_sub['AY4_KIRMIZI'] | _sub['AY5_KIRMIZI']).sum())
                return {
                    'BAZ KİTLE (adet)': _n,
                    'X+4 KIRMIZI (adet)': _x4,
                    'X+4 KIRMIZI (%)': round(_x4 / _n, 4),
                    'X+5 KIRMIZI (adet)': _x5,
                    'X+5 KIRMIZI (%)': round(_x5 / _n, 4),
                    'X+4 veya X+5 KIRMIZI (adet)': _x45,
                    'X+4 veya X+5 KIRMIZI (%)': round(_x45 / _n, 4),
                }

            _gruplar = [
                ('TABLO 0', 'TUM MUSTERI', _m),
                ('TABLO 1', 'TAKİP BAZI: X+6 TAKİPTE', _t),
                ('TABLO 2', 'KIRMIZI BAZI: X+3 KIRMIZI', _k),
                ('TABLO 3', 'ORTAK: X+3 KIRMIZI & X+6 TAKİP', _k & _t),
                ('TABLO 3', 'SADECE KIRMIZI: X+3 KIRMIZI & X+6 TAKİP DEĞİL', _k & (~_t)),
                ('TABLO 3', 'SADECE TAKİP (DIŞTA KALAN): X+3 KIRMIZI DEĞİL & X+6 TAKİP', (~_k) & _t),
            ]

            for _tablo, _grup_ad, _grup_mask in _gruplar:
                _sat = _ozet(_grup_mask)
                adim1_kume_ozet.append({
                    'RENK': etiket,
                    'DÖNEM': _don_ad,
                    'TABLO': _tablo,
                    'GRUP': _grup_ad,
                    **_sat,
                })

        _a1_kume_tablo_satirlari(TRAIN_DONEM, f'TRAIN {TRAIN_DONEM}')
        _a1_kume_tablo_satirlari(OOT_DONEM, f'OOT {OOT_DONEM}')

        # --- KONTROL: bu rengin takibe düşenlerinde ilk kırmızı ayı ---
        # Kırmızı segment hariç (orada herkes ay 0'da zaten kırmızı).
        if RENK_KOD != 1:
            _r = None
            if _ilk_kirmizi_get(OOT_DONEM) is not None and ID_COL in df.columns:
                _tk_ids = pd.to_numeric(
                    df.loc[(df['KK_URUN_FLG'] == 'KK') & (df['RENK'] == RENK_KOD)
                           & (df['DONEM'] == OOT_DONEM)
                           & (df[TAKIP_COL].fillna(0).astype(int) == 1), ID_COL],
                    errors='coerce').dropna().astype('int64')
                _nt = len(_tk_ids)
                if _nt:
                    _ay = _ilk_kirmizi_get(OOT_DONEM).reindex(_tk_ids.values)
                    _r = {'RENK': etiket, 'TAKİBE DÜŞEN (OOT, 6M)': _nt}
                    for _i in range(1, 7):
                        _r[f'AY {_i} (adet)'] = int((_ay == _i).sum())
                    _p13, _p46 = int(_ay.le(3).sum()), int(_ay.between(4, 6).sum())
                    _hic = int(_ay.isna().sum())
                    _r['PENCERE İÇİ ay1-3 (adet)'] = _p13
                    _r['PENCERE İÇİ %'] = round(_p13 / _nt, 4)
                    _r['PENCERE SONRASI ay4-6 (adet)'] = _p46
                    _r['PENCERE SONRASI %'] = round(_p46 / _nt, 4)
                    _r['HİÇ KIRMIZI YOK (adet)'] = _hic
                    _r['HİÇ KIRMIZI YOK %'] = round(_hic / _nt, 4)
            if _r:
                kontrol_satirlari.append(_r)

        # --- BASİT EK: GEÇMİŞ 12 AY (df'in KENDİ RENK_LxM kolonlarından) ---
        # Harici kaynak yok: X anındaki satırda RENK_LM = X-1'in rengi,
        # L2M = X-2 ... L12M = X-12. Takibe düşenler X'ten ÖNCE kırmızı
        # görmüş mü, en son ne kadar önce? (uzmanların "%99 görür" dediği
        # geçmiş pencerenin bizim verimizdeki karşılığı)
        _lagc = [c for c in (['RENK_LM'] + [f'RENK_L{k}M' for k in range(2, 13)])
                 if c in df.columns]
        if _lagc:
            _oot_m = ((df['KK_URUN_FLG'] == 'KK') & (df['RENK'] == RENK_KOD)
                      & (df['DONEM'] == OOT_DONEM)
                      & (df[TAKIP_COL].fillna(0).astype(int) == 1))
            _T = df.loc[_oot_m, _lagc]
            _n2 = len(_T)
            if _n2:
                def _kmz(col):                    # '1-Kırmızı' / 1 → True
                    sv = _T[col].astype(str).str.strip()
                    return sv.str.startswith('1') & ~sv.str.startswith(('10', '11', '12'))
                # en son kırmızı kaç ay önce (1 = geçen ay)
                _son = pd.Series(np.nan, index=_T.index)
                for i in range(len(_lagc), 0, -1):    # uzaktan yakına: yakın ay ezsin
                    _son[_kmz(_lagc[i-1])] = i
                _s13  = int(_son.le(3).sum())
                _s412 = int(_son.between(4, 12).sum())
                _hic2 = int(_son.isna().sum())
                kontrol2_satirlari.append({
                    'RENK': etiket, 'TAKİBE DÜŞEN (OOT)': _n2,
                    'SON 3 AYDA KIRMIZI (adet)': _s13,
                    'SON 3 AYDA %': round(_s13 / _n2, 4),
                    'SON 4-12 AYDA KIRMIZI (adet)': _s412,
                    'SON 4-12 AYDA %': round(_s412 / _n2, 4),
                    'SON 12 AYDA HİÇ YOK (adet)': _hic2,
                    'SON 12 AYDA HİÇ YOK %': round(_hic2 / _n2, 4)})

        # Hüküm (T1) ADIM1'in OOT satırından beslenir — model içeren testlerle
        # aynı dönem. (Burada ayrıca hesaplanmasına gerek yok.)

        # ---- ADIM 2: model -> gerçek takip (kıyas çıpalı) ----
        cap_kir_takip = _capture(d.tak_gercek, d.kir_skor, CAPTURE_PCT)
        cap_tak_takip = _capture(d.tak_gercek, d.tak_skor, CAPTURE_PCT)
        # Capture sadece üst %20'ye bakar; AUC tüm sıralamayı ölçer.
        # "A, B'nin işini görüyor mu" sorusu iki açıdan da cevaplanmalı:
        # A üst dilimde iyi ama genel sıralamada kötü olabilir (ya da tersi).
        if d.tak_gercek.nunique() > 1:
            auc_kir = float(roc_auc_score(d.tak_gercek, d.kir_skor))
            auc_tak = float(roc_auc_score(d.tak_gercek, d.tak_skor))
        else:
            auc_kir = auc_tak = np.nan
        _kb_ust = d.kb <= UST
        adim2.append({
            'RENK': etiket,
            'KIRMIZI MODELİ B1-4 MÜŞTERİ': int(_kb_ust.sum()),
            'B1-4te GERÇEK TAKİP ORANI': round(float(d.loc[_kb_ust, 'tak_gercek'].mean()), 4),
            'RENK GENELİ TAKİP ORANI': round(float(d.tak_gercek.mean()), 4),
            'KIRMIZI MODELİN TAKİP CAPTURE@20%': round(cap_kir_takip, 4),
            'ÖZEL TAKİP MODELİNİN CAPTURE@20% (KIYAS)': round(cap_tak_takip, 4),
            'FARK (özel modelin kattığı)': round(cap_tak_takip - cap_kir_takip, 4)
                if np.isfinite(cap_tak_takip) and np.isfinite(cap_kir_takip) else None,
            'KIRMIZI MODELİN TAKİP GINI': round(2 * auc_kir - 1, 4)
                if np.isfinite(auc_kir) else None,
            'ÖZEL TAKİP MODELİNİN GINI (KIYAS)': round(2 * auc_tak - 1, 4)
                if np.isfinite(auc_tak) else None,
            'GINI FARKI (özel - kırmızı)': round(2 * (auc_tak - auc_kir), 4)
                if np.isfinite(auc_kir) and np.isfinite(auc_tak) else None,
        })

        # ---- ADIM 3: 5x5 model x model — ADET ve SATIR-% YAN YANA ----
        d['kb_g'] = ((d.kb - 1) // 4 + 1)
        d['tb_g'] = ((d.tb - 1) // 4 + 1)
        g = d.pivot_table(index='kb_g', columns='tb_g', values='kir_skor',
                          aggfunc='count', fill_value=0)
        gp = (g.div(g.sum(axis=1), axis=0) * 100).round(1)
        blok = pd.DataFrame({
            'RENK': etiket,
            'SATIR: KIRMIZI modeli / SUTUN: TAKIP modeli':
                [f"KIRMIZIYA-GECIS SKORU {GRUP_AD[i-1]}" for i in g.index]})
        for c in g.columns:                                    # önce ADET bloğu
            blok[f"ADET | TAKIP {GRUP_AD[c-1]}"] = g[c].values
        blok['TOPLAM'] = g.sum(axis=1).values
        for c in gp.columns:                                   # sonra % bloğu
            blok[f"% | TAKIP {GRUP_AD[c-1]}"] = gp[c].values
        adim3_bloklar.append(blok)

        # ---- KARAR ----
        _t_ust = d.tb <= UST
        ortusme = float((_kb_ust & _t_ust).sum() / max(int(_kb_ust.sum()), 1))
        _kacan = (~_kb_ust) & _t_ust
        kacan_rate = float(d.loc[_kacan, 'tak_gercek'].mean()) if _kacan.any() else np.nan
        # Eşik gerekçesi: rastgele örtüşme tabanı %20 (4/20 bucket).
        #    >= 3x rastgele (%60)   → güçlü örtüşme
        #    >= ~1.75x rastgele (%35) → kısmi
        #    altı                     → rastgeleden zor ayrışıyor
        if ortusme >= 0.60:
            sonuc = "ÖRTÜŞÜYOR (≥3x rastgele) — tek model tartışılabilir"
        elif ortusme >= 0.35:
            sonuc = "KISMİ (~2x rastgele) — kaçan dilime bakın"
        else:
            sonuc = "AYRIŞIYOR (rastgeleye yakın) — iki model de gerekli"
        ort_rate  = float(d.loc[_kb_ust & _t_ust, 'tak_gercek'].mean()) \
            if (_kb_ust & _t_ust).any() else np.nan
        genel_rate = float(d.tak_gercek.mean())
        karar.append({
            '_n_takip': int(d.tak_gercek.sum()),   # hüküm için taşıyıcı; KARAR sheet'ine yazılmaz
            'RENK': etiket,
            'ÖRTÜŞME: kırmızı B1-4ün takipte de B1-4te olan oranı': round(ortusme, 4),
            'RASTGELE BEKLENEN': 0.20,
            'KAÇAN DİLİM MÜŞTERİ (takip B1-4, kırmızı B5-20)': int(_kacan.sum()),
            'KAÇAN DİLİMİN GERÇEK TAKİP ORANI': round(kacan_rate, 4)
                if np.isfinite(kacan_rate) else None,
            # KIYAS: kaçan dilim tek başına yorumlanamaz — örtüşen dilim ve
            # renk geneli yanında olmadan "%X çok mu?" sorusu cevapsız kalır.
            'ÖRTÜŞEN DİLİMİN GERÇEK TAKİP ORANI': round(ort_rate, 4)
                if np.isfinite(ort_rate) else None,
            'RENK GENELİ TAKİP ORANI': round(genel_rate, 4),
            'KAÇAN / GENEL (kaç kat)': round(kacan_rate / genel_rate, 1)
                if np.isfinite(kacan_rate) and genel_rate > 0 else None,
            'SONUÇ': sonuc,
        })
        # --- HİÇ BİLMEYEN BİRİNİN OKUYABİLECEĞİ RENK ÖZETİ ---
        print()
        print(f"  —— {etiket} SEGMENTİ: NE BULDUK? " + "—" * 30)
        print(f"  İki ayrı tahmin modeli karşılaştırılıyor:")
        print(f"    MODEL A: müşteri X+3 anında KIRMIZI olur mu?")
        print(f"    MODEL B: müşteri X+6 anında TAKİPTE olur mu?")
        print(f"  Soru: A modeli B'nin işini de görüyor mu? Görüyorsa B'ye gerek yok.")
        print(f"  Test dönemi: {OOT_DONEM} — modellerin eğitimde HİÇ görmediği ay.")
        print(f"  Bu ay gerçekten takibe düşen: {int(d.tak_gercek.sum()):,} müşteri.")
        print()
        print(f"  1) İKİ MODEL AYNI KİŞİLERİ Mİ İŞARET EDİYOR?")
        print(f"     A'nın 'en riskli %20' dediği müşterilerin {ortusme:.1%}'i, B'de de")
        print(f"     en riskli %20'de. Kıyas: iki model tamamen ALAKASIZ olsaydı bile")
        print(f"     bu oran ~%20 çıkardı. → "
              + ("Büyük ölçüde aynı kitle." if ortusme >= 0.60 else
                 "Kısmen örtüşüyor." if ortusme >= 0.35 else
                 "Neredeyse alakasız çalışıyorlar."))
        print()
        _n_tak   = int(d.tak_gercek.sum())
        _a_adet  = int(round(cap_kir_takip * _n_tak))
        _b_adet  = int(round(cap_tak_takip * _n_tak))
        print(f"  2) GERÇEKTEN TAKİBE DÜŞENLERİ HANGİSİ ÖNCEDEN İŞARETLERDİ?")
        print(f"     Her model tüm müşterileri risk sırasına dizer. Diyelim ki her")
        print(f"     modelin listesindeki EN RİSKLİ %20'lik gruba önceden aksiyon")
        print(f"     alıyoruz (arama, limit, yakın izleme).")
        print(f"     Bu ay takibe düşen {_n_tak:,} kişiden önceden işaretlenmiş olurdu:")
        print(f"        A modelinin listesiyle: {_a_adet:>10,} kişi  ({cap_kir_takip:.1%})")
        print(f"        B modelinin listesiyle: {_b_adet:>10,} kişi  ({cap_tak_takip:.1%})")
        print(f"     → B ile {_b_adet - _a_adet:+,} kişi FAZLA erken yakalanırdı."
              + ("  A'nın listesi bu segmentte rastgele %20 seçmekten bile az"
                 " yakalıyor — çünkü A'nın hedefi (kırmızıda kalış) takiple"
                 " TERS ilişkili." if cap_kir_takip < CAPTURE_PCT else ""))
        print()
        if np.isfinite(kacan_rate) and genel_rate > 0:
            _kacan_n   = int(_kacan.sum())
            # Ölçek otomatik: oranlar küçükse "her 100 kişi" ezilip ~0 basıyordu
            # (yeşil segmentlerde 0.0x%). Taban, genel oranı en az 1'e getirecek
            # şekilde 100 / 1.000 / 10.000 / 100.000 arasından seçilir.
            _taban = 100
            while _taban < 100_000 and genel_rate * _taban < 1:
                _taban *= 10
            _kacan_t = round(kacan_rate * _taban)
            _genel_t = round(genel_rate * _taban)
            _tb_ad   = f"{_taban:,}".replace(",", ".")
            print(f"  3) SADECE A MODELİNİ KULLANSAYDIK KİMLER GÖZDEN KAÇARDI?")
            print(f"     B'nin 'riskli' bulduğu ama A'nın listesine GİRMEYEN {_kacan_n:,}")
            print(f"     kişi var. Sadece A'yı kullansaydık bu gruba kimse bakmazdı.")
            print(f"     Peki gerçekte ne oldu? Bu gruptaki her {_tb_ad} kişiden ~{_kacan_t}'i")
            print(f"     takibe düştü. Kıyas: segmentte sıradan {_tb_ad} kişiden ~{_genel_t}'i")
            print(f"     düşüyor. → "
                  + (f"Kaçan grup sıradan müşteri DEĞİL — {kacan_rate/genel_rate:.1f} kat"
                     f" yoğun risk taşıyor, göz ardı edilemez."
                     if kacan_rate/genel_rate > ESIK_KACAN else
                     f"Kaçan grubun riski segment ortalamasına yakın"
                     f" ({kacan_rate/genel_rate:.1f} kat), kritik bir kayıp değil."))
        print(f"  " + "—" * 62)

        # ---- 20x20 detay — ADET ve SATIR-% YAN YANA ----
        nm = d.pivot_table(index='kb', columns='tb', values='kir_skor',
                           aggfunc='count', fill_value=0)
        pm = (nm.div(nm.sum(axis=1), axis=0) * 100).round(1)
        det = pd.DataFrame({
            'RENK': etiket,
            'SATIR: KIRMIZI / SUTUN: TAKIP':
                [f"KIRMIZI_B{i}" for i in nm.index]})
        for c in nm.columns:
            det[f"ADET T_B{c}"] = nm[c].values
        for c in pm.columns:
            det[f"% T_B{c}"] = pm[c].values
        detay_bloklar.append(det)

    def _genel_kume_satirlari(_don, _don_ad):
        # Filtre uygulanmadan tum portfoy: TRAIN/OOT ayrik satirlar
        _m = df['DONEM'] == _don
        _k = df.loc[_m, KIRMIZI_COL].fillna(0).astype(int) == 1
        _t = df.loc[_m, TAKIP_COL].fillna(0).astype(int) == 1
        _flags = _ay45_flags_get(_don)

        def _ozet(_grup_mask):
            # Grup maskesi parcali indexle gelebilir; once df indexine
            # guvenli sekilde hizala, sonra donem filtresiyle kes.
            if isinstance(_grup_mask, pd.Series):
                _mask = _grup_mask.reindex(df.index, fill_value=False).astype(bool)
            else:
                _mask = pd.Series(_grup_mask, index=df.index).astype(bool)
            _mask = _mask & _m
            _n = int(_mask.sum())
            if _n == 0:
                return {'BAZ KİTLE (adet)': 0,
                        'X+4 KIRMIZI (adet)': 0, 'X+4 KIRMIZI (%)': None,
                        'X+5 KIRMIZI (adet)': 0, 'X+5 KIRMIZI (%)': None,
                        'X+4 veya X+5 KIRMIZI (adet)': 0, 'X+4 veya X+5 KIRMIZI (%)': None}

            if (ID_COL not in df.columns) or (_flags is None) or (len(_flags) == 0):
                return {'BAZ KİTLE (adet)': _n,
                        'X+4 KIRMIZI (adet)': None, 'X+4 KIRMIZI (%)': None,
                        'X+5 KIRMIZI (adet)': None, 'X+5 KIRMIZI (%)': None,
                        'X+4 veya X+5 KIRMIZI (adet)': None, 'X+4 veya X+5 KIRMIZI (%)': None}

            _ids = pd.to_numeric(df.loc[_mask, ID_COL], errors='coerce').dropna().astype('int64')
            _sub = _flags.reindex(_ids.values).fillna(False)
            _x4 = int(_sub['AY4_KIRMIZI'].sum())
            _x5 = int(_sub['AY5_KIRMIZI'].sum())
            _x45 = int((_sub['AY4_KIRMIZI'] | _sub['AY5_KIRMIZI']).sum())
            return {
                'BAZ KİTLE (adet)': _n,
                'X+4 KIRMIZI (adet)': _x4,
                'X+4 KIRMIZI (%)': round(_x4 / _n, 4),
                'X+5 KIRMIZI (adet)': _x5,
                'X+5 KIRMIZI (%)': round(_x5 / _n, 4),
                'X+4 veya X+5 KIRMIZI (adet)': _x45,
                'X+4 veya X+5 KIRMIZI (%)': round(_x45 / _n, 4),
            }

        _gruplar = [
            ('TABLO 0', 'TUM MUSTERI', _m),
            ('TABLO 1', 'TAKİP BAZI: X+6 TAKİPTE', _t),
            ('TABLO 2', 'KIRMIZI BAZI: X+3 KIRMIZI', _k),
            ('TABLO 3', 'ORTAK: X+3 KIRMIZI & X+6 TAKİP', _k & _t),
            ('TABLO 3', 'SADECE KIRMIZI: X+3 KIRMIZI & X+6 TAKİP DEĞİL', _k & (~_t)),
            ('TABLO 3', 'SADECE TAKİP (DIŞTA KALAN): X+3 KIRMIZI DEĞİL & X+6 TAKİP', (~_k) & _t),
        ]

        for _tablo, _grup_ad, _grup_mask in _gruplar:
            _sat = _ozet(_grup_mask)
            adim1_kume_ozet.append({
                'RENK': 'GENEL (TUM RENKLER)',
                'DÖNEM': _don_ad,
                'TABLO': _tablo,
                'GRUP': _grup_ad,
                **_sat,
            })


    _genel_kume_satirlari(TRAIN_DONEM, f'TRAIN {TRAIN_DONEM}')
    _genel_kume_satirlari(OOT_DONEM, f'OOT {OOT_DONEM}')

    # ------------------------------------------------------------
    # EXCEL
    # ------------------------------------------------------------
    if not karar:
        print("ⓘ Hiç sonuç üretilemedi — renklerin hiçbirinde iki model birden kurulamadı.")
        _hazir = False

    if _hazir:

        # ------------------------------------------------------------
        # HÜKÜM: "ayrı takip modeline gerek yok" diyebilmek için ÜÇ TEST
        # BİRDEN geçmeli. Biri bile kalırsa model gereklidir — sebebiyle.
        #    TEST 1 SİNYAL (ADIM1): KAÇ KAT >= 2 → kırmızıya geçiş takibin
        #       gerçek öncüsü mü? (<1 ise vekil TERS çalışıyor — Kırmızı segment)
        #    TEST 2 KIYAS (ADIM2): özel modelin capture katkısı <= 5 puan →
        #       kırmızı modeli takibi neredeyse özel model kadar sıralıyor mu?
        #    TEST 3 KAÇAN (KARAR): kaçan dilimin takip oranı genelin <= 1.5
        #       katı → kırmızının görmediği dilimde gerçek risk birikmiyor mu?
        # Eşikler iş kararına göre oynatılabilir; sabitler aşağıda tek yerde.
        # ------------------------------------------------------------
        print("""
        ================================================================
         HÜKÜM: 6M TAKİP MODELİ AYRICA GEREKLİ Mİ?
        ================================================================
         Kural: "gerek yok" diyebilmek için ÜÇ TEST BİRDEN geçmeli.
         Biri bile kalırsa takip modeli GEREKLİDİR (sebep hükümde yazar).

         T1 SİNYAL (delil: ADIM1, gerçekxgerçek)
           Soru : Kırmızıya geçmek takibin gerçekten öncüsü mü?
           Ölçüm: P(takip|geçti) / P(takip|geçmedi) = KAÇ KAT, eşik ≥ {t1}
           Kalırsa: kırmızı hedefi takip için YAPISAL olarak yanlış vekil.

         T2 KIYAS (delil: ADIM2, modelxgerçek)
           Soru : Özel model, kırmızı modelinin üstüne ne katıyor?
           Ölçüm: capture@%{cp} farkı (puan) + adet karşılığı, eşik ≤ {t2}
           Kalırsa: kırmızı modeli sinyali yeterince İYİ SIRALAYAMIYOR.

         T3 KAÇAN (delil: KARAR, modelxmodel + gerçekleşme)
           Soru : Kırmızının görmediği dilimde gerçek risk birikiyor mu?
           Ölçüm: kaçan dilimin takip oranı / genel oran, eşik ≤ {t3}
           Kalırsa: kaçırılanlar küçük ama ÇOK RİSKLİ bir cepte toplanmış.

         Kısa ezber: T1 = sinyal var mı, T2 = model taşıyor mu,
                     T3 = kaçırdığı yerde yangın var mı.
         (SINIRDA = değer eşiğe ±%{sb} bandında; hüküm kırılgan, ek dönemle
          doğrulanmalı. Eşikler öneridir — ESIK_* sabitlerinden ayarlanır.)
        ================================================================""".format(
            t1=ESIK_SINYAL, t2=ESIK_KIYAS, t3=ESIK_KACAN,
            cp=int(CAPTURE_PCT * 100), sb=int(0.15 * 100)))

        hukum = []
        for k in karar:
            _r  = k['RENK']
            _a1 = next(x for x in adim1
                       if x['RENK'] == _r and str(x.get('DÖNEM', '')).startswith('OOT'))
            _a2 = next(x for x in adim2 if x['RENK'] == _r)
            kac_kat = _a1.get('TAKİP RİSK KATI (GEÇEN/GEÇMEYEN)')   # OOT dönemi T1
            fark    = _a2.get('FARK (özel modelin kattığı)')
            kacan_k = k.get('KAÇAN / GENEL (kaç kat)')

            # 1) Somut adet: özel modelin B1-4'te yakaladığı EK takip vakası.
            #    T2'deki "+X puan"ın TL/adet karşılığı — bütçe kararı puanla değil
            #    adetle verilir. hesap: fark (capture puanı) x toplam takip vakası.
            _n_takip = k.get('_n_takip')              # karar dict'ine aşağıda eklendi
            ek_vaka = (int(round(fark * _n_takip))
                       if fark is not None and _n_takip else None)

            t1 = (kac_kat is not None) and (kac_kat >= ESIK_SINYAL)
            t2 = (fark is not None) and (fark <= ESIK_KIYAS)
            t3 = (kacan_k is not None) and (kacan_k <= ESIK_KACAN)

            # SINIRDA tespiti: değer eşiğe ±%15 bandında ise hüküm KIRILGANDIR —
            # nokta tahminler örneklem gürültüsü taşır (özellikle az vakalı
            # renklerde); eşiğin hemen iki yanı istatistiksel olarak ayırt
            # edilemez olabilir. Bu durumda GEÇTİ/KALDI yerine SINIRDA yazılır
            # ve nihai hüküm "eşik mutabakatı + ek dönem doğrulaması" ister.
            SINIR_BANT = 0.15
            def _durum(v, esik, buyuk_gecer):
                if v is None:
                    return 'VERİ YOK', False
                sinirda = abs(v - esik) <= SINIR_BANT * esik
                gecti = (v >= esik) if buyuk_gecer else (v <= esik)
                if sinirda:
                    return 'SINIRDA', gecti
                return ('GEÇTİ' if gecti else 'KALDI'), gecti

            d1, t1 = _durum(kac_kat, ESIK_SINYAL, buyuk_gecer=True)
            d2, t2 = _durum(fark,    ESIK_KIYAS,  buyuk_gecer=False)
            d3, t3 = _durum(kacan_k, ESIK_KACAN,  buyuk_gecer=False)
            _sinirda = 'SINIRDA' in (d1, d2, d3)

            sebep = []
            if not t1:
                sebep.append(f"kırmızı hedefi takip için zayıf/ters vekil (KAÇ KAT={kac_kat})")
            if not t2:
                sebep.append(f"özel model capture'a +{fark} puan katıyor")
            if not t3:
                sebep.append(f"kaçan dilim genelin {kacan_k} katı riskli")

            if t1 and t2 and t3:
