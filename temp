import dataiku, zipfile, io

f = dataiku.Folder("LLM")

# zip'i belleğe al
with f.get_download_stream("/LLM.zip") as s:
    data = s.read()

with zipfile.ZipFile(io.BytesIO(data)) as z:
    for name in z.namelist():
        if name.endswith("/"):          # klasör girdilerini atla
            continue
        with z.open(name) as src:
            f.upload_stream("/" + name, src)
        print("eklendi:", name)

f.delete_path("/LLM.zip")
print("zip silindi")
