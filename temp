"""Feature grupları - hızlandırılmış sürüm.

Üretilen kolonlar, değerler ve dtype'lar orijinaliyle BİREBİR aynıdır.
Değişen tek şey hesaplama yöntemi. Yeni yardımcılar yalnızca ilgili
fonksiyonun İÇİNDE tanımlıdır; modül seviyesine hiçbir şey eklenmedi.
"""

import numpy as np
import pandas as pd
from fe_cells import _window, _exist, _sdiv, _summ, _trend_delta

COLOR_MAP = {0: 'INAKTIF', 1: 'KIRMIZI', 2: 'TURUNCU', 3: 'SARI',
             4: 'ACIK_YESIL', 5: 'YESIL', 6: 'KOYU_YESIL'}


def _renk_features(df):
    out = {}
    _summ(df, 'RENK', out, add_med=True)
    _trend_delta(df, 'RENK', out)
    all12 = _exist(df, _window('RENK')['all'])
    r3 = _exist(df, _window('RENK')['w3'])

    if {'RENK_LM', 'RENK_L3M'}.issubset(df.columns):
        out['RENK_DELTA_1_3'] = df['RENK_LM'] - df['RENK_L3M']

    idx = df.index

    # df[all12] orijinalde 10 kez ayrı ayrı materyalize ediliyordu
    # (7 renk sayacı + GOOD + MODE). Tek sefer numpy'a alıyoruz.
    M = df[all12].to_numpy(dtype="float64", na_value=np.nan) if all12 else None

    def _cnt_eq(v):
        """(df[all12] == v).sum(axis=1) ile aynı; NaN == v zaten False."""
        return pd.Series((M == v).sum(axis=1), index=idx)

    def _mode_first():
        """df[all12].mode(axis=1)[0] ile aynı.

        pandas satır başına mode hesaplıyor ve 200k satırda ~22s sürüyor.
        Değerler küçük bir kümeden geldiği için (renk kodları) her değerin
        satır bazlı sayımını tek geçişte çıkarıp argmax alıyoruz.
        argmax ilk maksimumu döndürür; uniq artan sıralı olduğundan bu
        pandas'ın döndürdüğü en küçük mod değerine karşılık gelir.
        """
        finite = M[~np.isnan(M)]
        if finite.size == 0:
            return pd.Series(np.full(len(df), np.nan), index=idx)
        uniq = np.unique(finite)
        if uniq.size > 64:                       # beklenmedik kardinalite
            return df[all12].mode(axis=1)[0]          # güvenli geri dönüş
        counts = np.empty((len(df), uniq.size), dtype=np.int8)
        for j, u in enumerate(uniq):
            counts[:, j] = (M == u).sum(axis=1)
        best = counts.argmax(1)
        res = uniq[best]
        res[counts.max(axis=1) == 0] = np.nan         # satırın tamamı NaN
        return pd.Series(res, index=idx)

    for v, n in COLOR_MAP.items():
        out[f'RENK_CNT_{n}'] = _cnt_eq(v)
    out['RENK_CNT_RISK'] = out['RENK_CNT_KIRMIZI'] + out['RENK_CNT_TURUNCU']
    out['RENK_CNT_GOOD'] = pd.Series((M >= 4).sum(axis=1), index=idx)
    out['RENK_RISK_RATIO'] = out['RENK_CNT_RISK'] / len(all12)
    out['RENK_RISK_IN_L3M'] = (df[r3] <= 2).any(axis=1).astype(int)
    out['RENK_DECLINING'] = ((df['RENK_LM'] < df['RENK_L2M']) &
                             (df['RENK_L2M'] < df['RENK_L3M'])).astype(int)
    out['RENK_IMPROVING'] = ((df['RENK_LM'] > df['RENK_L2M']) &
                             (df['RENK_L2M'] > df['RENK_L3M'])).astype(int)
    out['RENK_MODE_L12M'] = _mode_first()
    return out


def _dav_features(df):
    out = {}
    _summ(df, 'DAV_SKOR', out, prefix='DAV', add_med=False)
    _trend_delta(df, 'DAV_SKOR', out, prefix='DAV')
    if 'DAV_AVG_L12M' in out and 'DAV_STD_L12M' in out:
        out['DAV_CV_12M'] = np.where(out['DAV_AVG_L12M'] == 0, -99,
                                     out['DAV_STD_L12M'] / out['DAV_AVG_L12M'])
        out['DAV_RANGE_12M'] = out['DAV_MAX_L12M'] - out['DAV_MIN_L12M']
    return out


def _mms_features(df):
    out = {}
    _summ(df, 'MMS', out, add_med=False)
    _trend_delta(df, 'MMS', out)
    if 'MMS_AVG_L12M' in out and 'MMS_STD_L12M' in out:
        out['MMS_CV_12M'] = np.where(out['MMS_AVG_L12M'] == 0, -99,
                                     out['MMS_STD_L12M'] / out['MMS_AVG_L12M'])
    return out


def _ratio_features(df):
    # Bu fonksiyon zaten sadece skaler kolon aritmetiği yapıyor;
    # optimize edilecek tekrar eden iş yok, orijinaliyle aynı bırakıldı.
    out = {}
    if {'TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_4_6M'}.issubset(df.columns):
        out['TAUM_TREND_3_46'] = df['TAUM_TUT_AVG_3M'] - df['TAUM_TUT_AVG_4_6M']
    if {'TAUM_TUT_AVG_3M', 'TAUM_TUT_AVG_6M'}.issubset(df.columns):
        out['TAUM_RATIO_3_6'] = _sdiv(df['TAUM_TUT_AVG_3M'], df['TAUM_TUT_AVG_6M'])
    if {'SM_AKB_TAUM_TUT_AVG_L3M', 'TAUM_TUT_AVG_3M'}.issubset(df.columns):
        out['AKB_TAUM_ORAN'] = _sdiv(df['SM_AKB_TAUM_TUT_AVG_L3M'], df['TAUM_TUT_AVG_3M'])
    if {'BRY_KK_TOPLAM_ODEME_ORANI_L3M', 'BRY_KK_TOPLAM_ODEME_ORANI_L6M'}.issubset(df.columns):
        out['ODEME_TREND'] = (df['BRY_KK_TOPLAM_ODEME_ORANI_L3M']
                              - df['BRY_KK_TOPLAM_ODEME_ORANI_L6M'])
        out['ODEME_AVG'] = (df['BRY_KK_TOPLAM_ODEME_ORANI_L3M']
                            + df['BRY_KK_TOPLAM_ODEME_ORANI_L6M']) / 2
    if {'INT_SDM_BSVR_ADT_L3M', 'INT_SDM_BSVR_ADT_L6M'}.issubset(df.columns):
        out['BSVR_RATIO_3_6'] = _sdiv(df['INT_SDM_BSVR_ADT_L3M'], df['INT_SDM_BSVR_ADT_L6M'])
    if {'INT_SDM_A_EKOD_LM', 'INT_SDM_A_EKOD_L3M'}.issubset(df.columns):
        out['SDM_EKOD_DELTA'] = df['INT_SDM_A_EKOD_LM'] - df['INT_SDM_A_EKOD_L3M']
    if {'INT_SHM_A_EKOD_LM', 'INT_SHM_A_EKOD_L3M'}.issubset(df.columns):
        out['SHM_EKOD_DELTA'] = df['INT_SHM_A_EKOD_LM'] - df['INT_SHM_A_EKOD_L3M']
    return out


def _kkb_features(df):
    """KKB skor lag serilerinden ozet / trend / degisim feature'lari.

    Ozel durumlar:
      - skor == 0        -> KKB kaydi yok (gecmis yok). Istatistiklerde HARIC.
      - skor null/NaN    -> sorgu yapilmamis. Istatistiklerde HARIC.
    """
    base = 'KKB_SKOR'
    months = ['LM'] + [f'L{i}M' for i in range(2, 13)]
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return {}

    out = {}
    idx = df.index

    # Orijinalde her pencere icin valid[c] alt-DataFrame'i kopyalaniyordu
    # (9 kopya). Tek numpy matrisi + dilim indeksleri ile ayni sonuc.
    pos = {c: j for j, c in enumerate(cols)}
    R = df[cols].apply(pd.to_numeric, errors='coerce').to_numpy(dtype="float64",
                                                                na_value=np.nan)
    raw_nan = np.isnan(R)
    V = np.where(raw_nan | (R == 0), np.nan, R)      # gecersizler -> NaN
    ok = ~np.isnan(V)

    def _idx(keys):
        """Pencerede fiilen var olan kolonlarin matris indeksleri."""
        return [pos[f'{base}_{k}'] for k in keys if f'{base}_{k}' in pos]

    def _stats(j):
        """s.mean/std/min/max/median(1) ile birebir ayni besli."""
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        empty = cnt == 0
        safe = np.maximum(cnt, 1)
        tot = np.where(ok[:, j], s, 0.0).sum(axis=1)
        avg = tot / safe
        avg[empty] = np.nan
        ss = np.sort(s, axis=1)                      # NaN'lar sona
        c2 = cnt[:, None]
        lo = np.take_along_axis(ss, np.maximum(c2 - 1, 0) // 2, 1)[:, 0]
        hi = np.take_along_axis(ss, np.maximum(c2, 1) // 2, 1)[:, 0]
        med = (lo + hi) * 0.5
        mn = ss[:, 0].copy()
        mx = np.take_along_axis(ss, np.maximum(c2 - 1, 0), 1)[:, 0]
        med[empty] = np.nan
        mx[empty] = np.nan
        dev = np.where(ok[:, j], s - avg[:, None], 0.0)
        std = np.sqrt(np.einsum('ij,ij->i', dev, dev) / np.maximum(cnt - 1, 1))
        std[np.isnan(std)] = 0.0                     # orijinal .fillna(0)
        std[cnt <= 1] = 0.0
        return avg, std, mn, mx, med

    def _mean(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        m = np.where(ok[:, j], s, 0.0).sum(axis=1) / np.maximum(cnt, 1)
        m[cnt == 0] = np.nan
        return m

    windows = {
        '3M':   ['LM', 'L2M', 'L3M'],
        '6M':   ['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'],
        '12M':  months,
        '4_6M': ['L4M', 'L5M', 'L6M'],
        '6_9M': ['L6M', 'L7M', 'L8M', 'L9M'],
    }

    for tag, keys in windows.items():
        j = _idx(keys)
        if not j:
            continue
        avg, std, mn, mx, med = _stats(j)
        out[f'{base}_AVG_L{tag}'] = pd.Series(avg, index=idx, copy=False)
        out[f'{base}_STD_L{tag}'] = pd.Series(std, index=idx, copy=False)
        out[f'{base}_MIN_L{tag}'] = pd.Series(mn, index=idx, copy=False)
        out[f'{base}_MAX_L{tag}'] = pd.Series(mx, index=idx, copy=False)
        out[f'{base}_MED_L{tag}'] = pd.Series(med, index=idx, copy=False)

    j3, j46 = _idx(['LM', 'L2M', 'L3M']), _idx(['L4M', 'L5M', 'L6M'])
    j6 = _idx(['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'])
    j79 = _idx(['L7M', 'L8M', 'L9M'])
    if j3 and j46:
        out[f'{base}_TREND_3_46'] = pd.Series(_mean(j3) - _mean(j46), index=idx, copy=False)
    if j6 and j79:
        out[f'{base}_TREND_6_79'] = pd.Series(_mean(j6) - _mean(j79), index=idx, copy=False)

    lm, l2, l3 = f'{base}_LM', f'{base}_L2M', f'{base}_L3M'
    if lm in pos and l2 in pos:
        d = V[:, pos[lm]] - V[:, pos[l2]]
        out[f'{base}_DELTA_1_2'] = pd.Series(d, index=idx, copy=False)
        out[f'{base}_DELTA_PCT_1_2'] = _sdiv(d, V[:, pos[l2]])
    if lm in pos and l3 in pos:
        d13 = V[:, pos[lm]] - V[:, pos[l3]]
        out[f'{base}_DELTA_1_3'] = pd.Series(d13, index=idx, copy=False)
        out[f'{base}_CHG_L3M'] = pd.Series(d13.copy(), index=idx, copy=False)

    if f'{base}_AVG_L12M' in out and lm in pos:
        out[f'{base}_LM_BELOW_AVG12_FLG'] = (
            (pd.Series(V[:, pos[lm]], index=idx, copy=False)
             < out[f'{base}_AVG_L12M'])).astype('Int64').astype(float)

    out[f'{base}_VALID_CNT_L12M'] = pd.Series(ok.sum(axis=1), index=idx, copy=False)
    out[f'{base}_ZERO_CNT_L12M'] = pd.Series((R == 0).sum(axis=1), index=idx, copy=False)
    out[f'{base}_NULL_CNT_L12M'] = pd.Series(raw_nan.sum(axis=1), index=idx, copy=False)
    out[f'{base}_EVER_QUERIED_FLG'] = (out[f'{base}_VALID_CNT_L12M'] > 0).astype(int)

    return out


def _kk_features(df):
    """KK limit / risk / limit-kullanım-oranı (LKO) özetleri."""
    out = {}
    months = ['LM'] + [f'L{i}M' for i in range(2, 13)]

    for m in months:
        lim, rsk = f'KK_LIMIT_{m}', f'KK_RISK_{m}'
        if lim in df.columns and rsk in df.columns:
            out[f'KK_LKO_{m}'] = _sdiv(df[rsk], df[lim])
    lko = pd.DataFrame(out, index=df.index)

    _summ(df,  'KK_LIMIT', out, add_med=True)
    _summ(df,  'KK_RISK',  out, add_med=True)
    _summ(lko, 'KK_LKO',   out, add_med=True)

    _trend_delta(df,  'KK_LIMIT', out)
    _trend_delta(df,  'KK_RISK',  out)
    _trend_delta(lko, 'KK_LKO',   out)

    def _avg3(data, w3):
        """data[w3].mean(axis=1) ile aynı; alt-DataFrame kopyası çıkarmadan."""
        A = data[w3].to_numpy(dtype="float64", na_value=np.nan)
        ok = ~np.isnan(A)
        cnt = ok.sum(axis=1)
        m = np.where(ok, A, 0.0).sum(axis=1) / np.maximum(cnt, 1)
        m[cnt == 0] = np.nan
        return m

    for base, data in (('KK_LIMIT', df), ('KK_RISK', df), ('KK_LKO', lko)):
        lm, l2 = f'{base}_LM', f'{base}_L2M'
        if lm in data.columns and l2 in data.columns:
            a = data[lm].to_numpy(dtype="float64", na_value=np.nan)
            b = data[l2].to_numpy(dtype="float64", na_value=np.nan)
            out[f'{base}_DELTA_PCT_LM_L2M'] = _sdiv(a - b, b)
            out[f'{base}_INC_LM_L2M_FLG'] = (data[lm] > data[l2]).astype(int)
            out[f'{base}_DEC_LM_L2M_FLG'] = (data[lm] < data[l2]).astype(int)
        w3 = _exist(data, _window(base)['w3'])
        if lm in data.columns and w3:
            out[f'{base}_LM_TO_AVG_L3M'] = _sdiv(data[lm], _avg3(data, w3))
    return out


def _odeme_features(df):
    """KK ödeme oranı (paid/statement) davranış özetleri."""
    out = {}
    base = 'KK_ODEME_ORANI'
    months = ['LM'] + [f'L{i}M' for i in range(2, 13)]
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return out

    idx = df.index
    # s = df[cols] orijinalde iki ayrı boolean DataFrame üretiyordu
    S = df[cols].to_numpy(dtype="float64", na_value=np.nan)

    _summ(df, base, out, prefix='ODM', add_med=True)
    _trend_delta(df, base, out, prefix='ODM')

    if 'ODM_AVG_L12M' in out and 'ODM_STD_L12M' in out:
        out['ODM_CV_12M'] = np.where(out['ODM_AVG_L12M'] == 0, -99,
                                     out['ODM_STD_L12M'] / out['ODM_AVG_L12M'])

    out['ODM_LOW_CNT_L12M'] = pd.Series((S < 20).sum(axis=1), index=idx, copy=False)
    out['ODM_FULL_CNT_L12M'] = pd.Series((S >= 100).sum(axis=1), index=idx, copy=False)
    out['ODM_LOW_RATIO_L12M'] = out['ODM_LOW_CNT_L12M'] / len(cols)

    r3 = _exist(df, [f'{base}_LM', f'{base}_L2M', f'{base}_L3M'])
    if r3:
        j = [cols.index(c) for c in r3]
        out['ODM_LOW_IN_L3M'] = pd.Series((S[:, j] < 20).any(axis=1), index=idx).astype(int)

    if 'ODM_AVG_L12M' in out and f'{base}_LM' in df.columns:
        out['ODM_LM_BELOW_AVG'] = (df[f'{base}_LM'] < out['ODM_AVG_L12M']).astype(int)
        out['ODM_LM_TO_AVG_L12M'] = _sdiv(df[f'{base}_LM'], out['ODM_AVG_L12M'])

    if {f'{base}_LM', f'{base}_L2M', f'{base}_L3M'}.issubset(df.columns):
        out['ODM_DECLINING_3M'] = (
            (df[f'{base}_LM'] < df[f'{base}_L2M']) &
            (df[f'{base}_L2M'] < df[f'{base}_L3M'])
        ).astype(int)

    return out


def feature_engineering(df):
    """Tüm feature gruplarını üretir. (df_eng, yeni_feature_isimleri) döner."""
    out = {}
    for fn in (_renk_features, _dav_features, _mms_features, _kkb_features,
               _odeme_features, _ratio_features, _kk_features):
        out.update(fn(df))
    eng = pd.DataFrame(out, index=df.index)
    eng = eng.loc[:, ~eng.columns.duplicated()]
    return pd.concat([df, eng], axis=1), list(eng.columns)
