import dataiku, zipfile, io, os, posixpath

# ==================== AYARLAR ====================
FOLDER_ID   = "GOC_MODEL_RESULTS"  # Dataiku managed folder'ın adı / ID'si
ZIP_NAME    = None   # None -> klasördeki ilk .zip'i bulur.
                     # "LLM_BIREYSEL (1).zip" gibi yazarsan sadece onu açar.
TARGET_NAME = None   # None -> hedef klasör adı zip dosyasının adından üretilir
                     # ("MODEL_RESULTS (2).zip" -> "MODEL_RESULTS (2)").
                     # "LLM_BIREYSEL" gibi yazarsan içerik o isimli klasöre gider.
DELETE_ZIP  = True   # İşlem bittikten sonra zip dosyası silinsin mi?
OVERWRITE   = True   # Hedefte aynı isimli dosya varsa üzerine yazılsın mı (False -> atlanır)
# =================================================

f = dataiku.Folder(FOLDER_ID)

# --- 1) Folder içindeki dosyaları listele, açılacak zip'i belirle ---
paths = f.list_paths_in_partition()          # ör: ['/MODEL_RESULTS (2).zip', '/baska.csv']
zip_candidates = [p for p in paths if p.lower().endswith(".zip")]

if not zip_candidates:
    raise Exception("Klasörde .zip dosyası bulunamadı: " + str(paths))

if ZIP_NAME:
    # Kullanıcı belirli bir zip adı verdiyse onu ara (baştaki '/' farkını tolere et)
    matches = [p for p in zip_candidates if os.path.basename(p) == ZIP_NAME]
    if not matches:
        raise Exception(
            "'%s' adlı zip bulunamadı. Mevcut zip'ler: %s" % (ZIP_NAME, zip_candidates)
        )
    zip_path = matches[0]
else:
    zip_path = zip_candidates[0]             # verilmediyse ilk zip

# --- 2) Hedef klasör adını belirle ---
zip_basename = os.path.basename(zip_path)                 # 'MODEL_RESULTS (2).zip'
derived_name = os.path.splitext(zip_basename)[0]          # 'MODEL_RESULTS (2)'
target_name  = (TARGET_NAME or derived_name).strip("/")   # kullanıcı verdiyse onu kullan

print("Açılacak zip :", zip_path)
print("Hedef klasör :", "/" + target_name)

# --- 3) Zip'i folder'dan belleğe indir ---
with f.get_download_stream(zip_path) as s:
    data = s.read()

existing = set(paths)   # OVERWRITE=False iken çakışma kontrolü için

# --- 4) Zip içeriğini /<target_name>/ altına yaz ---
count, skipped = 0, 0
with zipfile.ZipFile(io.BytesIO(data)) as z:
    for entry in z.namelist():
        if entry.endswith("/"):
            continue                                   # klasör kaydı, dosya değil -> atla

        # Güvenlik: zip içinde '../' veya '/x' gibi kaçış yolları varsa temizle (zip-slip)
        safe_entry = posixpath.normpath(entry.replace("\\", "/")).lstrip("/")
        if safe_entry.startswith("..") or safe_entry in (".", ""):
            print("atlandı (güvensiz yol):", entry)
            skipped += 1
            continue

        dest_path = "/" + target_name + "/" + safe_entry   # ASIL DEĞİŞİKLİK: alt klasör altına yaz

        if not OVERWRITE and dest_path in existing:
            print("atlandı (zaten var):", dest_path)
            skipped += 1
            continue

        with z.open(entry) as src:
            f.upload_stream(dest_path, src)            # ara klasörler otomatik oluşur
        print("eklendi:", dest_path)
        count += 1

print("Toplam yazılan dosya: %d, atlanan: %d" % (count, skipped))

# --- 5) İstenirse kaynak zip'i sil ---
if DELETE_ZIP:
    f.delete_path(zip_path)
    print("zip silindi:", zip_path)
else:
    print("zip korundu:", zip_path)
