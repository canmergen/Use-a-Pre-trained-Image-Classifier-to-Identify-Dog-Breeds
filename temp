WITH INP_DEDUP AS (
    SELECT
        KDS_TON_ONAY_MBB_NO,
        KDS_TON_ONAY_SM_ID,
        MAX(KDS_TON_ONAY_O5233) AS MMS_BATCH,
        MAX(KDS_TON_ONAY_O0120) AS KKB_SKOR
    FROM PKRA.KRA_TSM_BATCH_INPUT
    GROUP BY
        KDS_TON_ONAY_MBB_NO,
        KDS_TON_ONAY_SM_ID
),
ONONY AS (
    SELECT
        A.MBB_NO,
        LAST_DAY(TRUNC(A.KDS_TON_ONAY_ISLEM_ZAMANI)) AS AY_SONU,
        INP.MMS_BATCH,
        INP.KKB_SKOR
    FROM (
        SELECT
            KDS_LOB_MBB_NO AS MBB_NO,
            KDS_LOB_SM_ID  AS SM_ID,
            KDS_LOB_ISLEM_ZAMANI AS KDS_TON_ONAY_ISLEM_ZAMANI,
            ROW_NUMBER() OVER (
                PARTITION BY
                    KDS_LOB_MBB_NO,
                    LAST_DAY(TRUNC(KDS_LOB_ISLEM_ZAMANI))
                ORDER BY
                    KDS_LOB_ISLEM_ZAMANI DESC
            ) AS RW_NB
        FROM PODS.KDS_TONL_LOG_BRY_KRD
        WHERE KDS_LOB_BASVURU_TIP = 'ONONY'
          AND KDS_LOB_ISLEM_ZAMANI >= TO_DATE('01.04.2024', 'dd.mm.yyyy')
          AND KDS_LOB_ISLEM_ZAMANI <  TO_DATE('30.11.2025', 'dd.mm.yyyy') + 1
    ) A
    LEFT JOIN INP_DEDUP INP
           ON A.MBB_NO = INP.KDS_TON_ONAY_MBB_NO
          AND A.SM_ID  = INP.KDS_TON_ONAY_SM_ID
    WHERE A.RW_NB = 1
),
PORTFOY AS (
    SELECT *
    FROM "SBXKVA"."MUS_YENI_RENKLER_TUM_PORTFOY"
    WHERE DONEM IN (202506, 202504, 202511)
)
SELECT
    T1.*,
    T2.MMS_BATCH  AS MMS_LM,
    T3.MMS_BATCH  AS MMS_L2M,
    T4.MMS_BATCH  AS MMS_L3M,
    T5.MMS_BATCH  AS MMS_L4M,
    T6.MMS_BATCH  AS MMS_L5M,
    T7.MMS_BATCH  AS MMS_L6M,
    T8.MMS_BATCH  AS MMS_L7M,
    T9.MMS_BATCH  AS MMS_L8M,
    T10.MMS_BATCH AS MMS_L9M,
    T11.MMS_BATCH AS MMS_L10M,
    T12.MMS_BATCH AS MMS_L11M,
    T13.MMS_BATCH AS MMS_L12M,
    T14.MMS_BATCH AS MMS,
    T2.KKB_SKOR   AS KKB_SKOR_LM,
    T3.KKB_SKOR   AS KKB_SKOR_L2M,
    T4.KKB_SKOR   AS KKB_SKOR_L3M,
    T5.KKB_SKOR   AS KKB_SKOR_L4M,
    T6.KKB_SKOR   AS KKB_SKOR_L5M,
    T7.KKB_SKOR   AS KKB_SKOR_L6M,
    T8.KKB_SKOR   AS KKB_SKOR_L7M,
    T9.KKB_SKOR   AS KKB_SKOR_L8M,
    T10.KKB_SKOR  AS KKB_SKOR_L9M,
    T11.KKB_SKOR  AS KKB_SKOR_L10M,
    T12.KKB_SKOR  AS KKB_SKOR_L11M,
    T13.KKB_SKOR  AS KKB_SKOR_L12M,
    T14.KKB_SKOR  AS KKB_SKOR
FROM PORTFOY T1
LEFT JOIN ONONY T2
       ON T1.MBB_NO = T2.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -1)) = T2.AY_SONU
LEFT JOIN ONONY T3
       ON T1.MBB_NO = T3.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -2)) = T3.AY_SONU
LEFT JOIN ONONY T4
       ON T1.MBB_NO = T4.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -3)) = T4.AY_SONU
LEFT JOIN ONONY T5
       ON T1.MBB_NO = T5.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -4)) = T5.AY_SONU
LEFT JOIN ONONY T6
       ON T1.MBB_NO = T6.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -5)) = T6.AY_SONU
LEFT JOIN ONONY T7
       ON T1.MBB_NO = T7.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -6)) = T7.AY_SONU
LEFT JOIN ONONY T8
       ON T1.MBB_NO = T8.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -7)) = T8.AY_SONU
LEFT JOIN ONONY T9
       ON T1.MBB_NO = T9.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -8)) = T9.AY_SONU
LEFT JOIN ONONY T10
       ON T1.MBB_NO = T10.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -9)) = T10.AY_SONU
LEFT JOIN ONONY T11
       ON T1.MBB_NO = T11.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -10)) = T11.AY_SONU
LEFT JOIN ONONY T12
       ON T1.MBB_NO = T12.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -11)) = T12.AY_SONU
LEFT JOIN ONONY T13
       ON T1.MBB_NO = T13.MBB_NO
      AND LAST_DAY(ADD_MONTHS(TRUNC(T1.TARIH), -12)) = T13.AY_SONU
LEFT JOIN ONONY T14
       ON T1.MBB_NO = T14.MBB_NO
      AND LAST_DAY(TRUNC(T1.TARIH)) = T14.AY_SONU
