# --- RENK GEÇİŞ ANALİZİ ---
# Dönem bazında: müşterinin ŞU ANKİ rengi (satır) -> k ay sonraki rengi (sütun)
# Her ufuk (RENK_SONRAKI_AY .. RENK_SONRAKI_6AY) için adet + satır-% tablosu

SNK_COLS = ['RENK_SONRAKI_AY'] + [f'RENK_SONRAKI_{k}AY' for k in range(2, 7)]
SNK_COLS = [c for c in SNK_COLS if c in df.columns]

SADECE_KK    = True    # False yaparsan tüm portföy
YUZDE_GOSTER = True    # False yaparsan sadece adet tabloları

_d = df[df['KK_URUN_FLG'] == 'KK'] if SADECE_KK else df

for _don in sorted(_d['DONEM'].dropna().astype(int).unique()):
    _m = _d['DONEM'] == _don
    _renk = _d.loc[_m, 'RENK'].fillna('(bos)')
    print("=" * 110)
    print(f"DONEM {_don}   (satır: {int(_m.sum()):,}"
          + (", sadece KK" if SADECE_KK else ", tüm portföy") + ")")

    for _col in SNK_COLS:
        _snk = _d.loc[_m, _col].fillna('(bos)')

        ct = pd.crosstab(_renk, _snk, margins=True, margins_name='TOPLAM')
        print(f"\n--- {_don} | RENK -> {_col}  (ADET) ---")
        print(ct.to_string())

        if YUZDE_GOSTER:
            pct = (pd.crosstab(_renk, _snk, normalize='index') * 100).round(1)
            print(f"--- {_don} | RENK -> {_col}  (SATIR %) ---")
            print(pct.to_string())
