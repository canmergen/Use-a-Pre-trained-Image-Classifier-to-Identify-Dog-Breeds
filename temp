# =========================================================
# 1) Elenen yeni feature'ların hangi feature(ler)le yüksek
#    korelasyonlu olduğunu bulma (Spearman |r| > CORR_ESIK)
# =========================================================

elenen_kontrol = [c for c in _yeni_kolonlar if c in df_train_raw.columns
                  and c not in imp_df["feature"].values]
print(f"Elenen yeni feature'lar: {elenen_kontrol}\n")

# Tüm sayısal kolonlarla (final FEATURES + elenenler dahil, TARGET hariç)
# rank-tabanlı Spearman korelasyonu tek seferde hesaplıyoruz.
_tum_num_cols = [c for c in df_train_raw.columns
                 if c != TARGET and pd.api.types.is_numeric_dtype(df_train_raw[c])]

_R_all = df_train_raw[_tum_num_cols].rank().to_numpy(dtype="float64")
_R_all = (_R_all - np.nanmean(_R_all, axis=0)) / np.maximum(np.nanstd(_R_all, axis=0), 1e-9)
_R_all = np.nan_to_num(_R_all)
_pos_all = {c: i for i, c in enumerate(_tum_num_cols)}

for feat in elenen_kontrol:
    if feat not in _pos_all:
        print(f"[{feat}] sayısal değil veya bulunamadı, atlandı.")
        continue
    i = _pos_all[feat]
    corr_vec = np.abs(_R_all.T @ _R_all[:, [i]] / len(_R_all)).flatten()
    _s = pd.Series(corr_vec, index=_tum_num_cols).drop(feat)
    _yuksek = _s[_s > CORR_ESIK].sort_values(ascending=False)
    print(f"\n[{feat}] ile |Spearman r| > {CORR_ESIK} olan feature'lar:")
    if len(_yuksek):
        display(_yuksek.rename("abs_corr").to_frame())
    else:
        print("  (Bu eşiğin üzerinde eşleşme yok — muhtemelen sabit değişken/PSI adımında elendi, korelasyon değil.)")

    # tgt_assoc karşılaştırması: hangisi hedefi daha iyi açıklıyordu, o yüzden mi elendi?
    if feat in tgt_assoc:
        print(f"  {feat} tgt_assoc = {tgt_assoc.get(feat, 0):.4f}")
        for rakip in _yuksek.index[:3]:
            print(f"    rakip {rakip} tgt_assoc = {tgt_assoc.get(rakip, 0):.4f}")

# =========================================================
# 2) SADECE yeni H01-H06 feature'larıyla mini model
#    (eleme adımı YOK, direkt bu feature'larla fit)
# =========================================================

FEATURES_YENI = _yeni_kolonlar.copy()
print(f"Kullanılan feature sayısı: {len(FEATURES_YENI)} -> {FEATURES_YENI}")

X_tr_y  = df_train_raw[FEATURES_YENI].fillna(-999)
X_val_y = df_val_raw[FEATURES_YENI].fillna(-999)
X_oot_y = df_oot_raw[FEATURES_YENI].fillna(-999)
y_tr_y, y_val_y, y_oot_y = df_train_raw[TARGET], df_val_raw[TARGET], df_oot_raw[TARGET]

model_yeni = lgb.LGBMClassifier(objective='binary', metric='auc', max_bin=63,
                                 random_state=RANDOM_STATE, n_jobs=LGB_JOBS, verbose=-1,
                                 max_depth=4, num_leaves=31, n_estimators=300,
                                 learning_rate=0.05, min_child_samples=50)
model_yeni.fit(X_tr_y, y_tr_y)

tr_prob_y  = model_yeni.predict_proba(X_tr_y)[:, 1]
val_prob_y = model_yeni.predict_proba(X_val_y)[:, 1]
oot_prob_y = model_yeni.predict_proba(X_oot_y)[:, 1]

tr_gini_y  = 2 * roc_auc_score(y_tr_y, tr_prob_y) - 1
val_gini_y = 2 * roc_auc_score(y_val_y, val_prob_y) - 1
oot_gini_y = 2 * roc_auc_score(y_oot_y, oot_prob_y) - 1 if y_oot_y.nunique() >= 2 else None

print(f"\n✓ SADECE YENİ FEATURE'LAR (H01-H06) İLE MODEL")
print(f"  gini -> train={tr_gini_y:.4f}  val={val_gini_y:.4f}  oot={oot_gini_y:.4f}")

# Karşılaştırma için tüm-model (150 feature) sonuçlarıyla yan yana
print(f"\n--- Karşılaştırma ---")
print(f"  tüm model (150 feature) -> train={ozet['train_gini']}  val={ozet['val_gini']}  oot={ozet['oot_gini']}")
print(f"  sadece yeniler (11 feat) -> train={tr_gini_y:.4f}  val={val_gini_y:.4f}  oot={oot_gini_y:.4f}")

_yaz("sadece_yeni_feature_model_ozet.csv", pd.DataFrame([{
    "n_feature": len(FEATURES_YENI),
    "train_gini": round(tr_gini_y, 4),
    "val_gini": round(val_gini_y, 4),
    "oot_gini": round(oot_gini_y, 4) if oot_gini_y is not None else None,
}]))
print("\n✓ Sonuç dosyaya yazıldı: sadece_yeni_feature_model_ozet.csv")












