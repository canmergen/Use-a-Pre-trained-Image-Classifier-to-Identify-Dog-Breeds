select
  DONEM,
  to_char(count(*), 'FM999,999,999,999')                          as SATIR,
  to_char(count(distinct MBB_NO), 'FM999,999,999,999')            as TEKIL_MBB,
  sum(case when TARIH != trunc(TARIH) then 1 else 0 end)          as SAAT_ICEREN,
  sum(case when TARIH != LAST_DAY(TARIH) then 1 else 0 end)       as AY_SONU_DEGIL,
  count(distinct TARIH)                                            as FARKLI_TARIH,
  min(TARIH)                                                       as MIN_TARIH,
  max(TARIH)                                                       as MAX_TARIH,
  sum(case when MBB_NO is null then 1 else 0 end)                 as MBB_NULL
from "SBXKVA"."MUS_YENI_RENKLER_TUM_PORTFOY"
where "DONEM" in (202506, 202504, 202511)
group by DONEM
order by DONEM
