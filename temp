        _L = df_raw.loc[
            pd.to_numeric(df_raw[KONTROL_RAW_DONEM],
                          errors='coerce') == OOT_DONEM,
            [KONTROL_RAW_ID] + _snk_cols].copy()
        if _L.empty:
            raise RuntimeError(f"df_raw'da DONEM={OOT_DONEM} satırı yok")

        def _kirmizi_mi(v):
            sv = str(v).strip()
            return sv.startswith('1') and not sv.startswith(('10', '11', '12'))

        _ilk = pd.Series(np.nan, index=_L.index)
        for k in range(6, 0, -1):                 # ay6→ay1: küçük ay ezsin
            _ilk[_L[_snk_cols[k - 1]].map(_kirmizi_mi)] = k
        _ids = pd.to_numeric(_L[KONTROL_RAW_ID], errors='coerce')
        _ILK_KIRMIZI = (pd.Series(_ilk.values, index=_ids.values)
                          .dropna().groupby(level=0).min())
        _ILK_KIRMIZI.index = _ILK_KIRMIZI.index.astype('int64')
        _df_ids = pd.to_numeric(df.loc[df['DONEM'] == OOT_DONEM, ID_COL],
                                errors='coerce').dropna().astype('int64').unique()
        _kaps = pd.Index(_df_ids).isin(
            pd.Index(_ids.dropna().astype('int64').unique())).mean()
        print(f"KONTROL kaynağı: df_raw RENK_SONRAKI_1..6AY "
              f"(DONEM={OOT_DONEM}, {len(_L):,} satır, kırmızı göreni "
              f"{len(_ILK_KIRMIZI):,}) | df OOT kapsanma: {_kaps:.1%}"
              + ("  ⚠ DÜŞÜK — ID/DONEM eşleşmesini kontrol edin!"
                 if _kaps < 0.95 else ""))
    except Exception as e:
        print(f"⚠ df_raw kullanılamadı ({e}) → df_aylik'e düşülüyor")
        _ILK_KIRMIZI = None
elif KONTROL_KAYNAK == 'df_raw':
    print("⚠ df_raw bellekte yok → df_aylik'e düşülüyor")

if _ILK_KIRMIZI is None:                          # df_aylik yolu / fallback
    KONTROL_AYLAR   = [_ay_ekle(OOT_DONEM, i) for i in range(1, 7)]
    _kontrol_mevcut = sorted(set(df['DONEM'].unique()) & set(KONTROL_AYLAR))
    KONTROL_EKSIK   = [a for a in KONTROL_AYLAR if a not in _kontrol_mevcut]
    if KONTROL_EKSIK:
