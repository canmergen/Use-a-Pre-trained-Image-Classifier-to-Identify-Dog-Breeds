target_col = "TGT_CS_ALL_TKP_ST_5M90"

period_target = (
    df.groupby("PERIOD")[target_col]
    .value_counts()
    .unstack(fill_value=0)
    .rename(columns={0.0: "TARGET_0", 1.0: "TARGET_1"})
)

period_target["TOPLAM"] = period_target["TARGET_0"] + period_target["TARGET_1"]
period_target["TARGET_1_PCT"] = (period_target["TARGET_1"] / period_target["TOPLAM"] * 100).round(2)
period_target["TARGET_0_PCT"] = (period_target["TARGET_0"] / period_target["TOPLAM"] * 100).round(2)

period_target = period_target.sort_index()
period_target
