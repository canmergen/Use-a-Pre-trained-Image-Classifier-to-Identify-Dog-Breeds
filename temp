# Ortalama tutar farkı (gelen - giden), son 3 gün
df["H05_AVG_DIFF_3D"] = df["TXN_GLN_3D_AMT_AVG"] - df["TXN_GDN_3D_AMT_AVG"]

# Aynı fark, önceki blok (3-6 gün)
df["H05_AVG_DIFF_3D_6D"] = df["TXN_GLN_3D_6D_AMT_AVG"] - df["TXN_GDN_3D_6D_AMT_AVG"]

# Farkın önceki bloğa göre değişimi (hipotezin sorduğu "artış")
df["H05_DIFF_CHG"] = df["H05_AVG_DIFF_3D"] - df["H05_AVG_DIFF_3D_6D"]

# Ölçekten arındırılmış hali (tutar büyüklüğüne bağımlı değil)
df["H05_AVG_DIFF_NORM"] = (df["TXN_GLN_3D_AMT_AVG"] - df["TXN_GDN_3D_AMT_AVG"]) / (df["TXN_GLN_3D_AMT_AVG"] + df["TXN_GDN_3D_AMT_AVG"] + 1)
