    for col in JOIN_KEYS:
        df_analiz[col] = pd.to_numeric(df_analiz[col], errors="coerce").astype("Int64")

    # --- 2b) RENK kodunu türet ('1-Kırmızı' → 1) --------------------
    # df_raw'daki RENK string etiket; int kodla karşılaştırma hiç
    # eşleşmiyordu (tüm renk blokları 0 satır kalmıştı). Etiketin
    # başındaki sayı ayrıştırılıp RENK_KOD olarak kullanılır; RENK
