mf   = dataiku.Folder("MODEL_RESULTS")   # ekrandaki ana folder
PATH = "/" + FOLDER.strip("/")           # -> "/renk_gecis_model_3mdeneme_updt_v3"

def save(dosya_adi, veri_bytes):
    """MODEL_RESULTS/<FOLDER>/<dosya_adi> yoluna yazar; yoksa oluşur, varsa üzerine yazar."""
    hedef = PATH + "/" + dosya_adi.lstrip("/")
    with mf.get_writer(hedef) as w:
        w.write(veri_bytes)
    print("Yazildi:", hedef)
    return hedef

