def _mf_yollar(folder=None):
    """Folder içindeki tüm dosya yollarını döner.
    Bu folder'da list_paths_in_partition() boş dönüyor (UI'da dosyalar
    görünmesine rağmen), o yüzden yedek olarak get_path_details ile
    kökten aşağı recursive gezilir."""
    folder = folder or mf
    try:
        yollar = folder.list_paths_in_partition()
        if yollar:
            return yollar
    except Exception:
        pass

    bulunan = []

    def _gez(p):
        try:
            det = folder.get_path_details(path=p)
        except Exception:
            return
        for c in det.get("children", []):
            tam = c.get("fullPath")
            if not tam:
                continue
            if c.get("directory"):
                _gez(tam)
            else:
                bulunan.append(tam)

    _gez("/")
    return bulunan

def klasor_var(alt_yol, folder=None):
    """MODEL_RESULTS içinde alt_yol klasörü var mı (= içinde en az bir dosya var mı)."""
    p = "/" + str(alt_yol).strip("/")
    return any(x.startswith(p + "/") for x in _mf_yollar(folder))

def dosya_var(alt_yol, fname, folder=None):
    """alt_yol klasöründe fname dosyası var mı."""
    hedef = "/" + str(alt_yol).strip("/") + "/" + str(fname).lstrip("/")
    return hedef in _mf_yollar(folder)

