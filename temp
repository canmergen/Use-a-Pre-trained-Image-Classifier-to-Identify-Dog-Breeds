def _sdiv(a, b):
    """Geçersiz bölme -> -99 sentineli. Bölme sadece geçerli yerlerde yapılır.

    DEĞİŞİKLİK: Eskiden sadece payda 0/NaN ise -99 dönüyordu; pay NaN ise
    sonuç NaN kalıyordu (aynı feature'da -99 ve NaN karışıyordu).
    Artık pay NaN da geçersiz sayılır -> tek tip sentinel -99.
    """
    a = np.asarray(a, dtype="float64")
    b = np.asarray(b, dtype="float64")
    shape = np.broadcast(a, b).shape
    bad = np.isnan(a) | (b == 0) | np.isnan(b)
    return np.divide(a, b, out=np.full(shape, -99.0), where=~bad)


def _renk_features(df):
    out = {}
    _summ(df, 'RENK', out, add_med=True)
    _trend_delta(df, 'RENK', out)
    all12 = _exist(df, _window('RENK')['all'])
    r3 = _exist(df, _window('RENK')['w3'])

    if {'RENK_LM', 'RENK_L3M'}.issubset(df.columns):
        out['RENK_DELTA_1_3'] = df['RENK_LM'] - df['RENK_L3M']

    # DEĞİŞİKLİK 1: hiç RENK lag kolonu yoksa erken çık.
    # Eskiden M = None oluyor, aşağıda (M == v) / (M >= 4) / len(all12)
    # patlıyordu. Diğer fonksiyonlarla (_kkb_features vb.) tutarlı.
    if not all12:
        return out

    idx = df.index
    M = df[all12].to_numpy(dtype="float64", na_value=np.nan)

    def _cnt_eq(v):
        """(df[all12] == v).sum(axis=1) ile aynı; NaN == v zaten False."""
        return pd.Series((M == v).sum(axis=1), index=idx)

    def _mode_first():
        """df[all12].mode(axis=1)[0] ile aynı."""
        finite = M[~np.isnan(M)]
        if finite.size == 0:
            return pd.Series(np.full(len(df), np.nan), index=idx)
        uniq = np.unique(finite)
        if uniq.size > 64:
            return df[all12].mode(axis=1)[0]
        counts = np.empty((len(df), uniq.size), dtype=np.int8)
        for j, u in enumerate(uniq):
            counts[:, j] = (M == u).sum(axis=1)
        best = counts.argmax(1)
        res = uniq[best]
        res[counts.max(axis=1) == 0] = np.nan
        return pd.Series(res, index=idx)

    for v, n in COLOR_MAP.items():
        out[f'RENK_CNT_{n}'] = _cnt_eq(v)
    out['RENK_CNT_RISK'] = out['RENK_CNT_KIRMIZI'] + out['RENK_CNT_TURUNCU']
    out['RENK_CNT_GOOD'] = pd.Series((M >= 4).sum(axis=1), index=idx)
    out['RENK_RISK_RATIO'] = out['RENK_CNT_RISK'] / len(all12)
    out['RENK_RISK_IN_L3M'] = (df[r3] <= 2).any(1).astype(int)

    # DEĞİŞİKLİK 2: eskiden guard'sız df['RENK_LM'] vb. okunuyordu,
    # kolonlardan biri eksikse KeyError atıyordu. DELTA_1_3'teki
    # issubset guard'ının aynısı eklendi.
    if {'RENK_LM', 'RENK_L2M', 'RENK_L3M'}.issubset(df.columns):
        out['RENK_DECLINING'] = ((df['RENK_LM'] < df['RENK_L2M']) &
                                 (df['RENK_L2M'] < df['RENK_L3M'])).astype(int)
        out['RENK_IMPROVING'] = ((df['RENK_LM'] > df['RENK_L2M']) &
                                 (df['RENK_L2M'] > df['RENK_L3M'])).astype(int)

    out['RENK_MODE_L12M'] = _mode_first()
    return out


def _dav_features(df):
    out = {}
    _summ(df, 'DAV_SKOR', out, prefix='DAV', add_med=False)
    _trend_delta(df, 'DAV_SKOR', out, prefix='DAV')
    if 'DAV_AVG_L12M' in out and 'DAV_STD_L12M' in out:
        # DEĞİŞİKLİK: np.where iki dalı da hesaplıyordu, AVG=0 satırlarında
        # division warning basıyordu. _sdiv sadece geçerli yerlerde bölüyor.
        # Davranış farkı: AVG NaN olan satırlar artık NaN değil -99
        # (tek sentinel politikasıyla tutarlı).
        out['DAV_CV_12M'] = pd.Series(
            _sdiv(out['DAV_STD_L12M'], out['DAV_AVG_L12M']),
            index=df.index, copy=False)
        out['DAV_RANGE_12M'] = out['DAV_MAX_L12M'] - out['DAV_MIN_L12M']
    return out


def _mms_features(df):
    out = {}
    _summ(df, 'MMS', out, add_med=False)
    _trend_delta(df, 'MMS', out)
    if 'MMS_AVG_L12M' in out and 'MMS_STD_L12M' in out:
        # DEĞİŞİKLİK: _dav_features'taki ile aynı (_sdiv, warning yok,
        # AVG NaN -> -99).
        out['MMS_CV_12M'] = pd.Series(
            _sdiv(out['MMS_STD_L12M'], out['MMS_AVG_L12M']),
            index=df.index, copy=False)
    return out


def _odeme_features(df):
    """KK ödeme oranı (paid/statement) davranış özetleri."""
    out = {}
    base = 'KK_ODEME_ORANI'
    months = ['LM'] + [f'L{i}M' for i in range(2, 13)]
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return out

    idx = df.index
    S = df[cols].to_numpy(dtype="float64", na_value=np.nan)

    _summ(df, base, out, prefix='ODM', add_med=True)
    _trend_delta(df, base, out, prefix='ODM')

    if 'ODM_AVG_L12M' in out and 'ODM_STD_L12M' in out:
        # DEĞİŞİKLİK: np.where yerine _sdiv (warning yok, AVG NaN -> -99).
        out['ODM_CV_12M'] = pd.Series(
            _sdiv(out['ODM_STD_L12M'], out['ODM_AVG_L12M']),
            index=idx, copy=False)

    out['ODM_LOW_CNT_L12M'] = pd.Series((S < 20).sum(axis=1), index=idx, copy=False)
    out['ODM_FULL_CNT_L12M'] = pd.Series((S >= 100).sum(axis=1), index=idx, copy=False)
    out['ODM_LOW_RATIO_L12M'] = out['ODM_LOW_CNT_L12M'] / len(cols)

    r3 = _exist(df, [f'{base}_LM', f'{base}_L2M', f'{base}_L3M'])
    if r3:
        j = [cols.index(c) for c in r3]
        out['ODM_LOW_IN_L3M'] = pd.Series((S[:, j] < 20).any(axis=1),
                                          index=idx).astype(int)

    if 'ODM_AVG_L12M' in out and f'{base}_LM' in df.columns:
        out['ODM_LM_BELOW_AVG'] = (df[f'{base}_LM'] < out['ODM_AVG_L12M']).astype(int)
        out['ODM_LM_TO_AVG_L12M'] = _sdiv(df[f'{base}_LM'], out['ODM_AVG_L12M'])

    if {f'{base}_LM', f'{base}_L2M', f'{base}_L3M'}.issubset(df.columns):
        out['ODM_DECLINING_3M'] = (
            (df[f'{base}_LM'] < df[f'{base}_L2M']) &
            (df[f'{base}_L2M'] < df[f'{base}_L3M'])
        ).astype(int)
    return out


def _kkb_features(df):
    """KKB skor lag serilerinden ozet / trend / degisim feature'lari.

    Ozel durumlar:
      - skor == 0        -> KKB kaydi yok (gecmis yok). Istatistiklerde HARIC.
      - skor null/NaN    -> sorgu yapilmamis. Istatistiklerde HARIC.
    """
    base = 'KKB_SKOR'
    months = ['LM'] + [f'L{i}M' for i in range(2, 13)]
    cols = _exist(df, [f'{base}_{m}' for m in months])
    if not cols:
        return {}

    out = {}
    idx = df.index

    pos = {c: j for j, c in enumerate(cols)}
    R = df[cols].apply(pd.to_numeric, errors='coerce').to_numpy(dtype="float64",
                                                                na_value=np.nan)
    raw_nan = np.isnan(R)
    V = np.where(raw_nan | (R == 0), np.nan, R)      # gecersizler -> NaN
    ok = ~np.isnan(V)

    def _idx(keys):
        """Pencerede fiilen var olan kolonlarin matris indeksleri."""
        return [pos[f'{base}_{k}'] for k in keys if f'{base}_{k}' in pos]

    def _stats(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        empty = cnt == 0
        safe = np.maximum(cnt, 1)
        tot = np.where(ok[:, j], s, 0.0).sum(axis=1)
        avg = tot / safe
        avg[empty] = np.nan
        ss = np.sort(s, axis=1)                      # NaN'lar sona
        c2 = cnt[:, None]
        lo = np.take_along_axis(ss, np.maximum(c2 - 1, 0) // 2, 1)[:, 0]
        hi = np.take_along_axis(ss, np.maximum(c2, 1) // 2, 1)[:, 0]
        med = (lo + hi) * 0.5
        mn = ss[:, 0].copy()
        mx = np.take_along_axis(ss, np.maximum(c2 - 1, 0), 1)[:, 0]
        med[empty] = np.nan
        mx[empty] = np.nan
        dev = np.where(ok[:, j], s - avg[:, None], 0.0)
        std = np.sqrt(np.einsum('ij,ij->i', dev, dev) / np.maximum(cnt - 1, 1))
        std[np.isnan(std)] = 0.0                     # orijinal .fillna(0)
        std[cnt <= 1] = 0.0
        return avg, std, mn, mx, med

    def _mean(j):
        s = V[:, j]
        cnt = ok[:, j].sum(axis=1)
        m = np.where(ok[:, j], s, 0.0).sum(axis=1) / np.maximum(cnt, 1)
        m[cnt == 0] = np.nan
        return m

    windows = {
        '3M':   ['LM', 'L2M', 'L3M'],
        '6M':   ['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'],
        '12M':  months,
        '4_6M': ['L4M', 'L5M', 'L6M'],
        '6_9M': ['L6M', 'L7M', 'L8M', 'L9M'],
    }

    for tag, keys in windows.items():
        j = _idx(keys)
        if not j:
            continue
        avg, std, mn, mx, med = _stats(j)
        out[f'{base}_AVG_L{tag}'] = pd.Series(avg, index=idx, copy=False)
        out[f'{base}_STD_L{tag}'] = pd.Series(std, index=idx, copy=False)
        out[f'{base}_MIN_L{tag}'] = pd.Series(mn, index=idx, copy=False)
        out[f'{base}_MAX_L{tag}'] = pd.Series(mx, index=idx, copy=False)
        out[f'{base}_MED_L{tag}'] = pd.Series(med, index=idx, copy=False)

    j3, j46 = _idx(['LM', 'L2M', 'L3M']), _idx(['L4M', 'L5M', 'L6M'])
    j6 = _idx(['LM', 'L2M', 'L3M', 'L4M', 'L5M', 'L6M'])
    j79 = _idx(['L7M', 'L8M', 'L9M'])
    if j3 and j46:
        out[f'{base}_TREND_3_46'] = pd.Series(_mean(j3) - _mean(j46),
                                              index=idx, copy=False)
    if j6 and j79:
        out[f'{base}_TREND_6_79'] = pd.Series(_mean(j6) - _mean(j79),
                                              index=idx, copy=False)

    lm, l2, l3 = f'{base}_LM', f'{base}_L2M', f'{base}_L3M'
    if lm in pos and l2 in pos:
        d = V[:, pos[lm]] - V[:, pos[l2]]
        out[f'{base}_DELTA_1_2'] = pd.Series(d, index=idx, copy=False)
        out[f'{base}_DELTA_PCT_1_2'] = _sdiv(d, V[:, pos[l2]])
    if lm in pos and l3 in pos:
        d13 = V[:, pos[lm]] - V[:, pos[l3]]
        out[f'{base}_DELTA_1_3'] = pd.Series(d13, index=idx, copy=False)
        out[f'{base}_CHG_L3M'] = pd.Series(d13.copy(), index=idx, copy=False)

    # DEĞİŞİKLİK: eski .astype('Int64').astype(float) zinciri NaN'ı zaten
    # koruyamıyordu (karşılaştırma bool döner, LM NaN -> flag 0 çıkıyordu).
    # Artık LM veya AVG12 NaN ise flag da NaN; ikisi de doluysa 0/1.
    # Not: preprocess'te bu kolon num grubuna düşüp NaN -> 0 dolar;
    # NaN'ı ayrı bir sınıf olarak tutmak istersen sentinel listesine
    # 'KKB' de eklemen gerekir.
    if f'{base}_AVG_L12M' in out and lm in pos:
        lm_v = V[:, pos[lm]]
        avg12 = out[f'{base}_AVG_L12M'].to_numpy(dtype="float64")
        flg = np.where(np.isnan(lm_v) | np.isnan(avg12), np.nan,
                       (lm_v < avg12).astype("float64"))
        out[f'{base}_LM_BELOW_AVG12_FLG'] = pd.Series(flg, index=idx, copy=False)

    out[f'{base}_VALID_CNT_L12M'] = pd.Series(ok.sum(axis=1), index=idx, copy=False)
    out[f'{base}_ZERO_CNT_L12M'] = pd.Series((R == 0).sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_NULL_CNT_L12M'] = pd.Series(raw_nan.sum(axis=1),
                                             index=idx, copy=False)
    out[f'{base}_EVER_QUERIED_FLG'] = (out[f'{base}_VALID_CNT_L12M'] > 0).astype(int)

    return out


def feature_engineering(df):
    """Tüm feature gruplarını üretir. (df_eng, yeni_feature_isimleri) döner."""
    out = {}
    for fn in (_renk_features, _dav_features, _mms_features, _kkb_features,
               _odeme_features, _ratio_features, _kk_features):
        out.update(fn(df))
    eng = pd.DataFrame(out, index=df.index)
    eng = eng.loc[:, ~eng.columns.duplicated()]
    # DEĞİŞİKLİK: df'te zaten var olan bir isim üretilirse concat sonrası
    # duplike kolon oluşuyordu; df ile çakışan isimler atılıyor (df'teki kalır).
    eng = eng.loc[:, ~eng.columns.isin(df.columns)]
    return pd.concat([df, eng], axis=1), list(eng.columns)
