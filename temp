SELECT
    COALESCE(a.DONEM, b.DONEM) AS DONEM,
    a.CNT AS CNT_PORTFOY,
    b.CNT AS CNT_PORTFOY_1,
    COALESCE(a.CNT,0) - COALESCE(b.CNT,0) AS FARK,
    CASE WHEN a.DONEM IS NULL THEN 'SADECE_1_DE_VAR'
         WHEN b.DONEM IS NULL THEN 'SADECE_ANA_TABLODA'
         WHEN a.CNT = b.CNT   THEN 'ADET_AYNI'
         ELSE 'ADET_FARKLI' END AS DURUM
FROM (SELECT DONEM, COUNT(*) AS CNT
        FROM MUS_YENI_RENKLER_TUM_PORTFOY GROUP BY DONEM) a
FULL OUTER JOIN
     (SELECT DONEM, COUNT(*) AS CNT
        FROM MUSTERI_YENI_RENKLER_TUM_PORTFOY_1 GROUP BY DONEM) b
  ON a.DONEM = b.DONEM
ORDER BY 1




WITH ortak AS (
    SELECT DISTINCT a.DONEM
    FROM (SELECT DISTINCT DONEM FROM MUS_YENI_RENKLER_TUM_PORTFOY) a
    JOIN (SELECT DISTINCT DONEM FROM MUSTERI_YENI_RENKLER_TUM_PORTFOY_1) b
      ON a.DONEM = b.DONEM
),
birlesik AS (
    SELECT 1 AS SRC, MBB_NO, TARIH, DONEM, KK_LIMIT, KK_RISK, KK_URUN_FLG,
           IHT_LIMIT, IHT_RISK, IHT_URUN_FLG, AP_LIMIT, AP_RISK, AP_URUN_FLG,
           IHT_KULL_FLG, MAX_OF_BK_BANKA_MEVCUT, MAX_OF_KK_12, SUM_OF_KK_24,
           MAX_OF_AP_12, SUM_OF_AP_24, MMS_DS_ONERI_RENK, AP_YENI_GIRIS_FLAG
      FROM MUS_YENI_RENKLER_TUM_PORTFOY
     WHERE DONEM IN (SELECT DONEM FROM ortak)
    UNION ALL
    SELECT 2 AS SRC, MBB_NO, TARIH, DONEM, KK_LIMIT, KK_RISK, KK_URUN_FLG,
           IHT_LIMIT, IHT_RISK, IHT_URUN_FLG, AP_LIMIT, AP_RISK, AP_URUN_FLG,
           IHT_KULL_FLG, MAX_OF_BK_BANKA_MEVCUT, MAX_OF_KK_12, SUM_OF_KK_24,
           MAX_OF_AP_12, SUM_OF_AP_24, MMS_DS_ONERI_RENK, AP_YENI_GIRIS_FLAG
      FROM MUSTERI_YENI_RENKLER_TUM_PORTFOY_1
     WHERE DONEM IN (SELECT DONEM FROM ortak)
)
SELECT MBB_NO, TARIH, DONEM, KK_LIMIT, KK_RISK, KK_URUN_FLG,
       IHT_LIMIT, IHT_RISK, IHT_URUN_FLG, AP_LIMIT, AP_RISK, AP_URUN_FLG,
       IHT_KULL_FLG, MAX_OF_BK_BANKA_MEVCUT, MAX_OF_KK_12, SUM_OF_KK_24,
       MAX_OF_AP_12, SUM_OF_AP_24, MMS_DS_ONERI_RENK, AP_YENI_GIRIS_FLAG,
       SUM(CASE WHEN SRC = 1 THEN 1 ELSE 0 END) AS ADET_PORTFOY,
       SUM(CASE WHEN SRC = 2 THEN 1 ELSE 0 END) AS ADET_PORTFOY_1
FROM birlesik
GROUP BY MBB_NO, TARIH, DONEM, KK_LIMIT, KK_RISK, KK_URUN_FLG,
         IHT_LIMIT, IHT_RISK, IHT_URUN_FLG, AP_LIMIT, AP_RISK, AP_URUN_FLG,
         IHT_KULL_FLG, MAX_OF_BK_BANKA_MEVCUT, MAX_OF_KK_12, SUM_OF_KK_24,
         MAX_OF_AP_12, SUM_OF_AP_24, MMS_DS_ONERI_RENK, AP_YENI_GIRIS_FLAG
HAVING SUM(CASE WHEN SRC = 1 THEN 1 ELSE 0 END)
     <> SUM(CASE WHEN SRC = 2 THEN 1 ELSE 0 END)
