def _yaz_bloklu(xl, sheet, bloklar, baslik, skala=None, baslik_satiri=3):
    """Tüm renklerin bloklarını TEK sheet'e alt alta yazar."""
    wb = xl.book
    r = baslik_satiri
    ilk = True
    for b in bloklar:
        b.to_excel(xl, sheet_name=sheet, index=False, startrow=r, header=ilk)
        satir = len(b) + (1 if ilk else 0)
        if skala:
            ws = wb[sheet]
            c0, c1 = skala['col0'], b.shape[1]
            r0 = r + (2 if ilk else 1)
            rng = f"{get_column_letter(c0)}{r0}:{get_column_letter(c1)}{r0 + len(b) - 1}"
            ws.conditional_formatting.add(rng, ColorScaleRule(
                start_type='num', start_value=0, start_color='FFFFFF',
                mid_type='num', mid_value=skala['mid'], mid_color='FFEB84',
                end_type='num', end_value=skala['max'], end_color='C00000'))
        r += satir + BOSLUK
        ilk = False
    ws = wb[sheet]
    ws['A1'] = baslik
    ws['A1'].font = Font(bold=True, size=11)
    ws['A1'].alignment = Alignment(wrap_text=True)
    ws.freeze_panes = f"C{baslik_satiri + 2}"      # RENK+etiket kolonları donuk
    return ws


