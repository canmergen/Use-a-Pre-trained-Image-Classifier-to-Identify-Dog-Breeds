A = df_HAVALE_EFT_NTT
B = df_HAVALE_EFT_NTT_prepared

# --- 1) Kolon (feature) farkları ---
cols_a = set(A.columns)
cols_b = set(B.columns)

only_in_a = cols_a - cols_b
only_in_b = cols_b - cols_a
common_cols = cols_a & cols_b

print(f"Ortak kolon sayısı : {len(common_cols)}")
print(f"Sadece A'da olan    : {len(only_in_a)} -> {sorted(only_in_a)}")
print(f"Sadece B'de olan    : {len(only_in_b)} -> {sorted(only_in_b)}")

# --- 2) SM_ID bazında satır farkları ---
ids_a = set(A["SM_ID"])
ids_b = set(B["SM_ID"])

only_ids_a = ids_a - ids_b
only_ids_b = ids_b - ids_a
common_ids = ids_a & ids_b

print(f"\nOrtak SM_ID sayısı        : {len(common_ids)}")
print(f"A'da olup B'de olmayan    : {len(only_ids_a)}")
print(f"B'de olup A'da olmayan    : {len(only_ids_b)}")

df_only_a = A[A["SM_ID"].isin(only_ids_a)]
df_only_b = B[B["SM_ID"].isin(only_ids_b)]

display(df_only_a)
display(df_only_b)
