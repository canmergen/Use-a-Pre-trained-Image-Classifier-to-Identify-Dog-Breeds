def egit_ve_olc(kolonlar, etiket):
    """Verilen kolon setiyle SEEDS kadar model eğitir; train + val metriklerini döndürür."""
    sonuclar, son_model = [], None
    for s in SEEDS:
        m = lgb.LGBMClassifier(**LGB_PARAMS, random_state=s)
        m.fit(train[kolonlar], y_train)
        p_tr  = m.predict_proba(train[kolonlar])[:, 1]
        p_val = m.predict_proba(val[kolonlar])[:, 1]
        sonuclar.append({
            "tr_auc":   roc_auc_score(y_train, p_tr),
            "val_auc":  roc_auc_score(y_val, p_val),
            "tr_gini":  2 * roc_auc_score(y_train, p_tr) - 1,
            "val_gini": 2 * roc_auc_score(y_val, p_val) - 1,
            "val_cap10": capture_at(y_val, p_val),
        })
        son_model = m
    r = pd.DataFrame(sonuclar)
    print(f"{etiket:<10} train AUC={r.tr_auc.mean():.4f}  val AUC={r.val_auc.mean():.4f}±{r.val_auc.std():.4f}  "
          f"val gini={r.val_gini.mean():.4f}  cap@10={r.val_cap10.mean():.4f}  "
          f"makas={r.tr_auc.mean()-r.val_auc.mean():.4f}")
    return r, son_model




