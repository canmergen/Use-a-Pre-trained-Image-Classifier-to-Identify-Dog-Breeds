]

def _analiz_klasor_var(yol):
    """mf içinde klasör var mı (dosya değil)."""
    try:
        d = mf.get_path_details("/" + str(yol).lstrip("/"))
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("exists") is False:
        return False
    return bool(d.get("directory", False))

_eksik = [p for p in GEREKLI_KLASORLER if not _analiz_klasor_var(p)]
_analiz_hazir = MODEL_GEREKLILIK_ANALIZI and not _eksik

if not MODEL_GEREKLILIK_ANALIZI:
    print("ⓘ MODEL_GEREKLILIK_ANALIZI=False → df_analiz üretimi atlandı.")
elif _eksik:
    print(f"ⓘ Eksik klasör(ler): {_eksik} → df_analiz üretimi atlandı.")

if _analiz_hazir:
    if 'df_raw' not in globals():
        raise RuntimeError("df_raw bellekte yok — df_analiz kurulamaz.")

    # ================================================================
    # A) GERÇEKLEŞME HEDEFLERİ (df_raw'dan) + KIYAS SKORLARI
    # ================================================================
    JOIN_KEYS   = ["DONEM", "MBB_NO"]
    ACT_KAYNAK  = ["RENK_3M_SONRASI", "RENK_6M_SONRASI", "RENK_12M_SONRASI",
                   "AKB_GGS_6_90", "AKB_TAKIP_6M"]
    KIYAS_SKORLAR_GINI = ["DAVRANIS_SKORU", "MUSTERI_SKORU"]
    TARGET_COLS = ["ACT_RENK3MSONRASIKIRMIZI", "ACT_RENK6MSONRASIKIRMIZI",
                   "ACT_RENK12MSONRASIKIRMIZI", "ACT_TAKIP6M"]

    # --- 2) df_raw kopyası + kaynak kolon kontrolü + anahtar tipi ---
    df_analiz = df_raw[list(dict.fromkeys(list(df_raw.columns)))].copy()
    _eksik_kaynak = [c for c in JOIN_KEYS + ACT_KAYNAK
                     if c not in df_analiz.columns]
    if _eksik_kaynak:
