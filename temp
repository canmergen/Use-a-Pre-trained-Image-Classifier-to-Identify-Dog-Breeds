# --- KAYIPSIZLIK TESTİ: aile + "_" + metrik == orijinal kolon adı mı? ---
reconstructed = set()
for fam, items in families.items():
    for metric, _ in items:
        reconstructed.add(f"{fam}_{metric}")
reconstructed |= {sm_id for sm_id, _ in specials}

originals = set(ids)

missing = originals - reconstructed   # bölerken kaybettiklerimiz
phantom = reconstructed - originals   # bölme yüzünden uydurduklarımız

print(f"Orijinal kolon: {len(originals)}")
print(f"Geri kurulan   : {len(reconstructed)}")
print(f"KAYIP  ({len(missing)}): {sorted(missing)[:20]}")
print(f"HAYALET({len(phantom)}): {sorted(phantom)[:20]}")

# --- ÇİFT SAYIM TESTİ: her kolon tam 1 kez mi sayıldı? ---
total_assigned = sum(len(items) for items in families.values()) + len(specials)
print(f"\nAtanan toplam: {total_assigned} (beklenen: {len(ids)})")

if not missing and not phantom and total_assigned == len(ids):
    print("\n✓ Bölme KAYIPSIZ ve ÇİFT SAYIMSIZ — sözlük güvenle kullanılabilir.")
else:
    print("\n✗ Sorun var — yukarıdaki listelerden nerede bozulduğu görülür.")
