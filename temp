def _psi(base_s, new_s, bins=10):
    """Population Stability Index. base = train, new = OOT.

    Yorum: <0.10 stabil | 0.10-0.25 dikkat | >0.25 kaymış
    """
    b, n = pd.Series(base_s), pd.Series(new_s)
    if isinstance(b.dtype, pd.CategoricalDtype) or b.dtype == object:
        bb = b.astype(object).where(b.notna(), "__NaN__").astype(str)
        nn = n.astype(object).where(n.notna(), "__NaN__").astype(str)
    else:
        b, n = b.fillna(-999999), n.fillna(-999999)
        if b.nunique() > 20:
            q = np.unique(np.nanquantile(b, np.linspace(0, 1, bins + 1)))
            if len(q) < 3:
                return 0.0
            q[0], q[-1] = -np.inf, np.inf
            bb = pd.cut(b, q, labels=False, include_lowest=True).astype(str)
            nn = pd.cut(n, q, labels=False, include_lowest=True).astype(str)
        else:
            bb, nn = b.astype(str), n.astype(str)
    pb = bb.value_counts(normalize=True)
    pn = nn.value_counts(normalize=True)
    idx = pb.index.union(pn.index)
    pb = pb.reindex(idx, fill_value=0) + 1e-6
    pn = pn.reindex(idx, fill_value=0) + 1e-6
    return float(((pn - pb) * np.log(pn / pb)).sum())


def _cramers_v(x, y):
    """Bias düzeltmeli (Bergsma) Cramér's V — kategorik ↔ hedef ilişkisi.

    Neden IV değil: IV bin sayısı arttıkça KENDİLİĞİNDEN şişiyor. 1.4M
    satırda hedefle hiç ilişkisi olmayan rastgele değişkenlerde ölçtük:
    sürekli 0.00004, 5 seviyeli 0.00002, 81 seviyeli 0.00036, 500 seviyeli
    0.00231 — yani 500 seviyeli gürültü, sürekli değişkenin 50 katı IV
    alıyor. Cramér's V'de aynı testte 0.0018 / 0.0032 / 0.0000; yanlılık yok.
    """
    ct = pd.crosstab(pd.Series(x).astype(object).fillna("__NaN__"),
                     pd.Series(y)).to_numpy()
    if ct.shape[0] < 2 or ct.shape[1] < 2:
        return 0.0
    n = ct.sum()
    exp = ct.sum(1)[:, None] * ct.sum(0)[None, :] / n
    chi2 = ((ct - exp) ** 2 / np.maximum(exp, 1e-9)).sum()
    r, k = ct.shape
    phi2c = max(0.0, chi2 / n - (k - 1) * (r - 1) / (n - 1))
    rc = r - (r - 1) ** 2 / (n - 1)
    kc = k - (k - 1) ** 2 / (n - 1)
    return float(np.sqrt(phi2c / max(min(kc - 1, rc - 1), 1e-9)))


def _capture_at(y_true, prob, pct=0.10):
    """En riskli %pct dilimde yakalanan batan oranı (capture@pct)."""
    y = np.asarray(y_true); p = np.asarray(prob)
    tot = y.sum()
    if tot <= 0 or len(y) == 0:
        return np.nan
    k = max(1, int(pct * len(y)))
    idx = np.argpartition(-p, min(k, len(p) - 1))[:k] if len(p) > 1 else np.array([0])
    return float(y[idx].sum() / tot)


def _bucket_metrik(y_true, prob, n_bucket=20, min_bad_per_bucket=100):
    """Bucket-1 lift, tavanın yüzde kaçı, ve monotonluk oranı.

    TAVAN: bucket 1, popülasyonun 1/nb'sini alır. Oraya girebilecek batan
    sayısı hem bucket'ın satır sayısıyla hem toplam batan sayısıyla sınırlı:
        max_bad_rate = min(1, base_rate * nb)
        tavan        = max_bad_rate / base_rate = min(1/base_rate, nb)
    Yani tavan BUCKET SAYISINI GEÇEMEZ. (Önceden sadece 1/base_rate idi;
    koyu yeşilde 1333 gibi ulaşılamaz bir tavan çıkıyor, o renk yapay
    olarak en kötü görünüyordu. Gerçek tavanı 20.)

    Bucket sayısı da adaptif: bucket başına en az min_bad_per_bucket batan
    düşsün, yoksa bad_rate gürültüden ayrışmaz ve monotonluk çöker.
    """
    y = np.asarray(y_true); p = np.asarray(prob)
    n = len(y); n_bad = int(y.sum())
    if n < n_bucket or n_bad == 0:
        return np.nan, np.nan, np.nan
    nb = int(min(n_bucket, max(5, n_bad // min_bad_per_bucket)))
    order = np.argsort(p, kind="stable")
    r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
    edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
    b = nb - np.searchsorted(edges[1:-1], r, side="left")   # 1 = en riskli
    br = pd.Series(y).groupby(b).mean().sort_index()
    base = y.mean()
    lift1 = float(br.iloc[0] / base) if base > 0 else np.nan
    tavan = min(1.0 / base, nb) if base > 0 else np.nan
    tavan_pct = float(lift1 / tavan) if tavan and np.isfinite(tavan) else np.nan
    mono = float((np.diff(br.to_numpy()) < 0).mean()) if len(br) > 1 else np.nan
    return lift1, tavan_pct, mono


