# --- HIZ AYARLARI -------------------------------------------------
# CV kaldırıldı → her trial'da TEK fit var.
#
# KRİTİK: os.cpu_count() Kubernetes pod'unda NODE'un çekirdek sayısını
# döndürüyor, pod'a AYRILAN kotayı değil. LGB n_jobs=256 çıkıyordu; pod'a
# 8-16 CPU verilmişse 256 thread o çekirdeklerde boğuşuyor (thrashing) ve
# fit hızlanmak yerine YAVAŞLIYOR. sched_getaffinity gerçek kotayı verir.
# Ayrıca 241 feature'a 256 thread zaten anlamsız — thread başına bir
# feature bile düşmüyor, kalanı senkronizasyon maliyeti.
# os.cpu_count() ve sched_getaffinity ikisi de NODE'un çekirdeğini verir
# (256). Kubernetes CPU limitini CFS QUOTA ile uygular; gerçek kota
# /sys/fs/cgroup'ta yazar (bu pod'da 72).
# KRİTİK: kotadan fazla thread açmak sadece "faydasız" değil, ZARARLI —
# kota dolunca Linux thread'leri periyodun geri kalanı boyunca DONDURUR
# (CFS throttling). 256 thread / 72 kota bu yüzden trial başına 9.6 dk
# yapıyordu. Kotanın altında kalmak throttling'i tamamen kapatır.
# 48 tavanı: LightGBM 241 feature'da ~32-48 thread'den sonra doyuma
# ulaşıyor; daha fazlası senkronizasyon maliyeti ve kotaya yaklaşma riski.
def _cpu_kotasi(tavan=48):
    _q = None
    try:                                             # cgroup v2
        _v = open('/sys/fs/cgroup/cpu.max').read().split()
        if _v[0] != 'max':
            _q = int(_v[0]) / int(_v[1])
    except Exception:
        try:                                         # cgroup v1
            _qq = int(open('/sys/fs/cgroup/cpu/cpu.cfs_quota_us').read())
            _pp = int(open('/sys/fs/cgroup/cpu/cpu.cfs_period_us').read())
            if _qq > 0:
                _q = _qq / _pp
        except Exception:
            pass
    _n = int(_q) if _q else (os.cpu_count() or 8)
    return max(1, min(_n, tavan))


