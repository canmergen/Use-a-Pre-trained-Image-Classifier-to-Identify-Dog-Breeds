# Gelen tutarın önceki 30 günlük döneme göre değişim oranı
df["H07_GLN_CHG"] = (df["TXN_GLN_30D_AMT"] - df["TXN_GLN_30D_60D_AMT"]) / (df["TXN_GLN_30D_60D_AMT"] + 1)

# Giden tutarın önceki 30 günlük döneme göre değişim oranı
df["H07_GDN_CHG"] = (df["TXN_GDN_30D_AMT"] - df["TXN_GDN_30D_60D_AMT"]) / (df["TXN_GDN_30D_60D_AMT"] + 1)

# Hipotezin deseni: gelen düşerken giden sabit
df["H07_DIVERGENCE"] = df["H07_GDN_CHG"] - df["H07_GLN_CHG"]

# Dosyanın literal kuralı: gelen %10+ düşmüş VE giden ±%5 içinde sabit
df["H07_FLAG"] = ((df["H07_GLN_CHG"] < -0.10) & (df["H07_GDN_CHG"].abs() <= 0.05)).astype(int)
