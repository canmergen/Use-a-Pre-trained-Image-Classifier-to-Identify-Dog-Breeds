# ============================================================
# DF_ANALIZ — MODEL GEREKLİLİK ANALİZİ (GERÇEKLEŞME + SKOR + BUCKET RAPORU)
# ------------------------------------------------------------
# ÇOK-OOT SÜRÜM: Aynı modellerin farklı OOT dönemleri klasör adı
# ekiyle ayrışır (ör. 3M_KIRMIZI_RENGE_GOC_OOT202506 vs
# 3M_KIRMIZI_RENGE_GOC_OOT202511). Yeni bir OOT geldiğinde SADECE
# OOT_DONEMLER listesine eklemek yeterlidir.
# Koşul: MODEL_GEREKLILIK_ANALIZI == True VE en az bir model
# klasörü mf içinde mevcut. Koşul sağlanmazsa hiçbir şey yapılmaz.
# Bir OOT'ta eksik klasör (ör. 202511'de 12M yok) analizi durdurmaz;
# o model o OOT'ta atlanır ve uyarı basılır.
# Adımlar:
#   A) ACT_* gerçekleşme hedefleri DOĞRUDAN df_raw'dan üretilir.
#      Kıyas skorları df_raw'da yoksa SADECE eksik olanlar
#      IBA_MMS_DS_GINI_DATA'dan çekilip left join edilir → df_analiz
#   B) TÜM klasörlerden (iki OOT birden) 6 rengin
#      renk_{kod}_{ad}_musteri_skorlari.csv dosyaları okunur;
#      SKOR_<klasör> ve PRED_<klasör> join edilir. Kolon adı klasör
#      adını (OOT eki dahil) taşıdığı için OOT'lar çakışmaz.
#   C) İki kıyas skoru için 20'li bucket sheet'leri + capture/GINI
#      kıyası + KAÇAN DİLİM + HÜKÜM — HER OOT GRUBU × HER DÖNEM için
#      ayrı: TRAIN (202504) + grubun KENDİ OOT dönemi (202506/202511).
#   F) TREND: mevcut skorların GINI'si tüm dönemlerde — model/OOT'tan
#      bağımsız olduğu için TEK sheet.
#   ⚠ TRAIN sheet'leri modelin lehine taraflı; asıl karar OOT
#     sheet'lerinden okunmalı.
#   ⚠ GENEL satırında 6 renk modelinin skorları TEK HAVUZDA birleşir;
#     karar RENK satırlarından okunmalıdır.
#   Çıktı: MODEL_RESULTS kökünde kiyas_skorlari_vs_modeller_bucket20.xlsx
#   Sheet sırası: HUKUM_<oot>_<TRAIN|OOT> → BUCKET20_<skor>_<oot>_<tag>
#     → CAPT_GINI_KIYAS_<oot>_<tag> → KACAN_DILIM_<oot>_<tag> → TREND
# ============================================================

# --- 0) Config bayrağı (config hücresinde tanımlı; yoksa kapalı say) ---
try:
    MODEL_GEREKLILIK_ANALIZI
except NameError:
    MODEL_GEREKLILIK_ANALIZI = False

# --- 1) OOT dönemleri + klasör keşfi --------------------------------
OOT_DONEMLER = ["OOT202506", "OOT202511"]   # yeni OOT → buraya ekle

# (model önek, ACT hedef kolonu) — klasör adı = "<önek>_<OOT>"
MODEL_ONEK_ACT = [
    ("3M_KIRMIZI_RENGE_GOC",  "ACT_RENK3MSONRASIKIRMIZI"),
    ("6M_KIRMIZI_RENGE_GOC",  "ACT_RENK6MSONRASIKIRMIZI"),
    ("12M_KIRMIZI_RENGE_GOC", "ACT_RENK12MSONRASIKIRMIZI"),
    ("6M_TAKIP",              "ACT_TAKIP6M"),
]

def _analiz_klasor_var(yol):
    """mf içinde klasör var mı (dosya değil)."""
    try:
        d = mf.get_path_details("/" + str(yol).lstrip("/"))
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("exists") is False:
        return False
    return bool(d.get("directory", False))

# OOT → [(klasör_adı, önek, act_kolonu), ...] — sadece mevcut olanlar
KLASORLER_OOT = {}
for _oot in OOT_DONEMLER:
    _bul = []
    for _onek, _act in MODEL_ONEK_ACT:
        _ad = f"{_onek}_{_oot}"
        if _analiz_klasor_var("/" + _ad):
            _bul.append((_ad, _onek, _act))
        else:
            print(f"ⓘ {_oot}: '{_ad}' klasörü yok → bu model bu OOT'ta atlanacak")
    if _bul:
        KLASORLER_OOT[_oot] = _bul
    else:
        print(f"⚠ {_oot}: hiç klasör bulunamadı → bu OOT tamamen atlanacak")

TUM_KLASORLER = [k for _lst in KLASORLER_OOT.values() for k, _, _ in _lst]
_analiz_hazir = MODEL_GEREKLILIK_ANALIZI and len(TUM_KLASORLER) > 0

if not MODEL_GEREKLILIK_ANALIZI:
    print("ⓘ MODEL_GEREKLILIK_ANALIZI=False → df_analiz üretimi atlandı.")
elif not TUM_KLASORLER:
    print("ⓘ Hiçbir model klasörü bulunamadı → df_analiz üretimi atlandı.")

if _analiz_hazir:
    if 'df_raw' not in globals():
        raise RuntimeError("df_raw bellekte yok — df_analiz kurulamaz.")

    # ================================================================
    # A) GERÇEKLEŞME HEDEFLERİ (df_raw'dan) + KIYAS SKORLARI
    # ================================================================
    JOIN_KEYS   = ["DONEM", "MBB_NO"]
    ACT_KAYNAK  = ["RENK_3M_SONRASI", "RENK_6M_SONRASI", "RENK_12M_SONRASI",
                   "AKB_GGS_6_90", "AKB_TAKIP_6M"]
    KIYAS_SKORLAR_GINI = ["DAVRANIS_SKORU", "MUSTERI_SKORU"]
    TARGET_COLS = ["ACT_RENK3MSONRASIKIRMIZI", "ACT_RENK6MSONRASIKIRMIZI",
                   "ACT_RENK12MSONRASIKIRMIZI", "ACT_TAKIP6M"]

    # --- 2) df_raw kopyası + kaynak kolon kontrolü + anahtar tipi ---
    df_analiz = df_raw[list(dict.fromkeys(list(df_raw.columns)))].copy()
    _eksik_kaynak = [c for c in JOIN_KEYS + ACT_KAYNAK
                     if c not in df_analiz.columns]
    if _eksik_kaynak:
        raise KeyError(f"df_raw'da eksik kaynak kolon: {_eksik_kaynak}")
    for col in JOIN_KEYS:
        df_analiz[col] = pd.to_numeric(df_analiz[col],
                                       errors="coerce").astype("Int64")

    # --- 2b) RENK kodunu türet ('1-Kırmızı' → 1) --------------------
    # df_raw'daki RENK string etiket; int kodla karşılaştırma hiç
    # eşleşmiyordu (tüm renk blokları 0 satır kalmıştı). Etiketin
    # başındaki sayı ayrıştırılıp RENK_KOD olarak kullanılır; RENK
    # zaten sayısalsa aynı sonucu verir.
    if "RENK" in df_analiz.columns:
        df_analiz["RENK_KOD"] = pd.to_numeric(
            df_analiz["RENK"].astype(str).str.split("-").str[0].str.strip(),
            errors="coerce").astype("Int64")
        print("RENK_KOD dağılımı:",
              df_analiz["RENK_KOD"].value_counts(dropna=False).sort_index().to_dict())
    else:
        df_analiz["RENK_KOD"] = pd.array([pd.NA] * len(df_analiz), dtype="Int64")
        print("⚠ df_raw'da RENK kolonu yok → renk bazlı bloklar üretilemeyecek")

    # --- 3) ACT_* hedeflerini df_raw kolonlarından üret -------------
    df_analiz["ACT_RENK3MSONRASIKIRMIZI"]  = (df_analiz["RENK_3M_SONRASI"]  == "1-Kırmızı").astype("int8")
    df_analiz["ACT_RENK6MSONRASIKIRMIZI"]  = (df_analiz["RENK_6M_SONRASI"]  == "1-Kırmızı").astype("int8")
    df_analiz["ACT_RENK12MSONRASIKIRMIZI"] = (df_analiz["RENK_12M_SONRASI"] == "1-Kırmızı").astype("int8")
    df_analiz["ACT_TAKIP6M"] = np.where(
        (pd.to_numeric(df_analiz["AKB_GGS_6_90"], errors="coerce").fillna(0) == 1)
        | (pd.to_numeric(df_analiz["AKB_TAKIP_6M"], errors="coerce").fillna(0) == 1),
        1, 0).astype("int8")
    for _t in TARGET_COLS:
        print(f"   {_t}: pozitif oran {df_analiz[_t].mean():.4%}")

    # --- 4) Kıyas skorları: df_raw'da yoksa GINI'den SADECE eksikleri çek
    _gini_gerek = [k for k in KIYAS_SKORLAR_GINI if k not in df_analiz.columns]
    if not _gini_gerek:
        print("ⓘ DAVRANIS_SKORU ve MUSTERI_SKORU df_raw'da mevcut → GINI okunmadı.")
    else:
        print(f"ⓘ df_raw'da olmayan kıyas skor(lar)ı GINI'den çekilecek: {_gini_gerek}")
        GINI_DATASET = "KIAILAYDABETULAKISSANDBOX.IBA_MMS_DS_GINI_DATA"
        d1   = dataiku.Dataset(GINI_DATASET)
        info = d1.get_location_info(sensitive_info=True)["info"]
        cp   = info["connectionParams"]
        root = info["path"].replace("s3://", "")
        s3   = pafs.S3FileSystem(access_key=cp["accessKey"],
                                 secret_key=cp["secretKey"],
                                 endpoint_override="loscdlhp.aknet.akb:9000",
                                 scheme="https",
                                 force_virtual_addressing=False)
        dset = pads.dataset(root, filesystem=s3, format="parquet")

        _gini_kolon  = JOIN_KEYS + _gini_gerek
        _mevcut_sema = set(dset.schema.names)
        _yok = [c for c in _gini_kolon if c not in _mevcut_sema]
        if _yok:
            raise KeyError(f"GINI dataset'inde eksik kolon: {_yok}")

        tbl = dset.to_table(columns=_gini_kolon, use_threads=True)
        df2 = tbl.to_pandas(self_destruct=True, split_blocks=True)
        del tbl
        print(f"   GINI okundu: {df2.shape[0]:,} satır, {df2.shape[1]} kolon")

        for col in JOIN_KEYS:
            df2[col] = pd.to_numeric(df2[col], errors="coerce").astype("Int64")
        df2 = df2[df2["DONEM"].isin(df_analiz["DONEM"].dropna().unique())]
        _dup = int(df2.duplicated(subset=JOIN_KEYS).sum())
        if _dup > 0:
            print(f"   ⚠ GINI: {_dup:,} mükerrer anahtar satırı düşürüldü")
            df2 = df2.drop_duplicates(subset=JOIN_KEYS, keep="first")

        _n_once = len(df_analiz)
        df_analiz = df_analiz.merge(df2, on=JOIN_KEYS, how="left", validate="m:1")
        assert len(df_analiz) == _n_once, "GINI skor join'i satır sayısını değiştirdi!"
        for _k in _gini_gerek:
            print(f"   ✓ {_k} eklendi | doluluk: {df_analiz[_k].notna().mean():.1%}")
        del df2

    ortak_donemler = sorted(df_analiz["DONEM"].dropna().unique())
    print(f"✓ df_analiz (gerçekleşme) hazır: {df_analiz.shape[0]:,} satır, "
          f"{df_analiz.shape[1]} kolon | dönemler: {ortak_donemler}")

    # ================================================================
    # B) MODEL SKORLARI — TÜM klasörlerden (iki OOT birden)
    #    renk_{kod}_{ad}_musteri_skorlari.csv dosyaları
    # ================================================================
    SKOR_KOLON    = ["mbb_no", "donem", "target_pred", "target_score"]
    _SKOR_RENKLER = MODEL_RENKLER if 'MODEL_RENKLER' in globals() else [1, 2, 3, 4, 5, 6]

    for _ek in TUM_KLASORLER:
        # --- 10) Klasördeki 6 renk dosyasını oku ve birleştir -------
        _parcalar = []
        for _rk in _SKOR_RENKLER:
            _ra  = COLOR_MAP.get(_rk, str(_rk))
            _yol = f"/{_ek}/renk_{_rk}_{_ra}_musteri_skorlari.csv"
            try:
                with mf.get_download_stream(_yol) as _s:
                    _p = pd.read_csv(_s, usecols=SKOR_KOLON)
                _parcalar.append(_p)
                print(f"   {_ek} / renk_{_rk}_{_ra}: {len(_p):,} satır")
            except Exception as e:
                print(f"   ⚠ {_yol} okunamadı ({e}) → bu renk atlandı")
        if not _parcalar:
            print(f"⚠ {_ek}: hiçbir renk dosyası okunamadı → skor eklenmedi.")
            continue
        _sc = pd.concat(_parcalar, ignore_index=True)
        del _parcalar
        print(f"{_ek}: toplam {len(_sc):,} satır (6 renk birleşik)")

        # --- 11) Anahtarları df_analiz ile aynı tipe getir ----------
        _sc["mbb_no"] = pd.to_numeric(_sc["mbb_no"], errors="coerce").astype("Int64")
        _sc["donem"]  = pd.to_numeric(_sc["donem"],  errors="coerce").astype("Int64")
        _sc = _sc.dropna(subset=["mbb_no", "donem"])

        # --- 12) Anahtar bazında tekilleştir ------------------------
        _dup = int(_sc.duplicated(subset=["mbb_no", "donem"]).sum())
        if _dup > 0:
            print(f"   ⚠ {_ek}: {_dup:,} mükerrer mbb_no+donem satırı düşürüldü")
            _sc = _sc.drop_duplicates(subset=["mbb_no", "donem"], keep="first")

        # --- 13) Kolonları klasör adıyla (OOT eki dahil) adlandır ---
        _sc = _sc.rename(columns={"target_score": f"SKOR_{_ek}",
                                  "target_pred":  f"PRED_{_ek}",
                                  "mbb_no":       "MBB_NO",
                                  "donem":        "DONEM"})

        # --- 14) Left join ------------------------------------------
        _n_once = len(df_analiz)
        df_analiz = df_analiz.merge(_sc, on=["MBB_NO", "DONEM"],
                                    how="left", validate="m:1")
        assert len(df_analiz) == _n_once, f"{_ek}: join satır sayısını değiştirdi!"
        _eslesme = df_analiz[f"SKOR_{_ek}"].notna().mean()
        print(f"   ✓ SKOR_{_ek} + PRED_{_ek} eklendi | eşleşme: {_eslesme:.1%}")
        del _sc

    # --- 15) PRED_* kolonları NaN koruyarak integer kalsın ----------
    for _ek in TUM_KLASORLER:
        _c = f"PRED_{_ek}"
        if _c in df_analiz.columns:
            df_analiz[_c] = df_analiz[_c].astype("Int8")

    # --- 16) QA: eşleşen kitlede ACT vs PRED pozitif oranları -------
    # _qa_cift artık klasör keşfinden türetilir (OOT eki dahil) —
    # sabit ad listesi yok, klasör adı değişince kırılmaz.
    _qa_cift = [(a, k) for _lst in KLASORLER_OOT.values() for k, _, a in _lst]
    print("\nQA — eşleşen kitlede pozitif oranlar (ACT=gerçekleşme, PRED=model 0/1):")
    for _a, _e in _qa_cift:
        _p = f"PRED_{_e}"
        if _a in df_analiz.columns and _p in df_analiz.columns:
            _m = df_analiz[_p].notna()
            if _m.any():
                print(f"   {_a}: {df_analiz.loc[_m, _a].mean():.4f}  |  "
                      f"{_p}: {df_analiz.loc[_m, _p].astype('float').mean():.4f}")

    print(f"\n✓ df_analiz FINAL: {df_analiz.shape[0]:,} satır, "
          f"{df_analiz.shape[1]} kolon")

    # ================================================================
    # C) KIYAS SKORLARI 20'Lİ BUCKET RAPORU (TRAIN + OOT)
    # ----------------------------------------------------------------
    #   DAVRANIS_SKORU: yüksek = İYİ  → riskli yön = DÜŞÜK (işaret -1)
    #   MUSTERI_SKORU : yüksek = KÖTÜ → riskli yön = YÜKSEK (işaret +1)
    # bucket 1 = en riskli %5.
    # DEĞERLENDİRME: her OOT grubu için İKİ dönem — TRAIN (202504) +
    # grubun KENDİ OOT dönemi (OOT202506→202506, OOT202511→202511).
    # ⚠ TRAIN kıyası modelin lehine taraflı; asıl hüküm OOT sheet'inden
    #   okunmalı. Gerçekleşmesi henüz oluşmamış hedefler o dönemde
    #   kendiliğinden hesaplanamaz/anlamsız kalır (ör. 202511'de 12M —
    #   zaten o klasör de yok, atlanır).
    # ⚠ GENEL satırı: 6 renk modelinin skoru tek havuzda — modele karşı
    #   taraflı; karar RENK satırlarından okunmalı.
    # ================================================================
    ANALIZ_N_BUCKET = 20
    ANALIZ_DONEM    = TRAIN_DONEM if 'TRAIN_DONEM' in globals() else 202504
    KACAN_UST       = 4          # "en riskli" = bucket 1-4 (üst %20)

    # --- HÜKÜM EŞİKLERİ (öneri — iş tarafıyla mutabık kalınmalı) ----
    ESIK_GINI_FARK    = 0.05  # T1a: model Gini - en iyi mevcut Gini ≤ 0.05 → mevcut yeter
    ESIK_CAPTURE_FARK = 0.05  # T1b: capture@20% farkı ≤ 5 puan → mevcut yeter
    ESIK_KACAN        = 1.5   # T2 : kaçan dilim ACT / genel ACT ≤ 1.5 → kör nokta yok

    _KIYAS_TANIM = [
        ("DAVRANIS", ["DAVRANIS_SKORU", "DAVRANIS_SKOR", "DAVRANIS_SCORE"], -1.0),
        ("MUSTERI",  ["MUSTERI_SKORU",  "MUSTERI_SKOR",  "MUSTERI_SCORE"],  +1.0),
    ]
    KIYAS_SKORLARI = []                       # (kısa ad, kolon, işaret)
    for _ad, _adaylar, _isaret in _KIYAS_TANIM:
        _col = next((c for c in _adaylar if c in df_analiz.columns), None)
        if _col is None:
            print(f"⚠ {_ad} skoru bulunamadı (aranan: {_adaylar}) → bu skor atlandı")
        else:
            KIYAS_SKORLARI.append((_ad, _col, _isaret))
    if not KIYAS_SKORLARI:
        raise KeyError("Hiçbir kıyas skoru bulunamadı — bucket raporu kurulamaz.")

    _kitle_cache = {}
    def _kitle(don):
        """Bir değerlendirme dönemi için ana kitle (KK filtreli)."""
        if don not in _kitle_cache:
            _m = df_analiz["DONEM"] == don
            if "KK_URUN_FLG" in df_analiz.columns:
                _m &= (df_analiz["KK_URUN_FLG"] == "KK")
            _kitle_cache[don] = df_analiz.loc[_m].copy()
        return _kitle_cache[don]

    if _kitle(ANALIZ_DONEM).empty:
        raise RuntimeError("TRAIN kitlesi boş — dönem/kolonları kontrol edin.")

    def _bucketla_riskli(skor_riskli_buyuk, nb=ANALIZ_N_BUCKET):
        """skor 'büyük = riskli' verilmiş olmalı. Bucket 1 = en riskli %5."""
        s = np.asarray(skor_riskli_buyuk, dtype="float64"); n = len(s)
        order = np.argsort(s, kind="stable")
        r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
        edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
        return nb - np.searchsorted(edges[1:-1], r, side="left")

    def _bucket_blogu(dsub, etiket, skor_col, isaret, act_cols, pred_cols):
        """Bir kitle için 20 bucket + 1 TOPLAM satırlık tablo döner.
        act_cols/pred_cols parametre: her OOT kendi kolon setiyle çağırır.
        Her ACT kolonunun yanına '(adet)' eklenir: o bucket'ta gerçekleşen
        vaka SAYISI. Her PRED kolonunun yanına '(kendi bucket)' eklenir:
        AYNI kitle modelin KENDİ ham skoruna göre (SKOR_<klasör>,
        yüksek=riskli) 20'ye bölündüğünde o bucket'taki PRED oranı —
        kıyas skoru sıralamasından bağımsız, filtresiz referans.
        TOPLAM satırı: segmentin/dönemin tamamı — kaç müşteri vardı,
        kaçı kırmızıya/takibe geçti (adet + oran)."""
        d = dsub.copy()
        d["_B"] = _bucketla_riskli(isaret * d[skor_col].to_numpy(dtype="float64"))
        g = d.groupby("_B")
        _bidx = g.size().index
        _yon = "düşük" if isaret < 0 else "yüksek"
        _bucket_kolon = f"BUCKET (1=en riskli, {_yon} {skor_col})"
        blok = pd.DataFrame({
            "SEGMENT": etiket,
            _bucket_kolon: _bidx,
            "MÜŞTERİ": g.size().values,
            "SKOR_MIN": g[skor_col].min().round(4).values,
            "SKOR_ORT": g[skor_col].mean().round(4).values,
            "SKOR_MAX": g[skor_col].max().round(4).values,
        })
        for c in act_cols:
            blok[f"{c} (%)"] = g[c].apply(
                lambda x: round(float(pd.to_numeric(x, errors="coerce").mean()), 4)).values
            blok[f"{c} (adet)"] = g[c].apply(
                lambda x: int(pd.to_numeric(x, errors="coerce").fillna(0).sum())).values
        for c in pred_cols:
            blok[f"{c} (%)"] = g[c].apply(
                lambda x: round(float(pd.to_numeric(x, errors="coerce").mean()), 4)).values
            # --- modelin KENDİ bucket'ı: aynı kitle, modelin ham
            # skoruna göre yeniden 20'ye bölünür (kıyas skorundan
            # bağımsız). Satırdaki bucket no = modelin kendi bucket no'su.
            _skor_c = "SKOR_" + c[len("PRED_"):]
            _kb = [None] * len(blok)
            if _skor_c in d.columns:
                _dm = d[d[_skor_c].notna()]
                if len(_dm) >= ANALIZ_N_BUCKET:
                    _bm = _bucketla_riskli(_dm[_skor_c].to_numpy(dtype="float64"))
                    _gm = pd.Series(
                        pd.to_numeric(_dm[c], errors="coerce").to_numpy()
                    ).groupby(_bm).mean().round(4)
                    _kb = [float(_gm[b]) if b in _gm.index else None
                           for b in _bidx]
            blok[f"{c} (kendi bucket) (%)"] = _kb

        # --- TOPLAM satırı: segmentin tamamı (bucket'suz) -----------
        _top = {
            "SEGMENT": etiket,
            _bucket_kolon: "TOPLAM",
            "MÜŞTERİ": int(len(d)),
            "SKOR_MIN": round(float(d[skor_col].min()), 4),
            "SKOR_ORT": round(float(d[skor_col].mean()), 4),
            "SKOR_MAX": round(float(d[skor_col].max()), 4),
        }
        for c in act_cols:
            _v = pd.to_numeric(d[c], errors="coerce")
            _top[f"{c} (%)"]    = round(float(_v.mean()), 4)
            _top[f"{c} (adet)"] = int(_v.fillna(0).sum())
        for c in pred_cols:
            _vp = pd.to_numeric(d[c], errors="coerce")
            _top[f"{c} (%)"] = (round(float(_vp.mean()), 4)
                                if _vp.notna().any() else None)
            _top[f"{c} (kendi bucket) (%)"] = None
        blok = pd.concat([blok, pd.DataFrame([_top])], ignore_index=True)
        return blok

    def _capture_pct(y, skor_riskli_buyuk, pct=0.20):
        """En riskli %pct dilimin yakaladığı vaka payı."""
        y = pd.to_numeric(y, errors="coerce").astype("float64").to_numpy()
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        tot = y.sum()
        if tot <= 0 or len(y) == 0:
            return np.nan
        k = max(1, int(pct * len(y)))
        top = np.argpartition(-s, min(k, len(y) - 1))[:k]
        return float(y[top].sum() / tot)

    def _gini(y, skor_riskli_buyuk):
        """Gini = 2*AUC - 1. skor: büyük = riskli olacak şekilde verilmeli.
        NEGATİF çıkabilir ve negatif RAPORLANIR (abs alınmaz)."""
        y = pd.to_numeric(y, errors="coerce").astype("float64").to_numpy()
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        if len(y) == 0 or len(np.unique(y)) < 2:
            return np.nan
        return float(2.0 * roc_auc_score(y, s) - 1.0)

    _renk_map = COLOR_MAP if 'COLOR_MAP' in globals() else {}

    def _segment_isle(dsub, etiket, skorm_map, kiyas_l, kacan_l, hukum_l,
                      hkm_ek="[TRAIN, OOT ile doğrulanmalı]"):
        """Bir kitle için kıyas + kaçan dilim + hüküm satırlarını üretir.
        skorm_map: ACT hedefi → o OOT'un model SKOR kolonu.
        hkm_ek: hüküm metninin sonuna eklenen dönem notu."""
        for _a, _skor_m in skorm_map.items():
            _y = pd.to_numeric(dsub[_a], errors="coerce")
            _vaka = int(_y.fillna(0).sum())

            # ---- kıyas satırı (capture + gini, üç sıralama) --------
            _row = {"SEGMENT": etiket, "HEDEF": _a, "VAKA": _vaka}
            _mevcut_metrik = {}                    # ad → (cap, gini)
            for _ad, _col, _isaret in KIYAS_SKORLARI:
                _s = _isaret * dsub[_col].astype("float64").to_numpy()
                _cap, _gin = _capture_pct(dsub[_a], _s), _gini(dsub[_a], _s)
                _mevcut_metrik[_ad] = (_cap, _gin)
                _row[f"{_ad} capture@20%"] = round(_cap, 4) if np.isfinite(_cap) else None
                _row[f"{_ad} GINI"]        = round(_gin, 4) if np.isfinite(_gin) else None
            _ort = dsub[_skor_m].notna()
            if _ort.any():
                _s_m = dsub.loc[_ort, _skor_m].to_numpy(dtype="float64")
                _cap_md = _capture_pct(dsub.loc[_ort, _a], _s_m)
                _gin_md = _gini(dsub.loc[_ort, _a], _s_m)
            else:
                _cap_md = _gin_md = np.nan
            _row["MODEL capture@20%"] = round(_cap_md, 4) if np.isfinite(_cap_md) else None
            _row["MODEL GINI"]        = round(_gin_md, 4) if np.isfinite(_gin_md) else None
            for _ad in _mevcut_metrik:
                _c0, _g0 = _mevcut_metrik[_ad]
                _row[f"CAPTURE FARKI (model - {_ad.lower()})"] = \
                    round(_cap_md - _c0, 4) if np.isfinite(_cap_md) and np.isfinite(_c0) else None
                _row[f"GINI FARKI (model - {_ad.lower()})"] = \
                    round(_gin_md - _g0, 4) if np.isfinite(_gin_md) and np.isfinite(_g0) else None
            kiyas_l.append(_row)

            # ---- kaçan dilim: mevcut skor B5-20 & MODEL SKORU üst %20
            # (threshold'suz tanım — PRED yerine modelin ham skorunun
            # en riskli %20'si; threshold agresifliği sonucu bozamaz)
            _kacan_katlar = {}
            for _ad, _col, _isaret in KIYAS_SKORLARI:
                _okm = dsub[_col].notna() & dsub[_skor_m].notna()
                if not _okm.any():
                    continue
                _dk = dsub.loc[_okm]
                _b_mev = _bucketla_riskli(_isaret * _dk[_col].to_numpy(dtype="float64"))
                _b_mod = _bucketla_riskli(_dk[_skor_m].to_numpy(dtype="float64"))
                _temiz    = _b_mev > KACAN_UST    # mevcut skorun temiz dediği B5-20
                _isaretli = _b_mod <= KACAN_UST   # model skorunun en riskli %20'si
                _kac   = _temiz & _isaretli
                _n_kac = int(_kac.sum())
                _yk = pd.to_numeric(_dk[_a], errors="coerce")
                _act_kac = float(_yk[_kac].mean()) if _n_kac else np.nan
                _act_gen = float(_yk.mean()) if _yk.notna().any() else np.nan
                _kat = (_act_kac / _act_gen) if (np.isfinite(_act_kac)
                        and np.isfinite(_act_gen) and _act_gen > 0) else np.nan
                if np.isfinite(_kat):
                    _kacan_katlar[_ad] = _kat
                kacan_l.append({
                    "SEGMENT": etiket, "HEDEF": _a, "MEVCUT SKOR": _ad,
                    "KAÇAN KİTLE (mevcut B5-20 & model üst %20, adet)": _n_kac,
                    "KAÇAN KİTLENİN GERÇEK ORANI": round(_act_kac, 4)
                        if np.isfinite(_act_kac) else None,
                    "SEGMENT GENEL ORANI": round(_act_gen, 4)
                        if np.isfinite(_act_gen) else None,
                    "KAÇAN / GENEL (kaç kat)": round(_kat, 1)
                        if np.isfinite(_kat) else None,
                })

            # ---- hüküm: T1 fark (en iyi mevcut'a karşı) + T2 kaçan --
            _caps = [m[0] for m in _mevcut_metrik.values() if np.isfinite(m[0])]
            _gins = [m[1] for m in _mevcut_metrik.values() if np.isfinite(m[1])]
            _cap_best = max(_caps) if _caps else np.nan
            _gin_best = max(_gins) if _gins else np.nan
            _cap_fark = _cap_md - _cap_best if np.isfinite(_cap_md) and np.isfinite(_cap_best) else np.nan
            _gin_fark = _gin_md - _gin_best if np.isfinite(_gin_md) and np.isfinite(_gin_best) else np.nan
            _kat_min  = min(_kacan_katlar.values()) if _kacan_katlar else np.nan
            _ek_vaka  = int(round(_cap_fark * _vaka)) if np.isfinite(_cap_fark) else None

            t1 = (np.isfinite(_gin_fark) and _gin_fark <= ESIK_GINI_FARK and
                  np.isfinite(_cap_fark) and _cap_fark <= ESIK_CAPTURE_FARK)
            t2 = np.isfinite(_kat_min) and _kat_min <= ESIK_KACAN
            if t1 and t2:
                _hkm = f"GEREKMEYEBİLİR — mevcut skor(lar) yeterli {hkm_ek}"
            else:
                _seb = []
                if not t1:
                    _seb.append(f"model fark katıyor (GINI {_gin_fark:+.3f}, "
                                f"capture {_cap_fark:+.3f})"
                                if np.isfinite(_gin_fark) and np.isfinite(_cap_fark)
                                else "fark hesaplanamadı")
                if not t2:
                    _seb.append(f"kör nokta var (kaçan dilim genelin "
                                f"{_kat_min:.1f} katı)" if np.isfinite(_kat_min)
                                else "kaçan dilim hesaplanamadı")
                _hkm = "GEREKLİ — " + "; ".join(_seb) + f" {hkm_ek}"
            hukum_l.append({
                "SEGMENT": etiket, "HEDEF": _a, "VAKA": _vaka,
                "EN İYİ MEVCUT GINI": round(_gin_best, 4) if np.isfinite(_gin_best) else None,
                "MODEL GINI": round(_gin_md, 4) if np.isfinite(_gin_md) else None,
                "GINI FARKI (≤0.05 → mevcut yeter)": round(_gin_fark, 4)
                    if np.isfinite(_gin_fark) else None,
                "CAPTURE FARKI (≤0.05 → mevcut yeter)": round(_cap_fark, 4)
                    if np.isfinite(_cap_fark) else None,
                "MODELİN EK VAKASI (adet, capture farkı x vaka)": _ek_vaka,
                "KAÇAN DİLİM KATI (min, ≤1.5 → kör nokta yok)": round(_kat_min, 1)
                    if np.isfinite(_kat_min) else None,
                "HÜKÜM": _hkm,
            })

    # ================================================================
    # C-E) HER OOT GRUBU × HER DEĞERLENDİRME DÖNEMİ (TRAIN + OOT)
    # ================================================================
    bucket_sheetler = {}   # sheet adı → (bloklar, kıyas kolonu, işaret, dönem, tag)
    analiz_ciktilar = {}   # (OOT, tag) → {"kiyas","kacan","hukum" df + "donem"}

    for _oot, _kls in KLASORLER_OOT.items():
        _kisa = _oot.replace("OOT", "")                    # ör. 202506
        _act_cols  = [a for _, _, a in _kls]
        _pred_cols = [f"PRED_{k}" for k, _, _ in _kls
                      if f"PRED_{k}" in df_analiz.columns]
        _skorm_map = {a: f"SKOR_{k}" for k, _, a in _kls
                      if f"SKOR_{k}" in df_analiz.columns}
        if not _skorm_map:
            print(f"⚠ {_oot}: hiç SKOR_ kolonu yok → bu OOT grubu atlandı")
            continue

        # Değerlendirme dönemleri: TRAIN + grubun kendi OOT dönemi
        _degerlendirmeler = [("TRAIN", ANALIZ_DONEM)]
        _oot_don = int(_kisa)
        if _oot_don != ANALIZ_DONEM:
            _degerlendirmeler.append(("OOT", _oot_don))

        for _tag, _don in _degerlendirmeler:
            dfA0 = _kitle(_don)
            print(f"\n===== {_oot} × {_tag} (DONEM={_don}) — "
                  f"kitle: {len(dfA0):,} satır =====")
            if dfA0.empty:
                print(f"⚠ {_oot}/{_tag}: DONEM={_don} kitlesi boş → atlandı")
                continue

            _hkm_ek = ("[TRAIN — modelin lehine taraflı, OOT ile doğrulanmalı]"
                       if _tag == "TRAIN" else f"[OOT {_don} — eğitim dışı dönem]")

            # --- Bucket blokları: her kıyas skoru için GENEL + renkler
            for _ad, _col, _isaret in KIYAS_SKORLARI:
                _dfS = dfA0[dfA0[_col].notna()].copy()
                print(f"   {_ad} ({_col}): {len(_dfS):,} satır skorlu "
                      f"({len(dfA0) - len(_dfS):,} boş dışarıda)")
                if _dfS.empty:
                    continue
                _bloklar = [_bucket_blogu(_dfS, "GENEL (TÜM PORTFÖY)",
                                          _col, _isaret, _act_cols, _pred_cols)]
                for _rk in _SKOR_RENKLER:
                    _dr = _dfS[_dfS["RENK_KOD"] == _rk]
                    if len(_dr) >= ANALIZ_N_BUCKET:
                        _bloklar.append(_bucket_blogu(
                            _dr, f"{_rk}-{_renk_map.get(_rk, _rk)}",
                            _col, _isaret, _act_cols, _pred_cols))
                    else:
                        print(f"   ⚠ {_ad} / RENK {_rk}: {len(_dr)} satır — bucket için az, atlandı")
                bucket_sheetler[f"BUCKET20_{_ad}_{_kisa}_{_tag}"] = \
                    (_bloklar, _col, _isaret, _don, _tag)

            # --- Capture + GINI kıyası + KAÇAN DİLİM + HÜKÜM --------
            kiyas_satirlar, kacan_satirlar, hukum_satirlar = [], [], []
            _segment_isle(dfA0, "GENEL (TÜM PORTFÖY)", _skorm_map,
                          kiyas_satirlar, kacan_satirlar, hukum_satirlar,
                          hkm_ek=_hkm_ek)
            for _rk in _SKOR_RENKLER:
                _dr = dfA0[dfA0["RENK_KOD"] == _rk]
                if len(_dr):
                    _segment_isle(_dr, f"{_rk}-{_renk_map.get(_rk, _rk)}",
                                  _skorm_map, kiyas_satirlar, kacan_satirlar,
                                  hukum_satirlar, hkm_ek=_hkm_ek)
            analiz_ciktilar[(_oot, _tag)] = {
                "kiyas": pd.DataFrame(kiyas_satirlar),
                "kacan": pd.DataFrame(kacan_satirlar),
                "hukum": pd.DataFrame(hukum_satirlar),
                "donem": _don,
            }

    if not analiz_ciktilar:
        raise RuntimeError("Hiçbir OOT için analiz üretilemedi — SKOR_ kolonlarını kontrol edin.")

    # ================================================================
    # E-2) OZET — dönem bazında adetler (bucket'suz, modelden bağımsız)
    # "O dönemde kaç kişi vardı, kaçı kırmızıya / takibe geçti"
    # ================================================================
    _ACT_KAYNAK_MAP = {
        "ACT_RENK3MSONRASIKIRMIZI":  ["RENK_3M_SONRASI"],
        "ACT_RENK6MSONRASIKIRMIZI":  ["RENK_6M_SONRASI"],
        "ACT_RENK12MSONRASIKIRMIZI": ["RENK_12M_SONRASI"],
        "ACT_TAKIP6M":               ["AKB_GGS_6_90", "AKB_TAKIP_6M"],
    }
    _ozet_donemler = sorted({ANALIZ_DONEM} |
                            {int(o.replace("OOT", "")) for o in KLASORLER_OOT})
    ozet_satirlar = []
    for _don in _ozet_donemler:
        _dk = _kitle(_don)
        if _dk.empty:
            continue

        def _ozet_isle(_dsub, _etiket):
            _r = {"DONEM": int(_don), "SEGMENT": _etiket,
                  "MÜŞTERİ": int(len(_dsub))}
            for _a in TARGET_COLS:
                # Gerçekleşme penceresi henüz oluşmadıysa (kaynak kolon
                # o dönemde tamamen boşsa) 0 yerine boş bırak — ACT'nin
                # NaN→0 dönüşümü sahte %0 üretmesin (ör. 202511'de 12M).
                _kaynaklar = _ACT_KAYNAK_MAP.get(_a, [])
                _var = any((k in _dsub.columns) and _dsub[k].notna().any()
                           for k in _kaynaklar)
                if _var:
                    _v = pd.to_numeric(_dsub[_a], errors="coerce")
                    _r[f"{_a} (adet)"] = int(_v.fillna(0).sum())
                    _r[f"{_a} (%)"]    = round(float(_v.mean()), 4)
                else:
                    _r[f"{_a} (adet)"] = None
                    _r[f"{_a} (%)"]    = None
            ozet_satirlar.append(_r)

        _ozet_isle(_dk, "GENEL (TÜM PORTFÖY)")
        for _rk in _SKOR_RENKLER:
            _dr = _dk[_dk["RENK_KOD"] == _rk]
            if len(_dr):
                _ozet_isle(_dr, f"{_rk}-{_renk_map.get(_rk, _rk)}")
    ozet_df = pd.DataFrame(ozet_satirlar)

    # ================================================================
    # F) TREND — mevcut skorların GINI'si TÜM dönemlerde (OOT'tan bağımsız)
    # ================================================================
    trend_satirlar = []
    _trend_mask_base = pd.Series(True, index=df_analiz.index)
    if "KK_URUN_FLG" in df_analiz.columns:
        _trend_mask_base &= (df_analiz["KK_URUN_FLG"] == "KK")

    for _don in ortak_donemler:
        _dfd = df_analiz.loc[_trend_mask_base & (df_analiz["DONEM"] == _don)]
        if _dfd.empty:
            continue

        def _trend_isle(_dsub, _etiket):
            for _a in TARGET_COLS:
                _yv = pd.to_numeric(_dsub[_a], errors="coerce")
                _r = {"DONEM": int(_don), "SEGMENT": _etiket, "HEDEF": _a,
                      "VAKA": int(_yv.fillna(0).sum())}
                for _ad, _col, _isaret in KIYAS_SKORLARI:
                    _g = _gini(_dsub[_a],
                               _isaret * _dsub[_col].astype("float64").to_numpy())
                    _r[f"{_ad} GINI"] = round(_g, 4) if np.isfinite(_g) else None
                trend_satirlar.append(_r)

        _trend_isle(_dfd, "GENEL (TÜM PORTFÖY)")
        for _rk in _SKOR_RENKLER:
            _dr = _dfd[_dfd["RENK_KOD"] == _rk]
            if len(_dr):
                _trend_isle(_dr, f"{_rk}-{_renk_map.get(_rk, _rk)}")
        print(f"   TREND {_don}: hesaplandı ({len(_dfd):,} satır)")

    trend_df = pd.DataFrame(trend_satirlar)
    if not trend_df.empty:
        trend_df = trend_df.sort_values(
            ["HEDEF", "SEGMENT", "DONEM"]).reset_index(drop=True)

    # ================================================================
    # G) EXCEL — OOT bazlı sheet'ler
    # ================================================================
    _fill  = PatternFill("solid", fgColor="F4CCCC")
    _byz   = Font(bold=True, color="7A1F1F")
    _yesil = PatternFill("solid", fgColor="C6EFCE")
    _kirm  = PatternFill("solid", fgColor="FFC7CE")
    buf = BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as xl:
        wb = xl.book

        def _notlar_yaz(ws, satirlar):
            """A1'den itibaren açıklama satırları; A1 bold."""
            for _i, _txt in enumerate(satirlar, start=1):
                ws[f"A{_i}"] = _txt
                ws[f"A{_i}"].font = Font(bold=(_i == 1))

        def _tablo_stil(ws, kolonlar, n_satir, pct_kosul,
                        genislik=18, freeze="C6"):
            """5. satır header stili + kolon genişliği + % formatı + freeze."""
            for c in range(1, len(kolonlar) + 1):
                h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
                h.alignment = Alignment(wrap_text=True, vertical="top")
                ws.column_dimensions[get_column_letter(c)].width = genislik
            _fmt = [i + 1 for i, c in enumerate(kolonlar) if pct_kosul(str(c))]
            for _c in _fmt:
                for _r in range(6, 6 + n_satir):
                    ws.cell(row=_r, column=_c).number_format = "0.00%"
            ws.freeze_panes = freeze

        # --- Sheet grubu 1: HUKUM_<oot>_<tag> (cevaplar önde) -------
        for (_oot, _tag), _cikti in analiz_ciktilar.items():
            _kisa = _oot.replace("OOT", "")
            _don  = _cikti["donem"]
            hukum_df = _cikti["hukum"]
            _sh = f"HUKUM_{_kisa}_{_tag}"
            if hukum_df.empty or hukum_df.shape[1] == 0:
                print(f"⚠ {_oot}/{_tag}: hüküm tablosu boş → {_sh} yazılmadı")
                continue
            hukum_df.to_excel(xl, sheet_name=_sh, index=False, startrow=4)
            ws = wb[_sh]
            if _tag == "TRAIN":
                _don_not = ("⚠ Bu sheet TRAIN dönemi: model skorları EĞİTİM "
                            "döneminden, kıyas modelin LEHİNE taraflı — asıl hüküm "
                            f"HUKUM_{_kisa}_OOT sheet'inden okunmalı. ")
            else:
                _don_not = (f"Bu sheet OOT dönemi ({_don}): model skorları eğitim "
                            "DIŞI dönemden — tarafsız, karar için esas sheet. ")
            _notlar_yaz(ws, [
                (f"HÜKÜM [{_oot} modelleri × {_tag}]: MEVCUT SKORLAR (DAVRANIS + "
                 f"MUSTERI) VARKEN MODELLER GEREKLİ Mİ? — DONEM={_don}"),
                (_don_not +
                 "GENEL satırında 6 renk modelinin skoru TEK HAVUZDA birleşir; "
                 "her model kendi segmentinde kalibre olduğundan GENEL kıyası "
                 "modele KARŞI taraflıdır — KARAR RENK SATIRLARINDAN OKUNMALIDIR. "
                 "TREND sheet'i stabilite içindir."),
                ("KURAL: 'gerekmeyebilir' için İKİ TEST birden geçmeli. T1 FARK: modelin "
                 "GINI ve capture katkısı en iyi mevcut skora göre ≤0.05. T2 KAÇAN: mevcut "
                 "skorlardan EN AZ BİRİNİN temiz dediği (B5-20) ama model skorunun en riskli "
                 "%20'sine giren kitlenin gerçek oranı genelin ≤1.5 katı (kör nokta yok). "
                 "Eşikler öneridir — ESIK_* sabitlerinden ayarlanır."),
            ])
            _tablo_stil(ws, hukum_df.columns, len(hukum_df),
                        lambda c: ("GINI" in c or "CAPTURE" in c or "FARKI" in c))
            ws.column_dimensions[get_column_letter(hukum_df.shape[1])].width = 55
            for _r in range(6, 6 + len(hukum_df)):
                _v = ws.cell(row=_r, column=hukum_df.shape[1]).value
                if isinstance(_v, str) and _v.startswith("GEREKLİ"):
                    ws.cell(row=_r, column=hukum_df.shape[1]).fill = _kirm
                elif isinstance(_v, str) and _v.startswith("GEREKMEYEBİLİR"):
                    ws.cell(row=_r, column=hukum_df.shape[1]).fill = _yesil

        # --- Sheet grubu 1.5: OZET_ADETLER (dönem bazında adetler) --
        if not ozet_df.empty:
            ozet_df.to_excel(xl, sheet_name="OZET_ADETLER", index=False, startrow=4)
            ws = wb["OZET_ADETLER"]
            _notlar_yaz(ws, [
                ("ÖZET — DÖNEM BAZINDA ADETLER: o dönemde kaç müşteri vardı, "
                 "kaçı kırmızıya / takibe geçti (bucket'suz, modelden bağımsız "
                 "gerçekleşme sayıları)."),
                ("Kitle: KK ürün müşterileri, GENEL + renk kırılımı. Boş hücre = o "
                 "hedefin gerçekleşme penceresi henüz oluşmadı (ör. 202511 için 12M "
                 "sonrası = 202611). Aynı adetler bucket sheet'lerindeki TOPLAM "
                 "satırlarında da vardır; bu sheet hepsini tek yerde toplar."),
            ])
            _tablo_stil(ws, ozet_df.columns, len(ozet_df),
                        lambda c: c.endswith("(%)"))
            _adet_c = [i + 1 for i, c in enumerate(ozet_df.columns)
                       if c.endswith("(adet)") or c == "MÜŞTERİ"]
            for _c in _adet_c:
                for _r in range(6, 6 + len(ozet_df)):
                    ws.cell(row=_r, column=_c).number_format = "#,##0"

        # --- Sheet grubu 2: BUCKET20_<skor>_<oot>_<tag> -------------
        for _sheet, (_bloklar, _col, _isaret, _don, _tag) in bucket_sheetler.items():
            r = 4
            ilk = True
            for b in _bloklar:
                b.to_excel(xl, sheet_name=_sheet, index=False,
                           startrow=r, header=ilk)
                r += len(b) + (1 if ilk else 0) + 2
                ilk = False
            ws = wb[_sheet]
            _yon = ("DÜŞÜK skor = riskli (skor yüksek=iyi)" if _isaret < 0
                    else "YÜKSEK skor = riskli (skor 1'e yaklaştıkça kötü)")
            _oot_ad = "OOT" + _sheet.rsplit("_", 2)[-2]
            _tag_not = ("⚠ TRAIN verisi — model kolonları eğitim dönemi, modelin "
                        "lehine taraflı." if _tag == "TRAIN"
                        else "OOT verisi — model kolonları eğitim dışı dönem, tarafsız.")
            _notlar_yaz(ws, [
                (f"{_col} 20'Lİ BUCKET [{_oot_ad} modelleri × {_tag}] — "
                 f"DONEM={_don}, KK. "
                 f"BUCKET 1 = en riskli %5 — {_yon}."),
                ("ACT_ = o bucket'ta GERÇEKLEŞME oranı (bu skor gerçek riski ayrıştırıyor "
                 "mu); '(adet)' = o bucket'ta gerçekleşen vaka SAYISI. Her segment "
                 "bloğunun sonundaki TOPLAM satırı dönemin tamamını verir: kaç müşteri "
                 "vardı, kaçı kırmızıya/takibe geçti (adet + oran). "
                 "PRED_ = o bucket'ta MODELİN 1 bastığı oran (model bu skorun iyi "
                 "dediği bucket'larda da risk buluyor mu). '(kendi bucket)' = AYNI kitle "
                 f"{_col} yerine modelin KENDİ ham skoruna göre 20'ye bölündüğünde o "
                 "bucket no'daki PRED oranı — bu skorla filtrelenmemiş referans. Yan yana "
                 "okuma: soldaki kolon 'bu skorun bucket'ında model ne diyor', sağdaki "
                 "'modelin kendi bucket'ında ne diyor'."),
                ("OKUMA: ACT_ sadece bucket 1-2'de toplanıyorsa bu skor yeterli iddiası "
                 "güçlenir; üst bucket'larda hâlâ ACT_/PRED_ kayda değerse modeller kör "
                 "noktayı yakalıyor demektir. Renk bloklarında bucket renk İÇİNDE kesilir. "
                 + _tag_not),
            ])
            _b0 = _bloklar[0]
            for c in range(1, _b0.shape[1] + 1):
                h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
                h.alignment = Alignment(wrap_text=True, vertical="top")
                ws.column_dimensions[get_column_letter(c)].width = 15
            _pct_c = [i + 1 for i, c in enumerate(_b0.columns) if c.endswith("(%)")]
            for _c in _pct_c:
                for _r in range(6, r + 1):
                    ws.cell(row=_r, column=_c).number_format = "0.00%"
            _adet_c = [i + 1 for i, c in enumerate(_b0.columns)
                       if c.endswith("(adet)") or c == "MÜŞTERİ"]
            for _c in _adet_c:
                for _r in range(6, r + 1):
                    ws.cell(row=_r, column=_c).number_format = "#,##0"
            ws.freeze_panes = "C6"

        # --- Sheet grubu 3: CAPTURE_GINI_KIYAS_<oot>_<tag> ----------
        for (_oot, _tag), _cikti in analiz_ciktilar.items():
            _kisa = _oot.replace("OOT", "")
            _don  = _cikti["donem"]
            kiyas_df = _cikti["kiyas"]
            if kiyas_df.empty:
                continue
            _sh = f"CAPT_GINI_KIYAS_{_kisa}_{_tag}"
            kiyas_df.to_excel(xl, sheet_name=_sh, index=False, startrow=4)
            ws = wb[_sh]
            _kynk_not = ("model kolonları eğitim dönemi (modelin lehine taraflı)."
                         if _tag == "TRAIN"
                         else "model kolonları eğitim DIŞI OOT dönemi (tarafsız).")
            _notlar_yaz(ws, [
                (f"CAPTURE@20% + GINI [{_oot} modelleri × {_tag}] — DAVRANIS vs "
                 f"MUSTERI vs MODEL, aynı hedefte üç sıralamanın gücü (DONEM={_don})."),
                ("CAPTURE@20%: en riskli %20 önceden işaretlenseydi vakaların yüzde kaçı "
                 "yakalanırdı. GINI=2*AUC-1: tüm sıralamanın gücü. DAVRANIS düşük=riskli, "
                 "MUSTERI yüksek=riskli, MODEL ham skor (skorlu alt kitlede). NEGATİF GINI "
                 "= skor bu hedefte TERS çalışıyor. ⚠ GENEL satırında model skorları tek "
                 "havuzda birleşik (modele karşı taraflı) — karar RENK satırlarından "
                 "okunmalı; " + _kynk_not),
            ])
            _tablo_stil(ws, kiyas_df.columns, len(kiyas_df),
                        lambda c: ("capture" in c or "CAPTURE" in c or "GINI" in c))

        # --- Sheet grubu 4: KACAN_DILIM_<oot>_<tag> -----------------
        for (_oot, _tag), _cikti in analiz_ciktilar.items():
            _kisa = _oot.replace("OOT", "")
            _don  = _cikti["donem"]
            kacan_df = _cikti["kacan"]
            if kacan_df.empty:
                continue
            _sh = f"KACAN_DILIM_{_kisa}_{_tag}"
            kacan_df.to_excel(xl, sheet_name=_sh, index=False, startrow=4)
            ws = wb[_sh]
            _notlar_yaz(ws, [
                (f"KAÇAN DİLİM [{_oot} modelleri × {_tag}] — mevcut skorun TEMİZ dediği "
                 f"(bucket 5-20) ama MODEL SKORUNUN EN RİSKLİ %20'sine giren kitle "
                 f"gerçekte ne yaptı? (DONEM={_don})"),
                ("Tanım threshold'suzdur: PRED yerine modelin ham skorunun üst %20'si "
                 "kullanılır — modelin threshold agresifliği sonucu etkilemez. KAÇ KAT "
                 "yüksekse model, mevcut skorun göremediği gerçek riski buluyor demektir; "
                 "≈1 civarındaysa kör nokta yok. Hüküm her hedef için İKİ skordan KÜÇÜK "
                 "olan katı kullanır (biri kör noktayı kapatıyorsa o skor işi görür)."),
            ])
            _tablo_stil(ws, kacan_df.columns, len(kacan_df),
                        lambda c: "ORANI" in c, genislik=20, freeze="D6")

        # --- Sheet 5: TREND (tek — OOT'tan bağımsız) ----------------
        if not trend_df.empty:
            trend_df.to_excel(xl, sheet_name="TREND", index=False, startrow=4)
            ws = wb["TREND"]
            _notlar_yaz(ws, [
                ("TREND — MEVCUT SKORLARIN GINI'Sİ TÜM DÖNEMLERDE "
                 f"({', '.join(str(d) for d in ortak_donemler)})"),
                ("Amaç: hükümlerin dayandığı dönemler sınırlı; mevcut skorların "
                 "zayıflığı/tersliği dönemsel tesadüf mü, KALICI mı? Not: kıyas "
                 "skorları veri kaynağında yalnız belirli dönemlerde dolu olabilir; "
                 "boş GINI hücresi o dönemde skor verisi olmadığını gösterir. "
                 "Bu tablo yalnız DAVRANIS/MUSTERI skorlarını kapsar "
                 "(model/OOT'tan bağımsız, tek tablo). NEGATİF GINI = ters çalışıyor."),
            ])
            _tablo_stil(ws, trend_df.columns, len(trend_df),
                        lambda c: "GINI" in c, freeze="E6")

    buf.seek(0)
    _rapor_yolu = "/kiyas_skorlari_vs_modeller_bucket20.xlsx"
    mf.upload_stream(_rapor_yolu, buf)
    print(f"\n✓ {_rapor_yolu} yazıldı — sheet'ler: {', '.join(wb.sheetnames)}")
    del _kitle_cache

