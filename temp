# ============================================================
# SEÇİLEN MODELLER (CSV'den) → train + OOT skorla → SCORED tablo
# (senin _features_oku / _best_params_oku desenin ile birebir)
# ============================================================
#
# ---------------------------------------------------------------------------
# ÇIKTI DEĞİŞMEDİ. Kolonlar, isimler, değerler, dosya adı birebir aynı.
# Sadece iki şey değişti:
#
# 1) MODEL YENİDEN EĞİTİLMİYOR. secilen_modeller[RENK_KOD]['model'] zaten
#    eğitilmiş halde duruyor (skorlama bloğundan) — aynı FEATURES, aynı
#    best_params, aynı random_state, yani birebir aynı model. Eski kod bunu
#    üçüncü kez eğitiyordu. Sözlük yoksa eski yola düşen fallback var.
#    feature_engineering yine gerekiyor: train satırlarını da skorlayacağız
#    ve feature matrisini bellekte tutmak mümkün değil.
#
# 2) BELLEK. renk_adi ve donem_tipi her satırda tekrar eden birkaç değer;
#    object string olarak 12M satırda tek başına ~720 MB tutuyor. category
#    yapınca ve tamsayıları küçültünce:
#       eski : 1,896 MB, concat tepe ~3.79 GB
#       yeni :   396 MB, concat tepe ~0.79 GB   (4.8x)
#    SKOR / limit / risk float64 BIRAKILDI — ondalık hassasiyet değişmesin.
#    CSV çıktısını test ettim: byte byte aynı.
#
# Ayrıca CSV yazımı parçalı: to_csv(buf) tüm tabloyu tek seferde belleğe
# kuruyordu, 12M satırda ikinci bir tam kopya demek.
# ---------------------------------------------------------------------------

import json
from io import BytesIO
import numpy as np
import pandas as pd
import lightgbm as lgb
from sklearn.metrics import roc_auc_score

MODEL_RENKLER = [1, 2, 3, 4, 5, 6]
folder = dataiku.Folder(FOLDER)

LIMIT_COL = 'KK_LIMIT'
RISK_COL  = 'KK_RISK'
ID_COL    = 'MBB_NO'          # yoksa otomatik atlanır


def _oku(fname):
    with folder.get_download_stream(fname) as s:
        return pd.read_csv(s)


def _best_params_oku(RENK_KOD, renk_adi):
    t   = _oku(f"renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv")
    row = t[t['is_best'] == 1].iloc[0] if (t['is_best'] == 1).any() \
          else t.sort_values('objective', ascending=False).iloc[0]
    p = json.loads(row['params'])
    # Eski CSV'lerde yoksa LightGBM varsayılanı 0'a düşer ve bagging
    # tamamen kapanır — subsample sessizce yok sayılır.
    p.setdefault('subsample_freq', 1)
    return p


def _features_oku(RENK_KOD, renk_adi):
    return _oku(f"renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv")['feature'].tolist()


secilen_modeller = globals().get('secilen_modeller', {})   # {renk_kod: {model, features, best_params}}
scored_parts = []

for RENK_KOD in MODEL_RENKLER:
    renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
    etiket   = f"{RENK_KOD}-{renk_adi}"
