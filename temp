import re

# Aile token'ı -> açıklamada geçmesi gereken kelime eşlemesi
def check_family_semantics(families):
    problems = []
    for fam, items in families.items():
        toks = fam.split("_")
        for metric, desc in items:
            d = desc.lower()
            # 1) YÖN kontrolü
            if "giden" in d and not ("GDN" in toks or toks[0] == "OUT"):
                problems.append((fam, metric, "yön: açıklama 'giden' diyor", desc))
            if "gelen" in d and not ("GLN" in toks or toks[0] == "IN"):
                problems.append((fam, metric, "yön: açıklama 'gelen' diyor", desc))
            # 2) PENCERE kontrolü (ilk 'son N gün' ifadesi aile adında olmalı)
            m = re.search(r"son\s+(\d+)\s+g[üu]n", d)
            if m and f"{m.group(1)}D" not in toks:
                problems.append((fam, metric, f"pencere: açıklama 'son {m.group(1)} gün' diyor", desc))
            # 3) SEGMENT kontrolü
            for tok_ad, kelime in (("KRIPTO", "kripto"), ("ODEME", "ödeme"), ("BAHIS", "bahis")):
                if kelime in d and tok_ad not in toks:
                    problems.append((fam, metric, f"segment: açıklama '{kelime}' diyor", desc))
                if tok_ad in toks and kelime not in d:
                    problems.append((fam, metric, f"segment: aile {tok_ad} ama açıklamada '{kelime}' yok", desc))
    return problems

problems = check_family_semantics(families)
print(f"Anlamsal uyumsuzluk: {len(problems)} / 1038 kolon")
for fam, metric, sorun, desc in problems[:30]:
    print(f"  {fam}_{metric} | {sorun}\n    -> {desc}")

