ESKI, YENI = "ters_U_orta_dilimler_riskli", "∩_orta_dilimler_riskli"

# Bellekteki + diskteki registry ve red arşivi
for k in registry:
    i = k["istatistikler"]
    if i.get("egri_sekli") == ESKI:
        i["egri_sekli"] = YENI
    if ESKI in k.get("yon_notu", ""):
        k["yon_notu"] = k["yon_notu"].replace(ESKI, YENI)
for r in red_registry:
    i = r.get("istatistikler")
    if i and i.get("egri_sekli") == ESKI:
        i["egri_sekli"] = YENI

state_write_text(REGISTRY_FILE, json.dumps(registry, ensure_ascii=False, indent=2))
state_write_text(REJECTS_FILE, json.dumps(red_registry, ensure_ascii=False, indent=2))

# feature_log.md: düz metin değişimi
log = state_read_text(LOG_FILE)
state_write_text(LOG_FILE, log.replace(ESKI, YENI))

print("Migrasyon tamam: registry + rejects + log güncellendi.")
