def _yaz(fname, df_out, chunk=250_000):
    """DataFrame'i folder'a CSV yaz. Dosya PATH alt klasörüne gider."""
    hedef = PATH + "/" + fname.lstrip("/")      # alt klasör yolu otomatik ekleniyor
    with folder.get_writer(hedef) as w:
        if len(df_out) == 0:
            w.write(df_out.to_csv(index=False).encode("utf-8")); return
        for i in range(0, len(df_out), chunk):
            w.write(df_out.iloc[i:i+chunk].to_csv(index=False, header=(i==0)).encode("utf-8"))
