WITH baz AS (
    SELECT MBB_NO, TARIH, DONEM, "KK_LIMIT", "KK_URUN_FLG",
           "IHT_URUN_FLG", "AP_URUN_FLG", "IHT_KULL_FLG",
           "MMS_DS_ONERI_RENK" AS RENK_GUNCEL
    FROM "SBXKVA"."MUS_YENI_RENKLER_TUM_PORTFOY"
    WHERE DONEM IN (202504, 202506, 202511)
),
komsu AS (
    SELECT MBB_NO, TARIH, MMS_DS_ONERI_RENK
    FROM "SBXKVA"."MUS_YENI_RENKLER_TUM_PORTFOY"
    WHERE TARIH BETWEEN (SELECT ADD_MONTHS(MIN(TARIH), -12) FROM baz)
                    AND (SELECT ADD_MONTHS(MAX(TARIH),  12) FROM baz)
)
SELECT t1.MBB_NO, t1.TARIH, t1.DONEM, t1."KK_LIMIT", t1."KK_URUN_FLG",
       t1."IHT_URUN_FLG", t1."AP_URUN_FLG", t1."IHT_KULL_FLG", t1.RENK_GUNCEL,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -1 THEN k.MMS_DS_ONERI_RENK END) AS RENK_LM,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -2 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L2M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -3 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L3M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -4 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L4M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -5 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L5M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -6 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L6M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -7 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L7M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -8 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L8M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  -9 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L9M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) = -10 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L10M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) = -11 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L11M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) = -12 THEN k.MMS_DS_ONERI_RENK END) AS RENK_L12M,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =   3 THEN k.MMS_DS_ONERI_RENK END) AS RENK_3M_SONRASI,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =   6 THEN k.MMS_DS_ONERI_RENK END) AS RENK_6M_SONRASI,
       MAX(CASE WHEN ROUND(MONTHS_BETWEEN(k.TARIH, t1.TARIH)) =  12 THEN k.MMS_DS_ONERI_RENK END) AS RENK_12M_SONRASI
FROM baz t1
LEFT JOIN komsu k
       ON k.MBB_NO = t1.MBB_NO
      AND k.TARIH BETWEEN ADD_MONTHS(t1.TARIH, -12) AND ADD_MONTHS(t1.TARIH, 12)
GROUP BY t1.MBB_NO, t1.TARIH, t1.DONEM, t1."KK_LIMIT", t1."KK_URUN_FLG",
         t1."IHT_URUN_FLG", t1."AP_URUN_FLG", t1."IHT_KULL_FLG", t1.RENK_GUNCEL
