        print("  train tek sınıf, atlandı"); continue

    # 4b) train / val — pipeline ile AYNI bölme.
    #     Model sadece train ile eğitildi; val'i ayrı etiketlemek için
    #     burada da aynı bölmeyi kurmamız gerekiyor.
    train, val = train_test_split(train_full,
                                  test_size=VAL_ORAN,
                                  stratify=train_full[TARGET],
                                  shuffle=True,
                                  random_state=RANDOM_STATE)
    X_tr, y_tr = train[FEATURES], train[TARGET]

    # 5) Model — skorlama bloğundakiyle AYNI model; varsa yeniden eğitilmiyor
    _hazir = ((RENK_KOD in secilen_modeller)
