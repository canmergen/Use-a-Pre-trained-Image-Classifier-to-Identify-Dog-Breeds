# Dosyanın literal hali: (3D - 7D) / 7D
df["H06_TREND_RATIO"] = (df["TXN_GLN_3D_AMT"] - df["TXN_GLN_7D_AMT"]) / (df["TXN_GLN_7D_AMT"] + 1)

# Günlük ortalamaya normalize edilmiş momentum (1 = sabit hız, <1 = yavaşlama)
df["H06_MOMENTUM"] = (df["TXN_GLN_3D_AMT"] / 3) / (df["TXN_GLN_7D_AMT"] / 7 + 1)

# Son 3 günün 7 günlük toplam içindeki payı (0-1 arası)
df["H06_RECENT_SHARE"] = df["TXN_GLN_3D_AMT"] / (df["TXN_GLN_7D_AMT"] + 1)
