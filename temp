YASAK_KALIPLAR = ["import", "eval", "exec", "lambda", "__", "os.", "open(", "=", ";"]

def oneri_dogrula(oneri, target_df):
    """Öneriyi doğrular. Dönüş: (True, seri) veya (False, red_nedeni)."""
    formul = str(oneri.get("formul", "")).strip()
    kolonlar = oneri.get("kullanilan_kolonlar", [])

    yok = [k for k in kolonlar if k not in target_df.columns]
    if yok:
        return False, f"şemada olmayan kolon: {yok}"
    gecen = [k for k in YASAKLI_KOLONLAR if k in formul]
    if gecen:
        return False, f"yasaklı kolon formülde: {gecen}"
    kalip = [k for k in YASAK_KALIPLAR if k in formul]
    if kalip:
        return False, f"yasaklı kalıp: {kalip}"
    try:
        ast.parse(formul, mode="eval")
    except SyntaxError as e:
        return False, f"söz dizimi hatası: {e}"
    try:
        ornek = target_df.head(1000)
        seri_ornek = eval(formul, {"__builtins__": {}}, {"df": ornek, "np": np, "pd": pd})
    except Exception as e:
        return False, f"çalıştırma hatası: {e}"
    seri = eval(formul, {"__builtins__": {}}, {"df": target_df, "np": np, "pd": pd})
    seri = pd.Series(seri, index=target_df.index).astype(float)
    if seri.replace([np.inf, -np.inf], np.nan).nunique(dropna=True) <= 1:
        return False, "çıktı sabit (ayrıştırma gücü yok)"
    return True, seri

def egri_sekli_bul(rates):
    """Decile eğrisinin şeklini sınıflandırır. Dönüş: (sekil, yon_guvenilir)."""
    r = pd.Series(rates, dtype=float)
    rho = r.corr(pd.Series(np.arange(len(r)), dtype=float), method="spearman")
    if pd.notna(rho) and abs(rho) >= 0.7:
        return ("monoton_artan" if rho > 0 else "monoton_azalan"), True
    tepe, dip = int(r.idxmax()), int(r.idxmin())
    ic = range(1, len(r) - 1)
    if tepe in ic and r.iloc[0] < r.iloc[tepe] and r.iloc[-1] < r.iloc[tepe]:
        return "ters_U_orta_dilimler_riskli", False
    if dip in ic and r.iloc[0] > r.iloc[dip] and r.iloc[-1] > r.iloc[dip]:
        return "U_uclar_riskli", False
    return "karisik", False

def istatistik_hesapla(seri, target_df):
    """Decile bazlı bad-rate analizi + eğri şekli. LLM'e sorulmaz, kod ölçer."""
    t = target_df[TARGET_COL].to_numpy()
    s = seri.replace([np.inf, -np.inf], np.nan)
    base_rate = t.mean()
    try:
        dilim = pd.qcut(s, 10, labels=False, duplicates="drop")
    except Exception:
        return None
    tablo = (pd.DataFrame({"dilim": dilim, "t": t})
             .dropna().groupby("dilim")["t"].agg(["mean", "size"]))
    if len(tablo) < 3:
        return None

    en_riskli = tablo["mean"].idxmax()
    seg_rate  = tablo.loc[en_riskli, "mean"]
    pp_gap = (seg_rate - base_rate) * 100
    lift   = seg_rate / base_rate if base_rate > 0 else np.nan
    yon = "yuksek_riskli" if tablo["mean"].iloc[-1] >= tablo["mean"].iloc[0] else "dusuk_riskli"
    sekil, yon_guvenilir = egri_sekli_bul(tablo["mean"].tolist())

    return {
        "base_rate": round(float(base_rate), 4),
        "en_riskli_dilim_rate": round(float(seg_rate), 4),
        "pp_gap": round(float(pp_gap), 2),
        "lift": round(float(lift), 3),
        "gozlenen_yon": yon,
        "egri_sekli": sekil,
        "yon_guvenilir": yon_guvenilir,
        "sifir_orani": round(float((s == 0).mean()), 3),
        "decile_egrisi": [round(float(x), 3) for x in tablo["mean"].tolist()],
    }

def max_korelasyon(seri, target_df, mevcut_llm_features):
    """Yeni serinin mevcut LLM feature'larıyla maksimum |korelasyon|u."""
    if not mevcut_llm_features:
        return 0.0
    en_yuksek = 0.0
    s = seri.replace([np.inf, -np.inf], np.nan)
    for ad in mevcut_llm_features:
        c = s.corr(target_df[ad].replace([np.inf, -np.inf], np.nan))
        if pd.notna(c):
            en_yuksek = max(en_yuksek, abs(float(c)))
    return round(en_yuksek, 3)

