# Dosyanın literal hali: 14 günlük / 3 günlük (yüksek = son 3 gün zayıf)
df["H04_DROP_RATIO"] = df["TXN_GLN_14D_AMT"] / (df["TXN_GLN_3D_AMT"] + 1)

# Günlük ortalamaya normalize edilmiş momentum (1 = sabit, <1 = düşüş)
df["H04_MOMENTUM"] = (df["TXN_GLN_3D_AMT"] / 3) / (df["TXN_GLN_14D_AMT"] / 14 + 1)

# Son 3 günün 14 günlük toplam içindeki payı (0-1 arası, sınırlı)
df["H04_RECENT_SHARE"] = df["TXN_GLN_3D_AMT"] / (df["TXN_GLN_14D_AMT"] + 1)
