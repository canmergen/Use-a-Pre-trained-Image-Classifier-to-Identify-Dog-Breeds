WITH INP_DEDUP AS (
    SELECT
        KDS_TON_ONAY_MBB_NO,
        KDS_TON_ONAY_SM_ID,
        MAX(KDS_TON_ONAY_O5233) AS MMS_BATCH,
        MAX(KDS_TON_ONAY_O0120) AS KKB_SKOR
    FROM PKRA.KRA_TSM_BATCH_INPUT
    GROUP BY KDS_TON_ONAY_MBB_NO, KDS_TON_ONAY_SM_ID
),
ONONY AS (
    SELECT
        A.MBB_NO,
        LAST_DAY(TRUNC(A.ISLEM_ZAMANI)) AS AY_SONU,
        INP.MMS_BATCH,
        INP.KKB_SKOR
    FROM (
        SELECT
            KDS_LOB_MBB_NO AS MBB_NO,
            KDS_LOB_SM_ID  AS SM_ID,
            KDS_LOB_ISLEM_ZAMANI AS ISLEM_ZAMANI,
            ROW_NUMBER() OVER (
                PARTITION BY KDS_LOB_MBB_NO, LAST_DAY(TRUNC(KDS_LOB_ISLEM_ZAMANI))
                ORDER BY KDS_LOB_ISLEM_ZAMANI DESC
            ) AS RW_NB
        FROM PODS.KDS_TONL_LOG_BRY_KRD
        WHERE KDS_LOB_BASVURU_TIP = 'ONONY'
          AND KDS_LOB_ISLEM_ZAMANI >= TO_DATE('01.04.2024','dd.mm.yyyy')
          AND KDS_LOB_ISLEM_ZAMANI <  TO_DATE('30.11.2025','dd.mm.yyyy') + 1
    ) A
    LEFT JOIN INP_DEDUP INP
           ON A.MBB_NO = INP.KDS_TON_ONAY_MBB_NO
          AND A.SM_ID  = INP.KDS_TON_ONAY_SM_ID
    WHERE A.RW_NB = 1
),
PORTFOY AS (
    SELECT *
    FROM "SBXKVA"."MUS_YENI_RENKLER_TUM_PORTFOY"
    WHERE DONEM IN (202506, 202504, 202511)
),
ANAHTAR AS (
    SELECT DISTINCT
        MBB_NO,
        LAST_DAY(TRUNC(TARIH)) AS TARIH
    FROM PORTFOY
),
PVT AS (
    SELECT
        K.MBB_NO,
        K.TARIH,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  0 THEN O.MMS_BATCH END) AS MMS,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  1 THEN O.MMS_BATCH END) AS MMS_LM,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  2 THEN O.MMS_BATCH END) AS MMS_L2M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  3 THEN O.MMS_BATCH END) AS MMS_L3M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  4 THEN O.MMS_BATCH END) AS MMS_L4M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  5 THEN O.MMS_BATCH END) AS MMS_L5M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  6 THEN O.MMS_BATCH END) AS MMS_L6M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  7 THEN O.MMS_BATCH END) AS MMS_L7M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  8 THEN O.MMS_BATCH END) AS MMS_L8M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  9 THEN O.MMS_BATCH END) AS MMS_L9M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 10 THEN O.MMS_BATCH END) AS MMS_L10M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 11 THEN O.MMS_BATCH END) AS MMS_L11M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 12 THEN O.MMS_BATCH END) AS MMS_L12M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  0 THEN O.KKB_SKOR END)  AS KKB_SKOR,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  1 THEN O.KKB_SKOR END)  AS KKB_SKOR_LM,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  2 THEN O.KKB_SKOR END)  AS KKB_SKOR_L2M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  3 THEN O.KKB_SKOR END)  AS KKB_SKOR_L3M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  4 THEN O.KKB_SKOR END)  AS KKB_SKOR_L4M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  5 THEN O.KKB_SKOR END)  AS KKB_SKOR_L5M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  6 THEN O.KKB_SKOR END)  AS KKB_SKOR_L6M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  7 THEN O.KKB_SKOR END)  AS KKB_SKOR_L7M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  8 THEN O.KKB_SKOR END)  AS KKB_SKOR_L8M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) =  9 THEN O.KKB_SKOR END)  AS KKB_SKOR_L9M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 10 THEN O.KKB_SKOR END)  AS KKB_SKOR_L10M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 11 THEN O.KKB_SKOR END)  AS KKB_SKOR_L11M,
        MAX(CASE WHEN ROUND(MONTHS_BETWEEN(K.TARIH, O.AY_SONU)) = 12 THEN O.KKB_SKOR END)  AS KKB_SKOR_L12M
    FROM ANAHTAR K
    JOIN ONONY O
      ON O.MBB_NO = K.MBB_NO
     AND O.AY_SONU BETWEEN LAST_DAY(ADD_MONTHS(K.TARIH, -12)) AND K.TARIH
    GROUP BY K.MBB_NO, K.TARIH
)
SELECT
    T1.*,
    P.MMS,
    P.MMS_LM,
    P.MMS_L2M,
    P.MMS_L3M,
    P.MMS_L4M,
    P.MMS_L5M,
    P.MMS_L6M,
    P.MMS_L7M,
    P.MMS_L8M,
    P.MMS_L9M,
    P.MMS_L10M,
    P.MMS_L11M,
    P.MMS_L12M,
    P.KKB_SKOR,
    P.KKB_SKOR_LM,
    P.KKB_SKOR_L2M,
    P.KKB_SKOR_L3M,
    P.KKB_SKOR_L4M,
    P.KKB_SKOR_L5M,
    P.KKB_SKOR_L6M,
    P.KKB_SKOR_L7M,
    P.KKB_SKOR_L8M,
    P.KKB_SKOR_L9M,
    P.KKB_SKOR_L10M,
    P.KKB_SKOR_L11M,
    P.KKB_SKOR_L12M
FROM PORTFOY T1
LEFT JOIN PVT P
       ON T1.MBB_NO = P.MBB_NO
      AND LAST_DAY(TRUNC(T1.TARIH)) = P.TARIH
