# Dosyanın literal hali: (14D - 30D) / 30D
df["H08_TREND_RATIO"] = (df["TXN_GLN_14D_AMT"] - df["TXN_GLN_30D_AMT"]) / (df["TXN_GLN_30D_AMT"] + 1)

# Günlük ortalamaya normalize edilmiş momentum (1 = sabit hız, <1 = yavaşlama)
df["H08_MOMENTUM"] = (df["TXN_GLN_14D_AMT"] / 14) / (df["TXN_GLN_30D_AMT"] / 30 + 1)

# Son 14 günün 30 günlük toplam içindeki payı (0-1 arası)
df["H08_RECENT_SHARE"] = df["TXN_GLN_14D_AMT"] / (df["TXN_GLN_30D_AMT"] + 1)
