import numpy as np
import pandas as pd


def preprocess(df):
    """PREPROCESS (stateless - leakage yok, medyan gerekmez).

    Çıktı orijinaliyle birebir aynıdır (değerler, kolon sırası, dtype'lar).
    Değişen sadece hesaplama yöntemi:

      1) df.replace([inf,-inf], nan) TÜM kolonları tarıyordu. inf yalnızca
         float dtype'ta bulunabilir; int/bool/category kolonlarda bu iş
         tamamen boşa gidiyordu. Artık sadece float kolonlara bakılıyor.
      2) replace zaten yeni bir nesne döndürdüğü için ardındaki .copy()
         ikinci bir tam kopya çıkarıyordu. Tek kopya yeterli.
      3) "inf -> nan" ardından "fillna(x)" iki ayrı tam geçiş. İkisi tek
         maskeye indirildi: ~isfinite -> x.
      4) df[num] = df[num].fillna(0) alt-DataFrame kopyalayıp geri
         yazıyordu (blok yeniden hizalama). Artık kolonlar tek seferde
         toplanıp DataFrame bir kez kuruluyor.
    """
    cols = list(df.columns)
    is_float = {c: (df[c].dtype.kind == 'f') for c in cols}

    # --- kolon grupları: orijinaldeki sıra ve koşullarla birebir ---------
    cat = [c for c in CAT_COLS if c in df.columns]
    cat_set = set(cat)

    sentinel = [c for c in cols
                if any(k in c for k in ('RENK', 'DAV', 'MMS'))
                and c not in CAT_COLS]
    sent_set = set(sentinel)

    num = [c for c in df.select_dtypes(include=np.number).columns
           if c != TARGET and c not in sent_set]
    num_set = set(num)

    def _fill_nonfinite(s, fill):
        """s.replace([inf,-inf], nan).fillna(fill) ile aynı, tek geçişte."""
        a = s.to_numpy()
        bad = ~np.isfinite(a)
        if not bad.any():
            return s
        out = a.copy()
        out[bad] = fill
        return pd.Series(out, index=s.index, name=s.name, copy=False)

    def _inf_to_nan(s):
        """Sadece inf temizliği (fillna yok): TARGET ve grup dışı kolonlar."""
        a = s.to_numpy()
        bad = np.isinf(a)
        if not bad.any():
            return s
        out = a.copy()
        out[bad] = np.nan
        return pd.Series(out, index=s.index, name=s.name, copy=False)

    pieces = {}
    for c in cols:
        s = df[c]
        if c in cat_set:
            # inf -> nan -> fillna(0) -> category
            s = _fill_nonfinite(s, 0) if is_float[c] else s.fillna(0)
            pieces[c] = s.astype('category')
        elif c in sent_set:
            pieces[c] = _fill_nonfinite(s, -1) if is_float[c] else s
        elif c in num_set:
            pieces[c] = _fill_nonfinite(s, 0) if is_float[c] else s
        else:
            # TARGET ve sayısal olmayan kolonlar: sadece inf temizliği
            pieces[c] = _inf_to_nan(s) if is_float[c] else s

    return pd.DataFrame(pieces, columns=cols, copy=False)
