import dataiku, zipfile, io

f = dataiku.Folder("LLM_BIREYSEL_HTML")

# Klasördeki dosyaları f üzerinden listele, zip olanı bul
paths = f.list_paths_in_partition()
zip_candidates = [p for p in paths if p.lower().endswith(".zip")]

if not zip_candidates:
    raise Exception("Klasörde .zip dosyası bulunamadı: " + str(paths))

zip_path = zip_candidates[0]  # ilk bulunan zip
print("Bulunan zip:", zip_path)

with f.get_download_stream(zip_path) as s:
    data = s.read()

with zipfile.ZipFile(io.BytesIO(data)) as z:
    for entry in z.namelist():
        if entry.endswith("/"):
            continue
        with z.open(entry) as src:
            f.upload_stream("/" + entry, src)
        print("eklendi:", entry)

f.delete_path(zip_path)
print("zip silindi")
