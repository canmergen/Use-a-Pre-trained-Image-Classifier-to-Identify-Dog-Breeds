        _leakli  = [c for c in _istenen if c in df_eng.columns and c in _leak]
        feats    = [c for c in _istenen
                    if c in df_eng.columns and c not in _leak]
        if _yok:
            print(f"   ⚠ {ad}: {len(_yok)} feature df_eng'te yok, düşürüldü "
                  f"→ bu model olduğundan zayıf görünebilir. Örnek: {_yok[:3]}")
        if _leakli:
            print(f"   ⚠ {ad}: {len(_leakli)} feature LEAK_COLS'ta olduğu için "
