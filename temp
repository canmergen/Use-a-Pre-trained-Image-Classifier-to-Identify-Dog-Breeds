import dataiku
import pandas as pd
from collections import defaultdict

# --- Ayarlar ---
DICT_DATASET = "DEGISKENLER"
NAME_COL, DESC_COL = "SM_ID", "aciklama"
OUT_DATASET = "DEGISKENLER_COMPACT"

# Eski notebook'un legend'ı + yeni şemanın ekleri
ABBREVIATION_LEGEND = {
    "GDN": "giden para hareketi", "GLN": "gelen para hareketi",
    "TXN": "işlem", "GCK": "gecikme", "ADT": "adet",
    "BKY": "bakiye", "LMT": "limit", "KRD": "kredi",
    "3D": "son 3 gün", "3D_6D": "3-6 gün arası (önceki dönem)",
    "CNT": "işlem adedi", "AMT": "işlem tutarı",
    "AMT_AVG": "ortalama tutar", "AMT_MAX": "maksimum tutar",
    "HS": "hafta sonu", "PER_DAY": "günlük ortalama",
    "BNK_ADT": "farklı banka adedi",
}

# Uzun eşleşme önce (AMT_PER_DAY, AMT'den önce denenmeli)
METRIC_SUFFIXES = [
    "AMT_PER_DAY", "CNT_PER_DAY", "AMT_AVG", "AMT_MAX",
    "HS_CNT", "HS_AMT", "BNK_ADT", "CNT", "AMT",
]

def family_of(col: str):
    """Kolonu (aile, metrik) olarak ayırır; metrik eşleşmezse None döner."""
    for suf in METRIC_SUFFIXES:
        if col.endswith("_" + suf):
            return col[: -(len(suf) + 1)], suf
    return None, None

# --- Sözlüğü oku ve grupla ---
df = dataiku.Dataset(DICT_DATASET).get_dataframe()
df.columns = [c.strip() for c in df.columns]

families = defaultdict(list)   # aile -> [(metrik, aciklama)]
specials = []                  # desene uymayanlar (PERIOD, TGT_... + KAÇIRDIKLARIMIZ)

for _, row in df.iterrows():
    sm_id = str(row[NAME_COL]).strip()
    desc = str(row[DESC_COL]).strip()
    fam, metric = family_of(sm_id)
    if fam:
        families[fam].append((metric, desc))
    else:
        specials.append((sm_id, desc))

# --- TEŞHİS: eşleşmeyenleri ve aile dağılımını göster ---
print(f"TOPLAM: {len(df)} satır -> {len(families)} aile + {len(specials)} eşleşmeyen")
print()
print(f"=== EŞLEŞMEYENLER ({len(specials)} adet) — hepsi listeleniyor ===")
for sm_id, desc in specials:
    print(f"  {sm_id}: {desc}")
print()
print("=== EN KALABALIK 15 AİLE ===")
for fam, items in sorted(families.items(), key=lambda kv: -len(kv[1]))[:15]:
    print(f"  {fam}: {len(items)} metrik -> {sorted({m for m, _ in items})}")
print()
# Tek metrikli aileler şüphelidir: suffix listesi eksik olabilir,
# kolonun ortası yanlış yerden bölünmüş olabilir
tek = [f for f, it in families.items() if len(it) == 1]
print(f"=== TEK METRİKLİ AİLELER ({len(tek)} adet, ilk 30) ===")
for f in sorted(tek)[:30]:
    print(f"  {f} -> {families[f][0][0]}")

# --- Compact metni derle ---
lines = ["# Veri Sözlüğü (Compact) — DEGISKENLER", ""]

lines.append("## ÖZEL KOLONLAR (birebir)")
for sm_id, desc in specials:
    lines.append(f"- `{sm_id}`: {desc}")

lines += ["", "## KISALTMA LEJANTI"]
for k, v in ABBREVIATION_LEGEND.items():
    lines.append(f"- `{k}`: {v}")

lines += ["", "## KOLON AİLELERİ (aile + mevcut metrikler + örnek açıklama)"]
for fam in sorted(families):
    metrics = sorted({m for m, _ in families[fam]})
    ornek = families[fam][0][1]
    lines.append(f"- `{fam}_[{'|'.join(metrics)}]` — örn: {ornek}")

compact_text = "\n".join(lines)
print()
print(f"Compact boyut: {len(compact_text)} karakter (~{len(compact_text)//3} token)")

out = pd.DataFrame({"part": ["compact_dictionary"], "text": [compact_text]})
dataiku.Dataset(OUT_DATASET).write_with_schema(out)
