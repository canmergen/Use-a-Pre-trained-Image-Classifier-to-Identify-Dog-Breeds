t0 = time.time()
from dataiku.core.sql import SQLExecutor2

d    = dataiku.Dataset("MUS_YENI_RENKLER_TUM_PORTFOY")
info = d.get_location_info(sensitive_info=True)["info"]
tbl  = info["quotedResolvedTableName"]
print("Kaynak:", info["connectionName"], "->", tbl)

# dtype planı (cast için)
sch = d.read_schema()
names, dtypes, date_idx = d.get_dataframe_schema_st(sch, int_as_float=True)
date_cols = {names[i] for i in date_idx} if date_idx else set()

vm0 = psutil.virtual_memory().used

df = SQLExecutor2(dataset=d).query_to_df(f"SELECT * FROM {tbl}")

cast = {c: t for c, t in dtypes.items() if c in df.columns and c not in date_cols}
df   = df.astype(cast)[[c for c in names if c in df.columns]]

_elapsed = time.time() - t0
_vm      = psutil.virtual_memory()
_ram_add = (_vm.used - vm0) / 1e9

print(f"Yükleme süresi : {int(_elapsed//60)}dk {int(_elapsed%60)}sn")
print(f"Bu adım RAM    : +{_ram_add:.1f} GB")
print(f"Sunucu RAM     : {_vm.used/1e9:.0f} / {_vm.total/1e9:.0f} GB (%{_vm.percent:.0f} dolu)")
print(f"Kalan RAM      : {_vm.available/1e9:.0f} GB")
print(f"\nDataFrame: {df.shape[0]:,} satır × {df.shape[1]:,} sütun")
print(f"Dönemler : {sorted(df['DONEM'].dropna().astype(int).unique().tolist())}")
print(f"Bellek   : {df.memory_usage(deep=True).sum()/1e9:.1f} GB")

df_raw = df.copy()
display(df.head())
