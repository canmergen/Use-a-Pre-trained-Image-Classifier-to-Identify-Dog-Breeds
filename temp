import dataiku, zipfile, io

f = dataiku.Folder("LLM_BIREYSEL_HTML")
zip_path = "/LLM_BIREYSEL_HTML.zip"     # listeden gördüğün tam yolu buraya yaz

with f.get_download_stream(zip_path) as s:
    data = s.read()

with zipfile.ZipFile(io.BytesIO(data)) as z:
    for entry in z.namelist():
        if entry.endswith("/"):
            continue
        with z.open(entry) as src:
            f.upload_stream("/" + entry, src)
        print("eklendi:", entry)

f.delete_path(zip_path)
print("zip silindi")
