# --- compact JSON'u proje değişkenine yaz (agent buradan okur) ---
import dataiku, json

folder = dataiku.Folder("COMPACT_JSON")
with folder.get_download_stream("degiskenler_compact.json") as s:
    compact_dict = json.loads(s.read().decode("utf-8"))
compact_tek_satir = json.dumps(compact_dict, ensure_ascii=False, separators=(",", ":"))

proj = dataiku.api_client().get_default_project()
v = proj.get_variables()
v["standard"]["compact_json"] = compact_tek_satir
proj.set_variables(v)
print(f"proje değişkeni compact_json güncellendi ✓ ({len(compact_tek_satir)} karakter)")
