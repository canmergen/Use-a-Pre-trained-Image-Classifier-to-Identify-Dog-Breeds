def klasor_var(alt_yol, folder=None):
    """MODEL_RESULTS içinde alt_yol klasörü var mı (= içinde en az bir dosya var mı)."""
    folder = folder or mf
    p = "/" + str(alt_yol).strip("/")
    return any(x.startswith(p + "/") for x in folder.list_paths_in_partition())


def dosya_var(alt_yol, fname, folder=None):
    """alt_yol klasöründe fname dosyası var mı."""
    folder = folder or mf
    hedef = "/" + str(alt_yol).strip("/") + "/" + str(fname).lstrip("/")
    return hedef in folder.list_paths_in_partition()


