df = dataiku.Dataset(DICT_DATASET).get_dataframe()
df.columns = [c.strip() for c in df.columns]
ids = [str(x).strip() for x in df[NAME_COL]]
n = len(ids)

# --- Baseline'ı DEGISKENLER'e uygula ---
old_fams = defaultdict(list)
old_temporal_hits = 0
for c in ids:
    if any(c.endswith(s) for s in ("_L1M", "_L3M", "_L6M", "_L12M", "_L24M")):
        old_temporal_hits += 1
    old_fams[old_family_of(c)].append(c)

# --- Yeni yaklaşımı uygula ---
new_fams = defaultdict(list)
new_specials = []
for c in ids:
    fam, metric = family_of(c)
    if fam:
        new_fams[fam].append(c)
    else:
        new_specials.append(c)

print(f"Toplam kolon: {n}")
print()
print("=== BASELINE (eski notebook) DEGISKENLER üzerinde ===")
print(f"Temporal suffix (L1M/L3M/...) eşleşen: {old_temporal_hits}")
print(f"Kaba fallback'e düşen                : {n - old_temporal_hits}")
print(f"Aile sayısı                          : {len(old_fams)}")
print("Aile dağılımı (tümü):")
for fam, cols in sorted(old_fams.items(), key=lambda kv: -len(kv[1])):
    print(f"  {fam}: {len(cols)} kolon")
print()
print("=== BİZİM YAKLAŞIM ===")
print(f"Metrik eşleşen kolon   : {n - len(new_specials)}")
print(f"Özel kolon (eşleşmeyen): {len(new_specials)}")
print(f"Aile sayısı            : {len(new_fams)}")
print("En kalabalık 10 aile:")
for fam, cols in sorted(new_fams.items(), key=lambda kv: -len(kv[1]))[:10]:
    print(f"  {fam}: {len(cols)} kolon")
print()
print("=== GELİŞİM ÖZETİ ===")
print(f"Şema tanıma      : baseline {old_temporal_hits}/{n} -> "
      f"bizde {n - len(new_specials)}/{n}")
print(f"Aile granülerliği: baseline {len(old_fams)} kaba aile "
      f"(ort {n/len(old_fams):.0f} kolon/aile) -> "
      f"bizde {len(new_fams)} aile "
      f"(ort {(n - len(new_specials))/max(len(new_fams),1):.1f} kolon/aile)")
