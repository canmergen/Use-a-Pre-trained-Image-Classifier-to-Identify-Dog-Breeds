# Metrik son ekleri — uzunluğa göre otomatik sıralanır (uzun önce),
# CNT_SHR/CNT, AMT_RATIO/AMT gibi çakışmalar böylece imkansız.
NEW_SUFFIXES = sorted({
    "AMT_PER_DAY", "CNT_PER_DAY", "AMT_AVG", "AMT_MAX",
    "HS_CNT", "HS_AMT", "BNK_ADT", "CNT", "AMT",
    "HS_CNT_SHR", "HS_AMT_SHR", "CNT_SHR", "AMT_SHR",
    "CNT_RATIO", "AMT_RATIO",
    "AMT_STD", "CV",
    "TMSNCFRST", "TMSNCLST",
}, key=len, reverse=True)

def family_of(col: str, suffixes=NEW_SUFFIXES):
    """Kolonu (aile, metrik) olarak ayırır; metrik eşleşmezse (None, None) —
    eşleşmeyen bilinçli olarak 'özel kolon' sayılır, kaba aileye zorlanmaz."""
    for suf in suffixes:
        if col.endswith("_" + suf):
            return col[: -(len(suf) + 1)], suf
    return None, None

