import dataiku
import pandas as pd

DATA_DATASET = "HAVALE_EFT_NTT_PREPARED"   # ekrandaki ad böyle (PREPARED büyük)
DICT_DATASET = "DEGISKENLER"
TARGET_COL   = "TGT_CS_ALL_TKP_ST_5M90"

m = dataiku.Dataset(DATA_DATASET).get_dataframe(infer_with_pandas=True)
d = dataiku.Dataset(DICT_DATASET).get_dataframe()
d.columns = [c.strip() for c in d.columns]

print(f"Satır: {len(m):,} | Kolon: {m.shape[1]}")
print(f"SM_ID unique: {m['SM_ID'].nunique():,}  (satır sayısına eşit mi?)")
print(f"\nPERIOD dağılımı:\n{m['PERIOD'].astype(str).value_counts().sort_index()}")
print(f"\nTarget oranı (genel): {m[TARGET_COL].mean():.2%}")
print("Target oranı dönem bazında:")
print(m.groupby(m['PERIOD'].astype(str))[TARGET_COL].agg(['mean', 'size']))

# --- ŞEMA HİZALAMA: sözlük vs gerçek tablo ---
dict_cols = {str(x).strip() for x in d["SM_ID"]}
data_cols = set(m.columns)
print(f"\nSözlükte olup TABLODA OLMAYAN ({len(dict_cols - data_cols)}): "
      f"{sorted(dict_cols - data_cols)[:15]}")
print(f"Tabloda olup SÖZLÜKTE OLMAYAN ({len(data_cols - dict_cols)}): "
      f"{sorted(data_cols - dict_cols)[:15]}")

# --- Eksik değer hızlı bakış ---
na = m.isna().mean().sort_values(ascending=False)
print(f"\nEn çok eksik 10 kolon:\n{(na.head(10) * 100).round(1)}")
