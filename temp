# =========================================================
# HİPOTEZ FEATURE'LARI (H01-H06) - train / val / oot için
# Hepsi RAW kolonlardan türetiliyor, feature engineering
# fonksiyonu olarak yazıp train/val/oot'a AYRI AYRI uyguluyoruz
# ki her set kendi satırlarından hesaplansın (leakage yok,
# çünkü hepsi satır-bazlı/aynı satır içi oranlar - zaman
# ötesi bir istatistik değil).
# =========================================================

def hipotez_featurelari_ekle(df):
    """H01-H06 hipotezlerindeki önerilen feature'ları df'e ekler.
    df'i kopyalayıp üzerine ekleme yapar, orijinali bozmaz."""
    df = df.copy()

    # --- H01: Gelen para saat-bazlı konsantrasyon endeksi (HHI) ---
    # 4 saat diliminin payının karesi toplamı (0.25-1 arası).
    # Düşük HHI -> saatlere yayılmış (düşük risk), yüksek HHI ->
    # tek saat dilimine yığılmış (yüksek batma riski).
    df["GLN_TIME_HHI_90D"] = (
        df["TXN_GLN_H00_06_90D_AMT_SHR"] ** 2 +
        df["TXN_GLN_H06_12_90D_AMT_SHR"] ** 2 +
        df["TXN_GLN_H12_18_90D_AMT_SHR"] ** 2 +
        df["TXN_GLN_H18_24_90D_AMT_SHR"] ** 2
    )
    # Not (H01'de belirtildiği gibi): TXN_GLN_90D_CNT == 0 olan
    # müşterilerde payların hepsi 0 olduğundan HHI de 0 çıkar.
    # Bu durumu ayırt etmek isterseniz aşağıdaki flag'i kullanabilirsiniz:
    df["GLN_TIME_HHI_90D_AKTIF_FLAG"] = (df["TXN_GLN_90D_CNT"] > 0).astype(int)

    # --- H02: Giden/gelen tutar trend yönü ve etkileşimi ---
    # log1p farkı: yakın dönem (90D) toplamla uzun dönem (180D) toplamı
    # karşılaştırıp artış/azalış yönünü ölçüyor.
    df["GDN_TREND_90D"] = (
        np.log1p(df["TXN_GDN_90D_AMT"]) - np.log1p(df["TXN_GDN_180D_AMT"])
    )
    df["GLN_TREND_90D"] = (
        np.log1p(df["TXN_GLN_90D_AMT"]) - np.log1p(df["TXN_GLN_180D_AMT"])
    )
    # Etkileşim terimi: her iki tutar da (180D bazında) sıfırdan büyükse
    # iki trendin çarpımı; değilse NaN (sıfır-bölme/anlamsızlık durumu).
    df["TREND_INTERACTION"] = np.where(
        (df["TXN_GDN_180D_AMT"] > 0) & (df["TXN_GLN_180D_AMT"] > 0),
        df["GDN_TREND_90D"] * df["GLN_TREND_90D"],
        np.nan
    )

    # --- H03: Gelen paranın ödeme şirketlerinden gelme oranı (binary eşik) ---
    # Hem aktif ay sayısı hem pay oranı pozitifse VE pay >= 0.83 ise flag=1.
    # Aksi halde (sıfır alt kümesi dahil) flag=0.
    df["GLN_ODEME_DOMINANT_FLAG"] = np.where(
        (df["TXN_GLN_ODEME_ACTIVE_MONTH_CNT"] > 0) & (df["TXN_GLN_ODEME_90D_AMT_SHR"] > 0),
        (df["TXN_GLN_ODEME_90D_AMT_SHR"] >= 0.83).astype(int),
        0
    )

    # --- H04: Giden işlemde banka çeşitliliğinin yakın dönemde daralması ---
    # 180 günlük banka sayısı ile 90 günlük banka sayısı farkı (0-18 arası tamsayı).
    # Yüksek değer -> banka çeşitliliği daralmış (bad rate artışıyla ilişkili).
    df["BNK_CONTRACTION"] = df["TXN_GDN_180D_BNK_ADT"] - df["TXN_GDN_90D_BNK_ADT"]

    # --- H05: Son 7 günün 90 günlük toplam içindeki payı + U-şekilli uç flag ---
    # 1e-8 eklenerek sıfıra bölme engelleniyor.
    df["GDN_7D_SHR_90D"] = df["TXN_GDN_7D_AMT"] / (df["TXN_GDN_90D_AMT"] + 1e-8)
    # Üst uç (yüksek yoğunlaşma) flag'i: sadece 90D'de işlem hacmi olan
    # müşterilerde pay >= 0.20 ise 1, aksi halde 0.
    df["GDN_7D_CONCENTRATION_HIGH"] = np.where(
        df["TXN_GDN_90D_CNT"] > 0,
        (df["GDN_7D_SHR_90D"] >= 0.20).astype(int),
        0
    )

    # --- H06: Geçmişte bahis aktifliğinin son 7 güne taşınması ---
    # Binary flag: 180 günde bahis aktif VE son 7 günde de bahis aktif.
    df["BAHIS_DEVAM_FLAG"] = (
        (df["TXN_GDN_BAHIS_180D_CNT"] > 0) & (df["TXN_GDN_BAHIS_7D_CNT"] > 0)
    ).astype(int)
    # Alternatif oran-bazlı gösterim: 180D bahis aktifse 7D'de devam
    # ediyor mu (1.0/0.0), 180D'de hiç aktif değilse 0.0.
    df["BAHIS_DEVAM_RATIO"] = np.where(
        df["TXN_GDN_BAHIS_180D_CNT"] > 0,
        (df["TXN_GDN_BAHIS_7D_CNT"] > 0).astype(float),
        0.0
    )

    return df


# --- Fonksiyonu train / val / oot setlerine ayrı ayrı uygula ---
print("▶ Hipotez feature'ları ekleniyor (train / val / oot)...")

df_train_raw = hipotez_featurelari_ekle(df_train_raw)
df_val_raw   = hipotez_featurelari_ekle(df_val_raw)
df_oot_raw   = hipotez_featurelari_ekle(df_oot_raw)

_yeni_kolonlar = [
    "GLN_TIME_HHI_90D", "GLN_TIME_HHI_90D_AKTIF_FLAG",
    "GDN_TREND_90D", "GLN_TREND_90D", "TREND_INTERACTION",
    "GLN_ODEME_DOMINANT_FLAG",
    "BNK_CONTRACTION",
    "GDN_7D_SHR_90D", "GDN_7D_CONCENTRATION_HIGH",
    "BAHIS_DEVAM_FLAG", "BAHIS_DEVAM_RATIO",
]
print(f"  ✓ Eklenen feature sayısı: {len(_yeni_kolonlar)}")
print(f"  ✓ train shape: {df_train_raw.shape} | val shape: {df_val_raw.shape} | oot shape: {df_oot_raw.shape}")

# Hızlı kontrol: NaN oranları (özellikle TREND_INTERACTION ve
# GDN_7D_SHR_90D gibi sıfır-bölme/koşullu NaN üretebilen kolonlar için)
print("\n  NaN oranları (train):")
print(df_train_raw[_yeni_kolonlar].isna().mean().round(4))
