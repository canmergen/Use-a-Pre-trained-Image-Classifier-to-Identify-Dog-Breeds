def _yol_detay(yol):
    """get_path_details güvenli sarmalayıcı: yoksa None döner."""
    try:
        d = mf.get_path_details("/" + str(yol).lstrip("/"))
    except Exception:
        return None
    if not isinstance(d, dict):
        return None
    # Dataiku yol yoksa da sözlük döndürebiliyor -> exists alanına bak.
    if d.get("exists") is False:
        return None
    return d


def _dosya_var(yol):
    """mf içinde DOSYA var mı (klasör değil)."""
    d = _yol_detay(yol)
    return bool(d) and not bool(d.get("directory", False))


def _klasor_var_p(yol):
    """mf içinde KLASÖR var mı."""
    d = _yol_detay(yol)
    return bool(d) and bool(d.get("directory", True))


def _renk_dosyalari_tam(fld_path, RENK_KOD, renk_adi):
    """Bir rengin model dosyaları klasörde tam mı (val_index opsiyonel)."""
    gerekli = [f"renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv",
               f"renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv"]
    return all(_dosya_var(str(fld_path).rstrip("/") + "/" + g) for g in gerekli)


def _klasor_kullanilabilir(fld_path):
    """Klasör var VE en az bir renk için model dosyaları okunabilir mi.
    Sadece klasör varlığına bakmak yetmiyor: Dataiku boş/olmayan yol için de
    detay döndürebiliyor, o yüzden asıl kanıt dosyanın kendisidir."""
    if not _klasor_var_p(fld_path):
        return False
    for _rk in MODEL_RENKLER:
        _ra = COLOR_MAP.get(_rk, str(_rk))
        if _renk_dosyalari_tam(fld_path, _rk, _ra):
            return True
    return False


