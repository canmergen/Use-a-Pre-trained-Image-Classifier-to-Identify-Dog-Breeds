    if _psi_sirali[0][1] > 0.10:
        print("  --- PSI en yüksek 10 ---")
        for c, v in _psi_sirali[:10]:
            print(f"    {v:7.4f}  {c}")

    # --- PSI ELEMESİ: hem kaymış HEM zayıf olanlar --------------------
    # Tek başına PSI yetmez: kayma ya veri kalitesi sorunudur ya da gerçek
    # davranış değişimidir (modellemek istediğimiz şey). Ama hedefi de
    # açıklamıyorsa ikinci ihtimal kalmıyor — sarıda elenen ikisinin
    # tgt_assoc'ı 0.019/0.021, listenin dibi; tutulanlar 0.049 ve üstü.
    _once = len(FEATURES)
    _ele  = [c for c in FEATURES
             if psi_scores[c] > 0.25 and tgt_assoc.get(c, 0.0) < 0.05]
    FEATURES = [c for c in FEATURES if c not in _ele]
    if _ele:
        print(f"  ✓ PSI elemesi: {len(_ele)} feature elendi "
              f"(PSI>0.25 ve tgt_assoc<0.05)  →  {_once}→{len(FEATURES)}")
        for c in _ele:
            print(f"    psi={psi_scores[c]:.4f} tgt={tgt_assoc[c]:.4f}  {c}")
    else:
        print("  ✓ PSI elemesi: eleyecek feature yok")

    print("  ▶ Kalan feature'lar dosyaya yazılıyor...")
