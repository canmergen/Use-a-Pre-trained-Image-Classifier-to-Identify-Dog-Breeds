# --- Geleceğe bakan kolonları desenle otomatik yakala ---
# RENK_<herhangi>_SONRASI  : RENK_3M_SONRASI, RENK_6M_SONRASI, RENK_18M_SONRASI, RENK_1Y_SONRASI ...
# RENK_SONRAKI_<herhangi>  : RENK_SONRAKI_AY, RENK_SONRAKI_2AY, RENK_SONRAKI_9AY ...
SIZINTI_DESENLERI = [
    re.compile(r'^RENK_.+_SONRASI$'),
    re.compile(r'^RENK_SONRAKI_.+$'),
]

if 'df' in globals():
    def _dogal_siralama_anahtari(s):
        return [int(x) if x.isdigit() else x.lower() for x in re.split(r'(\d+)', s)]

    def _liste_metni(kolonlar):
        if not kolonlar:
            return "[]"
        _sirali = sorted(kolonlar, key=_dogal_siralama_anahtari)
        return "[" + ", ".join(_sirali) + "]"

    _otomatik = {c for c in df.columns
                 if any(d.match(c) for d in SIZINTI_DESENLERI)}
    _once = set(LEAK_COLS)
    _zaten_olan   = _otomatik & _once
    _yeni_eklenen = _otomatik - _once
    LEAK_COLS.update(_otomatik)

    def _liste_yaz(baslik, kolonlar):
        print(f"\n{baslik} ({len(kolonlar)}): {_liste_metni(kolonlar)}")

    _liste_yaz("Otomatik bulunan sizinti kolonu", _otomatik)
    _liste_yaz("Zaten LEAK_COLS icinde olan", _zaten_olan)
    _liste_yaz("Yeni eklenen", _yeni_eklenen)
else:
    print("⚠ df bellekte yok -> otomatik sizinti taramasi atlandi")

print("\nLEAK_COLS toplam:", len(LEAK_COLS))
