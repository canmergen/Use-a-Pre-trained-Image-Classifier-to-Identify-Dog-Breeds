def _quick_iv(x, y, bins=10):
    d = pd.DataFrame({'x': x, 'y': y}).dropna(subset=["y"])
    if d["y"].nunique() < 2:
        return 0.0

    xs = d["x"]
    if isinstance(xs.dtype, pd.CategoricalDtype) or xs.dtype == object:
        # kategorik/metin: her seviye kendi bin'i, NaN ayrı bin
        d['b'] = xs.astype(object).where(xs.notna(), "__NaN__").astype(str)
    else:
        d["x"] = xs.fillna(-999999)
        if d['x'].nunique() > 20:
            d['b'] = pd.qcut(d['x'].rank(method='first'), bins, labels=False, duplicates='drop')
        else:
            d['b'] = d['x'].astype(str)

    tot_b, tot_g = max(d['y'].sum(), 1), max((d['y'] == 0).sum(), 1)
    g = d.groupby('b', observed=True)['y'].agg(['size', 'sum'])
    g['good'] = g['size'] - g['sum']
    db = (g['sum'] + 0.5) / tot_b
    dg = (g['good'] + 0.5) / tot_g
    return float(((dg - db) * np.log(dg / db)).sum())
