SELECT
    COALESCE(a.donem, b.donem) AS donem,
    a.cnt  AS cnt_portfoy,
    b.cnt  AS cnt_portfoy_1,
    COALESCE(a.cnt,0) - COALESCE(b.cnt,0) AS fark,
    CASE WHEN a.donem IS NULL THEN 'SADECE_1_DE_VAR'
         WHEN b.donem IS NULL THEN 'SADECE_ANA_TABLODA'
         WHEN a.cnt = b.cnt   THEN 'AYNI'
         ELSE 'ADET_FARKLI' END AS durum
FROM (SELECT donem, COUNT(*) cnt
        FROM mus_yeni_renkler_tum_portfoy GROUP BY donem) a
FULL OUTER JOIN
     (SELECT donem, COUNT(*) cnt
        FROM mus_yeni_renkler_tum_portfoy_1 GROUP BY donem) b
  ON a.donem = b.donem
ORDER BY 1;




WITH ortak AS (
    SELECT donem FROM mus_yeni_renkler_tum_portfoy
    INTERSECT
    SELECT donem FROM mus_yeni_renkler_tum_portfoy_1
),
a AS (SELECT * FROM mus_yeni_renkler_tum_portfoy
      WHERE donem IN (SELECT donem FROM ortak)),
b AS (SELECT * FROM mus_yeni_renkler_tum_portfoy_1
      WHERE donem IN (SELECT donem FROM ortak))
SELECT 'sadece_portfoy'   AS kaynak, x.* FROM (SELECT * FROM a EXCEPT SELECT * FROM b) x
UNION ALL
SELECT 'sadece_portfoy_1' AS kaynak, y.* FROM (SELECT * FROM b EXCEPT SELECT * FROM a) y;
