# --- SON GÖZLENEN RENK -> TAKIP_6M (müşteri bazında, dönem kırılımlı) ---
SADECE_KK = True

_d = df[df['KK_URUN_FLG'] == 'KK'] if SADECE_KK else df

_takip = pd.Series(
    np.where((_d['AKB_GGS_6_90'] == 1) | (_d['AKB_TAKIP_6M'] == 1), 1, 0),
    index=_d.index, name='TAKIP_6M')

# RENK sayısala çevrildiyse metne geri döndür (SONRAKI kolonları hâlâ metin)
_renk0 = _d['RENK'].map(renk_map_ters) if _d['RENK'].dtype != object else _d['RENK']

# En yeniden en eskiye: 5AY, 4AY, 3AY, 2AY, AY, RENK
snk_sirali = [f'RENK_SONRAKI_{k}AY' for k in range(5, 1, -1)] + ['RENK_SONRAKI_AY']
snk_sirali = [c for c in snk_sirali if c in _d.columns]

_yol = pd.concat([_d[snk_sirali], _renk0.rename('RENK')], axis=1)
son_renk = _yol.bfill(axis=1).iloc[:, 0].fillna('(bos)')   # ilk dolu = en son gözlenen renk

for _don in sorted(_d['DONEM'].dropna().astype(int).unique()):
    _m = (_d['DONEM'] == _don).to_numpy()
    print("=" * 90)
    print(f"DONEM {_don} — son gözlenen renk -> TAKIP_6M"
          + (", sadece KK" if SADECE_KK else ", tüm portföy"))
    ct = pd.crosstab(son_renk[_m], _takip[_m], margins=True, margins_name='TOPLAM')
    print(ct.to_string())
    pct = (pd.crosstab(son_renk[_m], _takip[_m], normalize='index') * 100).round(2)
    print("\n--- SATIR % ---")
    print(pct.to_string())
