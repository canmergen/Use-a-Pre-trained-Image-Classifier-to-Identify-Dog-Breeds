def _ay_ekle(yyyymm, k):
    y, m = divmod(int(yyyymm), 100)
    m += k; y += (m - 1) // 12; m = (m - 1) % 12 + 1
    return y * 100 + m


KONTROL_EKSIK, _ILK_KIRMIZI = [], None
_KONTROL_DS = None            # (eski agregat yol kaldırıldı; uyumluluk için)

if KONTROL_KAYNAK == 'df_raw' and 'df_raw' in globals():
    try:
        _snk_cols = ['RENK_SONRAKI_AY'] + [f'RENK_SONRAKI_{k}AY'
                                           for k in range(2, 7)]
        _eksik_kolon = [c for c in _snk_cols if c not in df_raw.columns]
        if _eksik_kolon:
            raise RuntimeError(f"df_raw'da eksik kolon: {_eksik_kolon}")
        # KRİTİK — TARİH/DONEM KİLİDİ: aynı müşterinin her DONEM için ayrı
        # satırı var ve her satırın RENK_SONRAKI_* kolonları O SATIRIN
