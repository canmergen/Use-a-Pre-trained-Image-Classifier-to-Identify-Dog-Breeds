        oneri = json_parse(cevap)
    if oneri is None:
        red_kaydi(tur, tema, "JSON parse edilemedi")
        print("  RED: JSON parse edilemedi"); continue

    # 1b) Eksik alan sigortası: LLM alan atlarsa KeyError yerine varsayılan
    for alan, varsayilan in [("ad_soneki", "FEATURE"), ("gerekce", ""), ("mekanizma", ""),
                             ("beklenen_yon", ""), ("kullanilan_kolonlar", []), ("formul", "")]:
        oneri.setdefault(alan, varsayilan)

    # 2) Doğrulama
    ok, sonuc = oneri_dogrula(oneri, train_df)
    if not ok:
        red_kaydi(tur, tema, sonuc, oneri)
        print(f"  RED: {sonuc}"); continue
    seri = sonuc

    # 3) İstatistik
    ist = istatistik_hesapla(seri, train_df)
    if ist is None:
        red_kaydi(tur, tema, "decile kurulamadı (tek değerli)", oneri)
        print("  RED: decile kurulamadı"); continue
    kor = max_korelasyon(seri, train_df, llm_features)

    # 4) Karar
    esik_ok = (ist["lift"] >= LIFT_ESIK) or (abs(ist["pp_gap"]) >= PPGAP_ESIK)
    kor_ok  = kor < KORELASYON_ESIK
    print(f"  lift={ist['lift']} pp_gap={ist['pp_gap']} kor={kor} "
          f"sıfır%={ist['sifir_orani']} eğri={ist['egri_sekli']}")

    if not esik_ok:
        red_kaydi(tur, tema, f"zayıf sinyal (lift<{LIFT_ESIK} ve |pp_gap|<{PPGAP_ESIK})", oneri, ist)
