### Toplam envanter kontrolü

Registry'deki TÜM feature'lar (bu koşu + önceki koşular) iki adımda gözden geçirilir.

Önce envanter listelenir: ad, anlam (gerekçe) ve formül. Sonra her feature'ın
metrikleri train üzerinde YENİDEN hesaplanır ve kayıt anındaki değerlerle yan
yana yazılır. İki değer arasında fark, formülün deterministik olmadığına veya
verinin değiştiğine işaret eder — normalde birebir aynı olmalıdır.





print(f"REGISTRY ENVANTERİ — toplam {len(registry)} feature\n" + "=" * 70)
for k in registry:
    etiketler = []
    if k.get("zayif_sinyal"):
        etiketler.append("ZAYIF SİNYAL")
    if k.get("yon_notu"):
        etiketler.append(k["yon_notu"])
    ek = ("  [" + " | ".join(etiketler) + "]") if etiketler else ""
    print(f"\n{k['iterasyon']:>2}. {k['ad']}{ek}")
    print(f"    Anlam : {k['gerekce']}")
    print(f"    Formül: {k['formul']}")
    print(f"    Tema  : {k['tema']}  |  Eklenme: {k['tarih']}")




print(f"{'feature':<42}{'lift':>7}{'(kayıt)':>9}{'pp_gap':>8}{'(kayıt)':>9}{'sıfır%':>8}{'eğri':>28}")
print("-" * 111)
sorunlu = []
for k in registry:
    ad = k["ad"]
    eski = k["istatistikler"]
    if ad not in train_df.columns:
        print(f"{ad:<42}  KOLON YOK — formül uygulanamamış!")
        sorunlu.append(ad); continue
    ist = istatistik_hesapla(train_df[ad], train_df)
    if ist is None:
        print(f"{ad:<42}  DECILE KURULAMADI")
        sorunlu.append(ad); continue
    fark = (abs(ist["lift"] - eski["lift"]) > 0.01) or (abs(ist["pp_gap"] - eski["pp_gap"]) > 0.5)
    isaret = "  <-- FARK!" if fark else ""
    if fark:
        sorunlu.append(ad)
    print(f"{ad:<42}{ist['lift']:>7.3f}{eski['lift']:>9.3f}"
          f"{ist['pp_gap']:>8.2f}{eski['pp_gap']:>9.2f}"
          f"{ist['sifir_orani']*100:>7.1f}%{ist['egri_sekli']:>28}{isaret}")

print("-" * 111)
if sorunlu:
    print(f"DİKKAT — incelenmesi gereken: {sorunlu}")
else:
    print("Tüm feature'lar tutarlı: yeniden hesaplanan metrikler kayıtla birebir eşleşiyor.")
