# ============================================================
# DF_ANALIZ — MODEL GEREKLİLİK ANALİZİ (GERÇEKLEŞME + SKOR + BUCKET RAPORU)
# ------------------------------------------------------------
# Koşul: MODEL_GEREKLILIK_ANALIZI == True  VE  4 model klasörü
# de mf içinde mevcut. Koşul sağlanmazsa hiçbir şey yapılmaz.
# Adımlar:
#   A) IBA_MMS_DS_GINI_DATA'dan ACT_* gerçekleşme hedefleri + kıyas
#      skorları (DAVRANIS_SKORU, MUSTERI_SKORU) alınır, df_raw ile
#      MBB_NO+DONEM bazında left join → df_analiz
#   B) Her klasörden 6 rengin renk_{kod}_{ad}_musteri_skorlari.csv
#      dosyaları okunur; SKOR_<klasör> ve PRED_<klasör> join edilir.
#   C) İki kıyas skoru için 20'li bucket sheet'leri + capture/GINI kıyası
#   D) KAÇAN DİLİM: mevcut skorun temiz dediği (B5-20) ama modelin
#      işaretlediği kitlenin GERÇEK batma oranı — kör nokta kanıtı
#   E) HÜKÜM: hedef × segment bazında T1 fark / T2 kaçan / T3 ek vaka
#      testleriyle "model gerekli mi" karar tablosu
#   F) TREND: mevcut skorların GINI'si TÜM ortak dönemlerde — tek
#      döneme bağlı olmayan stabilite kanıtı (model skoru sadece
#      TRAIN'de olduğu için trend yalnız mevcut skorları kapsar)
#   ⚠ MODEL KIYASI SADECE TRAIN (202504) ÜZERİNDEDİR — OOT gerçekleşmesi
#      IBA_MMS_DS_GINI_DATA'ya henüz gelmedi. Model skorları eğitim
#      döneminden olduğu için kıyas MODELİN LEHİNE taraflıdır; hüküm
#      OOT verisi gelince aynı analizle DOĞRULANMALIDIR.
#      Excel → MODEL_RESULTS kökünde (4 klasörün yanına) yazılır.
# ============================================================

# --- 0) Config bayrağı (config hücresinde tanımlı; yoksa kapalı say) ---
try:
    MODEL_GEREKLILIK_ANALIZI
except NameError:
    MODEL_GEREKLILIK_ANALIZI = False

# --- 1) Klasör kontrolü ---------------------------------------------
GEREKLI_KLASORLER = [
    "/3M_KIRMIZI_RENGE_GOC",
    "/6M_KIRMIZI_RENGE_GOC",
    "/12M_KIRMIZI_RENGE_GOC",
    "/6M_TAKIP",
]

def _analiz_klasor_var(yol):
    """mf içinde klasör var mı (dosya değil)."""
    try:
        d = mf.get_path_details("/" + str(yol).lstrip("/"))
    except Exception:
        return False
    if not isinstance(d, dict) or d.get("exists") is False:
        return False
    return bool(d.get("directory", False))

_eksik = [p for p in GEREKLI_KLASORLER if not _analiz_klasor_var(p)]
_analiz_hazir = MODEL_GEREKLILIK_ANALIZI and not _eksik

if not MODEL_GEREKLILIK_ANALIZI:
    print("ⓘ MODEL_GEREKLILIK_ANALIZI=False → df_analiz üretimi atlandı.")
elif _eksik:
    print(f"ⓘ Eksik klasör(ler): {_eksik} → df_analiz üretimi atlandı.")

if _analiz_hazir:
    if 'df_raw' not in globals():
        raise RuntimeError("df_raw bellekte yok — df_analiz kurulamaz.")

    # ================================================================
    # A) GERÇEKLEŞME HEDEFLERİ + KIYAS SKORLARI (GINI dataset)
    # ================================================================

    # --- 2) GINI dataset'ini SADECE gerekli kolonlarla oku ----------
    GINI_DATASET = "KIAILAYDABETULAKISSANDBOX.IBA_MMS_DS_GINI_DATA"
    KIYAS_SKORLAR_GINI = ["DAVRANIS_SKORU", "MUSTERI_SKORU"]
    KAYNAK_KOLONLAR = ["DONEM", "MBB_NO",
                       "RENK_3M_SONRASI", "RENK_6M_SONRASI",
                       "RENK_12M_SONRASI",
                       "AKB_GGS_6_90", "AKB_TAKIP_6M"] + KIYAS_SKORLAR_GINI

    d1   = dataiku.Dataset(GINI_DATASET)
    info = d1.get_location_info(sensitive_info=True)["info"]
    cp   = info["connectionParams"]
    root = info["path"].replace("s3://", "")
    s3   = pafs.S3FileSystem(access_key=cp["accessKey"],
                             secret_key=cp["secretKey"],
                             endpoint_override="loscdlhp.aknet.akb:9000",
                             scheme="https",
                             force_virtual_addressing=False)
    dset = pads.dataset(root, filesystem=s3, format="parquet")

    _mevcut_sema = set(dset.schema.names)
    _yok = [c for c in KAYNAK_KOLONLAR if c not in _mevcut_sema]
    if _yok:
        raise KeyError(f"GINI dataset'inde eksik kolon: {_yok}")

    tbl = dset.to_table(columns=KAYNAK_KOLONLAR, use_threads=True)
    df2 = tbl.to_pandas(self_destruct=True, split_blocks=True)
    del tbl
    print(f"GINI okundu: {df2.shape[0]:,} satır, {df2.shape[1]} kolon")

    # --- 3) ACT_* hedeflerini üret ----------------------------------
    df2["ACT_RENK3MSONRASIKIRMIZI"]  = (df2["RENK_3M_SONRASI"]  == "1-Kırmızı").astype("int8")
    df2["ACT_RENK6MSONRASIKIRMIZI"]  = (df2["RENK_6M_SONRASI"]  == "1-Kırmızı").astype("int8")
    df2["ACT_RENK12MSONRASIKIRMIZI"] = (df2["RENK_12M_SONRASI"] == "1-Kırmızı").astype("int8")
    df2["ACT_TAKIP6M"] = np.where((df2["AKB_GGS_6_90"] == 1)
                                  | (df2["AKB_TAKIP_6M"] == 1), 1, 0).astype("int8")

    JOIN_KEYS   = ["DONEM", "MBB_NO"]
    TARGET_COLS = ["ACT_RENK3MSONRASIKIRMIZI", "ACT_RENK6MSONRASIKIRMIZI",
                   "ACT_RENK12MSONRASIKIRMIZI", "ACT_TAKIP6M"]

    df2_slim = df2[JOIN_KEYS + TARGET_COLS + KIYAS_SKORLAR_GINI].copy()
    del df2

    # --- 4) Anahtar tiplerini iki tarafta eşitle --------------------
    # (float 202506.0 vs int 202506 join'i sessizce boşa düşürür)
    _raw = df_raw[list(dict.fromkeys(list(df_raw.columns)))].copy()
    for col in JOIN_KEYS:
        if col not in _raw.columns:
            raise KeyError(f"df_raw'da join anahtarı yok: {col}")
        _raw[col]      = pd.to_numeric(_raw[col],      errors="coerce").astype("Int64")
        df2_slim[col]  = pd.to_numeric(df2_slim[col],  errors="coerce").astype("Int64")

    # --- 4b) Kolon çakışması: kıyas skoru df_raw'da da varsa GINI
    # tarafından düşür (merge _x/_y sufiksi üretmesin) ----------------
    for _k in KIYAS_SKORLAR_GINI:
        if _k in _raw.columns and _k in df2_slim.columns:
            df2_slim = df2_slim.drop(columns=[_k])
            print(f"ⓘ {_k} df_raw'da zaten var → GINI kopyası düşürüldü (df_raw değeri kullanılacak)")

    # --- 5) Ortak dönemlerle sınırla + kontrol çıktıları ------------
    donem_1 = set(_raw["DONEM"].dropna().unique())
    donem_2 = set(df2_slim["DONEM"].dropna().unique())
    ortak_donemler = sorted(donem_1 & donem_2)
    print("df_raw dönemleri :", sorted(donem_1))
    print("GINI dönemleri   :", sorted(donem_2))
    print("ortak dönemler   :", ortak_donemler)
    print("df_raw'da olup GINI'de olmayan:", sorted(donem_1 - donem_2))
    print("GINI'de olup df_raw'da olmayan:", sorted(donem_2 - donem_1))
    if not ortak_donemler:
        raise RuntimeError("Ortak dönem yok — join anlamsız, df_analiz kurulmadı.")

    df1_f = _raw[_raw["DONEM"].isin(ortak_donemler)].copy()
    df2_f = df2_slim[df2_slim["DONEM"].isin(ortak_donemler)].copy()
    del _raw, df2_slim

    # --- 6) Sağ taraf anahtar bazında tekil mi? ---------------------
    dup_cnt = int(df2_f.duplicated(subset=JOIN_KEYS).sum())
    print("GINI mükerrer anahtar satırı:", dup_cnt)
    if dup_cnt > 0:
        df2_f = df2_f.drop_duplicates(subset=JOIN_KEYS, keep="first")

    # --- 7) Left join (eşleşmeyen MBB_NO'lar NaN kalır) -------------
    n_before = len(df1_f)
    df_analiz = df1_f.merge(df2_f,
                            on=JOIN_KEYS,
                            how="left",
                            validate="m:1",
                            indicator="_merge_flg")
    del df1_f, df2_f

    # --- 8) Kontroller ----------------------------------------------
    print("df_raw (ortak dönem):", f"{n_before:,}",
          "| merge sonrası:", f"{len(df_analiz):,}")
    print(df_analiz["_merge_flg"].value_counts())
    print("eşleşmeyen oran:",
          round(float((df_analiz["_merge_flg"] == "left_only").mean()), 4))

    # --- 9) Hedefler NaN'ı koruyarak integer kalsın -----------------
    for col in TARGET_COLS:
        df_analiz[col] = df_analiz[col].astype("Int8")

    df_analiz = df_analiz.drop(columns=["_merge_flg"])
    print(f"✓ df_analiz (gerçekleşme) hazır: {df_analiz.shape[0]:,} satır, "
          f"{df_analiz.shape[1]} kolon (+{len(TARGET_COLS)} hedef)")

    # ================================================================
    # B) MODEL SKORLARI — her klasörden 6 rengin
    #    renk_{kod}_{ad}_musteri_skorlari.csv dosyası
    # ================================================================
    SKOR_KOLON = ["mbb_no", "donem", "target_pred", "target_score"]
    _SKOR_RENKLER = MODEL_RENKLER if 'MODEL_RENKLER' in globals() else [1, 2, 3, 4, 5, 6]

    for _fld in GEREKLI_KLASORLER:
        _ek = _fld.strip("/")                      # kolon son eki = klasör adı

        # --- 10) Klasördeki 6 renk dosyasını oku ve birleştir -------
        _parcalar = []
        for _rk in _SKOR_RENKLER:
            _ra  = COLOR_MAP.get(_rk, str(_rk))
            _yol = f"/{_ek}/renk_{_rk}_{_ra}_musteri_skorlari.csv"
            try:
                with mf.get_download_stream(_yol) as _s:
                    _p = pd.read_csv(_s, usecols=SKOR_KOLON)
                _parcalar.append(_p)
                print(f"   {_ek} / renk_{_rk}_{_ra}: {len(_p):,} satır")
            except Exception as e:
                print(f"   ⚠ {_yol} okunamadı ({e}) → bu renk atlandı")
        if not _parcalar:
            print(f"⚠ {_ek}: hiçbir renk dosyası okunamadı → skor eklenmedi.")
            continue
        _sc = pd.concat(_parcalar, ignore_index=True)
        del _parcalar
        print(f"{_ek}: toplam {len(_sc):,} satır (6 renk birleşik)")

        # --- 11) Anahtarları df_analiz ile aynı tipe getir ----------
        _sc["mbb_no"] = pd.to_numeric(_sc["mbb_no"], errors="coerce").astype("Int64")
        _sc["donem"]  = pd.to_numeric(_sc["donem"],  errors="coerce").astype("Int64")
        _sc = _sc.dropna(subset=["mbb_no", "donem"])

        # --- 12) Anahtar bazında tekilleştir ------------------------
        # Renkler ayrık segment; dosyada train+val aynı dönemi
        # taşıyabilir ama skor aynıdır — çoğalma riskine karşı dedup.
        _dup = int(_sc.duplicated(subset=["mbb_no", "donem"]).sum())
        if _dup > 0:
            print(f"   ⚠ {_ek}: {_dup:,} mükerrer mbb_no+donem satırı düşürüldü")
            _sc = _sc.drop_duplicates(subset=["mbb_no", "donem"], keep="first")

        # --- 13) Kolonları klasör adıyla yeniden adlandır -----------
        _sc = _sc.rename(columns={"target_score": f"SKOR_{_ek}",
                                  "target_pred":  f"PRED_{_ek}",
                                  "mbb_no":       "MBB_NO",
                                  "donem":        "DONEM"})

        # --- 14) Left join ------------------------------------------
        _n_once = len(df_analiz)
        df_analiz = df_analiz.merge(_sc, on=["MBB_NO", "DONEM"],
                                    how="left", validate="m:1")
        assert len(df_analiz) == _n_once, f"{_ek}: join satır sayısını değiştirdi!"

        _eslesme = df_analiz[f"SKOR_{_ek}"].notna().mean()
        print(f"   ✓ SKOR_{_ek} + PRED_{_ek} eklendi | eşleşme: {_eslesme:.1%}")
        del _sc

    # --- 15) PRED_* kolonları NaN koruyarak integer kalsın ----------
    for _fld in GEREKLI_KLASORLER:
        _c = f"PRED_{_fld.strip('/')}"
        if _c in df_analiz.columns:
            df_analiz[_c] = df_analiz[_c].astype("Int8")

    # --- 16) QA: eşleşen kitlede ACT vs PRED pozitif oranları -------
    _qa_cift = [("ACT_RENK3MSONRASIKIRMIZI",  "3M_KIRMIZI_RENGE_GOC"),
                ("ACT_RENK6MSONRASIKIRMIZI",  "6M_KIRMIZI_RENGE_GOC"),
                ("ACT_RENK12MSONRASIKIRMIZI", "12M_KIRMIZI_RENGE_GOC"),
                ("ACT_TAKIP6M",               "6M_TAKIP")]
    print("\nQA — eşleşen kitlede pozitif oranlar (ACT=gerçekleşme, PRED=model 0/1):")
    for _a, _e in _qa_cift:
        _p = f"PRED_{_e}"
        if _a in df_analiz.columns and _p in df_analiz.columns:
            _m = df_analiz[_p].notna()
            if _m.any():
                print(f"   {_a}: {df_analiz.loc[_m, _a].mean():.4f}  |  "
                      f"{_p}: {df_analiz.loc[_m, _p].astype('float').mean():.4f}")

    print(f"\n✓ df_analiz FINAL: {df_analiz.shape[0]:,} satır, "
          f"{df_analiz.shape[1]} kolon")

    # ================================================================
    # C) KIYAS SKORLARI 20'Lİ BUCKET RAPORU (SADECE TRAIN)
    # ----------------------------------------------------------------
    #   DAVRANIS_SKORU: yüksek = İYİ  → riskli yön = DÜŞÜK (işaret -1)
    #   MUSTERI_SKORU : yüksek = KÖTÜ → riskli yön = YÜKSEK (işaret +1)
    # Skor, işaret çarpanıyla "büyük = riskli" hale getirilir;
    # bucket 1 = en riskli %5.
    # ⚠ SADECE TRAIN: OOT gerçekleşmesi GINI dataset'ine gelmedi.
    # Model skorları eğitim döneminden → kıyas modelin lehine taraflı;
    # hüküm OOT gelince doğrulanmalı (hüküm sheet'inde not düşülür).
    # ================================================================
    ANALIZ_N_BUCKET = 20
    ANALIZ_DONEM    = TRAIN_DONEM if 'TRAIN_DONEM' in globals() else 202504
    KACAN_UST       = 4        # "en riskli" = bucket 1-4 (üst %20); kaçan = B5-20 & PRED=1

    # --- HÜKÜM EŞİKLERİ (öneri — iş tarafıyla mutabık kalınmalı) ----
    ESIK_GINI_FARK    = 0.05   # T1a: model Gini - en iyi mevcut Gini ≤ 0.05 → mevcut yeter
    ESIK_CAPTURE_FARK = 0.05   # T1b: capture@20% farkı ≤ 5 puan → mevcut yeter
    ESIK_KACAN        = 1.5    # T2 : kaçan dilim ACT / genel ACT ≤ 1.5 → kör nokta yok

    _KIYAS_TANIM = [
        ("DAVRANIS", ["DAVRANIS_SKORU", "DAVRANIS_SKOR", "DAVRANIS_SCORE"], -1.0),
        ("MUSTERI",  ["MUSTERI_SKORU",  "MUSTERI_SKOR",  "MUSTERI_SCORE"],  +1.0),
    ]
    KIYAS_SKORLARI = []                      # (kısa ad, kolon, işaret)
    for _ad, _adaylar, _isaret in _KIYAS_TANIM:
        _col = next((c for c in _adaylar if c in df_analiz.columns), None)
        if _col is None:
            print(f"⚠ {_ad} skoru bulunamadı (aranan: {_adaylar}) → bu skor atlandı")
        else:
            KIYAS_SKORLARI.append((_ad, _col, _isaret))
    if not KIYAS_SKORLARI:
        raise KeyError("Hiçbir kıyas skoru bulunamadı — bucket raporu kurulamaz.")

    ACT_COLS  = TARGET_COLS
    PRED_COLS = [f"PRED_{f.strip('/')}" for f in GEREKLI_KLASORLER
                 if f"PRED_{f.strip('/')}" in df_analiz.columns]
    SKORM_MAP = {a: (f"SKOR_{e}", f"PRED_{e}") for a, e in _qa_cift
                 if f"SKOR_{e}" in df_analiz.columns}

    _mask = df_analiz["DONEM"] == ANALIZ_DONEM
    if "KK_URUN_FLG" in df_analiz.columns:
        _mask &= (df_analiz["KK_URUN_FLG"] == "KK")
    dfA0 = df_analiz.loc[_mask].copy()
    print(f"\nC) Bucket raporu ana kitlesi: DONEM={ANALIZ_DONEM}, KK → {len(dfA0):,} satır")
    if dfA0.empty:
        raise RuntimeError("Bucket raporu kitlesi boş — dönem/kolonları kontrol edin.")

    def _bucketla_riskli(skor_riskli_buyuk, nb=ANALIZ_N_BUCKET):
        """skor 'büyük = riskli' verilmiş olmalı. Bucket 1 = en riskli %5."""
        s = np.asarray(skor_riskli_buyuk, dtype="float64"); n = len(s)
        order = np.argsort(s, kind="stable")
        r = np.empty(n, dtype="float64"); r[order] = np.arange(1, n + 1)
        edges = 1.0 + np.arange(nb + 1) * (n - 1) / nb
        return nb - np.searchsorted(edges[1:-1], r, side="left")

    def _bucket_blogu(dsub, etiket, skor_col, isaret):
        """Bir kitle için 20 satırlık bucket tablosu döner."""
        d = dsub.copy()
        d["_B"] = _bucketla_riskli(isaret * d[skor_col].to_numpy(dtype="float64"))
        g = d.groupby("_B")
        _yon = "düşük" if isaret < 0 else "yüksek"
        blok = pd.DataFrame({
            "SEGMENT": etiket,
            f"BUCKET (1=en riskli, {_yon} {skor_col})": g.size().index,
            "MÜŞTERİ": g.size().values,
            "SKOR_MIN": g[skor_col].min().round(4).values,
            "SKOR_ORT": g[skor_col].mean().round(4).values,
            "SKOR_MAX": g[skor_col].max().round(4).values,
        })
        for c in ACT_COLS:
            blok[f"{c} (%)"] = g[c].apply(
                lambda x: round(float(pd.to_numeric(x, errors="coerce").mean()), 4)).values
        for c in PRED_COLS:
            blok[f"{c} (%)"] = g[c].apply(
                lambda x: round(float(pd.to_numeric(x, errors="coerce").mean()), 4)).values
        return blok

    def _capture_pct(y, skor_riskli_buyuk, pct=0.20):
        """En riskli %pct dilimin yakaladığı vaka payı."""
        y = pd.to_numeric(y, errors="coerce").astype("float64").to_numpy()
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        tot = y.sum()
        if tot <= 0 or len(y) == 0:
            return np.nan
        k = max(1, int(pct * len(y)))
        top = np.argpartition(-s, min(k, len(y) - 1))[:k]
        return float(y[top].sum() / tot)

    def _gini(y, skor_riskli_buyuk):
        """Gini = 2*AUC - 1. skor: büyük = riskli olacak şekilde verilmeli.
        NEGATİF çıkabilir ve negatif RAPORLANIR (abs alınmaz) — negatif
        Gini 'skor bu hedefte TERS çalışıyor' demektir, gizlenmemeli."""
        y = pd.to_numeric(y, errors="coerce").astype("float64").to_numpy()
        s = np.asarray(skor_riskli_buyuk, dtype="float64")
        ok = np.isfinite(y) & np.isfinite(s)
        y, s = y[ok], s[ok]
        if len(y) == 0 or len(np.unique(y)) < 2:
            return np.nan
        return float(2.0 * roc_auc_score(y, s) - 1.0)

    _renk_map = COLOR_MAP if 'COLOR_MAP' in globals() else {}

    # --- Bucket blokları: her kıyas skoru için GENEL + renkler ------
    bucket_sheetler = {}
    for _ad, _col, _isaret in KIYAS_SKORLARI:
        _dfS = dfA0[dfA0[_col].notna()].copy()
        print(f"   {_ad} ({_col}): {len(_dfS):,} satır skorlu "
              f"({len(dfA0) - len(_dfS):,} boş dışarıda)")
        if _dfS.empty:
            continue
        _bloklar = [_bucket_blogu(_dfS, "GENEL (TÜM PORTFÖY)", _col, _isaret)]
        if "RENK" in _dfS.columns:
            for _rk in _SKOR_RENKLER:
                _dr = _dfS[_dfS["RENK"] == _rk]
                if len(_dr) >= ANALIZ_N_BUCKET:
                    _bloklar.append(_bucket_blogu(
                        _dr, f"{_rk}-{_renk_map.get(_rk, _rk)}", _col, _isaret))
                else:
                    print(f"   ⚠ {_ad} / RENK {_rk}: {len(_dr)} satır — bucket için az, atlandı")
        bucket_sheetler[f"BUCKET20_{_ad}"] = (_bloklar, _col, _isaret)

    # --- Capture + GINI kıyası + KAÇAN DİLİM + HÜKÜM ----------------
    kiyas_satirlar, kacan_satirlar, hukum_satirlar = [], [], []

    def _segment_isle(dsub, etiket):
        for _a, (_skor_m, _pred_m) in SKORM_MAP.items():
            _y = pd.to_numeric(dsub[_a], errors="coerce")
            _vaka = int(_y.fillna(0).sum())
            _genel = float(_y.mean()) if _y.notna().any() else np.nan

            # ---- kıyas satırı (capture + gini, üç sıralama) --------
            _row = {"SEGMENT": etiket, "HEDEF": _a, "VAKA": _vaka}
            _mevcut_metrik = {}                    # ad → (cap, gini)
            for _ad, _col, _isaret in KIYAS_SKORLARI:
                _s = _isaret * dsub[_col].astype("float64").to_numpy()
                _cap, _gin = _capture_pct(dsub[_a], _s), _gini(dsub[_a], _s)
                _mevcut_metrik[_ad] = (_cap, _gin)
                _row[f"{_ad} capture@20%"] = round(_cap, 4) if np.isfinite(_cap) else None
                _row[f"{_ad} GINI"]        = round(_gin, 4) if np.isfinite(_gin) else None
            _ort = dsub[_skor_m].notna()
            if _ort.any():
                _s_m = dsub.loc[_ort, _skor_m].to_numpy(dtype="float64")
                _cap_md = _capture_pct(dsub.loc[_ort, _a], _s_m)
                _gin_md = _gini(dsub.loc[_ort, _a], _s_m)
            else:
                _cap_md = _gin_md = np.nan
            _row["MODEL capture@20%"] = round(_cap_md, 4) if np.isfinite(_cap_md) else None
            _row["MODEL GINI"]        = round(_gin_md, 4) if np.isfinite(_gin_md) else None
            for _ad in _mevcut_metrik:
                _c0, _g0 = _mevcut_metrik[_ad]
                _row[f"CAPTURE FARKI (model - {_ad.lower()})"] = \
                    round(_cap_md - _c0, 4) if np.isfinite(_cap_md) and np.isfinite(_c0) else None
                _row[f"GINI FARKI (model - {_ad.lower()})"] = \
                    round(_gin_md - _g0, 4) if np.isfinite(_gin_md) and np.isfinite(_g0) else None
            kiyas_satirlar.append(_row)

            # ---- kaçan dilim: mevcut skor B5-20 & PRED=1 -----------
            _kacan_katlar = {}
            for _ad, _col, _isaret in KIYAS_SKORLARI:
                _okm = dsub[_col].notna() & dsub[_pred_m].notna()
                if not _okm.any():
                    continue
                _dk = dsub.loc[_okm]
                _b = _bucketla_riskli(_isaret * _dk[_col].to_numpy(dtype="float64"))
                _temiz = _b > KACAN_UST                       # skorun temiz dediği B5-20
                _isaretli = pd.to_numeric(_dk[_pred_m], errors="coerce").fillna(0).to_numpy() == 1
                _kac = _temiz & _isaretli
                _n_kac = int(_kac.sum())
                _yk = pd.to_numeric(_dk[_a], errors="coerce")
                _act_kac = float(_yk[_kac].mean()) if _n_kac else np.nan
                _act_gen = float(_yk.mean()) if _yk.notna().any() else np.nan
                _kat = (_act_kac / _act_gen) if (np.isfinite(_act_kac)
                        and np.isfinite(_act_gen) and _act_gen > 0) else np.nan
                if np.isfinite(_kat):
                    _kacan_katlar[_ad] = _kat
                kacan_satirlar.append({
                    "SEGMENT": etiket, "HEDEF": _a, "MEVCUT SKOR": _ad,
                    "KAÇAN KİTLE (skor B5-20 & model PRED=1, adet)": _n_kac,
                    "KAÇAN KİTLENİN GERÇEK ORANI": round(_act_kac, 4)
                        if np.isfinite(_act_kac) else None,
                    "SEGMENT GENEL ORANI": round(_act_gen, 4)
                        if np.isfinite(_act_gen) else None,
                    "KAÇAN / GENEL (kaç kat)": round(_kat, 1)
                        if np.isfinite(_kat) else None,
                })

            # ---- hüküm: T1 fark (en iyi mevcut'a karşı) + T2 kaçan --
            _caps = [m[0] for m in _mevcut_metrik.values() if np.isfinite(m[0])]
            _gins = [m[1] for m in _mevcut_metrik.values() if np.isfinite(m[1])]
            _cap_best = max(_caps) if _caps else np.nan
            _gin_best = max(_gins) if _gins else np.nan
            _cap_fark = _cap_md - _cap_best if np.isfinite(_cap_md) and np.isfinite(_cap_best) else np.nan
            _gin_fark = _gin_md - _gin_best if np.isfinite(_gin_md) and np.isfinite(_gin_best) else np.nan
            # T2: HERHANGİ bir mevcut skor kör noktayı kapatıyorsa
            # (kat küçükse) o skor işi görür → min alınır.
            _kat_min = min(_kacan_katlar.values()) if _kacan_katlar else np.nan
            _ek_vaka = int(round(_cap_fark * _vaka)) if np.isfinite(_cap_fark) else None

            t1 = (np.isfinite(_gin_fark) and _gin_fark <= ESIK_GINI_FARK and
                  np.isfinite(_cap_fark) and _cap_fark <= ESIK_CAPTURE_FARK)
            t2 = np.isfinite(_kat_min) and _kat_min <= ESIK_KACAN
            if t1 and t2:
                _hkm = "GEREKMEYEBİLİR — mevcut skor(lar) yeterli [TRAIN, OOT ile doğrulanmalı]"
            else:
                _seb = []
                if not t1:
                    _seb.append(f"model fark katıyor (GINI {_gin_fark:+.3f}, "
                                f"capture {_cap_fark:+.3f})"
                                if np.isfinite(_gin_fark) and np.isfinite(_cap_fark)
                                else "fark hesaplanamadı")
                if not t2:
                    _seb.append(f"kör nokta var (kaçan dilim genelin "
                                f"{_kat_min:.1f} katı)" if np.isfinite(_kat_min)
                                else "kaçan dilim hesaplanamadı")
                _hkm = "GEREKLİ — " + "; ".join(_seb) + " [TRAIN, OOT ile doğrulanmalı]"
            hukum_satirlar.append({
                "SEGMENT": etiket, "HEDEF": _a, "VAKA": _vaka,
                "EN İYİ MEVCUT GINI": round(_gin_best, 4) if np.isfinite(_gin_best) else None,
                "MODEL GINI": round(_gin_md, 4) if np.isfinite(_gin_md) else None,
                "GINI FARKI (≤0.05 → mevcut yeter)": round(_gin_fark, 4)
                    if np.isfinite(_gin_fark) else None,
                "CAPTURE FARKI (≤0.05 → mevcut yeter)": round(_cap_fark, 4)
                    if np.isfinite(_cap_fark) else None,
                "MODELİN EK VAKASI (adet, capture farkı x vaka)": _ek_vaka,
                "KAÇAN DİLİM KATI (min, ≤1.5 → kör nokta yok)": round(_kat_min, 1)
                    if np.isfinite(_kat_min) else None,
                "HÜKÜM": _hkm,
            })

    _segment_isle(dfA0, "GENEL (TÜM PORTFÖY)")
    if "RENK" in dfA0.columns:
        for _rk in _SKOR_RENKLER:
            _dr = dfA0[dfA0["RENK"] == _rk]
            if len(_dr):
                _segment_isle(_dr, f"{_rk}-{_renk_map.get(_rk, _rk)}")
    kiyas_df = pd.DataFrame(kiyas_satirlar)
    kacan_df = pd.DataFrame(kacan_satirlar)
    hukum_df = pd.DataFrame(hukum_satirlar)

    # ================================================================
    # F) TREND — mevcut skorların GINI'si TÜM ortak dönemlerde
    # ----------------------------------------------------------------
    # Amaç: hüküm tek döneme (TRAIN) dayanıyor; mevcut skorların
    # zayıflığı/tersliği dönemsel bir tesadüf mü, kalıcı mı? Bu tablo
    # onu gösterir. Model skoru sadece TRAIN'de var → trend yalnız
    # DAVRANIS/MUSTERI skorlarını kapsar. Negatif GINI negatif yazılır.
    # ================================================================
    trend_satirlar = []
    _trend_mask_base = pd.Series(True, index=df_analiz.index)
    if "KK_URUN_FLG" in df_analiz.columns:
        _trend_mask_base &= (df_analiz["KK_URUN_FLG"] == "KK")

    for _don in ortak_donemler:
        _dfd = df_analiz.loc[_trend_mask_base & (df_analiz["DONEM"] == _don)]
        if _dfd.empty:
            continue

        def _trend_isle(_dsub, _etiket):
            for _a in ACT_COLS:
                _yv = pd.to_numeric(_dsub[_a], errors="coerce")
                _r = {"DONEM": int(_don), "SEGMENT": _etiket, "HEDEF": _a,
                      "VAKA": int(_yv.fillna(0).sum())}
                for _ad, _col, _isaret in KIYAS_SKORLARI:
                    _g = _gini(_dsub[_a],
                               _isaret * _dsub[_col].astype("float64").to_numpy())
                    _r[f"{_ad} GINI"] = round(_g, 4) if np.isfinite(_g) else None
                trend_satirlar.append(_r)

        _trend_isle(_dfd, "GENEL (TÜM PORTFÖY)")
        if "RENK" in _dfd.columns:
            for _rk in _SKOR_RENKLER:
                _dr = _dfd[_dfd["RENK"] == _rk]
                if len(_dr):
                    _trend_isle(_dr, f"{_rk}-{_renk_map.get(_rk, _rk)}")
        print(f"   TREND {_don}: hesaplandı ({len(_dfd):,} satır)")

    trend_df = pd.DataFrame(trend_satirlar)
    if not trend_df.empty:
        trend_df = trend_df.sort_values(["HEDEF", "SEGMENT", "DONEM"]).reset_index(drop=True)

    # --- Excel ------------------------------------------------------
    _fill = PatternFill("solid", fgColor="F4CCCC")
    _byz  = Font(bold=True, color="7A1F1F")
    _yesil = PatternFill("solid", fgColor="C6EFCE")
    _kirm  = PatternFill("solid", fgColor="FFC7CE")
    buf = BytesIO()
    with pd.ExcelWriter(buf, engine="openpyxl") as xl:
        wb = xl.book

        # Sheet: HUKUM (ilk sheet — cevap burada)
        hukum_df.to_excel(xl, sheet_name="HUKUM", index=False, startrow=4)
        ws = wb["HUKUM"]
        ws["A1"] = ("HÜKÜM: MEVCUT SKORLAR (DAVRANIS + MUSTERI) VARKEN MODELLER GEREKLİ Mİ? "
                    f"— DONEM={ANALIZ_DONEM}, SADECE TRAIN")
        ws["A2"] = ("⚠ ÖNEMLİ KISIT: OOT gerçekleşmesi henüz yok; model skorları EĞİTİM "
                    "döneminden olduğu için kıyas modelin LEHİNE taraflıdır. 'GEREKLİ' "
                    "hükümleri OOT verisi gelince aynı analizle DOĞRULANMADAN kesinleşmemelidir. "
                    "Mevcut skorların dönemsel STABİLİTESİ için TREND sheet'ine bakınız.")
        ws["A3"] = ("KURAL: 'gerekmeyebilir' için İKİ TEST birden geçmeli. T1 FARK: modelin "
                    "GINI ve capture katkısı en iyi mevcut skora göre ≤0.05. T2 KAÇAN: mevcut "
                    "skorlardan EN AZ BİRİNİN temiz dediği (B5-20) ama modelin işaretlediği "
                    "kitlenin gerçek oranı genelin ≤1.5 katı (kör nokta yok). "
                    "Eşikler öneridir — ESIK_* sabitlerinden ayarlanır.")
        for _c in ("A1", "A2", "A3"):
            ws[_c].font = Font(bold=(_c == "A1"))
        for c in range(1, hukum_df.shape[1] + 1):
            h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
            h.alignment = Alignment(wrap_text=True, vertical="top")
            ws.column_dimensions[get_column_letter(c)].width = 18
        ws.column_dimensions[get_column_letter(hukum_df.shape[1])].width = 55
        for _r in range(6, 6 + len(hukum_df)):
            _v = ws.cell(row=_r, column=hukum_df.shape[1]).value
            if isinstance(_v, str) and _v.startswith("GEREKLİ"):
                ws.cell(row=_r, column=hukum_df.shape[1]).fill = _kirm
            elif isinstance(_v, str) and _v.startswith("GEREKMEYEBİLİR"):
                ws.cell(row=_r, column=hukum_df.shape[1]).fill = _yesil
        _fmt_c = [i + 1 for i, c in enumerate(hukum_df.columns)
                  if "GINI" in c or "CAPTURE" in c or "FARKI" in c]
        for _c in _fmt_c:
            for _r in range(6, 6 + len(hukum_df)):
                ws.cell(row=_r, column=_c).number_format = "0.00%"
        ws.freeze_panes = "C6"

        # Bucket sheet'leri: BUCKET20_DAVRANIS, BUCKET20_MUSTERI
        for _sheet, (_bloklar, _col, _isaret) in bucket_sheetler.items():
            r = 4
            ilk = True
            for b in _bloklar:
                b.to_excel(xl, sheet_name=_sheet, index=False, startrow=r, header=ilk)
                r += len(b) + (1 if ilk else 0) + 2
                ilk = False
            ws = wb[_sheet]
            _yon = ("DÜŞÜK skor = riskli (skor yüksek=iyi)" if _isaret < 0
                    else "YÜKSEK skor = riskli (skor 1'e yaklaştıkça kötü)")
            ws["A1"] = (f"{_col} 20'Lİ BUCKET — DONEM={ANALIZ_DONEM} (SADECE TRAIN), KK. "
                        f"BUCKET 1 = en riskli %5 — {_yon}.")
            ws["A2"] = ("ACT_ = o bucket'ta GERÇEKLEŞME oranı (bu skor gerçek riski ayrıştırıyor "
                        "mu). PRED_ = o bucket'ta MODELİN 1 bastığı oran (model bu skorun iyi "
                        "dediği bucket'larda da risk buluyor mu).")
            ws["A3"] = ("OKUMA: ACT_ sadece bucket 1-2'de toplanıyorsa bu skor yeterli iddiası "
                        "güçlenir; üst bucket'larda hâlâ ACT_/PRED_ kayda değerse modeller kör "
                        "noktayı yakalıyor demektir. Renk bloklarında bucket renk İÇİNDE kesilir. "
                        "⚠ TRAIN verisi — model kolonları eğitim dönemi, modelin lehine taraflı.")
            for _c in ("A1", "A2", "A3"):
                ws[_c].font = Font(bold=(_c == "A1"))
            _b0 = _bloklar[0]
            for c in range(1, _b0.shape[1] + 1):
                h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
                h.alignment = Alignment(wrap_text=True, vertical="top")
                ws.column_dimensions[get_column_letter(c)].width = 15
            _pct_c = [i + 1 for i, c in enumerate(_b0.columns) if c.endswith("(%)")]
            for _c in _pct_c:
                for _r in range(6, r + 1):
                    ws.cell(row=_r, column=_c).number_format = "0.00%"
            ws.freeze_panes = "C6"

        # Sheet: CAPTURE_GINI_KIYAS
        kiyas_df.to_excel(xl, sheet_name="CAPTURE_GINI_KIYAS", index=False, startrow=4)
        ws = wb["CAPTURE_GINI_KIYAS"]
        ws["A1"] = ("CAPTURE@20% + GINI — DAVRANIS vs MUSTERI vs MODEL, aynı hedefte üç "
                    f"sıralamanın gücü (DONEM={ANALIZ_DONEM}, SADECE TRAIN).")
        ws["A2"] = ("CAPTURE@20%: en riskli %20 önceden işaretlenseydi vakaların yüzde kaçı "
                    "yakalanırdı. GINI=2*AUC-1: tüm sıralamanın gücü. DAVRANIS düşük=riskli, "
                    "MUSTERI yüksek=riskli, MODEL ham skor (skorlu alt kitlede). NEGATİF GINI "
                    "= skor bu hedefte TERS çalışıyor (gizlenmez, negatif yazılır). "
                    "⚠ Model kolonları eğitim dönemi — modelin lehine taraflı.")
        for _c in ("A1", "A2"):
            ws[_c].font = Font(bold=(_c == "A1"))
        for c in range(1, kiyas_df.shape[1] + 1):
            h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
            h.alignment = Alignment(wrap_text=True, vertical="top")
            ws.column_dimensions[get_column_letter(c)].width = 18
        _fmt_c = [i + 1 for i, c in enumerate(kiyas_df.columns)
                  if "capture" in c or "CAPTURE" in c or "GINI" in c]
        for _c in _fmt_c:
            for _r in range(6, 6 + len(kiyas_df)):
                ws.cell(row=_r, column=_c).number_format = "0.00%"
        ws.freeze_panes = "C6"

        # Sheet: KACAN_DILIM
        kacan_df.to_excel(xl, sheet_name="KACAN_DILIM", index=False, startrow=4)
        ws = wb["KACAN_DILIM"]
        ws["A1"] = ("KAÇAN DİLİM — mevcut skorun TEMİZ dediği (bucket 5-20) ama MODELİN riskli "
                    f"işaretlediği kitle gerçekte ne yaptı? (DONEM={ANALIZ_DONEM}, SADECE TRAIN)")
        ws["A2"] = ("Bu, model gerekliliğinin en net kanıtıdır: KAÇ KAT sütunu yüksekse model, "
                    "mevcut skorun göremediği gerçek riski buluyor demektir. ≈1 civarındaysa "
                    "modelin işaretledikleri mevcut skorun temiz dediği yerde sıradan müşteri — "
                    "kör nokta yok. Hüküm sheet'i her hedef için İKİ skordan KÜÇÜK olan katı "
                    "kullanır (biri kör noktayı kapatıyorsa o skor işi görür).")
        for _c in ("A1", "A2"):
            ws[_c].font = Font(bold=(_c == "A1"))
        for c in range(1, kacan_df.shape[1] + 1):
            h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
            h.alignment = Alignment(wrap_text=True, vertical="top")
            ws.column_dimensions[get_column_letter(c)].width = 20
        for _c in [i + 1 for i, c in enumerate(kacan_df.columns) if "ORANI" in c]:
            for _r in range(6, 6 + len(kacan_df)):
                ws.cell(row=_r, column=_c).number_format = "0.00%"
        ws.freeze_panes = "D6"

        # Sheet: TREND (mevcut skorların dönemsel GINI'si)
        if not trend_df.empty:
            trend_df.to_excel(xl, sheet_name="TREND", index=False, startrow=4)
            ws = wb["TREND"]
            ws["A1"] = ("TREND — MEVCUT SKORLARIN GINI'Sİ TÜM ORTAK DÖNEMLERDE "
                        f"({', '.join(str(d) for d in ortak_donemler)})")
            ws["A2"] = ("Amaç: hüküm tek döneme (TRAIN) dayanıyor; mevcut skorların "
                        "zayıflığı/tersliği dönemsel tesadüf mü, KALICI mı? GINI dönemler "
                        "arasında benzer seyrediyorsa TRAIN bulgusu genellenebilir; "
                        "zıplıyorsa hüküm kırılgandır. Model skoru sadece TRAIN'de mevcut "
                        "olduğu için bu tablo yalnız DAVRANIS/MUSTERI skorlarını kapsar. "
                        "NEGATİF GINI = skor o segment+hedefte TERS çalışıyor.")
            for _c in ("A1", "A2"):
                ws[_c].font = Font(bold=(_c == "A1"))
            for c in range(1, trend_df.shape[1] + 1):
                h = ws.cell(row=5, column=c); h.fill = _fill; h.font = _byz
                h.alignment = Alignment(wrap_text=True, vertical="top")
                ws.column_dimensions[get_column_letter(c)].width = 18
            for _c in [i + 1 for i, c in enumerate(trend_df.columns) if "GINI" in c]:
                for _r in range(6, 6 + len(trend_df)):
                    ws.cell(row=_r, column=_c).number_format = "0.00%"
            ws.freeze_panes = "E6"

    buf.seek(0)
    _rapor_yolu = "/kiyas_skorlari_vs_modeller_bucket20.xlsx"
    mf.upload_stream(_rapor_yolu, buf)
    print(f"\n✓ {_rapor_yolu} yazıldı "
          f"(HUKUM + {', '.join(bucket_sheetler.keys())} + CAPTURE_GINI_KIYAS "
          f"+ KACAN_DILIM + TREND)")
    del dfA0
