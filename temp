satirlar, sorunlu = [], []
for k in registry:
    ad, eski = k["ad"], k["istatistikler"]
    if ad not in train_df.columns:
        sorunlu.append(ad); continue
    ist = istatistik_hesapla(train_df[ad], train_df)
    if ist is None:
        sorunlu.append(ad); continue
    fark = (abs(ist["lift"] - eski["lift"]) > 0.01) or (abs(ist["pp_gap"] - eski["pp_gap"]) > 0.5)
    if fark:
        sorunlu.append(ad)
    satirlar.append({
        "feature": ad,
        "lift": ist["lift"],
        "pp_gap": ist["pp_gap"],
        "sifir_%": round(ist["sifir_orani"] * 100, 1),
        "egri": ist["egri_sekli"],
        "zayif": "⚠" if k.get("zayif_sinyal") else "",
        "tutarli": "FARK!" if fark else "✓",   # kayıtla karşılaştırma tek sütunda
    })

ozet = pd.DataFrame(satirlar)
with pd.option_context("display.max_colwidth", 45, "display.width", 200):
    print(ozet.to_string(index=False))

print("-" * 80)
if sorunlu:
    print(f"DİKKAT — incelenmesi gereken: {sorunlu}")
else:
    print("Tüm feature'lar tutarlı: yeniden hesaplanan metrikler kayıtla birebir eşleşiyor.")
