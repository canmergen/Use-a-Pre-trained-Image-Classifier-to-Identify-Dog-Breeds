    mask = ((df['KK_URUN_FLG'] == 'KK') &
            (df['RENK'] == RENK_KOD) &
            (df['DONEM'].isin([TRAIN_DONEM, OOT_DONEM])))
    df_r = df.loc[mask].copy()
    if df_r.empty or (df_r['DONEM'] == TRAIN_DONEM).sum() == 0:
        print("  veri yok, atlandı"); continue

    # 2) Feature engineering
    df_eng_r, eng_cols_r = feature_engineering(df_r)

    # 3) CSV'den feature + parametre
    try:
        FEATURES    = _features_oku(RENK_KOD, renk_adi)
        best_params = _best_params_oku(RENK_KOD, renk_adi)
    except Exception as e:
        print(f"  CSV okunamadı ({e}), atlandı"); continue
    FEATURES = [c for c in FEATURES if c in df_eng_r.columns]

    # 4) Zaman bazlı bölme + kategorik hizalama
    train_full = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == TRAIN_DONEM, FEATURES + [TARGET]])
    oot        = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == OOT_DONEM,   FEATURES + [TARGET]])
    for c in CAT_COLS:
        if c in train_full.columns and str(train_full[c].dtype) == 'category':
            oot[c] = pd.Categorical(oot[c], categories=train_full[c].cat.categories)

    # 5) Model — skorlama bloğundakiyle AYNI model; varsa yeniden eğitilmiyor
    X_tr, y_tr = train_full[FEATURES], train_full[TARGET]
    _hazir = ((RENK_KOD in secilen_modeller)
              and ('model' in secilen_modeller[RENK_KOD])
              and (list(secilen_modeller[RENK_KOD].get('features', [])) == list(FEATURES)))
    if _hazir:
        model = secilen_modeller[RENK_KOD]['model']
        print("  ▶ Model skorlama bloğundan alındı (yeniden eğitim YOK)")
    else:
        spw = (len(y_tr) - y_tr.sum()) / max(y_tr.sum(), 1)
        model = lgb.LGBMClassifier(objective='binary', metric='auc', scale_pos_weight=spw,
                                   random_state=RANDOM_STATE, n_jobs=-1, verbose=-1)
        model.set_params(**best_params).fit(X_tr, y_tr)
        print("  ▶ Model eğitildi")
    secilen_modeller[RENK_KOD] = {'model': model, 'features': FEATURES,
                                  'best_params': best_params}

    # 6) Hem train hem OOT skorla → tek uzun tabloya ekle
    for donem_tipi, frame, donem_val in [('TRAIN', train_full, TRAIN_DONEM),
                                         ('OOT',   oot,        OOT_DONEM)]:
        if frame.empty:
            continue
        prob = model.predict_proba(frame[FEATURES])[:, 1]
        ham  = df_eng_r.loc[frame.index]
        _n   = len(frame)
        # dtype'lar bilinçli: category + küçük tamsayı. Değerler ve CSV
        # çıktısı birebir aynı, bellek 4.8x düşüyor.
        out = pd.DataFrame({
            'renk_kod':   np.full(_n, RENK_KOD, dtype='int16'),
            'renk_adi':   pd.Categorical([renk_adi] * _n),
            'donem_tipi': pd.Categorical([donem_tipi] * _n),
            'donem':      np.full(_n, donem_val, dtype='int32'),
            'SKOR':       prob,                                   # float64 kalıyor
            'TARGET':     frame[TARGET].to_numpy(dtype='int8'),
            'limit':      ham[LIMIT_COL].values if LIMIT_COL in ham else np.nan,
            'risk':       ham[RISK_COL].values  if RISK_COL  in ham else np.nan,
        }, index=frame.index)
        if ID_COL in ham:
            out['musteri_id'] = ham[ID_COL].values
        scored_parts.append(out)

    del df_eng_r, df_r, train_full, oot, X_tr, y_tr
    print(f"  ✓ {etiket} skorlandı (train+oot)")

scored = pd.concat(scored_parts, ignore_index=True)
del scored_parts
print("\nToplam skorlanan satır:", scored.shape)
print("Bellek:", f"{scored.memory_usage(deep=True).sum()/1e6:,.0f} MB")

