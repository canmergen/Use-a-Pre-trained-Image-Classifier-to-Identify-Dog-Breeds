# --- TAKİBE GEÇİŞ ANALİZİ (sadece bakış, TARGET'a dokunmaz) ---
# Şu anki renk (satır) -> 6M içinde takibe düşüş (sütun)
# Takip tanımı = 6M_TAKIP target mantığıyla aynı: AKB_GGS_6_90 == 1 | AKB_TAKIP_6M == 1

SADECE_KK   = True    # False yaparsan tüm portföy
YUZDE_GOSTER = True

_d = df[df['KK_URUN_FLG'] == 'KK'] if SADECE_KK else df

_takip = np.where((_d['AKB_GGS_6_90'] == 1) | (_d['AKB_TAKIP_6M'] == 1), 1, 0)
_takip = pd.Series(_takip, index=_d.index, name='TAKIP_6M')

# --- Genel: renk -> takip (tüm dönemler birlikte) ---
_renk_all = _d['RENK'].fillna('(bos)')
ct = pd.crosstab(_renk_all, _takip, margins=True, margins_name='TOPLAM')
print("--- GENEL | RENK -> TAKIP_6M (ADET) ---")
print(ct.to_string())
if YUZDE_GOSTER:
    pct = (pd.crosstab(_renk_all, _takip, normalize='index') * 100).round(2)
    print("\n--- GENEL | RENK -> TAKIP_6M (SATIR %) ---")
    print(pct.to_string())

# --- Dönem bazında ---
for _don in sorted(_d['DONEM'].dropna().astype(int).unique()):
    _m = _d['DONEM'] == _don
    _renk = _d.loc[_m, 'RENK'].fillna('(bos)')
    _snk = _takip[_m]
    print("=" * 110)
    print(f"DONEM {_don}  (satır: {int(_m.sum()):,}"
          + (", sadece KK" if SADECE_KK else ", tüm portföy") + ")")
    ct = pd.crosstab(_renk, _snk, margins=True, margins_name='TOPLAM')
    print(f"\n--- {_don} | RENK -> TAKIP_6M  (ADET) ---")
    print(ct.to_string())
    if YUZDE_GOSTER:
        pct = (pd.crosstab(_renk, _snk, normalize='index') * 100).round(2)
        print(f"--- {_don} | RENK -> TAKIP_6M  (SATIR %) ---")
        print(pct.to_string())
