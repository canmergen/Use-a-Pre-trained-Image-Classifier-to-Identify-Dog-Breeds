def guncel_harita():
    """Base compact + registry'deki feature'lar → prompta gömülecek kompakt JSON."""
    harita = dict(base_compact)  # sığ kopya yeterli, base'i değiştirmiyoruz
    if registry:
        harita["uretilen_featurelar"] = {
            k["ad"]: {"gerekce": k["gerekce"], "formul": k["formul"]}
            for k in registry
        }
    return json.dumps(harita, ensure_ascii=False, separators=(",", ":"))

def tekrar_yasak_listesi():
    satirlar  = [f"- {k['ad']}: {k['gerekce']}" for k in registry]
    satirlar += [f"- (REDDEDİLDİ — {r.get('neden','')}) {r.get('ad_soneki','?')}: {r.get('gerekce','')}"
                 for r in red_registry]
    return "\n".join(satirlar) if satirlar else "(henüz yok)"

