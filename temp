with kaynak as (
  select
    PERSONEL_FLAG, VIP_FLAG, YAS_FLAG, FRAUD_FLAG, DOLANDIRICILIK_FLAG,
    case when PERSONEL_FLAG = 1 and DOLANDIRICILIK_FLAG = 0 and FRAUD_FLAG = 0
          and VIP_FLAG = 1 and YAS_FLAG = 1
         then 0 else 1 end as EXCL_DS_FLG,
    case when PERSONEL_FLAG = 1 and DOLANDIRICILIK_FLAG = 0 and FRAUD_FLAG = 0
          and VIP_FLAG = 1 and YAS_FLAG = 1
         then KALIBRE_SKOR_SN_YIL_YENI else null end as DAV_SKOR
  from PSKR.SKR_TBRY_MST_DAVR_SKOR_FNL_SAS
  where TARIH >= LAST_DAY(TO_DATE('2024-01','YYYY-MM'))
    and TARIH <= LAST_DAY(TO_DATE('2025-11','YYYY-MM'))
)
select
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) = 0  then 'KOMBINASYON'
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) = 63 then 'GENEL_TOPLAM'
    else 'TEKLI'
  end as SATIR_TIPI,
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) in (0, 63) then null
    when grouping(PERSONEL_FLAG)       = 0 then 'PERSONEL_FLAG'
    when grouping(VIP_FLAG)            = 0 then 'VIP_FLAG'
    when grouping(YAS_FLAG)            = 0 then 'YAS_FLAG'
    when grouping(FRAUD_FLAG)          = 0 then 'FRAUD_FLAG'
    when grouping(DOLANDIRICILIK_FLAG) = 0 then 'DOLANDIRICILIK_FLAG'
    when grouping(EXCL_DS_FLG)         = 0 then 'EXCL_DS_FLG'
  end as FLAG_ADI,
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) not in (0, 63)
    then cast(coalesce(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                       FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) as number(1))
  end as FLAG_DEGERI,
  PERSONEL_FLAG,
  VIP_FLAG,
  YAS_FLAG,
  FRAUD_FLAG,
  DOLANDIRICILIK_FLAG,
  EXCL_DS_FLG,
  to_char(count(*), 'FM999,999,999,999') as ADET,
  to_char(count(DAV_SKOR), 'FM999,999,999,999') as DAV_SKOR_DOLU,
  round(count(DAV_SKOR) * 100 / count(*), 2) as DAV_SKOR_DOLULUK_PCT,
  round(count(*) * 100 /
        max(case when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                                  FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG) = 63
                 then count(*) end) over (), 2) as PAY_PCT
from kaynak
group by grouping sets (
  (PERSONEL_FLAG, VIP_FLAG, YAS_FLAG, FRAUD_FLAG, DOLANDIRICILIK_FLAG, EXCL_DS_FLG),
  (PERSONEL_FLAG),
  (VIP_FLAG),
  (YAS_FLAG),
  (FRAUD_FLAG),
  (DOLANDIRICILIK_FLAG),
  (EXCL_DS_FLG),
  ()
)
order by SATIR_TIPI, FLAG_ADI, FLAG_DEGERI
