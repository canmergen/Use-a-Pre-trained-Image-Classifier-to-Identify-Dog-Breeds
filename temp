MODEL_RENKLER = [1, 2, 3, 4, 5, 6]

LIMIT_COL = 'KK_LIMIT'      # limit kolonu (ham veride)
RISK_COL  = 'KK_RISK'       # risk kolonu

# Bucket başına EN AZ bu kadar batan olsun; altına düşerse bucket sayısı
# otomatik iner. 0 = KAPALI, her renk hep istenen bucket sayısını kullanır.
MIN_BAD_PER_BUCKET = 0
MIN_BUCKET          = 5        # adaptif açıkken bundan aşağı inmiyoruz

VAL_ORAN    = 0.20

# Thread sayısı cgroup CPU kotasına göre; kotayı aşmak CFS throttling'e
# yol açıyor. 48 tavanı: LightGBM ~32-48 thread'den sonra doyuma ulaşıyor.
def _cpu_kotasi(tavan=48):
    _q = None
    try:                                                    # cgroup v2
        _v = open('/sys/fs/cgroup/cpu.max').read().split()
        if _v[0] != 'max':
            _q = int(_v[0]) / int(_v[1])
    except Exception:
        try:                                                # cgroup v1
            _qq = int(open('/sys/fs/cgroup/cpu/cpu.cfs_quota_us').read())
            _pp = int(open('/sys/fs/cgroup/cpu/cpu.cfs_period_us').read())
            if _qq > 0:
                _q = _qq / _pp
        except Exception:
            pass
    _n = int(_q) if _q else (os.cpu_count() or 8)
    return max(1, min(_n, tavan))

LGB_JOBS = _cpu_kotasi()
print(f"[HIZ] cgroup kotası={_cpu_kotasi(10**9)} → LGB n_jobs={LGB_JOBS}")

CAPTURE_PCT = 0.10

def _excel_yaz(fname, df_out, sheet_name='Sheet1'):
    """DataFrame'i Excel olarak PATH alt klasörüne yazar."""
    hedef = PATH + "/" + fname.lstrip("/")
    buf = BytesIO()
    with pd.ExcelWriter(buf, engine='openpyxl') as xl:
        df_out.to_excel(xl, sheet_name=sheet_name[:31], index=False)
    buf.seek(0)
    mf.upload_stream(hedef, buf)


def _best_params_oku(RENK_KOD, renk_adi):
    t = _oku(f"renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv")
    if 'is_best' in t.columns and (t['is_best'] == 1).any():
        row = t[t['is_best'] == 1].iloc[0]
    elif 'kural_ok' in t.columns and (t['kural_ok'] == 1).any():
        _s = 'capture_val' if 'capture_val' in t.columns else 'val_gini'
        row = t[t['kural_ok'] == 1].sort_values(_s, ascending=False).iloc[0]
    else:
        row = t.sort_values('objective', ascending=False).iloc[0]
    _kolon = 'params_json' if 'params_json' in t.columns else 'params'
    p = json.loads(row[_kolon])
    p.setdefault('subsample_freq', 1)
    return p


def _features_oku(RENK_KOD, renk_adi):
    """Feature listesini MODELİN GÖRDÜĞÜ KOLON SIRASIYLA döndürür
    (colsample_bytree kolon sırasına duyarlı)."""
    f = _oku(f"renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv")
    if 'sira' in f.columns:
        f = f.sort_values('sira')
    else:
        print("    ⚠ 'sira' kolonu yok (eski CSV) → feature sırası ana "
              "pipeline ile aynı olmayabilir, model farklı çıkabilir.")
    return f['feature'].tolist()


def _bol(train_full, RENK_KOD, renk_adi):
    """train / val bölmesini ANA PIPELINE'DAN TAŞIR (yeniden üretmez)."""
    try:
        _vi = set(_oku(f"renk_{RENK_KOD}_{renk_adi}_val_index.csv")['idx'])
        _m  = train_full.index.isin(_vi)
        if _m.sum() == 0:
            raise ValueError("val indeksi bu train_full ile eşleşmedi")
        return (train_full.loc[~_m].sort_index(),
                train_full.loc[_m].sort_index(), "dosya")
    except Exception as e:
        print(f"    ⚠ val indeksi okunamadı ({e}) → seed ile yeniden üretiliyor. "
              f"Bölmenin ana pipeline ile aynı olduğu GARANTİ DEĞİL.")
        tr, vl = train_test_split(train_full, test_size=VAL_ORAN,
                                   stratify=train_full[TARGET], shuffle=True,
                                   random_state=RANDOM_STATE)
        return tr.sort_index(), vl.sort_index(), "seed"


def _nb_sec(kumeler, n_bucket):
    """Üç küme için ORTAK bucket sayısı (kümeler arası karşılaştırılabilirlik)."""
    if MIN_BAD_PER_BUCKET <= 0:
        return int(n_bucket)
    _min_bad = min(int(np.asarray(y).sum()) for _, y, _, _ in kumeler
                   if len(y) and pd.Series(y).nunique() >= 2)
    return int(min(n_bucket, max(MIN_BUCKET, _min_bad // MIN_BAD_PER_BUCKET)))


def _bucket_tablosu(y, prob, index, etiket, kume_adi, n_bucket):
    """Tek bir küme (TRAIN/VAL/OOT) için bucket tablosu üretir."""
    y = np.asarray(y); prob = np.asarray(prob)

    _lim = df.loc[index, LIMIT_COL].to_numpy(dtype="float64") \
        if LIMIT_COL in df.columns else np.full(len(index), np.nan)
    _rsk = df.loc[index, RISK_COL].to_numpy(dtype="float64") \
        if RISK_COL in df.columns else np.full(len(index), np.nan)

    d = pd.DataFrame({'y': y, 'score': prob, 'limit': _lim, 'risk': _rsk})
    n     = len(d)
    n_bad = int(d['y'].sum())
    _nb   = n_bucket

    # Ranklar 1..n; bucket kenarları analitik. (1 = en riskli / en yüksek skor)
    order = np.argsort(d['score'].to_numpy(), kind="stable")
    r     = np.empty(n, dtype="float64")
    r[order] = np.arange(1, n + 1, dtype="float64")
    edges = 1.0 + np.arange(_nb + 1) * (n - 1) / _nb
    d['bucket'] = _nb - np.searchsorted(edges[1:-1], r, side="left")

    d['limit_bad'] = d['limit'] * d['y']
    d['risk_bad']  = d['risk']  * d['y']

    g = (d.groupby('bucket')
            .agg(n=('y', 'size'), bad=('y', 'sum'),
                 min_score=('score', 'min'), avg_score=('score', 'mean'),
                 max_score=('score', 'max'),
                 limit_sum=('limit', 'sum'), risk_sum=('risk', 'sum'),
                 limit_sum_bad=('limit_bad', 'sum'), risk_sum_bad=('risk_bad', 'sum'))
            .reset_index().sort_values('bucket'))

    g['bad_rate'] = g['bad'] / g['n']
    g['dr_risk']  = g['risk_sum_bad'] / g['risk_sum']

    # lift tavanı = min(1/base_rate, _nb); tavan_pct = lift / tavan
    _base = float(np.mean(y))
    g['lift'] = g['bad_rate'] / _base if _base > 0 else np.nan
    _tavan = min(1.0 / _base, _nb) if _base > 0 else np.nan
    g['lift_tavan_pct'] = g['lift'] / _tavan if np.isfinite(_tavan) else np.nan

    _tot_bad        = g['bad'].sum()
    g['cum_bad']    = g['bad'].cumsum()
    g['capture']    = g['cum_bad'] / _tot_bad if _tot_bad > 0 else np.nan
    g['cum_n_pct']  = g['n'].cumsum() / n

    for c in ['min_score', 'avg_score', 'max_score', 'bad_rate', 'dr_risk',
              'lift', 'lift_tavan_pct', 'capture', 'cum_n_pct']:
        g[c] = g[c].round(4)
    for c in ['limit_sum', 'risk_sum', 'limit_sum_bad', 'risk_sum_bad']:
        g[c] = g[c].round(0)

    _cap_tavan = min(1.0, CAPTURE_PCT / _base) if _base > 0 else np.nan

    g.insert(0, 'renk', etiket)
    g.insert(1, 'kume', kume_adi)
    g.insert(2, 'base_rate', round(_base, 4))
    g.insert(3, 'lift_tavan', round(_tavan, 2) if np.isfinite(_tavan) else None)
    g.insert(4, 'n_bucket', _nb)

    # monotonluk: bad_rate'in düştüğü komşu çift oranı (1.00 ideal)
    _mono = float((np.diff(g['bad_rate'].to_numpy()) < 0).mean()) if len(g) > 1 else np.nan

    # capture@pct skordan hesaplanıyor → bucket sayısından bağımsız
    _k     = max(1, int(CAPTURE_PCT * n))
    _top   = np.argpartition(-prob, min(_k, n - 1))[:_k] if n > 1 else np.array([0])
    cap10  = float(y[_top].sum() / n_bad) if n_bad > 0 else np.nan
    _capN  = int(CAPTURE_PCT * 100)
    ozet = {'renk': etiket, 'kume': kume_adi, 'n': n, 'bad': n_bad,
            'base_rate': round(_base, 4),
            'lift_tavan': round(_tavan, 2) if np.isfinite(_tavan) else None,
            'lift1': g['lift'].iloc[0],
            'lift1_tavan_pct': g['lift_tavan_pct'].iloc[0],
            f'capture{_capN}': round(cap10, 4) if pd.notna(cap10) else None,
            f'capture{_capN}_tavan': round(_cap_tavan, 4) if np.isfinite(_cap_tavan) else None,
            f'capture{_capN}_tavan_pct': (round(cap10 / _cap_tavan, 4)
                                           if pd.notna(cap10) and np.isfinite(_cap_tavan)
                                           and _cap_tavan > 0 else None),
            'monoton_pct': round(_mono, 4) if np.isfinite(_mono) else None,
            'n_bucket': _nb}
    return g, ozet


def renk_bazli_bucket_raporu(n_bucket_deger):
    """Tüm renkler için TRAIN/VAL/OOT bucket raporunu üretir ve Excel'e yazar."""
    bucket_tablolari, karsilastirma = {}, []

    for RENK_KOD in MODEL_RENKLER:
        renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
        etiket   = f"{RENK_KOD}-{renk_adi}"
        print(f"\n=== {etiket} (N_BUCKET={n_bucket_deger}) ===")

        # 1) Skorlar - önce skorlama bloğunun ürettiğini dene
        _s = secilen_modeller.get(RENK_KOD, {}) if 'secilen_modeller' in globals() else {}
        _gerekli = ('train_prob', 'train_index', 'y_train',
                    'val_prob', 'val_index', 'y_val',
                    'oot_prob', 'oot_index', 'y_oot')
        if all(k in _s for k in _gerekli):
            print("  ▶ 1) Skorlar skorlama bloğundan alınıyor (yeniden hesap YOK)...")
            kumeler = [
                ('TRAIN', np.asarray(_s['y_train']), np.asarray(_s['train_prob']), _s['train_index']),
                ('VAL',   np.asarray(_s['y_val']),   np.asarray(_s['val_prob']),   _s['val_index']),
                ('OOT',   np.asarray(_s['y_oot']),   np.asarray(_s['oot_prob']),   _s['oot_index']),
            ]
            print(f"  ✓ Hazır skor alındı (train={len(kumeler[0][1]):,} "
                  f"val={len(kumeler[1][1]):,} oot={len(kumeler[2][1]):,})")
        else:
            print("  ▶ 1) Hazır skor yok - model yeniden eğitiliyor...")
            mask = ((df['KK_URUN_FLG'] == 'KK') & (df['RENK'] == RENK_KOD) &
                    (df['DONEM'].isin([TRAIN_DONEM, OOT_DONEM])))
            df_r = df.loc[mask].copy()
            if df_r.empty or (df_r['DONEM'] == TRAIN_DONEM).sum() == 0:
                print("  veri yok, atlandı"); continue

            df_eng_r, _ = feature_engineering(df_r)
            try:
                FEATURES    = _features_oku(RENK_KOD, renk_adi)
                best_params = _best_params_oku(RENK_KOD, renk_adi)
            except Exception as e:
                print(f"  CSV okunamadı ({e}), atlandı"); continue
            FEATURES = [c for c in FEATURES if c in df_eng_r.columns]

            train_full = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == TRAIN_DONEM, FEATURES + [TARGET]])
            oot        = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == OOT_DONEM,   FEATURES + [TARGET]])
            for c in CAT_COLS:
                if c in train_full.columns and str(train_full[c].dtype) == 'category':
                    oot[c] = pd.Categorical(oot[c], categories=train_full[c].cat.categories)
            if train_full[TARGET].nunique() < 2:
                print("  train tek sınıf, atlandı"); continue

            train, val, _kaynak = _bol(train_full, RENK_KOD, renk_adi)
            X_tr, y_tr = train[FEATURES], train[TARGET]
            if y_tr.nunique() < 2:
                print("  train tek sınıf, atlandı"); continue
            print(f"    train {len(X_tr)} / val {len(val)} (val eğitime GİRMİYOR, "
                  f"bölme kaynağı: {_kaynak})")

            spw   = (len(y_tr) - y_tr.sum()) / max(y_tr.sum(), 1)
            model = lgb.LGBMClassifier(objective='binary', metric='auc',
                                        scale_pos_weight=spw, random_state=RANDOM_STATE,
                                        n_jobs=LGB_JOBS, verbose=-1).set_params(**best_params)
            model.fit(X_tr, y_tr)
            kumeler = [
                ('TRAIN', y_tr.to_numpy(),        model.predict_proba(X_tr)[:, 1],          train.index),
                ('VAL',   val[TARGET].to_numpy(), model.predict_proba(val[FEATURES])[:, 1], val.index),
                ('OOT',   oot[TARGET].to_numpy(), model.predict_proba(oot[FEATURES])[:, 1], oot.index),
            ]
            print("  ✓ Model eğitildi ve üç küme skorlandı")

        # 2) Her küme için bucket tablosu
        try:
            _nb_ortak = _nb_sec(kumeler, n_bucket_deger)
        except (ValueError, ZeroDivisionError) as e:
            print(f"  bucket sayısı belirlenemedi ({e}), atlandı"); continue
        if _nb_ortak != n_bucket_deger:
            print(f"  ▶ 2) batan sayısı düşük → {n_bucket_deger} yerine {_nb_ortak} bucket "
                  f"(üç kümede de aynı, karşılaştırılabilir kalsın diye)")
        print(f"  ▶ 2) {_nb_ortak} bucket'a bölünüyor (TRAIN / VAL / OOT)...")
        parcalar = []
        for kume_adi, y_k, p_k, idx_k in kumeler:
            if len(y_k) == 0 or pd.Series(y_k).nunique() < 2:
                print(f"    {kume_adi}: tek sınıf / boş, atlandı"); continue
            g, ozet = _bucket_tablosu(y_k, p_k, idx_k, etiket, kume_adi, _nb_ortak)
            parcalar.append(g)
            karsilastirma.append(ozet)
            _cN = int(CAPTURE_PCT * 100)
            _f = lambda v, f="{:.2f}": (f.format(v) if v is not None and pd.notna(v) else "NA")
            _p = lambda v: (f"{v:.0%}" if v is not None and pd.notna(v) else "NA")
            print(f"    {kume_adi:<5} base={ozet['base_rate']:.4f} "
                  f"lift_tavan={_f(ozet['lift_tavan'])} | lift1={_f(ozet['lift1'])} "
                  f"({_p(ozet['lift1_tavan_pct'])} tavan) | "
                  f"cap{_cN}={_f(ozet[f'capture{_cN}'], '{:.4f}')} / "
                  f"{_f(ozet[f'capture{_cN}_tavan'], '{:.4f}')} "
                  f"({_p(ozet[f'capture{_cN}_tavan_pct'])} tavan) | "
                  f"monoton={_p(ozet['monoton_pct'])} | nb={ozet['n_bucket']}")

        if not parcalar:
            print("  hiç küme üretilemedi, atlandı"); continue
        g_all = pd.concat(parcalar, ignore_index=True)
        bucket_tablolari[RENK_KOD] = g_all

        # 3) Bu rengin tablosunu Excel'e yaz (tek sheet, kume kolonu ile)
        _excel_yaz(f"renk_{RENK_KOD}_{renk_adi}_bucket{n_bucket_deger}_train_val_oot.xlsx",
                   g_all, sheet_name=renk_adi)
        print(f"  ✓ {etiket} tamamlandı (excel yazıldı)")

    # Tüm renkler tek Excel: her renk ayrı sheet + TUM + KARSILASTIRMA
    print("\n▶ Tüm renkler tek Excel'e birleştiriliyor...")
    if bucket_tablolari:
        kars = pd.DataFrame(karsilastirma)
        print("\n===== KÜME KARŞILAŞTIRMA (teşhis tablosu) =====")
        print(kars.to_string(index=False))
        print("\n  Okuma kılavuzu:")
        print("    TRAIN de kötü          → model o bölgede sinyal bulamamış (kapasite/feature)")
        print("    TRAIN iyi, VAL kötü    → aşırı öğrenme")
        print("    TRAIN+VAL iyi, OOT kötü→ zamansal bozulma (popülasyon kayması)")
        print("    lift1_tavan_pct        → renkler arası TEK karşılaştırılabilir lift ölçüsü")
        print("      tavan = min(1/base_rate, n_bucket) - bucket sayısını GEÇEMEZ")
        print("    capture tavanı = min(1, pct/base_rate)")
        print("    monoton_pct < 1.00     → bucket sıralaması bozuk, iş tarafında güven kaybı")

        fname = f"renk_bazli_TUM_bucket{n_bucket_deger}_train_val_oot.xlsx"
        buf = BytesIO()
        with pd.ExcelWriter(buf, engine='openpyxl') as xl:
            kars.to_excel(xl, sheet_name='KARSILASTIRMA', index=False)
            for RENK_KOD, g in bucket_tablolari.items():
                renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
                g.to_excel(xl, sheet_name=f"{RENK_KOD}_{renk_adi}"[:31], index=False)
            pd.concat(bucket_tablolari.values(), ignore_index=True) \
                .to_excel(xl, sheet_name='TUM', index=False)
        buf.seek(0)
        mf.upload_stream(PATH + "/" + fname, buf)

        print(f"\n✓ {PATH}/{fname} yazıldı "
              f"(KARSILASTIRMA + her renk ayrı sheet + TUM)")
    else:
        print("⚠ Hiç bucket tablosu üretilemedi")

    return bucket_tablolari, karsilastirma


# Tek run'da hem 20'lik hem 100'lük çıktılar üretilir
BUCKET_DEGERLERI = [20, 100]
for _n in BUCKET_DEGERLERI:
    print(f"\n{'='*70}\n N_BUCKET = {_n} ÇALIŞTIRILIYOR\n{'='*70}")
    renk_bazli_bucket_raporu(_n)
