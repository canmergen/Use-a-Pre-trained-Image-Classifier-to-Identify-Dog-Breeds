    # 4b) HEDEF İLİŞKİSİ — sayısal: |Spearman|, kategorik: Cramér's V
    print("  ▶ 4b) Hedef ilişkisi hesaplanıyor (Spearman / Cramér's V)...")
    num   = train[FEATURES].select_dtypes(include=np.number)
    _cols = np.asarray(num.columns)

    # Rank matrisi TEK kez: hem feature-feature Spearman hem hedef-Spearman
    # buradan çıkıyor (standartlaştırılmış rank'lerin iç çarpımı = Spearman).
    _R  = num.rank().to_numpy(dtype="float64")
    _R  = (_R - _R.mean(0)) / np.maximum(_R.std(0), 1e-9)
    _R  = np.nan_to_num(_R)
    _yr = y.rank().to_numpy(dtype="float64")
    _yr = (_yr - _yr.mean()) / max(_yr.std(), 1e-9)

    tgt_assoc = dict(zip(_cols, np.abs(_R.T @ _yr / len(_yr))))
    for c in FEATURES:                                   # kategorikler
        if c not in tgt_assoc:
            tgt_assoc[c] = _cramers_v(train[c], y)

    iv_scores = {c: _quick_iv(train[c], y) for c in FEATURES}   # rapor
