import re
import dataiku

# --- Kaynak: hipotezlerin okunacağı folder (değişmiyor) ---
SOURCE_FOLDER = "LLM_BIREYSEL"
src = dataiku.Folder(SOURCE_FOLDER)

# --- Hedef: çıktının yazılacağı folder (önceki config ile aynı mantık) ---
# main_folder, mf, FOLDER, PATH önceki hücrede tanımlıydı; burada tekrar
# kullanıyorum, DEĞİŞTİRMİYORUM.
out_folder = mf          # dataiku.Folder(main_folder) -> önceki hücreden geliyor
OUT_PATH   = PATH        # "/" + FOLDER  -> önceki hücreden geliyor

def tum_yollar(folder):
    """Folder icindeki tum dosya yollarini recursive olarak doner."""
    try:
        yollar = folder.list_paths_in_partition()
        if yollar:
            return yollar
    except Exception:
        pass

    bulunan = []

    def _gez(p):
        try:
            det = folder.get_path_details(path=p)
        except Exception:
            return
        for c in det.get("children", []):
            tam = c.get("fullPath")
            if not tam:
                continue
            if c.get("directory"):
                _gez(tam)
            else:
                bulunan.append(tam)

    _gez("/")
    return bulunan

def oku(folder, path):
    with folder.get_download_stream(path) as f:
        return f.read().decode("utf-8", errors="ignore")

def feature_bolumunu_cek(md_text):
    """## Onerilen Feature basligindan bir sonraki ## basligina (veya dosya sonuna) kadar olan kismi doner."""
    pattern = r"##\s*Önerilen Feature\s*\n(.*?)(?=\n##\s|\Z)"
    match = re.search(pattern, md_text, flags=re.DOTALL)
    if match:
        return match.group(1).strip()
    return None

# --- 1) Kaynaktan (LLM_BIREYSEL) hipotez dosyalarini oku ---
tum_yollar_listesi = tum_yollar(src)

hipotez_dosyalari = [
    p for p in tum_yollar_listesi
    if "/hypotheses/" in p and re.search(r"/H\d+\.md$", p, flags=re.IGNORECASE)
]

sonuclar = []
for path in sorted(hipotez_dosyalari):
    parcalar = path.strip("/").split("/")
    grup = parcalar[0]
    dosya_adi = parcalar[-1]

    icerik = oku(src, path)
    feature_kismi = feature_bolumunu_cek(icerik)

    sonuclar.append({
        "grup": grup,
        "dosya": dosya_adi,
        "feature": feature_kismi
    })

# Ekranda görmek icin
for s in sonuclar:
    print(f"\n{'='*80}\n[{s['grup']}] {s['dosya']}\n{'='*80}")
    print(s["feature"] if s["feature"] else "(Önerilen Feature bölümü bulunamadı)")

# --- 2) Hedefe (main_folder/PATH altina) tek bir toplu dosya olarak yaz ---
cikti_metni = []
for s in sonuclar:
    cikti_metni.append(f"## [{s['grup']}] {s['dosya']}\n")
    cikti_metni.append(s["feature"] if s["feature"] else "(Önerilen Feature bölümü bulunamadı)")
    cikti_metni.append("\n")

cikti_str = "\n".join(cikti_metni)

hedef_dosya_yolu = OUT_PATH.rstrip("/") + "/onerilen_features_toplu.md"
out_folder.upload_data(hedef_dosya_yolu, cikti_str.encode("utf-8"))

print("\nYazildi:", hedef_dosya_yolu)
