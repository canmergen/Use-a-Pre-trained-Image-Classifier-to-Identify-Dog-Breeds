# Oran (gelen / giden), son 3 gün
df["H09_RATIO_3D"] = df["TXN_GLN_3D_AMT"] / (df["TXN_GDN_3D_AMT"] + 1)

# Aynı oran, önceki blok (3-6 gün)
df["H09_RATIO_3D_6D"] = df["TXN_GLN_3D_6D_AMT"] / (df["TXN_GDN_3D_6D_AMT"] + 1)

# Oranın önceki bloğa göre değişimi (hipotezin sorduğu "%10 azalma")
df["H09_RATIO_TREND"] = (df["H09_RATIO_3D"] - df["H09_RATIO_3D_6D"]) / (df["H09_RATIO_3D_6D"] + 1e-6)

