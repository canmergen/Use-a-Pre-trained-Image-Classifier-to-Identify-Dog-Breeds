    # 4c) Yüksek korelasyon — çiftte hedefi DAHA İYİ AÇIKLAYAN tutulur
    print(f"  ▶ 4c) Korelasyon elemesi başladı (Spearman |r|>{CORR_ESIK})...")
    _C   = np.abs(_R.T @ _R / len(_R))
    _pos = {c: i for i, c in enumerate(_cols)}

    _kept, drop_corr = [], set()
    for c in sorted(_cols, key=lambda k: -tgt_assoc.get(k, 0.0)):
        i = _pos[c]
        if _kept and (_C[i, _kept] > CORR_ESIK).any():
            drop_corr.add(c)
        else:
            _kept.append(i)

    drop_corr = [c for c in FEATURES if c in drop_corr]
    FEATURES  = [c for c in FEATURES if c not in drop_corr]
