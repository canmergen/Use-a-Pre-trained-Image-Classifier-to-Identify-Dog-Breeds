    "TOP1": ["en çok"], "TOTAL": ["toplam"], "DISTINCT": ["farklı"],
    "EFFECTIVE": ["etkin"], "CP": ["karşı taraf"],
    "HHI": ["hhi", "yoğunlaş"], "ENTROPY": ["entropi"],
    "SUM": ["tutar"], "RAW": ["ham"], "SHRUNK": ["düzeltilmiş", "shrink"],
