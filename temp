#      (threshold'suz tanım — PRED'e bağlı değil)
#   E) HÜKÜM: hedef × segment bazında T1 fark / T2 kaçan testleri
#   F) TREND: mevcut skorların GINI'si tüm dönemlerde
#   ⚠ MODEL KIYASI SADECE TRAIN (202504); OOT gelince doğrulanmalı.
#   ⚠ GENEL satırında 6 renk modelinin skorları TEK HAVUZDA birleşir;
#     her model kendi segmentinde kalibre olduğundan bu kıyas MODELE
#     KARŞI taraflıdır — karar RENK satırlarından okunmalıdır.
#      Excel → MODEL_RESULTS kökünde (4 klasörün yanına) yazılır.
# ============================================================

# --- 0) Config bayrağı (config hücresinde tanımlı; yoksa kapalı say) ---
try:
    MODEL_GEREKLILIK_ANALIZI
except NameError:
    MODEL_GEREKLILIK_ANALIZI = False

# --- 1) Klasör kontrolü ---------------------------------------------
GEREKLI_KLASORLER = [
    "/3M_KIRMIZI_RENGE_GOC",
    "/6M_KIRMIZI_RENGE_GOC",
    "/12M_KIRMIZI_RENGE_GOC",
