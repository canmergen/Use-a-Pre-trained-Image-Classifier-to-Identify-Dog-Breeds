# ÖNCESİ / SONRASI KARŞILAŞTIRMA - Raw-only vs +H01-H06
# =========================================================

karsilastirma = pd.DataFrame({
    "öncesi (raw-only)": {
        "n_feature":   raw_ozet["n_feature"],
        "train_gini":  raw_ozet["train_gini"],
        "val_gini":    raw_ozet["val_gini"],
        "oot_gini":    raw_ozet["oot_gini"],
        "threshold":   raw_ozet["threshold"],
        "best_trial":  raw_ozet["best_trial"],
    },
    "sonrası (+H01-H06)": {
        "n_feature":   ozet["n_feature"],
        "train_gini":  ozet["train_gini"],
        "val_gini":    ozet["val_gini"],
        "oot_gini":    ozet["oot_gini"],
        "threshold":   ozet["threshold"],
        "best_trial":  ozet["best_trial"],
    },
})

karsilastirma["fark"] = (karsilastirma["sonrası (+H01-H06)"] - karsilastirma["öncesi (raw-only)"]).round(4)
karsilastirma["fark_%"] = ((karsilastirma["sonrası (+H01-H06)"] / karsilastirma["öncesi (raw-only)"] - 1) * 100).round(2)

print("--- Önceki / Sonraki Karşılaştırma ---")
display(karsilastirma)

# --- Train-val gap yorumu (overfit sinyali kontrolü) ---
gap_once = raw_ozet["train_gini"] - raw_ozet["val_gini"]
gap_sonra = ozet["train_gini"] - ozet["val_gini"]
print(f"\ntrain-val gap  -> öncesi: {gap_once:.4f}  |  sonrası: {gap_sonra:.4f}  "
      f"(fark: {gap_sonra - gap_once:+.4f})")

_yaz("karsilastirma_oncesi_sonrasi.csv", karsilastirma.reset_index().rename(columns={"index": "metrik"}))
print("\n✓ Karşılaştırma dosyaya yazıldı: karsilastirma_oncesi_sonrasi.csv")



# =========================================================
# FEATURE IMPORTANCE - yeni eklenen H01-H06 feature'larına
# özel karşılaştırma (LightGBM'in kendi importance'ı + rank)
# =========================================================

_yeni_kolonlar = [
    "GLN_TIME_HHI_90D", "GLN_TIME_HHI_90D_AKTIF_FLAG",
    "GDN_TREND_90D", "GLN_TREND_90D", "TREND_INTERACTION",
    "GLN_ODEME_DOMINANT_FLAG",
    "BNK_CONTRACTION",
    "GDN_7D_SHR_90D", "GDN_7D_CONCENTRATION_HIGH",
    "BAHIS_DEVAM_FLAG", "BAHIS_DEVAM_RATIO",
]

# --- 1) Modelin tüm feature importance'larını al ---
imp_df = pd.DataFrame({
    "feature": best.feature_name_,
    "importance_gain": best.booster_.feature_importance(importance_type="gain"),
    "importance_split": best.booster_.feature_importance(importance_type="split"),
}).sort_values("importance_gain", ascending=False).reset_index(drop=True)

# Rank kolonu ekle (1 = en önemli feature)
imp_df["rank"] = imp_df.index + 1
imp_df["gain_pct"] = (imp_df["importance_gain"] / imp_df["importance_gain"].sum() * 100).round(2)

print(f"✓ Toplam feature sayısı (final listede): {len(imp_df)}")
print(f"✓ Yeni eklenen H01-H06 feature'larından finalde kalan: "
      f"{imp_df['feature'].isin(_yeni_kolonlar).sum()} / {len(_yeni_kolonlar)}")

# --- 2) Sadece yeni feature'ları filtrele, rank sırasına göre göster ---
yeni_imp = imp_df[imp_df["feature"].isin(_yeni_kolonlar)].sort_values("rank")

print("\n--- Yeni (H01-H06) feature'ların importance'ı ---")
display(yeni_imp[["rank", "feature", "importance_gain", "gain_pct", "importance_split"]])

# --- 3) Finalde hiç kalmayan (elenmiş) yeni feature'lar var mı? ---
elenen_yeniler = [c for c in _yeni_kolonlar if c not in imp_df["feature"].values]
if elenen_yeniler:
    print(f"\n⚠ Şu yeni feature'lar eleme adımlarında (sabit/korelasyon/PSI) elendi, "
          f"finalde YOK: {elenen_yeniler}")
else:
    print("\n✓ Yeni feature'ların hepsi final modele girdi, eleme adımlarında hiçbiri düşmedi.")

# --- 4) Tüm feature'lar içinde top 20 - yenileri işaretlenmiş olarak görmek için ---
imp_df["yeni_mi"] = imp_df["feature"].isin(_yeni_kolonlar)
print("\n--- Genel top 20 (yeni feature'lar işaretli) ---")
display(imp_df.head(20)[["rank", "feature", "importance_gain", "gain_pct", "yeni_mi"]])

_yaz("feature_importance_full.csv", imp_df)
print("\n✓ Tam importance listesi dosyaya yazıldı: feature_importance_full.csv")
