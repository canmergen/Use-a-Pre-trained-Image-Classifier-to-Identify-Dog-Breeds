def old_family_of(col: str) -> str:
    """Eski notebook'un _family_of'u: aylık temporal suffix arar,
    bulamazsa kolonu ilk 2 parçadan kaba bir aileye atar (asla 'eşleşmedi' demez)."""
    for suffix in ("_L1M", "_L3M", "_L6M", "_L12M", "_L24M"):
        if col.endswith(suffix):
            return col.split("_")[0] + "_* (temporal)"
    parts = col.split("_")
    return "_".join(parts[:2]) + "_*" if len(parts) >= 2 else col

