select
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG) = 0  then 'KOMBINASYON'
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG) = 31 then 'GENEL_TOPLAM'
    else 'TEKLI'
  end as SATIR_TIPI,
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG) in (0, 31) then null
    when grouping(PERSONEL_FLAG)       = 0 then 'PERSONEL_FLAG'
    when grouping(VIP_FLAG)            = 0 then 'VIP_FLAG'
    when grouping(YAS_FLAG)            = 0 then 'YAS_FLAG'
    when grouping(FRAUD_FLAG)          = 0 then 'FRAUD_FLAG'
    when grouping(DOLANDIRICILIK_FLAG) = 0 then 'DOLANDIRICILIK_FLAG'
  end as FLAG_ADI,
  case
    when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                     FRAUD_FLAG, DOLANDIRICILIK_FLAG) not in (0, 31)
    then cast(coalesce(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                       FRAUD_FLAG, DOLANDIRICILIK_FLAG) as number(1))
  end as FLAG_DEGERI,
  PERSONEL_FLAG,
  VIP_FLAG,
  YAS_FLAG,
  FRAUD_FLAG,
  DOLANDIRICILIK_FLAG,
  to_char(count(*), 'FM999,999,999,999') as ADET,
  cast(count(*) as number(38)) as ADET_NUM,
  round(count(*) * 100 /
        max(case when grouping_id(PERSONEL_FLAG, VIP_FLAG, YAS_FLAG,
                                  FRAUD_FLAG, DOLANDIRICILIK_FLAG) = 31
                 then count(*) end) over (), 2) as PAY_PCT
from PSKR.SKR_TBRY_MST_DAVR_SKOR_FNL_SAS
where TARIH >= LAST_DAY(TO_DATE('2024-01','YYYY-MM'))
  and TARIH <= LAST_DAY(TO_DATE('2025-11','YYYY-MM'))
group by grouping sets (
  (PERSONEL_FLAG, VIP_FLAG, YAS_FLAG, FRAUD_FLAG, DOLANDIRICILIK_FLAG),
  (PERSONEL_FLAG),
  (VIP_FLAG),
  (YAS_FLAG),
  (FRAUD_FLAG),
  (DOLANDIRICILIK_FLAG),
  ()
)
order by SATIR_TIPI, FLAG_ADI, FLAG_DEGERI
