# -*- coding: utf-8 -*-
# Dataiku'da basit LLM çağrısı (LLM Mesh)

import dataiku

# 1) LLM'i al  (id'yi kendi ortamına göre değiştir)
project = dataiku.api_client().get_default_project()
llm = project.get_llm("openai:dataiku-qwen36-27b:qwen36-27b")

# 2) Çağrıyı hazırla
comp = llm.new_completion()
comp.with_message("Sen kısa ve net cevap veren bir asistansın.", role="system")
comp.with_message("Python'da liste ile sözlük arasındaki farkı 2 cümlede açıkla.", role="user")
comp.settings["temperature"] = 0.2   # istersen bu satırı sil, varsayılan kullanılır

# 3) Çalıştır ve yazdır
cevap = comp.execute().text
print("--- LLM CEVABI ---")
print(cevap)
