import time
import dataiku
import pyarrow.fs as pafs
import pyarrow.dataset as pads
import psutil

PROJECT = "KKKSSGGSERKANYASARSANDBOX"
DATASET_NAMES = ["HAVALE_EFT_NTT", "HAVALE_EFT_NTT_prepared"]

dfs = {}

for name in DATASET_NAMES:
    t0 = time.time()

    d = dataiku.Dataset(f"{PROJECT}.{name}")
    info = d.get_location_info(sensitive_info=True)["info"]
    cp = info["connectionParams"]
    root = info["path"].replace("s3://", "")

    s3 = pafs.S3FileSystem(
        access_key=cp["accessKey"],
        secret_key=cp["secretKey"],
        endpoint_override="loscdlhp.aknet.akb:9000",
        scheme="https",
        force_virtual_addressing=False,
    )

    dset = pads.dataset(root, filesystem=s3, format="parquet")

    sch = d.read_schema()
    names, dtypes, date_idx = d.get_dataframe_schema_st(sch, int_as_float=True)
    date_cols = {names[i] for i in date_idx} if date_idx else set()

    vm0 = psutil.virtual_memory().used
    tbl = dset.to_table(use_threads=True)
    df = tbl.to_pandas(self_destruct=True, split_blocks=True)

    cast = {c: t for c, t in dtypes.items() if c in df.columns and c not in date_cols}
    df = df.astype(cast)[names]

    elapsed = time.time() - t0
    ram_add = (psutil.virtual_memory().used - vm0) / 1e9
    print(f"[{name}] süre: {int(elapsed//60)}dk {int(elapsed%60)}sn | RAM: +{ram_add:.1f} GB | {df.shape[0]:,} satır x {df.shape[1]} sütun")

    globals()[f"df_{name}"] = df
    dfs[name] = df

df_HAVALE_EFT_NTT = dfs["HAVALE_EFT_NTT"]
df_HAVALE_EFT_NTT_prepared = dfs["HAVALE_EFT_NTT_prepared"]
