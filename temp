import dataiku, zipfile, io

f = dataiku.Folder("GOC_MODEL_RESULTS")   # Dataiku managed folder'a bağlanır

paths = f.list_paths_in_partition()       # folder içindeki tüm dosya yollarını listeler
zip_candidates = [p for p in paths if p.lower().endswith(".zip")]  # sadece .zip olanları süzer

if not zip_candidates:                    # hiç zip yoksa hata fırlatır
    raise Exception("Klasörde .zip dosyası bulunamadı: " + str(paths))

zip_path = zip_candidates[0]              # bulunan İLK zip'i seçer (hangisi olduğunu sen seçemiyorsun)
