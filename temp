# ============================================================
# RENK BAZLI MODELLER — her renk: eleme → split → Optuna → DOSYA (renk renk)
# ============================================================
#
# HIZ AYARI — çıktıyı DEĞİŞTİRMEZ.
# ------------------------------------------------------------
# Sorun: cross_validate(n_jobs=-1) CV_FOLDS fold'u paralel başlatıyordu,
# her fold içindeki LightGBM de n_jobs=-1 ile tüm çekirdekleri istiyordu.
# 16 çekirdekte 5 x 16 = 80 thread → thread'ler birbirini bekliyor (CPU
# boşa dönüyor). Bu tipik olarak 2-3x yavaşlatır.
#
# Çözüm: fold'ları sırayla çalıştır, LightGBM tüm çekirdekleri kullansın.
# LightGBM'in gördüğü thread sayısı ESKİSİYLE AYNI (-1) olduğu için
# üretilen model de birebir aynıdır.
CV_JOBS = 1
#
# NOT: Alternatif olarak fold'ları paralelleştirip LightGBM'i kısabilirsin
# (CV_JOBS=CV_FOLDS, n_jobs=N_CORES//CV_FOLDS). Genelde biraz daha hızlıdır
# AMA LightGBM farklı thread sayısında toplama sırasını değiştirebildiği
# için sonuçlar son hanelerde oynayabilir. Birebir aynılık istiyorsan
# yukarıdaki ayarda kal.

MODEL_RENKLER = [1, 2, 3, 4, 5, 6]   # kırmızı, turuncu, sarı, açık yeşil, yeşil, koyu yeşil
skf = StratifiedKFold(n_splits=CV_FOLDS, shuffle=True, random_state=RANDOM_STATE)
optuna.logging.set_verbosity(optuna.logging.WARNING)

folder = dataiku.Folder(FOLDER)   # ← dosyalar buraya

renk_sonuclari, ozet_satirlari = {}, []

for RENK_KOD in MODEL_RENKLER:
    renk_adi = COLOR_MAP.get(RENK_KOD, str(RENK_KOD))
    etiket   = f"{RENK_KOD}-{renk_adi}"
    print(f"\n=== {etiket} ===")

    # 1) Popülasyon: KK + renk + dönemler
    print("  ▶ 1) Popülasyon filtreleniyor...")
    mask = ((df['KK_URUN_FLG'] == 'KK') &
            (df['RENK'] == RENK_KOD) &
            (df['DONEM'].isin([TRAIN_DONEM, OOT_DONEM])))
    df_r = df.loc[mask].copy()
    if df_r.empty or (df_r['DONEM'] == TRAIN_DONEM).sum() == 0:
        print("  veri yok, atlandı"); continue
    print(f"  ✓ Popülasyon: {df_r.shape[0]} satır")

    # 2) Feature engineering + feature listesi
    print("  ▶ 2) Feature engineering başladı...")
    df_eng_r, eng_cols_r = feature_engineering(df_r)
    FEATURES = [c for c in (RAW_FEATURES + eng_cols_r)
                if c in df_eng_r.columns and c not in LEAK_COLS]
    FEATURES = list(dict.fromkeys(FEATURES))
    print(f"  ✓ Feature engineering bitti ({len(FEATURES)} feature)")

    # 3) Zaman bazlı bölme
    print("  ▶ 3) Zaman bazlı bölme (train / OOT)...")
    train_full = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == TRAIN_DONEM, FEATURES + [TARGET]])
    oot        = preprocess(df_eng_r.loc[df_eng_r['DONEM'] == OOT_DONEM,   FEATURES + [TARGET]])
    for c in CAT_COLS:
        if c in train_full.columns and str(train_full[c].dtype) == 'category':
            oot[c] = pd.Categorical(oot[c], categories=train_full[c].cat.categories)
    if train_full[TARGET].nunique() < 2:
        print("  train tek sınıf, atlandı"); continue
    print(f"  ✓ Bölme bitti (train {len(train_full)} / oot {len(oot)})")

    # 4) FEATURE ELEME (train_full üzerinde, split'ten ÖNCE)
    _before = len(FEATURES)
    y  = train_full[TARGET]
    Xf = train_full[FEATURES]

    # 4a) Sabit / neredeyse sabit
    print("  ▶ 4a) Sabit / neredeyse sabit değişken elemesi başladı...")
    drop_const = [c for c in FEATURES
                  if Xf[c].nunique(dropna=False) <= 1
                  or Xf[c].value_counts(normalize=True, dropna=False).iloc[0] > 0.99]
    FEATURES = [c for c in FEATURES if c not in drop_const]
    print(f"  ✓ Sabit eleme bitti (elenen {len(drop_const)})")

    # 4b) IV hesabı (korelasyondan ÖNCE)
    print("  ▶ 4b) IV hesabına başlandı (korelasyondan önce)...")
    iv_scores = {c: _quick_iv(train_full[c], y) for c in FEATURES}
    print("  ✓ IV hesabı bitti.")

    # 4c) Yüksek korelasyon (|r|>0.95) — çiftte IV'si YÜKSEK olan tutulur
    print("  ▶ 4c) Korelasyon elemesi başladı (|r|>0.95, düşük IV'li elenir)...")
    num   = train_full[FEATURES].select_dtypes(include=np.number)
    corr  = num.corr().abs()
    upper = corr.where(np.triu(np.ones(corr.shape), k=1).astype(bool))

    # Çift .loc döngüsü p x p skaler lookup yapıyordu (258 feature'da 66,564
    # lookup, ~1s). Vektörize hâli AYNI kümeyi ~850x hızlı üretiyor.
    _A    = upper.to_numpy()
    _cols = np.asarray(upper.columns)
    _ivv  = np.array([iv_scores.get(c, 0.0) for c in _cols])
    _ri, _ci = np.where(np.nan_to_num(_A, nan=0.0) > 0.95)
    drop_corr = set(np.where(_ivv[_ri] >= _ivv[_ci], _cols[_ci], _cols[_ri]))

    drop_corr = [c for c in FEATURES if c in drop_corr]
    FEATURES  = [c for c in FEATURES if c not in drop_corr]
    print(f"  ✓ Korelasyon elemesi bitti (elenen {len(drop_corr)})")

    # 4d) Düşük IV (<0.02)
    print("  ▶ 4d) Düşük IV'li değişken elemesi başladı (IV<0.02)...")
    drop_iv  = [c for c in FEATURES if iv_scores.get(c, 0.0) < 0.02]
    FEATURES = [c for c in FEATURES if c not in drop_iv]
    print("  ✓ IV elemesi bitti.")
    print(f"  eleme: const-{len(drop_const)} corr-{len(drop_corr)} "
          f"iv-{len(drop_iv)}  →  {_before}→{len(FEATURES)}")

    # — IV sonuçları — ilk 20 (yüksekten düşüğe)
    iv_sirali = sorted(iv_scores.items(), key=lambda kv: kv[1], reverse=True)
    print("  --- IV ilk 20 ---")
    for c, v in iv_sirali[:20]:
        print(f"    {v:7.4f}  {c}")

    if len(FEATURES) == 0:
        print("  tüm feature elendi, atlandı"); continue

    # — Bu rengin KALAN feature'larını kendi dosyasına yaz
    print("  ▶ Kalan feature'lar dosyaya yazılıyor...")
    feat_df = pd.DataFrame(
        [{'feature': c, 'iv': round(iv_scores.get(c, np.nan), 4)} for c in FEATURES]
    ).sort_values('iv', ascending=False)
    _yaz(f"renk_{RENK_KOD}_{renk_adi}_kalan_featurelar.csv", feat_df)

    # 5) Train içi validasyon (indirgenmiş FEATURES ile)
    print("  ▶ 5) Train/val bölme (stratify)...")
    train, val = train_test_split(train_full, test_size=VAL_SIZE,
                                  stratify=train_full[TARGET], random_state=RANDOM_STATE)
    X_tr,  y_tr  = train[FEATURES], train[TARGET]
    X_val, y_val = val[FEATURES],   val[TARGET]
    X_oot, y_oot = oot[FEATURES],   oot[TARGET]

    # 6) Model + Optuna
    print("  ▶ 6) Model denemeye başlandı (Optuna)...")
    spw  = (len(y_tr) - y_tr.sum()) / max(y_tr.sum(), 1)
    base = lgb.LGBMClassifier(objective='binary', metric='auc', scale_pos_weight=spw,
                              random_state=RANDOM_STATE, n_jobs=-1, verbose=-1)

    def objective(trial):
        max_depth = trial.suggest_int('max_depth', 2, 4)
        leaf_cap  = min(31, 2 ** max_depth - 1)
        params = {
            'max_depth': max_depth,
            'num_leaves': trial.suggest_int('num_leaves', min(4, leaf_cap), leaf_cap),
            'n_estimators': trial.suggest_int('n_estimators', 150, 400),
            'learning_rate': trial.suggest_float('learning_rate', 0.01, 0.05, log=True),
            'min_child_samples': trial.suggest_int('min_child_samples', 300, 1500),
            'reg_lambda': trial.suggest_float('reg_lambda', 5, 50, log=True),
            'reg_alpha': trial.suggest_float('reg_alpha', 0.0, 10.0),
            'colsample_bytree': trial.suggest_float('colsample_bytree', 0.4, 0.7),
            'subsample': trial.suggest_float('subsample', 0.6, 0.8),
            'subsample_freq': 1,
        }

        model = clone(base).set_params(**params)
        cv = cross_validate(model, X_tr, y_tr, scoring='roc_auc', cv=skf,
                            n_jobs=CV_JOBS, return_train_score=True)
        train_gini = 2 * cv['train_score'].mean() - 1
        test_gini  = 2 * cv['test_score'].mean() - 1
        trial.set_user_attr('train_gini', train_gini)
        trial.set_user_attr('test_gini',  test_gini)
        return cv['test_score'].mean() - max(0, (train_gini - test_gini) - 0.05)

    study = optuna.create_study(direction='maximize',
                                sampler=optuna.samplers.TPESampler(seed=RANDOM_STATE))
    study.optimize(objective, n_trials=N_ITER)
    print("  ✓ Model denemesi bitti (Optuna).")
    best = clone(base).set_params(**study.best_params).fit(X_tr, y_tr)

    # — Bu rengin DENENEN modellerini kendi dosyasına yaz
    print("  ▶ Denenen modeller dosyaya yazılıyor...")
    trial_rows = []
    for t in study.trials:
        if t.value is None:
            continue
        trial_rows.append({
            'trial':      t.number,
            'objective':  round(t.value, 4),
            'train_gini': round(t.user_attrs.get('train_gini', np.nan), 4),
            'test_gini':  round(t.user_attrs.get('test_gini',  np.nan), 4),
            'gini_gap':   round(t.user_attrs.get('train_gini', np.nan)
                                - t.user_attrs.get('test_gini', np.nan), 4),
            'is_best':    int(t.number == study.best_trial.number),
            'params':     json.dumps(t.params),
        })
    _yaz(f"renk_{RENK_KOD}_{renk_adi}_denenen_modeller.csv", pd.DataFrame(trial_rows))

    # 7) Threshold + metrikler
    print("  ▶ 7) Threshold seçimi + metrik hesabı...")
    val_prob = best.predict_proba(X_val)[:, 1]
    thr      = find_thresholds(y_val, val_prob)['youden_j']
    tr_gini  = 2 * roc_auc_score(y_tr,  best.predict_proba(X_tr)[:, 1]) - 1
    val_gini = 2 * roc_auc_score(y_val, val_prob) - 1
    oot_prob = best.predict_proba(X_oot)[:, 1]
    oot_metrics = evaluate(y_oot, oot_prob, thr) if y_oot.nunique() >= 2 else None

    # 8) Sakla + bu rengin ÖZETİNİ kendi dosyasına yaz
    print("  ▶ 8) Özet dosyaya yazılıyor...")
    renk_sonuclari[RENK_KOD] = {'model': best, 'features': FEATURES,
                                'best_params': study.best_params, 'threshold': thr}
    ozet_row = {
        'renk': etiket,
        'n_train': len(X_tr), 'n_oot': len(X_oot),
        'n_feature': len(FEATURES),
        'target_rate': round(y_tr.mean(), 4),
        'train_gini': round(tr_gini, 4), 'val_gini': round(val_gini, 4),
        'oot_gini': oot_metrics['Gini'] if oot_metrics else None,
        'oot_ks':   oot_metrics['KS']   if oot_metrics else None,
        'threshold': round(thr, 4),
        'best_params': json.dumps(study.best_params),
    }
    ozet_satirlari.append(ozet_row)
    _yaz(f"renk_{RENK_KOD}_{renk_adi}_ozet.csv", pd.DataFrame([ozet_row]))

    print(f"  ✓ {etiket} bitti → train_gini={tr_gini:.4f} val_gini={val_gini:.4f} "
          f"oot_gini={oot_metrics['Gini'] if oot_metrics else 'NA'}  (3 dosya yazıldı)")

# — Tüm renkler tek birleşik özet (opsiyonel)
print("\n▶ Tüm renklerin birleşik özeti yazılıyor...")
ozet = pd.DataFrame(ozet_satirlari)
print("\n===== ÖZET (tüm renkler) =====")
print(ozet.drop(columns='best_params').to_string(index=False))
_yaz("renk_bazli_TUM_ozet.csv", ozet)
print("✓ Tüm işlem tamamlandı.")
