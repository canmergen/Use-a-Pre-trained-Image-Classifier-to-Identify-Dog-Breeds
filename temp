select
  to_char(count(*), 'FM999,999,999,999') as SATIR,
  to_char(count(distinct MBB_NO || '#' || to_char(TARIH,'YYYYMMDD')), 'FM999,999,999,999') as TEKIL_MBB_TARIH,
  to_char(sum(case when TARIH != trunc(TARIH) then 1 else 0 end), 'FM999,999,999,999') as SAAT_ICEREN,
  count(distinct TARIH) as FARKLI_TARIH
from PSKR.SKR_TBRY_MST_DAVR_SKOR_FNL_SAS
where TARIH >= LAST_DAY(TO_DATE('2024-01','YYYY-MM'))
  and TARIH <= LAST_DAY(TO_DATE('2025-11','YYYY-MM'))
