## 1.5 Model eğitimi (3-fold CV + final val)

Train üzerinde 3-katlı stratified CV yapılır: her katta model 2/3 ile eğitilir
(erken durdurma katın kendi doğrulama parçasıyla), kalan 1/3'te ölçülür.
CV ortalaması ± std, karşılaştırmanın gürültü bandını verir. Ardından final
model tüm train ile (ağaç sayısı = CV'nin bulduğu ortalama) eğitilir ve
dokunulmamış VAL setinde skorlanır. Val yalnızca bu final ölçümde kullanılır.



import lightgbm as lgb
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import StratifiedKFold

LGB_PARAMS = dict(
    objective="binary", metric="auc", n_estimators=2000, learning_rate=0.03,
    num_leaves=15, max_depth=5, min_child_samples=100,
    colsample_bytree=0.5, subsample=0.8, subsample_freq=1,
    reg_lambda=10.0, reg_alpha=1.0, n_jobs=4, verbose=-1, random_state=42,
)

def capture_at(y_true, prob, pct=0.10):
    y, p = np.asarray(y_true), np.asarray(prob)
    k = max(1, int(pct * len(y)))
    idx = np.argsort(-p)[:k]
    return float(y[idx].sum() / max(y.sum(), 1))

def egit_ve_olc(kolonlar, etiket):
    """3-fold CV (train) + final model (tüm train) + val skoru."""
    X, y = train[kolonlar], y_train
    cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=42)
    fold_auc, fold_agac = [], []
    for tr_i, te_i in cv.split(X, y):
        m = lgb.LGBMClassifier(**LGB_PARAMS)
        m.fit(X.iloc[tr_i], y[tr_i],
              eval_set=[(X.iloc[te_i], y[te_i])],
              callbacks=[lgb.early_stopping(50, verbose=False)])
        fold_auc.append(roc_auc_score(y[te_i], m.predict_proba(X.iloc[te_i])[:, 1]))
        fold_agac.append(m.best_iteration_ or LGB_PARAMS["n_estimators"])

    n_final = int(np.mean(fold_agac))
    final = lgb.LGBMClassifier(**{**LGB_PARAMS, "n_estimators": n_final})
    final.fit(X, y)

    p_tr, p_val = final.predict_proba(X)[:, 1], final.predict_proba(val[kolonlar])[:, 1]
    r = {"cv_auc": float(np.mean(fold_auc)), "cv_std": float(np.std(fold_auc)),
         "tr_auc": roc_auc_score(y, p_tr), "val_auc": roc_auc_score(y_val, p_val),
         "val_gini": 2 * roc_auc_score(y_val, p_val) - 1,
         "val_cap10": capture_at(y_val, p_val), "n_agac": n_final}
    print(f"{etiket:<10} CV AUC={r['cv_auc']:.4f}±{r['cv_std']:.4f}  train AUC={r['tr_auc']:.4f}  "
          f"val AUC={r['val_auc']:.4f}  cap@10={r['val_cap10']:.4f}  "
          f"makas={r['tr_auc']-r['val_auc']:.4f}  ağaç={r['n_agac']}")
    return r, final

sonuc_base, model_base = egit_ve_olc(base_final, "BASE")
sonuc_enr,  model_enr  = egit_ve_olc(enr_final,  "ENRICHED")




