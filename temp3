# COK SEED KARSILASTIRMASI
# Tek seed'in fold std'si, iki feature setini ayirt etmeye yetmiyor.
# Ayni parametrelerle 5 farkli seed calistirip ortalamalari karsilastir.
# ------------------------------------------------------------------
def cok_seed_karsilastir(kolon_setleri, seedler=(1, 7, 42, 99, 123)):
    """kolon_setleri: {"BASE": base_final, "ENRICHED": enr_final}"""
    tablo = {}
    for etiket, kolonlar in kolon_setleri.items():
        cv_list, val_list = [], []
        for s in seedler:
            r, _ = egit_ve_olc(kolonlar, etiket, seed=s, sessiz=True)
            cv_list.append(r["cv_auc"])
            val_list.append(r["val_auc"])
        tablo[etiket] = {"cv_ort": np.mean(cv_list), "cv_sd": np.std(cv_list),
                         "val_ort": np.mean(val_list), "val_sd": np.std(val_list)}
        print(f"{etiket:<10} CV={tablo[etiket]['cv_ort']:.4f}±{tablo[etiket]['cv_sd']:.4f}  "
              f"VAL={tablo[etiket]['val_ort']:.4f}±{tablo[etiket]['val_sd']:.4f}  "
              f"(n_seed={len(seedler)})")

    if len(tablo) == 2:
        a, b = list(tablo.keys())
        delta = tablo[b]["val_ort"] - tablo[a]["val_ort"]
        gurultu = np.sqrt(tablo[a]["val_sd"]**2 + tablo[b]["val_sd"]**2)
        print(f"\nDELTA (val) = {delta:+.4f}   gurultu bandi = ±{gurultu:.4f}")
        print("SONUC: " + ("anlamli fark" if abs(delta) > gurultu
                           else "fark gurultu icinde, ayirt edilemiyor"))
    return tablo


cok_seed_karsilastir({"BASE": base_final, "ENRICHED": enr_final})
