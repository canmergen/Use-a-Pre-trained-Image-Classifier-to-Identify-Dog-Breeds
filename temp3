import numpy as np
import pandas as pd
from sklearn.metrics import roc_auc_score

llm_kolonlar = [c for c in enr_final if c not in base_final]


def tekil_auc(seri, y):
    """Tek kolonun AUC'si. NaN'lar medyanla doldurulur (LightGBM'siz olcum)."""
    x = pd.to_numeric(seri, errors="coerce")
    x = x.replace([np.inf, -np.inf], np.nan)
    if x.notna().sum() < 50 or x.dropna().nunique() < 2:
        return np.nan
    x = x.fillna(x.median())
    auc = roc_auc_score(y, x)
    return max(auc, 1 - auc)      # yon fark etmez, ayirt edicilik olculuyor


def veri_sagligi(seri):
    x = pd.to_numeric(seri, errors="coerce")
    n = len(x)
    return {
        "nan_%": 100.0 * x.isna().mean(),
        "inf_%": 100.0 * np.isinf(x.replace(np.nan, 0)).mean(),
        "sifir_%": 100.0 * (x == 0).mean(),
        "tekil_deger": int(x.nunique(dropna=True)),
        "maks_mutlak": float(np.nanmax(np.abs(x.replace([np.inf, -np.inf], np.nan)))
                             ) if x.notna().any() else np.nan,
    }


def llm_teshis(llm_kolonlar, ust_n=10):
    """Her LLM feature'i icin: train/val tekil AUC + veri sagligi + base ile korelasyon."""
    satirlar = []
    # Base kolonlarin tekil AUC'si (karsilastirma tabani icin)
    base_auc = {c: tekil_auc(train[c], y_train) for c in base_final}
    base_auc_ort = np.nanmean(list(base_auc.values()))
    base_auc_p90 = np.nanpercentile(list(base_auc.values()), 90)

    for c in llm_kolonlar:
        s = veri_sagligi(train[c])
        tr_auc = tekil_auc(train[c], y_train)
        va_auc = tekil_auc(val[c], y_val)

        # En yuksek korelasyonlu base kolonu (redundans gostergesi)
        x = pd.to_numeric(train[c], errors="coerce").replace([np.inf, -np.inf], np.nan)
        if x.notna().sum() > 50 and x.dropna().nunique() > 1:
            korr = train[base_final].corrwith(x, method="spearman").abs()
            en_yakin = korr.idxmax() if korr.notna().any() else None
            en_yakin_korr = float(korr.max()) if korr.notna().any() else np.nan
        else:
            en_yakin, en_yakin_korr = None, np.nan

        satirlar.append({
            "feature": c, "tr_auc": tr_auc, "val_auc": va_auc,
            "auc_kayip": tr_auc - va_auc if pd.notna(tr_auc) and pd.notna(va_auc) else np.nan,
            "en_yakin_base": en_yakin, "korr": en_yakin_korr, **s,
        })

    t = pd.DataFrame(satirlar).sort_values("val_auc", ascending=False)

    print(f"Base kolonlarin tekil AUC ortalamasi = {base_auc_ort:.4f}, "
          f"%90 dilim = {base_auc_p90:.4f}  (n={len(base_final)})")
    print(f"LLM kolonlarin tekil AUC ortalamasi  = {t['val_auc'].mean():.4f}  "
          f"(n={len(llm_kolonlar)})\n")

    print("--- En iyi %d LLM feature (val tekil AUC) ---" % ust_n)
    print(t.head(ust_n)[["feature", "tr_auc", "val_auc", "auc_kayip",
                         "korr", "nan_%", "sifir_%", "tekil_deger"]].to_string(index=False))

    print("\n--- Sorunlu olanlar ---")
    sorunlu = t[(t["nan_%"] > 20) | (t["inf_%"] > 0) |
                (t["sifir_%"] > 80) | (t["tekil_deger"] < 20) |
                (t["val_auc"] < 0.52) | (t["korr"] > 0.95)]
    if len(sorunlu) == 0:
        print("(veri sagligi acisindan sorunlu feature yok)")
    else:
        print(sorunlu[["feature", "val_auc", "korr", "nan_%", "inf_%",
                       "sifir_%", "tekil_deger", "maks_mutlak"]].to_string(index=False))
        print(f"\n{len(sorunlu)}/{len(llm_kolonlar)} feature en az bir sorun bayragi tasiyor.")

    return t


teshis = llm_teshis(llm_kolonlar)


