import numpy as np
import pandas as pd

# ------------------------------------------------------------------
# SPLIT + GAIN ONEM SIRALAMASI
# feature_importances_ varsayilan olarak "split" doner.
# gain icin booster uzerinden ayrica cekilir.
# ------------------------------------------------------------------
def onem_tablosu(model, kolonlar, prefix=LLM_PREFIX, ust_n=15):
    split = model.booster_.feature_importance(importance_type="split")
    gain  = model.booster_.feature_importance(importance_type="gain")

    imp = pd.DataFrame({"feature": kolonlar, "split": split, "gain": gain})

    # Yuzde paylar: mutlak gain degeri olcek bagimli, pay yorumlanabilir
    imp["split_%"] = 100.0 * imp["split"] / imp["split"].sum()
    imp["gain_%"]  = 100.0 * imp["gain"]  / imp["gain"].sum()

    # Kullanim basina kazanc: dusuk olan = cok kullanilip az kazandiran
    imp["gain_per_split"] = imp["gain"] / imp["split"].replace(0, np.nan)

    # Iki ayri siralama
    imp["sira_split"] = imp["split"].rank(ascending=False, method="min").astype(int)
    imp["sira_gain"]  = imp["gain"].rank(ascending=False, method="min").astype(int)
    imp["llm_mi"] = imp["feature"].str.startswith(prefix)

    llm = imp[imp["llm_mi"]]
    n = len(imp)

    print(f"LLM feature'larin siralamasi ({n} kolon icinde, {len(llm)} LLM kolonu):\n")
    for etiket, sutun in [("SPLIT", "sira_split"), ("GAIN", "sira_gain")]:
        print(f"  {etiket:<6} ilk 20'de: {(llm[sutun] <= 20).sum():>2} | "
              f"ilk 50'de: {(llm[sutun] <= 50).sum():>2} | "
              f"ilk 100'de: {(llm[sutun] <= 100).sum():>2} | "
              f"medyan sira: {llm[sutun].median():.0f}")

    # Tek sayilik ozet: toplam gain'in yuzde kaci LLM kolonlarindan geliyor?
    # Adil kiyas icin kolon payi da yaninda: 32/279 = %11.5
    print(f"\n  Toplam GAIN payi   : LLM %{llm['gain_%'].sum():.1f}  "
          f"(kolon payi %{100.0*len(llm)/n:.1f})")
    print(f"  Toplam SPLIT payi  : LLM %{llm['split_%'].sum():.1f}")
    print("  -> gain payi kolon payindan dusukse, model bu kolonlari "
          "ortalamanin altinda degerlendiriyor demektir.")

    print(f"\n--- LLM feature'lar, GAIN sirasina gore (ilk {ust_n}) ---")
    print(llm.sort_values("gain", ascending=False)
             .head(ust_n)[["sira_gain", "sira_split", "feature",
                           "gain_%", "split_%", "gain_per_split"]]
             .to_string(index=False,
                        formatters={"gain_%": "{:.2f}".format,
                                    "split_%": "{:.2f}".format,
                                    "gain_per_split": "{:.1f}".format}))

    print(f"\n--- Karsilastirma: en iyi {ust_n} BASE feature (GAIN) ---")
    print(imp[~imp["llm_mi"]].sort_values("gain", ascending=False)
             .head(ust_n)[["sira_gain", "feature", "gain_%", "split_%"]]
             .to_string(index=False,
                        formatters={"gain_%": "{:.2f}".format,
                                    "split_%": "{:.2f}".format}))

    # Cok kullanilip az kazandiranlar: gurultu emici adaylari
    kullanilan = imp[imp["split"] >= 10]
    dusuk_verim = kullanilan.nsmallest(10, "gain_per_split")
    print(f"\n--- Cok bolunup az kazandiranlar (split>=10, en dusuk gain/split) ---")
    print(dusuk_verim[["feature", "split", "gain_per_split", "llm_mi"]]
          .to_string(index=False, formatters={"gain_per_split": "{:.1f}".format}))

    # Hic kullanilmayanlar
    hic = imp[imp["split"] == 0]
    print(f"\nHic kullanilmayan kolon: {len(hic)} "
          f"(bunlarin {int(hic['llm_mi'].sum())} tanesi LLM)")

    return imp


