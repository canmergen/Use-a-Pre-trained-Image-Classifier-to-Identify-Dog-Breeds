# -*- coding: utf-8 -*-
"""
FEATURE_STATE/feature_registry.json -> okunabilir TXT çıktıları

Çıktılar:
  1) feature_ozet.txt        -> her feature için ad + formül + gerekçe blok blok
  2) feature_adlari.txt      -> sadece adlar (numaralı)
  3) feature_formulleri.txt  -> sadece formüller (numaralı)
  4) feature_gerekceleri.txt -> sadece gerekçeler (numaralı)
Numaralar 4 dosyada da aynı sırayı takip eder, satır satır eşleşir.
"""

import json
import io
import os

# ------------------------------------------------------------------
# AYARLAR
# ------------------------------------------------------------------
KAYNAK = "dataiku"          # "dataiku"  -> managed folder'dan oku/yaz
                            # "yerel"    -> normal dosya sisteminden oku/yaz

# --- KAYNAK = "dataiku" ise kullanılanlar ---
FOLDER_ADI  = "FEATURE_STATE"
JSON_YOLU   = "/feature_registry.json"     # folder içindeki yol (başında / olmalı)

# --- KAYNAK = "yerel" ise kullanılanlar ---
YEREL_JSON  = "feature_registry.json"
YEREL_CIKTI = "."                          # çıktıların yazılacağı klasör

AYRI_DOSYA_YAZ = True       # False yaparsan sadece feature_ozet.txt üretilir
SIRALA_ADA_GORE = False     # True -> feature'lar ada göre alfabetik sıralanır


# ------------------------------------------------------------------
# ALAN ADI EŞLEŞTİRME
# JSON'da alan adı farklı yazılmış olabilir diye alternatifler tanımlı.
# ------------------------------------------------------------------
AD_ANAHTARLARI      = ["ad", "isim", "name", "feature_adi", "feature_name"]
FORMUL_ANAHTARLARI  = ["formul", "formül", "formula", "kod", "expression"]
GEREKCE_ANAHTARLARI = ["gerekce", "gerekçe", "rationale", "aciklama", "açıklama"]


def alan_getir(kayit, anahtarlar, varsayilan="(yok)"):
    """Verilen anahtar alternatiflerinden ilk dolu olanı döndürür."""
    for a in anahtarlar:
        if a in kayit and kayit[a] not in (None, "", []):
            return kayit[a]
    return varsayilan


# ------------------------------------------------------------------
# OKUMA
# ------------------------------------------------------------------
def json_oku():
    if KAYNAK == "dataiku":
        import dataiku
        folder = dataiku.Folder(FOLDER_ADI)
        with folder.get_download_stream(JSON_YOLU) as s:
            veri = json.loads(s.read().decode("utf-8"))
        return veri, folder
    elif KAYNAK == "yerel":
        with io.open(YEREL_JSON, "r", encoding="utf-8") as s:
            veri = json.load(s)
        return veri, None
    else:
        raise ValueError("KAYNAK 'dataiku' veya 'yerel' olmalı.")


def kayitlari_normalize_et(veri):
    """
    Registry farklı biçimlerde olabilir:
      - doğrudan liste            -> [ {...}, {...} ]
      - sarmalayan sözlük         -> {"features": [ {...} ]}
      - ada göre sözlük           -> {"LLM_F001": {...}, ...}
    Hepsini tek tip listeye çevirir.
    """
    if isinstance(veri, list):
        return veri

    if isinstance(veri, dict):
        # 1) İçinde liste barındıran bilinen anahtarlar
        for anahtar in ("features", "feature_registry", "kayitlar", "registry", "items"):
            if isinstance(veri.get(anahtar), list):
                return veri[anahtar]
        # 2) Değerlerin hepsi sözlükse: ada göre sözlük varsay
        degerler = list(veri.values())
        if degerler and all(isinstance(d, dict) for d in degerler):
            kayitlar = []
            for k, v in veri.items():
                v = dict(v)
                v.setdefault("ad", k)   # anahtar adı feature adı olarak kullanılır
                kayitlar.append(v)
            return kayitlar

    raise ValueError("JSON yapısı tanınamadı. Beklenen: liste veya feature sözlüğü.")


# ------------------------------------------------------------------
# METİN ÜRETİMİ
# ------------------------------------------------------------------
CIZGI = "=" * 78


def ozet_metni_uret(kayitlar):
    parcalar = []
    parcalar.append(CIZGI)
    parcalar.append("FEATURE REGISTRY - AD / FORMUL / GEREKCE")
    parcalar.append("Toplam feature: %d" % len(kayitlar))
    parcalar.append(CIZGI)
    parcalar.append("")

    for i, k in enumerate(kayitlar, start=1):
        ad      = alan_getir(k, AD_ANAHTARLARI, "(adsiz_%d)" % i)
        formul  = alan_getir(k, FORMUL_ANAHTARLARI)
        gerekce = alan_getir(k, GEREKCE_ANAHTARLARI)

        parcalar.append(CIZGI)
        parcalar.append("[%d] %s" % (i, ad))
        parcalar.append(CIZGI)
        parcalar.append("")
        parcalar.append("--- FORMUL ---")
        parcalar.append(str(formul).strip())
        parcalar.append("")
        parcalar.append("--- GEREKCE ---")
        parcalar.append(str(gerekce).strip())
        parcalar.append("")
        parcalar.append("")

    return "\n".join(parcalar)


def tekil_metin_uret(kayitlar, anahtarlar, baslik):
    parcalar = [baslik, "-" * len(baslik), ""]
    for i, k in enumerate(kayitlar, start=1):
        deger = alan_getir(k, anahtarlar)
        parcalar.append("[%d] %s" % (i, str(deger).strip()))
        parcalar.append("")
    return "\n".join(parcalar)


# ------------------------------------------------------------------
# YAZMA
# ------------------------------------------------------------------
def txt_yaz(folder, dosya_adi, icerik):
    if KAYNAK == "dataiku":
        folder.upload_stream("/" + dosya_adi, icerik.encode("utf-8"))
        print("Yazildi (folder): /%s  (%d karakter)" % (dosya_adi, len(icerik)))
    else:
        yol = os.path.join(YEREL_CIKTI, dosya_adi)
        with io.open(yol, "w", encoding="utf-8") as f:
            f.write(icerik)
        print("Yazildi (yerel): %s  (%d karakter)" % (yol, len(icerik)))


# ------------------------------------------------------------------
# ANA AKIS
# ------------------------------------------------------------------
def main():
    veri, folder = json_oku()
    kayitlar = kayitlari_normalize_et(veri)

    if SIRALA_ADA_GORE:
        kayitlar = sorted(kayitlar, key=lambda k: str(alan_getir(k, AD_ANAHTARLARI, "")))

    print("Okunan feature sayisi: %d" % len(kayitlar))

    # Eksik alan uyarisi (sessizce "(yok)" yazip gecmemek icin)
    eksik = []
    for i, k in enumerate(kayitlar, start=1):
        yok = []
        if alan_getir(k, AD_ANAHTARLARI) == "(yok)":
            yok.append("ad")
        if alan_getir(k, FORMUL_ANAHTARLARI) == "(yok)":
            yok.append("formul")
        if alan_getir(k, GEREKCE_ANAHTARLARI) == "(yok)":
            yok.append("gerekce")
        if yok:
            eksik.append((i, yok))
    if eksik:
        print("UYARI - eksik alani olan kayitlar:")
        for i, yok in eksik:
            print("  [%d] eksik: %s" % (i, ", ".join(yok)))

    txt_yaz(folder, "feature_ozet.txt", ozet_metni_uret(kayitlar))

    if AYRI_DOSYA_YAZ:
        txt_yaz(folder, "feature_adlari.txt",
                tekil_metin_uret(kayitlar, AD_ANAHTARLARI, "FEATURE ADLARI"))
        txt_yaz(folder, "feature_formulleri.txt",
                tekil_metin_uret(kayitlar, FORMUL_ANAHTARLARI, "FEATURE FORMULLERI"))
        txt_yaz(folder, "feature_gerekceleri.txt",
                tekil_metin_uret(kayitlar, GEREKCE_ANAHTARLARI, "FEATURE GEREKCELERI"))

    print("Bitti.")


main()
