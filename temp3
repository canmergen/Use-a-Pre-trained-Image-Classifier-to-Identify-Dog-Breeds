# -*- coding: utf-8 -*-
"""
FEATURE_STATE/feature_registry.json  ->  ALL_GENERATED_FEATURES/feature_ozet.txt

Cikti formati (her feature icin):

    feature adi: LLM_F001_GDN_GLN_RATIO_ACCEL
    feature aciklamasi: Kisa vadeli (7 gun) giden/gelen oraninin...
    feature uretim formulu: LLM_F001_GDN_GLN_RATIO_ACCEL = (df['TXN_GDN_7D_AMT'] / ...)

    feature adi: ...
"""

import json
import io
import os

# ------------------------------------------------------------------
# AYARLAR
# ------------------------------------------------------------------
KAYNAK = "dataiku"          # "dataiku" -> managed folder | "yerel" -> dosya sistemi

# --- Dataiku modu ---
GIRDI_FOLDER_ADI  = "FEATURE_STATE"             # JSON'un okundugu folder
CIKTI_FOLDER_ADI  = "ALL_GENERATED_FEATURES"    # TXT'nin yazildigi folder
JSON_YOLU         = "/feature_registry.json"    # girdi folder icindeki yol

# --- Yerel mod ---
YEREL_JSON  = "feature_registry.json"
YEREL_CIKTI = "."

CIKTI_ADI = "feature_ozet.txt"

# Alan adi varyasyonlari (JSON'da farkli yazilmis olabilir diye)
AD_ANAHTARLARI      = ["ad", "isim", "name", "feature_adi"]
GEREKCE_ANAHTARLARI = ["gerekce", "gerekçe", "rationale", "aciklama", "açıklama"]
FORMUL_ANAHTARLARI  = ["formul", "formül", "formula", "kod", "expression"]


def alan_getir(kayit, anahtarlar, varsayilan="(yok)"):
    for a in anahtarlar:
        if a in kayit and kayit[a] not in (None, "", []):
            return kayit[a]
    return varsayilan


def folderlari_ac():
    """Girdi ve cikti folder'larini ayri ayri acar."""
    import dataiku
    girdi = dataiku.Folder(GIRDI_FOLDER_ADI)
    try:
        cikti = dataiku.Folder(CIKTI_FOLDER_ADI)
    except Exception as e:
        raise RuntimeError(
            "Cikti folder'i acilamadi: '%s'. Projede bu isimde bir managed folder "
            "var mi ve isim buyuk/kucuk harf dahil birebir ayni mi kontrol et. "
            "Orijinal hata: %s" % (CIKTI_FOLDER_ADI, e)
        )
    return girdi, cikti


def json_oku(girdi_folder):
    if KAYNAK == "dataiku":
        with girdi_folder.get_download_stream(JSON_YOLU) as s:
            return json.loads(s.read().decode("utf-8"))
    elif KAYNAK == "yerel":
        with io.open(YEREL_JSON, "r", encoding="utf-8") as s:
            return json.load(s)
    raise ValueError("KAYNAK 'dataiku' veya 'yerel' olmali.")


def kayitlari_normalize_et(veri):
    """Registry duz liste, sarmalanmis liste veya ada gore sozluk olabilir."""
    if isinstance(veri, list):
        return veri
    if isinstance(veri, dict):
        for anahtar in ("features", "feature_registry", "kayitlar", "registry", "items"):
            if isinstance(veri.get(anahtar), list):
                return veri[anahtar]
        degerler = list(veri.values())
        if degerler and all(isinstance(d, dict) for d in degerler):
            kayitlar = []
            for k, v in veri.items():
                v = dict(v)
                v.setdefault("ad", k)
                kayitlar.append(v)
            return kayitlar
    raise ValueError("JSON yapisi taninamadi. Beklenen: liste veya feature sozlugu.")


def tek_satir(metin):
    """Cok satirli metni tek satira indirger; alt alta hizalama bozulmasin diye."""
    return " ".join(str(metin).split())


def formul_satiri(ad, formul):
    """
    'ad = formul' formatina cevirir.
    Formul zaten 'ad =' ile basliyorsa (registry bazen boyle yazabilir)
    ikinci kez basa eklemez.
    """
    formul = tek_satir(formul)
    ad = tek_satir(ad)
    if formul.startswith(ad + " ="):
        return formul
    return "%s = %s" % (ad, formul)


def metin_uret(kayitlar):
    parcalar = []
    for k in kayitlar:
        ad      = alan_getir(k, AD_ANAHTARLARI)
        gerekce = alan_getir(k, GEREKCE_ANAHTARLARI)
        formul  = alan_getir(k, FORMUL_ANAHTARLARI)

        parcalar.append("feature adi: %s"            % tek_satir(ad))
        parcalar.append("feature aciklamasi: %s"     % tek_satir(gerekce))
        parcalar.append("feature uretim formulu: %s" % formul_satiri(ad, formul))
        parcalar.append("")   # feature'lar arasi bos satir

    return "\n".join(parcalar)


def txt_yaz(cikti_folder, icerik):
    if KAYNAK == "dataiku":
        cikti_folder.upload_stream("/" + CIKTI_ADI, icerik.encode("utf-8"))
        print("Yazildi: %s -> /%s" % (CIKTI_FOLDER_ADI, CIKTI_ADI))
    else:
        yol = os.path.join(YEREL_CIKTI, CIKTI_ADI)
        with io.open(yol, "w", encoding="utf-8") as f:
            f.write(icerik)
        print("Yazildi (yerel): %s" % yol)


def main():
    if KAYNAK == "dataiku":
        girdi_folder, cikti_folder = folderlari_ac()
    else:
        girdi_folder, cikti_folder = None, None

    veri = json_oku(girdi_folder)
    kayitlar = kayitlari_normalize_et(veri)
    print("Okunan feature sayisi: %d" % len(kayitlar))

    # Eksik alan varsa sessizce "(yok)" yazip gecmesin, konsola bassin
    for i, k in enumerate(kayitlar, start=1):
        yok = []
        if alan_getir(k, AD_ANAHTARLARI) == "(yok)":
            yok.append("ad")
        if alan_getir(k, GEREKCE_ANAHTARLARI) == "(yok)":
            yok.append("gerekce")
        if alan_getir(k, FORMUL_ANAHTARLARI) == "(yok)":
            yok.append("formul")
        if yok:
            print("UYARI [%d]: eksik alan -> %s" % (i, ", ".join(yok)))

    txt_yaz(cikti_folder, metin_uret(kayitlar))
    print("Bitti.")


main()
