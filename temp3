import lightgbm as lgb
import numpy as np
from sklearn.metrics import roc_auc_score
from sklearn.model_selection import StratifiedKFold

# ------------------------------------------------------------------
# PARAMETRELER
# 8.000 train satiri, ~1038 base kolon, dengeli target.
# colsample 0.5'ten dusuruldu ama 0.15'e degil: 33 LLM kolonu
# seyreltilmesin diye orta yol secildi (~agac basina 300 kolon).
# ------------------------------------------------------------------
LGB_PARAMS = dict(
    objective="binary", metric="auc",
    n_estimators=3000,
    learning_rate=0.02,
    num_leaves=16, max_depth=4,
    min_child_samples=200,      # 8.000 train / 3 fold -> ~5.300; %3.8
    colsample_bytree=0.30,
    subsample=0.8, subsample_freq=1,
    reg_lambda=10.0, reg_alpha=1.0,
    min_split_gain=0.01,
    n_jobs=4, verbose=-1, verbosity=-1, random_state=42,
)

ERKEN_DURDURMA = 100
CALLBACKS = [
    lgb.early_stopping(ERKEN_DURDURMA, verbose=False),
    lgb.log_evaluation(period=0),      # iterasyon logunu susturur
]


def capture_at(y_true, prob, pct=0.10):
    y, p = np.asarray(y_true), np.asarray(prob)
    k = max(1, int(pct * len(y)))
    idx = np.argsort(-p)[:k]
    return float(y[idx].sum() / max(y.sum(), 1))


def egit_ve_olc(kolonlar, etiket, seed=42, sessiz=False):
    """
    3-fold CV (train) + final model (tum train) + val skoru.
    Doner: (ozet_dict, final_model)
    ozet_dict icinde 'fold_auc' (liste) ve 'p_val' (val olasiliklari) da var;
    esli karsilastirma bunlari kullanir.
    """
    params = {**LGB_PARAMS, "random_state": seed}
    X, y = train[kolonlar], y_train
    cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=seed)

    fold_auc, fold_agac = [], []
    for tr_i, te_i in cv.split(X, y):
        m = lgb.LGBMClassifier(**params)
        m.fit(X.iloc[tr_i], y[tr_i],
              eval_set=[(X.iloc[te_i], y[te_i])],
              callbacks=CALLBACKS)
        fold_auc.append(roc_auc_score(y[te_i], m.predict_proba(X.iloc[te_i])[:, 1]))
        fold_agac.append(m.best_iteration_ if m.best_iteration_ else params["n_estimators"])

    # Fold modelleri verinin 2/3'u ile egitildi, final tamami ile egitilecek
    n_final = int(np.mean(fold_agac) * 1.5)
    final = lgb.LGBMClassifier(**{**params, "n_estimators": n_final})
    final.fit(X, y)

    p_tr = final.predict_proba(X)[:, 1]
    p_val = final.predict_proba(val[kolonlar])[:, 1]
    r = {"cv_auc": float(np.mean(fold_auc)), "cv_std": float(np.std(fold_auc)),
         "tr_auc": roc_auc_score(y, p_tr), "val_auc": roc_auc_score(y_val, p_val),
         "val_gini": 2 * roc_auc_score(y_val, p_val) - 1,
         "val_cap10": capture_at(y_val, p_val), "n_agac": n_final,
         "fold_auc": fold_auc, "p_val": p_val, "n_kolon": len(kolonlar)}

    if not sessiz:
        print(f"{etiket:<10} kolon={r['n_kolon']:>4}  "
              f"CV AUC={r['cv_auc']:.4f}±{r['cv_std']:.4f}  "
              f"train={r['tr_auc']:.4f}  val={r['val_auc']:.4f}  "
              f"cap@10={r['val_cap10']:.4f}  "
              f"makas={r['tr_auc']-r['val_auc']:.4f}  agac={r['n_agac']}")
    return r, final


# ------------------------------------------------------------------
# A) ESLI CV KARSILASTIRMASI
# Ayni seed -> StratifiedKFold ayni fold'lari uretir (bolme sadece y'ye
# ve seed'e bagli, kolon setine degil). Bu yuzden fold bazinda dogrudan
# cikartma yapilabilir; ortak gurultu birbirini goturur.
# ------------------------------------------------------------------
def esli_cv_karsilastir(base_kolon, enr_kolon, seedler=(1, 7, 42, 99, 123)):
    deltalar = []
    for s in seedler:
        rb, _ = egit_ve_olc(base_kolon, "BASE", seed=s, sessiz=True)
        re_, _ = egit_ve_olc(enr_kolon, "ENRICHED", seed=s, sessiz=True)
        for i, (b, e) in enumerate(zip(rb["fold_auc"], re_["fold_auc"])):
            deltalar.append(e - b)
        print(f"  seed={s:<4} BASE CV={rb['cv_auc']:.4f}  "
              f"ENR CV={re_['cv_auc']:.4f}  delta={re_['cv_auc']-rb['cv_auc']:+.4f}")

    d = np.array(deltalar)
    n = len(d)
    ort, sh = float(d.mean()), float(d.std(ddof=1) / np.sqrt(n))
    print(f"\nESLI CV DELTA = {ort:+.4f}  (std hata ±{sh:.4f}, n={n} fold)")
    print(f"  yaklasik t = {ort/sh if sh > 0 else 0:.2f}   "
          f"(|t|>2 ise fark gurultuden ayrisiyor)")
    return d


# ------------------------------------------------------------------
# B) ESLI VAL BOOTSTRAP
# Ayni bootstrap satirlariyla iki modelin val AUC'si hesaplanir.
# Val setinin kucuklugu (2.000) her iki modeli AYNI yonde etkiledigi icin
# esli fark, bagimsiz ortalama farkindan cok daha dar bir bantta cikar.
# ------------------------------------------------------------------
def esli_val_bootstrap(p_val_base, p_val_enr, n_boot=2000, seed=42):
    rng = np.random.default_rng(seed)
    yv = np.asarray(y_val)
    n = len(yv)
    farklar = []
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        if yv[idx].min() == yv[idx].max():      # tek sinif dustuyse atla
            continue
        farklar.append(roc_auc_score(yv[idx], p_val_enr[idx]) -
                       roc_auc_score(yv[idx], p_val_base[idx]))
    f = np.array(farklar)
    alt, ust = np.percentile(f, [2.5, 97.5])
    print(f"\nESLI VAL DELTA = {f.mean():+.4f}   %95 GA = [{alt:+.4f}, {ust:+.4f}]")
    print("  SONUC: " + ("anlamli (GA sifiri icermiyor)" if alt > 0 or ust < 0
                         else "anlamsiz (GA sifiri iceriyor)"))
    return f


# ------------------------------------------------------------------
# C) LLM KOLONLARI TEK BASINA
# 33 kolonun 1038'in yaninda kaybolup kaybolmadigini anlamanin en net yolu:
# tek baslarina, ve ayni sayida rastgele base kolonuna karsi olcmek.
# ------------------------------------------------------------------
def llm_tek_basina_test(llm_kolon, base_kolon, n_tekrar=5, seed=42):
    r_llm, _ = egit_ve_olc(llm_kolon, "SADECE_LLM", seed=seed)
    rng = np.random.default_rng(seed)
    skorlar = []
    for i in range(n_tekrar):
        secim = list(rng.choice(base_kolon, size=len(llm_kolon), replace=False))
        r, _ = egit_ve_olc(secim, f"RASTGELE_{i}", seed=seed, sessiz=True)
        skorlar.append(r["cv_auc"])
    print(f"RASTGELE  {len(llm_kolon)} base kolonu: "
          f"CV AUC ort={np.mean(skorlar):.4f}±{np.std(skorlar):.4f}  ({n_tekrar} tekrar)")
    print(f"KARSILASTIRMA: LLM {r_llm['cv_auc']:.4f} vs rastgele {np.mean(skorlar):.4f} "
          f"-> {'LLM ustun' if r_llm['cv_auc'] > np.mean(skorlar) + np.std(skorlar) else 'ayirt edilemiyor'}")
    return r_llm, skorlar


