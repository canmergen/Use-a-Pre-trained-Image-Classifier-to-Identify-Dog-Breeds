def karsilastirma_yorumla(llm_auc, rastgele_skorlar):
    ort, sd = float(np.mean(rastgele_skorlar)), float(np.std(rastgele_skorlar))
    if llm_auc > ort + sd:
        sonuc = "LLM USTUN"
    elif llm_auc < ort - sd:
        sonuc = "LLM ALTTA (feature'lar rastgele base kolonlarindan zayif)"
    else:
        sonuc = "ayirt edilemiyor"
    print(f"LLM {llm_auc:.4f} vs rastgele {ort:.4f}±{sd:.4f}  ->  {sonuc}")
    return sonuc


